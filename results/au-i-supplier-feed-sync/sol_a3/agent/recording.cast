[89.273887, "i", "     self.write_batch(\"changes_2.jsonl\", [delete(23, \"T-001\"), event])\n        before = len(self.requests())\n        self.cli(\"sync\")\n        requests = self.requests()[before:]\n        self.assertEqual([r[\"status\"] for r in requests], [409, 200])\n        self.assertEqual(requests[0][\"cursor\"], requests[1][\"cursor\"])\n        self.assertEqual(requests[1][\"ack\"], notice[\"id\"])\n        rows = {r[\"sku\"]: r for r in json.loads(self.cli(\"report\", \"--json\"))}\n        self.assertEqual(rows[\"T-001\"][\"feed_price\"], \"5.99\")\n        self.assertEqual(rows[\"T-001\"][\"effective_price\"], \"1.99\")\n''' + s[pos:]\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
