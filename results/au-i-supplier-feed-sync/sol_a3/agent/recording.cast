[89.273401, "i", "cd /app && cat > tests/test_store_sync.py <<'PY'\n\"\"\"Regression tests for page transactions, migration, and price selection.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nfrom feedsync import store\nfrom feedsync.sync import run_sync\n\n\ndef item(seq, sku=\"A\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"title\": f\"Product {seq}\", \"price\": price}\n\n\ndef page(cursor, items=(), tombstones=()):\n    return {\"items\": list(items), \"tombstones\": list(tombstones), \"next_cursor\": cursor}\n\n\nclass StoreSyncTest(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addCleanup(self.conn.close)\n\n    def apply(self, *pages):\n        return run_sync(self.conn, SimpleNamespace(iter_pages=lambda cursor: iter(pages)))\n\n    def test_decimal_prices(self):\n        for price, cents in [(\"4.35\", 435), (\"19.99\", 1999), (\"0.29\", 29),\n                             (\"8.58\", 858), (\"0.57\", 57), (\"15.99\", 1599), (\"0.00\", 0)]:\n    "]
[89.273446, "i", "        with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n        for price in (\"0.001\", \"NaN\", \"Infinity\"):\n            with self.subTest(price=price), self.assertRaises(ValueError):\n                store.price_to_cents(price)\n\n    def test_mixed_changes_use_sequence_not_array_order(self):\n        self.apply(page(\"done\", [item(7), item(1), item(5)],\n                        [{\"seq\": 6, \"sku\": \"A\"}, {\"seq\": 3, \"sku\": \"A\"}]))\n        row = self.conn.execute(\"SELECT * FROM products\").fetchone()\n        self.assertEqual((row[\"feed_seq\"], row[\"title\"]), (7, \"Product 7\"))\n        self.assertEqual(store.product_count(self.conn), 1)\n        self.apply(page(\"later\", tombstones=[{\"seq\": 8, \"sku\": \"A\"}]))\n        self.assertEqual(store.product_count(self.conn), 0)\n\n    def test_failed_page_rolls_back_changes_and_cursor(self):\n        self.apply(page(\"first\", [item(1)]))\n        with self.assertRaises(KeyError):\n            self.apply(page(\"bad\", [item(2), {\"seq\": 3, \"sk"]
[89.273456, "i", "u\": \"B\"}]))\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"first\")\n        self.assertEqual(self.conn.execute(\"SELECT feed_seq FROM products\").fetchone()[0], 1)\n        self.assertEqual(store.product_count(self.conn), 1)\n\n    def test_prior_page_is_durable_if_fetch_fails(self):\n        def pages(cursor):\n            yield page(\"saved\", [item(1)])\n            raise RuntimeError(\"network failure\")\n        with self.assertRaises(RuntimeError):\n            run_sync(self.conn, SimpleNamespace(iter_pages=pages))\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"saved\")\n        self.assertEqual(store.product_count(self.conn), 1)\n        self.assertIsNone(store.get_state(self.conn, \"last_sync_at\"))\n        self.assertFalse(self.conn.in_transaction)\n\n    def test_override_dates_and_feed_fallback(self):\n        self.apply(page(\"done\", [item(1)]))\n        self.conn.execute(\"INSERT INTO price_overrides (sku, override_cents, starts_on, ends_on, \"\n                          \"author, "]
[89.27346, "i", "reason, created_at) VALUES \"\n                          \"('A', 0, '2026-11-01', '2026-11-30', 'merch', 'promo', '2026-10-01')\")\n        for day in (\"2026-11-01\", \"2026-11-30\"):\n            self.assertEqual(store.effective_price(self.conn, \"A\", day), (0, \"override\"))\n            self.assertEqual(store.report_rows(self.conn, day)[0][\"effective_price\"], \"0.00\")\n        self.assertEqual(store.effective_price(self.conn, \"A\", \"2026-12-01\"), (435, \"feed\"))\n\n    def test_legacy_duplicates_migrate_without_touching_overrides(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"legacy.db\"\n            with sqlite3.connect(path) as conn:\n                conn.executescript(store.SCHEMA)\n                conn.executemany(\"INSERT INTO products (sku, title, price_cents, feed_seq) \"\n                                 \"VALUES ('A', ?, ?, ?)\",\n                                 [(\"newest seq\", 500, 5), (\"older seq\", 100, 1), (\"tie wins\", 550, 5)])\n                conn.execute(\"INSERT INTO price_ove"]
[89.273471, "i", "rrides (sku, override_cents, starts_on, \"\n                             \"author, reason, created_at) VALUES ('A', 400, '2020-01-01', \"\n                             \"'merch', 'promo', '2020-01-01')\")\n            conn = store.connect(path)\n            try:\n                self.assertEqual(store.product_count(conn), 1)\n                self.assertEqual(conn.execute(\"SELECT title FROM products\").fetchone()[0], \"tie wins\")\n                self.assertEqual(conn.execute(\"SELECT COUNT(*) FROM price_overrides\").fetchone()[0], 1)\n                with self.assertRaises(sqlite3.IntegrityError):\n                    conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A', 'dup', 0)\")\n            finally:\n                conn.close()\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text()\npos = s.index('\\n\\nif __name__ == \"__main__\":')\ns = s[:pos] + '''\n    def test_no_change_run_requests_only_saved_cursor(self):\n        self.cli(\"sync\")\n        first = self.requests()\n   "]
