[158.19901, "i", "cd /app && python - <<'PY'\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\nexpected = {}\nevents = [json.loads(line) for p in sorted(Path('dev/feed_data').glob('changes*.jsonl')) for line in p.read_text().splitlines() if line.strip()]\nfor e in sorted(events, key=lambda e: e['seq']):\n    if e['op'] == 'delete':\n        expected.pop(e['sku'], None)\n    else:\n        expected[e['sku']] = (e['sku'], e['title'], int(Decimal(e['price']) * 100), e.get('currency', 'EUR'), e.get('updated_at'), e['seq'])\nwith sqlite3.connect('data/catalog.db') as c, sqlite3.connect('/var/tmp/feedsync-before-v2-fix.db') as original:\n    actual = c.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products ORDER BY sku').fetchall()\n    assert actual == sorted(expected.values())\n    overrides = c.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    assert overrides == original.execute('SELECT * FROM price_overrides ORDER BY id').fetchall("]
[158.199065, "i", ")\n    assert c.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n    cursor = c.execute(\"SELECT value FROM sync_state WHERE key = 'feed_cursor'\").fetchone()[0]\nrows = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\nassert len(rows) == len(expected) == len({r['sku'] for r in rows})\nlast = json.loads(Path('/var/tmp/feedstub/requests.log').read_text().splitlines()[-1])\nassert last['cursor'] == cursor and last['next_cursor'] == cursor\nassert last['status'] == 200 and last['items'] == 0 and last['tombstones'] == 0 and not last['has_more']\nprint(f'PASS: {len(actual)} unique products match all fixture fields and exact prices; SQLite integrity OK')\nprint(f'PASS: all {len(overrides)} merchandising override records unchanged')\nprint(f'PASS: JSON report has {len(rows)} unique SKUs')\nprint(f'PASS: final incremental request used saved cursor {cursor}, returned zero changes')\nprint('Latest request:', json.dumps(last))\nPY\npython -m feedsync status\n"]
