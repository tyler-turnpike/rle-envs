[102.391377, "o", "('KS-10038', 308, '2025-06-01', '2029-12-31', '2026-10-05T10:42:00Z')\r\n('KS-10038', 208, '2025-11-20', '2029-12-31', '2026-10-05T10:42:00Z')\r\n"]
