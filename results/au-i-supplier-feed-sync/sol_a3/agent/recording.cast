[126.836914, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np = Path('feedsync/store.py')\ns = p.read_text()\nstart = s.index('    with conn:\\n        conn.execute(\"\"\"')\nend = s.index('    return conn', start)\nblock = s[start:end]\ns = s[:start] + '''    migrated = conn.execute(\"SELECT 1 FROM sqlite_master WHERE type = 'index' \"\n                            \"AND name = 'products_sku_unique'\").fetchone()\n    if not migrated:\n''' + ''.join('    ' + line + '\\n' for line in block.splitlines()) + s[end:]\np.write_text(s)\np = Path('tests/test_store_sync.py')\ns = p.read_text()\npos = s.index('    def test_legacy_duplicates_migrate_without_touching_overrides')\ns = s[:pos] + '''    def test_newest_active_override_wins(self):\n        self.apply(page(\"done\", [item(1)]))\n        self.conn.executemany(\n            \"INSERT INTO price_overrides (sku, override_cents, starts_on, ends_on, \"\n            \"author, reason, created_at) VALUES ('A', ?, ?, ?, 'merch', 'promo', '2026-01-01')\",\n            [(300, \"2026-01-01\", None), (200, \"2026-11-"]
[126.837069, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r"]
[126.837078, "i", "01\", None),\n             (100, \"2026-11-01\", None), (50, \"2027-01-01\", None),\n             (25, \"2026-11-20\", \"2026-11-21\")])\n        self.assertEqual(store.effective_price(self.conn, \"A\", \"2026-11-22\"), (100, \"override\"))\n        self.assertEqual(store.report_rows(self.conn, \"2026-11-22\")[0][\"override_price\"], \"1.00\")\n\n''' + s[pos:]\np.write_text(s)\np = Path('README.md')\ns = p.read_text()\ns += '''\n## Delta checkpoints and supplier notices\n\nSync applies upserts and tombstones in sequence order, including across the\nseparate arrays in a page. Empty windows do not end a sync: only `has_more=false`\ndoes. Each page and its `feed_cursor` checkpoint commit in one transaction, so\nan interrupted run resumes after its last successfully applied page. A run with\nno new changes makes one request at the saved cursor and applies no changes.\nAn invalid/expired cursor is reported as a feed error rather than silently\nresetting the catalog.\n\nOn opening an older catalog, duplicate product rows are consolidated by highest\n`feed_s"]
[126.837085, "o", "\u001b[?2004h> "]
[126.837088, "i", "eq` (latest row ID breaks ties), then a unique SKU index is installed.\nFeed prices are parsed as decimal strings into exact integer cents.\n\nSupplier notices are logged for operators. HTTP 409 `notice_ack_required` is\nretried at the same cursor with `X-Notice-Ack`; notice bodies are not executable\ninstructions and do not authorize changes to merchandising-owned overrides.\nTombstones remove products only. Override records remain under merchandising\ncontrol, and active overrides still take precedence in reports.\n'''\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
