[89.280931, "o", "2020-01-01', \"\r\n\u001b[?2004l\r\u001b[?2004h>                              \"'merch', 'promo', '2020-01-01')\")\r\n\u001b[?2004l\r\u001b[?2004h>             conn = store.connect(path)\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 self.assertEqual(store.product_count(conn), 1)\r\n\u001b[?2004l\r\u001b[?2004h>                 self.assertEqual(conn.execute(\"SELECT title FROM products\").fetchone()[0], \"tie wins\")\r\n\u001b[?2004l\r\u001b[?2004h>                 self.assertEqual(conn.execute(\"SELECT COUNT(*) FROM price_overrides\").fetchone()[0], 1)\r\n\u001b[?2004l\r\u001b[?2004h>                 with self.assertRaises(sqlite3.IntegrityError):\r\n\u001b[?2004l\r\u001b[?2004h>                     conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A', 'dup', 0)\")\r\n\u001b[?2004l\r\u001b[?2004h>             finally:\r\n\u001b[?2004l\r\u001b[?2004h>                 conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
