[141.349291, "i", "ctive_price'] == f'{cents // 100}.{cents % 100:02d}'\n        assert row['source'] == ('override' if active else 'feed')\n    print(f'JSON report verified: {len(rows)} rows with correct effective prices')\n\nlog = Path('/var/tmp/feedstub/requests.log')\nbefore = len(log.read_text().splitlines())\nresult = subprocess.run([sys.executable, '-m', 'feedsync', 'sync'], text=True, capture_output=True, check=True)\nprint('Second sync:', result.stdout.strip())\nassert json.loads(result.stdout) == {'pages': 1, 'upserts': 0, 'deletes': 0}\nrequests = [json.loads(line) for line in log.read_text().splitlines()[before:]]\nassert len(requests) == 1, requests\nassert requests[0]['cursor'] == cursor and requests[0]['status'] == 200\nwith sqlite3.connect('data/catalog.db') as conn:\n    assert actual == conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products ORDER BY sku').fetchall()\nprint('Incremental behavior verified: one request at saved cursor, no pages replayed')\nPY\npython -m feedsync status\npython "]
