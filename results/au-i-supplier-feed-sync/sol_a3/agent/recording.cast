[141.347385, "i", "cd /app && python - <<'PY'\nimport datetime as dt\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\n\nexpected = {}\nevents = []\nfor path in sorted(Path('dev/feed_data').glob('changes*.jsonl')):\n    events.extend(json.loads(line) for line in path.read_text().splitlines() if line.strip())\nfor event in sorted(events, key=lambda e: e['seq']):\n    if event['op'] == 'delete':\n        expected.pop(event['sku'], None)\n    else:\n        expected[event['sku']] = (event['sku'], event['title'], int(Decimal(event['price']) * 100),\n                                  event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-before-v2-fix.db') as backup:\n    actual = conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products ORDER BY sku').fetchall()\n    assert actual == sorted(expected.values()), 'Catalog differs from independent event replay'\n"]
[141.347555, "i", "    overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    assert overrides == backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), 'Overrides changed'\n    assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n    cursor = conn.execute(\"SELECT value FROM sync_state WHERE key = 'feed_cursor'\").fetchone()[0]\n    print(f'Catalog verified: {len(actual)} unique SKUs; all {len(overrides)} override records unchanged; cursor {cursor}')\n    rows = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\n    assert len(rows) == len(expected)\n    today = dt.date.today().isoformat()\n    for row in rows:\n        active = conn.execute('SELECT override_cents FROM price_overrides WHERE sku = ? AND starts_on <= ? AND (ends_on IS NULL OR ends_on >= ?) ORDER BY starts_on DESC, id DESC LIMIT 1', (row['sku'], today, today)).fetchone()\n        cents = active[0] if active else expected[row['sku']][2]\n        assert row['effe"]
