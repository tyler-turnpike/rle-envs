[140.677257, "i", "python - <<'PY'\nimport json, sqlite3\nfrom decimal import Decimal\nfrom pathlib import Path\nexpected = {}\nfor e in sorted((json.loads(line) for p in Path('dev/feed_data').glob('changes*.jsonl') for line in p.read_text().splitlines() if line.strip()), key=lambda e: e['seq']):\n    if e['op'] == 'delete':\n        expected.pop(e['sku'], None)\n    else:\n        expected[e['sku']] = (e['title'], int(Decimal(e['price']) * 100), e.get('currency', 'EUR'), e.get('updated_at'), e['seq'])\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-backup/catalog-before-fix.db') as backup:\n    actual = {r[0]: r[1:] for r in conn.execute('SELECT sku,title,price_cents,currency,updated_at,feed_seq FROM products')}\n    assert actual == expected\n    assert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0] == len(expected)\n    overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    assert overrides == backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchal"]
[140.677473, "i", "l()\n    assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n    cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\n    last = [json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines() if json.loads(line)['path'] == '/v2/changes'][-1]\n    assert last['cursor'] == last['next_cursor'] == cursor\n    assert last['items'] == last['tombstones'] == 0 and last['has_more'] is False\n    print(f'PASS: {len(actual)} unique products exactly match the complete feed; integrity OK.')\n    print(f'PASS: all {len(overrides)} original merchandising overrides unchanged.')\n    print(f'PASS: incremental request at saved cursor {cursor}, no old changes downloaded.')\nPY\npython -m feedsync status\npython -m unittest discover -s tests -v > /var/tmp/feedsync-tests.log 2>&1; tail -n 5 /var/tmp/feedsync-tests.log\n"]
