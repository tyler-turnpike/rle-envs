[51.895146, "i", "lace('\"VALUES (?, ?, ?, ?, ?, ?)\",', '''\"VALUES (?, ?, ?, ?, ?, ?) \"\n                 \"ON CONFLICT(sku) DO UPDATE SET title = excluded.title, \"\n                 \"price_cents = excluded.price_cents, currency = excluded.currency, \"\n                 \"updated_at = excluded.updated_at, feed_seq = excluded.feed_seq \"\n                 \"WHERE products.feed_seq IS NULL OR excluded.feed_seq >= products.feed_seq\",''')\ns = s.replace('\\ndef product_count(conn):', '''\ndef delete_product(conn, sku):\n    conn.execute(\"DELETE FROM products WHERE sku = ?\", (sku,))\n\n\ndef product_count(conn):''')\np.write_text(s)\np = Path('feedsync/sync.py')\ns = p.read_text()\na = s.index('        items = page.get(\"items\") or []')\nb = s.index('    store.set_state(conn, \"last_sync_at\"', a)\ns = s[:a] + '''        # Items and tombstones are separate arrays, not separate phases: a\n        # deleted SKU may be reissued later, even in the same sequence window.\n        changes = [(item[\"seq\"], False, item) for item in page.get(\"items\") or []]\n        cha"]
[51.895157, "i", "nges += [(item[\"seq\"], True, item) for item in page.get(\"tombstones\") or []]\n        with conn:\n            for _, deleted, item in sorted(changes, key=lambda change: change[0]):\n                if deleted:\n                    store.delete_product(conn, item[\"sku\"])\n                    stats[\"deletes\"] += 1\n                else:\n                    store.insert_product(conn, item)\n                    stats[\"upserts\"] += 1\n            # Even empty/compacted windows advance the cursor. Commit it with\n            # the changes so a failed page is safely replayed on the next run.\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\n''' + s[b:]\np.write_text(s)\nPY\n"]
