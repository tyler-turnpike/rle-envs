[140.679272, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[140.679648, "o", "\u001b[?2004h> expected = {}\r\n\u001b[?2004l\r\u001b[?2004h> for e in sorted((json.loads(line) for p in Path('dev/feed_data').glob('changes*.jsonl') for line in p.read_text().splitlines() if line.strip()), key=lambda e: e['seq']):"]
[140.679862, "o", "\r\n"]
[140.681076, "o", "\u001b[?2004l\r\u001b[?2004h>     if e['op'] == 'delete':\r\n\u001b[?2004l\r\u001b[?2004h>         expected.pop(e['sku'], None)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         expected[e['sku']] = (e['title'], int(Decimal(e['price']) * 100), e.get('currency', 'EUR'), e.get('updated_at'), e['seq'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.682297, "o", "with sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-backup/catalog-before-fix.db') as backup:\r\n\u001b[?2004l\r\u001b[?2004h>     actual = {r[0]: r[1:] for r in conn.execute('SELECT sku,title,price_cents,currency,updated_at,feed_seq FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     assert actual == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0] == len(expected)\r\n\u001b[?2004l\r\u001b[?2004h>     overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     assert overrides == backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h>     cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\r\n\u001b[?2004l\r\u001b[?2004h>     last = [json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines() if json.loads(line)['path'] == '/v2/changes"]
[140.682316, "o", "'][-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.683647, "o", "    assert last['cursor'] == last['next_cursor'] == cursor\r\n\u001b[?2004l\r\u001b[?2004h>     assert last['items'] == last['tombstones'] == 0 and last['has_more'] is False\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'PASS: {len(actual)} unique products exactly match the complete feed; integrity OK.')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'PASS: all {len(overrides)} original merchandising overrides unchanged.')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'PASS: incremental request at saved cursor {cursor}, no old changes downloaded.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[140.70793, "o", "PASS: 47 unique products exactly match the complete feed; integrity OK.\r\nPASS: all 34 original merchandising overrides unchanged.\r\nPASS: incremental request at saved cursor MjAyNi40NzoyMzM, no old changes downloaded.\r\n"]
