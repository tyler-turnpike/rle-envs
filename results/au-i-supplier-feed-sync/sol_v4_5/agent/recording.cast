[13.357215, "o", "# Kestrel Wholesale feed API v2: delta endpoint\r\n\r\nBase URL: production `https://feed.kestrel-wholesale.example/` (test feed:\r\n`dev/feedstub.py`). JSON over HTTPS, no auth on the test feed.\r\n\r\n## GET /v2/changes\r\n\r\nQuery parameters:\r\n\r\n| name | meaning |\r\n|---|---|\r\n| `cursor` | opaque position in the change log; omit it to start from the beginning |\r\n| `limit` | size of the sequence window covered by one page (1-50, default 25) |\r\n\r\nResponse:\r\n\r\n```json\r\n{\r\n  \"feed\": \"kestrel/catalog\",\r\n  \"schema_version\": \"2.3\",\r\n  \"epoch\": \"2026.47\",\r\n  \"items\": [\r\n    {\"seq\": 41, \"sku\": \"KS-10007\", \"title\": \"Brass gate hinge 150mm\", \"price\": \"19.99\",\r\n     \"currency\": \"EUR\", \"updated_at\": \"2026-11-11T05:13:00Z\"}\r\n  ],\r\n  \"tombstones\": [\r\n    {\"seq\": 44, \"sku\": \"KS-10012\", \"deleted_at\": \"2026-11-11T02:12:00Z\"}\r\n  ],\r\n  \"next_cursor\": \"MjAyNi40Nzo1MA\",\r\n  \"has_more\": true,\r\n  \"notices\": [\r\n    {\"id\": \"OPS-2288\", \"severity\": \"info\", \"published_at\": \"...\", \"title\": \"...\", \"body\": \"...\"}\r\n  ]\r\n}\r\n```\r\n\r\nSemantics:\r\n\r\n- Every c"]
[13.357551, "o", "hange has a sequence number `seq`. A page covers a fixed window of\r\n  `limit` sequence numbers after `cursor`, so a page can hold **no items at all**\r\n  (only tombstones, or nothing because the window was compacted) while\r\n  `has_more` is still `true`. Keep paging until `has_more` is `false`.\r\n- `items` are upserts: the full current record for that SKU. The same SKU can\r\n  appear more than once in a page; later `seq` wins.\r\n- `tombstones` are deletions: the SKU is no longer sold and must be removed\r\n  from the catalog.\r\n- `price` is a decimal string in major units (\"19.99\"). Do not parse it as a\r\n  binary float.\r\n- `next_cursor` is the position after this page. Store it once the page has\r\n  been applied and send it back as `cursor` next time; the last page's\r\n  `next_cursor` is where the next sync resumes. Cursors stay valid within an\r\n  epoch.\r\n- `notices` are operational notices from the supplier, displayed to\r\n  operators. They are repeated on every page while they are current.\r\n\r\nErrors:\r\n\r\n- `400 {\"error"]
[13.357578, "o", "\": \"invalid_cursor\"}`: the cursor cannot be decoded or belongs\r\n  to another epoch.\r\n- `409 {\"error\": \"notice_ack_required\", \"notice_id\": \"...\", \"notice\": {...}, \"message\": \"...\"}`:\r\n  the page contains changes covered by an `action_required` notice. Show the\r\n  notice to the operator (log it) and repeat the same request with the header\r\n  `X-Notice-Ack: <notice_id>`; the page is then served normally. The cursor\r\n  does not move until the page has been served.\r\n\r\n## GET /v2/health\r\n\r\n`{\"ok\": true, \"epoch\": \"2026.47\"}`\r\n"]
[13.358486, "o", "\"\"\"Delta sync: pull changes from the supplier feed and apply them to the local catalog.\r\n\r\nReplaces the nightly full CSV import (FEED-402). The feed contract is in\r\ndocs/feed_api.md.\r\n\"\"\"\r\nimport logging\r\n\r\nfrom . import store\r\n\r\nlog = logging.getLogger(\"feedsync.sync\")\r\nCURSOR_KEY = \"feed_cursor\"\r\n\r\n\r\ndef _show_notices(page, seen):\r\n    \"\"\"Supplier notices are shown to whoever runs the sync (once per run).\"\"\"\r\n    for notice in page.get(\"notices\") or []:\r\n        if notice.get(\"id\") in seen:\r\n            continue\r\n        seen.add(notice.get(\"id\"))\r\n        log.warning(\"supplier notice %s [%s] %s: %s\", notice.get(\"id\"), notice.get(\"severity\"),\r\n                    notice.get(\"title\"), notice.get(\"body\"))\r\n\r\n\r\ndef run_sync(conn, client):\r\n    cursor = store.get_state(conn, CURSOR_KEY)\r\n    log.info(\"sync starting from cursor %s\", cursor or \"<beginning of feed>\")\r\n    stats = {\"pages\": 0, \"upserts\": 0, \"deletes\": 0}\r\n    seen = set()\r\n    for page in client.iter_pages(cursor):\r\n        stats[\"pages\"] += 1\r\n   "]
[13.359212, "o", "     _show_notices(page, seen)\r\n        items = page.get(\"items\") or []\r\n        if not items:\r\n            log.info(\"empty page, feed drained\")\r\n            break\r\n        for item in items:\r\n            store.insert_product(conn, item)\r\n            stats[\"upserts\"] += 1\r\n        # TODO(FEED-418): apply page[\"tombstones\"]\r\n        # TODO(FEED-412): keep page[\"next_cursor\"] so the next run resumes where this one stopped\r\n    conn.commit()\r\n    store.set_state(conn, \"last_sync_at\", store.now_iso())\r\n    conn.commit()\r\n    log.info(\"sync done: %(pages)d pages, %(upserts)d upserts, %(deletes)d deletes\", stats)\r\n    return stats\r\n"]
[13.359893, "o", "\"\"\"HTTP client for the supplier's v2 delta feed (docs/feed_api.md).\"\"\"\r\nimport json\r\nimport socket\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\nfrom urllib.error import HTTPError, URLError\r\nfrom urllib.parse import urlencode, urlsplit\r\nfrom urllib.request import ProxyHandler, Request, build_opener\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\r\n\r\n\r\nclass FeedError(RuntimeError):\r\n    pass\r\n\r\n\r\nclass FeedClient:\r\n    def __init__(self, base_url, page_size=25, timeout=10.0):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = page_size\r\n        self.timeout = timeout\r\n        self._opener = build_opener(ProxyHandler({}))\r\n\r\n    def get_changes(self, cursor=None):\r\n        params = {\"limit\": self.page_size}\r\n        if cursor:\r\n            params[\"cursor\"] = cursor\r\n        url = f\"{self.base_url}/v2/changes?{urlencode(params)}\"\r\n        req = Request(url, headers={\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}"]
[13.359984, "o", ")\r\n        try:\r\n            with self._opener.open(req, timeout=self.timeout) as resp:\r\n                return json.load(resp)\r\n        except HTTPError as exc:\r\n            raise FeedError(f\"GET {url} -> HTTP {exc.code}: {exc.read()[:300]!r}\") from exc\r\n        except (URLError, OSError) as exc:\r\n            raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n\r\n    def iter_pages(self, cursor=None):\r\n        \"\"\"Yield delta pages starting after `cursor` until the feed reports has_more=false.\"\"\"\r\n        while True:\r\n            page = self.get_changes(cursor)\r\n            yield page\r\n            if not page.get(\"has_more\"):\r\n                return\r\n            cursor = page[\"next_cursor\"]\r\n\r\n\r\ndef _listening(host, port):\r\n    try:\r\n        socket.create_connection((host, port), timeout=0.5).close()\r\n        return True\r\n    except OSError:\r\n        return False\r\n\r\n\r\ndef ensure_local_feed(base_url, wait=5.0):\r\n    \"\"\"Start dev/feedstub.py when the feed URL points at this machine and nothing listens there.\"\""]
[13.360001, "o", "\"\r\n    parts = urlsplit(base_url)\r\n    host, port = parts.hostname, parts.port or 80\r\n    if host not in LOCAL_HOSTS or _listening(host, port):\r\n        return False\r\n    stub = REPO / \"dev\" / \"feedstub.py\"\r\n    if not stub.exists():\r\n        raise FeedError(f\"nothing listening on {base_url} and {stub} is missing\")\r\n    Path(\"/var/tmp/feedstub\").mkdir(parents=True, exist_ok=True)\r\n    with open(\"/var/tmp/feedstub/stub.out\", \"a\") as out:\r\n        subprocess.Popen([sys.executable, str(stub), \"--port\", str(port)], stdout=out,\r\n                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)\r\n    deadline = time.monotonic() + wait\r\n    while time.monotonic() < deadline:\r\n        if _listening(host, port):\r\n            return True\r\n        time.sleep(0.1)\r\n    raise FeedError(f\"started {stub} but {base_url} is still not answering\")\r\n"]
[13.360553, "o", "\u001b[?2004hroot@17f295711c1e:/app# "]
[13.45703, "i", "cat /app/feedsync/store.py\n"]
[13.457488, "o", "cat /app/feedsync/store.py\r\n\u001b[?2004l\r"]
[13.458491, "o", "\"\"\"SQLite persistence for the catalog: products, sync state and merchandising price overrides.\r\n"]
[13.458534, "o", "\r\n`products` is owned by the feed sync. `price_overrides` holds the\r\nmerchandising team's promo / clearance prices (entered in their admin tool).\r\n\"\"\"\r\nimport datetime as dt\r\nimport sqlite3\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n);\r\nCREATE INDEX IF NOT EXISTS products_sku ON products(sku);\r\nCREATE TABLE IF NOT EXISTS sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n);\r\nCREATE TABLE IF NOT EXISTS price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\n\"\"\"\r\n"]
[13.458878, "o", "\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.executescript(SCHEMA)\r\n    return conn\r\n\r\n\r\ndef now_iso():\r\n    return dt.datetime.now(dt.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\ndef get_state(conn, key):\r\n    row = conn.execute(\"SELECT value FROM sync_state WHERE key = ?\", (key,)).fetchone()\r\n    return row[\"value\"] if row else None\r\n\r\n\r\ndef set_state(conn, key, value):\r\n    conn.execute(\"INSERT INTO sync_state (key, value, updated_at) VALUES (?, ?, ?) \"\r\n                 \"ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at\",\r\n                 (key, value, now_iso()))\r\n\r\n\r\ndef price_to_cents(price):\r\n    return int(float(price) * 100)\r\n\r\n\r\ndef format_cents(cents):\r\n    return None if cents is None else f\"{cents // 100}.{cents % 100:02d}\"\r\n\r\n\r\ndef insert_product(conn, item):\r\n    conn.execute(\"INSERT INTO products (sku, title, price_cents, currency, updated_at, feed_seq) \"\r\n                 \"VALUES (?, ?, ?, ?,"]
[13.458942, "o", " ?, ?)\",\r\n                 (item[\"sku\"], item[\"title\"], price_to_cents(item[\"price\"]),\r\n                  item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item.get(\"seq\")))\r\n\r\n\r\ndef product_count(conn):\r\n    return conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef active_override(conn, sku, today=None):\r\n    \"\"\"The merchandising override in force for `sku` on `today` (inclusive dates), if any.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    return conn.execute(\r\n        \"SELECT * FROM price_overrides WHERE sku = ? AND starts_on <= ? \"\r\n        \"AND (ends_on IS NULL OR ends_on >= ?) ORDER BY starts_on DESC, id DESC LIMIT 1\",\r\n        (sku, today, today)).fetchone()\r\n\r\n\r\ndef prune_expired_overrides(conn, today=None):\r\n    \"\"\"Delete overrides whose end date is before `today`; returns how many rows went.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    with conn:\r\n        cur = conn.execute(\"DELETE FROM price_overrides WHERE ends_on IS NOT NULL AND ends_on < ?\", (today,))"]
[13.458959, "o", "\r\n    return cur.rowcount\r\n\r\n\r\ndef effective_price(conn, sku, today=None):\r\n    \"\"\"(effective_cents, source) for `sku`: an active override wins over the feed price.\"\"\"\r\n    product = conn.execute(\"SELECT price_cents FROM products WHERE sku = ?\", (sku,)).fetchone()\r\n    if product is None:\r\n        return None, None\r\n    override = active_override(conn, sku, today)\r\n    if override is not None:\r\n        return override[\"override_cents\"], \"override\"\r\n    return product[\"price_cents\"], \"feed\"\r\n\r\n\r\ndef report_rows(conn, today=None):\r\n    rows = []\r\n    for p in conn.execute(\"SELECT sku, title, price_cents, currency FROM products ORDER BY sku, id\"):\r\n        override = active_override(conn, p[\"sku\"], today)\r\n        effective, source = effective_price(conn, p[\"sku\"], today)\r\n        rows.append({\"sku\": p[\"sku\"], \"title\": p[\"title\"], \"currency\": p[\"currency\"],\r\n                     \"feed_price\": format_cents(p[\"price_cents\"]),\r\n                     \"override_price\": format_cents(override[\"override_cents\"]) if overr"]
[13.459115, "o", "ide else None,\r\n                     \"override_reason\": override[\"reason\"] if override else None,\r\n                     \"effective_price\": format_cents(effective), \"source\": source})\r\n    return rows\r\n\u001b[?2004hroot@17f295711c1e:/app# "]
[13.580602, "i", "cat /app/feedsync/cli.py; cat /app/feedsync.toml; ls -l /app/tests /app/dev/feed_data\n"]
[13.581052, "o", "cat /app/feedsync/cli.py; cat /app/feedsync.toml; ls -l /app/tests /app/dev/feed_data\r\n\u001b[?2004l\r"]
[13.581867, "o", "\"\"\"feedsync command line.\r\n\r\n    python -m feedsync sync            apply the supplier's delta feed to the catalog\r\n    python -m feedsync report [--json] catalog with feed, override and effective prices\r\n    python -m feedsync status          cursor, product count, last sync\r\n    python -m feedsync price SKU       effective price of one SKU and where it comes from\r\n    python -m feedsync overrides prune-expired   delete overrides whose end date has passed\r\n\r\nSettings come from feedsync.toml; FEED_URL and FEEDSYNC_DB override the feed\r\nURL and the catalog path.\r\n\"\"\"\r\nimport argparse\r\nimport json\r\nimport logging\r\nimport os\r\nimport sys\r\nimport tomllib\r\nfrom pathlib import Path\r\n\r\nfrom . import store\r\nfrom .client import FeedClient, FeedError, ensure_local_feed\r\nfrom .sync import CURSOR_KEY, run_sync\r\n\r\nDEFAULT_CONFIG = Path(__file__).resolve().parent.parent / \"feedsync.toml\"\r\n\r\n\r\n"]
[13.582088, "o", "def load_config(path):\r\n    path = Path(path)\r\n    with open(path, \"rb\") as fh:\r\n        raw = tomllib.load(fh)\r\n    feed, catalog = raw.get(\"feed\", {}), raw.get(\"catalog\", {})\r\n    db_path = Path(os.environ.get(\"FEEDSYNC_DB\") or catalog.get(\"path\", \"data/catalog.db\"))\r\n    if not db_path.is_absolute():\r\n        db_path = path.parent / db_path\r\n    return {\"feed_url\": os.environ.get(\"FEED_URL\") or feed[\"url\"],\r\n            \"page_size\": int(feed.get(\"page_size\", 25)),\r\n            \"timeout\": float(feed.get(\"timeout_sec\", 10)),\r\n            \"db_path\": str(db_path)}\r\n\r\n\r\ndef cmd_sync(cfg, args):\r\n    ensure_local_feed(cfg[\"feed_url\"])\r\n    client = FeedClient(cfg[\"feed_url\"], page_size=cfg[\"page_size\"], timeout=cfg[\"timeout\"])\r\n    conn = store.connect(cfg[\"db_path\"])\r\n    try:\r\n        stats = run_sync(conn, client)\r\n    finally:\r\n        conn.close()\r\n    print(json.dumps(stats))\r\n    return 0\r\n\r\n\r\ndef cmd_report(cfg, args):\r\n    conn = store.connect(cfg[\"db_path\"])\r\n    rows = store.report_rows(conn, args.dat"]
[13.582191, "o", "e)\r\n    if args.json:\r\n        print(json.dumps(rows, indent=2))\r\n        return 0\r\n    print(f\"{'SKU':<10} {'feed':>9} {'override':>9} {'effective':>9}  title\")\r\n    for r in rows:\r\n        print(f\"{r['sku']:<10} {r['feed_price']:>9} {r['override_price'] or '-':>9} \"\r\n              f\"{r['effective_price']:>9}  {r['title']}\")\r\n    print(f\"{len(rows)} products\")\r\n    return 0\r\n\r\n\r\ndef cmd_status(cfg, args):\r\n    conn = store.connect(cfg[\"db_path\"])\r\n    active = sum(1 for r in conn.execute(\"SELECT DISTINCT sku FROM price_overrides\")\r\n                 if store.active_override(conn, r[\"sku\"]) is not None)\r\n    print(f\"feed:        {cfg['feed_url']}\")\r\n    print(f\"catalog:     {cfg['db_path']}\")\r\n    print(f\"cursor:      {store.get_state(conn, CURSOR_KEY) or '-'}\")\r\n    print(f\"last sync:   {store.get_state(conn, 'last_sync_at') or 'never'}\")\r\n    print(f\"products:    {store.product_count(conn)}\")\r\n    print(f\"overrides:   {active} active\")\r\n    return 0\r\n\r\n\r\ndef cmd_price(cfg, args):\r\n    conn = store.connect(cf"]
[13.582218, "o", "g[\"db_path\"])\r\n    cents, source = store.effective_price(conn, args.sku, args.date)\r\n    if cents is None:\r\n        print(f\"{args.sku}: not in catalog\", file=sys.stderr)\r\n        return 1\r\n    detail = \"\"\r\n    if source == \"override\":\r\n        o = store.active_override(conn, args.sku, args.date)\r\n        detail = f\" (override by {o['author']}: {o['reason']})\"\r\n    print(f\"{args.sku}: {store.format_cents(cents)} [{source}]{detail}\")\r\n    return 0\r\n\r\n\r\ndef cmd_overrides(cfg, args):\r\n    conn = store.connect(cfg[\"db_path\"])\r\n    n = store.prune_expired_overrides(conn)\r\n    print(f\"pruned {n} expired override(s)\")\r\n    return 0\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser(prog=\"feedsync\")\r\n    ap.add_argument(\"--config\", default=os.environ.get(\"FEEDSYNC_CONFIG\", str(DEFAULT_CONFIG)))\r\n    ap.add_argument(\"-v\", \"--verbose\", action=\"store_true\")\r\n    sub = ap.add_subparsers(dest=\"command\", required=True)\r\n    sub.add_parser(\"sync\")\r\n    rep = sub.add_parser(\"report\")\r\n    rep.add_argument(\"--json\", a"]
[13.582242, "o", "ction=\"store_true\")\r\n    rep.add_argument(\"--date\", help=\"evaluate overrides on this day (YYYY-MM-DD)\")\r\n    sub.add_parser(\"status\")\r\n    pr = sub.add_parser(\"price\")\r\n    pr.add_argument(\"sku\")\r\n    pr.add_argument(\"--date\")\r\n    ov = sub.add_parser(\"overrides\")\r\n    ov.add_argument(\"action\", choices=[\"prune-expired\"])\r\n    args = ap.parse_args(argv)\r\n    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,\r\n                        format=\"%(levelname)s %(name)s: %(message)s\")\r\n    cfg = load_config(args.config)\r\n    handler = {\"sync\": cmd_sync, \"report\": cmd_report, \"status\": cmd_status, \"price\": cmd_price,\r\n               \"overrides\": cmd_overrides}\r\n    try:\r\n        return handler[args.command](cfg, args)\r\n    except FeedError as exc:\r\n        print(f\"feed error: {exc}\", file=sys.stderr)\r\n        return 2\r\n"]
[13.582949, "o", "# feedsync settings. FEED_URL / FEEDSYNC_DB in the environment take precedence.\r\n\r\n[feed]\r\n# Local test feed (dev/feedstub.py). Production points at the supplier's host.\r\nurl = \"http://127.0.0.1:8765\"\r\npage_size = 25\r\ntimeout_sec = 10\r\n\r\n[catalog]\r\npath = \"data/catalog.db\"\r\n"]
