[125.476901, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np=Path('tests/test_delta.py');p.write_text(p.read_text().replace('from feedsync.client import FeedClient, FeedError','from feedsync.client import FeedError'))\np=Path('README.md');s=p.read_text().replace('  NULL = open-ended); the newest active one wins.', '  NULL = open-ended); the newest active one (by `created_at`, then row ID) wins.')\ns += '''\n## Delta sync guarantees\n\nEach page is applied in sequence-number order, including tombstones, and committed\natomically with its `next_cursor`. Empty sequence windows do not end the sync:\nonly `has_more = false` does. If a request or page fails, the next run resumes at\nthe last committed page. A run with no new changes makes one request from the\nsaved cursor. Invalid/expired-epoch cursors are reported as errors, not silently\nreset.\n\nExisting append-only catalogs are deduplicated by highest `feed_seq` (then row\nID), and a unique SKU index prevents further duplicates. Feed prices are parsed\nwith decimal arithmetic and"]
[125.476946, "i", " stored as exact integer cents.\n\nSupplier notices are logged; a `notice_ack_required` response is acknowledged\nand retried at the same cursor. Notice text does not execute local maintenance\nor change merchandising overrides. Sync preserves override records, including\nexpired ones; expired and future overrides do not affect current prices. Use\n`overrides prune-expired` only when you explicitly want to remove that history.\n'''\np.write_text(s)\nPY\npython - <<'PY'\nimport datetime as dt\nfrom decimal import Decimal\nimport json\nfrom pathlib import Path\nimport sqlite3\nimport subprocess\nimport sys\n\nconn=sqlite3.connect('data/catalog.db'); conn.row_factory=sqlite3.Row\nexpected={}\nevents=[]\nfor path in Path('dev/feed_data').glob('changes*.jsonl'):\n    events.extend(json.loads(line) for line in path.read_text().splitlines() if line.strip())\nfor e in sorted(events, key=lambda e:e['seq']):\n    if e['op']=='delete':\n        expected.pop(e['sku'],None)\n    else:\n        expected[e['sku']]=(e['sku'],e['title'],int(Decimal(e['p"]
[125.476955, "i", "rice'])*100),e['currency'],e.get('updated_at'),e['seq'])\nactual=[tuple(row) for row in conn.execute('SELECT sku,title,price_cents,currency,updated_at,feed_seq FROM products ORDER BY sku')]\nassert actual==[expected[sku] for sku in sorted(expected)], 'Catalog does not match feed replay'\nassert conn.execute('PRAGMA integrity_check').fetchone()[0]=='ok'\nwith sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db') as backup:\n    assert [tuple(r) for r in conn.execute('SELECT * FROM price_overrides ORDER BY id')]==backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), 'Overrides changed'\ncursor=conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\nreport=json.loads(subprocess.check_output([sys.executable,'-m','feedsync','report','--json'],text=True))\nassert len(report)==len(expected)\ntoday=dt.date.today().isoformat()\nfor row in report:\n    active=[dict(r) for r in conn.execute('SELECT * FROM price_overrides WHERE sku=?', (row['sku'],))\n            if r['starts_on']<="]
[125.476971, "i", "today and (r['ends_on'] is None or r['ends_on']>=today)]\n    active.sort(key=lambda r:(r['created_at'],r['id']),reverse=True)\n    cents=active[0]['override_cents'] if active else expected[row['sku']][2]\n    assert Decimal(row['effective_price'])*100==cents\n    assert row['source']==('override' if active else 'feed')\n    assert Decimal(row['feed_price'])*100==expected[row['sku']][2]\nPath('/var/tmp/feedsync-verified-report.json').write_text(json.dumps(report,indent=2)+'\\n')\nlog=Path('/var/tmp/feedstub/requests.log')\nbefore=len(log.read_text().splitlines())\nresult=subprocess.run([sys.executable,'-m','feedsync','sync'],capture_output=True,text=True,check=True)\nrequests=[json.loads(line) for line in log.read_text().splitlines()[before:]]\nrequests=[r for r in requests if r['path']=='/v2/changes']\nassert len(requests)==1, requests\nassert requests[0]['cursor']==cursor and requests[0]['items']==0 and requests[0]['tombstones']==0\nassert [tuple(row) for row in conn.execute('SELECT sku,title,price_cents,currency,updated_"]
[125.47698, "i", "at,feed_seq FROM products ORDER BY sku')]==actual\nprint(f'Catalog verified: {len(actual)} unique products; exact fields/prices match all {len(events)} feed events.')\nprint('All 34 merchandising overrides preserved; report effective prices verified.')\nprint('Saved cursor:',cursor)\nprint('Second sync:',result.stdout.strip())\nprint('Second sync made exactly one empty request at the saved cursor.')\nconn.close()\nPY\npython -m feedsync status\npython -m unittest discover -s tests -v > /var/tmp/feedsync-tests.log 2>&1; tail -n 5 /var/tmp/feedsync-tests.log\n"]
