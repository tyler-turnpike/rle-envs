[240.113725, "i", "cd /app && python - <<'PY'\nimport datetime as dt\nfrom decimal import Decimal\nimport json, sqlite3, subprocess, sys\nfrom pathlib import Path\nexpected = {}\nfor path in sorted(Path('dev/feed_data').glob('changes*.jsonl')):\n for e in sorted((json.loads(line) for line in path.read_text().splitlines() if line.strip()), key=lambda e:e['seq']):\n  if e['op'] == 'delete': expected.pop(e['sku'], None)\n  else: expected[e['sku']] = (e['sku'], e['title'], int(Decimal(e['price']) * 100), e.get('currency','EUR'), e.get('updated_at'), e['seq'])\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db') as before:\n actual = conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products ORDER BY sku').fetchall()\n assert actual == sorted(expected.values()), 'catalog differs from full delta replay'\n overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n assert overrides == before.execute('SELECT * FROM price_overrides ORDER BY "]
[240.113848, "i", "id').fetchall(), 'overrides changed'\n assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n saved_cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\n report = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\n assert len(report) == len(expected) == len({r['sku'] for r in report})\n today = dt.date.today().isoformat()\n active_count = 0\n for row in report:\n  override = conn.execute('SELECT override_cents FROM price_overrides WHERE sku=? AND starts_on<=? AND (ends_on IS NULL OR ends_on>=?) ORDER BY starts_on DESC,id DESC LIMIT 1', (row['sku'],today,today)).fetchone()\n  cents = override[0] if override else expected[row['sku']][2]\n  assert row['effective_price'] == f'{cents//100}.{cents%100:02d}'\n  assert row['source'] == ('override' if override else 'feed')\n  active_count += bool(override)\n print(f'Validated {len(actual)} unique products, every product field, all report prices, {active_count} active report "]
[240.113868, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[240.113878, "i", "overrides, {len(overrides)} unchanged override records, and database integrity.')\nlog = Path('/var/tmp/feedstub/requests.log')\nprevious = len(log.read_text().splitlines())\nsubprocess.run([sys.executable, '-m', 'feedsync', 'sync'], check=True)\nnew = [json.loads(line) for line in log.read_text().splitlines()[previous:]]\nchanges = [r for r in new if r['path'] == '/v2/changes']\nassert len(changes) == 1, changes\nassert changes[0]['cursor'] == saved_cursor, changes\nassert changes[0]['items'] == changes[0]['tombstones'] == 0, changes\nprint('Second sync verified: exactly one request at stored cursor, no old pages downloaded.')\nprint('Request:', changes[0])\nPY\n"]
