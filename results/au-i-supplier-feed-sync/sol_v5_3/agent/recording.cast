[76.168068, "i", "cd /app && cat dev/feed_data/notices.json && tail -12 feedsync/cli.py && python - <<'PY'\nimport sqlite3, json\nc = sqlite3.connect('data/catalog.db')\nfor t in ('products','sync_state','price_overrides'):\n print(t, c.execute(f'SELECT COUNT(*) FROM {t}').fetchone()[0])\nprint('state:', c.execute('SELECT * FROM sync_state').fetchall())\nprint('duplicates:', c.execute('SELECT sku, COUNT(*) FROM products GROUP BY sku HAVING COUNT(*)>1').fetchall())\nprint('schema:', c.execute(\"SELECT sql FROM sqlite_master WHERE tbl_name='products'\").fetchall())\nevents = [json.loads(x) for x in open('dev/feed_data/changes.jsonl') if x.strip()]\nprint('events:',len(events),'last seq:',max(e['seq'] for e in events))\nprint('gated events:', [(e['seq'],e['sku'],e.get('gate')) for e in events if e.get('gate')])\nPY\n"]
