[71.878237, "i", "\n    store.set_state(conn, \"last_sync_at\", store.now_iso())\n    conn.commit()\n''', '''        changes = [(item, False) for item in page.get(\"items\") or []]\n        changes.extend((item, True) for item in page.get(\"tombstones\") or [])\n        # The API separates upserts and deletes, but their sequences interleave.\n        # A page and its cursor must either both commit or both roll back.\n        with conn:\n            for item, deleted in sorted(changes, key=lambda change: change[0][\"seq\"]):\n                if deleted:\n                    store.delete_product(conn, item)\n                    stats[\"deletes\"] += 1\n                else:\n                    store.insert_product(conn, item)\n                    stats[\"upserts\"] += 1\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\n    with conn:\n        store.set_state(conn, \"last_sync_at\", store.now_iso())\n''')\np.write_text(s)\np=Path('feedsync/client.py'); s=p.read_text().replace('import json\\n','import json\\nimport logging\\n')\na=s.index('        "]
[71.878244, "i", "req = Request(url, headers='); b=s.index('\\n    def iter_pages',a)\ns=s[:a]+'''        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\n        acknowledged = set()\n        while True:\n            req = Request(url, headers=headers)\n            try:\n                with self._opener.open(req, timeout=self.timeout) as resp:\n                    return json.load(resp)\n            except HTTPError as exc:\n                with exc:\n                    body = exc.read()\n                if exc.code == 409:\n                    try:\n                        error = json.loads(body)\n                    except (ValueError, UnicodeDecodeError):\n                        error = {}\n                    notice_id = error.get(\"notice_id\") if isinstance(error, dict) else None\n                    if (isinstance(error, dict) and error.get(\"error\") == \"notice_ack_required\"\n                            and isinstance(notice_id, str) and notice_id\n                            and notice_id not in acknowledged):\n   "]
[71.878258, "i", "                     # Notices are supplier data to display, never local commands to execute.\n                        logging.getLogger(__name__).warning(\n                            \"supplier notice %s requires acknowledgement: %s; %s\",\n                            notice_id, error.get(\"notice\"), error.get(\"message\", \"\"))\n                        acknowledged.add(notice_id)\n                        headers[\"X-Notice-Ack\"] = notice_id\n                        continue  # Same URL and cursor; only the acknowledgement changes.\n                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\n            except (URLError, OSError) as exc:\n                raise FeedError(f\"GET {url} failed: {exc}\") from exc\n\n''' + s[b:]\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
