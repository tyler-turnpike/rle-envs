[124.94082, "i", " with self.assertLogs('feedsync.client', level='WARNING') as logs:\n            self.assertEqual(self.client.get_changes('opaque+/='), page)\n        self.assertIn('Display this notice.', '\\n'.join(logs.output))\n        first, second = [call.args[0] for call in self.client._opener.open.call_args_list]\n        self.assertEqual(first.full_url, second.full_url)\n        self.assertIsNone(first.get_header('X-notice-ack'))\n        self.assertEqual(second.get_header('X-notice-ack'), 'OPS-1')\n\n    def test_repeated_gate_fails_instead_of_looping(self):\n        gated = {'error': 'notice_ack_required', 'notice_id': 'OPS-1'}\n        self.client._opener.open.side_effect = [error(409, gated), error(409, gated)]\n        with self.assertLogs('feedsync.client'), self.assertRaises(FeedError):\n            self.client.get_changes('opaque')\n        self.assertEqual(self.client._opener.open.call_count, 2)\n\n    def test_invalid_cursor_is_not_silently_reset(self):\n        self.client._opener.open.side_effect = error(400, {'error': 'in"]
[124.940828, "i", "valid_cursor'})\n        with self.assertRaises(FeedError):\n            self.client.get_changes('old-epoch')\n        self.assertEqual(self.client._opener.open.call_count, 1)\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text()\ns = s.replace('\\n\\nif __name__ == \"__main__\":', '''\n\n    def test_no_change_sync_only_checks_saved_cursor(self):\n        self.cli(\"sync\")\n        first = self.requests()\n        stats = json.loads(self.cli(\"sync\"))\n        second = self.requests()[len(first):]\n        self.assertEqual(len(second), 1)\n        self.assertEqual(second[0][\"cursor\"], first[-1][\"next_cursor\"])\n        self.assertEqual(stats, {\"pages\": 1, \"upserts\": 0, \"deletes\": 0})\n\n    def test_gated_page_preserves_all_override_history(self):\n        self.cli(\"sync\")\n        with sqlite3.connect(self.db) as conn:\n            conn.execute(\"INSERT INTO price_overrides (sku, override_cents, starts_on, ends_on, \"\n                         \"author, reason, created_at) VALUES \"\n              "]
[124.940832, "i", "           \"('T-003', 99, '2020-01-01', '2020-02-01', 'merch', 'expired history', '2020-01-01'), \"\n                         \"('T-003', 88, '2090-01-01', NULL, 'merch', 'future', '2026-01-01'), \"\n                         \"('T-005', 799, '2024-01-01', NULL, 'merch', 'active', '2026-01-01')\")\n            before = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n        event = upsert(22, 'T-003', 'Reissued tap', '1.99')\n        event['gate'] = 'OPS-TEST'\n        self.write_batch('changes_2.jsonl', [event])\n        (self.data / 'notices.json').write_text(json.dumps([{\n            'id': 'OPS-TEST', 'severity': 'action_required', 'title': 'Reissued codes',\n            'body': 'Remove expired local overrides before proceeding.'}]))\n        start = len(self.requests())\n        self.cli('sync')\n        requests = self.requests()[start:]\n        self.assertEqual([r['status'] for r in requests], [409, 200])\n        self.assertEqual(requests[0]['cursor'], requests[1]['cursor'])\n        self.assertEqu"]
[124.942844, "i", "al(requests[1]['ack'], 'OPS-TEST')\n        with sqlite3.connect(self.db) as conn:\n            self.assertEqual(conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), before)\n        rows = {r['sku']: r for r in json.loads(self.cli('report', '--json'))}\n        self.assertEqual((rows['T-003']['effective_price'], rows['T-003']['source']), ('1.99', 'feed'))\n        self.assertEqual((rows['T-005']['effective_price'], rows['T-005']['source']), ('7.99', 'override'))\n\n\nif __name__ == \"__main__\":''')\np.write_text(s)\np=Path('feedsync/client.py'); s=p.read_text().replace('from exc\\n\\n\\n    def iter_pages', 'from exc\\n\\n    def iter_pages'); p.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
