[156.921936, "i", "python - <<'PY'\nimport datetime as dt\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\n\nexpected = {}\nevents = [json.loads(line) for path in sorted(Path('dev/feed_data').glob('changes*.jsonl'))\n          for line in path.read_text().splitlines() if line.strip()]\nfor event in sorted(events, key=lambda e: e['seq']):\n if event['op'] == 'delete':\n  expected.pop(event['sku'], None)\n else:\n  expected[event['sku']] = (event['title'], int(Decimal(event['price']) * 100),\n                            event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nwith sqlite3.connect('data/catalog.db') as conn:\n actual = {r[0]: r[1:] for r in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\n count = conn.execute('SELECT COUNT(*) FROM products').fetchone()[0]\n assert len(actual) == count == len(expected), (len(actual), count, len(expected))\n assert actual == expected, 'catalog differs from replayed feed'\n overrid"]
[156.922227, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.922301, "i", "es = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n assert json.loads(json.dumps(overrides)) == json.loads(Path('/var/tmp/feedsync-overrides-before.json').read_text())\n cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\n assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\nreport = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\nassert len(report) == len(expected)\ntoday = dt.date.today().isoformat()\nfor row in report:\n active = [o for o in overrides if o[1] == row['sku'] and o[3] <= today and (o[4] is None or o[4] >= today)]\n winner = max(active, key=lambda o: (o[7], o[0])) if active else None\n cents = winner[2] if winner else expected[row['sku']][1]\n assert row['effective_price'] == f'{cents // 100}.{cents % 100:02d}', row\n assert row['source'] == ('override' if winner else 'feed'), row\n assert row['feed_price'] == f'{expected[row[\"sku\"]][1] // 100}.{expected[row[\"sku\"]][1] % "]
[156.92231, "o", "import datetime as dt\r\n"]
[156.922316, "i", "100:02d}'\nprint(f'Validated {count} unique products, every feed field and effective report price; all {len(overrides)} overrides unchanged.')\nprint('Stored cursor:', cursor)\nlog = Path('/var/tmp/feedstub/requests.log')\nlines_before = len(log.read_text().splitlines())\nproc = subprocess.run([sys.executable, '-m', 'feedsync', 'sync'], capture_output=True, text=True, check=True)\nprint('Second sync:', proc.stdout.strip())\nassert json.loads(proc.stdout) == {'pages': 1, 'upserts': 0, 'deletes': 0}\nrequests = [json.loads(line) for line in log.read_text().splitlines()[lines_before:]]\nchanges = [r for r in requests if r['path'] == '/v2/changes']\nassert len(changes) == 1, changes\nassert changes[0]['cursor'] == cursor and changes[0]['next_cursor'] == cursor, changes\nprint('Incrementality verified: one request from the saved final cursor; no previously applied pages downloaded.')\nPY\n"]
