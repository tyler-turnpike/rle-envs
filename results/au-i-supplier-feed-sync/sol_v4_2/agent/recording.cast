[103.817435, "i", "cat > tests/test_store.py <<'PY'\n\"\"\"Storage invariants, including upgrades from the unfinished v2 schema.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\n\n\nclass StoreTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.path = Path(self.tmp.name) / 'catalog.db'\n        self.conn = store.connect(self.path)\n        self.addCleanup(self.conn.close)\n\n    def test_exact_cents(self):\n        for price, cents in [('4.35', 435), ('19.99', 1999), ('0.29', 29),\n                             ('0.57', 57), ('15.99', 1599), ('0', 0), ('-0.29', -29)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n                self.assertEqual(store.format_cents(cents), f'{float(price):.2f}')\n        with self.assertRaises(ValueError):\n            store.price_to_cents('0.001')\n\n    def test_legacy_duplicates_migrate_without"]
