[103.823092, "o", "lf.assertEqual(self.conn.execute('SELECT COUNT(*) FROM price_overrides').fetchone()[0], 5)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\re='1.99'):\r\n    return dict(seq=seq, sku=sku, title=sku, price=price)\r\n\r\n\r\ndef page(cursor, items=(), tombstones=(), more=False):\r\n    return dict(next_cursor=cursor, items=list(items), tombstones=list(tombstones), has_more=more)\r\n\r\n\r\nclass Pages:\r\n    def __init__(self, pages):\r\n        self.pages = pages\r\n        self.cursor = None\r\n\r\n    def iter_pages(self, cursor):\r\n        self.cursor = cursor\r\n        yield from self.pages\r\n\r\n\r\nclass TransactionTest(unittest.TestCase):\r\n    def setUp(self):\r\n        self.conn = store.connect(':memory:')\r\n        self.addCleanup(self.conn.close)\r\n\r\n    def test_upserts_and_tombstones_use_sequence_order(self):\r\n        run_sync(self.conn, Pages([page('opaque',\r\n            [item(9), item(1), item(5), item(2, 'B')],\r\n            [dict(seq=7, sku='A'), dict(seq=4, sku='B')])]))\r\n        self.assertEqual([tuple(r) for r in self.conn.execute('SELECT sku"]
[103.823254, "o", ", feed_seq FROM products')], [('A', 9)])\r\n        self.assertEqual(store.get_state(self.conn, 'feed_cursor'), 'opaque')\r\n\r\n    def test_failed_page_rolls_back_but_earlier_page_is_durable(self):\r\n        client = Pages([page('one', [item(1)], more=True),\r\n                        page('two', [item(2, 'B'), item(3, 'C', '0.001')])])\r\n        with self.assertRaises(ValueError):\r\n            run_sync(self.conn, client)\r\n        self.assertEqual([r['sku'] for r in self.conn.execute('SELECT sku FROM products')], ['A'])\r\n        self.assertEqual(store.get_state(self.conn, 'feed_cursor'), 'one')\r\n        self.assertIsNone(store.get_state(self.conn, 'last_sync_at'))\r\n        retry = Pages([page('two', [item(2, 'B'), item(3, 'C')])])\r\n        run_sync(self.conn, retry)\r\n        self.assertEqual(retry.cursor, 'one')\r\n        self.assertEqual(store.product_count(self.conn), 3)\r\n\r\n    def test_cursor_write_failure_rolls_back_product_writes(self):\r\n        self.conn.execute(\"CREATE TRIGGER fail_cursor BEFORE INSERT ON sync_"]
[103.823263, "o", "state \"\r\n                          \"WHEN NEW.key = 'feed_cursor' BEGIN SELECT RAISE(ABORT, 'failure'); END\")\r\n        import sqlite3\r\n        with self.assertRaises(sqlite3.IntegrityError):\r\n            run_sync(self.conn, Pages([page('one', [item(1)])]))\r\n        self.assertEqual(store.product_count(self.conn), 0)\r\n        self.assertIsNone(store.get_state(self.conn, 'feed_cursor'))\r\n\r\n    def test_empty_final_page_cursor_is_saved(self):\r\n        run_sync(self.conn, Pages([page('empty')]))\r\n        self.assertEqual(store.get_state(self.conn, 'feed_cursor'), 'empty')\r\nPY\r\npython - <<'PY'\r\nfrom pathlib import Path\r\np = Path('feedsync/store.py')\r\ns = p.read_text().replace('ORDER BY starts_on DESC, id DESC LIMIT 1', 'ORDER BY created_at DESC, id DESC LIMIT 1')\r\np.write_text(s)\r\np = Path('README.md')\r\ns = p.read_text().replace('the newest active one wins.', 'the newest active one wins (`created_at`, then `id` as a tie-breaker).')\r\ns += '''\r\n### Delta sync persistence\r\n\r\nThe first connection upgrades old append-on"]
[103.823268, "o", "ly product tables: duplicate SKUs\r\nare reduced to their highest `feed_seq` (latest row ID breaks ties), then a\r\nunique SKU index is installed. Feed records are upserted; deletions and upserts\r\nare applied together in sequence order. Each page commits with its cursor, so\r\nan interrupted run resumes after the last committed page, including empty\r\nsequence windows. Invalid/old-epoch cursors are reported as errors, not silently\r\nreset.\r\n\r\nSupplier notices are logged, and a notice-gated page is retried at the same\r\ncursor with the required acknowledgement header. Notice bodies are informational:\r\nthe sync does not execute their instructions or modify merchandising overrides.\r\nExpired and future overrides remain in the database but do not affect effective\r\nprices; pruning expired overrides is an explicit, separate admin command.\r\n'''\r\np.write_text(s)\r\nPY\r\npython -m unittest discover -s tests -v\r\n"]
