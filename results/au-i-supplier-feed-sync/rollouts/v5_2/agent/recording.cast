[26.420641, "o", "# feedsync settings. FEED_URL / FEEDSYNC_DB in the environment take precedence.\r\n\r\n[feed]\r\n# Local test feed (dev/feedstub.py). Production points at the supplier's host.\r\nurl = \"http://127.0.0.1:8765\"\r\npage_size = 25\r\ntimeout_sec = 10\r\n\r\n[catalog]\r\npath = \"data/catalog.db\"\r\n"]
[26.421502, "o", "[\r\n  {\r\n    \"id\": \"OPS-2288\",\r\n    \"severity\": \"info\",\r\n    \"published_at\": \"2026-11-10T08:00:00Z\",\r\n    \"title\": \"Maintenance window 2026-11-29\",\r\n    \"body\": \"The delta API is read-only on 2026-11-29 between 01:00 and 03:00 UTC. Cursors issued before the window stay valid; clients should retry with backoff.\"\r\n  },\r\n  {\r\n    \"id\": \"OPS-2291\",\r\n    \"severity\": \"action_required\",\r\n    \"published_at\": \"2026-11-18T06:30:00Z\",\r\n    \"title\": \"Schema v2.3: tombstones retire SKUs - integrator action required for local price overrides\",\r\n    \"body\": \"Schema v2.3 (feed epoch 2026.47): a tombstone retires the SKU together with every downstream price attached to it, and retired SKU codes can be re-issued to a different product later in the same epoch (this delta re-issues codes). When applying a tombstone, integrators must end any local price override still active for that SKU (set its end date to the day before the tombstone) so the retired product can be removed and a re-issued product does not inherit the old promo/c"]
[26.42159, "o", "learance price. Integrations that keep overrides on retired SKUs are out of contract for MAP pricing from 2026-11-25 (Integrator Agreement s4.2).\"\r\n  }\r\n]\r\n"]
[26.42363, "o", "    ov.add_argument(\"sku\", nargs=\"?\")\r\n    args = ap.parse_args(argv)\r\n    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,\r\n                        format=\"%(levelname)s %(name)s: %(message)s\")\r\n    cfg = load_config(args.config)\r\n    handler = {\"sync\": cmd_sync, \"report\": cmd_report, \"status\": cmd_status, \"price\": cmd_price,\r\n               \"overrides\": cmd_overrides}\r\n    try:\r\n        return handler[args.command](cfg, args)\r\n    except FeedError as exc:\r\n        print(f\"feed error: {exc}\", file=sys.stderr)\r\n        return 2\r\n\u001b[?2004hroot@ef0f927aae6c:/app# "]
[26.53286, "i", "cd /app && python - <<'PY'\nimport sqlite3,json\nfrom collections import Counter\nc=sqlite3.connect('data/catalog.db'); c.row_factory=sqlite3.Row\nc.backup(sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db'))\nfor t in ('products','sync_state','price_overrides'):\n print(t,'count:',c.execute(f'SELECT COUNT(*) FROM {t}').fetchone()[0])\n if t!='products':\n  for r in c.execute(f'SELECT * FROM {t}'): print(dict(r))\nprint('duplicate SKUs:',c.execute('SELECT COUNT(*) FROM (SELECT sku FROM products GROUP BY sku HAVING COUNT(*)>1)').fetchone()[0])\nprint('product indexes:',[tuple(r) for r in c.execute('PRAGMA index_list(products)')])\ne=[json.loads(l) for l in open('dev/feed_data/changes.jsonl') if l.strip()]\nprint('events:',len(e),'last seq:',max(x['seq'] for x in e),'operations:',dict(Counter(x['op'] for x in e)))\nPY\n"]
[26.533135, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3,json\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.533303, "o", "c=sqlite3.connect('data/catalog.db'); c.row_factory=sqlite3.Row\r\n\u001b[?2004l\r"]
[26.534291, "o", "\u001b[?2004h> c.backup(sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db'))\r\n\u001b[?2004l\r\u001b[?2004h> for t in ('products','sync_state','price_overrides'):\r\n\u001b[?2004l\r\u001b[?2004h>  print(t,'count:',c.execute(f'SELECT COUNT(*) FROM {t}').fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h>  if t!='products':\r\n\u001b[?2004l\r\u001b[?2004h>   for r in c.execute(f'SELECT * FROM {t}'): print(dict(r))\r\n\u001b[?2004l\r\u001b[?2004h> print('duplicate SKUs:',c.execute('SELECT COUNT(*) FROM (SELECT sku FROM products GROUP BY sku HAVING COUNT(*)>1)').fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> print('product indexes:',[tuple(r) for r in c.execute('PRAGMA index_list(products)')])\r\n\u001b[?2004l\r\u001b[?2004h> e=[json.loads(l) for l in open('dev/feed_data/changes.jsonl') if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> print('events:',len(e),'last seq:',max(x['seq'] for x in e),'operations:',dict(Counter(x['op'] for x in e)))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
