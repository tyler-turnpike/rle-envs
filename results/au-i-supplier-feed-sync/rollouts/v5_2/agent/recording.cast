[106.996203, "i", "cd /app && cat > tests/test_regressions.py <<'PY'\n\"\"\"Persistence and failure-recovery regressions for the v2 delta consumer.\"\"\"\nimport io\nimport json\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import Mock\nfrom urllib.error import HTTPError\n\nfrom feedsync import store\nfrom feedsync.client import FeedClient, FeedError\nfrom feedsync.sync import run_sync\n\n\ndef item(seq, sku=\"A\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"title\": f\"Product {seq}\", \"price\": price}\n\n\ndef page(cursor, items=(), tombstones=(), has_more=False):\n    return {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": has_more}\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.start = None\n\n    def iter_pages(self, cursor):\n        self.start = cursor\n        yield from self.pages\n\n\nclass StoreTests(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addClean"]
[106.996353, "i", "up(self.conn.close)\n\n    def test_exact_prices_and_formatting(self):\n        for price, cents in [(\"4.35\", 435), (\"0.29\", 29), (\"8.58\", 858),\n                             (\"19.99\", 1999), (\"0.57\", 57), (\"0.00\", 0),\n                             (\"-0.29\", -29)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n                self.assertEqual(store.format_cents(cents), price)\n        for price in (\"1.001\", \"NaN\", \"Infinity\"):\n            with self.subTest(price=price), self.assertRaises(ValueError):\n                store.price_to_cents(price)\n\n    def test_upsert_and_stale_events(self):\n        store.insert_product(self.conn, item(10, price=\"0.29\"))\n        store.insert_product(self.conn, item(5, price=\"19.99\"))\n        store.delete_product(self.conn, {\"sku\": \"A\", \"seq\": 6})\n        self.assertEqual(store.product_count(self.conn), 1)\n        self.assertEqual(self.conn.execute(\"SELECT price_cents FROM products\").fetchone()[0], 29)\n        store.inse"]
