[127.476185, "o", "SKU index is installed; prices are converted using exact decimal arithmetic.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.476411, "o", "Supplier notices are logged once per sync. A `notice_ack_required` response is\r\n\u001b[?2004l\r"]
