[127.475077, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np=Path('README.md'); s=p.read_text(); marker='## Tables\\n'\naddition='''## Delta sync behavior\n\nEach page is applied in sequence order and committed together with its opaque\ncursor, including tombstone-only and compacted/empty pages. If a later page\nfails, rerun `sync`: completed pages are retained and the failed page is retried.\nAn unchanged feed requires just one request at the stored cursor. Legacy\nappend-only catalogs are deduplicated by latest feed sequence before a unique\nSKU index is installed; prices are converted using exact decimal arithmetic.\n\nSupplier notices are logged once per sync. A `notice_ack_required` response is\nlogged and retried once at the same cursor with `X-Notice-Ack`; acknowledgment\nonly unlocks the feed page. It does not authorize changes to merchandising's\n`price_overrides`: sync deletes only feed-owned product rows, preserving override\nrecords and their inclusive validity dates even if a SKU is later reissued.\nAny override-policy"]
[127.475264, "i", " change mentioned by a supplier needs separate merchandising\nreview. Invalid/old-epoch cursors fail explicitly rather than silently restarting.\n\n'''\ns=s.replace(marker,addition+marker); p.write_text(s)\nPY\npython -m unittest discover -s tests -v > /var/tmp/feedsync-tests.log 2>&1; rc=$?; tail -6 /var/tmp/feedsync-tests.log; test \"$rc\" -eq 0\n"]
[127.475849, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r change mentioned by a supplier needs separate merchandising\r\nreview. Invalid/old-epoch cursors fail explicitly rather than silently restarting.\r\n\r\n'''\r\ns=s.replace(marker,addition+marker); p.write_text(s)\r\nPY\r\npython -m unittest discover -s tests -v > /var/tmp/feedsync-tests.log 2>&1; rc=$?; tail -6 /var/tmp/feedsync-tests.log; test \"$rc\" -eq 0\r\n\u001b[?2004h> "]
