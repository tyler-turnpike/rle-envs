[145.367908, "i", "cd /app && python - <<'PY'\nimport sqlite3\nc=sqlite3.connect('data/catalog.db')\nfor row in c.execute(\"SELECT type,name,tbl_name,sql FROM sqlite_master WHERE type IN ('trigger','view')\"):\n print('\\n',*row,sep='\\n')\nprint('all table schemas:')\nfor row in c.execute(\"SELECT name,sql FROM sqlite_master WHERE type='table'\"):\n print(*row,sep='\\n')\nprint('override changes since backup:')\nc.execute(\"ATTACH DATABASE '/var/tmp/feedsync-catalog-before-fix.db' AS old\")\nprint(c.execute('SELECT COUNT(*) FROM (SELECT * FROM price_overrides EXCEPT SELECT * FROM old.price_overrides)').fetchone()[0])\nPY\n"]
[145.368887, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> c=sqlite3.connect('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.36979, "o", "for row in c.execute(\"SELECT type,name,tbl_name,sql FROM sqlite_master WHERE type IN ('trigger','view')\"):\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n',*row,sep='\\n')\r\n\u001b[?2004l\r\u001b[?2004h> print('all table schemas:')\r\n\u001b[?2004l\r\u001b[?2004h> for row in c.execute(\"SELECT name,sql FROM sqlite_master WHERE type='table'\"):\r\n\u001b[?2004l\r\u001b[?2004h>  print(*row,sep='\\n')\r\n\u001b[?2004l\r\u001b[?2004h> print('override changes since backup:')\r\n\u001b[?2004l\r\u001b[?2004h> c.execute(\"ATTACH DATABASE '/var/tmp/feedsync-catalog-before-fix.db' AS old\")\r\n\u001b[?2004l\r\u001b[?2004h> print(c.execute('SELECT COUNT(*) FROM (SELECT * FROM price_overrides EXCEPT SELECT * FROM old.price_overrides)').fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[145.381155, "o", "\r\n\r\ntrigger\r\nmerch_guard_active_override\r\nproducts\r\nCREATE TRIGGER merch_guard_active_override\r\nBEFORE DELETE ON products\r\nWHEN EXISTS (SELECT 1 FROM price_overrides o WHERE o.sku = OLD.sku\r\n             AND o.starts_on <= date('now') AND (o.ends_on IS NULL OR o.ends_on >= date('now')))\r\nBEGIN\r\n    SELECT RAISE(ABORT, 'merch-guard: product has an active merchandising price override');\r\nEND"]
[145.381357, "o", "\r\nall table schemas:\r\nproducts\r\nCREATE TABLE products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n)\r\n"]
[145.38141, "o", "sqlite_sequence\r\nCREATE TABLE sqlite_sequence(name,seq)\r\nsync_state\r\nCREATE TABLE sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n)\r\nprice_overrides\r\nCREATE TABLE price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n)\r\noverride changes since backup:\r\n"]
[145.381604, "o", "0\r\n"]
[145.384038, "o", "\u001b[?2004hroot@ef0f927aae6c:/app# "]
[187.083151, "i", "cd /app && python - <<'PY'\nfrom pathlib import Path\np=Path('feedsync/store.py'); s=p.read_text()\ns=s.replace('CREATE TABLE IF NOT EXISTS sync_state (', '''CREATE TABLE IF NOT EXISTS feed_tombstones (\n    sku      TEXT PRIMARY KEY,\n    feed_seq INTEGER NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sync_state (''')\nmarker='\\n\\ndef connect(path):'\nconstants='''\n\n# Older catalogs disallowed every deletion of an overridden SKU. Keep that\n# protection for live products, but let authoritative feed retirements remove\n# the feed-owned row without changing merchandising's independent records.\nLEGACY_MERCH_GUARD = \"\"\"CREATE TRIGGER merch_guard_active_override\nBEFORE DELETE ON products\nWHEN EXISTS (SELECT 1 FROM price_overrides o WHERE o.sku = OLD.sku\n             AND o.starts_on <= date('now') AND (o.ends_on IS NULL OR o.ends_on >= date('now')))\nBEGIN\n    SELECT RAISE(ABORT, 'merch-guard: product has an active merchandising price override');\nEND\"\"\"\n\nMERCH_GUARD = LEGACY_MERCH_GUARD.replace(\"\\\\nBEGIN\", \"\"\"\nAND NOT EXISTS (SELEC"]
[187.083657, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.08367, "i", "T 1 FROM feed_tombstones t WHERE t.sku = OLD.sku\n                AND (OLD.feed_seq IS NULL OR t.feed_seq >= OLD.feed_seq))\nAND NOT EXISTS (SELECT 1 FROM products newer WHERE newer.sku = OLD.sku\n                AND (COALESCE(newer.feed_seq, -1) > COALESCE(OLD.feed_seq, -1)\n                     OR (COALESCE(newer.feed_seq, -1) = COALESCE(OLD.feed_seq, -1)\n                         AND newer.id > OLD.id)))\nBEGIN\"\"\")\n\n\ndef _sql_normalized(sql):\n    return \" \".join(sql.rstrip(\"; \\\\n\").split())\n'''\ns=s.replace(marker,constants+marker)\ns=s.replace('    # Upgrade append-only catalogs', '''    guard = conn.execute(\"SELECT sql FROM sqlite_master WHERE type = 'trigger' \"\n                         \"AND name = 'merch_guard_active_override'\").fetchone()\n    with conn:\n        if guard and _sql_normalized(guard[\"sql\"]) == _sql_normalized(LEGACY_MERCH_GUARD):\n            conn.execute(\"DROP TRIGGER merch_guard_active_override\")\n            conn.execute(MERCH_GUARD)\n        elif guard is None:\n            conn.execute(MERCH_GUAR"]
[187.083763, "i", "D)\n    # Upgrade append-only catalogs''')\ns=s.replace('    conn.execute(\"INSERT INTO products', '''    retired = conn.execute(\"SELECT feed_seq FROM feed_tombstones WHERE sku = ?\",\n                           (item[\"sku\"],)).fetchone()\n    if retired is not None and retired[\"feed_seq\"] >= item[\"seq\"]:\n        return\n    conn.execute(\"INSERT INTO products''',1)\ns=s.replace('    conn.execute(\"DELETE FROM products WHERE sku = ? \"', '''    conn.execute(\"INSERT INTO feed_tombstones (sku, feed_seq) VALUES (?, ?) \"\n                 \"ON CONFLICT(sku) DO UPDATE SET feed_seq = MAX(feed_seq, excluded.feed_seq)\",\n                 (tombstone[\"sku\"], tombstone[\"seq\"]))\n    conn.execute(\"DELETE FROM products WHERE sku = ? \"''')\np.write_text(s)\nPY\npython -m py_compile feedsync/*.py\n"]
