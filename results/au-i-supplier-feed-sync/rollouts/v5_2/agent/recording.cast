[70.924794, "o", "        changes += [(item[\"seq\"], \"delete\", item) for item in tombstones]\r\n\u001b[?2004l\r\u001b[?2004h>         with conn:\r\n\u001b[?2004l\r\u001b[?2004h>             for _, op, change in sorted(changes, key=lambda event: event[0]):\r\n\u001b[?2004l\r\u001b[?2004h>                 if op == \"upsert\":\r\n\u001b[?2004l\r\u001b[?2004h>                     store.insert_product(conn, change)\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     store.delete_product(conn, change)\r\n\u001b[?2004l\r\u001b[?2004h>             # Checkpoint empty/compacted windows too. A failed page rolls back\r\n\u001b[?2004l\r\u001b[?2004h>             # both its changes and cursor; previously committed pages survive.\r\n\u001b[?2004l\r\u001b[?2004h>             store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\r\n\u001b[?2004l\r\u001b[?2004h>         stats[\"pages\"] += 1\r\n\u001b[?2004l\r\u001b[?2004h>         stats[\"upserts\"] += len(items)\r\n\u001b[?2004l\r\u001b[?2004h>         stats[\"deletes\"] += len(tombstones)\r\n\u001b[?2004l\r\u001b[?2004h>     with conn:\r\n\u001b[?2004l\r\u001b[?2004h>         store.set_state(conn, \"last_sync_at\", store.now"]
