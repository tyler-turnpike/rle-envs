[106.996379, "i", "elf.addCleanup(self.conn.close)\n\n    def test_sequence_order_including_delete_and_reissue(self):\n        stats = run_sync(self.conn, Pages(page(\"done\", [item(5), item(1), item(3), item(6, \"B\")],\n                                             [{\"seq\": 2, \"sku\": \"A\"}, {\"seq\": 4, \"sku\": \"A\"},\n                                              {\"seq\": 7, \"sku\": \"B\"}])))\n        self.assertEqual([tuple(r) for r in self.conn.execute(\"SELECT sku,feed_seq FROM products\")],\n                         [(\"A\", 5)])\n        self.assertEqual(stats, {\"pages\": 1, \"upserts\": 4, \"deletes\": 3})\n\n    def test_empty_pages_checkpoint_and_resume(self):\n        client = Pages(page(\"empty-1\", has_more=True), page(\"empty-2\"))\n        self.assertEqual(run_sync(self.conn, client)[\"pages\"], 2)\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"empty-2\")\n        again = Pages(page(\"empty-2\"))\n        run_sync(self.conn, again)\n        self.assertEqual(again.start, \"empty-2\")\n\n    def test_failed_page_rolls_back_but_prior_page_st"]
