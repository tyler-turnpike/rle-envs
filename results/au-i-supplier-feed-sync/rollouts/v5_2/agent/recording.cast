[71.034281, "i", "\n            req = Request(url, headers=headers)\n            try:\n                with self._opener.open(req, timeout=self.timeout) as resp:\n                    return json.load(resp)\n            except HTTPError as exc:\n                body = exc.read()\n                try:\n                    error = json.loads(body)\n                except (ValueError, UnicodeDecodeError):\n                    error = {}\n                notice_id = error.get(\"notice_id\") if isinstance(error, dict) else None\n                if (exc.code == 409 and isinstance(error, dict)\n                        and error.get(\"error\") == \"notice_ack_required\"\n                        and isinstance(notice_id, str) and notice_id\n                        and \"\\\\r\" not in notice_id and \"\\\\n\" not in notice_id\n                        and \"X-Notice-Ack\" not in headers):\n                    notice = error.get(\"notice\")\n                    if isinstance(notice, dict):\n                        log_notices([notice], self.seen_notices)\n                    e"]
[71.038175, "i", "lse:\n                        log.warning(\"supplier notice %s: %s\", notice_id, error.get(\"message\"))\n                    log.info(\"acknowledging supplier notice %s; retrying the same page\", notice_id)\n                    headers[\"X-Notice-Ack\"] = notice_id\n                    continue\n                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\n            except (URLError, OSError) as exc:\n                raise FeedError(f\"GET {url} failed: {exc}\") from exc\n''' +s[b:]\ns=s.replace('            yield page\\n', '''            if page.get(\"has_more\") and page[\"next_cursor\"] == cursor:\n                raise FeedError(\"feed returned has_more without advancing its cursor\")\n            yield page\n''')\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
