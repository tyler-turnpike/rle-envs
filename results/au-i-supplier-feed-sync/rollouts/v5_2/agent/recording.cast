[70.910574, "i", "q, -1) = COALESCE(products.feed_seq, -1)\n                            AND newer.id > products.id)\n                    )\n                )\n            \"\"\")\n            conn.execute(\"DROP INDEX IF EXISTS products_sku\")\n            conn.execute(\"CREATE UNIQUE INDEX products_sku ON products(sku)\")\n    return conn\n''')\ns=s.replace('    return int(float(price) * 100)', '''    cents = Decimal(price) * 100\n    if not cents.is_finite() or cents != cents.to_integral_value():\n        raise ValueError(f\"price is not an exact number of cents: {price!r}\")\n    return int(cents)''')\ns=s.replace('    return None if cents is None else f\"{cents // 100}.{cents % 100:02d}\"', '''    if cents is None:\n        return None\n    return f\"{'-' if cents < 0 else ''}{abs(cents) // 100}.{abs(cents) % 100:02d}\"''')\ns=s.replace('def insert_product(conn, item):\\n', 'def insert_product(conn, item):\\n    \"\"\"Upsert a full feed record without letting an older sequence replace it.\"\"\"\\n')\ns=s.replace('                 \"VALUES (?, ?, ?, ?, ?, ?)\",', "]
[70.910585, "i", "'''                 \"VALUES (?, ?, ?, ?, ?, ?) \"\n                 \"ON CONFLICT(sku) DO UPDATE SET title = excluded.title, \"\n                 \"price_cents = excluded.price_cents, currency = excluded.currency, \"\n                 \"updated_at = excluded.updated_at, feed_seq = excluded.feed_seq \"\n                 \"WHERE products.feed_seq IS NULL OR excluded.feed_seq >= products.feed_seq\",''')\ns=s.replace('item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item.get(\"seq\")))', 'item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item[\"seq\"]))')\ns=s.replace('\\ndef product_count(conn):', '''\ndef delete_product(conn, tombstone):\n    \"\"\"Remove the feed-owned product, never the admin-owned price overrides.\"\"\"\n    conn.execute(\"DELETE FROM products WHERE sku = ? \"\n                 \"AND (feed_seq IS NULL OR feed_seq <= ?)\",\n                 (tombstone[\"sku\"], tombstone[\"seq\"]))\n\n\ndef product_count(conn):''')\np.write_text(s)\np=Path('feedsync/sync.py')\ns=p.read_text().replace('from . import store\\n', 'from . import store\\"]
[70.910599, "i", "nfrom .client import log_notices\\n')\na=s.index('def _show_notices('); b=s.index('def run_sync(',a)\ns=s[:a]+s[b:]\na=s.index('    seen = set()')\ns=s[:a]+'''    seen = getattr(client, \"seen_notices\", set())\n    for page in client.iter_pages(cursor):\n        log_notices(page.get(\"notices\") or [], seen)\n        # The API separates upserts and deletes, but they share one sequence.\n        # A SKU can be deleted and reissued even within the same page.\n        items = page.get(\"items\") or []\n        tombstones = page.get(\"tombstones\") or []\n        changes = [(item[\"seq\"], \"upsert\", item) for item in items]\n        changes += [(item[\"seq\"], \"delete\", item) for item in tombstones]\n        with conn:\n            for _, op, change in sorted(changes, key=lambda event: event[0]):\n                if op == \"upsert\":\n                    store.insert_product(conn, change)\n                else:\n                    store.delete_product(conn, change)\n            # Checkpoint empty/compacted windows too. A failed page rolls back\n"]
[70.910617, "i", "            # both its changes and cursor; previously committed pages survive.\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\n        stats[\"pages\"] += 1\n        stats[\"upserts\"] += len(items)\n        stats[\"deletes\"] += len(tombstones)\n    with conn:\n        store.set_state(conn, \"last_sync_at\", store.now_iso())\n    log.info(\"sync done: %(pages)d pages, %(upserts)d upserts, %(deletes)d deletes\", stats)\n    return stats\n'''\np.write_text(s)\nPY\n"]
