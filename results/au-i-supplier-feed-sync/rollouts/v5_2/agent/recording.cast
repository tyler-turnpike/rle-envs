[106.996367, "i", "eq))\n                old.execute(\"INSERT INTO sync_state (key,value) VALUES ('feed_cursor','opaque')\")\n                old.execute(\"INSERT INTO price_overrides (sku,override_cents,starts_on,author,reason,created_at) \"\n                            \"VALUES ('A',50,'2020-01-01','merch','promo','2020-01-01')\")\n            for _ in range(2):\n                conn = store.connect(path)\n                try:\n                    self.assertEqual([tuple(r) for r in conn.execute(\n                        \"SELECT sku,price_cents FROM products ORDER BY sku\")], [(\"A\", 300), (\"B\", 500)])\n                    self.assertEqual(store.get_state(conn, \"feed_cursor\"), \"opaque\")\n                    self.assertEqual(conn.execute(\"SELECT COUNT(*) FROM price_overrides\").fetchone()[0], 1)\n                finally:\n                    conn.close()\n\n    def test_override_dates_and_newest_active(self):\n        store.insert_product(self.conn, item(1))\n        overrides = [(100, \"2020-01-01\", None), (200, \"2026-11-01\", \"2026-11-22\"),\n          "]
