[222.479944, "o", "> \r\n\u001b[?2004l\r"]
[222.479993, "o", "\u001b[?2004h> "]
[222.480122, "o", "conn=sqlite3.connect('data/catalog.db'); conn.row_factory=sqlite3.Row\r\n\u001b[?2004l\r"]
[222.480159, "o", "\u001b[?2004h> "]
[222.480252, "o", "expected={}\r\n"]
[222.481285, "o", "\u001b[?2004l\r\u001b[?2004h"]
[222.481408, "o", "> "]
[222.481739, "o", "for event in sorted((json.loads(line) for line in Path('dev/feed_data/changes.jsonl').read_text().splitlines() if line.strip()), key=lambda e:e['seq']):\r\n\u001b[?2004l\r"]
[222.481764, "o", "\u001b[?2004h"]
[222.481821, "o", "> "]
[222.481847, "o", "    if event['op']=='delete':\r\n\u001b[?2004l\r"]
[222.481899, "o", "\u001b[?2004h> "]
[222.481948, "o", "        expected.pop(event['sku'],None)\r\n\u001b[?2004l\r"]
[222.481981, "o", "\u001b[?2004h> "]
[222.482962, "o", "    else:\r\n\u001b[?2004l\r"]
[222.483008, "o", "\u001b[?2004h> "]
[222.483219, "o", "        expected[event['sku']]=(event['title'],int(Decimal(event['price'])*100),event.get('currency','EUR'),event.get('updated_at'),event['seq'])\r\n\u001b[?2004l\r"]
[222.483258, "o", "\u001b[?2004h> "]
[222.483433, "o", "actual={r['sku']:(r['title'],r['price_cents'],r['currency'],r['updated_at'],r['feed_seq']) for r in conn.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.483545, "o", "assert actual==expected, 'catalog differs from feed replay'\r\n\u001b[?2004l\r\u001b[?2004h"]
[222.483583, "o", "> "]
[222.48373, "o", "assert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0]==len(expected)\r\n\u001b[?2004l\r"]
[222.483752, "o", "\u001b[?2004h> "]
[222.483848, "o", "backup=sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.483932, "o", "overrides=[tuple(r) for r in conn.execute('SELECT * FROM price_overrides ORDER BY id')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.484094, "o", "assert overrides==backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), 'merchandising overrides changed'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.484158, "o", "rows=json.loads(Path('/var/tmp/feedsync-report.json').read_text())\r\n\u001b[?2004l\r"]
[222.484251, "o", "\u001b[?2004h> assert len(rows)==len(expected) and {r['sku'] for r in rows}==set(expected)\r\n\u001b[?2004l\r"]
[222.484281, "o", "\u001b[?2004h"]
[222.484314, "o", "> today=dt.date.today().isoformat()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.484339, "o", "def fmt(c):\r\n\u001b[?2004l\r"]
[222.48435, "o", "\u001b[?2004h> "]
[222.484404, "o", "    return f'{Decimal(c)/100:.2f}'\r\n\u001b[?2004l\r"]
[222.484456, "o", "\u001b[?2004h> override_prices=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.484488, "o", "for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.484557, "o", "    sku=row['sku']\r\n\u001b[?2004l\r\u001b[?2004h"]
[222.48459, "o", "> "]
[222.484656, "o", "    active=[dict(r) for r in conn.execute('SELECT * FROM price_overrides WHERE sku=?',(sku,))\r\n\u001b[?2004l\r"]
[222.484671, "o", "\u001b[?2004h> "]
[222.484746, "o", "            if r['starts_on']<=today and (r['ends_on'] is None or r['ends_on']>=today)]\r\n\u001b[?2004l\r"]
[222.484768, "o", "\u001b[?2004h> "]
[222.484874, "o", "    active.sort(key=lambda r:(r['starts_on'],r['id']),reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.48494, "o", "    override=active[0] if active else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485015, "o", "    price=override['override_cents'] if override else expected[sku][1]\r\n\u001b[?2004l\r"]
[222.485037, "o", "\u001b[?2004h"]
[222.485046, "o", "> "]
[222.485115, "o", "    assert row['feed_price']==fmt(expected[sku][1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485249, "o", "    assert row['override_price']==(fmt(override['override_cents']) if override else None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485285, "o", "    assert row['effective_price']==fmt(price)\r\n\u001b[?2004l\r"]
[222.485301, "o", "\u001b[?2004h"]
[222.485311, "o", "> "]
[222.485373, "o", "    assert row['source']==('override' if override else 'feed')\r\n\u001b[?2004l\r"]
[222.485482, "o", "\u001b[?2004h>     override_prices+=bool(override)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485542, "o", "start=int(Path('/var/tmp/feedsync-request-second-start').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485726, "o", "requests=[json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines()[start:] if json.loads(line)['path']=='/v2/changes']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485755, "o", "assert len(requests)==1, requests\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.485971, "o", "request=requests[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.486006, "o", "assert request['cursor']==Path('/var/tmp/feedsync-first-cursor').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> assert request['status']==200 and request['items']==0 and request['tombstones']==0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.486411, "o", "assert request['next_cursor']==request['cursor'] and request['has_more'] is False\r\n\u001b[?2004l\r\u001b[?2004h> assert conn.execute('PRAGMA integrity_check').fetchone()[0]=='ok'\r\n\u001b[?2004l\r\u001b[?2004h> assert conn.execute('PRAGMA foreign_key_check').fetchall()==[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[222.487195, "o", "print(f'Validated all {len(actual)} unique product records against complete feed replay.')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Validated all {len(rows)} report prices ({override_prices} active overrides).')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'All {len(overrides)} merchandising override records unchanged from backup.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Incremental follow-up: exactly one request at the final saved cursor; no old pages downloaded.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Database integrity: OK.')\r\n\u001b[?2004l\r\u001b[?2004h> print('KS-10007:', next(r for r in rows if r['sku']=='KS-10007'))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[222.517217, "o", "Validated all 47 unique product records against complete feed replay.\r\nValidated all 47 report prices (24 active overrides).\r\n"]
[222.521091, "o", "All 34 merchandising override records unchanged from backup.\r\nIncremental follow-up: exactly one request at the final saved cursor; no old pages downloaded.\r\n"]
[222.521137, "o", "Database integrity: OK.\r\nKS-10007: {'sku': 'KS-10007', 'title': 'Stainless hook rail 300mm', 'currency': 'EUR', 'feed_price': '249.70', 'override_price': '3.20', 'override_reason': 'Clearance - discontinued finish', 'effective_price': '3.20', 'source': 'override'}\r\n"]
[222.521529, "o", "\u001b[?2004h"]
[222.521696, "o", "root@ef0f927aae6c:/app# "]
