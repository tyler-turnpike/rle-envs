[61.154843, "i", "cd /app && python - <<'PY'\nimport sqlite3\nc=sqlite3.connect('data/catalog.db')\nfor name in ('products','sync_state','price_overrides'):\n print('\\nTABLE',name)\n print(c.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\",(name,)).fetchone()[0])\n print('count',c.execute(f'SELECT count(*) FROM {name}').fetchone()[0])\n print(c.execute(f'SELECT * FROM {name} LIMIT 15').fetchall())\nprint('duplicate SKUs',c.execute('SELECT sku, count(*) FROM products GROUP BY sku HAVING count(*)>1').fetchall())\nPY\npython -m unittest discover -s tests -v\n"]
