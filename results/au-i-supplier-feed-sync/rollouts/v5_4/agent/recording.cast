[244.108722, "i", "cd /app && python - <<'PY'\nimport datetime\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\n\nc=sqlite3.connect('data/catalog.db')\nc.row_factory=sqlite3.Row\nexpected={}\nevents=[]\nfor path in sorted(Path('dev/feed_data').glob('changes*.jsonl')):\n    events.extend(json.loads(line) for line in path.read_text().splitlines() if line.strip())\nfor e in sorted(events, key=lambda e:e['seq']):\n    if e['op']=='delete':\n        expected.pop(e['sku'], None)\n    else:\n        expected[e['sku']]=(e['sku'], e['title'], int(Decimal(e['price'])*100),\n                             e.get('currency', 'EUR'), e.get('updated_at'), e['seq'])\nactual=[tuple(r) for r in c.execute('SELECT sku,title,price_cents,currency,updated_at,feed_seq '\n                                   'FROM products ORDER BY sku')]\nassert actual==[expected[k] for k in sorted(expected)], 'catalog differs from feed replay'\nbackup=sqlite3.connect('/var/tmp/feedsync-backups/catalog-before-fix.db')\nbefore=back"]
[244.108932, "i", "up.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\nassert [tuple(r) for r in c.execute('SELECT * FROM price_overrides ORDER BY id')]==before\nassert c.execute('PRAGMA integrity_check').fetchone()[0]=='ok'\nrows=json.loads(subprocess.check_output([sys.executable,'-m','feedsync','report','--json'],text=True))\nassert len(rows)==len(expected)==len({r['sku'] for r in rows})\ntoday=datetime.date.today().isoformat()\nfor row in rows:\n    feed=expected[row['sku']][2]\n    active=[o for o in before if o[1]==row['sku'] and o[3]<=today and (o[4] is None or o[4]>=today)]\n    active.sort(key=lambda o:(o[3],o[0]), reverse=True)\n    price=active[0][2] if active else feed\n    assert row['feed_price']==f'{feed//100}.{feed%100:02d}'\n    assert row['effective_price']==f'{price//100}.{price%100:02d}'\n    assert row['source']==('override' if active else 'feed')\nprint(f'VALIDATED: {len(actual)} unique products, full feed records and effective prices match; all {len(before)} override rows unchanged; SQLite integrity OK')"]
[244.108949, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.108955, "i", "\nlog=Path('/var/tmp/feedstub/requests.log')\noffset=len(log.read_text().splitlines())\ncursor=c.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\nresult=subprocess.run([sys.executable,'-m','feedsync','sync'],capture_output=True,text=True,check=True)\nprint('SECOND RUN:', result.stdout.strip())\nrequests=[json.loads(line) for line in log.read_text().splitlines()[offset:]]\nrequests=[r for r in requests if r['path']=='/v2/changes']\nassert len(requests)==1, requests\nr=requests[0]\nassert r['cursor']==cursor and r['next_cursor']==cursor\nassert r['status']==200 and r['items']==r['tombstones']==0 and not r['has_more']\nassert json.loads(result.stdout)==dict(pages=1,upserts=0,deletes=0)\nassert actual==[tuple(r) for r in c.execute('SELECT sku,title,price_cents,currency,updated_at,feed_seq FROM products ORDER BY sku')]\nprint('VERIFIED: second run only polls stored cursor', cursor, 'with no replayed pages')\nPY\n"]
[244.109106, "o", "import datetime\r\n\u001b[?2004l\rup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\r\nassert [tuple(r) for r in c.execute('SELECT * FROM price_overrides ORDER BY id')]==before\r\nassert c.execute('PRAGMA integrity_check').fetchone()[0]=='ok'\r\nrows=json.loads(subprocess.check_output([sys.executable,'-m','feedsync','report','--json'],text=True))\r\nassert len(rows)==len(expected)==len({r['sku'] for r in rows})\r\ntoday=datetime.date.today().isoformat()\r\nfor row in rows:\r\n    feed=expected[row['sku']][2]\r\n    active=[o for o in before if o[1]==row['sku'] and o[3]<=today and (o[4] is None or o[4]>=today)]\r\n    active.sort(key=lambda o:(o[3],o[0]), reverse=True)\r\n    price=active[0][2] if active else feed\r\n    assert row['feed_price']==f'{feed//100}.{feed%100:02d}'\r\n    assert row['effective_price']==f'{price//100}.{price%100:02d}'\r\n    assert row['source']==('override' if active else 'feed')\r\nprint(f'VALIDATED: {len(actual)} unique products, full feed records and effective prices match; all {len(before)} overri"]
