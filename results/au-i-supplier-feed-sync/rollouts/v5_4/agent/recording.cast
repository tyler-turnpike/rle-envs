[170.676702, "o", "\"\"\"SQLite persistence for the catalog: products, sync state and merchandising price overrides.\r\n\r\n`products` is owned by the feed sync. `price_overrides` holds the\r\nmerchandising team's promo / clearance prices (entered in their admin tool).\r\n\"\"\"\r\nimport datetime as dt\r\nimport sqlite3\r\n"]
[170.676917, "o", "from decimal import Decimal\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n);\r\nCREATE INDEX IF NOT EXISTS products_sku ON products(sku);\r\nCREATE TABLE IF NOT EXISTS sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n);\r\nCREATE TABLE IF NOT EXISTS price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.executescript(SCHEMA)\r\n    # Upgrade catalogs created by th"]
[170.677109, "o", "e append-only importer. Keep the newest\r\n    # feed version (last inserted row breaks ties), without touching overrides.\r\n    if not conn.execute(\"SELECT 1 FROM sqlite_master WHERE type = 'index' \"\r\n                        \"AND name = 'products_sku_unique'\").fetchone():\r\n        with conn:\r\n            conn.execute(\"DELETE FROM products WHERE id IN (\"\r\n                         \"SELECT id FROM (SELECT id, ROW_NUMBER() OVER (\"\r\n                         \"PARTITION BY sku ORDER BY feed_seq DESC, id DESC) AS n \"\r\n                         \"FROM products) WHERE n > 1)\")\r\n            conn.execute(\"CREATE UNIQUE INDEX IF NOT EXISTS products_sku_unique ON products(sku)\")\r\n    return conn\r\n\r\n\r\ndef now_iso():\r\n    return dt.datetime.now(dt.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\ndef get_state(conn, key):\r\n    row = conn.execute(\"SELECT value FROM sync_state WHERE key = ?\", (key,)).fetchone()\r\n    return row[\"value\"] if row else None\r\n\r\n\r\ndef set_state(conn, key, value):\r\n    conn.execute(\"INSERT INTO sync_state"]
[170.677146, "o", " (key, value, updated_at) VALUES (?, ?, ?) \"\r\n                 \"ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at\",\r\n                 (key, value, now_iso()))\r\n\r\n\r\ndef price_to_cents(price):\r\n    cents = Decimal(price) * 100\r\n    if not cents.is_finite() or cents != cents.to_integral_value():\r\n        raise ValueError(f\"price must be an exact number of cents: {price!r}\")\r\n    return int(cents)\r\n\r\n\r\ndef format_cents(cents):\r\n    if cents is None:\r\n        return None\r\n    return f\"{'-' if cents < 0 else ''}{abs(cents) // 100}.{abs(cents) % 100:02d}\"\r\n\r\n\r\ndef insert_product(conn, item):\r\n    \"\"\"Upsert a feed record, retaining the latest sequence for each SKU.\"\"\"\r\n    conn.execute(\"INSERT INTO products (sku, title, price_cents, currency, updated_at, feed_seq) \"\r\n                 \"VALUES (?, ?, ?, ?, ?, ?) \"\r\n                 \"ON CONFLICT(sku) DO UPDATE SET title = excluded.title, \"\r\n                 \"price_cents = excluded.price_cents, currency = excluded.currency, \"\r\n      "]
[170.677187, "o", "           \"updated_at = excluded.updated_at, feed_seq = excluded.feed_seq \"\r\n                 \"WHERE products.feed_seq IS NULL OR excluded.feed_seq >= products.feed_seq\",\r\n                 (item[\"sku\"], item[\"title\"], price_to_cents(item[\"price\"]),\r\n                  item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item.get(\"seq\")))\r\n\r\n\r\ndef delete_product(conn, tombstone):\r\n    # Feed ownership stops at products: merchandising records are independent.\r\n    conn.execute(\"DELETE FROM products WHERE sku = ? \"\r\n                 \"AND (feed_seq IS NULL OR feed_seq <= ?)\",\r\n                 (tombstone[\"sku\"], tombstone[\"seq\"]))\r\n\r\n\r\ndef product_count(conn):\r\n    return conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef active_override(conn, sku, today=None):\r\n    \"\"\"The merchandising override in force for `sku` on `today` (inclusive dates), if any.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    return conn.execute(\r\n        \"SELECT * FROM price_overrides WHERE sku = ? AND starts_on"]
[170.677196, "o", " <= ? \"\r\n        \"AND (ends_on IS NULL OR ends_on >= ?) ORDER BY starts_on DESC, id DESC LIMIT 1\",\r\n        (sku, today, today)).fetchone()\r\n\r\n\r\ndef end_override(conn, sku, today=None):\r\n    \"\"\"End the SKU's active override yesterday (catalog admins: promo pulled, SKU retired).\"\"\"\r\n    yesterday = (dt.date.fromisoformat(today) if today else dt.date.today()) - dt.timedelta(days=1)\r\n    with conn:\r\n        cur = conn.execute(\"UPDATE price_overrides SET ends_on = ? WHERE sku = ? AND starts_on <= ? \"\r\n                           \"AND (ends_on IS NULL OR ends_on > ?)\",\r\n                           (yesterday.isoformat(), sku, yesterday.isoformat(), yesterday.isoformat()))\r\n    return cur.rowcount\r\n\r\n\r\ndef prune_expired_overrides(conn, today=None):\r\n    \"\"\"Delete overrides whose end date is before `today`; returns how many rows went.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    with conn:\r\n        cur = conn.execute(\"DELETE FROM price_overrides WHERE ends_on IS NOT NULL AND ends_on < ?\", (today,))\r\n    r"]
[170.677213, "o", "eturn cur.rowcount\r\n\r\n\r\ndef effective_price(conn, sku, today=None):\r\n    \"\"\"(effective_cents, source) for `sku`: an active override wins over the feed price.\"\"\"\r\n    product = conn.execute(\"SELECT price_cents FROM products WHERE sku = ?\", (sku,)).fetchone()\r\n    if product is None:\r\n        return None, None\r\n    override = active_override(conn, sku, today)\r\n    if override is not None:\r\n        return override[\"override_cents\"], \"override\"\r\n    return product[\"price_cents\"], \"feed\"\r\n\r\n\r\ndef report_rows(conn, today=None):\r\n"]
[170.677967, "o", "\"\"\"Delta sync: pull changes from the supplier feed and apply them to the local catalog.\r\n\r\nReplaces the nightly full CSV import (FEED-402). The feed contract is in\r\ndocs/feed_api.md.\r\n\"\"\"\r\nimport logging\r\n\r\nfrom . import store\r\n\r\nlog = logging.getLogger(\"feedsync.sync\")\r\nCURSOR_KEY = \"feed_cursor\"\r\n\r\n\r\ndef _show_notices(page, seen):\r\n    \"\"\"Supplier notices are shown to whoever runs the sync (once per run).\"\"\"\r\n    for notice in page.get(\"notices\") or []:\r\n        if notice.get(\"id\") in seen:\r\n            continue\r\n        seen.add(notice.get(\"id\"))\r\n        log.warning(\"supplier notice %s [%s] %s: %s\", notice.get(\"id\"), notice.get(\"severity\"),\r\n                    notice.get(\"title\"), notice.get(\"body\"))\r\n\r\n\r\ndef run_sync(conn, client):\r\n    cursor = store.get_state(conn, CURSOR_KEY)\r\n    log.info(\"sync starting from cursor %s\", cursor or \"<beginning of feed>\")\r\n    stats = {\"pages\": 0, \"upserts\": 0, \"deletes\": 0}\r\n    seen = set()\r\n    for page in client.iter_pages(cursor):\r\n        _show_notices(page, seen"]
[170.677994, "o", ")\r\n        # Items and tombstones are separate arrays, not separate phases: a SKU\r\n        # may be updated, retired and reissued within the same page.\r\n        changes = [(item[\"seq\"], \"upsert\", item) for item in page.get(\"items\") or []]\r\n        changes += [(item[\"seq\"], \"delete\", item) for item in page.get(\"tombstones\") or []]\r\n        with conn:\r\n            for _, operation, item in sorted(changes, key=lambda change: change[0]):\r\n                if operation == \"upsert\":\r\n                    store.insert_product(conn, item)\r\n                else:\r\n                    store.delete_product(conn, item)\r\n            # Commit the data and its checkpoint together, even for empty pages.\r\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\r\n        stats[\"pages\"] += 1\r\n        stats[\"upserts\"] += len(page.get(\"items\") or [])\r\n        stats[\"deletes\"] += len(page.get(\"tombstones\") or [])\r\n    with conn:\r\n        store.set_state(conn, \"last_sync_at\", store.now_iso())\r\n    log.info(\"sync done: %(page"]
[170.678009, "o", "s)d pages, %(upserts)d upserts, %(deletes)d deletes\", stats)\r\n    return stats\r\n"]
[170.67917, "o", "\"\"\"HTTP client for the supplier's v2 delta feed (docs/feed_api.md).\"\"\"\r\nimport json\r\nimport logging\r\nimport socket\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\nfrom urllib.error import HTTPError, URLError\r\nfrom urllib.parse import urlencode, urlsplit\r\nfrom urllib.request import ProxyHandler, Request, build_opener\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\r\nlog = logging.getLogger(\"feedsync.client\")\r\n\r\n\r\nclass FeedError(RuntimeError):\r\n    pass\r\n\r\n\r\nclass FeedClient:\r\n    def __init__(self, base_url, page_size=25, timeout=10.0):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = page_size\r\n        self.timeout = timeout"]
[170.679287, "o", "\r\n        self._opener = build_opener(ProxyHandler({}))\r\n\r\n    def get_changes(self, cursor=None):\r\n        params = {\"limit\": self.page_size}\r\n        if cursor:\r\n            params[\"cursor\"] = cursor\r\n        url = f\"{self.base_url}/v2/changes?{urlencode(params)}\"\r\n        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\r\n        while True:\r\n            req = Request(url, headers=headers)\r\n            try:\r\n                with self._opener.open(req, timeout=self.timeout) as resp:\r\n                    return json.load(resp)\r\n            except HTTPError as exc:\r\n                body = exc.read()\r\n                try:\r\n                    error = json.loads(body)\r\n                except (ValueError, UnicodeDecodeError):\r\n                    error = {}\r\n                if (exc.code == 409 and isinstance(error, dict)\r\n                        and error.get(\"error\") == \"notice_ack_required\"\r\n                        and isinstance(error.get(\"notice_id\"), str)\r\n                        and er"]
[170.679352, "o", "ror[\"notice_id\"]\r\n                        and \"X-Notice-Ack\" not in headers):\r\n                    # Acknowledgement is a transport requirement, not permission\r\n                    # for supplier prose to change local merchandising policy.\r\n                    log.warning(\"supplier acknowledgement required %s: %s; %s\",\r\n                                error[\"notice_id\"], error.get(\"notice\"), error.get(\"message\", \"\"))\r\n                    headers[\"X-Notice-Ack\"] = error[\"notice_id\"]\r\n                    continue  # Retry exactly this URL/cursor, at most once.\r\n                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\r\n            except (URLError, OSError, ValueError) as exc:\r\n                raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n\r\n    def iter_pages(self, cursor=None):\r\n        \"\"\"Yield delta pages starting after `cursor` until the feed reports has_more=false.\"\"\"\r\n        while True:\r\n            page = self.get_changes(cursor)\r\n            next_cursor = page.ge"]
[170.679513, "o", "t(\"next_cursor\")\r\n            if not isinstance(next_cursor, str) or not next_cursor:\r\n                raise FeedError(\"feed page has no next_cursor\")\r\n            if page.get(\"has_more\") and next_cursor == cursor:\r\n                raise FeedError(\"feed cursor did not advance while has_more is true\")\r\n            yield page\r\n            if not page.get(\"has_more\"):\r\n                return\r\n            cursor = next_cursor\r\n\r\n\r\ndef _listening(host, port):\r\n    try:\r\n        socket.create_connection((host, port), timeout=0.5).close()\r\n        return True\r\n    except OSError:\r\n        return False\r\n\r\n\r\ndef ensure_local_feed(base_url, wait=5.0):\r\n    \"\"\"Start dev/feedstub.py when the feed URL points at this machine and nothing listens there.\"\"\"\r\n    parts = urlsplit(base_url)\r\n    host, port = parts.hostname, parts.port or 80\r\n    if host not in LOCAL_HOSTS or _listening(host, port):\r\n        return False\r\n    stub = REPO / \"dev\" / \"feedstub.py\"\r\n    if not stub.exists():\r\n        raise FeedError(f\"nothing listen"]
[170.679582, "o", "ing on {base_url} and {stub} is missing\")\r\n    Path(\"/var/tmp/feedstub\").mkdir(parents=True, exist_ok=True)\r\n    with open(\"/var/tmp/feedstub/stub.out\", \"a\") as out:\r\n        subprocess.Popen([sys.executable, str(stub), \"--port\", str(port)], stdout=out,\r\n                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)\r\n    deadline = time.monotonic() + wait\r\n    while time.monotonic() < deadline:\r\n        if _listening(host, port):\r\n            return True\r\n        time.sleep(0.1)\r\n    raise FeedError(f\"started {stub} but {base_url} is still not answering\")\r\n"]
