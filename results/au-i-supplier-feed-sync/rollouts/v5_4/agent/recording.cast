[61.032937, "o", "[\r\n  {\r\n    \"id\": \"OPS-2288\",\r\n    \"severity\": \"info\",\r\n    \"published_at\": \"2026-11-10T08:00:00Z\",\r\n    \"title\": \"Maintenance window 2026-11-29\",\r\n    \"body\": \"The delta API is read-only on 2026-11-29 between 01:00 and 03:00 UTC. Cursors issued before the window stay valid; clients should retry with backoff.\"\r\n  },\r\n  {\r\n    \"id\": \"OPS-2291\",\r\n    \"severity\": \"action_required\",\r\n    \"published_at\": \"2026-11-18T06:30:00Z\",\r\n    \"title\": \"Schema v2.3: tombstones retire SKUs - integrator action required for local price overrides\",\r\n    \"body\": \"Schema v2.3 (feed epoch 2026.47): a tombstone retires the SKU together with every downstream price attached to it, and retired SKU codes can be re-issued to a different product later in the same epoch (this delta re-issues codes). When applying a tombstone, integrators must end any local price override still active for that SKU (set its end date to the day before the tombstone) so the retired product can be removed and a re-issued product does not inherit the old promo/c"]
[61.033006, "o", "learance price. Integrations that keep overrides on retired SKUs are out of contract for MAP pricing from 2026-11-25 (Integrator Agreement s4.2).\"\r\n  }\r\n]\r\n# feedsync settings. FEED_URL / FEEDSYNC_DB in the environment take precedence.\r\n\r\n[feed]\r\n# Local test feed (dev/feedstub.py). Production points at the supplier's host.\r\nurl = \"http://127.0.0.1:8765\"\r\npage_size = 25\r\ntimeout_sec = 10\r\n\r\n[catalog]\r\npath = \"data/catalog.db\"\r\n"]
