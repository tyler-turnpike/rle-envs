[87.382004, "i", "changes_2.jsonl\", [event])\n        first = self.requests()\n        self.cli(\"sync\")\n        requests = self.requests()[len(first):]\n        self.assertEqual([r[\"status\"] for r in requests], [409, 200])\n        self.assertEqual([r[\"cursor\"] for r in requests], [first[-1][\"next_cursor\"]] * 2)\n        self.assertIsNone(requests[0][\"ack\"])\n        self.assertEqual(requests[1][\"ack\"], \"TEST-ACK\")\n        with sqlite3.connect(self.db) as conn:\n            self.assertEqual(conn.execute(\"SELECT * FROM price_overrides\").fetchall(), before)\n        rows = {r[\"sku\"]: r for r in json.loads(self.cli(\"report\", \"--json\"))}\n        self.assertEqual((rows[\"T-005\"][\"effective_price\"], rows[\"T-005\"][\"source\"]), (\"0.57\", \"feed\"))\n        first = self.requests()\n        self.cli(\"sync\")\n        requests = self.requests()[len(first):]\n        self.assertEqual(len(requests), 1)\n        self.assertEqual(requests[0][\"cursor\"], first[-1][\"next_cursor\"])\n        self.assertEqual(requests[0][\"items\"], 0)\n'''+s[pos:]; p.write_text(s)\np=P"]
[87.382041, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.382073, "i", "ath('README.md'); s=p.read_text(); s+='''\n## Delta checkpoints and upgrades\n\nEach sequence window is applied in sequence order (upserts and tombstones\ninterleaved), together with its cursor in one SQLite transaction. Empty windows\nstill advance the checkpoint. If a page fails, rerunning resumes after the last\ncommitted page; an unchanged feed requires only a single empty polling request.\nPrices are converted with decimal arithmetic, rejecting fractional cents.\n\nOpening a legacy catalog collapses duplicate product rows to the highest\n`feed_seq` (latest insertion breaks ties) and adds a unique SKU index. Existing\nproduct columns and merchandising overrides are preserved. Supplier notices are\nlogged; HTTP 409 notice gates are acknowledged and retried at the same cursor.\nNotice bodies are not executed as maintenance commands, and sync never prunes\nlocal overrides. Expired overrides remain available for historical reports but\ndo not affect today's effective prices.\n'''; p.write_text(s)\nPY\npython -m unittest discov"]
[87.382434, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.382466, "i", "er -s tests -v\n"]
