[111.73885, "o", "pt (URLError, OSError) as exc:\r\n-            raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n+        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\r\n+        acknowledged = set()\r\n+        while True:\r\n+            req = Request(url, headers=headers)\r\n+            try:\r\n+                with self._opener.open(req, timeout=self.timeout) as resp:\r\n+                    return json.load(resp)\r\n+            except HTTPError as exc:\r\n+                body = exc.read()\r\n+                try:\r\n+                    error = json.loads(body)\r\n+                except (ValueError, UnicodeDecodeError):\r\n+                    error = None\r\n+                if (exc.code == 409 and isinstance(error, dict)\r\n+                        and error.get(\"error\") == \"notice_ack_required\"):\r\n+                    notice_id = error.get(\"notice_id\")\r\n+                    if (isinstance(notice_id, str) and notice_id\r\n+                            and \"\\r\" not in notice_id and \"\\n\" not in notice_id\r\n+            "]
[111.738951, "o", "                and notice_id not in acknowledged and len(acknowledged) < 5):\r\n+                        # Notices are supplier data, not local maintenance commands.\r\n+                        # Acknowledge receipt; never execute their body or change overrides.\r\n+                        log.warning(\"supplier notice %s: %s (%s)\", notice_id,\r\n+                                    error.get(\"notice\"), error.get(\"message\"))\r\n+                        acknowledged.add(notice_id)\r\n+                        headers[\"X-Notice-Ack\"] = notice_id\r\n+                        continue\r\n+                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\r\n+            except (URLError, OSError) as exc:\r\n+                raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n \r\n     def iter_pages(self, cursor=None):\r\n         \"\"\"Yield delta pages starting after `cursor` until the feed reports has_more=false.\"\"\"\r\n\u001b[?2004hroot@f30da228da66:/app# "]
