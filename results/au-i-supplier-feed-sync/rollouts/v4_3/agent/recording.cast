[87.270499, "i", "cat > tests/test_store_sync.py <<'PY'\n\"\"\"Regression coverage for catalog upgrades and atomic delta application.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\nfrom feedsync.sync import run_sync\n\n\ndef item(seq, sku=\"A\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"title\": f\"Title {seq}\", \"price\": price}\n\n\ndef page(cursor, items=(), tombstones=(), has_more=False):\n    return {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": has_more}\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.cursor = None\n\n    def iter_pages(self, cursor):\n        self.cursor = cursor\n        yield from self.pages\n\n\nclass StoreSyncTest(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addCleanup(self.conn.close)\n\n    def test_exact_cents(self):\n        for price, expected in [(\"4.35\", 435), (\"0.29\", 29), (\"0.57\", 57),\n                    "]
[87.27082, "i", "            (\"19.99\", 1999), (\"8.58\", 858), (\"0\", 0),\n                                (\"-0.29\", -29), (\"1.2300\", 123)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), expected)\n                self.assertEqual(store.format_cents(expected), f\"{expected / 100:.2f}\")\n        for invalid in [\"1.001\", \"NaN\", \"Infinity\"]:\n            with self.subTest(invalid=invalid), self.assertRaises(ValueError):\n                store.price_to_cents(invalid)\n\n    def test_sequence_order_including_delete_and_reissue(self):\n        run_sync(self.conn, Pages(page(\"done\",\n            items=[item(9), item(1), item(8, \"B\"), item(2, \"B\")],\n            tombstones=[{\"sku\": \"A\", \"seq\": 5}, {\"sku\": \"B\", \"seq\": 10}])))\n        rows = self.conn.execute(\"SELECT sku, title, feed_seq FROM products\").fetchall()\n        self.assertEqual([tuple(r) for r in rows], [(\"A\", \"Title 9\", 9)])\n        store.insert_product(self.conn, item(3))\n        store.delete_product(self.conn, {\"sku\": \"A\", \"se"]
