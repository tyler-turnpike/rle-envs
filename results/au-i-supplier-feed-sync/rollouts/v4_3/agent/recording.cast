[54.749408, "o", "s=s[:start]+'''        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\r\n\u001b[?2004l\r"]
[54.749455, "o", "\u001b[?2004h> "]
[54.749468, "o", "        acknowledged = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.749524, "o", "        while True:\r\n\u001b[?2004l\r"]
[54.749541, "o", "\u001b[?2004h> "]
[54.749588, "o", "            req = Request(url, headers=headers)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.749695, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.749773, "o", "                with self._opener.open(req, timeout=self.timeout) as resp:\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.749786, "o", "> "]
[54.749794, "o", "                    return json.load(resp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.749853, "o", "            except HTTPError as exc:\r\n"]
[54.749875, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.749968, "o", "                body = exc.read()\r\n\u001b[?2004l\r"]
[54.749982, "o", "\u001b[?2004h>                 try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.750087, "o", "                    error = json.loads(body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.750155, "o", "                except (ValueError, UnicodeDecodeError):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.750205, "o", ">                     error = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.75025, "o", "> "]
[54.750287, "o", "                if (exc.code == 409 and isinstance(error, dict)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.750372, "o", "                        and error.get(\"error\") == \"notice_ack_required\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.750385, "o", "> "]
[54.750455, "o", "                    notice_id = error.get(\"notice_id\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.750514, "o", "> "]
[54.750626, "o", "                    if (isinstance(notice_id, str) and notice_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.750677, "o", "> "]
[54.750724, "o", "                            and \"\\\\r\" not in notice_id and \"\\\\n\" not in notice_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.750811, "o", "                            and notice_id not in acknowledged and len(acknowledged) < 5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.750927, "o", "                        # Notices are supplier data, not local maintenance commands.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.751031, "o", "                        # Acknowledge receipt; never execute their body or change overrides.\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.75107, "o", "> "]
[54.751139, "o", "                        log.warning(\"supplier notice %s: %s (%s)\", notice_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.751177, "o", "> "]
[54.751244, "o", "                                    error.get(\"notice\"), error.get(\"message\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.751267, "o", "> "]
[54.75133, "o", "                        acknowledged.add(notice_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.751355, "o", "> "]
[54.751432, "o", "                        headers[\"X-Notice-Ack\"] = notice_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.751481, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.751527, "o", "> "]
[54.751586, "o", "                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.751604, "o", "> "]
[54.751689, "o", "            except (URLError, OSError) as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.751749, "o", "                raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n\u001b[?2004l\r\u001b[?2004h"]
