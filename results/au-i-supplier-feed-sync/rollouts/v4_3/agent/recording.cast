[54.749117, "o", "s=s.replace('LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}', 'LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\\nlog = logging.getLogger(\"feedsync.client\")')\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.749177, "o", "> "]
