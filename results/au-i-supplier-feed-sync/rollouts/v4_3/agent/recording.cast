[131.208146, "i", "python - <<'PY'\nimport datetime as dt\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\n\nexpected = {}\nevents = [json.loads(line) for path in Path('dev/feed_data').glob('changes*.jsonl')\n          for line in path.read_text().splitlines() if line.strip()]\nfor event in sorted(events, key=lambda e: e['seq']):\n    sku = event['sku']\n    if event['op'] == 'delete':\n        expected.pop(sku, None)\n    else:\n        expected[sku] = (event['title'], int(Decimal(event['price']) * 100),\n                         event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-before-v2/catalog.db') as before:\n    actual = {row[0]: row[1:] for row in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\n    assert actual == expected, (actual, expected)\n    assert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0] == len(expecte"]
[131.20833, "i", "d)\n    assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n    overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    assert overrides == before.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\n    today = dt.date.today().isoformat()\n    report = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\n    assert len(report) == len(expected)\n    for row in report:\n        sku = row['sku']\n        active = [o for o in overrides if o[1] == sku and o[3] <= today and (o[4] is None or o[4] >= today)]\n        newest = max(active, key=lambda o: (o[3], o[0])) if active else None\n        cents = newest[2] if newest else expected[sku][1]\n        assert row['effective_price'] == f'{Decimal(cents) / 100:.2f}', row\n        assert row['source'] == ('override' if newest else 'feed'), row\n        assert row['feed_price'] == f"]
[131.208388, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[131.208412, "i", "'{Decimal(expected[sku][1]) / 100:.2f}', row\n    snapshot = conn.execute('SELECT * FROM products ORDER BY sku').fetchall()\nprint(f'Catalog matches all feed fields for {len(expected)} SKUs; report prices verified; all {len(overrides)} override rows preserved.')\nlog_path = Path('/var/tmp/feedstub/requests.log')\nprior = len(log_path.read_text().splitlines())\nsubprocess.run([sys.executable, '-m', 'feedsync', 'sync'], check=True)\nnew_requests = [json.loads(line) for line in log_path.read_text().splitlines()[prior:]]\nchanges = [r for r in new_requests if r['path'] == '/v2/changes']\nassert len(changes) == 1, changes\nassert changes[0]['cursor'] == cursor and changes[0]['next_cursor'] == cursor, changes\nassert changes[0]['items'] == 0 and changes[0]['tombstones'] == 0, changes\nwith sqlite3.connect('data/catalog.db') as conn:\n    assert snapshot == conn.execute('SELECT * FROM products ORDER BY sku').fetchall()\n    assert overrides == conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\nprint('Second run"]
