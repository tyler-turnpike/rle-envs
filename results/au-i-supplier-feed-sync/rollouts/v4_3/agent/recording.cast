[87.270852, "i", "q\": 4})\n        self.assertEqual(self.conn.execute(\"SELECT feed_seq FROM products\").fetchone()[0], 9)\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"done\")\n        with self.assertRaises(sqlite3.IntegrityError):\n            self.conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A','dup',1)\")\n\n    def test_failed_page_rolls_back_but_keeps_previous_checkpoint(self):\n        client = Pages(page(\"first\", [item(1)], has_more=True),\n                       page(\"second\", [item(2, \"B\"), item(3, \"C\", \"not a price\")]))\n        with self.assertRaises(ValueError):\n            run_sync(self.conn, client)\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"first\")\n        self.assertIsNone(store.get_state(self.conn, \"last_sync_at\"))\n        self.assertEqual([r[0] for r in self.conn.execute(\"SELECT sku FROM products\")], [\"A\"])\n        resumed = Pages(page(\"second\", [item(2, \"B\"), item(3, \"C\")]))\n        run_sync(self.conn, resumed)\n        self.assertEqual(resumed.c"]
