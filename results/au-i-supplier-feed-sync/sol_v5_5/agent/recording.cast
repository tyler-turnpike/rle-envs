[156.694507, "i", "cd /app && python - <<'PY'\nimport json, sqlite3, subprocess, sys\nfrom pathlib import Path\nlog=Path('/var/tmp/feedstub/requests.log')\nbefore=len(log.read_text().splitlines())\nc=sqlite3.connect('data/catalog.db')\ncursor=c.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\nproducts=c.execute('SELECT * FROM products ORDER BY sku').fetchall()\noverrides=c.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\np=subprocess.run([sys.executable,'-m','feedsync','sync'],capture_output=True,text=True,check=True)\nprint(p.stderr, end=''); print(p.stdout,end='')\nnew=[json.loads(line) for line in log.read_text().splitlines()[before:]]\nrequests=[r for r in new if r['path']=='/v2/changes']\nassert len(requests)==1, requests\nassert requests[0]['cursor']==cursor and requests[0]['status']==200\nassert requests[0]['items']==0 and requests[0]['tombstones']==0 and not requests[0]['has_more']\nassert c.execute('SELECT * FROM products ORDER BY sku').fetchall()==products\nassert c.execute('SELECT * FROM "]
