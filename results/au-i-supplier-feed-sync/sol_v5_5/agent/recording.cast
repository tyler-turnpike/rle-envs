[119.647187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.64726, "o", "class MigrationTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647349, "o", "    def test_deduplicate_legacy_catalog_with_override_guard(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647418, "o", "        with tempfile.TemporaryDirectory() as tmp:\r\n\u001b[?2004l\r"]
[119.647486, "o", "\u001b[?2004h> "]
[119.647515, "o", "            path = Path(tmp) / \"catalog.db\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647576, "o", "            conn = sqlite3.connect(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647685, "o", "            conn.executescript(store.SCHEMA + GUARD)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647771, "o", "            for seq, price in [(3, 300), (1, 100), (3, 301)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647864, "o", "                conn.execute(\"INSERT INTO products (sku, title, price_cents, feed_seq) VALUES ('SKU', 'P', ?, ?)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.647953, "o", "                             (price, seq))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648058, "o", "            conn.execute(\"INSERT INTO price_overrides (sku, override_cents, starts_on, author, reason, created_at) \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.648082, "o", "> "]
[119.64818, "o", "                         \"VALUES ('SKU', 199, '2020-01-01', 'merch', 'promo', '2026-01-01')\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.648228, "o", "> "]
[119.648243, "o", "            conn.commit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648304, "o", "            conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648364, "o", "            conn = store.connect(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648426, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648501, "o", "                self.assertEqual(store.product_count(conn), 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.648522, "o", "> "]
[119.648659, "o", "                self.assertEqual(conn.execute(\"SELECT price_cents FROM products\").fetchone()[0], 301)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.64874, "o", "> "]
[119.648855, "o", "                self.assertEqual(store.effective_price(conn, \"SKU\"), (199, \"override\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.648906, "o", ">                 with self.assertRaises(sqlite3.IntegrityError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.648968, "o", "                    with conn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649032, "o", "                        conn.execute(\"DELETE FROM products\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649147, "o", "                with self.assertRaises(sqlite3.IntegrityError):\r\n\u001b[?2004l\r"]
[119.649186, "o", "\u001b[?2004h>                     with conn:\r\n\u001b[?2004l\r"]
[119.649221, "o", "\u001b[?2004h> "]
[119.649308, "o", "                        conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('SKU', 'P', 1)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649368, "o", "            finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649429, "o", "                conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649475, "o", "            # The migration is idempotent.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649558, "o", "            store.connect(path).close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.649594, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[119.649671, "o", "\u001b[?2004h> "]
[119.649719, "o", "    unittest.main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
