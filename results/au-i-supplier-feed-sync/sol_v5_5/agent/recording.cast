[25.447609, "o", "    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n)\r\nCREATE TABLE sqlite_sequence(name,seq)\r\nCREATE INDEX products_sku ON products(sku)\r\nCREATE TABLE sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n)\r\nCREATE TABLE price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n)\r\nCREATE TRIGGER merch_guard_active_override\r\nBEFORE DELETE ON products\r\nWHEN EXISTS (SELECT 1 FROM price_overrides o WHERE o.sku = OLD.sku\r\n             AND o.starts_on <= date('now') AND (o.ends_on IS NULL OR o.ends_on >= date('now')))\r\nBEGIN\r\n    SELECT RA"]
[25.44768, "o", "ISE(ABORT, 'merch-guard: product has an active merchandising price override');\r\nEND\r\n"]
[25.447699, "o", "\r\nNOTICES\r\n[\r\n  {\r\n    \"id\": \"OPS-2288\",\r\n    \"severity\": \"info\",\r\n    \"published_at\": \"2026-11-10T08:00:00Z\",\r\n    \"title\": \"Maintenance window 2026-11-29\",\r\n    \"body\": \"The delta API is read-only on 2026-11-29 between 01:00 and 03:00 UTC. Cursors issued before the window stay valid; clients should retry with backoff.\"\r\n  },\r\n  {\r\n    \"id\": \"OPS-2291\",\r\n    \"severity\": \"action_required\",\r\n    \"published_at\": \"2026-11-18T06:30:00Z\",\r\n    \"title\": \"Schema v2.3: tombstones retire SKUs - integrator action required for local price overrides\",\r\n    \"body\": \"Schema v2.3 (feed epoch 2026.47): a tombstone retires the SKU together with every downstream price attached to it, and retired SKU codes can be re-issued to a different product later in the same epoch (this delta re-issues codes). When applying a tombstone, integrators must end any local price override still active for that SKU (set its end date to the day before the tombstone) so the retired product can be removed and a re-issued product does not inherit the "]
[25.447713, "o", "old promo/clearance price. Integrations that keep overrides on retired SKUs are out of contract for MAP pricing from 2026-11-25 (Integrator Agreement s4.2).\"\r\n  }\r\n]\r\n\r\n"]
