[156.58435, "i", "cd /app && python - <<'PY'\nimport datetime as dt\nimport json\nimport sqlite3\nfrom decimal import Decimal\nfrom pathlib import Path\nfrom feedsync import store\n\nevents = sorted((json.loads(line) for path in sorted(Path('dev/feed_data').glob('changes*.jsonl'))\n                 for line in path.read_text().splitlines() if line.strip()), key=lambda e:e['seq'])\nexpected = {}\nfor e in events:\n if e['op']=='delete': expected.pop(e['sku'],None)\n else: expected[e['sku']] = (e['title'],int(Decimal(e['price'])*100),e['currency'],e.get('updated_at'),e['seq'])\nc = sqlite3.connect('data/catalog.db'); c.row_factory=sqlite3.Row\nactual = {r['sku']:(r['title'],r['price_cents'],r['currency'],r['updated_at'],r['feed_seq']) for r in c.execute('SELECT * FROM products')}\nassert actual==expected, (actual,expected)\nassert c.execute('SELECT count(*) FROM products').fetchone()[0]==len(expected)\nassert c.execute('PRAGMA integrity_check').fetchone()[0]=='ok'\nb = sqlite3.connect('/var/tmp/feedsync-before-v2-fix.db'); b.row_factory=sqlite3.Ro"]
[156.584749, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import datetime as dt\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.585065, "i", "w\nbefore = {r['id']:dict(r) for r in b.execute('SELECT * FROM price_overrides')}\nexpected_overrides = {k:dict(v) for k,v in before.items()}\nfor e in events:\n if e['op']!='delete': continue\n day=e['updated_at'][:10]\n for row in expected_overrides.values():\n  if row['sku']==e['sku'] and row['starts_on']<=day and (row['ends_on'] is None or row['ends_on']>=day):\n   row['ends_on']=(dt.date.fromisoformat(day)-dt.timedelta(days=1)).isoformat()\nafter = {r['id']:dict(r) for r in c.execute('SELECT * FROM price_overrides')}\nassert after==expected_overrides\nprint('Validated all columns for',len(expected),'unique products against all',len(events),'feed events.')\nprint('Preserved all',len(after),'override audit rows. Changed only:')\nfor key in before:\n if before[key]!=after[key]: print(after[key]['sku'], 'ends_on:',before[key]['ends_on'],'->',after[key]['ends_on'])\nassert c.execute(\"SELECT sql FROM sqlite_master WHERE name='merch_guard_active_override'\").fetchone()[0]==b.execute(\"SELECT sql FROM sqlite_master WHERE name='m"]
[156.585116, "o", "from decimal import Decimal"]
[156.585122, "i", "erch_guard_active_override'\").fetchone()[0]\nprint('Deletion guard unchanged; integrity_check: ok')\nreport_conn = store.connect('data/catalog.db')\nrows=store.report_rows(report_conn)\ntoday=dt.date.today().isoformat()\nfor row in rows:\n active=[o for o in after.values() if o['sku']==row['sku'] and o['starts_on']<=today and (o['ends_on'] is None or o['ends_on']>=today)]\n active.sort(key=lambda o:(o['starts_on'],o['id']),reverse=True)\n cents=active[0]['override_cents'] if active else expected[row['sku']][1]\n assert row['effective_price']==f'{cents//100}.{cents%100:02d}'\n assert row['source']==('override' if active else 'feed')\nprint('Independently validated every effective report price.')\nprint('Stored cursor:',store.get_state(report_conn,'feed_cursor'))\nprint('Feed requests so far:')\nfor line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines():\n r=json.loads(line)\n if r['path']=='/v2/changes': print({k:r[k] for k in ['cursor','status','items','tombstones','next_cursor','has_more','ack']})\nPY\n"]
