[119.643262, "o", "ective_price(self.conn, \"SKU\"), (858, \"feed\"))\r\n\u001b[?2004l\r\u001b[?2004h>         rows = {r[\"id\"]: dict(r) for r in self.conn.execute(\"SELECT * FROM price_overrides\")}\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(rows[active][\"ends_on\"], (day - dt.timedelta(days=1)).isoformat())\r\n\u001b[?2004l\r\u001b[?2004h>         expected = dict(before[active], ends_on=(day - dt.timedelta(days=1)).isoformat())\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(rows[active], expected)\r\n\u001b[?2004l\r\u001b[?2004h>         for key in [expired, future, unrelated]:\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(rows[key], before[key])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertIsNotNone(self.conn.execute(\r\n\u001b[?2004l\r\u001b[?2004h>             \"SELECT 1 FROM sqlite_master WHERE type='trigger' AND name='merch_guard_active_override'\").fetchone())\r\n\u001b[?2004l\r\u001b[?2004h>         self.override()\r\n\u001b[?2004l\r\u001b[?2004h>         with self.assertRaises(sqlite3.IntegrityError):\r\n\u001b[?2004l\r\u001b[?2004h>             with self.conn:\r\n\u001b[?2004l\r\u001b[?2004h>                 self.conn.execute(\"DELE"]
[119.643273, "o", "TE FROM products WHERE sku='SKU'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_tombstone_ends_overrides_at_retirement_not_sync_date(self):\r\n\u001b[?2004l\r\u001b[?2004h>         old = self.override(starts=\"2020-01-01\", ends=\"2026-11-15\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
