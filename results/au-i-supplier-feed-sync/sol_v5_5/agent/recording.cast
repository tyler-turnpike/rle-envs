[119.645379, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645433, "o", "    def test_completed_page_survives_network_failure(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645537, "o", "        class Interrupted:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.64556, "o", "            def iter_pages(self, cursor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645726, "o", "                yield page(\"saved\", [item(1)], more=True)\r\n\u001b[?2004l\r\u001b[?2004h>                 raise RuntimeError(\"connection interrupted\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645824, "o", "        with self.assertRaises(RuntimeError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645849, "o", "            run_sync(self.conn, Interrupted())\r\n\u001b[?2004l\r"]
[119.645854, "o", "\u001b[?2004h"]
[119.645859, "o", "> "]
[119.64596, "o", "        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"saved\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646042, "o", "        self.assertEqual(store.product_count(self.conn), 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.6461, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646154, "o", "    def test_override_dates_newest_active_and_zero_price(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646181, "o", "        with self.conn:\r\n\u001b[?2004l\r"]
[119.646218, "o", "\u001b[?2004h> "]
[119.646281, "o", "            store.insert_product(self.conn, item(1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646363, "o", "        self.override(ends=\"2025-01-01\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646428, "o", "        self.override(starts=\"2026-01-01\", ends=\"2026-11-22\", cents=299)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.646442, "o", "> "]
[119.646539, "o", "        self.override(starts=\"2026-01-01\", ends=\"2026-11-22\", cents=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646603, "o", "        self.override(starts=\"2027-01-01\", cents=999)\r\n\u001b[?2004l\r"]
[119.646714, "o", "\u001b[?2004h>         row = store.report_rows(self.conn, \"2026-11-22\")[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.646812, "o", "        self.assertEqual((row[\"feed_price\"], row[\"effective_price\"], row[\"source\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.64683, "o", "> "]
[119.646893, "o", "                         (\"4.35\", \"0.00\", \"override\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.646942, "o", "> "]
[119.647002, "o", "        self.assertEqual(store.effective_price(self.conn, \"SKU\", \"2026-11-23\"), (435, \"feed\"))\r\n\u001b[?2004l\r"]
[119.647051, "o", "\u001b[?2004h> "]
