[119.614931, "i", "rn {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": more}\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.start = None\n\n    def iter_pages(self, cursor):\n        self.start = cursor\n        yield from self.pages\n\n\nclass StoreTest(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addCleanup(self.conn.close)\n\n    def override(self, sku=\"SKU\", cents=199, starts=\"2020-01-01\", ends=None, created=\"2026-01-01\"):\n        cur = self.conn.execute(\n            \"INSERT INTO price_overrides \"\n            \"(sku, override_cents, starts_on, ends_on, author, reason, created_at) \"\n            \"VALUES (?, ?, ?, ?, 'merch/test', 'promo', ?)\", (sku, cents, starts, ends, created))\n        self.conn.commit()\n        return cur.lastrowid\n\n    def test_exact_cents(self):\n        for price, cents in [(\"4.35\", 435), (\"19.99\", 1999), (\"0.29\", 29),\n                             (\"0.57\", 57), (\"8.58\""]
[119.614961, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[119.614966, "i", ", 858), (\"15.99\", 1599), (\"-0.29\", -29)]:\n            self.assertEqual(store.price_to_cents(price), cents)\n            self.assertEqual(store.format_cents(cents), price)\n        with self.assertRaises(ValueError):\n            store.price_to_cents(\"0.001\")\n\n    def test_ordered_retirement_reissue_preserves_overrides_and_guard(self):\n        self.conn.executescript(GUARD)\n        day = dt.date.today()\n        active = self.override(starts=day.isoformat())\n        expired = self.override(ends=\"2021-01-01\")\n        future = self.override(starts=\"2099-01-01\", ends=\"2099-12-31\")\n        unrelated = self.override(sku=\"OTHER\")\n        before = {r[\"id\"]: dict(r) for r in self.conn.execute(\"SELECT * FROM price_overrides\")}\n        tombstone = {\"sku\": \"SKU\", \"seq\": 2, \"deleted_at\": day.isoformat() + \"T12:00:00Z\"}\n        # The arrays aren't globally ordered: delete must happen between these upserts.\n        run_sync(self.conn, Pages(page(\"end\", [item(4, price=\"8.58\"), item(1), item(3)], [tombstone])))\n        self.asser"]
