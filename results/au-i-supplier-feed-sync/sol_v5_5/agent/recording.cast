[119.644576, "o", "\u001b[?2004h> "]
[119.644662, "o", "            run_sync(self.conn, Pages(page(\"failed\", [bad], [{\"sku\": \"SKU\", \"seq\": 3}])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.644695, "o", "        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"first\")\r\n\u001b[?2004l\r"]
[119.644709, "o", "\u001b[?2004h> "]
[119.644792, "o", "        self.assertEqual(store.product_count(self.conn), 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.64484, "o", "> "]
[119.644928, "o", "        self.assertIsNone(self.conn.execute(\"SELECT ends_on FROM price_overrides WHERE id=?\", (oid,)).fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.645038, "o", "        replay = Pages(page(\"end\", [], [{\"sku\": \"SKU\", \"seq\": 3}]))\r\n\u001b[?2004l\r"]
[119.64511, "o", "\u001b[?2004h> "]
[119.645139, "o", "        run_sync(self.conn, replay)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(replay.start, \"first\")\r\n\u001b[?2004l\r"]
[119.645148, "o", "\u001b[?2004h"]
[119.645257, "o", ">         self.assertEqual(store.product_count(self.conn), 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
