[119.644178, "o", "\u001b[?2004h> "]
[119.644311, "o", "        self.conn.executescript(GUARD)\r\n\u001b[?2004l\r\u001b[?2004h>         oid = self.override()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.644351, "o", "        run_sync(self.conn, Pages(page(\"first\", [item(1)])))\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.644377, "o", "> "]
