[78.42906, "i", ".assertEqual(store.effective_price(self.conn, \"missing\"), (None, None))\n\n    def test_legacy_duplicates_migrated_and_uniqueness_enforced(self):\n        self.override(399, \"2026-01-01\")\n        with self.conn:\n            self.conn.execute(\"DROP INDEX products_sku_unique\")\n            for seq, price in [(10, 100), (None, 200), (9, 300), (10, 400)]:\n                self.conn.execute(\"INSERT INTO products \"\n                                  \"(sku, title, price_cents, feed_seq) VALUES ('A', 'old', ?, ?)\",\n                                  (price, seq))\n        migrated = store.connect(self.path)\n        self.addCleanup(migrated.close)\n        self.assertEqual(self.products(), [(\"A\", 400, 10)])\n        self.assertEqual(store.active_override(migrated, \"A\", \"2026-11-22\")[\"override_cents\"], 399)\n        with self.assertRaises(sqlite3.IntegrityError), migrated:\n            migrated.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A', 'bad', 1)\")\n        with migrated:\n            store.insert_product(m"]
