[101.194521, "o", "last sync:   2026-11-22T15:23:37Z\r\nproducts:    47\r\noverrides:   25 active\r\n"]
[101.203453, "o", "\u001b[?2004hroot@31fc47e2f052:/app# "]
[116.059226, "i", "python - <<'PY'\nfrom pathlib import Path\nimport sqlite3\nout = Path('/tmp/feedsync-validation')\nlog = Path('/var/tmp/feedstub/requests.log')\n(out / 'log-after-first.txt').write_text(str(len(log.read_text().splitlines())))\nwith sqlite3.connect('data/catalog.db') as conn:\n (out / 'cursor-after-first.txt').write_text(conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0])\nPY\npython -m feedsync sync\npython -m feedsync report --json > /tmp/feedsync-validation/report.json\n"]
