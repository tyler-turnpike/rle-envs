[48.423945, "i", "     store.insert_product(conn, item)\n                    stats[\"upserts\"] += 1\n            # Empty windows still advance the cursor. Commit changes and their\n            # checkpoint together, before asking the client for another page.\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\n    with conn:\n        store.set_state(conn, \"last_sync_at\", store.now_iso())\n''' + s[end:]\ns = s.replace('    store.set_state(conn, \"last_sync_at\", store.now_iso())\\n    conn.commit()\\n', '')\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
