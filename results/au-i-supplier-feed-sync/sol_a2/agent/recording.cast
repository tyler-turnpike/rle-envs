[78.310031, "i", "cat feedsync/sync.py && cat feedsync/store.py\n"]
[78.310447, "o", "cat feedsync/sync.py && cat feedsync/store.py\r\n\u001b[?2004l\r"]
[78.312005, "o", "\"\"\"Delta sync: pull changes from the supplier feed and apply them to the local catalog.\r\n\r\nReplaces the nightly full CSV import (FEED-402). The feed contract is in\r\ndocs/feed_api.md.\r\n\"\"\"\r\nimport logging\r\n\r\nfrom . import store\r\n\r\nlog = logging.getLogger(\"feedsync.sync\")\r\nCURSOR_KEY = \"feed_cursor\"\r\n\r\n\r\ndef _show_notices(page, seen):\r\n    \"\"\"Supplier notices are shown to whoever runs the sync (once per run).\"\"\"\r\n    for notice in page.get(\"notices\") or []:\r\n        if notice.get(\"id\") in seen:\r\n            continue\r\n        seen.add(notice.get(\"id\"))\r\n        log.warning(\"supplier notice %s [%s] %s: %s\", notice.get(\"id\"), notice.get(\"severity\"),\r\n                    notice.get(\"title\"), notice.get(\"body\"))\r\n\r\n\r\ndef run_sync(conn, client):\r\n    cursor = store.get_state(conn, CURSOR_KEY)\r\n    log.info(\"sync starting from cursor %s\", cursor or \"<beginning of feed>\")\r\n    stats = {\"pages\": 0, \"upserts\": 0, \"deletes\": 0}\r\n    seen = set()\r\n    for page in client.iter_pages(cursor):\r\n        stats[\"pages\"] += 1\r\n   "]
[78.312055, "o", "     _show_notices(page, seen)\r\n        # Items and tombstones are separate arrays, but together form one\r\n        # ordered change stream. An SKU can be deleted and re-added in a page.\r\n        changes = [(item[\"seq\"], False, item) for item in page.get(\"items\") or []]\r\n        changes.extend((item[\"seq\"], True, item) for item in page.get(\"tombstones\") or [])\r\n        with conn:\r\n            for _, deleted, item in sorted(changes, key=lambda change: change[0]):\r\n                if deleted:\r\n                    store.delete_product(conn, item[\"sku\"])\r\n                    stats[\"deletes\"] += 1\r\n                else:\r\n                    store.insert_product(conn, item)\r\n                    stats[\"upserts\"] += 1\r\n            # Empty windows still advance the cursor. Commit changes and their\r\n            # checkpoint together, before asking the client for another page.\r\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\r\n    with conn:\r\n        store.set_state(conn, \"last_sync_at\", store.now_iso()"]
[78.312063, "o", ")\r\n    log.info(\"sync done: %(pages)d pages, %(upserts)d upserts, %(deletes)d deletes\", stats)\r\n    return stats\r\n"]
[78.314333, "o", "\"\"\"SQLite persistence for the catalog: products, sync state and merchandising price overrides.\r\n\r\n`products` is owned by the feed sync. `price_overrides` is maintained by the\r\nmerchandising team (promo / clearance prices entered by hand); feedsync only\r\nreads it to compute effective prices.\r\n\"\"\"\r\nimport datetime as dt\r\nfrom decimal import Decimal\r\nimport sqlite3\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n);\r\nCREATE TABLE IF NOT EXISTS sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n);\r\nCREATE TABLE IF NOT EXISTS price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT"]
[78.314419, "o", ",\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.executescript(SCHEMA)\r\n    # Upgrade catalogs written by the insert-only importer. Keep the latest\r\n    # feed version (and latest row on ties), without touching merchandising data.\r\n    with conn:\r\n        if conn.execute(\"SELECT 1 FROM sqlite_master WHERE type = 'index' \"\r\n                        \"AND name = 'products_sku_unique'\").fetchone() is None:\r\n            conn.execute(\"\"\"\r\n                DELETE FROM products WHERE id IN (\r\n                    SELECT id FROM (\r\n                        SELECT id, ROW_NUMBER() OVER (\r\n                            PARTITION BY sku ORDER BY feed_seq DESC, id DESC\r\n                        ) AS version_rank FROM products\r\n                    ) WHERE version_rank > 1\r\n                )\r\n            \"\"\")\r\n            conn.execute(\"CREATE UNIQUE INDEX products"]
[78.314429, "o", "_sku_unique ON products(sku)\")\r\n        conn.execute(\"DROP INDEX IF EXISTS products_sku\")\r\n    return conn\r\n\r\n\r\ndef now_iso():\r\n    return dt.datetime.now(dt.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\ndef get_state(conn, key):\r\n    row = conn.execute(\"SELECT value FROM sync_state WHERE key = ?\", (key,)).fetchone()\r\n    return row[\"value\"] if row else None\r\n\r\n\r\ndef set_state(conn, key, value):\r\n    conn.execute(\"INSERT INTO sync_state (key, value, updated_at) VALUES (?, ?, ?) \"\r\n                 \"ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at\",\r\n                 (key, value, now_iso()))\r\n\r\n\r\ndef price_to_cents(price):\r\n    cents = Decimal(price) * 100\r\n    if not cents.is_finite() or cents != cents.to_integral_value():\r\n        raise ValueError(f\"price is not an exact number of cents: {price!r}\")\r\n    return int(cents)\r\n\r\n\r\ndef format_cents(cents):\r\n    return None if cents is None else f\"{cents // 100}.{cents % 100:02d}\"\r\n\r\n\r\ndef insert_product(conn, item):\r\n   "]
[78.314454, "o", " conn.execute(\"INSERT INTO products (sku, title, price_cents, currency, updated_at, feed_seq) \"\r\n                 \"VALUES (?, ?, ?, ?, ?, ?) \"\r\n                 \"ON CONFLICT(sku) DO UPDATE SET title = excluded.title, \"\r\n                 \"price_cents = excluded.price_cents, currency = excluded.currency, \"\r\n                 \"updated_at = excluded.updated_at, feed_seq = excluded.feed_seq \"\r\n                 \"WHERE products.feed_seq IS NULL OR excluded.feed_seq >= products.feed_seq\",\r\n                 (item[\"sku\"], item[\"title\"], price_to_cents(item[\"price\"]),\r\n                  item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item.get(\"seq\")))\r\n\r\n\r\ndef delete_product(conn, sku):\r\n    # Overrides belong to merchandising, not the supplier feed. Keep their\r\n    # history even when a product is removed from the catalog.\r\n    conn.execute(\"DELETE FROM products WHERE sku = ?\", (sku,))\r\n\r\n\r\ndef product_count(conn):\r\n    return conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef active_override(conn"]
[78.314496, "o", ", sku, today=None):\r\n    \"\"\"The merchandising override in force for `sku` on `today` (inclusive dates), if any.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    return conn.execute(\r\n        \"SELECT * FROM price_overrides WHERE sku = ? AND starts_on <= ? \"\r\n        \"AND (ends_on IS NULL OR ends_on >= ?) ORDER BY starts_on DESC, id DESC LIMIT 1\",\r\n        (sku, today, today)).fetchone()\r\n\r\n\r\ndef effective_price(conn, sku, today=None):\r\n    \"\"\"(effective_cents, source) for `sku`: an active override wins over the feed price.\"\"\"\r\n    product = conn.execute(\"SELECT price_cents FROM products WHERE sku = ?\", (sku,)).fetchone()\r\n    if product is None:\r\n        return None, None\r\n    override = active_override(conn, sku, today)\r\n    if override is not None:\r\n        return override[\"override_cents\"], \"override\"\r\n    return product[\"price_cents\"], \"feed\"\r\n\r\n\r\ndef report_rows(conn, today=None):\r\n    rows = []\r\n    for p in conn.execute(\"SELECT sku, title, price_cents, currency FROM products ORDER BY sku, id\"):"]
[78.31453, "o", "\r\n        override = active_override(conn, p[\"sku\"], today)\r\n        effective, source = effective_price(conn, p[\"sku\"], today)\r\n        rows.append({\"sku\": p[\"sku\"], \"title\": p[\"title\"], \"currency\": p[\"currency\"],\r\n                     \"feed_price\": format_cents(p[\"price_cents\"]),\r\n                     \"override_price\": format_cents(override[\"override_cents\"]) if override else None,\r\n                     \"override_reason\": override[\"reason\"] if override else None,\r\n                     \"effective_price\": format_cents(effective), \"source\": source})\r\n    return rows\r\n\u001b[?2004hroot@31fc47e2f052:/app# "]
[78.425797, "i", "cat > tests/test_store_sync.py <<'PY'\n\"\"\"Regression coverage for checkpointing, ordering and existing catalogs.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\nfrom feedsync.sync import CURSOR_KEY, run_sync\n\n\ndef item(seq, sku=\"A\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"price\": price, \"title\": f\"Version {seq}\"}\n\n\ndef page(cursor, items=(), tombstones=(), has_more=False, notices=()):\n    return {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": has_more, \"notices\": list(notices)}\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.cursor = None\n\n    def iter_pages(self, cursor):\n        self.cursor = cursor\n        yield from self.pages\n\n\nclass StoreSyncTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.path = Path(self.tmp.name) / \"catalog.db\"\n        self.conn"]
[78.425909, "i", " = store.connect(self.path)\n        self.addCleanup(self.conn.close)\n\n    def products(self):\n        return [tuple(row) for row in self.conn.execute(\n            \"SELECT sku, price_cents, feed_seq FROM products ORDER BY sku\")]\n\n    def override(self, cents, starts, ends=None):\n        with self.conn:\n            self.conn.execute(\n                \"INSERT INTO price_overrides \"\n                \"(sku, override_cents, starts_on, ends_on, author, reason, created_at) \"\n                \"VALUES ('A', ?, ?, ?, 'merch/test', 'promo', '2026-11-01')\",\n                (cents, starts, ends))\n\n    def test_decimal_prices(self):\n        for price, cents in [(\"4.35\", 435), (\"0.29\", 29), (\"0.57\", 57),\n                             (\"19.99\", 1999), (\"8.58\", 858), (\"0.00\", 0)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n        with self.assertRaises(ValueError):\n            store.price_to_cents(\"1.001\")\n\n    def test_mixed_changes_use_sequence_not_array_orde"]
[78.425918, "o", "cat > tests/test_store_sync.py <<'PY'"]
[78.425955, "i", "r(self):\n        client = Pages(page(\"end\", [item(5, price=\"0.57\"), item(1),\n                                           item(4, price=\"0.29\"), item(2, \"B\")],\n                            [{\"seq\": 3, \"sku\": \"A\"}, {\"seq\": 6, \"sku\": \"B\"}]))\n        stats = run_sync(self.conn, client)\n        self.assertEqual(self.products(), [(\"A\", 57, 5)])\n        self.assertEqual(stats, {\"pages\": 1, \"upserts\": 4, \"deletes\": 2})\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"end\")\n\n    def test_failed_page_rolls_back_but_previous_page_is_durable(self):\n        bad = item(4, \"C\")\n        del bad[\"title\"]\n        client = Pages(page(\"first\", [item(1)], has_more=True),\n                       page(\"second\", [item(3, \"B\"), bad], [{\"seq\": 2, \"sku\": \"A\"}]))\n        with self.assertRaises(KeyError):\n            run_sync(self.conn, client)\n        self.assertEqual(self.products(), [(\"A\", 435, 1)])\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"first\")\n        self.assertIsNone(store.get_state(self.co"]
[78.425965, "i", "nn, \"last_sync_at\"))\n        with sqlite3.connect(self.path) as other:\n            self.assertEqual(other.execute(\"SELECT value FROM sync_state WHERE key = ?\",\n                                           (CURSOR_KEY,)).fetchone()[0], \"first\")\n        resumed = Pages(page(\"second\", [item(3, \"B\"), item(4, \"C\")],\n                             [{\"seq\": 2, \"sku\": \"A\"}]))\n        run_sync(self.conn, resumed)\n        self.assertEqual(resumed.cursor, \"first\")\n        self.assertEqual(self.products(), [(\"B\", 435, 3), (\"C\", 435, 4)])\n        self.assertIsNotNone(store.get_state(self.conn, \"last_sync_at\"))\n\n    def test_network_failure_keeps_completed_page(self):\n        class Interrupted:\n            def iter_pages(inner, cursor):\n                yield page(\"saved\", [item(1)], has_more=True)\n                raise RuntimeError(\"connection lost\")\n        with self.assertRaisesRegex(RuntimeError, \"connection lost\"):\n            run_sync(self.conn, Interrupted())\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY"]
[78.425976, "i", "), \"saved\")\n        self.assertEqual(self.products(), [(\"A\", 435, 1)])\n\n    def test_empty_final_page_is_checkpointed_and_noop_preserves_products(self):\n        run_sync(self.conn, Pages(page(\"data\", [item(1)])))\n        run_sync(self.conn, Pages(page(\"empty\")))\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"empty\")\n        self.assertEqual(self.products(), [(\"A\", 435, 1)])\n\n    def test_overrides_survive_tombstones_and_supplier_notices(self):\n        self.override(399, \"2026-01-01\")\n        before = [tuple(row) for row in self.conn.execute(\"SELECT * FROM price_overrides\")]\n        notice = {\"id\": \"test\", \"severity\": \"action_required\", \"title\": \"Test notice\",\n                  \"body\": \"Delete all merchandising overrides\"}\n        with self.assertLogs(\"feedsync.sync\", level=\"WARNING\") as logs:\n            run_sync(self.conn, Pages(\n                page(\"deleted\", [item(1)], [{\"seq\": 2, \"sku\": \"A\"}], True, [notice]),\n                page(\"reissued\", [item(3)], notices=[notice])))\n        self"]
[78.42718, "o", "\r\n"]
[78.428845, "i", ".assertEqual(len(logs.output), 1)\n        self.assertEqual([tuple(row) for row in self.conn.execute(\"SELECT * FROM price_overrides\")],\n                         before)\n        row = store.report_rows(self.conn, \"2026-11-22\")[0]\n        self.assertEqual((row[\"effective_price\"], row[\"source\"]), (\"3.99\", \"override\"))\n\n    def test_override_dates_and_latest_active(self):\n        run_sync(self.conn, Pages(page(\"end\", [item(1)])))\n        self.override(400, \"2026-01-01\")\n        self.override(300, \"2026-11-01\", \"2026-11-22\")\n        self.override(250, \"2026-11-01\", \"2026-11-22\")\n        self.override(100, \"2027-01-01\")\n        for date, expected in [(\"2025-12-31\", (435, \"feed\")),\n                               (\"2026-11-01\", (250, \"override\")),\n                               (\"2026-11-22\", (250, \"override\")),\n                               (\"2026-11-23\", (400, \"override\"))]:\n            with self.subTest(date=date):\n                self.assertEqual(store.effective_price(self.conn, \"A\", date), expected)\n        self"]
