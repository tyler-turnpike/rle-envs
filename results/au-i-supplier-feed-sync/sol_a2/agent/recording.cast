[48.423133, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('feedsync/store.py')\ns = p.read_text().replace('import datetime as dt\\n', 'import datetime as dt\\nfrom decimal import Decimal\\n')\ns = s.replace('CREATE INDEX IF NOT EXISTS products_sku ON products(sku);\\n', '')\ns = s.replace('    conn.executescript(SCHEMA)\\n    return conn\\n', '''    conn.executescript(SCHEMA)\n    # Upgrade catalogs written by the insert-only importer. Keep the latest\n    # feed version (and latest row on ties), without touching merchandising data.\n    with conn:\n        if conn.execute(\"SELECT 1 FROM sqlite_master WHERE type = 'index' \"\n                        \"AND name = 'products_sku_unique'\").fetchone() is None:\n            conn.execute(\"\"\"\n                DELETE FROM products WHERE id IN (\n                    SELECT id FROM (\n                        SELECT id, ROW_NUMBER() OVER (\n                            PARTITION BY sku ORDER BY feed_seq DESC, id DESC\n                        ) AS version_rank FROM products\n                    ) WHERE "]
