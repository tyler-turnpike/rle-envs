[117.068829, "i", "python - <<'PY'\nimport datetime, json, sqlite3\nfrom decimal import Decimal\nfrom pathlib import Path\nout = Path('/tmp/feedsync-validation')\nevents = [json.loads(line) for p in sorted(Path('dev/feed_data').glob('changes*.jsonl')) for line in p.read_text().splitlines() if line.strip()]\nexpected = {}\nfor event in sorted(events, key=lambda e: e['seq']):\n if event['op'] == 'delete':\n  expected.pop(event['sku'], None)\n else:\n  expected[event['sku']] = (event['title'], int(Decimal(event['price']) * 100), event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nwith sqlite3.connect('data/catalog.db') as conn:\n actual = {r[0]: r[1:] for r in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\n assert actual == expected, 'Catalog differs from feed replay'\n assert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0] == len(expected)\n before = json.loads((out / 'overrides-before.json').read_text())\n overrides = conn.execute('SELECT * FROM price_overrides ORDER B"]
[117.069788, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import datetime, json, sqlite3\r\n"]
[117.069798, "i", "Y id').fetchall()\n assert [list(r) for r in overrides] == before, 'Overrides changed'\n assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\nrows = json.loads((out / 'report.json').read_text())\nassert len(rows) == len(expected)\ntoday = datetime.date.today().isoformat()\ndef money(cents): return f'{Decimal(cents) / 100:.2f}'\nfor row in rows:\n sku = row['sku']\n eligible = [o for o in overrides if o[1] == sku and o[3] <= today and (o[4] is None or o[4] >= today)]\n override = max(eligible, key=lambda o: (o[3], o[0])) if eligible else None\n cents = override[2] if override else expected[sku][1]\n assert row['feed_price'] == money(expected[sku][1]), row\n assert row['effective_price'] == money(cents), row\n assert row['source'] == ('override' if override else 'feed'), row\n assert row['override_price'] == (money(override[2]) if override else None), row\nlogs = [json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines()]\nfirst_start = int((out / 'log-start.txt').read_text())\n"]
[117.069804, "i", "first_end = int((out / 'log-after-first.txt').read_text())\nfirst = [r for r in logs[first_start:first_end] if r['path'] == '/v2/changes']\nsecond = [r for r in logs[first_end:] if r['path'] == '/v2/changes']\nassert len(first) == 10, first\nassert len(second) == 1, second\nassert second[0]['cursor'] == first[-1]['next_cursor'] == (out / 'cursor-after-first.txt').read_text()\nassert not second[0]['has_more'] and second[0]['items'] == 0 and second[0]['tombstones'] == 0\nprint(f'Validated {len(actual)} unique products, all columns and exact prices against feed replay.')\nprint(f'Validated all {len(rows)} report rows and preserved all {len(overrides)} override records.')\nprint(f'Incremental rerun: {len(second)} request at stored cursor, no historical pages or changes.')\nprint('SQLite integrity_check: ok')\nPY\npython -m unittest discover -s tests -v\n"]
