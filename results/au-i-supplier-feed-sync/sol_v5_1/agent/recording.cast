[28.436776, "i", "python - <<'PY'\nimport sqlite3, json\nfrom pathlib import Path\nc = sqlite3.connect('data/catalog.db'); c.row_factory = sqlite3.Row\nprint('SCHEMA:', '\\n'.join(r[0] for r in c.execute('SELECT sql FROM sqlite_master WHERE sql IS NOT NULL')))\nfor table in ('products', 'sync_state', 'price_overrides'):\n    rows = list(c.execute('SELECT * FROM '+table))\n    print(table, len(rows))\n    if table != 'products':\n        for r in rows: print(dict(r))\nprint('DUPES', [tuple(r) for r in c.execute('SELECT sku, count(*) FROM products GROUP BY sku HAVING count(*)>1')])\nevents=[json.loads(l) for l in Path('dev/feed_data/changes.jsonl').read_text().splitlines() if l.strip()]\nprint('EVENTS', len(events), 'SEQ RANGE', events[0]['seq'], events[-1]['seq'])\nprint('GATED', [e for e in events if e.get('gate')])\nPY\n"]
