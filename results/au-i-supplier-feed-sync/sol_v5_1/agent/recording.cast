[106.665196, "i", "python - <<'PY'\nimport json, sqlite3\nfrom decimal import Decimal\nfrom pathlib import Path\nfrom feedsync import store\nexpected = {}\nfor event in sorted((json.loads(line) for p in Path('dev/feed_data').glob('changes*.jsonl') for line in p.read_text().splitlines() if line.strip()), key=lambda e: e['seq']):\n    if event['op'] == 'delete':\n        expected.pop(event['sku'], None)\n    else:\n        expected[event['sku']] = (event['sku'], event['title'], int(Decimal(event['price'])*100), event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nc = store.connect('data/catalog.db')\nactual = {r['sku']:tuple(r) for r in c.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\nassert actual == expected, (actual, expected)\nassert store.product_count(c) == len(expected)\nbackup = sqlite3.connect('/var/tmp/feedsync-backups/catalog.before-v2-fix.db')\nassert [tuple(r) for r in c.execute('SELECT * FROM price_overrides ORDER BY id')] == backup.execute('SELECT * FROM price_overrides O"]
[106.66554, "i", "RDER BY id').fetchall()\nassert c.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\nrows=store.report_rows(c)\nassert len(rows) == len(expected)\nfor r in rows:\n    override = c.execute('SELECT override_cents FROM price_overrides WHERE sku=? AND starts_on<=date(\\'now\\') AND (ends_on IS NULL OR ends_on>=date(\\'now\\')) ORDER BY starts_on DESC, id DESC LIMIT 1', (r['sku'],)).fetchone()\n    cents = override[0] if override else expected[r['sku']][2]\n    assert Decimal(r['effective_price'])*100 == cents\n    assert r['source'] == ('override' if override else 'feed')\nprint(f'Verified all {len(expected)} products and effective prices; all 34 override records unchanged; SQLite integrity OK.')\nprint('Cursor:', store.get_state(c, 'feed_cursor'))\nlog=Path('/var/tmp/feedstub/requests.log')\nrequests=[json.loads(l) for l in log.read_text().splitlines() if json.loads(l)['path']=='/v2/changes']\nprint('Local feed requests:', [(r['cursor'],r['status'],r['items'],r['tombstones'],r['has_more']) for r in requests])\nPath('/var/tm"]
