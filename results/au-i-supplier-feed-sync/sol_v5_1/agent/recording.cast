[106.775779, "i", "python -m feedsync sync > /var/tmp/feedsync-second-sync.json && cat /var/tmp/feedsync-second-sync.json && python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom feedsync import store\nbefore=json.loads(Path('/var/tmp/feedsync-before-second.json').read_text())\nrequests=[json.loads(l) for l in Path('/var/tmp/feedstub/requests.log').read_text().splitlines() if json.loads(l)['path']=='/v2/changes'][before['requests']:]\nassert len(requests)==1, requests\nassert requests[0]['cursor']==before['cursor'], requests\nassert requests[0]['items']==requests[0]['tombstones']==0\nc=store.connect('data/catalog.db')\nassert store.get_state(c, 'feed_cursor')==before['cursor']\nassert [list(r) for r in c.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products ORDER BY sku')]==before['products']\nassert store.report_rows(c)==before['report']\nprint('Incremental verification passed: one request at the saved cursor, zero changes, catalog/report unchanged.')\nPY\npython -m feedsync report\n"]
