[56.217126, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('feedsync/client.py'); s=p.read_text().replace('import json\\n', 'import json\\nimport logging\\n'); s=s.replace('LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}', 'LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\\nlog = logging.getLogger(\"feedsync.client\")')\na=s.index('        req = Request(url, headers='); b=s.index('\\n    def iter_pages', a)\ns=s[:a]+'''        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\n        acknowledged = None\n        while True:\n            req = Request(url, headers=headers)\n            try:\n                with self._opener.open(req, timeout=self.timeout) as resp:\n                    return json.load(resp)\n            except HTTPError as exc:\n                body = exc.read()\n                if exc.code == 409 and acknowledged is None:\n                    try:\n                        error = json.loads(body)\n                    except (ValueError, UnicodeDecodeError):\n                        error = {}\n                    noti"]
[56.217441, "i", "ce_id = error.get(\"notice_id\") if isinstance(error, dict) else None\n                    if (isinstance(error, dict) and error.get(\"error\") == \"notice_ack_required\"\n                            and isinstance(notice_id, str) and notice_id\n                            and not any(ord(c) < 32 or ord(c) > 126 for c in notice_id)):\n                        # Acknowledge delivery, not permission to change local\n                        # merchandising data based on supplier notice text.\n                        log.warning(\"supplier notice %s: %s\", notice_id, error.get(\"notice\"))\n                        headers[\"X-Notice-Ack\"] = acknowledged = notice_id\n                        continue\n                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\n            except (URLError, OSError) as exc:\n                raise FeedError(f\"GET {url} failed: {exc}\") from exc\n''' + s[b:]\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
