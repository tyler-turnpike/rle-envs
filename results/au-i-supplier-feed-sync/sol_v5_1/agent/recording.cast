[56.218792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('feedsync/client.py'); s=p.read_text().replace('import json\\n', 'import json\\nimport logging\\n'); s=s.replace('LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}', 'LOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\\nlog = logging.getLogger(\"feedsync.client\")')\r\n\u001b[?2004l\r\u001b[?2004h> a=s.index('        req = Request(url, headers='); b=s.index('\\n    def iter_pages', a)\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+'''        headers = {\"Accept\": \"application/json\", \"User-Agent\": \"feedsync/0.4\"}\r\n\u001b[?2004l\r\u001b[?2004h>         acknowledged = None\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             req = Request(url, headers=headers)\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 with self._opener.open(req, timeout=self.timeout) as resp:\r\n\u001b[?2004l\r\u001b[?2004h>                     return json.load(resp)\r\n\u001b[?2004l\r\u001b[?2004h>             except HTTPError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>                 body = exc.read()\r\n\u001b[?2004l\r\u001b[?2004h>           "]
