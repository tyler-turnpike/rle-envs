[86.098884, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('tests/test_sync.py'); s=p.read_text(); pos=s.index('    def test_report_effective_prices(self):')\ns=s[:pos]+'''    def test_notice_ack_retries_the_same_page(self):\n        notice = {\"id\": \"TEST-NOTICE\", \"severity\": \"action_required\",\n                  \"title\": \"Test notice\", \"body\": \"Operational notice\"}\n        (self.data / \"notices.json\").write_text(json.dumps([notice]))\n        self.write_batch(\"changes_1.jsonl\", [dict(upsert(1, \"T-001\", \"Hinge\", \"4.35\"),\n                                                   gate=notice[\"id\"])])\n        self.cli(\"sync\")\n        requests = self.requests()\n        self.assertEqual([r[\"status\"] for r in requests], [409, 200])\n        self.assertEqual(requests[0][\"cursor\"], requests[1][\"cursor\"])\n        self.assertEqual(requests[1][\"ack\"], notice[\"id\"])\n        self.assertEqual(self.catalog(), [(\"T-001\", 435)])\n\n    def test_unchanged_feed_polls_only_stored_cursor(self):\n        self.cli(\"sync\")\n        first = self.requests()\n   "]
[86.099172, "o", "python - <<'PY'"]
[86.100078, "i", "     self.cli(\"sync\")\n        second = self.requests()[len(first):]\n        self.assertEqual(len(second), 1)\n        self.assertEqual(second[0][\"cursor\"], first[-1][\"next_cursor\"])\n        self.assertEqual(self.catalog(), [(\"T-001\", 429), (\"T-004\", 29), (\"T-005\", 858)])\n\n''' + s[pos:]; p.write_text(s)\np=Path('README.md'); s=p.read_text(); s += '''\n### Delta sync recovery and merchandising data\n\nThe sync applies changes in sequence order and commits each page together with\nits cursor, including empty and tombstone-only pages. If a later page fails,\nrerun `sync` to resume after the last committed page. Existing catalogs are\nmigrated to one row per SKU (highest `feed_seq`, latest row on ties).\n\nSupplier notices are logged; notice-acknowledgement responses are retried once\nat the same cursor. Notices do not authorize changes to local merchandising\nrecords. Feed tombstones remove products, not `price_overrides`; an active\noverride continues to win if its SKU is later reissued. Review supplier notices\nabout SKU reu"]
[86.100105, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('tests/test_sync.py'); s=p.read_text(); pos=s.index('    def test_report_effective_prices(self):')\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:pos]+'''    def test_notice_ack_retries_the_same_page(self):\r\n\u001b[?2004l\r\u001b[?2004h>         notice = {\"id\": \"TEST-NOTICE\", \"severity\": \"action_required\",\r\n\u001b[?2004l\r\u001b[?2004h>                   \"title\": \"Test notice\", \"body\": \"Operational notice\"}\r\n\u001b[?2004l\r\u001b[?2004h>         (self.data / \"notices.json\").write_text(json.dumps([notice]))\r\n\u001b[?2004l\r\u001b[?2004h>         self.write_batch(\"changes_1.jsonl\", [dict(upsert(1, \"T-001\", \"Hinge\", \"4.35\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.100119, "i", "se with merchandising and use the existing admin commands if an\noverride should be ended. Sync never prunes or ends overrides automatically.\n'''; p.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
[86.100698, "o", "                                                   gate=notice[\"id\"])])\r\n\u001b[?2004l\r"]
[86.103071, "o", "\u001b[?2004h>         self.cli(\"sync\")\r\n\u001b[?2004l\r\u001b[?2004h>         requests = self.requests()\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual([r[\"status\"] for r in requests], [409, 200])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(requests[0][\"cursor\"], requests[1][\"cursor\"])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(requests[1][\"ack\"], notice[\"id\"])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.catalog(), [(\"T-001\", 435)])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_unchanged_feed_polls_only_stored_cursor(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.cli(\"sync\")\r\n\u001b[?2004l\r\u001b[?2004h>         first = self.requests()\r\n\u001b[?2004l\r\u001b[?2004h>         self.cli(\"sync\")\r\n\u001b[?2004l\r\u001b[?2004h>         second = self.requests()[len(first):]\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(len(second), 1)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(second[0][\"cursor\"], first[-1][\"next_cursor\"])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.catalog(), [(\"T-001\", 429), (\"T-004\", 29), (\"T-005\", 858)])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b"]
[86.103125, "o", "[?2004l\r\u001b[?2004h> ''' + s[pos:]; p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('README.md'); s=p.read_text(); s += '''\r\n\u001b[?2004l\r\u001b[?2004h> ### Delta sync recovery and merchandising data\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The sync applies changes in sequence order and commits each page together with\r\n\u001b[?2004l\r\u001b[?2004h> its cursor, including empty and tombstone-only pages. If a later page fails,\r\n\u001b[?2004l\r\u001b[?2004h> rerun `sync` to resume after the last committed page. Existing catalogs are\r\n\u001b[?2004l\r\u001b[?2004h> migrated to one row per SKU (highest `feed_seq`, latest row on ties).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Supplier notices are logged; notice-acknowledgement responses are retried once\r\n\u001b[?2004l\r\u001b[?2004h> at the same cursor. Notices do not authorize changes to local merchandising\r\n\u001b[?2004l\r\u001b[?2004h> records. Feed tombstones remove products, not `price_overrides`; an active\r\n\u001b[?2004l\r\u001b[?2004h> override continues to win if its SKU is later reissued. Review supplier notices\r\n\u001b[?2004l\r\u001b[?2004h> about S"]
[86.103196, "o", "KU reuse with merchandising and use the existing admin commands if an\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.103694, "o", "override should be ended. Sync never prunes or ends overrides automatically.\r\n"]
[86.103879, "o", "\u001b[?2004l\r\u001b[?2004h> "]
