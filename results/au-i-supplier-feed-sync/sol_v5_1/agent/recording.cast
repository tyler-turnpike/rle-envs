[85.991276, "i", "ge_resumes(self):\n        client = Pages([page(\"first\", [item(1)], more=True),\n                        page(\"bad\", [item(2, \"NEW\"), item(3, price=\"0.001\")])])\n        with self.assertRaises(ValueError):\n            run_sync(self.conn, client)\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"first\")\n        self.assertEqual([tuple(r) for r in self.conn.execute(\"SELECT sku, feed_seq FROM products\")],\n                         [(\"SKU\", 1)])\n        retry = Pages([page(\"fixed\", [item(2, \"NEW\"), item(3)])])\n        run_sync(self.conn, retry)\n        self.assertEqual(retry.cursor, \"first\")\n        self.assertEqual(store.product_count(self.conn), 2)\n\n    def test_empty_final_page_stores_cursor(self):\n        run_sync(self.conn, Pages([page(\"empty\")]))\n        self.assertEqual(store.get_state(self.conn, CURSOR_KEY), \"empty\")\n        self.assertIsNotNone(store.get_state(self.conn, \"last_sync_at\"))\n\n    def test_tombstones_and_notices_preserve_merchandising_records(self):\n        self.conn.execute(\"INSE"]
