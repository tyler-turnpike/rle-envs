[85.990911, "i", "cat > tests/test_store.py <<'PY'\n\"\"\"Storage invariants and page-level recovery, independent of the HTTP stub.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\nfrom feedsync.sync import CURSOR_KEY, run_sync\n\n\ndef item(seq, sku=\"SKU\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"price\": price, \"title\": f\"Product {seq}\"}\n\n\ndef page(cursor, items=(), tombstones=(), more=False):\n    return {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": more}\n\n\nclass Pages:\n    def __init__(self, pages):\n        self.pages = pages\n        self.cursor = None\n\n    def iter_pages(self, cursor):\n        self.cursor = cursor\n        yield from self.pages\n\n\nclass StoreTest(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addCleanup(self.conn.close)\n\n    def test_exact_cents(self):\n        for price, cents in [(\"4.35\", 435), (\"0.29\", 29), (\"8.58\", 858),\n                     "]
[85.991094, "i", "        (\"0.57\", 57), (\"19.99\", 1999), (\"0.00\", 0)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n        for price in (\"1.001\", \"NaN\", \"Infinity\"):\n            with self.subTest(price=price), self.assertRaises(ValueError):\n                store.price_to_cents(price)\n\n    def test_legacy_duplicates_migrate_by_sequence_then_id(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            db = Path(tmp) / \"legacy.db\"\n            with sqlite3.connect(db) as conn:\n                conn.executescript(store.SCHEMA)\n                conn.execute(\"CREATE INDEX products_sku ON products(sku)\")\n                for seq, price in [(9, 900), (3, 300), (9, 999), (None, 100)]:\n                    conn.execute(\"INSERT INTO products (sku, title, price_cents, feed_seq) \"\n                                 \"VALUES ('SKU', 'legacy', ?, ?)\", (price, seq))\n            conn = store.connect(db)\n            try:\n                self.assertEqual(store.product_count"]
