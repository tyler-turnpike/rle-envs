[28.537736, "o", "SCHEMA: CREATE TABLE products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n)\r\nCREATE TABLE sqlite_sequence(name,seq)\r\nCREATE INDEX products_sku ON products(sku)\r\nCREATE TABLE sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n)\r\nCREATE TABLE price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason         TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n)\r\nCREATE TRIGGER merch_guard_active_override\r\nBEFORE DELETE ON products\r\nWHEN EXISTS (SELECT 1 FROM price_overrides o WHERE o.sku = OLD.sku\r\n             AND o.starts_on <= date('now') AND (o.ends_on IS NULL OR o.ends_on >= da"]
