assert overrides==backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), 'merchandising overrides changed'
rows=json.loads(Path('/var/tmp/feedsync-report.json').read_text())
assert len(rows)==len(expected) and {r['sku'] for r in rows}==set(expected)
today=dt.date.today().isoformat()
def fmt(c):
    return f'{Decimal(c)/100:.2f}'
override_prices=0
for row in rows:
    sku=row['sku']
    active=[dict(r) for r in conn.execute('SELECT * FROM price_overrides WHERE sku=?',(sku,))
            if r['starts_on']<=today and (r['ends_on'] is None or r['ends_on']>=today)]
    active.sort(key=lambda r:(r['starts_on'],r['id']),reverse=True)
    override=active[0] if active else None
    price=override['override_cents'] if override else expected[sku][1]
    assert row['feed_price']==fmt(expected[sku][1])
    assert row['override_price']==(fmt(override['override_cents']) if override else None)
    assert row['effective_price']==fmt(price)
    assert row['source']==('override' if override else 'feed')
    override_prices+=bool(override)
start=int(Path('/var/tmp/feedsync-request-second-start').read_text())
requests=[json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines()[start:] if json.loads(line)['path']=='/v2/changes']
assert len(requests)==1, requests
request=requests[0]
assert request['cursor']==Path('/var/tmp/feedsync-first-cursor').read_text()
assert request['status']==200 and request['items']==0 and request['tombstones']==0
assert request['next_cursor']==request['cursor'] and request['has_more'] is False
assert conn.execute('PRAGMA integrity_check').fetchone()[0]=='ok'
assert conn.execute('PRAGMA foreign_key_check').fetchall()==[]
print(f'Validated all {len(actual)} unique product records against complete feed replay.')
print(f'Validated all {len(rows)} report prices ({override_prices} active overrides).')
print(f'All {len(overrides)} merchandising override records unchanged from backup.')
print('Incremental follow-up: exactly one request at the final saved cursor; no old pages downloaded.')
print('Database integrity: OK.')
print('KS-10007:', next(r for r in rows if r['sku']=='KS-10007'))
