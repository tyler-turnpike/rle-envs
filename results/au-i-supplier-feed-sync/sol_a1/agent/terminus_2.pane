    def test_combines_and_sorts_changes_before_applying(self):
        conn = self.connect()
        client = Pages(page("end", [item(5, price="0.57"), item(1), item(3, "B"), item(2)],
                            [{"seq": 4, "sku": "A"}, {"seq": 6, "sku": "B"}]))
        stats = run_sync(conn, client)
        self.assertEqual(stats, {"pages": 1, "upserts": 4, "deletes": 2})
        self.assertEqual([tuple(r) for r in conn.execute("SELECT sku, price_cents, feed_seq FROM products")],
                         [("A", 57, 5)])
        self.assertEqual(store.get_state(conn, CURSOR_KEY), "end")

