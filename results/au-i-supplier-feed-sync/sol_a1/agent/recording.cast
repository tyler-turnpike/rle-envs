[99.392721, "i", "cd /app && python - <<'PY'\nimport datetime\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nfrom decimal import Decimal\nfrom pathlib import Path\n\nchanges = []\nfor path in sorted(Path('dev/feed_data').glob('changes*.jsonl')):\n    changes.extend(json.loads(line) for line in path.read_text().splitlines() if line.strip())\nexpected = {}\nfor event in sorted(changes, key=lambda e: e['seq']):\n    if event['op'] == 'delete':\n        expected.pop(event['sku'], None)\n    else:\n        expected[event['sku']] = (event['title'], int(Decimal(event['price']) * 100),\n                                  event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nconn = sqlite3.connect('data/catalog.db')\nconn.row_factory = sqlite3.Row\nactual = {r['sku']: tuple(r)[1:] for r in conn.execute(\n    'SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\nassert actual == expected, 'Catalog differs from replayed feed'\nassert conn.execute('SELECT COUNT(*) FROM products').fetchone()[0] == len(expec"]
[99.393422, "i", "ted)\nassert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\nwith sqlite3.connect('/var/tmp/feedsync-before-v2-fix.db') as backup:\n    before = backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\nassert [tuple(r) for r in conn.execute('SELECT * FROM price_overrides ORDER BY id')] == before\nreport = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\nassert len(report) == len(expected)\nassert len({r['sku'] for r in report}) == len(expected)\ntoday = datetime.date.today().isoformat()\nactive_count = 0\nfor row in report:\n    candidates = [o for o in before if o[1] == row['sku'] and o[3] <= today and (o[4] is None or o[4] >= today)]\n    override = max(candidates, key=lambda o: (o[3], o[0])) if candidates else None\n    feed = expected[row['sku']][1]\n    cents = override[2] if override else feed\n    assert row['feed_price'] == f'{Decimal(feed) / 100:.2f}'\n    assert row['effective_price'] == f'{Decimal(cents) / 100:.2f}'\n    assert row["]
[99.393656, "i", "'source'] == ('override' if override else 'feed')\n    assert row['override_price'] == (f'{Decimal(override[2]) / 100:.2f}' if override else None)\n    active_count += override is not None\nrequests = [json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines()]\nrequests = [r for r in requests if r['path'] == '/v2/changes']\nassert requests[-1]['cursor'] == requests[-2]['next_cursor']\nassert requests[-1]['items'] == requests[-1]['tombstones'] == 0\nassert requests[-1]['has_more'] is False\nprint(f'Verified all {len(expected)} catalog rows and report prices; {active_count} current products use overrides.')\nprint(f'All {len(before)} merchandising override records unchanged; SQLite integrity check passed.')\nprint('Incremental request:', json.dumps(requests[-1]))\nPY\npython -m feedsync report | head -n 9\npython -m feedsync price KS-10007\n"]
