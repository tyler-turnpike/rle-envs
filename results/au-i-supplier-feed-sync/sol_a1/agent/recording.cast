[99.399135, "o", "\u001b[?2004h> "]
[99.399153, "o", "active_count = 0\r\n"]
[99.399212, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[99.399238, "o", "for row in report:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.39927, "o", "> "]
[99.399397, "o", "    candidates = [o for o in before if o[1] == row['sku'] and o[3] <= today and (o[4] is None or o[4] >= today)]\r\n\u001b[?2004l\r"]
[99.399571, "o", "\u001b[?2004h"]
[99.399646, "o", ">     override = max(candidates, key=lambda o: (o[3], o[0])) if candidates else None"]
[99.399723, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.399794, "o", ">     feed = expected[row['sku']][1]"]
[99.399845, "o", "\r\n\u001b[?2004l\r"]
[99.399921, "o", "\u001b[?2004h"]
[99.399963, "o", ">     cents = override[2] if override else feed"]
[99.400014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.400099, "o", ">     assert row['feed_price'] == f'{Decimal(feed) / 100:.2f}'"]
[99.400143, "o", "\r\n"]
[99.400186, "o", "\u001b[?2004l\r\u001b[?2004h"]
[99.40028, "o", ">     assert row['effective_price'] == f'{Decimal(cents) / 100:.2f}'"]
[99.400324, "o", "\r\n"]
[99.400443, "o", "\u001b[?2004l\r\u001b[?2004h>     assert row['source'] == ('override' if override else 'feed')"]
[99.40049, "o", "\r\n"]
[99.400562, "o", "\u001b[?2004l\r\u001b[?2004h"]
[99.400682, "o", "> "]
[99.40074, "o", "    assert row['override_price'] == (f'{Decimal(override[2]) / 100:.2f}' if override else None)"]
[99.400863, "o", "\r\n\u001b[?2004l\r"]
[99.400978, "o", "\u001b[?2004h>     active_count += override is not None"]
[99.401117, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> requests = [json.loads(line) for line in Path('/var/tmp/feedstub/requests.log').read_text().splitlines()]"]
[99.401178, "o", "\r\n"]
[99.401244, "o", "\u001b[?2004l\r"]
[99.401372, "o", "\u001b[?2004h> "]
[99.401458, "o", "requests = [r for r in requests if r['path'] == '/v2/changes']\r\n"]
[99.401542, "o", "\u001b[?2004l\r\u001b[?2004h"]
[99.401589, "o", "> "]
[99.40172, "o", "assert requests[-1]['cursor'] == requests[-2]['next_cursor']"]
[99.401815, "o", "\r\n"]
[99.401903, "o", "\u001b[?2004l\r\u001b[?2004h> assert requests[-1]['items'] == requests[-1]['tombstones'] == 0"]
[99.401986, "o", "\r\n\u001b[?2004l\r"]
[99.40206, "o", "\u001b[?2004h> assert requests[-1]['has_more'] is False"]
[99.402137, "o", "\r\n\u001b[?2004l\r"]
[99.402291, "o", "\u001b[?2004h> print(f'Verified all {len(expected)} catalog rows and report prices; {active_count} current products use overrides.')"]
[99.402365, "o", "\r\n"]
[99.402445, "o", "\u001b[?2004l\r"]
[99.402587, "o", "\u001b[?2004h> print(f'All {len(before)} merchandising override records unchanged; SQLite integrity check passed.')"]
[99.402639, "o", "\r\n"]
[99.402712, "o", "\u001b[?2004l\r"]
[99.402804, "o", "\u001b[?2004h> "]
[99.402867, "o", "print('Incremental request:', json.dumps(requests[-1]))"]
[99.402949, "o", "\r\n\u001b[?2004l\r"]
[99.403196, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[99.507737, "o", "Verified all 47 catalog rows and report prices; 24 current products use overrides.\r\n"]
[99.50781, "o", "All 31 merchandising override records unchanged; SQLite integrity check passed.\r\n"]
