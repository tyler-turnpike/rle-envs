[72.565733, "i", "cd /app && cat > tests/test_store_and_pages.py <<'PY'\n\"\"\"Regression coverage for catalog upgrades and page-level checkpoints.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\nfrom feedsync.client import FeedError\nfrom feedsync.sync import CURSOR_KEY, run_sync\n\n\ndef item(seq, sku=\"A\", price=\"4.35\"):\n    return {\"seq\": seq, \"sku\": sku, \"title\": f\"Version {seq}\", \"price\": price}\n\n\ndef page(cursor, items=(), tombstones=(), more=False):\n    return {\"items\": list(items), \"tombstones\": list(tombstones),\n            \"next_cursor\": cursor, \"has_more\": more}\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.cursor = None\n\n    def iter_pages(self, cursor):\n        self.cursor = cursor\n        for value in self.pages:\n            if isinstance(value, Exception):\n                raise value\n            yield value\n\n\nclass StoreAndPagesTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n    "]
[72.565792, "i", "    self.addCleanup(self.tmp.cleanup)\n        self.db = Path(self.tmp.name) / \"catalog.db\"\n\n    def connect(self):\n        conn = store.connect(self.db)\n        self.addCleanup(conn.close)\n        return conn\n\n    def test_decimal_prices(self):\n        for price, cents in [(\"4.35\", 435), (\"0.29\", 29), (\"0.57\", 57),\n                             (\"8.58\", 858), (\"19.99\", 1999), (\"0.00\", 0)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n                self.assertEqual(store.format_cents(cents), price)\n        with self.assertRaises(ValueError):\n            store.price_to_cents(\"1.001\")\n\n    def test_migrates_duplicate_skus_without_touching_overrides_or_state(self):\n        with sqlite3.connect(self.db) as old:\n            old.executescript(store.SCHEMA)\n            old.execute(\"CREATE INDEX products_sku ON products(sku)\")\n            # Sequence wins over insertion order, with insertion order as tie-break.\n            for seq, price in [(9, 100),"]
[72.565813, "i", " (3, 200), (9, 300), (None, 400)]:\n                old.execute(\"INSERT INTO products (sku, title, price_cents, feed_seq) \"\n                            \"VALUES ('A', 'Legacy', ?, ?)\", (price, seq))\n            old.execute(\"INSERT INTO sync_state (key, value) VALUES ('feed_cursor', 'opaque')\")\n            old.execute(\"INSERT INTO price_overrides \"\n                        \"(sku, override_cents, starts_on, author, reason, created_at) \"\n                        \"VALUES ('A', 77, '2024-01-01', 'merch', 'promo', '2024-01-01')\")\n            overrides = old.execute(\"SELECT * FROM price_overrides\").fetchall()\n        conn = self.connect()\n        self.assertEqual(store.product_count(conn), 1)\n        self.assertEqual(conn.execute(\"SELECT price_cents FROM products\").fetchone()[0], 300)\n        self.assertEqual(store.get_state(conn, CURSOR_KEY), \"opaque\")\n        self.assertEqual([tuple(r) for r in conn.execute(\"SELECT * FROM price_overrides\")], overrides)\n        with self.assertRaises(sqlite3.IntegrityError):\n          "]
[72.56582, "i", "  conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A', 'Duplicate', 1)\")\n        conn.rollback()\n        self.assertEqual(store.product_count(self.connect()), 1)\n\n    def test_combines_and_sorts_changes_before_applying(self):\n        conn = self.connect()\n        client = Pages(page(\"end\", [item(5, price=\"0.57\"), item(1), item(3, \"B\"), item(2)],\n                            [{\"seq\": 4, \"sku\": \"A\"}, {\"seq\": 6, \"sku\": \"B\"}]))\n        stats = run_sync(conn, client)\n        self.assertEqual(stats, {\"pages\": 1, \"upserts\": 4, \"deletes\": 2})\n        self.assertEqual([tuple(r) for r in conn.execute(\"SELECT sku, price_cents, feed_seq FROM products\")],\n                         [(\"A\", 57, 5)])\n        self.assertEqual(store.get_state(conn, CURSOR_KEY), \"end\")\n\n    def test_failed_page_rolls_back_and_resumes_after_last_committed_page(self):\n        conn = self.connect()\n        client = Pages(page(\"first\", [item(1)], more=True),\n                       page(\"bad\", [item(2), item(3, \"B\", \"invalid\")]))\n "]
[72.565831, "i", "       with self.assertRaises(ArithmeticError):\n            run_sync(conn, client)\n        # Check durability on a separate connection, not just this transaction.\n        check = self.connect()\n        self.assertEqual(store.get_state(check, CURSOR_KEY), \"first\")\n        self.assertEqual(check.execute(\"SELECT feed_seq FROM products\").fetchone()[0], 1)\n        self.assertIsNone(store.get_state(check, \"last_sync_at\"))\n        retry = Pages(page(\"last\", [item(2), item(3, \"B\")]))\n        run_sync(conn, retry)\n        self.assertEqual(retry.cursor, \"first\")\n        self.assertEqual(store.product_count(conn), 2)\n\n    def test_network_failure_keeps_checkpoint_and_empty_final_page_advances_it(self):\n        conn = self.connect()\n        with self.assertRaises(FeedError):\n            run_sync(conn, Pages(page(\"first\", [item(1)], more=True), FeedError(\"offline\")))\n        self.assertEqual(store.get_state(self.connect(), CURSOR_KEY), \"first\")\n        run_sync(conn, Pages(page(\"empty-final\")))\n        self.assertEqual(st"]
