[154.696896, "i", "cd /app && python - <<'PY'\nimport datetime as dt\nimport json\nimport sqlite3\nimport subprocess\nimport sys\nimport time\nfrom decimal import Decimal\nfrom pathlib import Path\n\nexpected = {}\nfor event in sorted((json.loads(line) for path in Path('dev/feed_data').glob('changes*.jsonl')\n                     for line in path.read_text().splitlines() if line.strip()), key=lambda e: e['seq']):\n    if event['op'] == 'delete':\n        expected.pop(event['sku'], None)\n    else:\n        expected[event['sku']] = (event['title'], int(Decimal(event['price']) * 100),\n                                  event.get('currency', 'EUR'), event.get('updated_at'), event['seq'])\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect('/var/tmp/feedsync-catalog-before-fix.db') as backup:\n    actual = {r[0]: r[1:] for r in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')}\n    assert actual == expected, 'Catalog differs from independently reconstructed feed state'\n    assert conn.execute('"]
[154.696948, "i", "SELECT COUNT(*) = COUNT(DISTINCT sku) FROM products').fetchone()[0]\n    overrides = conn.execute('SELECT * FROM price_overrides ORDER BY id').fetchall()\n    assert overrides == backup.execute('SELECT * FROM price_overrides ORDER BY id').fetchall(), 'Override history changed'\n    assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\n    cursor = conn.execute(\"SELECT value FROM sync_state WHERE key='feed_cursor'\").fetchone()[0]\n    print(f'Catalog verified: {len(actual)} unique SKUs, all feed fields exact; SQLite integrity OK')\n    print(f'Merchandising overrides unchanged: {len(overrides)} rows')\n    conn.row_factory = sqlite3.Row\n    today = dt.date.today().isoformat()\n    report = json.loads(subprocess.check_output([sys.executable, '-m', 'feedsync', 'report', '--json'], text=True))\n    assert len(report) == len(expected)\n    def money(cents):\n        return f'{Decimal(cents) / 100:.2f}'\n    for row in report:\n        sku = row['sku']\n        active = [dict(o) for o in conn.execute('SELECT * FRO"]
[154.697078, "i", "M price_overrides WHERE sku=?', (sku,))\n                  if o['starts_on'] <= today and (o['ends_on'] is None or o['ends_on'] >= today)]\n        override = max(active, key=lambda o: (o['starts_on'], o['id'])) if active else None\n        cents = override['override_cents'] if override else expected[sku][1]\n        assert row['feed_price'] == money(expected[sku][1])\n        assert row['effective_price'] == money(cents)\n        assert row['override_price'] == (money(override['override_cents']) if override else None)\n        assert row['source'] == ('override' if override else 'feed')\n    print(f'JSON report verified: all {len(report)} effective prices match active-override/feed rules')\n\nlog = Path('/var/tmp/feedstub/requests.log')\nbefore = log.read_text().splitlines()\nfirst_requests = [json.loads(line) for line in before if json.loads(line)['path'] == '/v2/changes']\nprint('First-run HTTP statuses:', [r['status'] for r in first_requests])\nresult = subprocess.run([sys.executable, '-m', 'feedsync', 'sync'], capture"]
[154.697089, "o", "cd /app && python - <<'PY'\r\n\u001b[?2004l\r"]
[154.697095, "i", "_output=True, text=True, check=True)\nstats = json.loads(result.stdout)\nassert stats == dict(pages=1, upserts=0, deletes=0), stats\ntime.sleep(0.1)\nrequests = [json.loads(line) for line in log.read_text().splitlines()[len(before):]\n            if json.loads(line)['path'] == '/v2/changes']\nassert len(requests) == 1, requests\nassert requests[0]['cursor'] == cursor and requests[0]['status'] == 200\nassert requests[0]['items'] == 0 and requests[0]['tombstones'] == 0\nwith sqlite3.connect('data/catalog.db') as conn:\n    assert {r[0]: r[1:] for r in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')} == expected\nprint('Second sync verified:', stats, '; exactly one request at the saved cursor, no replayed pages')\nPY\npython -m feedsync report > /var/tmp/feedsync-current-report.txt && head -n 7 /var/tmp/feedsync-current-report.txt && tail -n 1 /var/tmp/feedsync-current-report.txt\n"]
