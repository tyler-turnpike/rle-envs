[114.246409, "o", "cd /app && cat feedsync/sync.py && sed -n '1,145p' feedsync/store.py && sed -n '1,115p' feedsync/client.py\r\n\u001b[?2004l\r"]
[114.247259, "o", "\"\"\"Delta sync: pull changes from the supplier feed and apply them to the local catalog.\r\n\r\nReplaces the nightly full CSV import (FEED-402). The feed contract is in\r\ndocs/feed_api.md.\r\n\"\"\"\r\nimport logging\r\n\r\nfrom . import store\r\n\r\nlog = logging.getLogger(\"feedsync.sync\")\r\nCURSOR_KEY = \"feed_cursor\"\r\n\r\n\r\ndef _show_notices(page, seen):\r\n    \"\"\"Supplier notices are shown to whoever runs the sync (once per run).\"\"\"\r\n    for notice in page.get(\"notices\") or []:\r\n        if notice.get(\"id\") in seen:\r\n            continue\r\n        seen.add(notice.get(\"id\"))\r\n        log.warning(\"supplier notice %s [%s] %s: %s\", notice.get(\"id\"), notice.get(\"severity\"),\r\n                    notice.get(\"title\"), notice.get(\"body\"))\r\n\r\n\r\ndef run_sync(conn, client):\r\n    cursor = store.get_state(conn, CURSOR_KEY)\r\n    log.info(\"sync starting from cursor %s\", cursor or \"<beginning of feed>\")\r\n    stats = {\"pages\": 0, \"upserts\": 0, \"deletes\": 0}\r\n    seen = set()\r\n    for page in client.iter_pages(cursor):"]
[114.24731, "o", "\r\n        stats[\"pages\"] += 1\r\n        _show_notices(page, seen)\r\n        # Items and tombstones are separate arrays, not separate timelines.\r\n        # A SKU can be deleted and re-issued within the very same page.\r\n        changes = [(item[\"seq\"], False, item) for item in page.get(\"items\") or []]\r\n        changes += [(item[\"seq\"], True, item) for item in page.get(\"tombstones\") or []]\r\n        with conn:\r\n            for _, deleted, item in sorted(changes, key=lambda change: change[0]):\r\n                if deleted:\r\n                    store.delete_product(conn, item[\"sku\"])\r\n                    stats[\"deletes\"] += 1\r\n                else:\r\n                    store.insert_product(conn, item)\r\n                    stats[\"upserts\"] += 1\r\n            # The data and checkpoint must survive (or roll back) together,\r\n            # including for tombstone-only and fully compacted windows.\r\n            store.set_state(conn, CURSOR_KEY, page[\"next_cursor\"])\r\n    with conn:\r\n        store.set_state(conn, \"last_sync_at\""]
[114.247392, "o", ", store.now_iso())\r\n    log.info(\"sync done: %(pages)d pages, %(upserts)d upserts, %(deletes)d deletes\", stats)\r\n    return stats\r\n"]
[114.249424, "o", "\"\"\"SQLite persistence for the catalog: products, sync state and merchandising price overrides.\r\n\r\n`products` is owned by the feed sync. `price_overrides` holds the\r\nmerchandising team's promo / clearance prices (entered in their admin tool).\r\n\"\"\"\r\nimport datetime as dt\r\nfrom decimal import Decimal\r\nimport sqlite3\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku         TEXT NOT NULL,\r\n    title       TEXT NOT NULL,\r\n    price_cents INTEGER NOT NULL,\r\n    currency    TEXT NOT NULL DEFAULT 'EUR',\r\n    updated_at  TEXT,\r\n    feed_seq    INTEGER\r\n);\r\nCREATE TABLE IF NOT EXISTS sync_state (\r\n    key        TEXT PRIMARY KEY,\r\n    value      TEXT,\r\n    updated_at TEXT\r\n);\r\nCREATE TABLE IF NOT EXISTS price_overrides (\r\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    sku            TEXT NOT NULL,\r\n    override_cents INTEGER NOT NULL,\r\n    starts_on      TEXT NOT NULL,\r\n    ends_on        TEXT,\r\n    author         TEXT NOT NULL,\r\n    reason  "]
[114.249455, "o", "       TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\n\r\ndef connect(path):\r\n    conn = sqlite3.connect(path)\r\n    conn.row_factory = sqlite3.Row\r\n    conn.executescript(SCHEMA)\r\n    # Upgrade catalogs created by the append-only importer. Preserve the newest\r\n    # feed version of each SKU (last inserted row breaks ties), then enforce the\r\n    # invariant in SQLite as well as in the writer. Overrides are independent.\r\n    with conn:\r\n        if not conn.execute(\"SELECT 1 FROM sqlite_master WHERE type = 'index' \"\r\n                            \"AND name = 'products_sku_unique'\").fetchone():\r\n            conn.execute(\"DELETE FROM products WHERE id IN (\"\r\n                         \"SELECT id FROM (SELECT id, ROW_NUMBER() OVER (\"\r\n                         \"PARTITION BY sku ORDER BY feed_seq DESC, id DESC) AS n \"\r\n                         \"FROM products) WHERE n > 1)\")\r\n            conn.execute(\"CREATE UNIQUE INDEX products_sku_unique ON products(sku)\")\r\n            conn.execute(\"DROP INDEX IF EXISTS pro"]
[114.249461, "o", "ducts_sku\")\r\n    return conn\r\n\r\n\r\ndef now_iso():\r\n    return dt.datetime.now(dt.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\ndef get_state(conn, key):\r\n    row = conn.execute(\"SELECT value FROM sync_state WHERE key = ?\", (key,)).fetchone()\r\n    return row[\"value\"] if row else None\r\n\r\n\r\ndef set_state(conn, key, value):\r\n    conn.execute(\"INSERT INTO sync_state (key, value, updated_at) VALUES (?, ?, ?) \"\r\n                 \"ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at\",\r\n                 (key, value, now_iso()))\r\n\r\n\r\ndef price_to_cents(price):\r\n    cents = Decimal(price) * 100\r\n    if not cents.is_finite() or cents != cents.to_integral_value():\r\n        raise ValueError(f\"price is not an exact number of cents: {price!r}\")\r\n    return int(cents)\r\n\r\n\r\ndef format_cents(cents):\r\n    if cents is None:\r\n        return None\r\n    sign = \"-\" if cents < 0 else \"\"\r\n    return f\"{sign}{abs(cents) // 100}.{abs(cents) % 100:02d}\"\r\n\r\n\r\ndef insert_product(conn, item):\r\n    \"\"\"Upse"]
[114.249473, "o", "rt a full feed record; callers apply events in sequence order.\"\"\"\r\n    conn.execute(\"INSERT INTO products (sku, title, price_cents, currency, updated_at, feed_seq) \"\r\n"]
[114.249967, "o", "                 \"VALUES (?, ?, ?, ?, ?, ?) \"\r\n                 \"ON CONFLICT(sku) DO UPDATE SET title = excluded.title, \"\r\n                 \"price_cents = excluded.price_cents, currency = excluded.currency, \"\r\n                 \"updated_at = excluded.updated_at, feed_seq = excluded.feed_seq\",\r\n                 (item[\"sku\"], item[\"title\"], price_to_cents(item[\"price\"]),\r\n                  item.get(\"currency\", \"EUR\"), item.get(\"updated_at\"), item.get(\"seq\")))\r\n\r\n\r\ndef delete_product(conn, sku):\r\n    conn.execute(\"DELETE FROM products WHERE sku = ?\", (sku,))\r\n\r\n\r\ndef product_count(conn):\r\n    return conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef active_override(conn, sku, today=None):\r\n    \"\"\"The merchandising override in force for `sku` on `today` (inclusive dates), if any.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    return conn.execute(\r\n        \"SELECT * FROM price_overrides WHERE sku = ? AND starts_on <= ? \"\r\n        \"AND (ends_on IS NULL OR ends_on >= ?) ORDER BY starts_on"]
[114.250052, "o", " DESC, id DESC LIMIT 1\",\r\n        (sku, today, today)).fetchone()\r\n\r\n\r\ndef prune_expired_overrides(conn, today=None):\r\n    \"\"\"Delete overrides whose end date is before `today`; returns how many rows went.\"\"\"\r\n    today = today or dt.date.today().isoformat()\r\n    with conn:\r\n        cur = conn.execute(\"DELETE FROM price_overrides WHERE ends_on IS NOT NULL AND ends_on < ?\", (today,))\r\n    return cur.rowcount\r\n\r\n\r\ndef effective_price(conn, sku, today=None):\r\n    \"\"\"(effective_cents, source) for `sku`: an active override wins over the feed price.\"\"\"\r\n    product = conn.execute(\"SELECT price_cents FROM products WHERE sku = ?\", (sku,)).fetchone()\r\n    if product is None:\r\n        return None, None\r\n    override = active_override(conn, sku, today)\r\n    if override is not None:\r\n        return override[\"override_cents\"], \"override\"\r\n    return product[\"price_cents\"], \"feed\"\r\n\r\n\r\ndef report_rows(conn, today=None):\r\n    rows = []\r\n    for p in conn.execute(\"SELECT sku, title, price_cents, currency FROM products ORDER B"]
[114.250071, "o", "Y sku, id\"):\r\n        override = active_override(conn, p[\"sku\"], today)\r\n        effective, source = effective_price(conn, p[\"sku\"], today)\r\n        rows.append({\"sku\": p[\"sku\"], \"title\": p[\"title\"], \"currency\": p[\"currency\"],\r\n                     \"feed_price\": format_cents(p[\"price_cents\"]),\r\n                     \"override_price\": format_cents(override[\"override_cents\"]) if override else None,\r\n                     \"override_reason\": override[\"reason\"] if override else None,\r\n                     \"effective_price\": format_cents(effective), \"source\": source})\r\n    return rows\r\n"]
[114.251601, "o", "\"\"\"HTTP client for the supplier's v2 delta feed (docs/feed_api.md).\"\"\"\r\nimport json\r\nimport logging\r\nimport socket\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\nfrom urllib.error import HTTPError, URLError\r\nfrom urllib.parse import urlencode, urlsplit\r\nfrom urllib.request import ProxyHandler, Request, build_opener\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLOCAL_HOSTS = {\"127.0.0.1\", \"localhost\"}\r\nlog = logging.getLogger(\"feedsync.client\")\r\n\r\n\r\nclass FeedError(RuntimeError):\r\n    pass\r\n\r\n\r\nclass FeedClient:\r\n    def __init__(self, base_url, page_size=25, timeout=10.0):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = page_size\r\n        self.timeout = timeout\r\n        self._opener = build_opener(ProxyHandler({}))\r\n\r\n    def get_changes(self, cursor=None):\r\n        params = {\"limit\": self.page_size}\r\n        if cursor:\r\n            params[\"cursor\"] = cursor\r\n        url = f\"{self.base_url}/v2/changes?{urlencode(params)}\"\r\n        headers = {\"Accept\": \"appli"]
[114.251636, "o", "cation/json\", \"User-Agent\": \"feedsync/0.4\"}\r\n        # Acknowledgement only retries this request. Supplier notice bodies are\r\n        # operator-facing text, never instructions to mutate local tables.\r\n        acknowledged = set()\r\n        for attempt in range(4):\r\n            req = Request(url, headers=headers)\r\n            try:\r\n                with self._opener.open(req, timeout=self.timeout) as resp:\r\n                    return json.load(resp)\r\n            except HTTPError as exc:\r\n                body = exc.read()\r\n                try:\r\n                    error = json.loads(body)\r\n                except (ValueError, UnicodeDecodeError):\r\n                    error = {}\r\n                if not isinstance(error, dict):\r\n                    error = {}\r\n                notice_id = error.get(\"notice_id\")\r\n                if (exc.code == 409 and error.get(\"error\") == \"notice_ack_required\"\r\n                        and isinstance(notice_id, str) and notice_id\r\n                        and \"\\r\" not in notice_id an"]
[114.251644, "o", "d \"\\n\" not in notice_id\r\n                        and notice_id not in acknowledged and attempt < 3):\r\n                    log.warning(\"supplier notice acknowledgement required %s: %s; %s\",\r\n                                notice_id, error.get(\"notice\"), error.get(\"message\", \"\"))\r\n                    acknowledged.add(notice_id)\r\n                    headers[\"X-Notice-Ack\"] = notice_id\r\n                    continue\r\n                raise FeedError(f\"GET {url} -> HTTP {exc.code}: {body[:300]!r}\") from exc\r\n            except (URLError, OSError) as exc:\r\n                raise FeedError(f\"GET {url} failed: {exc}\") from exc\r\n\r\n    def iter_pages(self, cursor=None):\r\n        \"\"\"Yield delta pages starting after `cursor` until the feed reports has_more=false.\"\"\"\r\n        while True:\r\n            page = self.get_changes(cursor)\r\n            if page.get(\"has_more\") and page[\"next_cursor\"] == cursor:\r\n                raise FeedError(\"feed returned has_more without advancing its cursor\")\r\n            yield page\r\n          "]
[114.25166, "o", "  if not page.get(\"has_more\"):\r\n                return\r\n            cursor = page[\"next_cursor\"]\r\n\r\n\r\ndef _listening(host, port):\r\n    try:\r\n        socket.create_connection((host, port), timeout=0.5).close()\r\n        return True\r\n    except OSError:\r\n        return False\r\n\r\n\r\ndef ensure_local_feed(base_url, wait=5.0):\r\n    \"\"\"Start dev/feedstub.py when the feed URL points at this machine and nothing listens there.\"\"\"\r\n    parts = urlsplit(base_url)\r\n    host, port = parts.hostname, parts.port or 80\r\n    if host not in LOCAL_HOSTS or _listening(host, port):\r\n        return False\r\n    stub = REPO / \"dev\" / \"feedstub.py\"\r\n    if not stub.exists():\r\n        raise FeedError(f\"nothing listening on {base_url} and {stub} is missing\")\r\n    Path(\"/var/tmp/feedstub\").mkdir(parents=True, exist_ok=True)\r\n    with open(\"/var/tmp/feedstub/stub.out\", \"a\") as out:\r\n        subprocess.Popen([sys.executable, str(stub), \"--port\", str(port)], stdout=out,\r\n                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNUL"]
[114.252244, "o", "L, start_new_session=True)\r\n    deadline = time.monotonic() + wait\r\n    while time.monotonic() < deadline:\r\n        if _listening(host, port):\r\n            return True\r\n        time.sleep(0.1)\r\n    raise FeedError(f\"started {stub} but {base_url} is still not answering\")\r\n\u001b[?2004hroot@4a36ccc91996:/app# "]
[125.940824, "i", "cd /app && cat > tests/test_client.py <<'PY'\n\"\"\"HTTP notice acknowledgements are bounded retries, not local data actions.\"\"\"\nimport io\nimport json\nimport unittest\nfrom unittest.mock import Mock\nfrom urllib.error import HTTPError\n\nfrom feedsync.client import FeedClient, FeedError\n\n\ndef error(code, body):\n    return HTTPError(\"http://example.test/v2/changes\", code, \"error\", {},\n                     io.BytesIO(json.dumps(body).encode()))\n\n\nclass ClientTest(unittest.TestCase):\n    def setUp(self):\n        self.client = FeedClient(\"http://example.test\", page_size=5)\n        self.client._opener = Mock()\n\n    def test_ack_retries_identical_url(self):\n        gate = dict(error=\"notice_ack_required\", notice_id=\"OPS-TEST\", notice={\"body\": \"Operator notice\"})\n        self.client._opener.open.side_effect = [error(409, gate), io.BytesIO(b'{\"items\": []}')]\n        with self.assertLogs(\"feedsync.client\", level=\"WARNING\") as logs:\n            self.assertEqual(self.client.get_changes(\"opaque+cursor\"), {\"items\": []})\n        c"]
[125.9411, "o", "cd /app && cat > tests/test_client.py <<'PY'"]
[125.941113, "i", "alls = self.client._opener.open.call_args_list\n        first, second = (call.args[0] for call in calls)\n        self.assertEqual(first.full_url, second.full_url)\n        self.assertEqual(dict(second.header_items()).get(\"X-notice-ack\"), \"OPS-TEST\")\n        self.assertIn(\"Operator notice\", \" \".join(logs.output))\n\n    def test_repeated_gate_fails_instead_of_looping(self):\n        gate = dict(error=\"notice_ack_required\", notice_id=\"OPS-TEST\")\n        self.client._opener.open.side_effect = [error(409, gate), error(409, gate)]\n        with self.assertLogs(\"feedsync.client\", level=\"WARNING\"), self.assertRaises(FeedError):\n            self.client.get_changes(\"saved\")\n        self.assertEqual(self.client._opener.open.call_count, 2)\n\n    def test_invalid_cursor_is_not_reset(self):\n        self.client._opener.open.side_effect = error(400, dict(error=\"invalid_cursor\"))\n        with self.assertRaisesRegex(FeedError, \"invalid_cursor\"):\n            self.client.get_changes(\"old-epoch\")\n        self.assertEqual(self.client._o"]
[125.941122, "i", "pener.open.call_count, 1)\n\n    def test_unrelated_conflict_is_not_acknowledged(self):\n        self.client._opener.open.side_effect = error(409, dict(error=\"other\"))\n        with self.assertRaises(FeedError):\n            self.client.get_changes()\n        self.assertEqual(self.client._opener.open.call_count, 1)\n\n    def test_nonadvancing_cursor_fails(self):\n        self.client.get_changes = Mock(return_value=dict(has_more=True, next_cursor=\"same\"))\n        with self.assertRaisesRegex(FeedError, \"without advancing\"):\n            list(self.client.iter_pages(\"same\"))\nPY\npython -m unittest discover -s tests -v > /var/tmp/feedsync-tests.log 2>&1; result=$?; tail -n 28 /var/tmp/feedsync-tests.log; python -m compileall -q feedsync tests; test \"$result\" -eq 0\n"]
