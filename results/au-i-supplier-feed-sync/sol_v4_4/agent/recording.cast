[39.386115, "i", "cd /app && python - <<'PY'\nimport sqlite3\nc=sqlite3.connect('data/catalog.db')\nfor t in ('products','sync_state','price_overrides'):\n print(t, c.execute('SELECT COUNT(*) FROM '+t).fetchone()[0])\nprint('state', c.execute('SELECT * FROM sync_state').fetchall())\nprint('duplicates', c.execute('SELECT sku, COUNT(*) FROM products GROUP BY sku HAVING COUNT(*) > 1').fetchall())\nprint('product sample', c.execute('SELECT * FROM products LIMIT 3').fetchall())\nprint('override dates/counts', c.execute('SELECT starts_on, ends_on, COUNT(*) FROM price_overrides GROUP BY starts_on, ends_on').fetchall())\nPY\nsed -n '1,100p' dev/feedstub.py\npython -m unittest discover -s tests -v\n"]
