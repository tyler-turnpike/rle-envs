[104.2805, "i", "t import FeedError\nfrom feedsync.sync import run_sync\n\n\ndef item(seq, sku, price=\"4.35\"):\n    return dict(seq=seq, sku=sku, title=sku, price=price)\n\n\ndef page(cursor, items=(), tombstones=()):\n    return dict(items=list(items), tombstones=list(tombstones), next_cursor=cursor)\n\n\nclass Pages:\n    def __init__(self, *pages):\n        self.pages = pages\n        self.cursor = None\n\n    def iter_pages(self, cursor):\n        self.cursor = cursor\n        for entry in self.pages:\n            if isinstance(entry, Exception):\n                raise entry\n            yield entry\n\n\nclass DeltaTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.path = Path(self.tmp.name) / \"catalog.db\"\n        self.conn = store.connect(self.path)\n        self.addCleanup(self.conn.close)\n\n    def test_interleaved_and_unsorted_events(self):\n        stats = run_sync(self.conn, Pages(page(\"opaque:1\", [item(5, \"A\", \"0.57\"), item(1, \"A\"),\n            "]
