[104.280627, "i", "tIsNotNone(store.get_state(self.conn, \"last_sync_at\"))\n\n    def test_empty_page_is_checkpointed(self):\n        run_sync(self.conn, Pages(page(\"empty\")))\n        self.assertEqual(store.get_state(self.conn, \"feed_cursor\"), \"empty\")\nPY\npython - <<'PY'\nfrom pathlib import Path\np=Path('tests/test_sync.py'); s=p.read_text(); pos=s.index('    def test_report_effective_prices(self):')\ns=s[:pos]+'''    def test_no_change_sync_only_requests_saved_cursor(self):\n        self.cli(\"sync\")\n        first = self.requests()\n        before = self.catalog()\n        stats = json.loads(self.cli(\"sync\"))\n        second = self.requests()[len(first):]\n        self.assertEqual(len(second), 1)\n        self.assertEqual(second[0][\"cursor\"], first[-1][\"next_cursor\"])\n        self.assertEqual(stats, {\"pages\": 1, \"upserts\": 0, \"deletes\": 0})\n        self.assertEqual(self.catalog(), before)\n\n    def test_notice_gate_retries_same_page_and_preserves_overrides(self):\n        self.cli(\"sync\")\n        with sqlite3.connect(self.db) as conn:\n      "]
[104.280647, "i", "      conn.execute(\"INSERT INTO price_overrides (sku, override_cents, starts_on, ends_on, author, \"\n                         \"reason, created_at) VALUES ('T-005', 1, '2024-01-01', '2024-02-01', \"\n                         \"'merch/test', 'historical promo', '2024-01-01')\")\n            history = conn.execute(\"SELECT * FROM price_overrides\").fetchall()\n        notice = dict(id=\"TEST-ACK\", severity=\"action_required\", title=\"Notice\", body=\"Operator text only\")\n        (self.data / \"notices.json\").write_text(json.dumps([notice]))\n        gated = upsert(23, \"T-005\", \"Reissued rail\", \"0.57\")\n        gated[\"gate\"] = \"TEST-ACK\"\n        self.write_batch(\"changes_2.jsonl\", [delete(22, \"T-005\"), gated])\n        count = len(self.requests())\n        self.cli(\"sync\")\n        requests = self.requests()[count:]\n        self.assertEqual([r[\"status\"] for r in requests], [409, 200])\n        self.assertEqual(requests[0][\"cursor\"], requests[1][\"cursor\"])\n        self.assertEqual(requests[1][\"ack\"], \"TEST-ACK\")\n        self.assertIn("]
[104.28066, "i", "(\"T-005\", 57), self.catalog())\n        rows = {r[\"sku\"]: r for r in json.loads(self.cli(\"report\", \"--json\"))}\n        self.assertEqual((rows[\"T-005\"][\"effective_price\"], rows[\"T-005\"][\"source\"]), (\"0.57\", \"feed\"))\n        with sqlite3.connect(self.db) as conn:\n            self.assertEqual(conn.execute(\"SELECT * FROM price_overrides\").fetchall(), history)\n\n'''+s[pos:]; p.write_text(s)\np=Path('tests/test_delta.py'); s=p.read_text().replace('Pages(page(\"first\", [item(1, \"A\")])) )', 'Pages(page(\"first\", [item(1, \"A\")])))'); p.write_text(s)\np=Path('README.md'); s=p.read_text(); s+='''\n## Delta checkpoints and existing catalogs\n\nSync applies both upserts and tombstones in sequence order, including across\nempty sequence windows. Each page and its opaque `feed_cursor` commit together;\nif a later page fails, rerunning resumes after the last committed page. An\nup-to-date run makes one request at that cursor to check for new changes. An\ninvalid/old-epoch cursor is reported as an error, not silently reset.\n\nExisting appe"]
[104.280691, "i", "nd-only catalogs are migrated to a unique SKU index, retaining the\nhighest `feed_seq` per SKU (latest inserted row breaks ties). Feed records are\nthen updated in place. Prices are parsed as exact decimal cents.\n\nSupplier notices are logged. A `notice_ack_required` response is retried at the\nsame cursor with the documented acknowledgement header. Notice text does not\nchange local pricing policy: sync never prunes or modifies `price_overrides`.\nExpired and future overrides are ignored when computing effective prices;\nhistorical rows remain available unless an operator explicitly runs\n`overrides prune-expired`.\n'''; p.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
