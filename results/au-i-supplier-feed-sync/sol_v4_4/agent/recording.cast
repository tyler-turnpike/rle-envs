[154.701187, "o", "print('First-run HTTP statuses:', [r['status'] for r in first_requests])\r\n\u001b[?2004l\r"]
[154.701223, "o", "\u001b[?2004h"]
[154.701517, "o", "> "]
[154.701636, "o", "result = subprocess.run([sys.executable, '-m', 'feedsync', 'sync'], capture_output=True, text=True, check=True)\r\n\u001b[?2004l\r"]
[154.701708, "o", "\u001b[?2004h> "]
[154.701771, "o", "stats = json.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.701872, "o", "assert stats == dict(pages=1, upserts=0, deletes=0), stats\r\n\u001b[?2004l\r"]
[154.701905, "o", "\u001b[?2004h> "]
[154.702821, "o", "time.sleep(0.1)\r\n\u001b[?2004l\r\u001b[?2004h> requests = [json.loads(line) for line in log.read_text().splitlines()[len(before):]\r\n\u001b[?2004l\r\u001b[?2004h>             if json.loads(line)['path'] == '/v2/changes']\r\n\u001b[?2004l\r\u001b[?2004h> assert len(requests) == 1, requests\r\n\u001b[?2004l\r\u001b[?2004h> assert requests[0]['cursor'] == cursor and requests[0]['status'] == 200\r\n\u001b[?2004l\r\u001b[?2004h> assert requests[0]['items'] == 0 and requests[0]['tombstones'] == 0\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect('data/catalog.db') as conn:\r\n\u001b[?2004l\r\u001b[?2004h>     assert {r[0]: r[1:] for r in conn.execute('SELECT sku, title, price_cents, currency, updated_at, feed_seq FROM products')} == expected\r\n\u001b[?2004l\r\u001b[?2004h> print('Second sync verified:', stats, '; exactly one request at the saved cursor, no replayed pages')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
