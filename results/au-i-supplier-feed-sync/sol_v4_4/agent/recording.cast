[104.275882, "i", "cd /app && cat > tests/test_store.py <<'PY'\n\"\"\"Storage invariants, legacy migration, and merchandising price selection.\"\"\"\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom feedsync import store\n\n\nclass StoreTest(unittest.TestCase):\n    def setUp(self):\n        self.conn = store.connect(\":memory:\")\n        self.addCleanup(self.conn.close)\n\n    def test_exact_cents(self):\n        for price, cents in [(\"4.35\", 435), (\"19.99\", 1999), (\"0.29\", 29),\n                             (\"8.58\", 858), (\"0.57\", 57), (\"249.70\", 24970),\n                             (\"12\", 1200), (\"0.00\", 0), (\"-0.29\", -29)]:\n            with self.subTest(price=price):\n                self.assertEqual(store.price_to_cents(price), cents)\n                self.assertEqual(store.format_cents(cents), f\"{price}.00\" if \".\" not in price else price)\n        for price in (\"1.001\", \"NaN\", \"Infinity\"):\n            with self.subTest(price=price), self.assertRaises(ValueError):\n                store.price_to_cents(price)\n\n    def"]
[104.276441, "i", " test_upsert_updates_all_feed_columns(self):\n        store.insert_product(self.conn, dict(sku=\"A\", title=\"Old\", price=\"4.35\", seq=1))\n        store.insert_product(self.conn, dict(sku=\"A\", title=\"New\", price=\"0.57\", currency=\"GBP\",\n                                             updated_at=\"2026-11-01T00:00:00Z\", seq=2))\n        row = self.conn.execute(\"SELECT * FROM products\").fetchone()\n        self.assertEqual(store.product_count(self.conn), 1)\n        self.assertEqual(tuple(row[k] for k in (\"title\", \"price_cents\", \"currency\", \"updated_at\", \"feed_seq\")),\n                         (\"New\", 57, \"GBP\", \"2026-11-01T00:00:00Z\", 2))\n        with self.assertRaises(sqlite3.IntegrityError):\n            self.conn.execute(\"INSERT INTO products (sku, title, price_cents) VALUES ('A', 'Duplicate', 1)\")\n\n    def test_override_boundaries_and_newest_active(self):\n        store.insert_product(self.conn, dict(sku=\"A\", title=\"A\", price=\"4.35\", seq=1))\n        overrides = [(99, \"2026-01-01\", \"2026-11-21\"),  # expired\n               "]
