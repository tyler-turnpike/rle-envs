[104.304074, "o", "?2004h>         gated[\"gate\"] = \"TEST-ACK\"\r\n\u001b[?2004l\r\u001b[?2004h>         self.write_batch(\"changes_2.jsonl\", [delete(22, \"T-005\"), gated])\r\n\u001b[?2004l\r\u001b[?2004h>         count = len(self.requests())\r\n\u001b[?2004l\r\u001b[?2004h>         self.cli(\"sync\")\r\n\u001b[?2004l\r\u001b[?2004h>         requests = self.requests()[count:]\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual([r[\"status\"] for r in requests], [409, 200])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(requests[0][\"cursor\"], requests[1][\"cursor\"])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(requests[1][\"ack\"], \"TEST-ACK\")\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertIn((\"T-005\", 57), self.catalog())\r\n\u001b[?2004l\r\u001b[?2004h>         rows = {r[\"sku\"]: r for r in json.loads(self.cli(\"report\", \"--json\"))}\r\n\u001b[?2004l\r\u001b[?2004h> "]
