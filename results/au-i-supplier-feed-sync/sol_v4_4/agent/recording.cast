[136.890752, "i", "cd /app && python - <<'PY'\nimport sqlite3\nfrom pathlib import Path\nbackup = Path('/var/tmp/feedsync-catalog-before-fix.db')\nif backup.exists():\n    raise SystemExit(f'Refusing to overwrite existing backup: {backup}')\nwith sqlite3.connect('data/catalog.db') as source, sqlite3.connect(backup) as target:\n    source.backup(target)\n    print(f'Backup saved: {backup}')\n    print('Overrides preserved before sync:', source.execute('SELECT COUNT(*) FROM price_overrides').fetchone()[0])\nPY\npython -m feedsync sync > /var/tmp/feedsync-local-first.out 2> /var/tmp/feedsync-local-first.log; result=$?; cat /var/tmp/feedsync-local-first.out; echo \"sync exit: $result\"; python -m feedsync status\n"]
