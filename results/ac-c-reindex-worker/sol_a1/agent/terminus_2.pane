import json
import time
from pathlib import Path
from reindex.checkpoint import Checkpoint
from reindex.source import Source
from reindex.store import iter_rows, shard_paths
from reindex.transform import transform_doc

root = Path('/app')
checkpoint = Checkpoint(root / 'var/checkpoint.json')
while not checkpoint.load()['complete']:
    time.sleep(2)
state = checkpoint.load()
rows = list(iter_rows(root / 'var/index'))
ids = [row['id'] for row in rows]
assert len(ids) == len(set(ids)), 'duplicate ids'
source = Source(root / 'data/docs.db')
docs = [doc for batch in source.batches(size=100) for doc in batch]
assert ids == [doc.id for doc in docs], 'missing, extra, or out-of-order ids'
assert state['docs'] == len(docs)
assert state['last_id'] == docs[-1].id
assert state['shards'] == {p.name: p.stat().st_size for p in shard_paths(root / 'var/index')}
print('Verified exact live-document coverage and checkpoint boundaries: %d rows' % len(rows), flush=True)
for n, (row, doc) in enumerate(zip(rows, docs), 1):
    assert row == transform_doc(doc), 'row mismatch for id %d' % doc.id
    if n % 1000 == 0:
        print('Verified all row fields, including checksum/minhash: %d/%d' % (n, len(rows)), flush=True)
source.close()
print('PASS: all %d rows match the unchanged transformation; complete, duplicate-free index.' % len(rows), flush=True)
