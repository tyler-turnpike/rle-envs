s = open(p).read().replace('import sqlite3\n', 'import sqlite3\nimport subprocess\nimport sys\n')
pos = s.index('    def test_empty_source_is_complete(self):')
s = s[:pos] + '''    def test_sigkill_between_shard_flush_and_checkpoint(self):
        # Kill without Python cleanup, after the second batch is durable but
        # before its checkpoint. This also crosses a shard boundary.
        script = """
import os
import signal
import sys
from reindex.checkpoint import Checkpoint
from reindex.store import ShardWriter
from reindex.worker import main
original_save = Checkpoint.save
original_init = ShardWriter.__init__
def small_shards(self, index_dir):
    original_init(self, index_dir, shard_rows=3, buffer_rows=1)
ShardWriter.__init__ = small_shards
def kill_before_save(self, state):
    if state['docs'] == 4:
        os.kill(os.getpid(), signal.SIGKILL)
    original_save(self, state)
Checkpoint.save = kill_before_save
main(sys.argv[1:])
"""
        result = subprocess.run([sys.executable, "-c", script,
                                 "--source", str(self.db), "--index-dir", str(self.index),
                                 "--checkpoint", str(self.ckpt.path), "--batch-size", "2"],
                                cwd=Path(__file__).resolve().parent.parent,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=10)
        self.assertEqual(result.returncode, -signal.SIGKILL)
        self.assertEqual(self.ckpt.load()["docs"], 2)
        self.assertEqual(list(iter_rows(self.index)), self.expected[:4])
        self.assertEqual(run(self.args), 0)
        self.assert_complete()

''' + s[pos:]
open(p, 'w').write(s)
