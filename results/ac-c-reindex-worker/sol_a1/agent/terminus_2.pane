    def assert_complete(self):
        self.assertEqual(list(iter_rows(self.index)), self.expected)
        state = self.ckpt.load()
        self.assertTrue(state["complete"])
        self.assertEqual(state["docs"], len(self.expected))
        self.assertEqual(state["last_id"], self.docs[-1].id)
        self.assertEqual(state["shards"], {p.name: p.stat().st_size
                                          for p in shard_paths(self.index)})

