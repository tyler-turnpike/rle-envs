[103.71189, "i", "(while true; do ./jobs reindex; rc=$?; if [ \"$rc\" -eq 0 ]; then break; fi; if [ \"$rc\" -ne 75 ]; then echo \"FAILED rc=$rc\"; exit \"$rc\"; fi; done) > /app/var/reindex-build.log 2>&1 & echo \"Build loop PID: $!\"\n"]
