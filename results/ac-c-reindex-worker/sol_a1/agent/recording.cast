[169.058664, "i", "cat > /tmp/verify_search412.py <<'PY'\nimport json\nimport time\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nroot = Path('/app')\ncheckpoint = Checkpoint(root / 'var/checkpoint.json')\nwhile not checkpoint.load()['complete']:\n    time.sleep(2)\nstate = checkpoint.load()\nrows = list(iter_rows(root / 'var/index'))\nids = [row['id'] for row in rows]\nassert len(ids) == len(set(ids)), 'duplicate ids'\nsource = Source(root / 'data/docs.db')\ndocs = [doc for batch in source.batches(size=100) for doc in batch]\nassert ids == [doc.id for doc in docs], 'missing, extra, or out-of-order ids'\nassert state['docs'] == len(docs)\nassert state['last_id'] == docs[-1].id\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths(root / 'var/index')}\nprint('Verified exact live-document coverage and checkpoint boundaries: %d rows' % len(rows), flush=True)\nfor n, (row, doc) in en"]
[169.059036, "o", "cat > /tmp/verify_search412.py <<'PY'\r\nimport json\r\nimport time\r\nfrom pathlib import Path\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import iter_rows, shard_paths\r\nfrom reindex.transform import transform_doc\r\n\r\nroot = Path('/app')\r\ncheckpoint = Checkpoint(root / 'var/checkpoint.json')\r\nwhile not checkpoint.load()['complete']:\r\n    time.sleep(2)\r\nstate = checkpoint.load()\r\nrows = list(iter_rows(root / 'var/index'))\r\nids = [row['id'] for row in rows]\r\nassert len(ids) == len(set(ids)), 'duplicate ids'\r\nsource = Source(root / 'data/docs.db')\r\ndocs = [doc for batch in source.batches(size=100) for doc in batch]\r\nassert ids == [doc.id for doc in docs], 'missing, extra, or out-of-order ids'\r\nassert state['docs'] == len(docs)\r\nassert state['last_id'] == docs[-1].id\r\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths(root / 'var/index')}\r\nprint('Verified exact live-document coverage and checkpoint boundaries: %d rows' % len(rows), flush=True)\r"]
[169.059099, "i", "umerate(zip(rows, docs), 1):\n    assert row == transform_doc(doc), 'row mismatch for id %d' % doc.id\n    if n % 1000 == 0:\n        print('Verified all row fields, including checksum/minhash: %d/%d' % (n, len(rows)), flush=True)\nsource.close()\nprint('PASS: all %d rows match the unchanged transformation; complete, duplicate-free index.' % len(rows), flush=True)\nPY\nPYTHONPATH=/app python3 /tmp/verify_search412.py > var/index-verification.log 2>&1 & echo \"Verifier PID: $!\"\n"]
