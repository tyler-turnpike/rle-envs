[75.672523, "i", "      self.path.parent.mkdir(parents=True, exist_ok=True)\n        fd, tmp = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                   dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(tmp, self.path)\n            fsync_directory(self.path.parent)\n        finally:\n            Path(tmp).unlink(missing_ok=True)\n\n    def clear(self):\n        self.path.unlink(missing_ok=True)\n        if self.path.parent.exists():\n            fsync_directory(self.path.parent)\nEOF\npython3 - <<'PY'\np = 'reindex/source.py'\ns = open(p).read().replace('id >= start_id', 'id > start_id').replace('AND id >= ?', 'AND id > ?').replace('next_id = rows[-1][0] + 1', 'next_id = rows[-1][0]')\nopen(p, 'w').write(s)\nPY\n"]
