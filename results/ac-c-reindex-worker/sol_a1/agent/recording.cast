[7.311873, "o", "Normally started by `make reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str(ROOT / \"var\" / \"index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(R"]
[7.311993, "o", "OOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    ckpt = Checkpoint(args.checkpoint)\r\n    state = ckpt.load()\r\n    if state[\"complete\"]:\r\n        log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n        return 0\r\n    source = Source(args.source)\r\n    store = ShardWriter(args."]
[7.312361, "o", "index_dir)\r\n    if state[\"last_id\"] == 0:\r\n        log.info(\"no checkpoint: rebuilding index from scratch\")\r\n        store.reset()\r\n    total = source.count()\r\n    started = time.monotonic()\r\n    log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\r\n    for n, batch in enumerate(source.batches(start_id=state[\"last_id\"], size=args.batch_size), 1):\r\n        for doc in batch:\r\n            store.add(transform_doc(doc))\r\n        state[\"last_id\"] = batch[-1].id\r\n        state[\"docs\"] += len(batch)\r\n        ckpt.save(state)\r\n        if n % 20 == 0:\r\n            rate = n * args.batch_size / (time.monotonic() - started)\r\n            log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                     state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n    store.close()\r\n    state[\"complete\"] = True\r\n    ckpt.save(state)\r\n    source.close()\r\n    log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n    return 0\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logg"]
[7.312372, "o", "ing.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[7.316353, "o", "#!/usr/bin/env python3\r\n\"\"\"Job supervisor.  Every batch job in this repo runs through it.\r\n\r\n    python3 ops/supervise.py run <job>       run (or resume) the job inside its budget\r\n    python3 ops/supervise.py history <job>   show the last runs\r\n\r\nPer-job limits live in ops/limits.json.  When a run reaches its wall-clock budget\r\nthe job's process group gets SIGTERM; whatever is still alive `grace_seconds` later\r\ngets SIGKILL.  Nothing the job started is left running when this returns.\r\n\r\nExit status: 0 job finished, 75 stopped at the budget (run again to continue),\r\n73 another run of the job holds the lock, anything else: the job failed.\r\n\"\"\"\r\nimport argparse\r\nimport fcntl\r\nimport json\r\nimport os\r\nimport signal\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nLIMITS_FILE = ROOT / \"ops\" / \"limits.json\"\r\nRUN_DIR = ROOT / \"var\" / \"run\"\r\nLOG_FILE = ROOT / \"var\" / \"supervisor.log\"\r\nJOBS = {\"reindex\": [sys.executable, \"-m\", \"reindex.worker\"]}\r\nE"]
[7.316375, "o", "X_INCOMPLETE, EX_BUSY = 75, 73\r\n\r\n\r\nclass _Interrupted(Exception):\r\n    pass\r\n\r\n\r\ndef _raise_interrupted(signum, frame):\r\n    raise _Interrupted(signal.Signals(signum).name)\r\n\r\n\r\ndef load_limits(job):\r\n    limits = json.loads(LIMITS_FILE.read_text())[\"jobs\"][job]\r\n    return float(limits[\"budget_seconds\"]), float(limits[\"grace_seconds\"])\r\n\r\n\r\ndef _signal_group(pgid, sig):\r\n    try:\r\n        os.killpg(pgid, sig)\r\n        return True\r\n    except ProcessLookupError:\r\n        return False\r\n\r\n\r\ndef _stop(proc, grace):\r\n    \"\"\"SIGTERM the job's group, SIGKILL after the grace period. Returns (rc, outcome).\"\"\"\r\n    _signal_group(proc.pid, signal.SIGTERM)\r\n    try:\r\n        return proc.wait(timeout=grace), \"stopped\"\r\n    except subprocess.TimeoutExpired:\r\n        print(\"supervise: still running %gs after SIGTERM, sending SIGKILL\" % grace, flush=True)\r\n        _signal_group(proc.pid, signal.SIGKILL)\r\n        return proc.wait(), \"killed\"\r\n\r\n\r\ndef run(job):\r\n    budget, grace = load_limits(job)\r\n    RUN_DIR.mkdir(parents"]
[7.316386, "o", "=True, exist_ok=True)\r\n    lock = open(RUN_DIR / (\"%s.lock\" % job)"]
[7.316796, "o", ", \"w\")\r\n    try:\r\n        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\r\n    except BlockingIOError:\r\n        print(\"supervise: another %s run holds the lock\" % job, file=sys.stderr)\r\n        return EX_BUSY\r\n    for sig in (signal.SIGTERM, signal.SIGHUP):\r\n        signal.signal(sig, _raise_interrupted)\r\n\r\n    started_at = time.strftime(\"%Y-%m-%dT%H:%M:%S\")\r\n    t0 = time.monotonic()\r\n    proc = subprocess.Popen(JOBS[job], cwd=ROOT, start_new_session=True,\r\n                            env=dict(os.environ, SUPERVISED_JOB=job))\r\n    pidfile = RUN_DIR / (\"%s.pid\" % job)\r\n    pidfile.write_text(\"%d\\n\" % proc.pid)\r\n    print(\"supervise: %s started pid=%d budget=%gs grace=%gs\" % (job, proc.pid, budget, grace),\r\n          flush=True)\r\n    stop_latency = None\r\n    try:\r\n        try:\r\n            rc, outcome = proc.wait(timeout=budget), \"finished\"\r\n        except subprocess.TimeoutExpired:\r\n            print(\"supervise: budget of %gs reached, sending SIGTERM\" % budget, flush=True)\r\n            t_term = time.monotoni"]
[7.316841, "o", "c()\r\n            rc, outcome = _stop(proc, grace)\r\n            stop_latency = round(time.monotonic() - t_term, 3)\r\n    except (KeyboardInterrupt, _Interrupted):\r\n        t_term = time.monotonic()\r\n        rc, outcome = _stop(proc, grace)\r\n        outcome = \"interrupted\" if outcome == \"stopped\" else outcome\r\n        stop_latency = round(time.monotonic() - t_term, 3)\r\n    finally:\r\n        if _signal_group(proc.pid, signal.SIGKILL):   # stragglers left in the job's group\r\n            print(\"supervise: killed leftover processes of %s\" % job, flush=True)\r\n        pidfile.unlink(missing_ok=True)\r\n\r\n    record = {\"job\": job, \"started_at\": started_at, \"pid\": proc.pid,\r\n              \"budget_seconds\": budget, \"grace_seconds\": grace, \"outcome\": outcome,\r\n              \"returncode\": rc, \"elapsed\": round(time.monotonic() - t0, 3),\r\n              \"stop_latency\": stop_latency}\r\n    with open(LOG_FILE, \"a\") as fh:\r\n        fh.write(json.dumps(record) + \"\\n\")\r\n    print(\"supervise: %s %s after %.1fs (rc=%s)\" % (job, outcome"]
[7.31686, "o", ", record[\"elapsed\"], rc), flush=True)\r\n    "]
[7.31705, "o", "if outcome == \"finished\":\r\n        return 0 if rc == 0 else (rc if rc > 0 else 1)\r\n    if outcome == \"stopped\":\r\n        print(\"supervise: %s incomplete; run it again to continue\" % job, flush=True)\r\n    return EX_INCOMPLETE\r\n\r\n\r\ndef history(job, limit=10):\r\n    if not LOG_FILE.exists():\r\n        print(\"no runs recorded\")\r\n        return 0\r\n    records = [json.loads(line) for line in LOG_FILE.read_text().splitlines() if line.strip()]\r\n    for rec in [r for r in records if r.get(\"job\") == job][-limit:]:\r\n        print(\"%(started_at)s  %(outcome)-11s rc=%(returncode)-4s %(elapsed)7.1fs  \"\r\n              \"budget=%(budget_seconds)gs\" % rec)\r\n    return 0\r\n\r\n\r\ndef main(argv=None):\r\n    parser = argparse.ArgumentParser(prog=\"supervise.py\")\r\n    parser.add_argument(\"command\", choices=(\"run\", \"history\"))\r\n    parser.add_argument(\"job\", choices=sorted(JOBS))\r\n    args = parser.parse_args(argv)\r\n    return run(args.job) if args.command == \"run\" else history(args.job)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main()"]
