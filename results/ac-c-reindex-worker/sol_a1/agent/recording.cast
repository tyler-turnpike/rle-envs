[169.256018, "o", "\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n\r\nNormally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport signal\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str"]
[169.256224, "o", "(ROOT / \"var\" / \"index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    args = parser.parse_args(argv)\r\n    if args.batch_size <= 0:\r\n        parser.error(\"--batch-size must be positive\")\r\n    return args\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir, state[\"shards\"]))\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    stopping = False\r\n\r\n    def request_stop(signum, frame):\r\n        # Never raise in the"]
[169.256235, "o", " middle of a shard/checkpoint write. A second signal\r\n        # is harmless too; SIGKILL is handled by recovery on the next invocation.\r\n        nonlocal stopping\r\n        stopping = True\r\n\r\n    previous_handlers = {}\r\n    store = source = None\r\n    try:\r\n        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):\r\n            previous_handlers[sig] = signal.signal(sig, request_stop)\r\n        ckpt = Checkpoint(args.checkpoint)\r\n        state = ckpt.load()\r\n        store = ShardWriter(args.index_dir)\r\n        # Even a complete checkpoint can have uncommitted bytes after it.\r\n        store.recover(state[\"shards\"])\r\n        if state[\"complete\"]:\r\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n            return 0\r\n        source = Source(args.source)\r\n        total = source.count()\r\n        started = time.monotonic()\r\n        initial_docs = state[\"docs\"]\r\n        log.info(\"starting after id %d (%d/%d docs done)\",\r\n                 state[\"last_id\"], state[\"docs\"], total)\r\n\r\n      "]
[169.25624, "o", "  for n, batch in enumerate(source.batches(start_id=state[\"last_id\"],\r\n                                                 size=args.batch_size), 1):\r\n            done = 0\r\n            last_id = state[\"last_id\"]\r\n            for doc in batch:\r\n                if stopping:\r\n                    break\r\n                store.add(transform_doc(doc))\r\n                last_id = doc.id\r\n                done += 1\r\n            if done:\r\n                # This ordering is the transaction protocol: durable shard data,\r\n                # then atomic checkpoint publication. Recovery rolls back bytes\r\n                # written before a crash but not covered by the checkpoint.\r\n                shards = store.commit()\r\n                state = dict(state, last_id=last_id, docs=state[\"docs\"] + done,\r\n                             shards=shards)\r\n                ckpt.save(state)\r\n            if stopping:\r\n                log.info(\"stopped after id %d (%d/%d docs committed)\",\r\n                         state[\"last_id\"], state[\"docs\"]"]
[169.256257, "o", ", total)\r\n                return 75\r\n            if n % 20 == 0:\r\n                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\r\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                         state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n        state = dict(state, complete=True, shards=store.commit())\r\n        ckpt.save(state)\r\n        log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n        return 0\r\n    finally:\r\n        try:\r\n            if store is not None:\r\n                # On an exception, do not flush pending rows. Already-written\r\n                # uncommitted tails will be removed by recover().\r\n                store.close(flush=False)\r\n        finally:\r\n            if source is not None:\r\n                source.close()\r\n            for sig, handler in previous_handlers.items():\r\n                signal.signal(sig, handler)\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logging.INFO, stream=sys.stderr,\r\n                  "]
[169.256263, "o", "      format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[169.257916, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\n"]
[169.257988, "o", "import os\r\nfrom pathlib import Path\r\n\r\n"]
[169.258109, "o", "from reindex.durability import fsync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir, shards=None):\r\n    \"\"\"Read all rows, or just the checkpoint's committed byte prefixes.\r\n\r\n    The bounded form is safe for status while a worker is appending a batch.\r\n    In particular it never parses an uncommitted, possibly partial JSON line.\r\n    \"\"\"\r\n"]
[169.258121, "o", "    paths = ([(path, None) for path in shard_paths(index_dir)] if shards is None\r\n             else [(Path(index_dir) / name, size) for name, size in sorted(shards.items())])\r\n    for path, remaining in paths:\r\n        with open(path, \"rb\") as fh:\r\n            while remaining is None or remaining > 0:\r\n                line = fh.readline(-1 if remaining is None else remaining)\r\n                if not line:\r\n                    if remaining:\r\n                        raise RuntimeError(\"committed shard is short: %s\" % path)\r\n                    break\r\n                if remaining is not None:\r\n                    remaining -= len(line)\r\n                if line.strip():\r\n"]
[169.258133, "o", "                    yield json.loads(line)\r\n"]
[169.258141, "o", "\r\n"]
[169.258157, "o", "\r\nclass ShardWriter:\r\n"]
[169.258237, "o", "    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n"]
[169.258316, "o", "        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        fsync_directory(self.index_dir.parent)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n"]
[169.258366, "o", "\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._buffer.clear()\r\n        self._rows_in_shard = 0\r\n        self._next_shard = 0\r\n        fsync_directory(self.index_dir)\r\n\r\n    def recover(self, shards):\r\n"]
[169.258444, "o", "        \"\"\"Restore the checkpoint prefix, discarding any interrupted transaction.\r\n\r\n        Validate every committed file before changing anything. Never silently\r\n        skip committed work if the index has been lost or externally damaged.\r\n        Call only on a newly opened writer. Byte offsets also handle partial\r\n        JSON/UTF-8 writes without ever having to parse an uncommitted tail.\r\n        \"\"\"\r\n        for name, size in shards.items():\r\n            path = self.index_dir / name\r\n"]
[169.258625, "o", "            if not path.is_file() or path.stat().st_size < size:\r\n                raise RuntimeError(\"committed shard is missing or short: %s\" % path)\r\n        for path in shard_paths(self.index_dir):\r\n            if path.name not in shards:\r\n                path.unlink()\r\n            elif path.stat().st_size != shards[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(shards[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        fsync_directory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n"]
