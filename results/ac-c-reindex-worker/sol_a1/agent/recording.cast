[12.67385, "o", "# search-reindex\r\n\r\nBuilds the search index (`var/index/shard-*.jsonl`) from the document store\r\n(`data/docs.db`).\r\n\r\n| path | what |\r\n|------|------|\r\n| `reindex/worker.py` | the reindex job: reads docs in id order, transforms, writes shards, checkpoints |\r\n| `reindex/transform.py` | doc -> index row (row format documented there) |\r\n| `reindex/store.py` | shard writer / reader |\r\n| `reindex/checkpoint.py` | progress checkpoint (`var/checkpoint.json`) |\r\n| `reindex/source.py` | source corpus access (+ fixture generator) |\r\n| `ops/supervise.py` | job runner used for every batch job here: budget, SIGTERM/SIGKILL, run log |\r\n| `ops/limits.json` | per-job budgets |\r\n| `jobs` | entry points: `./jobs reindex`, `./jobs status`, `./jobs history`, `./jobs test`, `./jobs clean` |\r\n\r\nA full reindex of the current corpus is several budgets long; the job is designed\r\nto be run repeatedly and pick up where the previous run stopped.\r\n"]
[12.674014, "o", "{\r\n  \"jobs\": {\r\n    \"reindex\": {\r\n      \"budget_seconds\": 20,\r\n      \"grace_seconds\": 5\r\n    }\r\n  }\r\n}\r\n"]
[12.675358, "o", "\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n\r\nNormally started by `make reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str(ROOT / \"var\" / \""]
[12.675545, "o", "index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    ckpt = Checkpoint(args.checkpoint)\r\n    state = ckpt.load()\r\n    if state[\"complete\"]:\r\n        log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n        return 0\r\n    so"]
[12.675598, "o", "urce = Source(args.source)\r\n    store = ShardWriter(args."]
[12.675768, "o", "index_dir)\r\n    if state[\"last_id\"] == 0:\r\n        log.info(\"no checkpoint: rebuilding index from scratch\")\r\n        store.reset()\r\n    total = source.count()\r\n    started = time.monotonic()\r\n    log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\r\n    for n, batch in enumerate(source.batches(start_id=state[\"last_id\"], size=args.batch_size), 1):\r\n        for doc in batch:\r\n            store.add(transform_doc(doc))\r\n        state[\"last_id\"] = batch[-1].id\r\n        state[\"docs\"] += len(batch)\r\n        ckpt.save(state)\r\n        if n % 20 == 0:\r\n            rate = n * args.batch_size / (time.monotonic() - started)\r\n            log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                     state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n    store.close()\r\n    state[\"complete\"] = True\r\n    ckpt.save(state)\r\n    source.close()\r\n    log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n    return 0\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logg"]
[12.675775, "o", "ing.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[12.676945, "o", "#!/usr/bin/env python3\r\n\"\"\"Job supervisor.  Every batch job in this repo runs through it.\r\n\r\n    python3 ops/supervise.py run <job>       run (or resume) the job inside its budget\r\n    python3 ops/supervise.py history <job>   show the last runs\r\n\r\nPer-job limits live in ops/limits.json.  When a run reaches its wall-clock budget\r\nthe job's process group gets SIGTERM; whatever is still alive `grace_seconds` later\r\ngets SIGKILL.  Nothing the job started is left running when this returns.\r\n\r\nExit status: 0 job finished, 75 stopped at the budget (run again to continue),\r\n73 another run of the job holds the lock, anything else: the job failed.\r\n\"\"\"\r\nimport argparse\r\nimport fcntl\r\nimport json\r\nimport os\r\nimport signal\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nLIMITS_FILE = ROOT / \"ops\" / \"limits.json\"\r\nRUN_DIR = ROOT / \"var\" / \"run\"\r\nLOG_FILE = ROOT / \"var\" / \"supervisor.log\"\r\nJOBS = {\"reindex\": [sys.executable, \"-m\", \"reindex.worker\"]}\r\nE"]
[12.676965, "o", "X_INCOMPLETE, EX_BUSY = 75, "]
