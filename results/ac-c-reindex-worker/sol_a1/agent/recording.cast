[103.827819, "o", "\r\n\u001b[?2004l\r\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durability import fsync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SH"]
[103.827842, "o", "ARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        fsync_directory(self.index_dir.parent)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._buffer.clear()\r\n        self._rows_in_shard = 0\r\n        self._next_shard = 0\r\n        fsync_directory(self.index_dir)\r\n\r\n    def recover(self, shards):\r\n"]
[103.827857, "o", "        \"\"\"Restore the checkpoint prefix, discarding any interrupted transaction.\r\n\r\n        Validate every committed file before changing anything. Never silently\r\n        skip committed work if the index has been lost or externally damaged.\r\n        Call only on a newly opened writer. Byte offsets also handle partial\r\n        JSON/UTF-8 writes without ever having to parse an uncommitted tail.\r\n        \"\"\"\r\n        for name, size in shards.items():\r\n            path = self.index_dir / name\r\n            if not path.is_file() or path.stat().st_size < size:\r\n                raise RuntimeError(\"committed shard is missing or short: %s\" % path)\r\n        for path in shard_paths(self.index_dir):\r\n            if path.name not in shards:\r\n                path.unlink()\r\n            elif path.stat().st_size != shards[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(shards[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        fsync_direc"]
[103.827866, "o", "tory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def commit(self):\r\n        \"\"\"Make rows durable BEFORE publishing these boundaries in a checkpoint.\"\"\"\r\n        self.flush()\r\n        fsync_directory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n      "]
[103.827883, "o", "  path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self, flush=True):\r\n        if flush:\r\n            self.flush()\r\n        else:\r\n            self._buffer.clear()\r\n        self._close_shard()\r\n"]
[103.829288, "o", "\"\"\"Atomic progress checkpoint and committed shard byte boundaries.\"\"\"\r\nimport json\r\nimport logging\r\nimport os\r\nimport re\r\nimport tempfile\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durability import fsync_directory\r\n\r\nlog = logging.getLogger(\"reindex.checkpoint\")\r\n\r\n\r\ndef fresh_state():\r\n    # last_id is exclusive on resume. shards describes only durable bytes.\r\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False, \"shards\": {}}\r\n\r\n\r\n"]
[103.829319, "o", "class Checkpoint:\r\n    def __init__(self, path):\r\n        self.path = Path(path)\r\n\r\n    def load(self):\r\n        try:\r\n            data = json.loads(self.path.read_text(encoding=\"utf-8\"))\r\n        except FileNotFoundError:\r\n            return fresh_state()\r\n        except ValueError:\r\n            log.warning(\"checkpoint %s unreadable, starting over\", self.path)\r\n            return fresh_state()\r\n        # Old checkpoints may claim buffered rows were committed. They cannot be\r\n        # safely resumed; rebuild once rather than perpetuating missing rows.\r\n        if not isinstance(data, dict) or \"shards\" not in data:\r\n            log.warning(\"checkpoint %s has no durable shard boundaries; rebuilding\", self.path)\r\n            return fresh_state()\r\n        if (type(data.get(\"last_id\")) is not int or data[\"last_id\"] < 0\r\n                or type(data.get(\"docs\")) is not int or data[\"docs\"] < 0\r\n                or type(data.get(\"complete\")) is not bool\r\n                or not isinstance(data[\"shards\"], dict)\r\n      "]
[103.829324, "o", "          or any(not re.fullmatch(r\"shard-[0-9]+\\.jsonl\", name)\r\n                       or type(size) is not int or size < 0\r\n                       for name, size in data[\"shards\"].items())):\r\n            raise ValueError(\"invalid checkpoint: %s\" % self.path)\r\n        return data\r\n\r\n    def save(self, state):\r\n        self.path.parent.mkdir(parents=True, exist_ok=True)\r\n        fd, tmp = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\r\n                                   dir=self.path.parent)\r\n        try:\r\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\r\n                json.dump(state, fh)\r\n           "]
[103.829603, "o", "     fh.flush()\r\n                os.fsync(fh.fileno())\r\n            os.replace(tmp, self.path)\r\n            fsync_directory(self.path.parent)\r\n        finally:\r\n            Path(tmp).unlink(missing_ok=True)\r\n\r\n    def clear(self):\r\n        self.path.unlink(missing_ok=True)\r\n        if self.path.parent.exists():\r\n            fsync_directory(self.path.parent)\r\n"]
