[75.669086, "i", "cat > reindex/durability.py <<'EOF'\n\"\"\"Small filesystem durability primitives shared by index and checkpoint writes.\"\"\"\nimport os\n\n\ndef fsync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\nEOF\ncat > reindex/checkpoint.py <<'EOF'\n\"\"\"Atomic progress checkpoint and committed shard byte boundaries.\"\"\"\nimport json\nimport logging\nimport os\nimport re\nimport tempfile\nfrom pathlib import Path\n\nfrom reindex.durability import fsync_directory\n\nlog = logging.getLogger(\"reindex.checkpoint\")\n\n\ndef fresh_state():\n    # last_id is exclusive on resume. shards describes only durable bytes.\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False, \"shards\": {}}\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text(encoding=\"utf-8\"))\n        except FileNotFoundError:\n            return fresh_state()\n        except ValueError:\n           "]
[75.672372, "o", "cat > reindex/durability.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Small filesystem durability primitives shared by index and checkpoint writes.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fsync_directory(path):\r\n\u001b[?2004l\r\u001b[?2004h>     fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         os.fsync(fd)\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         os.close(fd)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@0315e396b25f:/app# cat > reindex/checkpoint.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Atomic progress checkpoint and committed shard byte boundaries.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import logging\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from reindex.durability import fsync_directory\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> log = logging.getLo"]
[75.67248, "i", " log.warning(\"checkpoint %s unreadable, starting over\", self.path)\n            return fresh_state()\n        # Old checkpoints may claim buffered rows were committed. They cannot be\n        # safely resumed; rebuild once rather than perpetuating missing rows.\n        if not isinstance(data, dict) or \"shards\" not in data:\n            log.warning(\"checkpoint %s has no durable shard boundaries; rebuilding\", self.path)\n            return fresh_state()\n        if (type(data.get(\"last_id\")) is not int or data[\"last_id\"] < 0\n                or type(data.get(\"docs\")) is not int or data[\"docs\"] < 0\n                or type(data.get(\"complete\")) is not bool\n                or not isinstance(data[\"shards\"], dict)\n                or any(not re.fullmatch(r\"shard-[0-9]+\\.jsonl\", name)\n                       or type(size) is not int or size < 0\n                       for name, size in data[\"shards\"].items())):\n            raise ValueError(\"invalid checkpoint: %s\" % self.path)\n        return data\n\n    def save(self, state):\n  "]
