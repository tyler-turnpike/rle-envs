[12.414065, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir ="]
[12.414144, "o", " Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n "]
[12.414153, "o", "           if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n\"\"\"Reindex progress checkpoint (var/checkpoint.json).\"\"\"\r\nimport json\r\nimport logging\r\nfrom pathlib import Path\r\n\r\nlog = logging.getLogger(\"reindex.checkpoint\")\r\n\r\n\r\ndef fresh_state():\r\n    #"]
[12.414207, "o", " last_id: id of the last document handled; docs: documents indexed so far\r\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False}\r\n\r\n\r\nclass Checkpoint:\r\n    def __init__(self, path):\r\n        self.path = Path(path)\r\n\r\n    def load(self):\r\n        try:\r\n            data = json.loads(self.path.read_text())\r\n        except FileNotFoundError:\r\n            return fresh_state()\r\n        except ValueError:\r\n            log.warning(\"checkpoint %s unreadable, starting over\", self.path)\r\n            return fresh_state()\r\n        state = fresh_state()\r\n        state.update(data)\r\n        return state\r\n\r\n    def save(self, state):\r\n        self.path.parent.mkdir(parents=True, exist_ok=True)\r\n        with open(self.path, \"w\") as fh:\r\n            json.dump(state, fh)\r\n\r\n    def clear(self):\r\n        self.path.unlink(missing_ok=True)\r\n\"\"\"Source corpus: the documents table the search index is built from.\r\n\r\nThe corpus lives in data/docs.db (SQLite).  Ids are increasing but not contiguous\r\n(deleted rows are purged now and t"]
[12.414321, "o", "hen), and soft-deleted rows are skipped.\r\n`generate_corpus` builds the fixture corpus used in dev images and tests.\r\n\"\"\"\r\nimport random\r\nimport sqlite3\r\nfrom collections import namedtuple\r\n\r\nDoc = namedtuple(\"Doc\", \"id title body lang\")\r\n\r\nDEFAULT_SEED = 20240611\r\nDEFAULT_COUNT = 6000\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS docs (\r\n    id INTEGER PRIMARY KEY,\r\n    title TEXT NOT NULL,\r\n    body TEXT NOT NULL,\r\n    lang TEXT NOT NULL,\r\n    deleted INTEGER NOT NULL DEFAULT 0,\r\n    updated_at TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\n_ACCENTED = [\"café\", \"naïve\", \"résumé\", \"über\", \"façade\", \"Ångström\", \"smörgåsbord\",\r\n             \"jalapeño\", \"Zürich\", \"déjà\", \"crème\", \"señor\", \"Straße\", \"coöperate\"]\r\n_STOP = [\"the\", \"of\", \"and\", \"to\", \"in\", \"is\", \"for\", \"with\", \"on\", \"as\", \"by\", \"at\"]\r\n\r\n\r\ndef _vocabulary(rng, size=700):\r\n    onsets = [\"b\", \"c\", \"d\", \"f\", \"g\", \"h\", \"k\", \"l\", \"m\", \"n\", \"p\", \"r\", \"s\", \"t\",\r\n              \"v\", \"w\", \"z\", \"br\", \"ch\", \"cl\", \"dr\", \"gr\", \"pl\", \"qu\", \"sh\", \"st\", \"th\", \"tr\"]\r\n    v"]
[12.414327, "o", "owels = [\"a\", \"e\", \"i\", \"o\", \"u\", \"ai\", \"ea\", \"io\", \"ou\", \"y\"]\r\n    codas = [\"\", \"\", \"n\", \"r\", \"s\", \"t\", \"l\", \"m\", \"ck\", \"nd\", \"st\", \"x\"]\r\n    words = set()\r\n    while len(words) < size:\r\n        syllables = rng.randint(1, 3)\r\n        words.add(\"\".join(rng.choice(onsets) + rng.choice(vowels) + rng.choice(codas)\r\n                          for _ in range(syllables)))\r\n    return sorted(words) + _ACCENTED + _STOP * 6\r\n\r\n\r\ndef generate_corpus(path, count=DEFAULT_COUNT, seed=DEFAULT_SEED):\r\n    \"\"\"Write a deterministic corpus of `count` documents to the SQLite file at `path`.\"\"\"\r\n    rng = random.Random(seed)\r\n    vocab = _vocabulary(rng)\r\n    rows, doc_id = [], 0\r\n    for _ in range(count):\r\n        doc_id += rng.choice((1, 1, 1, 2, 3))\r\n        title = \" \".join(rng.choice(vocab) for _ in range(rng.randint(2, 7))).title()\r\n        sentences = []\r\n        for _ in range(rng.randint(0, 9)):\r\n            words = [rng.choice(vocab) for _ in range(rng.randint(4, 18))]\r\n            if rng.random() < 0.15:\r\n            "]
[12.414332, "o", "    words[0] = words[0].upper()\r\n            sentences.append(\" \".join(words).capitalize() + rng.choice((\".\", \"!\", \"?\", \"...\", \";\")))\r\n        body = \" \".join(sentences)\r\n        lang = rng.choice((\"en\", \"en\", \"en\", \"de\", \"fr\"))\r\n        deleted = 1 if rng.random() < 0.04 else 0\r\n        updated = \"2024-%02d-%02d\" % (rng.randint(1, 12), rng.randint(1, 28))\r\n        rows.append((doc_id, title, body, lang, deleted, updated))\r\n    conn = sqlite3.connect(path)\r\n    with conn:\r\n        conn.executescript(SCHEMA)\r\n        conn.execute(\"DELETE FROM docs\")\r\n        conn.executemany(\"INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)\", rows)\r\n    conn.close()\r\n    return len(rows)\r\n\r\n\r\nclass Source:\r\n    \"\"\"Read-only access to the live (not soft-deleted) documents, in id order.\"\"\"\r\n\r\n    def __init__(self, path):\r\n        self.conn = sqlite3.connect(\"file:%s?mode=ro\" % path, uri=True)\r\n\r\n    def count(self):\r\n        return self.conn.execute(\"SELECT COUNT(*) FROM docs WHERE deleted = 0\").fetchone()[0]\r\n\r\n    def batches(self,"]
[12.414337, "o", " start_id=0, size=25):\r\n        \"\"\"Yield lists of Docs with id >= start_id, `size` at a time, in id order.\"\"\"\r\n        next_id = start_id\r\n        while True:\r\n            rows = self.conn.execute(\r\n                \"SELECT id, title, body, lang FROM docs WHERE deleted = 0 AND id >= ? \"\r\n                \"ORDER BY id LIMIT ?\", (next_id, size)).fetchall()\r\n            if not rows:\r\n                return\r\n            yield [Doc(*row) for row in rows]\r\n            next_id = rows[-1][0] + 1\r\n\r\n    def close(self):\r\n        self.conn.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    import sys\r\n    out = sys.argv[1] if len(sys.argv) > 1 else \"data/docs.db\"\r\n    print(\"wrote %d docs to %s\" % (generate_corpus(out), out))\r\n\u001b[?2004hroot@0315e396b25f:/app# "]
