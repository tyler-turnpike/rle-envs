[103.963882, "i", "= self.root / \"docs.db\"\n        self.index = self.root / \"index\"\n        self.ckpt = Checkpoint(self.root / \"checkpoint.json\")\n        make_source(self.db)\n        self.args = parse_args([\"--source\", str(self.db), \"--index-dir\", str(self.index),\n                                \"--checkpoint\", str(self.ckpt.path), \"--batch-size\", \"2\"])\n        source = Source(self.db)\n        self.docs = [doc for batch in source.batches(size=2) for doc in batch]\n        source.close()\n        self.expected = [transform_doc(doc) for doc in self.docs]\n\n    def assert_complete(self):\n        self.assertEqual(list(iter_rows(self.index)), self.expected)\n        state = self.ckpt.load()\n        self.assertTrue(state[\"complete\"])\n        self.assertEqual(state[\"docs\"], len(self.expected))\n        self.assertEqual(state[\"last_id\"], self.docs[-1].id)\n        self.assertEqual(state[\"shards\"], {p.name: p.stat().st_size\n                                          for p in shard_paths(self.index)})\n\n    def test_exclusive_cursor_with_gaps_an"]
