[12.677526, "o", "def _raise_interrupted(signum, frame):\r\n"]
[12.677591, "o", "    raise _Interrupted(signal.Signals(signum).name)\r\n\r\n\r\ndef load_limits(job):\r\n    limits = json.loads(LIMITS_FILE.read_text())[\"jobs\"][job]\r\n    return float(limits[\"budget_seconds\"]), float(limits[\"grace_seconds\"])\r\n"]
[12.67773, "o", "\r\n\r\ndef _signal_group(pgid, sig):\r\n    try:\r\n        os.killpg(pgid, sig)\r\n        return True\r\n    except ProcessLookupError:\r\n        return False\r\n"]
