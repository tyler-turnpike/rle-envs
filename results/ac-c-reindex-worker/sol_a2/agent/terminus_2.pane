import json
from reindex.source import Source
from reindex.transform import transform_doc
source = Source('data/docs.db')
count = 0
with open('/tmp/search-412-expected.jsonl', 'w') as fh:
    for batch in source.batches(size=100):
        for doc in batch:
            fh.write(json.dumps(transform_doc(doc), sort_keys=True) + '\n')
            count += 1
source.close()
print('Expected rows generated:', count, flush=True)
PY

