[83.408232, "i", " inconsistent durable frontier is an error.\n    \"\"\"\n    index_dir = Path(index_dir)\n    index_dir.mkdir(parents=True, exist_ok=True)\n    for name, size in shards.items():\n        if (Path(name).name != name or not name.startswith(\"shard-\")\n                or not name.endswith(\".jsonl\") or not isinstance(size, int) or size < 0):\n            raise ValueError(\"invalid shard frontier\")\n        path = index_dir / name\n        if not path.exists() or path.stat().st_size < size:\n            raise ValueError(\"committed shard missing or short: %s\" % path)\n    for path in shard_paths(index_dir):\n        if path.name not in shards:\n            path.unlink()\n        elif path.stat().st_size != shards[path.name]:\n            with open(path, \"r+b\") as fh:\n                fh.truncate(shards[path.name])\n                fh.flush()\n                os.fsync(fh.fileno())\n    fsync_dir(index_dir)\n\n\nclass ShardWriter:\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\n        if shard_rows <= 0 or b"]
