[113.136847, "i", "mkdir -p var; (while :; do ./jobs reindex; rc=$?; if [ \"$rc\" -eq 0 ]; then break; elif [ \"$rc\" -ne 75 ]; then echo \"REINDEX FAILED rc=$rc\"; exit \"$rc\"; fi; done) >var/reindex-build.log 2>&1 & echo \"build loop pid=$!\"\n"]
