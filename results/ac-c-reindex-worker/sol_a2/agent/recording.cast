[83.417615, "o", "> "]
[83.417704, "o", "            for line in fh:\r\n\u001b[?2004l\r"]
[83.417738, "o", "\u001b[?2004h> "]
[83.417864, "o", "                if line.strip():\r\n\u001b[?2004l\r"]
[83.417879, "o", "\u001b[?2004h> "]
[83.418024, "o", "                    yield json.loads(line)\r\n\u001b[?2004l\r"]
[83.418043, "o", "\u001b[?2004h> "]
[83.418114, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.418211, "o", "def recover(index_dir, shards):\r\n\u001b[?2004l\r"]
[83.418258, "o", "\u001b[?2004h> "]
[83.418439, "o", "    \"\"\"Roll back uncommitted appends, including partial JSON and new shards.\r\n\u001b[?2004l\r"]
[83.418476, "o", "\u001b[?2004h> "]
[83.418534, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.418785, "o", "    This is idempotent even if recovery itself is interrupted. Never silently\r\n\u001b[?2004l\r"]
[83.418841, "o", "\u001b[?2004h> "]
[83.422604, "o", "    skip missing committed data: an inconsistent durable frontier is an error.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     index_dir = Path(index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     index_dir.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>     for name, size in shards.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if (Path(name).name != name or not name.startswith(\"shard-\")\r\n\u001b[?2004l\r\u001b[?2004h>                 or not name.endswith(\".jsonl\") or not isinstance(size, int) or size < 0):\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(\"invalid shard frontier\")\r\n\u001b[?2004l\r\u001b[?2004h>         path = index_dir / name\r\n\u001b[?2004l\r\u001b[?2004h>         if not path.exists() or path.stat().st_size < size:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(\"committed shard missing or short: %s\" % path)\r\n\u001b[?2004l\r\u001b[?2004h>     for path in shard_paths(index_dir):\r\n\u001b[?2004l\r\u001b[?2004h>         if path.name not in shards:\r\n\u001b[?2004l\r\u001b[?2004h>             path.unlink()\r\n\u001b[?2004l\r\u001b[?2004h>         elif path.stat().st_size != shards[path.name]:"]
[83.422613, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             with open(path, \"r+b\") as fh:\r\n\u001b[?2004l\r\u001b[?2004h>                 fh.truncate(shards[path.name])\r\n\u001b[?2004l\r\u001b[?2004h>                 fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h>                 os.fsync(fh.fileno())\r\n\u001b[?2004l\r\u001b[?2004h>     fsync_dir(index_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ShardWriter:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n\u001b[?2004l\r\u001b[?2004h>         if shard_rows <= 0 or buffer_rows <= 0:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(\"shard and buffer sizes must be positive\")\r\n\u001b[?2004l\r\u001b[?2004h>         self.index_dir = Path(index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>         self.index_dir.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>         # Persist creation of the index directory before publishing a checkpoint.\r\n\u001b[?2004l\r\u001b[?2004h>         fsync_dir(self.index_dir.parent)\r\n\u001b[?2004l\r\u001b[?2004h>         self.shard_rows = shard_rows\r\n\u001b[?2004l\r\u001b[?2004h>         self.buffer_r"]
[83.422617, "o", "ows = buffer_rows\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer = []\r\n\u001b[?2004l\r\u001b[?2004h>         self._fh = None\r\n\u001b[?2004l\r\u001b[?2004h>         self._rows_in_shard = 0\r\n\u001b[?2004l\r\u001b[?2004h>         self._next_shard = self._first_free_shard()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _first_free_shard(self):\r\n\u001b[?2004l\r\u001b[?2004h>         numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n\u001b[?2004l\r\u001b[?2004h>         return max(numbers) + 1 if numbers else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @property\r\n\u001b[?2004l\r\u001b[?2004h>     def pending(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return len(self._buffer)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def reset(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.abort()\r\n\u001b[?2004l\r\u001b[?2004h>         recover(self.index_dir, {})\r\n\u001b[?2004l\r\u001b[?2004h>         self._next_shard = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def add(self, row):\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.append(row)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(self._buffer) >= self.buffer_r"]
[83.422621, "o", "ows:\r\n\u001b[?2004l\r\u001b[?2004h>             self.flush()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _sync_shard(self):\r\n\u001b[?2004l\r\u001b[?2004h>         if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h>             os.fsync(self._fh.fileno())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def flush(self):\r\n\u001b[?2004l\r\u001b[?2004h>         if not self._buffer:\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>         for row in self._buffer:\r\n\u001b[?2004l\r\u001b[?2004h>             if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n\u001b[?2004l\r\u001b[?2004h>                 self._rotate()\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n\u001b[?2004l\r\u001b[?2004h>                                       ensure_ascii=False) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>             self._rows_in_shard += 1\r\n\u001b[?2004l\r\u001b[?2004h>         self._sync_shard()\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.clear()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fron"]
[83.422663, "o", "tier(self):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Make all rows durable before returning lengths for checkpointing.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         self.flush()\r\n\u001b[?2004l\r\u001b[?2004h>         fsync_dir(self.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>         return {path.name: path.stat().st_size for path in shard_paths(self.index_dir)}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _rotate(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self._close_shard()\r\n\u001b[?2004l\r\u001b[?2004h>         path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n\u001b[?2004l\r\u001b[?2004h>         self._fh = open(path, \"x\", encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h>         self._next_shard += 1\r\n\u001b[?2004l\r\u001b[?2004h>         self._rows_in_shard = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _close_shard(self):\r\n\u001b[?2004l\r\u001b[?2004h>         if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.422832, "o", "            self._sync_shard()\r\n\u001b[?2004l\r"]
[83.42285, "o", "\u001b[?2004h> "]
[83.422946, "o", "            self._fh.close()\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.422991, "o", "> \r\n\u001b[?2004l\r"]
[83.423021, "o", "\u001b[?2004h> "]
[83.423063, "o", "    def close(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.423095, "o", "> "]
[83.423119, "o", "        self.flush()\r\n\u001b[?2004l\r"]
[83.423134, "o", "\u001b[?2004h"]
[83.42315, "o", "> "]
[83.423229, "o", "        self._close_shard()\r\n\u001b[?2004l\r"]
[83.423254, "o", "\u001b[?2004h> "]
[83.423751, "o", "        fsync_dir(self.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def abort(self):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Discard RAM rows after a failure; recovery owns any on-disk tail.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.clear()\r\n\u001b[?2004l\r\u001b[?2004h>         if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.close()\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh = None\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[83.425047, "o", "\u001b[?2004hroot@cae0bcceaac3:/app# "]
[83.425164, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.425265, "o", "p='reindex/worker.py'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.42555, "o", "s=open(p).read().replace('`make reindex`', '`./jobs reindex`').replace('import logging\\n', 'import logging\\nimport signal\\n').replace('from reindex.store import ShardWriter, iter_rows', 'from reindex.store import ShardWriter, iter_rows, recover')\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.425596, "o", "> "]
[83.425661, "o", "a=s.index('def run(args):')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.425739, "o", "b=s.index('\\n\\ndef main(',a)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.425795, "o", "> "]
[83.425841, "o", "s=s[:a]+'''def run(args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.425873, "o", "    if args.batch_size <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.426015, "o", "        raise ValueError(\"batch size must be positive\")\r\n\u001b[?2004l\r\u001b[?2004h>     stopping = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.426106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.426166, "o", "    def request_stop(signum, frame):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.42627, "o", "        # Never raise asynchronously in a write/rename. SIGKILL is safe too:\r\n\u001b[?2004l\r"]
[83.426335, "o", "\u001b[?2004h> "]
[83.426412, "o", "        # the previous checkpoint owns the durable prefix until the next save.\r\n\u001b[?2004l\r"]
[83.426479, "o", "\u001b[?2004h> "]
[83.426599, "o", "        nonlocal stopping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.427464, "o", "        stopping = True\r\n\u001b[?2004l\r"]
[83.427543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.427669, "o", "    handlers = {sig: signal.signal(sig, request_stop)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.42771, "o", "> "]
[83.427817, "o", "                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.427845, "o", "> "]
[83.427945, "o", "    source = store = None\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.428023, "o", "        ckpt = Checkpoint(args.checkpoint)\r\n\u001b[?2004l\r"]
[83.428036, "o", "\u001b[?2004h> "]
[83.428102, "o", "        state = ckpt.load()\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.428148, "o", "> "]
[83.428231, "o", "        recover(args.index_dir, state[\"shards\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.428305, "o", "> "]
[83.428361, "o", "        if state[\"complete\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.42845, "o", "            log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.428546, "o", "            return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.4287, "o", "        source = Source(args.source)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.428793, "o", "        store = ShardWriter(args.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.428879, "o", "        total = source.count()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.428944, "o", "        started = time.monotonic()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429015, "o", "        initial_docs = state[\"docs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429102, "o", "        log.info(\"starting after id %d (%d/%d docs done)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429166, "o", "                 state[\"last_id\"], state[\"docs\"], total)\r\n\u001b[?2004l\r"]
[83.429259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429325, "o", "        def commit():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429406, "o", "            state[\"shards\"] = store.frontier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.429492, "o", "            ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.429585, "o", "\u001b[?2004h> "]
[83.429653, "o", "        # Source's lower bound is inclusive; checkpoint last_id is already done.\r\n\u001b[?2004l\r"]
[83.429708, "o", "\u001b[?2004h> "]
[83.429827, "o", "        start_id = state[\"last_id\"] + 1 if state[\"docs\"] else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.429901, "o", "> "]
[83.429967, "o", "        for batch in source.batches(start_id=start_id, size=args.batch_size):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430037, "o", "            for doc in batch:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430115, "o", "                if stopping:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430216, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430306, "o", "                store.add(transform_doc(doc))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430395, "o", "                state[\"last_id\"] = doc.id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430484, "o", "                state[\"docs\"] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430754, "o", "                # Preserve block-sized I/O in normal runs, not one fsync per doc.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.430842, "o", "                if store.pending == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.430892, "o", "> "]
[83.432422, "o", "                    commit()\r\n\u001b[?2004l\r\u001b[?2004h>                     rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\r\n\u001b[?2004l\r\u001b[?2004h>                     log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n\u001b[?2004l\r\u001b[?2004h>                              state[\"last_id\"], state[\"docs\"], total, rate)\r\n\u001b[?2004l\r\u001b[?2004h>             if stopping:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             if not stopping:\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"complete\"] = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         commit()  # Includes a partial block on SIGTERM or end of input.\r\n\u001b[?2004l\r\u001b[?2004h>         store.close()\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"reindex %s: %d docs\", \"complete\" if state[\"complete\"] else \"paused\",\r\n\u001b[?2004l\r\u001b[?2004h>                  state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>         return 0 if state[\"complete\"] else 75\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         if store is not None"]
[83.432445, "o", ":\r\n\u001b[?2004l\r\u001b[?2004h>             store.abort()\r\n\u001b[?2004l\r\u001b[?2004h>         if source is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             source.close()\r\n\u001b[?2004l\r\u001b[?2004h>         for sig, handler in handlers.items():\r\n\u001b[?2004l\r\u001b[?2004h>             signal.signal(sig, handler)\r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[83.442098, "o", "\u001b[?2004hroot@cae0bcceaac3:/app# ./jobs test\r\n\u001b[?2004l\r"]
[83.492173, "o", "test_stop_and_resume_gives_complete_index (test_reindex.ResumeTest.test_stop_and_resume_gives_complete_index) ... "]
[88.709822, "o", "ok\r\n"]
[88.710067, "o", "test_rows_round_trip_across_shards (test_reindex.StoreTest.test_rows_round_trip_across_shards) ... "]
[88.716076, "o", "ok\r\n"]
[88.716146, "o", "test_empty_body (test_reindex.TransformTest.test_empty_body) ... "]
[88.71649, "o", "ok\r\n"]
[88.716559, "o", "test_golden_row (test_reindex.TransformTest.test_golden_row) ... "]
[88.717885, "o", "ok\r\n"]
[88.717939, "o", "\r\n----------------------------------------------------------------------\r\nRan 4 tests in 5.226s\r\n\r\nOK\r\n"]
