[310.073275, "i", "cat >/tmp/search-412-audit.py <<'PY'\nimport hashlib\nimport json\nimport time\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.store import iter_rows\n\nexpected = [json.loads(line) for line in open('/tmp/search-412-expected.jsonl')]\nprevious = -1\nwhile True:\n    state = Checkpoint('var/checkpoint.json').load()\n    if state['docs'] != previous or state['complete']:\n        rows = list(iter_rows('var/index', state['shards']))\n        assert state['docs'] >= previous, 'progress regressed'\n        assert len(rows) == state['docs'], 'checkpoint count mismatch'\n        assert rows == expected[:state['docs']], 'row content or source order mismatch'\n        assert len({row['id'] for row in rows}) == len(rows), 'duplicate IDs'\n        if rows:\n            assert rows[-1]['id'] == state['last_id'], 'last_id mismatch'\n        print('Verified committed prefix:', state['docs'], 'complete:', state['complete'], flush=True)\n        previous = state['docs']\n        if state['complete']:\n           "]
[310.074658, "i", " assert rows == expected, 'incomplete final index'\n            assert list(iter_rows('var/index')) == expected, 'unexpected uncommitted final rows'\n            report = {'complete': True, 'source_live_docs': len(expected), 'index_rows': len(rows),\n                      'unique_ids': len({row['id'] for row in rows}),\n                      'all_row_fields_match': True,\n                      'shard_sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()\n                                       for p in sorted(Path('var/index').glob('shard-*.jsonl'))}}\n            Path('var/index-verification.json').write_text(json.dumps(report, indent=2) + '\\n')\n            print('Final verification passed', flush=True)\n            break\n    time.sleep(1)\nPY\nPYTHONPATH=/app python3 /tmp/search-412-audit.py >var/index-audit.log 2>&1 & echo \"audit pid=$!\"\n"]
