[113.263028, "i", ".db), '--index-dir', str(self.index),\n                                  '--checkpoint', str(self.ckpt.path),\n                                  '--batch-size', str(batch_size)])\n\n    def expected(self):\n        source = Source(self.db)\n        try:\n            return [transform_doc(doc) for batch in source.batches(size=11) for doc in batch]\n        finally:\n            source.close()\n\n    def assert_complete(self):\n        expected = self.expected()\n        self.assertEqual(list(iter_rows(self.index)), expected)\n        state = self.ckpt.load()\n        self.assertTrue(state['complete'])\n        self.assertEqual(state['docs'], len(expected))\n        self.assertEqual(state['last_id'], expected[-1]['id'] if expected else 0)\n        self.assertEqual(state['shards'],\n                         {p.name: p.stat().st_size for p in shard_paths(self.index)})\n\n    def test_checkpoint_replace_failure_keeps_old_commit(self):\n        state = fresh_state()\n        self.ckpt.save(state)\n        new_state = dict(state, docs=20, "]
[113.263052, "i", "last_id=42)\n        with patch('reindex.checkpoint.os.replace', side_effect=OSError('interrupted')):\n            with self.assertRaises(OSError):\n                self.ckpt.save(new_state)\n        self.assertEqual(self.ckpt.load(), state)\n        self.ckpt.save(new_state)\n        self.assertEqual(self.ckpt.load(), new_state)\n        self.assertEqual(list(self.root.glob('*.tmp')), [])\n\n    def test_recovery_removes_partial_tail_and_rotated_shards(self):\n        writer = ShardWriter(self.index, shard_rows=3, buffer_rows=2)\n        for i in range(5):\n            writer.add({'id': i, 'slug': 'café'})\n        frontier = writer.frontier()\n        for i in range(5, 12):\n            writer.add({'id': i})\n        writer.close()\n        with open(shard_paths(self.index)[-1], 'ab') as fh:\n            fh.write(b'{\"id\":')\n        recover(self.index, frontier)\n        recover(self.index, frontier)  # Recovery is itself restartable.\n        self.assertEqual([r['id'] for r in iter_rows(self.index)], list(range(5)))\n        s"]
[113.26306, "i", "elf.assertEqual({p.name: p.stat().st_size for p in shard_paths(self.index)}, frontier)\n        shard_paths(self.index)[0].unlink()\n        with self.assertRaisesRegex(ValueError, 'missing or short'):\n            recover(self.index, frontier)\n\n    def test_sigkill_after_data_before_checkpoint(self):\n        generate_corpus(self.db, count=45, seed=8)\n        # Several rotations per block; the second block reaches disk but its\n        # checkpoint does not. Kill cannot be mistaken for graceful shutdown.\n        script = '''\nimport os, signal, sys\nfrom functools import partial\nfrom reindex import worker\nfrom reindex.store import ShardWriter\nfrom reindex.checkpoint import Checkpoint\nworker.ShardWriter = partial(ShardWriter, shard_rows=7, buffer_rows=10)\noriginal = Checkpoint.save\ndef crash(self, state):\n    if state['docs'] >= 20:\n        os.kill(os.getpid(), signal.SIGKILL)\n    original(self, state)\nCheckpoint.save = crash\nworker.main(sys.argv[1:])\n'''\n        args = ['--source', str(self.db), '--index-dir', str("]
[113.263066, "i", "self.index),\n                '--checkpoint', str(self.ckpt.path), '--batch-size', '3']\n        result = subprocess.run([sys.executable, '-c', script, *args], cwd=ROOT,\n                                stderr=subprocess.DEVNULL, timeout=30)\n        self.assertEqual(result.returncode, -signal.SIGKILL)\n        state = self.ckpt.load()\n        self.assertEqual(state['docs'], 10)\n        self.assertEqual(list(iter_rows(self.index))[:10], self.expected()[:10])\n        # Also exercise a torn write in an uncommitted new shard.\n        with open(shard_paths(self.index)[-1], 'ab') as fh:\n            fh.write(b'{\"id\":')\n        self.assertEqual(worker.run(self.args(batch_size=13)), 0)\n        self.assert_complete()\n        before = {p.name: p.read_bytes() for p in shard_paths(self.index)}\n        self.assertEqual(worker.run(self.args()), 0)\n        self.assertEqual(before, {p.name: p.read_bytes() for p in shard_paths(self.index)})\n\n    def test_repeated_sigterm_commits_partial_blocks(self):\n        generate_corpus(self.d"]
[113.263082, "i", "b, count=35, seed=12)\n        previous = 0\n        for _ in range(3):\n            calls = 0\n\n            def stop_during_transform(doc):\n                nonlocal calls\n                calls += 1\n                if calls == 4:\n                    os.kill(os.getpid(), signal.SIGTERM)\n                return transform_doc(doc)\n\n            with patch.object(worker, 'transform_doc', stop_during_transform):\n                self.assertEqual(worker.run(self.args(batch_size=3)), 75)\n            state = self.ckpt.load()\n            self.assertEqual(state['docs'], previous + 4)\n            self.assertEqual(list(iter_rows(self.index)), self.expected()[:state['docs']])\n            previous = state['docs']\n        self.assertEqual(worker.run(self.args()), 0)\n        self.assert_complete()\n\n    def test_failure_after_checkpoint_replace_resumes_new_commit(self):\n        generate_corpus(self.db, count=24, seed=3)\n        original = Checkpoint.save\n\n        def save_then_fail(ckpt, state):\n            original(ckpt, state)\n   "]
[113.263101, "i", "         raise OSError('crash after checkpoint rename')\n\n        with patch.object(worker, 'ShardWriter', partial(ShardWriter, buffer_rows=5)), \\\n                patch.object(Checkpoint, 'save', save_then_fail):\n            with self.assertRaises(OSError):\n                worker.run(self.args())\n        self.assertEqual(self.ckpt.load()['docs'], 5)\n        self.assertEqual(worker.run(self.args()), 0)\n        self.assert_complete()\n\n    def test_legacy_checkpoint_rebuilds_once(self):\n        generate_corpus(self.db, count=12, seed=1)\n        self.index.mkdir()\n        (self.index / 'shard-00000.jsonl').write_text('{\"id\":999}\\n{\"id\":999}\\n')\n        self.ckpt.path.write_text(json.dumps({'last_id': 999, 'docs': 2, 'complete': True}))\n        self.assertEqual(worker.run(self.args()), 0)\n        self.assert_complete()\n\n    def test_empty_source(self):\n        generate_corpus(self.db, count=0)\n        self.assertEqual(worker.run(self.args()), 0)\n        self.assert_complete()\n\n\nif __name__ == '__main__':\n    unitte"]
