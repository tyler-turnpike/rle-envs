        os.fsync(self._fh.fileno())
        # Persist new shard names as well as their contents before allowing
        # a checkpoint to refer to them.
        sync_directory(self.index_dir)
        self._buffer.clear()

    def _rotate(self):
        self._close_shard()
        path = self.index_dir / ("shard-%05d.jsonl" % self._next_shard)
        self._fh = open(path, "a", encoding="utf-8")
        self._next_shard += 1
        self._rows_in_shard = 0

    def _close_shard(self):
        if self._fh is not None:
            # Rotation can occur inside flush(); every closed shard must be
            # durable, not only the final shard in that flush.
            self._fh.flush()
            os.fsync(self._fh.fileno())
            self._fh.close()
            self._fh = None

    def close(self):
        self.flush()
        self._close_shard()

    def abort(self):
        """Release resources without publishing or flushing buffered work."""
        self._buffer.clear()
        self._close_shard()
