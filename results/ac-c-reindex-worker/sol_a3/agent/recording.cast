[218.935673, "o", "        self.docs.insert(0, doc)\r\n        self.assert_complete()\r\n\r\n    def test_sigkill_after_durable_prefix_resumes(self):\r\n        # Slow only the child transform so the parent can kill between commits.\r\n        script = \"\"\"\r\nimport sys, time\r\nfrom reindex import worker\r\noriginal = worker.transform_doc\r\ndef slow(doc):\r\n    row = original(doc)\r\n    time.sleep(0.06)\r\n    return row\r\nworker.transform_doc = slow\r\nworker.main(sys.argv[1:])\r\n\"\"\"\r\n        argv = [sys.executable, \"-c\", script, \"--source\", str(self.db),\r\n                \"--index-dir\", str(self.index), \"--checkpoint\", str(self.checkpoint),\r\n                \"--batch-size\", \"2\"]\r\n        proc = subprocess.Popen(argv, stderr=subprocess.DEVNULL)\r\n        try:\r\n"]
[218.936777, "o", "            deadline = time.monotonic() + 10\r\n            while time.monotonic() < deadline:\r\n                if Checkpoint(self.checkpoint).load()[\"docs\"] >= 2:\r\n                    break\r\n                time.sleep(0.01)\r\n            else:\r\n                self.fail(\"child did not commit progress\")\r\n            proc.kill()\r\n"]
[218.937082, "o", "            proc.wait(timeout=5)\r\n        finally:\r\n            if proc.poll() is None:\r\n                proc.kill()\r\n                proc.wait(timeout=5)\r\n        state = Checkpoint(self.checkpoint).load()\r\n        self.assertGreaterEqual(state[\"docs\"], 2)\r\n        self.assertFalse(state[\"complete\"])\r\n        self.assert_complete()\r\n\r\n    def test_supervisor_budget_stops_and_resumes(self):\r\n        script = \"\"\"\r\nimport sys, time\r\nfrom reindex import worker\r\noriginal = worker.transform_doc\r\ndef slow(doc):\r\n    row = original(doc)\r\n    time.sleep(0.06)\r\n    return row\r\nworker.transform_doc = slow\r\nsys.exit(worker.main(sys.argv[1:]))\r\n\"\"\"\r\n        command = [sys.executable, \"-c\", script, \"--source\", str(self.db),\r\n                   \"--index-dir\", str(self.index), \"--checkpoint\", str(self.checkpoint),\r\n                   \"--batch-size\", \"2\"]\r\n        handlers = {sig: signal.getsignal(sig) for sig in (signal.SIGTERM, signal.SIGHUP)}\r\n        for sig, handler in handlers.items():\r\n            self.addCleanup(sign"]
[218.937175, "o", "al.signal, sig, handler)\r\n        with patch.object(supervise, \"JOBS\", {\"reindex\": command}), \\\r\n             patch.object(supervise, \"RUN_DIR\", self.root / \"run\"), \\\r\n             patch.object(supervise, \"LOG_FILE\", self.root / \"runs.jsonl\"), \\\r\n             patch.object(supervise, \"load_limits\", return_value=(0.25, 2, 0)):\r\n            self.assertEqual(supervise.run(\"reindex\"), 75)\r\n        state = Checkpoint(self.checkpoint).load()\r\n        self.assertGreater(state[\"docs\"], 0)\r\n        self.assertFalse(state[\"complete\"])\r\n        self.assertEqual(len(list(iter_rows(self.index))), state[\"docs\"])\r\n        self.assert_complete()\r\n\r\n    def test_empty_source(self):\r\n        with sqlite3.connect(self.db) as conn:\r\n            conn.execute(\"DELETE FROM docs\")\r\n        self.docs = []\r\n        self.assertEqual(run(self.args), 0)\r\n        self.assertEqual(list(iter_rows(self.index)), [])\r\n        self.assertEqual(Checkpoint(self.checkpoint).load()[\"docs\"], 0)\r\n        self.assertTrue(Checkpoint(self.checkpoint).loa"]
[218.937189, "o", "d()[\"complete\"])\r\n\r\n    def test_atomic_checkpoint_failure_leaves_old_checkpoint(self):\r\n        ckpt = Checkpoint(self.checkpoint)\r\n        old = {\"last_id\": 1, \"docs\": 1, \"complete\": False, \"shards\": {}}\r\n        ckpt.save(old)\r\n        with patch(\"reindex.checkpoint.os.replace\", side_effect=OSError(\"crash\")):\r\n            with self.assertRaises(OSError):\r\n                ckpt.save(dict(old, last_id=4, docs=2))\r\n        self.assertEqual(ckpt.load(), old)\r\n        self.assertEqual(list(self.root.glob(\"*.tmp\")), [])\r\n\r\n    def test_rotation_and_recovery_across_buffer_boundaries(self):\r\n        writer = ShardWriter(self.index, shard_rows=2, buffer_rows=3)\r\n        for i in range(5):\r\n            writer.add({\"id\": i, \"text\": \"Café\"})\r\n        offsets = writer.committed_offsets()\r\n        self.assertEqual(len(offsets), 3)\r\n        for i in range(5, 11):\r\n            writer.add({\"id\": i})\r\n        writer.close()\r\n        with open(shard_paths(self.index)[-1], \"ab\") as fh:\r\n            fh.write(b'{')\r\n        wri"]
[218.937197, "o", "ter = ShardWriter(self.index, shard_rows=2, buffer_rows=3)\r\n        writer.recover(offsets)\r\n        writer.recover(offsets)  # Recovery itself is restartable.\r\n        self.assertEqual([r[\"id\"] for r in iter_rows(self.index)], list(range(5)))\r\n        writer.add({\"id\": 5})\r\n        writer.close()\r\n        self.assertEqual([r[\"id\"] for r in iter_rows(self.index)], list(range(6)))\r\n\r\n"]
