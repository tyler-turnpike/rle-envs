[218.765074, "i", "cat > /tmp/verify-reindex.py <<'EOF'\nimport json\nimport sys\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\nsys.path.insert(0, '/app')\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\n\ndef main():\n    source = Source('/app/data/docs.db')\n    docs = [doc for batch in source.batches(0, 200) for doc in batch]\n    source.close()\n    with ProcessPoolExecutor(max_workers=3) as pool:\n        rows = list(pool.map(transform_doc, docs, chunksize=20))\n    Path('/tmp/expected-index.json').write_text(json.dumps(rows, ensure_ascii=False))\n    print('Computed exact expected rows for %d live documents' % len(rows), flush=True)\n\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /tmp/verify-reindex.py > /tmp/verify-reindex.log 2>&1 & echo \"expected-row verifier pid=$!\"\n"]
