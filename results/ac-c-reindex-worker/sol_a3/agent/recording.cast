[70.004707, "i", "cat > reindex/durable.py <<'EOF'\n\"\"\"Filesystem durability helpers shared by checkpoint and shard commits.\"\"\"\nimport os\n\n\ndef sync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\nEOF\npython3 - <<'PY'\np='reindex/checkpoint.py'\ns=open(p).read().replace('import logging\\n', 'import logging\\nimport os\\nimport tempfile\\n')\ns=s.replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.durable import sync_directory\\n')\ns=s.replace('        with open(self.path, \"w\") as fh:\\n            json.dump(state, fh)\\n', '''        # A crash leaves either the old checkpoint or the new one, never half JSON.\n        fd, temporary = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                         dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh)\n                fh.flush()\n                os.fsync(fh.fileno())"]
[70.004764, "i", "\n            os.replace(temporary, self.path)\n            sync_directory(self.path.parent)\n        finally:\n            Path(temporary).unlink(missing_ok=True)\n''')\nopen(p,'w').write(s)\np='reindex/store.py'\ns=open(p).read().replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.durable import sync_directory\\n')\ns=s.replace('        self._next_shard = 0\\n\\n    def add', '''        self._buffer.clear()\n        self._rows_in_shard = 0\n        self._next_shard = 0\n        sync_directory(self.index_dir)\n\n    def recover(self, offsets):\n        \"\"\"Roll back everything not named by the last atomic checkpoint.\n\n        Validate before modifying anything: missing committed bytes are an error,\n        not a reason to advance or silently discard a checkpoint.\n        \"\"\"\n        paths = {p.name: p for p in shard_paths(self.index_dir)}\n        for name, offset in offsets.items():\n            if name not in paths or not isinstance(offset, int) or offset < 0:\n                raise ValueError(\"inval"]
[70.004785, "i", "id or missing committed shard: %s\" % name)\n            if paths[name].stat().st_size < offset:\n                raise ValueError(\"committed shard is too short: %s\" % name)\n        self._buffer.clear()\n        self._close_shard()\n        for name, path in paths.items():\n            if name not in offsets:\n                path.unlink()\n            elif path.stat().st_size != offsets[name]:\n                with open(path, \"r+b\") as fh:\n                    fh.truncate(offsets[name])\n                    fh.flush()\n                    os.fsync(fh.fileno())\n        sync_directory(self.index_dir)\n        self._next_shard = self._first_free_shard()\n        self._rows_in_shard = 0\n\n    def committed_offsets(self):\n        \"\"\"Flush all rows before returning the durable byte positions to publish.\"\"\"\n        self.flush()\n        sync_directory(self.index_dir)\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\n\n    def add''')\ns=s.replace('        if self._fh is not None:\\n            self._fh.cl"]
[70.004894, "i", "ose()', '        if self._fh is not None:\\n            self._fh.flush()\\n            os.fsync(self._fh.fileno())\\n            self._fh.close()')\ns += '''\n    def abort(self):\n        \"\"\"Release resources without promoting buffered rows to committed work.\"\"\"\n        self._buffer.clear()\n        self._close_shard()\n'''\nopen(p,'w').write(s)\nPY\n"]
