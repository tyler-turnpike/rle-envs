[144.210521, "i", "python3 - <<'PY'\np='tests/test_durability.py'\ns=open(p).read().replace('import signal\\n', 'import signal\\nimport subprocess\\nimport sys\\nimport time\\n')\npos=s.index('    def test_empty_source(self):')\ns=s[:pos]+'''    def test_sigkill_after_durable_prefix_resumes(self):\n        # Slow only the child transform so the parent can kill between commits.\n        script = \"\"\"\nimport sys, time\nfrom reindex import worker\noriginal = worker.transform_doc\ndef slow(doc):\n    row = original(doc)\n    time.sleep(0.06)\n    return row\nworker.transform_doc = slow\nworker.main(sys.argv[1:])\n\"\"\"\n        argv = [sys.executable, \"-c\", script, \"--source\", str(self.db),\n                \"--index-dir\", str(self.index), \"--checkpoint\", str(self.checkpoint),\n                \"--batch-size\", \"2\"]\n        proc = subprocess.Popen(argv, stderr=subprocess.DEVNULL)\n        try:\n            deadline = time.monotonic() + 10\n            while time.monotonic() < deadline:\n                if Checkpoint(self.checkpoint).load()[\"docs\"] >= 2:\n          "]
[144.210744, "i", "          break\n                time.sleep(0.01)\n            else:\n                self.fail(\"child did not commit progress\")\n            proc.kill()\n            proc.wait(timeout=5)\n        finally:\n            if proc.poll() is None:\n                proc.kill()\n                proc.wait(timeout=5)\n        state = Checkpoint(self.checkpoint).load()\n        self.assertGreaterEqual(state[\"docs\"], 2)\n        self.assertFalse(state[\"complete\"])\n        self.assert_complete()\n\n'''+s[pos:]\nopen(p,'w').write(s)\nPY\n./jobs test > /tmp/reindex-tests.log 2>&1 & echo \"tests pid=$!\"\n"]
