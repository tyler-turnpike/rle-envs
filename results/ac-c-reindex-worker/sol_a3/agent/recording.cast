[123.617666, "o", "\u001b[?2004h> \"\"\"Crash-window and resume regressions; keep transforms identical to production.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import signal\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> import unittest\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import SCHEMA, Doc\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.store import ShardWriter, iter_rows, shard_paths\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.transform import transform_doc\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.worker import parse_args, run\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class DurabilityTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def setUp(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.temp = tempfile.TemporaryDirectory()\r\n\u001b[?2004l\r\u001b[?2004h>         self.addCleanup(self.temp.cleanup)\r\n\u001b"]
[123.617705, "o", "[?2004l\r\u001b[?2004h>         self.root = Path(self.temp.name)\r\n\u001b[?2004l\r\u001b[?2004h>         self.db = self.root / \"docs.db\"\r\n\u001b[?2004l\r\u001b[?2004h>         self.index = self.root / \"index\"\r\n\u001b[?2004l\r\u001b[?2004h>         self.checkpoint = self.root / \"checkpoint.json\"\r\n\u001b[?2004l\r\u001b[?2004h>         self.docs = [Doc(i, \"Café %d\" % i, \"naïve résumé\", \"fr\")\r\n\u001b[?2004l\r\u001b[?2004h>                      for i in [1, 4, 8, 15, 23, 42, 99]]\r\n\u001b[?2004l\r\u001b[?2004h>         with sqlite3.connect(self.db) as conn:\r\n\u001b[?2004l\r\u001b[?2004h>             conn.executescript(SCHEMA)\r\n\u001b[?2004l\r\u001b[?2004h>             conn.executemany(\"INSERT INTO docs VALUES (?, ?, ?, ?, 0, 'now')\", self.docs)\r\n\u001b[?2004l\r\u001b[?2004h>             conn.execute(\"INSERT INTO docs VALUES (10, 'deleted', '', 'en', 1, 'now')\")\r\n\u001b[?2004l\r\u001b[?2004h>         self.args = parse_args([\"--source\", str(self.db), \"--index-dir\", str(self.index),\r\n\u001b[?2004l\r\u001b[?2004h>                                 \"--checkpoint\", str(self.checkpoint), \"--batch-size\", \"2\"])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?20"]
