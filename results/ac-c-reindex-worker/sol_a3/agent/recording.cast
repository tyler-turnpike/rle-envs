[88.007613, "o", "\"\"\"Reindex progress checkpoint (var/checkpoint.json).\"\"\"\r\nimport json\r\nimport logging\r\nimport os\r\nimport tempfile\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durable import sync_directory\r\n\r\nlog = logging.getLogger(\"reindex.checkpoint\")\r\n\r\n\r\ndef fresh_state():\r\n    # last_id: id of the last document handled; docs: documents indexed so far\r\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False}\r\n\r\n\r\nclass Checkpoint:\r\n    def __init__(self, path):\r\n        self.path = Path(path)\r\n\r\n    def load(self):\r\n        try:\r\n            data = json.loads(self.path.read_text())\r\n        except FileNotFoundError:\r\n            return fresh_state()\r\n        except ValueError:\r\n            log.warning(\"checkpoint %s unreadable, starting over\", self.path)\r\n            return fresh_state()\r\n        state = fresh_state()\r\n        state.update(data)\r\n        return state\r\n\r\n    def save(self, state):\r\n        self.path.parent.mkdir(parents=True, exist_ok=True)\r\n        # A crash leaves either the old checkpoint or the new one, n"]
[88.007834, "o", "ever half JSON.\r\n        fd, temporary = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\r\n                                         dir=self.path.parent)\r\n        try:\r\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\r\n                json.dump(state, fh)\r\n                fh.flush()\r\n                os.fsync(fh.fileno())\r\n            os.replace(temporary, self.path)\r\n            sync_directory(self.path.parent)\r\n        finally:\r\n            Path(temporary).unlink(missing_ok=True)\r\n\r\n    def clear(self):\r\n        self.path.unlink(missing_ok=True)\r\n\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfro"]
[88.007853, "o", "m reindex.durable import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(se"]
[88.00787, "o", "lf.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._buffer.clear()\r\n        self._rows_in_shard = 0\r\n        self._next_shard = 0\r\n        sync_directory(self.index_dir)\r\n\r\n    def recover(self, offsets):\r\n        \"\"\"Roll back everything not named by the last atomic checkpoint.\r\n\r\n        Validate before modifying anything: missing committed bytes are an error,\r\n        not a reason to advance or silently discard a checkpoint.\r\n        \"\"\"\r\n        paths = {p.name: p for p in shard_paths(self.index_dir)}\r\n        for name, offset in offsets.items():\r\n            if name not in paths or not isinstance(offset, int) or offset < 0:\r\n                raise ValueError(\"invalid or missing committed shard: %s\" % na"]
[88.007885, "o", "me)\r\n            if paths[name].stat().st_size < offset:\r\n                raise ValueError(\"committed shard is too short: %s\" % name)\r\n        self._buffer.clear()\r\n        self._close_shard()\r\n        for name, path in paths.items():\r\n            if name not in offsets:\r\n                path.unlink()\r\n            elif path.stat().st_size != offsets[name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(offsets[name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n        self._rows_in_shard = 0\r\n\r\n    def committed_offsets(self):\r\n        \"\"\"Flush all rows before returning the durable byte positions to publish.\"\"\"\r\n        self.flush()\r\n        sync_directory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer"]
[88.007933, "o", "_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n      "]
[88.007947, "o", "  self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Release resources without promoting buffered rows to committed work.\"\"\"\r\n        self._buffer.clear()\r\n        self._close_shard()\r\n\u001b[?2004hroot@1988364556ea:/app# "]
[123.6133, "i", "cat > tests/test_durability.py <<'EOF'\n\"\"\"Crash-window and resume regressions; keep transforms identical to production.\"\"\"\nimport json\nimport os\nimport signal\nimport sqlite3\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import SCHEMA, Doc\nfrom reindex.store import ShardWriter, iter_rows, shard_paths\nfrom reindex.transform import transform_doc\nfrom reindex.worker import parse_args, run\n\n\nclass DurabilityTest(unittest.TestCase):\n    def setUp(self):\n        self.temp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.temp.cleanup)\n        self.root = Path(self.temp.name)\n        self.db = self.root / \"docs.db\"\n        self.index = self.root / \"index\"\n        self.checkpoint = self.root / \"checkpoint.json\"\n        self.docs = [Doc(i, \"Café %d\" % i, \"naïve résumé\", \"fr\")\n                     for i in [1, 4, 8, 15, 23, 42, 99]]\n        with sqlite3.connect(self.db) as conn:\n            conn.execu"]
[123.613361, "i", "tescript(SCHEMA)\n            conn.executemany(\"INSERT INTO docs VALUES (?, ?, ?, ?, 0, 'now')\", self.docs)\n            conn.execute(\"INSERT INTO docs VALUES (10, 'deleted', '', 'en', 1, 'now')\")\n        self.args = parse_args([\"--source\", str(self.db), \"--index-dir\", str(self.index),\n                                \"--checkpoint\", str(self.checkpoint), \"--batch-size\", \"2\"])\n\n    def assert_complete(self):\n        self.assertEqual(run(self.args), 0)\n        self.assertEqual(list(iter_rows(self.index)), [transform_doc(d) for d in self.docs])\n        state = Checkpoint(self.checkpoint).load()\n        self.assertTrue(state[\"complete\"])\n        self.assertEqual(state[\"docs\"], len(self.docs))\n        self.assertEqual(state[\"last_id\"], self.docs[-1].id)\n        self.assertEqual(state[\"shards\"], {p.name: p.stat().st_size\n                                          for p in shard_paths(self.index)})\n        before = {p.name: p.read_bytes() for p in shard_paths(self.index)}\n        self.assertEqual(run(self.args), 0)\n   "]
[123.613374, "i", "     self.assertEqual(before, {p.name: p.read_bytes() for p in shard_paths(self.index)})\n\n    def test_crash_before_checkpoint_replays_only_uncommitted_rows(self):\n        save = Checkpoint.save\n\n        def crash(ckpt, state):\n            if state[\"docs\"] == 4:\n                raise SystemExit(\"crash after index flush, before checkpoint\")\n            save(ckpt, state)\n\n        with patch.object(Checkpoint, \"save\", crash):\n            with self.assertRaises(SystemExit):\n                run(self.args)\n        self.assertEqual(Checkpoint(self.checkpoint).load()[\"docs\"], 2)\n        self.assertEqual(len(list(iter_rows(self.index))), 4)\n        # Simulate a torn append and an entirely uncommitted rotated shard.\n        with open(shard_paths(self.index)[-1], \"ab\") as fh:\n            fh.write(b'{\"id\":')\n        (self.index / \"shard-99999.jsonl\").write_bytes(b'{\"id\":')\n        self.assert_complete()\n\n    def test_crash_after_checkpoint_does_not_replay_last_id(self):\n        save = Checkpoint.save\n\n        def crash(c"]
[123.613396, "i", "kpt, state):\n            save(ckpt, state)\n            if state[\"docs\"] == 4:\n                raise SystemExit(\"crash after checkpoint publication\")\n\n        with patch.object(Checkpoint, \"save\", crash):\n            with self.assertRaises(SystemExit):\n                run(self.args)\n        self.assertEqual(Checkpoint(self.checkpoint).load()[\"docs\"], 4)\n        self.assert_complete()\n\n    def test_sigterm_during_transform_commits_current_document(self):\n        calls = 0\n\n        def stop(doc):\n            nonlocal calls\n            calls += 1\n            row = transform_doc(doc)\n            if calls == 3:\n                os.kill(os.getpid(), signal.SIGTERM)\n            return row\n\n        with patch(\"reindex.worker.transform_doc\", stop):\n            self.assertEqual(run(self.args), 75)\n        self.assertEqual(Checkpoint(self.checkpoint).load()[\"docs\"], 3)\n        self.assertEqual(list(iter_rows(self.index)), [transform_doc(d) for d in self.docs[:3]])\n        self.assert_complete()\n\n    def test_signal_during"]
