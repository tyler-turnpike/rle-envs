[320.136452, "i", "cat > /tmp/check-index-prefix.py <<'EOF'\nimport json\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, '/app')\nfrom reindex.store import iter_rows, shard_paths\nstate = json.loads(Path('/app/var/checkpoint.json').read_text())\nexpected = json.loads(Path('/tmp/expected-index.json').read_text())\nactual = list(iter_rows('/app/var/index'))\nassert len(actual) == state['docs'], (len(actual), state['docs'])\nassert len({r['id'] for r in actual}) == len(actual), 'duplicates'\nassert actual == expected[:state['docs']], 'row contents or order differ'\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths('/app/var/index')}\nif actual:\n    assert state['last_id'] == actual[-1]['id']\nif state['complete']:\n    assert actual == expected, 'incomplete source coverage'\nprint('Verified %d/%d exact rows; complete=%s' % (len(actual), len(expected), state['complete']))\nEOF\npython3 /tmp/check-index-prefix.py\n"]
