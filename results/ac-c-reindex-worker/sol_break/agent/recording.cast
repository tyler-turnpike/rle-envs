[106.739888, "i", "d = [sys.executable, '-m', 'reindex.worker', '--source', str(self.db),\n               '--index-dir', str(self.index), '--checkpoint', str(self.ckpt.path)]\n        done = 0\n        for _ in range(3):\n            proc = subprocess.Popen(cmd, cwd=ROOT, stderr=subprocess.DEVNULL)\n            try:\n                deadline = time.monotonic() + 15\n                while self.ckpt.load()['docs'] <= done:\n                    self.assertIsNone(proc.poll(), 'worker exited before next commit')\n                    self.assertLess(time.monotonic(), deadline, 'worker made no progress')\n                    time.sleep(0.01)\n                time.sleep(0.02)  # Kill during work, not only at batch boundaries.\n                proc.send_signal(signal.SIGKILL)\n                proc.wait(timeout=5)\n            finally:\n                if proc.poll() is None:\n                    proc.kill()\n                    proc.wait()\n            state = self.ckpt.load()\n            self.assertGreater(state['docs'], done)\n            done = state['"]
