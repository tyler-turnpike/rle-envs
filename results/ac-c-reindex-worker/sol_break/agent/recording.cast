[106.736565, "i", "cat > tests/test_durability.py <<'PY'\n\"\"\"Regression tests for SEARCH-412's commit and recovery boundaries.\"\"\"\nimport json\nimport os\nimport signal\nimport sqlite3\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport unittest\nfrom pathlib import Path\nfrom unittest import mock\n\nfrom reindex.checkpoint import Checkpoint, fresh_state\nfrom reindex.source import Doc, SCHEMA, Source, generate_corpus\nfrom reindex.store import ShardWriter, iter_rows, shard_paths\nfrom reindex.transform import transform_doc\nfrom reindex.worker import parse_args, run\n\nROOT = Path(__file__).resolve().parent.parent\n\n\nclass DurabilityTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.root = Path(self.tmp.name)\n        self.db = self.root / 'docs.db'\n        self.index = self.root / 'index'\n        self.ckpt = Checkpoint(self.root / 'checkpoint.json')\n        # Sparse IDs and soft deletes exercise the exclusive resume boundary.\n       "]
[106.736705, "i", " with sqlite3.connect(self.db) as conn:\n            conn.executescript(SCHEMA)\n            conn.executemany('INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)',\n                             [(i * 3, 'Café %d' % i, 'A small résumé.', 'fr',\n                               int(i % 7 == 0), '2024-01-01') for i in range(1, 38)])\n        self.args = parse_args(['--source', str(self.db), '--index-dir', str(self.index),\n                                '--checkpoint', str(self.ckpt.path), '--batch-size', '8'])\n\n    def expected(self):\n        source = Source(self.db)\n        try:\n            return [transform_doc(doc) for batch in source.batches() for doc in batch]\n        finally:\n            source.close()\n\n    def assert_complete(self):\n        expected = self.expected()\n        self.assertEqual(list(iter_rows(self.index)), expected)\n        state = self.ckpt.load()\n        self.assertTrue(state['complete'])\n        self.assertEqual(state['docs'], len(expected))\n        self.assertEqual(state['last_id'], expected[-1]['i"]
[106.737857, "i", "d'] if expected else 0)\n        self.assertEqual(state['shards'], {p.name: p.stat().st_size\n                                           for p in shard_paths(self.index)})\n\n    def test_crashes_on_both_sides_of_each_checkpoint(self):\n        original = Checkpoint.save\n        # Four full batches, a short last batch, then the complete checkpoint.\n        for after in (False, True):\n            for boundary in range(1, 7):\n                with self.subTest(after=after, boundary=boundary):\n                    self.ckpt.path.unlink(missing_ok=True)\n                    calls = 0\n\n                    def save(ckpt, state):\n                        nonlocal calls\n                        calls += 1\n                        if calls == boundary and not after:\n                            raise OSError('crash before checkpoint publication')\n                        original(ckpt, state)\n                        if calls == boundary and after:\n                            raise OSError('crash after checkpoint publication')\n\n   "]
