[219.02119, "i", "cat > /tmp/verify-search-index.py <<'PY'\nimport hashlib\nimport itertools\nimport json\nimport sqlite3\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Doc\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nroot = Path('/app')\ncheckpoint = Checkpoint(root / 'var/checkpoint.json')\ndeadline = time.monotonic() + 300\nwhile not checkpoint.load()['complete']:\n    if time.monotonic() > deadline:\n        raise RuntimeError('backfill did not complete in time')\n    time.sleep(1)\nstate = checkpoint.load()\nconn = sqlite3.connect('file:/app/data/docs.db?mode=ro', uri=True)\nexpected = conn.execute('SELECT id, title, body, lang FROM docs WHERE deleted = 0 ORDER BY id')\nseen = set()\ncount = 0\nfor values, row in itertools.zip_longest(expected, iter_rows(root / 'var/index')):\n    assert values is not None and row is not None, 'missing or extra index row'\n    doc = Doc(*values)\n    assert row"]
[219.021331, "i", "['id'] == doc.id, ('wrong id', row['id'], doc.id)\n    assert doc.id not in seen, ('duplicate id', doc.id)\n    assert row == transform_doc(doc), ('row contents differ', doc.id)\n    seen.add(doc.id)\n    count += 1\n    if count % 500 == 0:\n        print('Verified %d complete rows (including checksum and all minhash values)' % count, flush=True)\nconn.close()\nassert count == state['docs'] == len(seen)\npaths = shard_paths(root / 'var/index')\nassert state['shards'] == {p.name: p.stat().st_size for p in paths}\nreport = {'verified_at': datetime.now(timezone.utc).isoformat(), 'live_docs': count,\n          'index_rows': count, 'unique_ids': len(seen), 'complete': state['complete'],\n          'all_row_contents_match': True,\n          'shard_sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}}\n(root / 'var/index-verification.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint('VERIFIED: %d live docs, %d rows, %d unique IDs; every row matches unchanged transform' %\n      (count, count, len"]
[219.02134, "i", "(seen)), flush=True)\nPY\nPYTHONPATH=/app python3 /tmp/verify-search-index.py > /tmp/reindex-verification.log 2>&1 &\n"]
