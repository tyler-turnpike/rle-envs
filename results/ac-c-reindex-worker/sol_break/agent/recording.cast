[76.297836, "o", "\r\n\u001b[?2004l\r"]
[76.298413, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, bu"]
[76.298467, "o", "ffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._buffer.clear()\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n        sync_directory(self.index_dir)\r\n\r\n    def recover(self, committed):\r\n        \"\"\"Roll back everything beyond the last atomically published commit.\r\n\r\n        Val"]
[76.298475, "o", "idate committed files before touching anything. A missing/sh"]
[76.317336, "o", "ort file\r\n        is storage damage, not an invitation to silently skip committed work.\r\n        Byte offsets also handle a kill in the middle of a UTF-8/JSON row.\r\n        \"\"\"\r\n        for name, size in committed.items():\r\n            if Path(name).name != name or not name.startswith(\"shard-\") or not name.endswith(\".jsonl\"):\r\n                raise ValueError(\"invalid committed shard name: %r\" % name)\r\n            path = self.index_dir / name\r\n            if not path.exists() or path.stat().st_size < size:\r\n                raise RuntimeError(\"committed shard missing or truncated: %s\" % path)\r\n        for path in shard_paths(self.index_dir):\r\n            if path.name not in committed:\r\n                path.unlink()\r\n            elif path.stat().st_size != committed[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(committed[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        self._next_"]
[76.317359, "o", "shard = self._first_free_shard()\r\n\r\n    def snapshot(self):\r\n        \"\"\"Make all rows durable before their offsets may be checkpointed.\"\"\"\r\n        self.flush()\r\n        sync_directory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" "]
[76.317374, "o", "% self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Release resources without committing pending rows. Recovery owns tails.\"\"\"\r\n        self._buffer.clear()\r\n        if self._fh is not None:\r\n            self._fh.close()\r\n            self._fh = None\r\n"]
[76.319324, "o", "test_stop_and_resume_gives_complete_index (test_reindex.ResumeTest.test_stop_and_resume_gives_complete_index) ... ok\r\ntest_rows_round_trip_across_shards (test_reindex.StoreTest.test_rows_round_trip_across_shards) ... ok\r\ntest_empty_body (test_reindex.TransformTest.test_empty_body) ... ok\r\ntest_golden_row (test_reindex.TransformTest.test_golden_row) ... ok\r\n\r\n----------------------------------------------------------------------\r\nRan 4 tests in 5.340s\r\n\r\nOK\r\n"]
