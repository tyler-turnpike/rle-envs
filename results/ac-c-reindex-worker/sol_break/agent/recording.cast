[106.742087, "o", "\u001b[?2004l\r\u001b[?2004h>         with sqlite3.connect(self.db) as conn:\r\n\u001b[?2004l\r\u001b[?2004h>             conn.executescript(SCHEMA)\r\n\u001b[?2004l\r\u001b[?2004h>             conn.executemany('INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)',\r\n\u001b[?2004l\r\u001b[?2004h>                              [(i * 3, 'Café %d' % i, 'A small résumé.', 'fr',\r\n\u001b[?2004l\r\u001b[?2004h>                                int(i % 7 == 0), '2024-01-01') for i in range(1, 38)])\r\n\u001b[?2004l\r\u001b[?2004h>         self.args = parse_args(['--source', str(self.db), '--index-dir', str(self.index),\r\n\u001b[?2004l\r\u001b[?2004h>                                 '--checkpoint', str(self.ckpt.path), '--batch-size', '8'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def expected(self):\r\n\u001b[?2004l\r\u001b[?2004h>         source = Source(self.db)\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             return [transform_doc(doc) for batch in source.batches() for doc in batch]\r\n\u001b[?2004l\r\u001b[?2004h>         finally:\r\n\u001b[?2004l\r\u001b[?2004h>             source.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?"]
