[65.26778, "i", "   count += 1\n                last_id = doc.id\n            if count:\n                commit(last_id, count)\n            if stopping:\n                log.info(\"stopped safely after id %d (%d/%d docs)\",\n                         state[\"last_id\"], state[\"docs\"], total)\n                return 0\n            if n % 20 == 0:\n                rate = n * args.batch_size / (time.monotonic() - started)\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\n                         state[\"last_id\"], state[\"docs\"], total, rate)\n\n        # Includes the empty corpus and a restart after the final batch commit.\n        store.close()\n        state[\"complete\"] = True\n        ckpt.save(state)\n        log.info(\"reindex complete: %d docs\", state[\"docs\"])\n        return 0\n    finally:\n        if store is not None:\n            store.abort()\n        if source is not None:\n            source.close()\n        for sig, handler in previous.items():\n            signal.signal(sig, handler)\n''' +s[b:]\nopen(p,'w').write(s)\nPY"]
