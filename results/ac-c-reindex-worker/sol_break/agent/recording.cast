[65.267757, "i", ")\n        if state[\"complete\"]:\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\n            return 0\n        source = Source(args.source)\n        total = source.count()\n        started = time.monotonic()\n        log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\n\n        def commit(last_id, count):\n            # Ordering is essential: durable rows -> atomic checkpoint. A crash\n            # between them leaves a tail, which recover() removes before replay.\n            state[\"shards\"] = store.snapshot()\n            state[\"last_id\"] = last_id\n            state[\"docs\"] += count\n            ckpt.save(state)\n\n        for n, batch in enumerate(source.batches(start_id=state[\"last_id\"] + 1,\n                                                size=args.batch_size), 1):\n            count, last_id = 0, state[\"last_id\"]\n            for doc in batch:\n                if stopping:\n                    break\n                store.add(transform_doc(doc))\n             "]
