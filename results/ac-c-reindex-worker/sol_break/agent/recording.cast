[65.158038, "i", "cat > reindex/checkpoint.py <<'PY'\n\"\"\"Atomically published reindex progress and committed shard byte lengths.\"\"\"\nimport json\nimport logging\nimport os\nimport tempfile\nfrom pathlib import Path\n\nlog = logging.getLogger(\"reindex.checkpoint\")\n\n\ndef sync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef fresh_state():\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False, \"shards\": {}}\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text())\n        except FileNotFoundError:\n            return fresh_state()\n        except ValueError:\n            log.warning(\"checkpoint %s unreadable, starting over\", self.path)\n            return fresh_state()\n        if \"shards\" not in data:\n            # The old protocol checkpointed buffered (not durable) rows. Even a\n            # 'complete' legacy checkpoint cannot certify a dupl"]
[65.158385, "i", "icate-free index.\n            log.warning(\"legacy checkpoint %s: rebuilding with durable commits\", self.path)\n            return fresh_state()\n        state = fresh_state()\n        state.update(data)\n        return state\n\n    def save(self, state):\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        fd, name = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                    dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(name, self.path)\n            sync_directory(self.path.parent)\n        finally:\n            Path(name).unlink(missing_ok=True)\n\n    def clear(self):\n        self.path.unlink(missing_ok=True)\n        sync_directory(self.path.parent)\nPY\npython3 - <<'PY'\np='reindex/store.py'\ns=open(p).read().replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.checkpoin"]
