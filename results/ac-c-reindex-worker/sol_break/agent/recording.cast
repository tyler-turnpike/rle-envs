[167.584226, "i", "python3 - <<'PY'\np='reindex/store.py'\ns=open(p).read()\na=s.index('def iter_rows(')\nb=s.index('\\n\\nclass ShardWriter',a)\ns=s[:a]+'''def iter_rows(index_dir, committed=None):\n    \"\"\"Read all rows, or only the checkpoint's certified byte prefixes.\n\n    The latter is safe for status during a run or after a torn tail write; it\n    never parses or publishes uncommitted bytes and does not mutate the index.\n    \"\"\"\n    if committed is not None:\n        for name, size in sorted(committed.items()):\n            with open(Path(index_dir) / name, \"rb\") as fh:\n                remaining = size\n                while remaining:\n                    line = fh.readline(remaining)\n                    if not line:\n                        raise RuntimeError(\"committed shard truncated: %s\" % name)\n                    remaining -= len(line)\n                    if line.strip():\n                        yield json.loads(line)\n        return\n    for path in shard_paths(index_dir):\n        with open(path, encoding=\"utf-8\") as fh:\n        "]
[167.584452, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='reindex/store.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> a=s.index('def iter_rows(')\r\n\u001b[?2004l\r\u001b[?2004h> b=s.index('\\n\\nclass ShardWriter',a)\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+'''def iter_rows(index_dir, committed=None):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Read all rows, or only the checkpoint's certified byte prefixes.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     The latter is safe for status during a run or after a torn tail write; it\r\n\u001b[?2004l\r\u001b[?2004h>     never parses or publishes uncommitted bytes and does not mutate the index.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if committed is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         for name, size in sorted(committed.items()):\r\n\u001b[?2004l\r\u001b[?2004h>             with open(Path(index_dir) / name, \"rb\") as fh:\r\n\u001b[?2004l\r\u001b[?2004h>                 remaining = size\r\n\u001b[?2004l\r\u001b[?2004h>                 while remaining:\r\n\u001b[?2004l\r\u001b[?2004h>                     line = fh.readline(remaining)\r\n\u001b[?2004l\r\u001b[?2004h>                "]
