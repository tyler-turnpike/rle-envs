[185.458417, "o", "\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n"]
[185.462152, "o", "\r\nNormally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n"]
[185.462258, "o", "    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\n"]
[185.46595, "o", "import argparse\r\nimport logging\r\nimport signal\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str(ROOT / \"var\" / \"index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    args = parser.parse_args(argv)\r\n    if args.batch_size <= 0:\r\n        parser.error(\"--batch-size must be positive\")\r\n    return args\r\n\r\n\r\ndef sh"]
[185.466117, "o", "ow_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir, state[\"shards\"]))\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source, committed)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    # Never raise asynchronously in a write/rename. Stop at a document boundary\r\n    # and commit the partial batch; SIGKILL is handled by recovery on next run.\r\n    stopping = False\r\n\r\n    def request_stop(signum, frame):\r\n        nonlocal stopping\r\n        stopping = True\r\n\r\n    previous = {sig: signal.signal(sig, request_stop)\r\n                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n    source = store = None\r\n    try:\r\n        ckpt = Checkpoint(args.checkpoint)\r\n        state"]
[185.466129, "o", " = ckpt.load()\r\n        store = ShardWriter(args.index_dir)\r\n        store.recover(state[\"shards\"])\r\n        if state[\"complete\"]:\r\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n            return 0\r\n        source = Source(args.source)\r\n        total = source.count()\r\n        started = time.monotonic()\r\n        log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\r\n        def commit(last_id, count):\r\n            # Ordering is essential: durable rows -> atomic checkpoint. A crash\r\n            # between them leaves a tail, which recover() removes before replay.\r\n            state[\"shards\"] = store.snapshot()\r\n            state[\"last_id\"] = last_id\r\n            state[\"docs\"] += count\r\n            ckpt.save(state)\r\n\r\n        for n, batch in enumerate(source.batches(start_id=state[\"last_id\"] + 1,\r\n                                                size=args.batch_size), 1):\r\n            count, last_id = 0, state[\"last_id\"]\r\n            for doc in bat"]
[185.466134, "o", "ch:\r\n                if stopping:\r\n                    break\r\n                store.add(transform_doc(doc))\r\n                count += 1\r\n                last_id = doc.id\r\n            if count:\r\n                commit(last_id, count)\r\n            if stopping:\r\n                log.info(\"stopped safely after id %d (%d/%d docs)\",\r\n                         state[\"last_id\"], state[\"docs\"], total)\r\n                return 0\r\n            if n % 20 == 0:\r\n                rate = n * args.batch_size / (time.monotonic() - started)\r\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                         state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n        # Includes the empty corpus and a restart after the final batch commit.\r\n        store.close()\r\n        state[\"complete\"] = True\r\n        ckpt.save(state)\r\n        log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n        return 0\r\n    finally:\r\n        if store is not None:\r\n            store.abort()\r\n        if source is not None:\r\n  "]
[185.46614, "o", "          source.close()\r\n        for sig, handler in previous.items():\r\n            signal.signal(sig, handler)\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logging.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[185.482257, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir, committed=None):\r\n    \"\"\"Read all rows, or only the checkpoint's certified byte prefixes.\r\n\r\n    The latter is safe for status during a run or after a torn tail write; it\r\n    never parses or publishes uncommitted bytes and does not mutate the index.\r\n    \"\"\"\r\n    if committed is no"]
[185.482441, "o", "t None:\r\n        for name, size in sorted(committed.items()):\r\n            with open(Path(index_dir) / name, \"rb\") as fh:\r\n                remaining = size\r\n                while remaining:\r\n                    line = fh.readline(remaining)\r\n                    if not line:\r\n                        raise RuntimeError(\"committed shard truncated: %s\" % name)\r\n                    remaining -= len(line)\r\n                    if line.strip():\r\n                        yield json.loads(line)\r\n        return\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n      "]
[185.482476, "o", "  self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._buffer.clear()\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n        sync_directory(self.index_dir)\r\n\r\n    def recover(self, committed):\r\n        \"\"\"Roll back everything beyond the last atomically published commit.\r\n\r\n        Validate committed files before touching anything. A missing/short file\r\n        is storage damage, not an invitation to silently skip committed work.\r\n        Byte offsets also handle a kill in the middle of a UTF-8/JSON row.\r\n        \"\"\"\r"]
[185.482481, "o", "\n        for name, size in committed.items():\r\n            if Path(name).name != name or not name.startswith(\"shard-\") or not name.endswith(\".jsonl\"):\r\n                raise ValueError(\"invalid committed shard name: %r\" % name)\r\n            path = self.index_dir / name\r\n            if not path.exists() or path.stat().st_size < size:\r\n                raise RuntimeError(\"committed shard missing or truncated: %s\" % path)\r\n        for path in shard_paths(self.index_dir):\r\n            if path.name not in committed:\r\n                path.unlink()\r\n            elif path.stat().st_size != committed[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(committed[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def snapshot(self):\r\n        \"\"\"Make all rows durable before their offsets may be checkpointed.\"\"\"\r\n        self.flush()\r\n        sync_di"]
[185.482489, "o", "rectory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n       "]
[185.482495, "o", " if self._fh is not None:\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Release resources without committing pending rows. Recovery owns tails.\"\"\"\r\n        self._buffer.clear()\r\n        if self._fh is not None:\r\n            self._fh.close()\r\n            self._fh = None\r\n\u001b[?2004hroot@497dc6d7a000:/app# "]
