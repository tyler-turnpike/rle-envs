[65.272076, "o", "fter the final batch commit.\r\n\u001b[?2004l\r\u001b[?2004h>         store.close()\r\n\u001b[?2004l\r\u001b[?2004h>         state[\"complete\"] = True\r\n\u001b[?2004l\r\u001b[?2004h>         ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         if store is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             store.abort()\r\n\u001b[?2004l\r\u001b[?2004h>         if source is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             source.close()\r\n\u001b[?2004l\r\u001b[?2004h>         for sig, handler in previous.items():\r\n\u001b[?2004l\r\u001b[?2004h>             signal.signal(sig, handler)\r\n\u001b[?2004l\r\u001b[?2004h> ''' +s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
