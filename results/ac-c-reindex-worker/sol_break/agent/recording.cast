[106.746075, "o", "        self.assertEqual(state['docs'], len(expected))\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(state['last_id'], expected[-1]['id'] if expected else 0)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(state['shards'], {p.name: p.stat().st_size\r\n\u001b[?2004l\r\u001b[?2004h>                                            for p in shard_paths(self.index)})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_crashes_on_both_sides_of_each_checkpoint(self):\r\n\u001b[?2004l\r\u001b[?2004h>         original = Checkpoint.save\r\n\u001b[?2004l\r\u001b[?2004h>         # Four full batches, a short last batch, then the complete checkpoint.\r\n\u001b[?2004l\r\u001b[?2004h>         for after in (False, True):\r\n\u001b[?2004l\r\u001b[?2004h>             for boundary in range(1, 7):\r\n\u001b[?2004l\r\u001b[?2004h>                 with self.subTest(after=after, boundary=boundary):\r\n\u001b[?2004l\r\u001b[?2004h>                     self.ckpt.path.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>                     calls = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>                     def save(ckpt, state):\r\n\u001b[?2004"]
[106.746202, "o", "l\r\u001b[?2004h>                         nonlocal calls\r\n\u001b[?2004l\r\u001b[?2004h>                         calls += 1\r\n\u001b[?2004l\r\u001b[?2004h>                         if calls == boundary and not after:\r\n\u001b[?2004l\r\u001b[?2004h>                             raise OSError('crash before checkpoint publication')\r\n\u001b[?2004l\r\u001b[?2004h>                         original(ckpt, state)\r\n\u001b[?2004l\r\u001b[?2004h>                         if calls == boundary and after:\r\n\u001b[?2004l\r\u001b[?2004h>                             raise OSError('crash after checkpoint publication')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>                     with mock.patch.object(Checkpoint, 'save', save):\r\n\u001b[?2004l\r\u001b[?2004h>                         with self.assertRaises(OSError):\r\n\u001b[?2004l\r\u001b[?2004h>                             run(self.args)\r\n\u001b[?2004l\r\u001b[?2004h>                     committed = self.ckpt.load()\r\n\u001b[?2004l\r\u001b[?2004h>                     prefix = {name: (self.index / name).read_bytes()[:size]\r\n\u001b[?2004l\r\u001b[?2004h>                               for name, size in committed['"]
[106.746304, "o", "shards'].items()}\r\n\u001b[?2004l\r\u001b[?2004h>                     committed_rows = [json.loads(line) for data in prefix.values()\r\n\u001b[?2004l\r\u001b[?2004h>                                       for line in data.splitlines()]\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assertEqual(committed_rows, self.expected()[:committed['docs']])\r\n\u001b[?2004l\r\u001b[?2004h>                     run(self.args)\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assert_complete()\r\n\u001b[?2004l\r\u001b[?2004h>                     for name, data in prefix.items():\r\n\u001b[?2004l\r\u001b[?2004h>                         self.assertEqual((self.index / name).read_bytes()[:len(data)], data)\r\n\u001b[?2004l\r\u001b[?2004h>                     before = {p.name: p.read_bytes() for p in shard_paths(self.index)}\r\n\u001b[?2004l\r\u001b[?2004h>                     run(self.args)  # Completed runs are idempotent.\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assertEqual(before, {p.name: p.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h>                                               for p in shard_paths(self.index)})\r\n\u001b[?2004l\r\u001b[?"]
[106.746421, "o", "2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_atomic_checkpoint_replace_failure_keeps_old_commit(self):\r\n\u001b[?2004l\r\u001b[?2004h>         old = fresh_state()\r\n\u001b[?2004l\r\u001b[?2004h>         self.ckpt.save(old)\r\n\u001b[?2004l\r\u001b[?2004h>         with mock.patch('reindex.checkpoint.os.replace', side_effect=OSError('crash')):\r\n\u001b[?2004l\r\u001b[?2004h>             with self.assertRaises(OSError):\r\n\u001b[?2004l\r\u001b[?2004h>                 self.ckpt.save(dict(old, last_id=123, docs=42))\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.ckpt.load(), old)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(list(self.root.glob('*.tmp')), [])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_recovery_discards_torn_tail_and_uncommitted_shards(self):\r\n\u001b[?2004l\r\u001b[?2004h>         writer = ShardWriter(self.index, shard_rows=3, buffer_rows=2)\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(4):\r\n\u001b[?2004l\r\u001b[?2004h>             writer.add({'id': i, 'title': 'café'})\r\n\u001b[?2004l\r\u001b[?2004h>         committed = writer.snapshot()\r\n\u001b[?2004l\r\u001b[?2004h>         writer.close()\r\n\u001b"]
