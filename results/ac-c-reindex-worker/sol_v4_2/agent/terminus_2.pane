[?2004l"""Reindex worker: data/docs.db -> var/index/shard-*.jsonl.

Normally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).
Progress is kept in var/checkpoint.json so the next run continues where the last
one stopped; a run with no checkpoint rebuilds the index from scratch.

    python3 -m reindex.worker            run / resume
    python3 -m reindex.worker --status   print progress
"""
import argparse
import logging
import signal
import sys
import time
from pathlib import Path

from reindex.checkpoint import Checkpoint, fresh_state
from reindex.source import Source
from reindex.store import ShardWriter, iter_rows
from reindex.transform import transform_doc

ROOT = Path(__file__).resolve().parent.parent
BATCH_SIZE = 25

log = logging.getLogger("reindex.worker")


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="reindex.worker")
    parser.add_argument("--source", default=str(ROOT / "data" / "docs.db"))
    parser.add_argument("--index-dir", default=str(ROOT / "var" / "index"))
    parser.add_argument("--checkpoint", default=str(ROOT / "var" / "checkpoint.json"))
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--status", action="store_true", help="print progress and exit")
    args = parser.parse_args(argv)
    if args.batch_size <= 0:
        parser.error("--batch-size must be positive")
    return args


def show_status(args):
    state = Checkpoint(args.checkpoint).load()
    source = Source(args.source)
    total = source.count()
    source.close()
    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []
    unique = len({row["id"] for row in rows})
    print("checkpoint : %s" % state)
    print("source     : %d live docs" % total)
    print("index      : %d rows, %d unique ids (%.1f%% of source)"
          % (len(rows), unique, 100.0 * unique / max(total, 1)))
    return 0


def run(args):
    # Signal handlers only request a stop; never interrupt a filesystem commit.
    stopping = False

    def request_stop(signum, frame):
        nonlocal stopping
        stopping = True

    handlers = {sig: signal.signal(sig, request_stop)
                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    source = store = None
    try:
        ckpt = Checkpoint(args.checkpoint)
        state = ckpt.load()
        source = Source(args.source)
        store = ShardWriter(args.index_dir)
        if "shards" not in state:
            # Old checkpoints may claim buffered (never written) rows, and may
            # already contain duplicates. There is no trustworthy prefix to use.
            log.info("no durable checkpoint: rebuilding index from scratch")
            store.reset()
            state = fresh_state()
            state["shards"] = {}
            ckpt.save(state)
        else:
            store.recover(state["shards"])
        if state["complete"]:
            log.info("index already complete (%d docs)", state["docs"])
            return 0

        total = source.count()
        started = time.monotonic()
        initial_docs = state["docs"]
        log.info("starting after id %d (%d/%d docs done)", state["last_id"], state["docs"], total)
        # Source.batches is inclusive, while last_id is already committed.
        start_id = state["last_id"] + 1 if state["docs"] else 0
        for n, batch in enumerate(source.batches(start_id=start_id, size=args.batch_size), 1):
            for doc in batch:
                if stopping:
                    break
                store.add(transform_doc(doc))
                state["last_id"] = doc.id
                state["docs"] += 1
            # Flush even a partial batch on SIGTERM, then atomically publish it.
            state["shards"] = store.commit()
            ckpt.save(state)
            if stopping:
                log.info("stopped safely at id %d (%d/%d docs)",
                         state["last_id"], state["docs"], total)
                return 75
            if n % 20 == 0:
                rate = (state["docs"] - initial_docs) / (time.monotonic() - started)
                log.info("progress: last_id=%d docs=%d/%d (%.0f docs/s)",
                         state["last_id"], state["docs"], total, rate)

        if stopping:
            return 75
        state["shards"] = store.commit()
        state["complete"] = True
        ckpt.save(state)
        log.info("reindex complete: %d docs", state["docs"])
        return 0
    finally:
        try:
            if store is not None:
                store.abort()
            if source is not None:
                source.close()
        finally:
            for sig, handler in handlers.items():
                signal.signal(sig, handler)


def main(argv=None):
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(asctime)s %(name)s %(levelname)s %(message)s")
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.status:
        return show_status(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
"""Atomically published reindex progress and durable shard boundaries."""
import json
import os
import tempfile
from pathlib import Path

from reindex.durable import sync_directory


def fresh_state():
    # last_id is inclusive; shards (added by the worker) records committed bytes.
    return {"last_id": 0, "docs": 0, "complete": False}


class Checkpoint:
    def __init__(self, path):
        self.path = Path(path)

    def load(self):
        try:
            data = json.loads(self.path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            return fresh_state()
        # Fail closed on corruption: silently resetting could discard committed work.
        if (not isinstance(data, dict)
                or type(data.get("last_id")) is not int
                or type(data.get("docs")) is not int
                or data["last_id"] < 0 or data["docs"] < 0
                or type(data.get("complete")) is not bool):
            raise ValueError("invalid checkpoint: %s" % self.path)
        return data

    def save(self, state):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=self.path.name + ".", suffix=".tmp",
                                         dir=self.path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(state, fh, sort_keys=True)
                fh.write("\n")
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temporary, self.path)
            sync_directory(self.path.parent)
        finally:
            Path(temporary).unlink(missing_ok=True)

    def clear(self):
        self.path.unlink(missing_ok=True)
        sync_directory(self.path.parent)
