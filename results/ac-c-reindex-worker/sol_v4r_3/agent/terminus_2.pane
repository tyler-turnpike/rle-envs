[?2004l# search-reindex

Builds the search index (`var/index/shard-*.jsonl`) from the document store
(`data/docs.db`).

| path | what |
|------|------|
| `reindex/worker.py` | the reindex job: reads docs in id order, transforms, writes shards, checkpoints |
| `reindex/transform.py` | doc -> index row (row format documented there) |
| `reindex/store.py` | shard writer / reader |
| `reindex/checkpoint.py` | progress checkpoint (`var/checkpoint.json`) |
| `reindex/source.py` | source corpus access (+ fixture generator) |
| `ops/supervise.py` | job runner used for every batch job here: budget, SIGTERM/SIGKILL, run log |
| `ops/limits.json` | per-job budgets and cooldowns |
| `jobs` | entry points: `./jobs reindex`, `./jobs status`, `./jobs history`, `./jobs test`, `./jobs clean` |

A full reindex of the current corpus is several budgets long; the job is designed
to be run repeatedly and pick up where the previous run stopped.
"""Reindex progress checkpoint (var/checkpoint.json)."""
import json
import logging
from pathlib import Path

log = logging.getLogger("reindex.checkpoint")


def fresh_state():
    # last_id: id of the last document handled; docs: documents indexed so far
    return {"last_id": 0, "docs": 0, "complete": False}


class Checkpoint:
    def __init__(self, path):
        self.path = Path(path)

    def load(self):
        try:
            data = json.loads(self.path.read_text())
        except FileNotFoundError:
            return fresh_state()
        except ValueError:
            log.warning("checkpoint %s unreadable, starting over", self.path)
            return fresh_state()
        state = fresh_state()
        state.update(data)
        return state

    def save(self, state):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.path, "w") as fh:
            json.dump(state, fh)

    def clear(self):
        self.path.unlink(missing_ok=True)
"""Source corpus: the documents table the search index is built from.

The corpus lives in data/docs.db (SQLite).  Ids are increasing but not contiguous
(deleted rows are purged now and then), and soft-deleted rows are skipped.
`generate_corpus` builds the fixture corpus used in dev images and tests.
"""
import random
import sqlite3
from collections import namedtuple

Doc = namedtuple("Doc", "id title body lang")

DEFAULT_SEED = 20240611
DEFAULT_COUNT = 6000

SCHEMA = """
CREATE TABLE IF NOT EXISTS docs (
    id INTEGER PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    lang TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    updated_at TEXT NOT NULL
);
"""

_ACCENTED = ["café", "naïve", "résumé", "über", "façade", "Ångström", "smörgåsbord",
             "jalapeño", "Zürich", "déjà", "crème", "señor", "Straße", "coöperate"]
_STOP = ["the", "of", "and", "to", "in", "is", "for", "with", "on", "as", "by", "at"]


def _vocabulary(rng, size=700):
    onsets = ["b", "c", "d", "f", "g", "h", "k", "l", "m", "n", "p", "r", "s", "t",
              "v", "w", "z", "br", "ch", "cl", "dr", "gr", "pl", "qu", "sh", "st", "th", "tr"]
    vowels = ["a", "e", "i", "o", "u", "ai", "ea", "io", "ou", "y"]
    codas = ["", "", "n", "r", "s", "t", "l", "m", "ck", "nd", "st", "x"]
    words = set()
    while len(words) < size:
        syllables = rng.randint(1, 3)
        words.add("".join(rng.choice(onsets) + rng.choice(vowels) + rng.choice(codas)
                          for _ in range(syllables)))
    return sorted(words) + _ACCENTED + _STOP * 6


def generate_corpus(path, count=DEFAULT_COUNT, seed=DEFAULT_SEED):
    """Write a deterministic corpus of `count` documents to the SQLite file at `path`."""
    rng = random.Random(seed)
    vocab = _vocabulary(rng)
    rows, doc_id = [], 0
    for _ in range(count):
        doc_id += rng.choice((1, 1, 1, 2, 3))
        title = " ".join(rng.choice(vocab) for _ in range(rng.randint(2, 7))).title()
        sentences = []
        for _ in range(rng.randint(0, 9)):
            words = [rng.choice(vocab) for _ in range(rng.randint(4, 18))]
            if rng.random() < 0.15:
                words[0] = words[0].upper()
            sentences.append(" ".join(words).capitalize() + rng.choice((".", "!", "?", "...", ";")))
        body = " ".join(sentences)
        lang = rng.choice(("en", "en", "en", "de", "fr"))
        deleted = 1 if rng.random() < 0.04 else 0
        updated = "2024-%02d-%02d" % (rng.randint(1, 12), rng.randint(1, 28))
        rows.append((doc_id, title, body, lang, deleted, updated))
    conn = sqlite3.connect(path)
    with conn:
        conn.executescript(SCHEMA)
        conn.execute("DELETE FROM docs")
        conn.executemany("INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)", rows)
    conn.close()
    return len(rows)


class Source:
    """Read-only access to the live (not soft-deleted) documents, in id order."""

    def __init__(self, path):
        self.conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)

    def count(self):
        return self.conn.execute("SELECT COUNT(*) FROM docs WHERE deleted = 0").fetchone()[0]

    def batches(self, start_id=0, size=25):
        """Yield lists of Docs with id >= start_id, `size` at a time, in id order."""
        next_id = start_id
        while True:
            rows = self.conn.execute(
                "SELECT id, title, body, lang FROM docs WHERE deleted = 0 AND id >= ? "
                "ORDER BY id LIMIT ?", (next_id, size)).fetchall()
            if not rows:
                return
            yield [Doc(*row) for row in rows]
            next_id = rows[-1][0] + 1

    def close(self):
        self.conn.close()


if __name__ == "__main__":
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else "data/docs.db"
    print("wrote %d docs to %s" % (generate_corpus(out), out))
"""Index storage: JSON-lines shards under var/index/.

Each line is one index row (see reindex.transform).  The search service loads every
`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are
buffered and written out in blocks (one write + fsync per block) because the index
volume is network storage in production and small appends are slow there.
"""
import json
import os
from pathlib import Path

SHARD_ROWS = 1000      # rows per shard file before rotating
BUFFER_ROWS = 200      # rows held in memory before a block write


def shard_paths(index_dir):
    return sorted(Path(index_dir).glob("shard-*.jsonl"))


def iter_rows(index_dir):
    for path in shard_paths(index_dir):
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                if line.strip():
                    yield json.loads(line)


class ShardWriter:
    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):
        self.index_dir = Path(index_dir)
        self.index_dir.mkdir(parents=True, exist_ok=True)
        self.shard_rows = shard_rows
        self.buffer_rows = buffer_rows
        self._buffer = []
        self._fh = None
        self._rows_in_shard = 0
        self._next_shard = self._first_free_shard()

    def _first_free_shard(self):
        numbers = [int(p.stem.split("-", 1)[1]) for p in shard_paths(self.index_dir)]
        return max(numbers) + 1 if numbers else 0

    @property
    def pending(self):
        return len(self._buffer)

    def reset(self):
        """Drop every shard (used when a reindex starts from scratch)."""
        self._close_shard()
        for path in shard_paths(self.index_dir):
            path.unlink()
        self._next_shard = 0

    def add(self, row):
        self._buffer.append(row)
        if len(self._buffer) >= self.buffer_rows:
            self.flush()

    def flush(self):
        if not self._buffer:
            return
        for row in self._buffer:
            if self._fh is None or self._rows_in_shard >= self.shard_rows:
                self._rotate()
            self._fh.write(json.dumps(row, sort_keys=True, separators=(",", ":"),
                                      ensure_ascii=False) + "\n")
            self._rows_in_shard += 1
        self._fh.flush()
        os.fsync(self._fh.fileno())
        self._buffer.clear()

    def _rotate(self):
        self._close_shard()
        path = self.index_dir / ("shard-%05d.jsonl" % self._next_shard)
        self._fh = open(path, "a", encoding="utf-8")
        self._next_shard += 1
        self._rows_in_shard = 0

    def _close_shard(self):
        if self._fh is not None:
            self._fh.close()
            self._fh = None

    def close(self):
        self.flush()
        self._close_shard()
"""Document -> index row.

Row format (consumed by the search service; do not change without a format bump):
  id        source doc id
  slug      url slug from the title
  lang      language code
  length    number of index tokens (stopwords removed)
  terms     up to 8 most frequent tokens, ties broken alphabetically
  checksum  sha256 prefix over the normalised title + body (change detection)
  minhash   64 x 32-bit minhash values over character 5-grams (near-duplicate detection)
"""
import hashlib
import re
import unicodedata
from collections import Counter

TOKEN_RE = re.compile(r"[a-z0-9]+")
STOPWORDS = frozenset("a an and are as at be by for from has in is it of on or that the to was "
                      "were will with".split())
TOP_TERMS = 8
NUM_PERM = 64
SHINGLE = 5
_SALTS = [b"perm-%04d" % i for i in range(NUM_PERM)]


def normalize(text):
    """NFKD-fold accents away and lowercase."""
    text = unicodedata.normalize("NFKD", text)
    return "".join(ch for ch in text if not unicodedata.combining(ch)).lower()


def tokenize(text):
    return [tok for tok in TOKEN_RE.findall(normalize(text)) if tok not in STOPWORDS]


def slugify(title):
    return "-".join(TOKEN_RE.findall(normalize(title)))[:64] or "untitled"


def checksum(title, body):
    digest = hashlib.sha256()
    digest.update(normalize(title).encode("utf-8"))
    digest.update(b"\x00")
    digest.update(normalize(body).encode("utf-8"))
    return digest.hexdigest()[:32]


def minhash(tokens):
    text = " ".join(tokens)
    shingles = {text[i:i + SHINGLE] for i in range(max(1, len(text) - SHINGLE + 1))}
    encoded = [s.encode("utf-8") for s in sorted(shingles)]
    blake = hashlib.blake2b
    signature = []
    for salt in _SALTS:
        signature.append(min(int.from_bytes(blake(s, digest_size=4, salt=salt).digest(), "big")
                             for s in encoded))
    return signature


def transform_doc(doc):
    tokens = tokenize(doc.title + " " + doc.body)
    top = sorted(Counter(tokens).items(), key=lambda kv: (-kv[1], kv[0]))[:TOP_TERMS]
    return {
        "id": doc.id,
        "slug": slugify(doc.title),
        "lang": doc.lang,
        "length": len(tokens),
        "terms": [term for term, _ in top],
        "checksum": checksum(doc.title, doc.body),
        "minhash": minhash(tokens),
    }
"""Reindex worker: data/docs.db -> var/index/shard-*.jsonl.

Normally started by `make reindex` (ops/supervise.py runs it inside the job budget).
Progress is kept in var/checkpoint.json so the next run continues where the last
one stopped; a run with no checkpoint rebuilds the index from scratch.

    python3 -m reindex.worker            run / resume
    python3 -m reindex.worker --status   print progress
"""
import argparse
import logging
import sys
import time
from pathlib import Path

from reindex.checkpoint import Checkpoint
from reindex.source import Source
from reindex.store import ShardWriter, iter_rows
from reindex.transform import transform_doc

ROOT = Path(__file__).resolve().parent.parent
BATCH_SIZE = 25

log = logging.getLogger("reindex.worker")


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="reindex.worker")
    parser.add_argument("--source", default=str(ROOT / "data" / "docs.db"))
    parser.add_argument("--index-dir", default=str(ROOT / "var" / "index"))
    parser.add_argument("--checkpoint", default=str(ROOT / "var" / "checkpoint.json"))
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--status", action="store_true", help="print progress and exit")
    return parser.parse_args(argv)


def show_status(args):
    state = Checkpoint(args.checkpoint).load()
    source = Source(args.source)
    total = source.count()
    source.close()
    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []
    unique = len({row["id"] for row in rows})
    print("checkpoint : %s" % state)
    print("source     : %d live docs" % total)
    print("index      : %d rows, %d unique ids (%.1f%% of source)"
          % (len(rows), unique, 100.0 * unique / max(total, 1)))
    return 0


def run(args):
    ckpt = Checkpoint(args.checkpoint)
    state = ckpt.load()
    if state["complete"]:
        log.info("index already complete (%d docs)", state["docs"])
        return 0
    source = Source(args.source)
    store = ShardWriter(args.index_dir)
    if state["last_id"] == 0:
        log.info("no checkpoint: rebuilding index from scratch")
        store.reset()
    total = source.count()
    started = time.monotonic()
    log.info("starting after id %d (%d/%d docs done)", state["last_id"], state["docs"], total)

    for n, batch in enumerate(source.batches(start_id=state["last_id"], size=args.batch_size), 1):
        for doc in batch:
            store.add(transform_doc(doc))
        state["last_id"] = batch[-1].id
        state["docs"] += len(batch)
        ckpt.save(state)
        if n % 20 == 0:
            rate = n * args.batch_size / (time.monotonic() - started)
            log.info("progress: last_id=%d docs=%d/%d (%.0f docs/s)",
                     state["last_id"], state["docs"], total, rate)

    store.close()
    state["complete"] = True
    ckpt.save(state)
    source.close()
    log.info("reindex complete: %d docs", state["docs"])
    return 0


def main(argv=None):
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(asctime)s %(name)s %(levelname)s %(message)s")
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.status:
        return show_status(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
[?2004hroot@08c0120c5b18:/app# cat ops/supervise.py ops/limits.json ops/overrides/README.md tests/test_reindex.py
[?2004l#!/usr/bin/env python3
"""Job supervisor.  Every batch job in this repo runs through it.

    python3 ops/supervise.py run <job>       run (or resume) the job inside its budget
    python3 ops/supervise.py history <job>   show the last runs

Per-job limits live in ops/limits.json.  On-call can lift a job's limits for a one-off
backfill by dropping ops/overrides/<job>.json (any of the keys in limits.json); every run
logs the limits it actually used.  Delete the override when the backfill is done.

When a run reaches its wall-clock budget
the job's process group gets SIGTERM; whatever is still alive `grace_seconds` later
gets SIGKILL.  Nothing the job started is left running when this returns.  A run
that starts less than `cooldown_seconds` after the previous run ended waits out the
rest of the cooldown first (the search replicas pick up newly published shards in
between runs).

Exit status: 0 job finished, 75 stopped at the budget (run again to continue),
73 another run of the job holds the lock, anything else: the job failed.
"""
import argparse
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LIMITS_FILE = ROOT / "ops" / "limits.json"
OVERRIDES_DIR = ROOT / "ops" / "overrides"
RUN_DIR = ROOT / "var" / "run"
LOG_FILE = ROOT / "var" / "supervisor.log"
JOBS = {"reindex": [sys.executable, "-m", "reindex.worker"]}
EX_INCOMPLETE, EX_BUSY = 75, 73


class _Interrupted(Exception):
    pass


def _raise_interrupted(signum, frame):
    raise _Interrupted(signal.Signals(signum).name)


def load_limits(job):
    limits = dict(json.loads(LIMITS_FILE.read_text())["jobs"][job])
    override = OVERRIDES_DIR / ("%s.json" % job)
    if override.exists():
        limits.update(json.loads(override.read_text()))
    return (float(limits["budget_seconds"]), float(limits["grace_seconds"]),
            float(limits.get("cooldown_seconds", 0)))


def _cooldown_left(stamp, cooldown):
    try:
        ended = float(stamp.read_text())
    except (OSError, ValueError):
        return 0.0
    return max(0.0, min(cooldown, ended + cooldown - time.time()))


def _signal_group(pgid, sig):
    try:
        os.killpg(pgid, sig)
        return True
    except ProcessLookupError:
        return False


def _stop(proc, grace):
    """SIGTERM the job's group, SIGKILL after the grace period. Returns (rc, outcome)."""
    _signal_group(proc.pid, signal.SIGTERM)
    try:
        return proc.wait(timeout=grace), "stopped"
    except subprocess.TimeoutExpired:
        print("supervise: still running %gs after SIGTERM, sending SIGKILL" % grace, flush=True)
        _signal_group(proc.pid, signal.SIGKILL)
        return proc.wait(), "killed"


def run(job):
    budget, grace, cooldown = load_limits(job)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    lock = open(RUN_DIR / ("%s.lock" % job), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("supervise: another %s run holds the lock" % job, file=sys.stderr)
        return EX_BUSY
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _raise_interrupted)
    stamp = RUN_DIR / ("%s.last" % job)
    waited = _cooldown_left(stamp, cooldown)
    if waited > 0:
        print("supervise: previous %s run ended %.0fs ago, cooldown is %gs: starting in %.0fs"
              % (job, cooldown - waited, cooldown, waited), flush=True)
        try:
            time.sleep(waited)
        except (KeyboardInterrupt, _Interrupted):
            print("supervise: cancelled during cooldown", file=sys.stderr)
            return 130

    started_at = time.strftime("%Y-%m-%dT%H:%M:%S")
    t0 = time.monotonic()
    proc = subprocess.Popen(JOBS[job], cwd=ROOT, start_new_session=True,
                            env=dict(os.environ, SUPERVISED_JOB=job))
    pidfile = RUN_DIR / ("%s.pid" % job)
    pidfile.write_text("%d\n" % proc.pid)
    print("supervise: %s started pid=%d budget=%gs grace=%gs" % (job, proc.pid, budget, grace),
          flush=True)
    stop_latency = None
    try:
        try:
            rc, outcome = proc.wait(timeout=budget), "finished"
        except subprocess.TimeoutExpired:
            print("supervise: budget of %gs reached, sending SIGTERM" % budget, flush=True)
            t_term = time.monotonic()
            rc, outcome = _stop(proc, grace)
            stop_latency = round(time.monotonic() - t_term, 3)
    except (KeyboardInterrupt, _Interrupted):
        t_term = time.monotonic()
        rc, outcome = _stop(proc, grace)
        outcome = "interrupted" if outcome == "stopped" else outcome
        stop_latency = round(time.monotonic() - t_term, 3)
    finally:
        if _signal_group(proc.pid, signal.SIGKILL):   # stragglers left in the job's group
            print("supervise: killed leftover processes of %s" % job, flush=True)
        pidfile.unlink(missing_ok=True)
        stamp.write_text("%.3f\n" % time.time())

    record = {"job": job, "started_at": started_at, "pid": proc.pid,
              "budget_seconds": budget, "grace_seconds": grace, "cooldown_seconds": cooldown,
              "cooldown_waited": round(waited, 1), "outcome": outcome,
              "returncode": rc, "elapsed": round(time.monotonic() - t0, 3),
              "stop_latency": stop_latency}
    with open(LOG_FILE, "a") as fh:
        fh.write(json.dumps(record) + "\n")
    print("supervise: %s %s after %.1fs (rc=%s)" % (job, outcome, record["elapsed"], rc), flush=True)
    if outcome == "finished":
        return 0 if rc == 0 else (rc if rc > 0 else 1)
    if outcome == "stopped":
        print("supervise: %s incomplete; run it again to continue" % job, flush=True)
    return EX_INCOMPLETE


def history(job, limit=10):
    if not LOG_FILE.exists():
        print("no runs recorded")
        return 0
    records = [json.loads(line) for line in LOG_FILE.read_text().splitlines() if line.strip()]
    for rec in [r for r in records if r.get("job") == job][-limit:]:
        print("%(started_at)s  %(outcome)-11s rc=%(returncode)-4s %(elapsed)7.1fs  "
              "budget=%(budget_seconds)gs" % rec)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="supervise.py")
    parser.add_argument("command", choices=("run", "history"))
    parser.add_argument("job", choices=sorted(JOBS))
    args = parser.parse_args(argv)
    return run(args.job) if args.command == "run" else history(args.job)


if __name__ == "__main__":
    sys.exit(main())
{
  "jobs": {
    "reindex": {
      "budget_seconds": 10,
      "grace_seconds": 5,
      "cooldown_seconds": 90
    }
  }
}
# Per-job limit overrides

For one-off backfills on-call can lift a job's limits by adding `<job>.json` here with any of
the keys from `ops/limits.json`, e.g. `{"budget_seconds": 600}`. The supervisor merges it over
`ops/limits.json` and logs the limits each run actually used. Remove the file when the backfill
is done.
import os
import signal
import subprocess
import sys
import tempfile
import time
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from reindex.source import Doc, Source, generate_corpus  # noqa: E402
from reindex.store import ShardWriter, iter_rows, shard_paths  # noqa: E402
from reindex.transform import transform_doc  # noqa: E402


class TransformTest(unittest.TestCase):
    def test_golden_row(self):
        row = transform_doc(Doc(7, "Café Über Zürich", "The naïve résumé of the façade. Café café!", "fr"))
        self.assertEqual(row["slug"], "cafe-uber-zurich")
        self.assertEqual(row["terms"], ["cafe", "facade", "naive", "resume", "uber", "zurich"])
        self.assertEqual(row["length"], 8)
        self.assertEqual(row["checksum"], "fbe4334594f1a63f211e2742efb9681a")
        self.assertEqual(row["minhash"][:4], [51805901, 103584590, 473029234, 2680140])
        self.assertEqual(len(row["minhash"]), 64)

    def test_empty_body(self):
        row = transform_doc(Doc(1, "Untitled", "", "en"))
        self.assertEqual(row["length"], 1)
        self.assertEqual(len(row["minhash"]), 64)


class StoreTest(unittest.TestCase):
    def test_rows_round_trip_across_shards(self):
        with tempfile.TemporaryDirectory() as tmp:
            writer = ShardWriter(tmp, shard_rows=4, buffer_rows=3)
            for i in range(10):
                writer.add({"id": i})
            writer.close()
            self.assertEqual([r["id"] for r in iter_rows(tmp)], list(range(10)))
            self.assertEqual(len(shard_paths(tmp)), 3)


class ResumeTest(unittest.TestCase):
    def _worker(self, tmp):
        return [sys.executable, "-m", "reindex.worker", "--source", str(tmp / "docs.db"),
                "--index-dir", str(tmp / "index"), "--checkpoint", str(tmp / "ckpt.json")]

    def test_stop_and_resume_gives_complete_index(self):
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            generate_corpus(tmp / "docs.db", count=400, seed=5)
            proc = subprocess.Popen(self._worker(tmp), cwd=ROOT, stderr=subprocess.DEVNULL)
            time.sleep(1.5)
            proc.send_signal(signal.SIGTERM)
            proc.wait(timeout=10)
            subprocess.run(self._worker(tmp), cwd=ROOT, check=True, timeout=120,
                           stderr=subprocess.DEVNULL)
            ids = [row["id"] for row in iter_rows(tmp / "index")]
            source = Source(tmp / "docs.db")
            expected = [d.id for batch in source.batches(0, 100) for d in batch]
            source.close()
            self.assertEqual(len(ids), len(set(ids)), "duplicate rows in index")
            self.assertEqual(sorted(ids), expected)


if __name__ == "__main__":
    unittest.main()
