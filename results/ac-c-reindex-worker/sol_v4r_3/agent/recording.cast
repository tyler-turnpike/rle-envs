[78.861279, "i", "    fd, tmp = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                   dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh, sort_keys=True)\n                fh.write(\"\\n\")\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(tmp, self.path)\n            sync_directory(self.path.parent)\n        finally:\n            Path(tmp).unlink(missing_ok=True)\n\n    def clear(self):\n        self.path.unlink(missing_ok=True)\n        if self.path.parent.exists():\n            sync_directory(self.path.parent)\nEOF\npython3 - <<'PY'\np='reindex/store.py'\ns=open(p).read().replace('from pathlib import Path\\n','from pathlib import Path\\n\\nfrom reindex.durable import sync_directory\\n')\ns=s.replace('        self.index_dir.mkdir(parents=True, exist_ok=True)\\n','        self.index_dir.mkdir(parents=True, exist_ok=True)\\n        sync_directory(self.index_dir.parent)\\n')\ns=s.replace('      "]
