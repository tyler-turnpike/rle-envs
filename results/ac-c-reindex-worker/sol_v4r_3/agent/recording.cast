[132.150121, "i", "cat > /tmp/search412-backfill.sh <<'EOF'\n#!/bin/bash\nset -u\ncd /app\ntrap 'rm -f ops/overrides/reindex.json' EXIT\nprintf '{\"cooldown_seconds\": 0}\\n' > ops/overrides/reindex.json\nfor attempt in $(seq 1 30); do\n  ./jobs reindex\n  rc=$?\n  if [ \"$rc\" != 0 ] && [ \"$rc\" != 75 ]; then exit \"$rc\"; fi\n  python3 - <<'PY'\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\ns = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nsource = Source('data/docs.db')\nexpected = [d.id for batch in source.batches(size=300) for d in batch]\nsource.close()\nids = [r['id'] for r in rows]\nassert ids == expected[:s['docs']], (len(ids), s)\nassert len(set(ids)) == len(ids)\nassert s['last_id'] == (ids[-1] if ids else 0)\nassert s['shards'] == {p.name: p.stat().st_size for p in shard_paths('var/index')}\nassert not s['complete'] or len(ids) == len(expected)\nprint('AUDIT: %d committed rows; complete=%s' % (len(ids), s['complete']), flush=True)\nPY\n "]
[132.15046, "i", " if [ \"$?\" != 0 ]; then exit 1; fi\n  if [ \"$rc\" = 0 ]; then ./jobs status; exit 0; fi\ndone\nexit 1\nEOF\nbash /tmp/search412-backfill.sh > var/backfill.log 2>&1 & echo \"backfill monitor pid=$!\"\n"]
