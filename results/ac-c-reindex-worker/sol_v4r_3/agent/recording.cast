[206.247791, "i", "(tmp, committed)), [{'id': 1, 'text': 'café'}])\n            self.assertEqual(path.read_bytes(), before)\n\n''' + s[pos:];open(p,'w').write(s)\nPY\n./jobs test > var/tests.log 2>&1 & echo \"test pid=$!\"\n"]
