[173.391084, "o", "                log.info(\"stopped safely: last_id=%d docs=%d/%d\",\r\n"]
[173.391164, "o", "                         state[\"last_id\"], state[\"docs\"], total)\r\n"]
[173.391212, "o", "                return 75\r\n"]
[173.391236, "o", "            if n % 20 == 0:\r\n"]
[173.391254, "o", "                rate = (state[\"docs\"] - initial_docs) / max(time.monotonic() - started, 0.001)\r\n"]
[173.39129, "o", "                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n"]
[173.391304, "o", "                         state[\"last_id\"], state[\"docs\"], total, rate)\r\n"]
