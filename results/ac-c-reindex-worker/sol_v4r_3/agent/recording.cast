[6.167578, "o", "#!/bin/bash\r\n# Team job entry points.  Usage: ./jobs <command>\r\n#   reindex   run (or continue) the search reindex under the job supervisor\r\n#   status    progress of the current reindex\r\n#   history   recent supervised runs\r\n#   test      unit tests\r\n#   clean     drop the index and checkpoint (next reindex starts from scratch)\r\nset -euo pipefail\r\ncd \"$(dirname \"$0\")\"\r\nPY=${PY:-python3}\r\ncase \"${1:-}\" in\r\n  reindex) exec \"$PY\" ops/supervise.py run reindex ;;\r\n  status)  exec \"$PY\" -m reindex.worker --status ;;\r\n  history) exec \"$PY\" ops/supervise.py history reindex ;;\r\n  test)    exec \"$PY\" -m unittest discover -s tests -v ;;\r\n  clean)   rm -rf var/index var/checkpoint.json ;;\r\n  *) sed -n '2,8p' \"$0\"; exit 2 ;;\r\nesac\r\n"]
[6.168959, "o", "ops:\r\ntotal 24\r\ndrwxr-xr-x 3 root root 4096 Nov 22 18:00 .\r\ndrwxr-xr-x 1 root root 4096 Nov 22 18:00 ..\r\n-rw-r--r-- 1 root root  126 Nov 22 15:55 limits.json\r\ndrwxr-xr-x 2 root root 4096 Nov 22 18:00 overrides\r\n-rwxr-xr-x 1 root root 6550 Nov 22 18:00 supervise.py\r\n\r\nreindex:\r\ntotal 32\r\ndrwxr-xr-x 1 root root 4096 Nov 22 18:00 .\r\ndrwxr-xr-x 1 root root 4096 Nov 22 18:00 ..\r\n-rw-r--r-- 1 root root    0 Nov 22 15:02 __init__.py\r\ndrwxr-xr-x 2 root root 4096 Nov 22 18:00 __pycache__\r\n-rw-r--r-- 1 root root  989 Nov 22 15:02 checkpoint.py\r\n-rw-r--r-- 1 root root 3880 Nov 22 15:02 source.py\r\n-rw-r--r-- 1 root root 2795 Nov 22 15:02 store.py\r\n-rw-r--r-- 1 root root 2328 Nov 22 15:01 transform.py\r\n-rw-r--r-- 1 root root 3340 Nov 22 15:02 worker.py\r\n"]
