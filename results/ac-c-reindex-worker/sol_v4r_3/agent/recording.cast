[97.593538, "i", "cat reindex/store.py; sed -n '90,125p' reindex/source.py; ls -la var\n"]
[97.595211, "o", "cat reindex/store.py; sed -n '90,125p' reindex/source.py; ls -la var\r\n\u001b[?2004l\r"]
[97.59716, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\n"]
[97.597369, "o", "Each line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durable import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index"]
[97.597456, "o", "_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        sync_directory(self.index_dir.parent)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        self._buffer.clear()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n        sync_directory(self.index_dir)\r\n\r\n    def snapshot(self):\r\n        \"\"\"Make all output durable before its lengths enter a checkpoint.\"\"\"\r\n        self.flush()\r\n        sync_d"]
[97.597535, "o", "irectory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n\r\n    def recover(self, committed):\r\n        \"\"\"Roll back partial writes/new shards to the last committed snapshot.\r\n\r\n        Validate the entire manifest before changing anything. Missing committed\r\n        bytes are an error, not a reason to skip source documents silently.\r\n        Recovery is idempotent, including if interrupted during truncation.\r\n        \"\"\"\r\n        self._close_shard()\r\n        self._buffer.clear()\r\n        for name, size in committed.items():\r\n            try:\r\n                number = int(name.removeprefix(\"shard-\").removesuffix(\".jsonl\"))\r\n            except (ValueError, AttributeError):\r\n                raise ValueError(\"invalid shard name in checkpoint: %r\" % name)\r\n            if (number < 0 or name != \"shard-%05d.jsonl\" % number\r\n                    or type(size) is not int or size < 0):\r\n                raise ValueError(\"invalid shard manifest entry: %r\" % name)\r\n          "]
[97.597624, "o", "  path = self.index_dir / name\r\n            if not path.is_file() or path.stat().st_size < size:\r\n                raise ValueError(\"committed shard missing or truncated: %s\" % path)\r\n        for path in shard_paths(self.index_dir):\r\n            if path.name not in committed:\r\n                path.unlink()\r\n            elif path.stat().st_size != committed[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(committed[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        # Start a new shard on resume; boundaries have no search semantics.\r\n        self._next_shard = self._first_free_shard()\r\n        self._rows_in_shard = 0\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is "]
[97.597713, "o", "None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            # Rotation may occur in the middle of a buffered block. Every\r\n            # rotated shard must be durable, not just the final shard.\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r"]
[97.597723, "o", "\n"]
