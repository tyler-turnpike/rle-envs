[206.457534, "i", "cat > /tmp/search412-verify.py <<'PY'\nimport json\nimport time\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nwhile not Checkpoint('var/checkpoint.json').load()['complete']:\n    time.sleep(2)\nstate = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nsource = Source('data/docs.db')\nexpected_ids = [row[0] for row in source.conn.execute('SELECT id FROM docs WHERE deleted=0 ORDER BY id')]\nassert [row['id'] for row in rows] == expected_ids\nassert len(rows) == len({r['id'] for r in rows}) == state['docs'] == source.count()\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths('var/index')}\nn = 0\nfor batch in source.batches(size=100):\n    for doc in batch:\n        assert rows[n] == transform_doc(doc), 'row mismatch: %s' % doc.id\n        n += 1\n    print('Verified %d/%d full rows' % (n, len(rows)), flush=True)\nsource.close()\nas"]
[206.457613, "i", "sert n == len(rows)\nreport = {'verified_rows': n, 'unique_ids': len(set(expected_ids)), 'complete': state['complete'],\n          'last_id': state['last_id'], 'all_fields_match_transform': True,\n          'shards': len(state['shards'])}\nPath('var/verification.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint(json.dumps(report), flush=True)\nPY\nPYTHONPATH=/app python3 /tmp/search412-verify.py > var/verification.log 2>&1 & echo \"verification pid=$!\"; tail -10 var/backfill.log\n"]
