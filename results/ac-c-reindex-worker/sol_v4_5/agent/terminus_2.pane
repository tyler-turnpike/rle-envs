[?2004l"""Index storage: JSON-lines shards under var/index/.

Each line is one index row (see reindex.transform).  The search service loads every
`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are
buffered and written out in blocks (one write + fsync per block) because the index
volume is network storage in production and small appends are slow there.
"""
import json
import os
from pathlib import Path

from reindex.checkpoint import sync_directory

SHARD_ROWS = 1000      # rows per shard file before rotating
BUFFER_ROWS = 200      # rows held in memory before a block write


def shard_paths(index_dir):
    return sorted(Path(index_dir).glob("shard-*.jsonl"))


def iter_rows(index_dir, positions=None):
    """Read all rows, or just the committed byte ranges of a checkpoint."""
    paths = shard_paths(index_dir) if positions is None else [
        Path(index_dir) / name for name in sorted(positions)]
    for path in paths:
        with open(path, "rb") as fh:
            limit = None if positions is None else positions[path.name]
            while limit is None or fh.tell() < limit:
                line = fh.readline()
                if not line:
                    break
                if line.strip():
                    yield json.loads(line)


class ShardWriter:
    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):
        self.index_dir = Path(index_dir)
        self.index_dir.mkdir(parents=True, exist_ok=True)
        sync_directory(self.index_dir.parent)
        self.shard_rows = shard_rows
        self.buffer_rows = buffer_rows
        self._buffer = []
        self._fh = None
        self._rows_in_shard = 0
        self._next_shard = self._first_free_shard()

    def _first_free_shard(self):
        numbers = [int(p.stem.split("-", 1)[1]) for p in shard_paths(self.index_dir)]
        return max(numbers) + 1 if numbers else 0

    @property
    def pending(self):
        return len(self._buffer)

    def reset(self):
        """Drop every shard (used when a reindex starts from scratch)."""
        self._close_shard()
        for path in shard_paths(self.index_dir):
            path.unlink()
        self._next_shard = 0
        self._rows_in_shard = 0
        self._buffer.clear()
        sync_directory(self.index_dir)

    def recover(self, positions):
        """Discard writes newer than the atomic checkpoint, including torn lines.

        Validate committed files before making changes: missing committed bytes
        indicate corruption, not a reason to silently advance or restart.
        """
        if self._fh is not None or self._buffer:
            raise RuntimeError("recover must precede writing")
        for name, size in positions.items():
            if (Path(name).name != name or not name.startswith("shard-")
                    or not name.endswith(".jsonl") or size < 0):
                raise ValueError("invalid shard checkpoint")
            path = self.index_dir / name
            if not path.exists() or path.stat().st_size < size:
                raise RuntimeError("committed shard bytes missing: %s" % path)
        for path in shard_paths(self.index_dir):
            if path.name not in positions:
                path.unlink()
            elif path.stat().st_size != positions[path.name]:
                with open(path, "r+b") as fh:
                    fh.truncate(positions[path.name])
                    fh.flush()
                    os.fsync(fh.fileno())
        sync_directory(self.index_dir)
        self._next_shard = self._first_free_shard()

    def snapshot(self):
        """Durably flush rows before publishing their offsets in a checkpoint."""
        self.flush()
        sync_directory(self.index_dir)
        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}

    def add(self, row):
        self._buffer.append(row)
        if len(self._buffer) >= self.buffer_rows:
            self.flush()

    def flush(self):
        if not self._buffer:
            return
        for row in self._buffer:
            if self._fh is None or self._rows_in_shard >= self.shard_rows:
                self._rotate()
            self._fh.write(json.dumps(row, sort_keys=True, separators=(",", ":"),
                                      ensure_ascii=False) + "\n")
            self._rows_in_shard += 1
        self._sync_shard()
        self._buffer.clear()

    def _rotate(self):
        self._close_shard()
        path = self.index_dir / ("shard-%05d.jsonl" % self._next_shard)
        self._fh = open(path, "a", encoding="utf-8")
        self._next_shard += 1
        self._rows_in_shard = 0

    def _sync_shard(self):
        if self._fh is not None:
            self._fh.flush()
            os.fsync(self._fh.fileno())

    def _close_shard(self):
        if self._fh is not None:
            self._sync_shard()
            self._fh.close()
            self._fh = None

    def close(self):
        self.flush()
        self._close_shard()
        sync_directory(self.index_dir)

    def abort(self):
        """Close without publishing buffered work; recovery discards disk tails."""
        self._buffer.clear()
        self._close_shard()
"""Reindex worker: data/docs.db -> var/index/shard-*.jsonl.

Normally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).
Progress is kept in var/checkpoint.json so the next run continues where the last
one stopped; a run with no checkpoint rebuilds the index from scratch.

    python3 -m reindex.worker            run / resume
    python3 -m reindex.worker --status   print progress
"""
import argparse
import logging
import signal
import sys
import time
from pathlib import Path

from reindex.checkpoint import Checkpoint
from reindex.source import Source
from reindex.store import ShardWriter, iter_rows
from reindex.transform import transform_doc

ROOT = Path(__file__).resolve().parent.parent
BATCH_SIZE = 25

log = logging.getLogger("reindex.worker")


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="reindex.worker")
    parser.add_argument("--source", default=str(ROOT / "data" / "docs.db"))
    parser.add_argument("--index-dir", default=str(ROOT / "var" / "index"))
    parser.add_argument("--checkpoint", default=str(ROOT / "var" / "checkpoint.json"))
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--status", action="store_true", help="print progress and exit")
    args = parser.parse_args(argv)
    if args.batch_size <= 0:
        parser.error("--batch-size must be positive")
    return args


def show_status(args):
    state = Checkpoint(args.checkpoint).load()
    source = Source(args.source)
    total = source.count()
    source.close()
    rows = list(iter_rows(args.index_dir, state["shards"]))
    unique = len({row["id"] for row in rows})
    print("checkpoint : %s" % state)
    print("source     : %d live docs" % total)
    print("index      : %d rows, %d unique ids (%.1f%% of source)"
          % (len(rows), unique, 100.0 * unique / max(total, 1)))
    return 0


def run(args):
    # A handler only requests a stop. Never interrupt a write/checkpoint halfway
    # through, and check between documents rather than waiting for a whole batch.
    stopping = False

    def request_stop(signum, frame):
        nonlocal stopping
        stopping = True

    previous_handlers = {sig: signal.signal(sig, request_stop)
                         for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    source = store = None
    try:
        ckpt = Checkpoint(args.checkpoint)
        state = ckpt.load()
        store = ShardWriter(args.index_dir)
        store.recover(state["shards"])
        if state["complete"]:
            log.info("index already complete (%d docs)", state["docs"])
            return 0
        source = Source(args.source)
        total = source.count()
        started = time.monotonic()
        initial_docs = state["docs"]
        log.info("starting after id %d (%d/%d docs done)",
                 state["last_id"], state["docs"], total)

        def commit():
            # Ordering is essential: durable data, then atomic durable checkpoint.
            # A kill in between leaves only an uncommitted tail to roll back.
            state["shards"] = store.snapshot()
            ckpt.save(state)

        # Source.batches is inclusive; last_id is the last *committed* document.
        batches = source.batches(start_id=state["last_id"] + 1, size=args.batch_size)
        for n, batch in enumerate(batches, 1):
            processed = 0
            for doc in batch:
                if stopping:
                    break
                store.add(transform_doc(doc))
                state["last_id"] = doc.id
                state["docs"] += 1
                processed += 1
            if processed:
                commit()
            if stopping:
                log.info("stopped after id %d (%d/%d docs committed)",
                         state["last_id"], state["docs"], total)
                return 75
            if n % 20 == 0:
                rate = (state["docs"] - initial_docs) / (time.monotonic() - started)
                log.info("progress: last_id=%d docs=%d/%d (%.0f docs/s)",
                         state["last_id"], state["docs"], total, rate)

        if stopping:
            return 75
        state["complete"] = True
        commit()
        log.info("reindex complete: %d docs", state["docs"])
        return 0
    finally:
        try:
            if store is not None:
                store.abort()
            if source is not None:
                source.close()
        finally:
            for sig, handler in previous_handlers.items():
                signal.signal(sig, handler)


def main(argv=None):
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(asctime)s %(name)s %(levelname)s %(message)s")
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.status:
        return show_status(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
