[76.62237, "i", "python3 - <<'PY'\np='reindex/worker.py'\ns=open(p).read().replace('`make reindex`', '`./jobs reindex`').replace('import logging\\n', 'import logging\\nimport signal\\n')\ns=s.replace('    return parser.parse_args(argv)', '    args = parser.parse_args(argv)\\n    if args.batch_size <= 0:\\n        parser.error(\"--batch-size must be positive\")\\n    return args')\ns=s.replace('    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []', '    rows = list(iter_rows(args.index_dir, state[\"shards\"]))')\na=s.index('def run(args):'); b=s.index('\\n\\ndef main(', a)\ns=s[:a]+'''def run(args):\n    # A handler only requests a stop. Never interrupt a write/checkpoint halfway\n    # through, and check between documents rather than waiting for a whole batch.\n    stopping = False\n\n    def request_stop(signum, frame):\n        nonlocal stopping\n        stopping = True\n\n    previous_handlers = {sig: signal.signal(sig, request_stop)\n                         for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\n  "]
