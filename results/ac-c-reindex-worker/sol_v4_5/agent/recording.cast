[120.704252, "i", ".args.index_dir, state['shards'])))\n\n    def test_atomic_checkpoint_preserves_previous_on_replace_failure(self):\n        old = {'last_id': 3, 'docs': 2, 'complete': False, 'shards': {}}\n        self.ckpt.save(old)\n        with mock.patch('reindex.checkpoint.os.replace', side_effect=OSError('injected')):\n            with self.assertRaises(OSError):\n                self.ckpt.save(dict(old, docs=4))\n        self.assertEqual(self.ckpt.load(), old)\n        self.assertFalse(Path(self.args.checkpoint + '.tmp').exists())\n\n    def test_commit_is_durable_and_resume_cursor_is_exclusive(self):\n        save = Checkpoint.save\n\n        def stop_after_first_commit(ckpt, state):\n            self.assertEqual(len(list(iter_rows(self.args.index_dir))), state['docs'])\n            save(ckpt, state)\n            raise RuntimeError('crash after checkpoint')\n\n        with mock.patch.object(Checkpoint, 'save', stop_after_first_commit):\n            with self.assertRaisesRegex(RuntimeError, 'crash after'):\n                run(self.args)\n"]
[120.704262, "i", "        self.assertEqual(self.ckpt.load()['last_id'], 3)\n        self.assertEqual(run(self.args), 0)\n        self.assert_complete()\n        before = {p.name: p.read_bytes() for p in shard_paths(self.args.index_dir)}\n        self.assertEqual(run(self.args), 0)\n        self.assertEqual(before, {p.name: p.read_bytes() for p in shard_paths(self.args.index_dir)})\n\n    def test_sigkill_at_commit_windows(self):\n        # First checkpoint commits IDs 1 and 3. Kill during publication of the\n        # second one, once before rename and once after: both must resume exactly.\n        for after_replace in (False, True):\n            with self.subTest(after_replace=after_replace):\n                code = '''\nimport os, signal, sys\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.worker import main\nsave = Checkpoint.save\ncalls = 0\ndef crash(self, state):\n    global calls\n    calls += 1\n    if calls == 2:\n        if AFTER:\n            save(self, state)\n        else:\n            with open(str(self.path) + '.tmp', 'w') as f"]
[120.704268, "i", "h:\n                fh.write('{\"last_id\":')\n        os.kill(os.getpid(), signal.SIGKILL)\n    save(self, state)\nCheckpoint.save = crash\nsys.exit(main(sys.argv[1:]))\n'''.replace('AFTER', repr(after_replace))\n                proc = subprocess.run([sys.executable, '-c', code] + self.argv,\n                                      cwd=ROOT, stderr=subprocess.DEVNULL, timeout=10)\n                self.assertEqual(proc.returncode, -signal.SIGKILL)\n                state = self.ckpt.load()\n                self.assertEqual(state['docs'], 4 if after_replace else 2)\n                self.assertEqual(len(list(iter_rows(self.args.index_dir, state['shards']))), state['docs'])\n                self.assertEqual(run(self.args), 0)\n                self.assert_complete()\n                for path in shard_paths(self.args.index_dir):\n                    path.unlink()\n                self.ckpt.clear()\n\n    def test_recover_partial_tails_and_uncommitted_rotated_shards(self):\n        writer = ShardWriter(self.args.index_dir, shard_rows=2, bu"]
