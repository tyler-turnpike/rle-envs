[58.764423, "i", "cat > reindex/checkpoint.py <<'PY'\n\"\"\"Atomic, durable reindex progress and committed shard byte offsets.\"\"\"\nimport json\nimport logging\nimport os\nfrom pathlib import Path\n\nlog = logging.getLogger(\"reindex.checkpoint\")\n\n\ndef sync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef fresh_state():\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False, \"shards\": {}}\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text())\n        except FileNotFoundError:\n            return fresh_state()\n        except ValueError:\n            log.warning(\"checkpoint %s unreadable, starting over\", self.path)\n            return fresh_state()\n        # Old checkpoints may describe buffered, lost rows. They cannot safely be\n        # resumed; rebuild them once rather than preserving an incomplete index.\n        if \"shards\" not in data:\n  "]
[58.764471, "i", "          log.warning(\"legacy checkpoint has no durable offsets; rebuilding\")\n            return fresh_state()\n        state = fresh_state()\n        state.update(data)\n        return state\n\n    def save(self, state):\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        temporary = self.path.with_name(self.path.name + \".tmp\")\n        try:\n            with open(temporary, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh, sort_keys=True)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(temporary, self.path)\n            sync_directory(self.path.parent)\n        finally:\n            temporary.unlink(missing_ok=True)\n\n    def clear(self):\n        self.path.unlink(missing_ok=True)\n        sync_directory(self.path.parent)\nPY\npython3 - <<'PY'\np='reindex/store.py'\ns=open(p).read().replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.checkpoint import sync_directory\\n')\na=s.index('def iter_rows('); b=s.index('\\n\\nclass Shard"]
[58.764476, "i", "Writer:', a)\ns=s[:a]+'''def iter_rows(index_dir, positions=None):\n    \"\"\"Read all rows, or just the committed byte ranges of a checkpoint.\"\"\"\n    paths = shard_paths(index_dir) if positions is None else [\n        Path(index_dir) / name for name in sorted(positions)]\n    for path in paths:\n        with open(path, \"rb\") as fh:\n            limit = None if positions is None else positions[path.name]\n            while limit is None or fh.tell() < limit:\n                line = fh.readline()\n                if not line:\n                    break\n                if line.strip():\n                    yield json.loads(line)\n''' + s[b:]\ns=s.replace('        self._next_shard = 0\\n\\n    def add', '''        self._next_shard = 0\n        self._rows_in_shard = 0\n        self._buffer.clear()\n        sync_directory(self.index_dir)\n\n    def recover(self, positions):\n        \"\"\"Discard writes newer than the atomic checkpoint, including torn lines.\n\n        Validate committed files before making changes: missing committed bytes\n  "]
[58.764481, "i", "      indicate corruption, not a reason to silently advance or restart.\n        \"\"\"\n        if self._fh is not None or self._buffer:\n            raise RuntimeError(\"recover must precede writing\")\n        for name, size in positions.items():\n            if (Path(name).name != name or not name.startswith(\"shard-\")\n                    or not name.endswith(\".jsonl\") or size < 0):\n                raise ValueError(\"invalid shard checkpoint\")\n            path = self.index_dir / name\n            if not path.exists() or path.stat().st_size < size:\n                raise RuntimeError(\"committed shard bytes missing: %s\" % path)\n        for path in shard_paths(self.index_dir):\n            if path.name not in positions:\n                path.unlink()\n            elif path.stat().st_size != positions[path.name]:\n                with open(path, \"r+b\") as fh:\n                    fh.truncate(positions[path.name])\n                    fh.flush()\n                    os.fsync(fh.fileno())\n        sync_directory(self.index_dir)\n    "]
[58.764486, "i", "    self._next_shard = self._first_free_shard()\n\n    def snapshot(self):\n        \"\"\"Durably flush rows before publishing their offsets in a checkpoint.\"\"\"\n        self.flush()\n        sync_directory(self.index_dir)\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\n\n    def add''')\ns=s.replace('        self._fh.flush()\\n        os.fsync(self._fh.fileno())\\n        self._buffer.clear()', '        self._sync_shard()\\n        self._buffer.clear()')\ns=s.replace('    def _close_shard(self):\\n        if self._fh is not None:\\n            self._fh.close()', '''    def _sync_shard(self):\n        if self._fh is not None:\n            self._fh.flush()\n            os.fsync(self._fh.fileno())\n\n    def _close_shard(self):\n        if self._fh is not None:\n            self._sync_shard()\n            self._fh.close()''')\ns=s.replace('    def close(self):\\n        self.flush()\\n        self._close_shard()', '''    def close(self):\n        self.flush()\n        self._close_shard()\n        sync_directo"]
