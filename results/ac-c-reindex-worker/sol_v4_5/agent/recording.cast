[231.061614, "i", "cat > /tmp/verify-reindex.py <<'PY'\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nsys.path.insert(0, '/app')\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\nfrom reindex.worker import parse_args, run\n\nfinished = Path('/tmp/reindex-backfill.rc')\nwhile not finished.exists():\n    time.sleep(2)\nassert finished.read_text().strip() == '0', 'backfill did not finish successfully'\nstate = Checkpoint('/app/var/checkpoint.json').load()\nassert state['complete']\nrows = list(iter_rows('/app/var/index'))\nids = [row['id'] for row in rows]\nassert len(ids) == len(set(ids)) == state['docs']\nsource = Source('/app/data/docs.db')\ndocs = [doc for batch in source.batches(0, 100) for doc in batch]\nsource.close()\nassert ids == [doc.id for doc in docs], 'index ID set/order differs from live corpus'\nprint('IDs verified:', len(ids), 'live documents, zero duplicates', flush=True)\nfor i, (doc"]
[231.061883, "i", ", row) in enumerate(zip(docs, rows), 1):\n    assert row == transform_doc(doc), 'row content differs for ID %s' % doc.id\n    if i % 1000 == 0:\n        print('Full row contents verified:', i, flush=True)\nassert state['last_id'] == docs[-1].id\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths('/app/var/index')}\n\ndef fingerprints():\n    return {p.name: hashlib.sha256(p.read_bytes()).hexdigest()\n            for p in shard_paths('/app/var/index')}\nbefore = fingerprints()\ncheckpoint_before = Path('/app/var/checkpoint.json').read_bytes()\nassert run(parse_args([])) == 0\nassert before == fingerprints()\nassert checkpoint_before == Path('/app/var/checkpoint.json').read_bytes()\nreport = {'live_documents': len(docs), 'index_rows': len(rows),\n          'unique_ids': len(set(ids)), 'all_row_contents_match': True,\n          'complete_run_is_noop': True, 'shard_sha256': before}\nPath('/app/var/index-verification.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint('PASS: complete index, all row fi"]
[231.061902, "o", "cat > /tmp/verify-reindex.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path"]
[231.061908, "i", "elds unchanged, completed rerun is a no-op', flush=True)\nPY\n(python3 /tmp/verify-reindex.py > /tmp/reindex-verification.log 2>&1; echo \"$?\" > /tmp/reindex-verification.rc) &\n"]
[231.064807, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0, '/app')\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import Source\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.store import iter_rows, shard_paths\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.transform import transform_doc\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.worker import parse_args, run\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.064848, "o", "finished = Path('/tmp/reindex-backfill.rc')"]
[231.06522, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.065799, "o", "> while not finished.exists():\r\n\u001b[?2004l\r\u001b[?2004h>     time.sleep(2)"]
[231.065973, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.066022, "o", "> assert finished.read_text().strip() == '0', 'backfill did not finish successfully'"]
[231.066086, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.067593, "o", "> "]
[231.067772, "o", "state = Checkpoint('/app/var/checkpoint.json').load()"]
[231.067818, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> assert state['complete']\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.067869, "o", "> "]
[231.067873, "o", "rows = list(iter_rows('/app/var/index'))"]
[231.068093, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ids = [row['id'] for row in rows]"]
[231.068114, "o", "\r\n"]
[231.068138, "o", "\u001b[?2004l\r"]
[231.068144, "o", "\u001b[?2004h"]
[231.068314, "o", "> assert len(ids) == len(set(ids)) == state['docs']"]
[231.068337, "o", "\r\n"]
[231.068353, "o", "\u001b[?2004l\r"]
[231.068396, "o", "\u001b[?2004h"]
[231.06852, "o", "> source = Source('/app/data/docs.db')"]
[231.068626, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.068699, "o", "> "]
[231.068704, "o", "docs = [doc for batch in source.batches(0, 100) for doc in batch]"]
[231.06883, "o", "\r\n\u001b[?2004l\r"]
[231.068871, "o", "\u001b[?2004h"]
[231.068942, "o", "> source.close()"]
[231.069021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.06913, "o", "> "]
[231.069138, "o", "assert ids == [doc.id for doc in docs], 'index ID set/order differs from live corpus'"]
[231.069223, "o", "\r\n"]
[231.06931, "o", "\u001b[?2004l\r\u001b[?2004h"]
[231.069432, "o", "> print('IDs verified:', len(ids), 'live documents, zero duplicates', flush=True)"]
[231.069494, "o", "\r\n"]
[231.069618, "o", "\u001b[?2004l\r\u001b[?2004h"]
[231.06973, "o", "> for i, (doc, row) in enumerate(zip(docs, rows), 1):"]
[231.069826, "o", "\r\n"]
[231.069909, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[231.07004, "o", "    assert row == transform_doc(doc), 'row content differs for ID %s' % doc.id"]
[231.070119, "o", "\r\n"]
[231.07021, "o", "\u001b[?2004l\r\u001b[?2004h"]
[231.070282, "o", ">     if i % 1000 == 0:"]
[231.070472, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.070483, "o", "        print('Full row contents verified:', i, flush=True)"]
[231.070557, "o", "\r\n"]
[231.07057, "o", "\u001b[?2004l\r"]
[231.070617, "o", "\u001b[?2004h"]
[231.070646, "o", "> "]
[231.070772, "o", "assert state['last_id'] == docs[-1].id"]
[231.07079, "o", "\r\n"]
[231.070971, "o", "\u001b[?2004l\r\u001b[?2004h> assert state['shards'] == {p.name: p.stat().st_size for p in shard_paths('/app/var/index')}"]
[231.071055, "o", "\r\n"]
[231.07113, "o", "\u001b[?2004l\r"]
[231.071204, "o", "\u001b[?2004h"]
[231.07129, "o", "> \r\n"]
[231.071298, "o", "\u001b[?2004l\r"]
[231.071328, "o", "\u001b[?2004h"]
[231.071451, "o", "> def fingerprints():"]
[231.07147, "o", "\r\n"]
[231.07148, "o", "\u001b[?2004l\r"]
[231.071647, "o", "\u001b[?2004h>     return {p.name: hashlib.sha256(p.read_bytes()).hexdigest()"]
[231.071723, "o", "\r\n"]
[231.071771, "o", "\u001b[?2004l\r"]
[231.071907, "o", "\u001b[?2004h>             for p in shard_paths('/app/var/index')}"]
[231.071975, "o", "\r\n"]
[231.071987, "o", "\u001b[?2004l\r"]
[231.072275, "o", "\u001b[?2004h> before = fingerprints()"]
[231.072318, "o", "\r\n"]
[231.072329, "o", "\u001b[?2004l\r"]
[231.072492, "o", "\u001b[?2004h> checkpoint_before = Path('/app/var/checkpoint.json').read_bytes()"]
[231.072563, "o", "\r\n"]
[231.07261, "o", "\u001b[?2004l\r"]
[231.072665, "o", "\u001b[?2004h"]
[231.072784, "o", "> assert run(parse_args([])) == 0"]
[231.072816, "o", "\r\n"]
[231.072827, "o", "\u001b[?2004l\r"]
[231.072863, "o", "\u001b[?2004h"]
[231.072975, "o", "> assert before == fingerprints()"]
[231.073051, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.073065, "o", "> "]
[231.073196, "o", "assert checkpoint_before == Path('/app/var/checkpoint.json').read_bytes()"]
[231.073258, "o", "\r\n"]
[231.073328, "o", "\u001b[?2004l\r"]
[231.073335, "o", "\u001b[?2004h"]
[231.073472, "o", "> report = {'live_documents': len(docs), 'index_rows': len(rows),"]
[231.073569, "o", "\r\n\u001b[?2004l\r"]
[231.073576, "o", "\u001b[?2004h"]
[231.073618, "o", "> "]
[231.073778, "o", "          'unique_ids': len(set(ids)), 'all_row_contents_match': True,"]
[231.073841, "o", "\r\n"]
[231.07386, "o", "\u001b[?2004l\r"]
[231.074017, "o", "\u001b[?2004h"]
[231.074027, "o", ">           'complete_run_is_noop': True, 'shard_sha256': before}"]
[231.074104, "o", "\r\n"]
[231.074147, "o", "\u001b[?2004l\r"]
[231.074228, "o", "\u001b[?2004h"]
[231.074242, "o", "> "]
[231.07437, "o", "Path('/app/var/index-verification.json').write_text(json.dumps(report, indent=2) + '\\n')"]
[231.074443, "o", "\r\n"]
[231.074882, "o", "\u001b[?2004l\r\u001b[?2004h> print('PASS: complete index, all row fields unchanged, completed rerun is a no-op', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
