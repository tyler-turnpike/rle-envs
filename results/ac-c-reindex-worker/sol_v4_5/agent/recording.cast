[120.704234, "i", ", 14, 18, 23, 29)])\n        conn.commit()\n        conn.close()\n        self.argv = ['--source', str(self.root / 'docs.db'),\n                     '--index-dir', str(self.root / 'index'),\n                     '--checkpoint', str(self.root / 'ckpt.json'), '--batch-size', '2']\n        self.args = parse_args(self.argv)\n        self.ckpt = Checkpoint(self.args.checkpoint)\n\n    def expected(self):\n        source = Source(self.args.source)\n        try:\n            return [transform_doc(doc) for batch in source.batches(0, 100) for doc in batch]\n        finally:\n            source.close()\n\n    def assert_complete(self):\n        rows = list(iter_rows(self.args.index_dir))\n        self.assertEqual(rows, self.expected())\n        self.assertEqual(len(rows), len({row['id'] for row in rows}))\n        state = self.ckpt.load()\n        self.assertTrue(state['complete'])\n        self.assertEqual(state['docs'], len(rows))\n        self.assertEqual(state['last_id'], rows[-1]['id'])\n        self.assertEqual(rows, list(iter_rows(self"]
