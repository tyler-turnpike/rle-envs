[172.505018, "i", "python3 - <<'PY'\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.store import iter_rows\nfrom reindex.source import Source\nstate = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nsrc = Source('data/docs.db')\nexpected_ids = [doc.id for batch in src.batches(0, 100) for doc in batch if doc.id <= state['last_id']]\nsrc.close()\nassert [row['id'] for row in rows] == expected_ids\nassert len(rows) == state['docs']\nassert len(rows) == len({row['id'] for row in rows})\nprint('Committed prefix verified:', len(rows), 'rows through ID', state['last_id'])\nPY\nprintf '{\"budget_seconds\": 600, \"cooldown_seconds\": 0}\\n' > ops/overrides/reindex.json\n(./jobs reindex > /tmp/reindex-backfill.log 2>&1; rc=$?; rm -f ops/overrides/reindex.json; echo \"$rc\" > /tmp/reindex-backfill.rc) &\n"]
