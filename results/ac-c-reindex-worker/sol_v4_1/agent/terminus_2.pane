python3 - <<'PY'
import subprocess
from pathlib import Path
from reindex.checkpoint import Checkpoint
from reindex.source import Source
from reindex.store import iter_rows
try:
    previous = Checkpoint('var/checkpoint.json').load()['docs']
    for attempt in range(30):
        state = Checkpoint('var/checkpoint.json').load()
        if state['complete']:
            print('Backfill complete.', flush=True)
            break
        rc = subprocess.run(['./jobs', 'reindex']).returncode
        assert rc in (0, 75), 'unexpected supervisor return code %s' % rc
        state = Checkpoint('var/checkpoint.json').load()
        rows = list(iter_rows('var/index'))
        source = Source('data/docs.db')
        expected = [d.id for batch in source.batches(0, 100) for d in batch if d.id <= state['last_id']]
        source.close()
        assert [r['id'] for r in rows] == expected
        assert len(rows) == state['docs'] > previous
        previous = state['docs']
        print('Verified durable prefix: %d documents' % previous, flush=True)
    else:
        raise RuntimeError('backfill did not converge')
finally:
    Path('ops/overrides/reindex.json').unlink(missing_ok=True)
PY
