[66.700145, "i", "python3 - <<'PY'\np = 'reindex/worker.py'\ns = open(p).read().replace('`make reindex`', '`./jobs reindex`').replace('import logging\\n', 'import logging\\nimport signal\\n')\ns = s.replace('from reindex.checkpoint import Checkpoint', 'from reindex.checkpoint import Checkpoint, fresh_state')\nstart = s.index('def run(args):')\nend = s.index('\\n\\ndef main(', start)\ns = s[:start] + '''def run(args):\n    if args.batch_size <= 0:\n        raise ValueError(\"batch size must be positive\")\n    stopping = False\n\n    def request_stop(signum, frame):\n        # Do not raise from a signal handler: it may interrupt a durable commit.\n        nonlocal stopping\n        stopping = True\n\n    previous_handlers = {}\n    source = store = None\n    try:\n        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):\n            previous_handlers[sig] = signal.signal(sig, request_stop)\n        ckpt = Checkpoint(args.checkpoint)\n        state = ckpt.load()\n        source = Source(args.source)\n        store = ShardWriter(args.index_dir)\n     "]
[66.700492, "i", "   if \"shards\" not in state:\n            # Old checkpoints were written ahead of buffered output and cannot\n            # certify any prefix. Rebuild them once using the new protocol.\n            log.info(\"no durable checkpoint: rebuilding index from scratch\")\n            state = fresh_state()\n            store.reset()\n            state[\"shards\"] = store.snapshot()\n            ckpt.save(state)\n        else:\n            store.recover(state[\"shards\"])\n        if state[\"complete\"]:\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\n            return 0\n        total = source.count()\n        started = time.monotonic()\n        initial_docs = state[\"docs\"]\n        log.info(\"starting after id %d (%d/%d docs done)\",\n                 state[\"last_id\"], state[\"docs\"], total)\n\n        # Source.batches has an inclusive lower bound; last_id is committed.\n        for n, batch in enumerate(source.batches(start_id=state[\"last_id\"] + 1,\n                                                 size=args.batch_size)"]
[66.700507, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.700518, "i", ", 1):\n            if stopping:\n                break\n            for doc in batch:\n                if stopping:\n                    break\n                store.add(transform_doc(doc))\n                state[\"last_id\"] = doc.id\n                state[\"docs\"] += 1\n            # Index first, checkpoint second. A crash between them leaves a\n            # tail that recover() removes before replaying those documents.\n            state[\"shards\"] = store.snapshot()\n            ckpt.save(state)\n            if stopping:\n                break\n            if n % 20 == 0:\n                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\n                         state[\"last_id\"], state[\"docs\"], total, rate)\n        else:\n            state[\"complete\"] = True\n            state[\"shards\"] = store.snapshot()\n            ckpt.save(state)\n            log.info(\"reindex complete: %d docs\", state[\"docs\"])\n            return 0\n        log.info("]
[66.700616, "i", "\"stopped safely: last_id=%d docs=%d/%d\",\n                 state[\"last_id\"], state[\"docs\"], total)\n        return 0\n    finally:\n        try:\n            if store is not None:\n                store.close()\n        finally:\n            if source is not None:\n                source.close()\n            for sig, handler in previous_handlers.items():\n                signal.signal(sig, handler)\n''' + s[end:]\nopen(p, 'w').write(s)\nPY\n./jobs test\n"]
