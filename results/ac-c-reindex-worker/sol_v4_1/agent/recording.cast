[263.514211, "i", "python3 - <<'PY'\nimport hashlib\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\nstate = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nassert state['complete'] and state['docs'] == len(rows)\nassert len(rows) == len({r['id'] for r in rows}), 'duplicate IDs'\nsource = Source('data/docs.db')\nassert source.count() == len(rows)\nchecked = 0\nfor batch in source.batches(0, 100):\n    for doc in batch:\n        expected = transform_doc(doc)\n        actual = rows[checked]\n        assert actual == expected, 'row mismatch for document %d' % doc.id\n        checked += 1\n        if checked % 500 == 0:\n            print('Verified complete row contents: %d/%d' % (checked, len(rows)), flush=True)\nsource.close()\nassert checked == len(rows)\nassert state['last_id'] == rows[-1]['id']\nassert state['shards'] == "]
[263.514395, "o", "python3 - <<'PY'"]
[263.514407, "i", "{p.name: p.stat().st_size for p in shard_paths('var/index')}\nreport = {\n    'verified_at': datetime.now(timezone.utc).isoformat(),\n    'documents': checked,\n    'unique_ids': len({r['id'] for r in rows}),\n    'all_row_fields_match': True,\n    'source_sha256': hashlib.sha256(Path('data/docs.db').read_bytes()).hexdigest(),\n    'shard_sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()\n                     for p in shard_paths('var/index')},\n}\nPath('var/reindex-validation.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint('PASS: all %d rows exactly match transform_doc, including checksum and minhash.' % checked)\nPY\n"]
[263.514681, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib"]
