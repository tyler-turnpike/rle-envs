[78.1929, "o", "\u001b[?2004l\r"]
[78.193559, "o", "# Per-job limit overrides\r\n\r\nFor one-off backfills on-call can lift a job's limits by adding `<job>.json` here with any of\r\nthe keys from `ops/limits.json`, e.g. `{\"budget_seconds\": 600}`. The supervisor merges it over\r\n`ops/limits.json` and logs the limits each run actually used. Remove the file when the backfill\r\nis done.\r\n"]
[78.193701, "o", "\u001b[?2004hroot@dd05da628cc7:/app# "]
[103.25398, "i", "cat > tests/test_durability.py <<'PY'\n\"\"\"Commit ordering, crash recovery, and repeated-stop regression tests.\"\"\"\nimport json\nimport os\nimport signal\nimport sqlite3\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom reindex.checkpoint import Checkpoint, fresh_state\nfrom reindex.source import SCHEMA, Source\nfrom reindex.store import ShardWriter, iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nROOT = Path(__file__).resolve().parent.parent\n\n\nclass DurabilityTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.root = Path(self.tmp.name)\n        self.index = self.root / 'index'\n        self.checkpoint = self.root / 'ckpt.json'\n        self.db = self.root / 'docs.db'\n        with sqlite3.connect(self.db) as conn:\n            conn.executescript(SCHEMA)\n            conn.executemany('INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)',\n    "]
[103.254317, "o", "cat > tests/test_durability.py <<'PY'\r\n"]
[103.254345, "i", "                         [(i, 'Café %d' % i, 'A small naïve body', 'fr', int(i == 7), '')\n                              for i in [1, 3, 7, 9, 12, 18, 21, 29, 30]])\n        self.args = ['--source', str(self.db), '--index-dir', str(self.index),\n                     '--checkpoint', str(self.checkpoint), '--batch-size', '3']\n\n    def worker(self, script=None):\n        cmd = [sys.executable]\n        cmd += ['-c', script] if script else ['-m', 'reindex.worker']\n        return subprocess.run(cmd + self.args, cwd=ROOT, stderr=subprocess.DEVNULL,\n                              timeout=15)\n\n    def assert_complete(self):\n        source = Source(self.db)\n        try:\n            expected = [transform_doc(doc) for batch in source.batches(0, 3) for doc in batch]\n        finally:\n            source.close()\n        actual = list(iter_rows(self.index))\n        self.assertEqual(actual, expected)\n        state = Checkpoint(self.checkpoint).load()\n        self.assertTrue(state['complete'])\n        self.assertEqual(state['docs'"]
[103.255545, "o", "\u001b[?2004l\r\u001b[?2004h> \"\"\"Commit ordering, crash recovery, and repeated-stop regression tests.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import signal\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> import unittest\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from reindex.checkpoint import Checkpoint, fresh_state\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import SCHEMA, Source\r\n"]
[103.25562, "i", "], len(expected))\n        self.assertEqual(state['last_id'], expected[-1]['id'] if expected else 0)\n        self.assertEqual(state['shards'], {p.name: p.stat().st_size for p in shard_paths(self.index)})\n\n    def test_kill_before_and_after_checkpoint_publication(self):\n        for phase in ('before', 'after'):\n            with self.subTest(phase=phase):\n                # Rebuild a clean fixture index for each crash window.\n                self.checkpoint.unlink(missing_ok=True)\n                result = self.worker('''\nimport os, signal, sys\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.worker import main\noriginal = Checkpoint.save\nphase = %r\ndef save(self, state):\n    if state['docs'] and phase == 'before':\n        os.kill(os.getpid(), signal.SIGKILL)\n    original(self, state)\n    if state['docs'] and phase == 'after':\n        os.kill(os.getpid(), signal.SIGKILL)\nCheckpoint.save = save\nsys.exit(main())\n''' % phase)\n                self.assertEqual(result.returncode, -signal.SIGKILL)\n                st"]
[103.255628, "i", "ate = Checkpoint(self.checkpoint).load()\n                self.assertEqual(state['docs'], 0 if phase == 'before' else 3)\n                self.assertEqual(self.worker().returncode, 0)\n                self.assert_complete()\n                # A completed invocation is a no-op, not another append pass.\n                sizes = {p.name: p.read_bytes() for p in shard_paths(self.index)}\n                self.assertEqual(self.worker().returncode, 0)\n                self.assertEqual(sizes, {p.name: p.read_bytes() for p in shard_paths(self.index)})\n\n    def test_repeated_sigterm_commits_partial_batches(self):\n        script = '''\nimport os, signal, sys\nimport reindex.worker as worker\noriginal = worker.transform_doc\ncalls = 0\ndef transform(doc):\n    global calls\n    calls += 1\n    if calls == 2:\n        os.kill(os.getpid(), signal.SIGTERM)\n    return original(doc)\nworker.transform_doc = transform\nsys.exit(worker.main())\n'''\n        previous = 0\n        for _ in range(6):\n            self.assertEqual(self.worker(script).ret"]
[103.255641, "i", "urncode, 0)\n            state = Checkpoint(self.checkpoint).load()\n            self.assertGreaterEqual(state['docs'], previous)\n            self.assertEqual(state['docs'], len(list(iter_rows(self.index))))\n            previous = state['docs']\n            if state['complete']:\n                break\n        self.assert_complete()\n\n    def test_recovery_removes_torn_tail_and_uncommitted_shards(self):\n        writer = ShardWriter(self.index, shard_rows=2, buffer_rows=2)\n        writer.add({'id': 1})\n        committed = writer.snapshot()\n        writer.add({'id': 3})\n        writer.add({'id': 9})\n        writer.close()\n        paths = shard_paths(self.index)\n        with open(paths[0], 'ab') as fh:\n            fh.write(b'{\"torn\":')\n        with open(paths[-1], 'ab') as fh:\n            fh.write(b'\\xff')\n        for _ in range(2):\n            recovered = ShardWriter(self.index)\n            recovered.recover(committed)\n            recovered.close()\n            self.assertEqual(list(iter_rows(self.index)), [{'id': 1}]"]
[103.255645, "i", ")\n        recovered = ShardWriter(self.index)\n        recovered.recover(committed)\n        recovered.add({'id': 3})\n        recovered.close()\n        self.assertEqual(list(iter_rows(self.index)), [{'id': 1}, {'id': 3}])\n\n    def test_missing_committed_bytes_fail_closed(self):\n        writer = ShardWriter(self.index)\n        writer.add({'id': 1})\n        committed = writer.snapshot()\n        writer.close()\n        shard_paths(self.index)[0].write_bytes(b'')\n        with self.assertRaisesRegex(RuntimeError, 'truncated'):\n            ShardWriter(self.index).recover(committed)\n\n    def test_checkpoint_replace_failure_preserves_old_state(self):\n        ckpt = Checkpoint(self.checkpoint)\n        old = fresh_state()\n        ckpt.save(old)\n        with patch('reindex.checkpoint.os.replace', side_effect=OSError('injected')):\n            with self.assertRaises(OSError):\n                ckpt.save(dict(old, docs=3, last_id=9))\n        self.assertEqual(ckpt.load(), old)\n        self.assertEqual(list(self.root.glob('ckpt."]
[103.256706, "i", "json.*.tmp')), [])\n\n    def test_rotated_shards_are_synced_before_close(self):\n        writer = ShardWriter(self.index, shard_rows=1, buffer_rows=3)\n        synced = []\n        real_fsync = os.fsync\n        def fsync(fd):\n            synced.append(os.readlink('/proc/self/fd/%d' % fd))\n            real_fsync(fd)\n        with patch('reindex.store.os.fsync', side_effect=fsync):\n            for i in range(3):\n                writer.add({'id': i})\n            writer.snapshot()\n            writer.close()\n        for path in shard_paths(self.index):\n            self.assertIn(str(path), synced)\n\n    def test_unsafe_legacy_checkpoint_rebuilds_once(self):\n        self.index.mkdir()\n        (self.index / 'shard-00000.jsonl').write_text('{\"id\":999}\\n')\n        Checkpoint(self.checkpoint).save({'last_id': 18, 'docs': 5, 'complete': True})\n        self.assertEqual(self.worker().returncode, 0)\n        self.assert_complete()\n\n    def test_empty_source_completes(self):\n        with sqlite3.connect(self.db) as conn:\n          "]
