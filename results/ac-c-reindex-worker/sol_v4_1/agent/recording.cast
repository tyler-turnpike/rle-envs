[66.569841, "i", "cat > reindex/durability.py <<'PY'\n\"\"\"Filesystem durability helpers shared by index and checkpoint commits.\"\"\"\nimport os\n\n\ndef fsync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\nPY\npython3 - <<'PY'\np = 'reindex/checkpoint.py'\ns = open(p).read().replace('import logging\\n', 'import logging\\nimport os\\nimport tempfile\\n')\ns = s.replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.durability import fsync_directory\\n')\ns = s.replace('''        with open(self.path, \"w\") as fh:\n            json.dump(state, fh)\n''', '''        # The old checkpoint remains authoritative until the replacement is\n        # complete. The temporary file must be on the same filesystem.\n        fd, name = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                    dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state,"]
[66.570127, "i", " fh)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(name, self.path)\n            fsync_directory(self.path.parent)\n        finally:\n            Path(name).unlink(missing_ok=True)\n''')\nopen(p, 'w').write(s)\np = 'reindex/store.py'\ns = open(p).read().replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom reindex.durability import fsync_directory\\n')\ns = s.replace('''        self._close_shard()\n        for path in shard_paths(self.index_dir):\n            path.unlink()\n        self._next_shard = 0\n''', '''        self._buffer.clear()\n        self._close_shard()\n        for path in shard_paths(self.index_dir):\n            path.unlink()\n        fsync_directory(self.index_dir)\n        self._next_shard = 0\n        self._rows_in_shard = 0\n''')\ns = s.replace('''    def add(self, row):\n''', '''    def recover(self, shards):\n        \"\"\"Roll back to checkpoint byte offsets, including torn JSON tails.\n\n        Recovery is idempotent if killed itself. Missing committe"]
[66.570155, "o", "cat > reindex/durability.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.570166, "i", "d data is an\n        error, never a reason to silently advance past documents.\n        \"\"\"\n        if self._fh is not None or self._buffer:\n            raise RuntimeError(\"recovery requires an unused writer\")\n        paths = {path.name: path for path in shard_paths(self.index_dir)}\n        for name, size in shards.items():\n            if name not in paths or not isinstance(size, int) or size < 0:\n                raise RuntimeError(\"invalid or missing committed shard: %s\" % name)\n            if paths[name].stat().st_size < size:\n                raise RuntimeError(\"committed shard is truncated: %s\" % name)\n        for name, path in paths.items():\n            if name not in shards:\n                path.unlink()\n            elif path.stat().st_size > shards[name]:\n                with open(path, \"r+b\") as fh:\n                    fh.truncate(shards[name])\n                    fh.flush()\n                    os.fsync(fh.fileno())\n        fsync_directory(self.index_dir)\n        self._next_shard = self._first_free_shar"]
[66.570472, "i", "d()\n\n    def snapshot(self):\n        \"\"\"Make rows and shard names durable before publishing their offsets.\"\"\"\n        self.flush()\n        fsync_directory(self.index_dir)\n        return {path.name: path.stat().st_size for path in shard_paths(self.index_dir)}\n\n    def add(self, row):\n''')\ns = s.replace('''        if self._fh is not None:\n            self._fh.close()\n''', '''        if self._fh is not None:\n            self._fh.flush()\n            os.fsync(self._fh.fileno())\n            self._fh.close()\n''')\nopen(p, 'w').write(s)\nPY\n"]
