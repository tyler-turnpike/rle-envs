[66.57797, "o", "  \"\"\"Roll back to checkpoint byte offsets, including torn JSON tails.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         Recovery is idempotent if killed itself. Missing committed data is an\r\n\u001b[?2004l\r\u001b[?2004h>         error, never a reason to silently advance past documents.\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         if self._fh is not None or self._buffer:\r\n\u001b[?2004l\r\u001b[?2004h>             raise RuntimeError(\"recovery requires an unused writer\")\r\n\u001b[?2004l\r\u001b[?2004h>         paths = {path.name: path for path in shard_paths(self.index_dir)}\r\n\u001b[?2004l\r\u001b[?2004h>         for name, size in shards.items():\r\n\u001b[?2004l\r\u001b[?2004h>             if name not in paths or not isinstance(size, int) or size < 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 raise RuntimeError(\"invalid or missing committed shard: %s\" % name)\r\n\u001b[?2004l\r\u001b[?2004h>             if paths[name].stat().st_size < size:\r\n\u001b[?2004l\r\u001b[?2004h>                 raise RuntimeError(\"committed shard is truncated: %s\" % name)\r\n\u001b[?2004l\r\u001b[?2004h>         for name"]
