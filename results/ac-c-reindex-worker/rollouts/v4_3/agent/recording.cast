[81.382323, "o", "cat /tmp/reindex-tests.log; sed -n '1,220p' reindex/store.py; sed -n '70,110p' reindex/source.py"]
[81.383311, "o", "\r\n\u001b[?2004l\r"]
[81.38482, "o", "test_stop_and_resume_gives_complete_index (test_reindex.ResumeTest.test_stop_and_resume_gives_complete_index) ... ok\r\ntest_rows_round_trip_across_shards (test_reindex.StoreTest.test_rows_round_trip_across_shards) ... ok\r\ntest_empty_body (test_reindex.TransformTest.test_empty_body) ... ok\r\ntest_golden_row (test_reindex.TransformTest.test_golden_row) ... ok\r\n\r\n----------------------------------------------------------------------\r\nRan 4 tests in 5.567s\r\n\r\nOK\r\n"]
[81.386453, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n"]
[81.386565, "o", "\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n"]
[81.386612, "o", "`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\n"]
[81.386649, "o", "volume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\n\r\nfrom reindex.durability import fsync_directory\r\nfrom pathlib import Path\r\n\r\n"]
[81.38668, "o", "SHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n"]
[81.3867, "o", "\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n"]
[81.386727, "o", "        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n"]
[81.386742, "o", "\r\n\r\nclass ShardWriter:\r\n"]
[81.38679, "o", "    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        fsync_directory(self.index_dir.parent)\r\n        self.shard_rows = shard_rows\r\n"]
[81.386795, "o", "        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n"]
[81.386846, "o", "        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def recover(self, committed):\r\n        \"\"\"Restore the checkpoint's durable prefix, without parsing crash tails.\r\n\r\n        A crash during this operation is harmless: the same truncations/deletes\r\n        will be repeated on the next run. Missing committed bytes are an error,\r\n        not a reason to silently skip documents.\r\n        \"\"\"\r\n        if self._fh is not None or self._buffer:\r\n            raise RuntimeError(\"recovery requires an unused writer\")\r\n        paths = {p.name: p for p in shard_paths(self.index_dir)}\r\n"]
[81.386907, "o", "        for name, length in committed.items():\r\n"]
[81.386914, "o", "            if name not in paths or length < 0 or paths[name].stat().st_size < length:\r\n                raise RuntimeError(\"missing committed shard data: %s\" % name)\r\n        for name, path in paths.items():\r\n            if name not in committed:\r\n                path.unlink()\r\n            elif path.stat().st_size != committed[name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(committed[name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        fsync_directory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def reset(self):\r\n"]
[81.386921, "o", "        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n"]
[81.386962, "o", "        self._buffer.clear()\r\n        self._close_shard()\r\n"]
[81.386971, "o", "        self.recover({})\r\n\r\n    def commit(self):\r\n        \"\"\"Durably flush rows, returning byte boundaries for the checkpoint.\r\n\r\n        The caller must save the checkpoint *after* this returns. Until then\r\n        these bytes may be rolled back by recover().\r\n        \"\"\"\r\n        self.flush()\r\n"]
[81.386977, "o", "        fsync_directory(self.index_dir)\r\n        return {p.name: p.stat().st_size for p in shard_paths(self.index_dir)}\r\n"]
[81.387298, "o", "\r\n"]
[81.387311, "o", "    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n         "]
[81.387316, "o", "   self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n"]
[81.388468, "o", "    return len(rows)\r\n"]
[81.388524, "o", "\r\n"]
[81.388553, "o", "\r\n"]
[81.389621, "o", "class Source:\r\n"]
[81.389687, "o", "    \"\"\"Read-only access to the live (not soft-deleted) documents, in id order.\"\"\"\r\n"]
[81.389758, "o", "\r\n"]
[81.389792, "o", "    def __init__(self, path):\r\n"]
[81.389821, "o", "        self.conn = sqlite3.connect(\"file:%s?mode=ro\" % path, uri=True)\r\n"]
[81.389854, "o", "\r\n"]
[81.389879, "o", "    def count(self):\r\n"]
[81.39007, "o", "        return self.conn.execute(\"SELECT COUNT(*) FROM docs WHERE deleted = 0\").fetchone()[0]\r\n\r\n    def batches(self, start_id=0, size=25):\r\n        \"\"\"Yield lists of Docs with id > start_id, `size` at a time, in id order.\"\"\"\r\n        next_id = start_id\r\n        while True:\r\n            rows = self.conn.execute(\r\n                \"SELECT id, title, body, lang FROM docs WHERE deleted = 0 AND id > ? \"\r\n                \"ORDER BY id LIMIT ?\", (next_id, size)).fetchall()\r\n            if not rows:\r\n                return\r\n            yield [Doc(*row) for row in rows]\r\n            next_id = rows[-1][0]\r\n\r\n    def close(self):\r\n        self.conn.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    import sys\r\n    out = sys.argv[1] if len(sys.argv) > 1 else \"data/docs.db\"\r\n    print(\"wrote %d docs to %s\" % (generate_corpus(out), out))\r\n\u001b[?2004hroot@c15b0fb7b942:/app# "]
[114.225495, "i", "cat > tests/test_durability.py <<'PY'\n\"\"\"Regression coverage for SEARCH-412 commit ordering and crash recovery.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nfrom reindex.checkpoint import Checkpoint, fresh_state\nfrom reindex.source import Source, generate_corpus\nfrom reindex.store import ShardWriter, iter_rows, shard_paths\nfrom reindex.transform import transform_doc\nfrom reindex.worker import parse_args, run\n\nROOT = Path(__file__).resolve().parent.parent\n\n\nclass DurableResumeTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.path = Path(self.tmp.name)\n        generate_corpus(self.path / \"docs.db\", count=65, seed=9)\n        self.args = parse_args([\"--source\", str(self.path / \"docs.db\"),\n                                \"--index-dir\", str(self.path / \"index\"),\n                                \"--checkpoin"]
[114.229662, "i", "t\", str(self.path / \"ckpt.json\"),\n                                \"--batch-size\", \"7\"])\n        source = Source(self.args.source)\n        self.docs = [d for batch in source.batches(size=11) for d in batch]\n        source.close()\n        self.expected = [transform_doc(d) for d in self.docs]\n\n    def assert_complete(self):\n        self.assertEqual(list(iter_rows(self.args.index_dir)), self.expected)\n        state = Checkpoint(self.args.checkpoint).load()\n        self.assertTrue(state[\"complete\"])\n        self.assertEqual(state[\"docs\"], len(self.docs))\n        self.assertEqual(state[\"last_id\"], self.docs[-1].id)\n        self.assertEqual(state[\"shards\"],\n                         {p.name: p.stat().st_size for p in shard_paths(self.args.index_dir)})\n\n    def test_exclusive_cursor_with_gaps_and_deleted_documents(self):\n        source = Source(self.args.source)\n        try:\n            actual = [d for batch in source.batches(self.docs[9].id, 3) for d in batch]\n            self.assertEqual(actual, self.docs[10:])\n    "]
