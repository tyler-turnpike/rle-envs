[68.202022, "i", "            log.info(\"index already complete (%d docs)\", state[\"docs\"])\n            return 0\n        source = Source(args.source)\n        total = source.count()\n        started = time.monotonic()\n        initial_docs = state[\"docs\"]\n        log.info(\"starting after id %d (%d/%d docs done)\",\n                 state[\"last_id\"], state[\"docs\"], total)\n\n        for n, batch in enumerate(source.batches(start_id=state[\"last_id\"], size=args.batch_size), 1):\n            added = 0\n            for doc in batch:\n                if stopping:\n                    break\n                store.add(transform_doc(doc))\n                state[\"last_id\"] = doc.id\n                state[\"docs\"] += 1\n                added += 1\n            if added:\n                state[\"shards\"] = store.commit()\n                ckpt.save(state)\n            if stopping:\n                log.info(\"stopped at id %d (%d/%d docs committed)\",\n                         state[\"last_id\"], state[\"docs\"], total)\n                return 0\n            if n % 20 == 0:"]
[68.202028, "i", "\n                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\n                         state[\"last_id\"], state[\"docs\"], total, rate)\n\n        if not stopping:\n            state[\"shards\"] = store.commit()\n            state[\"complete\"] = True\n            ckpt.save(state)\n            log.info(\"reindex complete: %d docs\", state[\"docs\"])\n        return 0\n    finally:\n        if source is not None:\n            source.close()\n        if store is not None:\n            # Any writes after a failed checkpoint remain uncommitted and will\n            # be removed on recovery. Closing never advances the checkpoint.\n            store.close()\n        for sig, handler in previous.items():\n            signal.signal(sig, handler)\n''' + s[b:]\nopen(p, 'w').write(s)\nPY\n./jobs test > /tmp/reindex-tests.log 2>&1; cat /tmp/reindex-tests.log\n"]
