[132.728137, "o", "\r\ntest_recovery_removes_partial_tail_and_extra_shards_idempotently (test_durability.StorageDurabilityTest.test_recovery_removes_partial_tail_and_extra_shards_idempotently) ... ok\r\ntest_stop_and_resume_gives_complete_index (test_reindex.ResumeTest.test_stop_and_resume_gives_complete_index) ... ok\r\ntest_rows_round_trip_across_shards (test_reindex.StoreTest.test_rows_round_trip_across_shards) ... ok\r\ntest_empty_body (test_reindex.TransformTest.test_empty_body) ... ok\r\ntest_golden_row (test_reindex.TransformTest.test_golden_row) ... ok\r\n\r\n----------------------------------------------------------------------\r\nRan 11 tests in 16.041s\r\n\r\nOK\r\n"]
