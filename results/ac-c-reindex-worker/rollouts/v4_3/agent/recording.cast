[256.464692, "i", "./jobs status; ./jobs history; rm ops/overrides/reindex.json\ncat > /tmp/verify-reindex.py <<'PY'\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nroot = Path('/app')\nstate = Checkpoint(root / 'var/checkpoint.json').load()\nassert state['complete'], state\nrows = list(iter_rows(root / 'var/index'))\nsource = Source(root / 'data/docs.db')\ncount = 0\nfor batch in source.batches(size=100):\n    for doc in batch:\n        assert count < len(rows), ('missing row', doc.id)\n        assert rows[count] == transform_doc(doc), ('row mismatch', doc.id)\n        count += 1\n    print('Validated %d rows including checksum and minhash' % count, flush=True)\nsource.close()\nassert count == len(rows) == state['docs']\nassert len({r['id'] for r in rows}) == count\nassert rows[-1]['id'] == state['last_id']\nassert state['shards'] == {p.name: p.sta"]
[256.464944, "o", "./jobs status; ./jobs history; rm ops/overrides/reindex.json"]
[256.465031, "i", "t().st_size for p in shard_paths(root / 'var/index')}\nreport = {'validated_at': datetime.now(timezone.utc).isoformat(),\n          'source_live_docs': count, 'index_rows': len(rows),\n          'unique_ids': len({r['id'] for r in rows}),\n          'complete': True, 'all_row_contents_match': True}\n(root / 'var/reindex-validation.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint(json.dumps(report, indent=2), flush=True)\nPY\nPYTHONPATH=/app python3 /tmp/verify-reindex.py > /tmp/reindex-verification.log 2>&1 &\nVERIFY_PID=$!\n./jobs test > /tmp/reindex-tests-final.log 2>&1; TEST_RC=$?; tail -6 /tmp/reindex-tests-final.log\nwait \"$VERIFY_PID\"; VERIFY_RC=$?\necho \"Tests exit=$TEST_RC; full verification exit=$VERIFY_RC\"\n"]
