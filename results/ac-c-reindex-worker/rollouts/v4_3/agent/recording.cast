[15.736823, "o", "\"\"\"Document -> index row.\r\n\r\nRow format (consumed by the search service; do not change without a format bump):\r\n  id        source doc id\r\n  slug      url slug from the title\r\n  lang      language code\r\n  length    number of index tokens (stopwords removed)\r\n  terms     up to 8 most frequent tokens, ties broken alphabetically\r\n  checksum  sha256 prefix over the normalised title + body (change detection)\r\n  minhash   64 x 32-bit minhash values over character 5-grams (near-duplicate detection)\r\n\"\"\"\r\nimport hashlib\r\nimport re\r\nimport unicodedata\r\nfrom collections import Counter\r\n\r\nTOKEN_RE = re.compile(r\"[a-z0-9]+\")\r\nSTOPWORDS = frozenset(\"a an and are as at be by for from has in is it of on or that the to was \"\r\n                      \"were will with\".split())\r\nTOP_TERMS = 8\r\nNUM_PERM = 64\r\nSHINGLE = 5\r\n_SALTS = [b\"perm-%04d\" % i for i in range(NUM_PERM)]\r\n\r\n\r\ndef normalize(text):\r\n    \"\"\"NFKD-fold accents away and lowercase.\"\"\"\r\n    text = unicodedata.normalize(\"NFKD\", text)\r\n    return \"\".join(ch for ch in tex"]
[15.736956, "o", "t if not unicodedata.combining(ch)).lower()\r\n\r\n\r\ndef tokenize(text):\r\n    return [tok for tok in TOKEN_RE.findall(normalize(text)) if tok not in STOPWORDS]\r\n\r\n\r\ndef slugify(title):\r\n    return \"-\".join(TOKEN_RE.findall(normalize(title)))[:64] or \"untitled\"\r\n\r\n\r\ndef checksum(title, body):\r\n    digest = hashlib.sha256()\r\n    digest.update(normalize(title).encode(\"utf-8\"))\r\n    digest.update(b\"\\x00\")\r\n    digest.update(normalize(body).encode(\"utf-8\"))\r\n    return digest.hexdigest()[:32]\r\n\r\n\r\ndef minhash(tokens):\r\n    text = \" \".join(tokens)\r\n    shingles = {text[i:i + SHINGLE] for i in range(max(1, len(text) - SHINGLE + 1))}\r\n    encoded = [s.encode(\"utf-8\") for s in sorted(shingles)]\r\n    blake = hashlib.blake2b\r\n    signature = []\r\n    for salt in _SALTS:\r\n        signature.append(min(int.from_bytes(blake(s, digest_size=4, salt=salt).digest(), \"big\")\r\n                             for s in encoded))\r\n    return signature\r\n\r\n\r\ndef transform_doc(doc):\r\n    tokens = tokenize(doc.title + \" \" + doc.body)\r\n    top = "]
[15.73697, "o", "sorted(Counter(tokens).items(), key=lambda kv: (-kv[1], kv[0]))[:TOP_TERMS]\r\n    return {\r\n        \"id\": doc.id,\r\n        \"slug\": slugify(doc.title),\r\n        \"lang\": doc.lang,\r\n        \"length\": len(tokens),\r\n        \"terms\": [term for term, _ in top],\r\n        \"checksum\": checksum(doc.title, doc.body),\r\n        \"minhash\": minhash(tokens),\r\n    }\r\n"]
[15.739275, "o", "{\r\n  \"jobs\": {\r\n    \"reindex\": {\r\n      \"budget_seconds\": 10,\r\n      \"grace_seconds\": 5,\r\n      \"cooldown_seconds\": 90\r\n    }\r\n  }\r\n}\r\n"]
[15.740556, "o", "# search-reindex\r\n\r\nBuilds the search index (`var/index/shard-*.jsonl`) from the document store\r\n(`data/docs.db`).\r\n\r\n| path | what |\r\n|------|------|\r\n| `reindex/worker.py` | the reindex job: reads docs in id order, transforms, writes shards, checkpoints |\r\n| `reindex/transform.py` | doc -> index row (row format documented there) |\r\n| `reindex/store.py` | shard writer / reader |\r\n| `reindex/checkpoint.py` | progress checkpoint (`var/checkpoint.json`) |\r\n| `reindex/source.py` | source corpus access (+ fixture generator) |\r\n| `ops/supervise.py` | job runner used for every batch job here: budget, SIGTERM/SIGKILL, run log |\r\n| `ops/limits.json` | per-job budgets and cooldowns |\r\n| `jobs` | entry points: `./jobs reindex`, `./jobs status`, `./jobs history`, `./jobs test`, `./jobs clean` |\r\n\r\nA full reindex of the current corpus is several budgets long; the job is designed\r\nto be run repeatedly and pick up where the previous run stopped.\r\n"]
[15.741598, "o", "import os\r\nimport signal\r\nimport subprocess\r\nimport sys\r\nimport tempfile\r\nimport time\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom reindex.source import Doc, Source, generate_corpus  # noqa: E402\r\nfrom reindex.store import ShardWriter, iter_rows, shard_paths  # noqa: E402\r\nfrom reindex.transform import transform_doc  # noqa: E402\r\n\r\n\r\nclass TransformTest(unittest.TestCase):\r\n    def test_golden_row(self):\r\n        row = transform_doc(Doc(7, \"Café Über Zürich\", \"The naïve résumé of the façade. Café café!\", \"fr\"))\r\n        self.assertEqual(row[\"slug\"], \"cafe-uber-zurich\")\r\n        self.assertEqual(row[\"terms\"], [\"cafe\", \"facade\", \"naive\", \"resume\", \"uber\", \"zurich\"])\r\n        self.assertEqual(row[\"length\"], 8)\r\n        self.assertEqual(row[\"checksum\"], \"fbe4334594f1a63f211e2742efb9681a\")\r\n        self.assertEqual(row[\"minhash\"][:4], [51805901, 103584590, 473029234, 2680140])\r\n        self.assertEqual(len(row[\"minhash\""]
[15.741709, "o", "]), 64)\r\n\r\n    def test_empty_body(self):\r\n        row = transform_doc(Doc(1, \"Untitled\", \"\", \"en\"))\r\n        self.assertEqual(row[\"length\"], 1)\r\n        self.assertEqual(len(row[\"minhash\"]), 64)\r\n\r\n\r\nclass StoreTest(unittest.TestCase):\r\n    def test_rows_round_trip_across_shards(self):\r\n        with tempfile.TemporaryDirectory() as tmp:\r\n            writer = ShardWriter(tmp, shard_rows=4, buffer_rows=3)\r\n            for i in range(10):\r\n                writer.add({\"id\": i})\r\n            writer.close()\r\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], list(range(10)))\r\n            self.assertEqual(len(shard_paths(tmp)), 3)\r\n\r\n\r\nclass ResumeTest(unittest.TestCase):\r\n    def _worker(self, tmp):\r\n        return [sys.executable, \"-m\", \"reindex.worker\", \"--source\", str(tmp / \"docs.db\"),\r\n                \"--index-dir\", str(tmp / \"index\"), \"--checkpoint\", str(tmp / \"ckpt.json\")]\r\n\r\n    def test_stop_and_resume_gives_complete_index(self):\r\n        with tempfile.TemporaryDirectory() as tmp:\r\n           "]
[15.741863, "o", " tmp = Path(tmp)\r\n            generate_corpus(tmp / \"docs.db\", count=400, seed=5)\r\n            proc = subprocess.Popen(self._worker(tmp), cwd=ROOT, stderr=subprocess.DEVNULL)\r\n            time.sleep(1.5)\r\n            proc.send_signal(signal.SIGTERM)\r\n            proc.wait(timeout=10)\r\n            subprocess.run(self._worker(tmp), cwd=ROOT, check=True, timeout=120,\r\n                           stderr=subprocess.DEVNULL)\r\n            ids = [row[\"id\"] for row in iter_rows(tmp / \"index\")]\r\n            source = Source(tmp / \"docs.db\")\r\n            expected = [d.id for batch in source.batches(0, 100) for d in batch]\r\n            source.close()\r\n            self.assertEqual(len(ids), len(set(ids)), \"duplicate rows in index\")\r\n            self.assertEqual(sorted(ids), expected)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n\u001b[?2004hroot@c15b0fb7b942:/app# "]
