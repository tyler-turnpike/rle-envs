[68.201632, "i", "cat > reindex/durability.py <<'PY'\n\"\"\"Filesystem durability helpers (the index and checkpoint use separate files).\"\"\"\nimport os\n\n\ndef fsync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\nPY\ncat > reindex/checkpoint.py <<'PY'\n\"\"\"Atomic, durable reindex progress checkpoint (var/checkpoint.json).\"\"\"\nimport json\nimport logging\nimport os\nfrom pathlib import Path\nimport tempfile\n\nfrom reindex.durability import fsync_directory\n\nlog = logging.getLogger(\"reindex.checkpoint\")\n\n\ndef fresh_state():\n    # shards maps published filenames to committed byte lengths. Bytes beyond\n    # those lengths are uncommitted, even if they contain complete JSON rows.\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False, \"shards\": {}}\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text())\n        except FileNotFoundError:\n            retur"]
