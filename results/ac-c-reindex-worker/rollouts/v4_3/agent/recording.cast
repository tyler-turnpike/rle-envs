[68.241602, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:a] + '''def run(args):\r\n\u001b[?2004l\r\u001b[?2004h>     stopping = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def request_stop(signum, frame):\r\n\u001b[?2004l\r\u001b[?2004h>         # Do not raise from inside a write/rename. Finish the current document\r\n\u001b[?2004l\r\u001b[?2004h>         # and commit the partial batch; SIGKILL recovery uses the old checkpoint.\r\n\u001b[?2004l\r\u001b[?2004h>         nonlocal stopping\r\n\u001b[?2004l\r\u001b[?2004h>         stopping = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     previous = {sig: signal.signal(sig, request_stop)\r\n\u001b[?2004l\r\u001b[?2004h>                 for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n\u001b[?2004l\r\u001b[?2004h>     source = store = None\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         ckpt = Checkpoint(args.checkpoint)\r\n\u001b[?2004l\r\u001b[?2004h>         state = ckpt.load()\r\n\u001b[?2004l\r\u001b[?2004h>         store = ShardWriter(args.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>         # Persist the chosen starting state before deleting any orphaned bytes\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[68.241684, "o", "    # (also handles an absent/legacy checkpoint safely across another stop).\r\n\u001b[?2004l\r\u001b[?2004h>         ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>         store.recover(state[\"shards\"])\r\n\u001b[?2004l\r\u001b[?2004h>         if state[\"complete\"]:\r\n\u001b[?2004l\r\u001b[?2004h>             log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>             return 0\r\n\u001b[?2004l\r\u001b[?2004h>         source = Source(args.source)\r\n\u001b[?2004l\r\u001b[?2004h>         total = source.count()\r\n\u001b[?2004l\r\u001b[?2004h>         started = time.monotonic()\r\n\u001b[?2004l\r\u001b[?2004h>         initial_docs = state[\"docs\"]\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"starting after id %d (%d/%d docs done)\",\r\n\u001b[?2004l\r\u001b[?2004h>                  state[\"last_id\"], state[\"docs\"], total)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         for n, batch in enumerate(source.batches(start_id=state[\"last_id\"], size=args.batch_size), 1):\r\n\u001b[?2004l\r\u001b[?2004h>             added = 0\r\n\u001b[?2004l\r\u001b[?2004h>             for doc in batch:\r\n\u001b[?2004l\r\u001b[?2004h>                 if stopping:"]
[68.241702, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h>                 store.add(transform_doc(doc))\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"last_id\"] = doc.id\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"docs\"] += 1\r\n\u001b[?2004l\r\u001b[?2004h>                 added += 1\r\n\u001b[?2004l\r\u001b[?2004h>             if added:\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"shards\"] = store.commit()\r\n\u001b[?2004l\r\u001b[?2004h>                 ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>             if stopping:\r\n\u001b[?2004l\r\u001b[?2004h>                 log.info(\"stopped at id %d (%d/%d docs committed)\",\r\n\u001b[?2004l\r\u001b[?2004h>                          state[\"last_id\"], state[\"docs\"], total)\r\n\u001b[?2004l\r\u001b[?2004h> "]
