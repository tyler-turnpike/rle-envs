[114.229913, "i", "n disk, even before recovery.\n                self.assertEqual(list(iter_rows(self.args.index_dir))[:committed],\n                                 self.expected[:committed])\n                run(self.args)\n                self.assert_complete()\n\n    def test_legacy_checkpoint_rebuilds_instead_of_trusting_missing_rows(self):\n        Path(self.args.checkpoint).write_text(json.dumps(\n            {\"last_id\": self.docs[-1].id, \"docs\": len(self.docs), \"complete\": True}))\n        run(self.args)\n        self.assert_complete()\n\n\nclass StorageDurabilityTest(unittest.TestCase):\n    def test_recovery_removes_partial_tail_and_extra_shards_idempotently(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            writer = ShardWriter(tmp, shard_rows=3, buffer_rows=2)\n            for i in range(5):\n                writer.add({\"id\": i, \"text\": \"café\"})\n            committed = writer.commit()\n            for i in range(5, 10):\n                writer.add({\"id\": i})\n            writer.close()\n            paths = shard_pa"]
