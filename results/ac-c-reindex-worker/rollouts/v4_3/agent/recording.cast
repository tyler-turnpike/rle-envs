[147.109319, "i", "cat > /tmp/check-reindex-prefix.py <<'PY'\nfrom pathlib import Path\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\n\nstate = Checkpoint('/app/var/checkpoint.json').load()\nrows = list(iter_rows('/app/var/index'))\nsource = Source('/app/data/docs.db')\nexpected = [doc.id for batch in source.batches(size=200) for doc in batch]\nsource.close()\nids = [row['id'] for row in rows]\nassert ids == expected[:state['docs']], (len(ids), state)\nassert len(ids) == len(set(ids))\nassert (ids[-1] if ids else 0) == state['last_id']\nassert state['shards'] == {p.name: p.stat().st_size for p in shard_paths('/app/var/index')}\nassert not state['complete'] or ids == expected\nprint('Verified durable prefix: %d/%d docs; complete=%s' % (len(ids), len(expected), state['complete']))\nPY\nPYTHONPATH=/app python3 /tmp/check-reindex-prefix.py\nfor attempt in $(seq 1 20); do\n  ./jobs reindex\n  rc=$?\n  if [ \"$rc\" -ne 0 ] && [ \"$rc\" -ne 75 ]; then echo \"Unexpected supervisor e"]
[147.109998, "i", "xit $rc\"; break; fi\n  PYTHONPATH=/app python3 /tmp/check-reindex-prefix.py || break\n  if python3 -c 'import json,sys; sys.exit(not json.load(open(\"var/checkpoint.json\"))[\"complete\"])'; then break; fi\ndone\n"]
[147.110022, "o", "cat > /tmp/check-reindex-prefix.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import Source\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.store import iter_rows, shard_paths\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> state = Checkpoint('/app/var/checkpoint.json').load()\r\n\u001b[?2004l\r\u001b[?2004h> rows = list(iter_rows('/app/var/index'))\r\n\u001b[?2004l\r\u001b[?2004h> source = Source('/app/data/docs.db')\r\n\u001b[?2004l\r\u001b[?2004h> expected = [doc.id for batch in source.batches(size=200) for doc in batch]"]
