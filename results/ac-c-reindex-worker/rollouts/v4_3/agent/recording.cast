[114.229829, "i", "    finally:\n            source.close()\n\n    def test_repeated_term_commits_partial_batch_and_completed_run_is_noop(self):\n        for count in (3, 5, 2):\n            calls = 0\n\n            def stop_during_transform(doc):\n                nonlocal calls\n                calls += 1\n                row = transform_doc(doc)\n                if calls == count:\n                    os.kill(os.getpid(), signal.SIGTERM)\n                return row\n\n            before = Checkpoint(self.args.checkpoint).load()[\"docs\"]\n            with patch(\"reindex.worker.transform_doc\", stop_during_transform):\n                self.assertEqual(run(self.args), 0)\n            state = Checkpoint(self.args.checkpoint).load()\n            self.assertEqual(state[\"docs\"], before + count)\n            self.assertEqual(list(iter_rows(self.args.index_dir)), self.expected[:before + count])\n        run(self.args)\n        self.assert_complete()\n        contents = {p.name: p.read_bytes() for p in shard_paths(self.args.index_dir)}\n        run(self.args)\n "]
