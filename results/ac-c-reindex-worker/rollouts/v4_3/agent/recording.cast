[114.22985, "i", "       self.assertEqual(contents, {p.name: p.read_bytes() for p in shard_paths(self.args.index_dir)})\n\n    def test_sigkill_on_each_side_of_checkpoint(self):\n        # Kill at deterministic commit boundaries, not based on wall-clock speed.\n        for phase in (\"before_flush\", \"after_flush\", \"after_checkpoint\"):\n            with self.subTest(phase=phase):\n                for p in shard_paths(self.args.index_dir):\n                    p.unlink()\n                Path(self.args.checkpoint).unlink(missing_ok=True)\n                code = '''\nimport os, signal, sys\nfrom reindex.worker import main\nfrom reindex.store import ShardWriter\nfrom reindex.checkpoint import Checkpoint\nphase = sys.argv.pop(1)\nold_commit, old_save = ShardWriter.commit, Checkpoint.save\ncalls = 0\ndef commit(self):\n    global calls\n    calls += 1\n    if calls == 2 and phase == 'before_flush':\n        os.kill(os.getpid(), signal.SIGKILL)\n    result = old_commit(self)\n    if calls == 2 and phase == 'after_flush':\n        os.kill(os.getpid(), signal."]
