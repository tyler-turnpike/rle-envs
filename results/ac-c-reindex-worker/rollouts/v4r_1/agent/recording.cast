[6.069586, "o", "#!/bin/bash\r\n# Team job entry points.  Usage: ./jobs <command>\r\n#   reindex   run (or continue) the search reindex under the job supervisor\r\n#   status    progress of the current reindex\r\n#   history   recent supervised runs\r\n#   test      unit tests\r\n#   clean     drop the index and checkpoint (next reindex starts from scratch)\r\nset -euo pipefail\r\ncd \"$(dirname \"$0\")\"\r\nPY=${PY:-python3}\r\ncase \"${1:-}\" in\r\n  reindex) exec \"$PY\" ops/supervise.py run reindex ;;\r\n  status)  exec \"$PY\" -m reindex.worker --status ;;\r\n  history) exec \"$PY\" ops/supervise.py history reindex ;;\r\n  test)    exec \"$PY\" -m unittest discover -s tests -v ;;\r\n  clean)   rm -rf var/index var/checkpoint.json ;;\r\n  *) sed -n '2,8p' \"$0\"; exit 2 ;;\r\nesac\r\n"]
[6.070846, "o", "ops:\r\n"]
