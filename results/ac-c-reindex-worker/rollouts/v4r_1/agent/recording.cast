[167.244314, "i", "python3 - <<'PY'\np = 'tests/test_recovery.py'\ns = open(p).read().replace('import json\\n', '')\nmarker = '    def test_missing_committed_bytes_fail_closed(self):\\n'\ninsert = '''    def test_partial_json_line_in_committed_shard_is_discarded(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            writer = ShardWriter(tmp)\n            writer.add({\"id\": 1, \"title\": \"café\"})\n            position = writer.flush()\n            writer.close()\n            path = shard_paths(tmp)[0]\n            committed = path.read_bytes()\n            with open(path, \"ab\") as fh:\n                fh.write(b'{\"id\":2,\"title\":\"partial')\n            writer = ShardWriter(tmp)\n            writer.recover(position)\n            writer.close()\n            self.assertEqual(path.read_bytes(), committed)\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], [1])\n\n    def test_failure_during_flush_across_shards(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            writer = ShardWriter(tmp, shard_rows=3, buffer_r"]
[167.244606, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p = 'tests/test_recovery.py'\r\n\u001b[?2004l\r\u001b[?2004h> s = open(p).read().replace('import json\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> marker = '    def test_missing_committed_bytes_fail_closed(self):\\n'\r\n\u001b[?2004l\r\u001b[?2004h> insert = '''    def test_partial_json_line_in_committed_shard_is_discarded(self):\r\n\u001b[?2004l\r\u001b[?2004h>         with tempfile.TemporaryDirectory() as tmp:\r\n\u001b[?2004l\r\u001b[?2004h>             writer = ShardWriter(tmp)\r\n\u001b[?2004l\r\u001b[?2004h>             writer.add({\"id\": 1, \"title\": \"café\"})\r\n\u001b[?2004l\r\u001b[?2004h>             position = writer.flush()\r\n\u001b[?2004l\r\u001b[?2004h>             writer.close()\r\n\u001b[?2004l\r\u001b[?2004h>             path = shard_paths(tmp)[0]\r\n\u001b[?2004l\r\u001b[?2004h>             committed = path.read_bytes()"]
[167.244675, "i", "ows=100)\n            writer.add({\"id\": 0})\n            position = writer.flush()\n            for i in range(1, 10):\n                writer.add({\"id\": i})\n            rotate = writer._rotate\n\n            def fail_on_later_shard():\n                rotate()\n                if writer._next_shard == 3:\n                    raise OSError(\"interrupted flush\")\n\n            with patch.object(writer, \"_rotate\", side_effect=fail_on_later_shard):\n                with self.assertRaises(OSError):\n                    writer.flush()\n            writer.abort()\n            writer = ShardWriter(tmp, shard_rows=3, buffer_rows=100)\n            writer.recover(position)\n            writer.close()\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], [0])\n\n'''\ns=s.replace(marker,insert+marker)\ns=s.replace('(\"before\", \"after\"):', '(\"before\", \"during\", \"after\"):')\ns=s.replace('''        if sys.argv[1] == \"after\":\n            original(self, state)\n        os._exit(99)''', '''        if sys.argv[1] == \"after\":\n            origi"]
