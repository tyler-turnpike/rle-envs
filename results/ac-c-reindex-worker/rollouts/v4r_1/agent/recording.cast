[67.480807, "i", "cat > reindex/checkpoint.py <<'PY'\n\"\"\"Atomic, durable reindex progress checkpoint.\"\"\"\nimport json\nimport os\nimport tempfile\nfrom pathlib import Path\n\n\ndef fresh_state():\n    # last_id is inclusive: the last document committed to the shards.\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False}\n\n\ndef sync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text())\n        except FileNotFoundError:\n            return fresh_state()\n        # Fail closed on corruption rather than silently discarding committed work.\n        if not isinstance(data, dict):\n            raise ValueError(\"checkpoint must be an object\")\n        state = fresh_state()\n        state.update(data)\n        return state\n\n    def save(self, state):\n        self.path.parent.mkdir(parents=True, exist_ok=Tru"]
[67.48414, "i", "e)\n        fd, name = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                    dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(name, self.path)\n            sync_directory(self.path.parent)\n        finally:\n            Path(name).unlink(missing_ok=True)\n\n    def clear(self):\n        self.path.unlink(missing_ok=True)\nPY\ncat > reindex/store.py <<'PY'\n\"\"\"JSON-lines shards with a recoverable, durable byte-position boundary.\n\nA checkpoint may only publish the position returned by flush(). Recovery discards\nall bytes after that position, including partial JSON lines and later shards.\nThe search row format and shard naming convention are unchanged.\n\"\"\"\nimport json\nimport os\nfrom pathlib import Path\n\nfrom reindex.checkpoint import sync_directory\n\nSHARD_ROWS = 1000\nBUFFER_ROWS = 200\nEMPTY_POSITION = {\"shard\": "]
