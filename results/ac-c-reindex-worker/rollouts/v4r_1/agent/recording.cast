[67.508366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def flush(self):\r\n\u001b[?2004l\r\u001b[?2004h>         if not self._buffer:\r\n\u001b[?2004l\r\u001b[?2004h>             return dict(self._position)\r\n\u001b[?2004l\r\u001b[?2004h>         for row in self._buffer:\r\n\u001b[?2004l\r \u001b[?2004h>             if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n\u001b[?2004l\r\u001b[?2004h>                 self._rotate()\r\n\u001b[?2004l\r\u001b[?2004h>             line = json.dumps(row, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False) + \"\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.write(line.encode(\"utf-8\"))\r\n\u001b[?2004l\r\u001b[?2004h>             self._rows_in_shard += 1\r\n\u001b[?2004l\r\u001b[?2004h>         self._fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h>         os.fsync(self._fh.fileno())\r\n\u001b[?2004l\r \u001b[?2004h>         # Publish new shard names only after every shard's data is durable.\r\n\u001b[?2004l\r\u001b[?2004h>         sync_directory(self.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>         self._position = {\"shard\": self._next_shard - 1, \"offset\": self._fh.tell()}\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.clear()\r\n\u001b[?20"]
[67.50839, "o", "04l\r\u001b[?2004h>         return dict(self._position)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _rotate(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self._close_shard()\r\n\u001b[?2004l\r\u001b[?2004h>         path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n\u001b[?2004l\r\u001b[?2004h>         self._fh = open(path, \"ab\")\r\n\u001b[?2004l\r\u001b[?2004h>         self._next_shard += 1\r\n\u001b[?2004l\r\u001b[?2004h>         self._rows_in_shard = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _close_shard(self):\r\n\u001b[?2004l\r\u001b[?2004h>         if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             # A block can cross shard boundaries; fsync the earlier shards too.\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h>             os.fsync(self._fh.fileno())\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.close()\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def abort(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
