[148.40509, "i", "cat > /tmp/finish-reindex.sh <<'SH'\n#!/bin/bash\nset -eu\ncd /app\ntest ! -e ops/overrides/reindex.json\nprintf '{\"cooldown_seconds\":0}\\n' > ops/overrides/reindex.json\ntrap 'rm -f /app/ops/overrides/reindex.json' EXIT\nfor attempt in $(seq 1 40); do\n  rc=0\n  ./jobs reindex || rc=$?\n  if [ \"$rc\" -ne 0 ] && [ \"$rc\" -ne 75 ]; then exit \"$rc\"; fi\n  python3 - <<'PY'\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows\nstate = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nsource = Source('data/docs.db')\nexpected = [d.id for batch in source.batches(0, 100) for d in batch]\nsource.close()\nids = [r['id'] for r in rows]\nassert ids == expected[:state['docs']], (len(ids), state)\nassert len(ids) == len(set(ids)) == state['docs']\nassert not ids or ids[-1] == state['last_id']\nprint('Verified committed prefix:', state['docs'], 'docs; complete:', state['complete'], flush=True)\nPY\n  if [ \"$rc\" -eq 0 ]; then\n    python3 /tmp/verify-reindex.py\n  "]
[148.405574, "o", "cat > /tmp/finish-reindex.sh <<'SH'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.405744, "i", "  exit 0\n  fi\ndone\nexit 1\nSH\ncat > /tmp/verify-reindex.py <<'PY'\nimport json\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, '/app')\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows\nfrom reindex.transform import transform_doc\n\nstate = Checkpoint('/app/var/checkpoint.json').load()\nassert state['complete'], state\nrows = list(iter_rows('/app/var/index'))\nsource = Source('/app/data/docs.db')\nexpected_count = source.count()\nassert len(rows) == len({r['id'] for r in rows}) == state['docs'] == expected_count\nn = 0\nfor batch in source.batches(0, 100):\n    for doc in batch:\n        assert rows[n] == transform_doc(doc), 'row mismatch for id %s' % doc.id\n        n += 1\n    if n % 1000 == 0:\n        print('Full row verification:', n, '/', expected_count, flush=True)\nsource.close()\nassert n == expected_count\nassert not rows or rows[-1]['id'] == state['last_id']\nprint('VERIFIED: %d live documents, exactly one unchanged-format row each; all checksums and "]
[148.405795, "o", "set -eu\r\n\u001b[?2004l\r\u001b[?2004h> cd /app\r\n\u001b[?2004l\r\u001b[?2004h> test ! -e ops/overrides/reindex.json\r\n\u001b[?2004l\r"]
[148.405849, "i", "minhash signatures match.' % n, flush=True)\nPath('/tmp/reindex-verified.json').write_text(json.dumps({'verified_rows': n, 'checkpoint': state}, indent=2))\nPY\nbash /tmp/finish-reindex.sh > /tmp/reindex-backfill.log 2>&1 & echo \"backfill pid=$!\"\n"]
[148.405903, "o", "\u001b[?2004h> printf '{\"cooldown_seconds\":0}\\n' > ops/overrides/reindex.json\r\n\u001b[?2004l\r"]
[148.405948, "o", "\u001b[?2004h> "]
[148.405993, "o", "trap 'rm -f /app/ops/overrides/reindex.json' EXIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.406032, "o", "> "]
[148.40612, "o", "for attempt in $(seq 1 40); do\r\n\u001b[?2004l\r\u001b[?2004h>   rc=0\r\n\u001b[?2004l\r"]
[148.406185, "o", "\u001b[?2004h>   ./jobs reindex || rc=$?\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.406225, "o", "> "]
[148.406277, "o", "  if [ \"$rc\" -ne 0 ] && [ \"$rc\" -ne 75 ]; then exit \"$rc\"; fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.406338, "o", "  python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.406412, "o", "from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r"]
[148.406532, "o", "\u001b[?2004h> from reindex.source import Source\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.406603, "o", "from reindex.store import iter_rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.406664, "o", "state = Checkpoint('var/checkpoint.json').load()\r\n\u001b[?2004l\r"]
[148.406705, "o", "\u001b[?2004h> "]
[148.406758, "o", "rows = list(iter_rows('var/index'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.406808, "o", "> source = Source('data/docs.db')\r\n"]
[148.406846, "o", "\u001b[?2004l\r"]
[148.408459, "o", "\u001b[?2004h> expected = [d.id for batch in source.batches(0, 100) for d in batch]\r\n\u001b[?2004l\r\u001b[?2004h> source.close()\r\n\u001b[?2004l\r\u001b[?2004h> ids = [r['id'] for r in rows]\r\n\u001b[?2004l\r\u001b[?2004h> assert ids == expected[:state['docs']], (len(ids), state)\r\n\u001b[?2004l\r\u001b[?2004h> assert len(ids) == len(set(ids)) == state['docs']\r\n\u001b[?2004l\r\u001b[?2004h> assert not ids or ids[-1] == state['last_id']\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified committed prefix:', state['docs'], 'docs; complete:', state['complete'], flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\u001b[?2004h>   if [ \"$rc\" -eq 0 ]; then\r\n\u001b[?2004l\r\u001b[?2004h>     python3 /tmp/verify-reindex.py\r\n\u001b[?2004l\r\u001b[?2004h>     exit 0\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> exit 1\r\n\u001b[?2004l\r\u001b[?2004h> SH\r\n\u001b[?2004l\r"]
[148.412572, "o", "\u001b[?2004hroot@4b540f928f29:/app# cat > /tmp/verify-reindex.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0, '/app')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.412664, "o", "from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import Source\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.store import iter_rows"]
[148.417225, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.transform import transform_doc\r\n\u001b[?2004l\r"]
[148.41732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.417634, "o", "state = Checkpoint('/app/var/checkpoint.json').load()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.417759, "o", "assert state['complete'], state"]
[148.417831, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.417904, "o", "rows = list(iter_rows('/app/var/index'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.418069, "o", "source = Source('/app/data/docs.db')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.418154, "o", "expected_count = source.count()"]
[148.418188, "o", "\r\n"]
[148.418262, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[148.418437, "o", "assert len(rows) == len({r['id'] for r in rows}) == state['docs'] == expected_count\r\n\u001b[?2004l\r"]
[148.418533, "o", "\u001b[?2004h> n = 0"]
[148.41897, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.41905, "o", "> "]
[148.419151, "o", "for batch in source.batches(0, 100):"]
[148.419208, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.419307, "o", "> "]
[148.419318, "o", "    for doc in batch:"]
[148.419377, "o", "\r\n"]
[148.419434, "o", "\u001b[?2004l\r\u001b[?2004h"]
[148.419583, "o", ">         assert rows[n] == transform_doc(doc), 'row mismatch for id %s' % doc.id"]
[148.419634, "o", "\r\n"]
[148.419685, "o", "\u001b[?2004l\r"]
[148.419751, "o", "\u001b[?2004h"]
[148.419809, "o", "> "]
[148.419875, "o", "        n += 1"]
[148.419904, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.419996, "o", ">     if n % 1000 == 0:"]
[148.420046, "o", "\r\n"]
[148.420093, "o", "\u001b[?2004l\r\u001b[?2004h"]
[148.42031, "o", ">         print('Full row verification:', n, '/', expected_count, flush=True)"]
[148.420362, "o", "\r\n"]
[148.420404, "o", "\u001b[?2004l\r"]
[148.420451, "o", "\u001b[?2004h"]
[148.420542, "o", "> source.close()"]
[148.420612, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.42063, "o", "> "]
[148.420691, "o", "assert n == expected_count"]
[148.420751, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.420838, "o", "> assert not rows or rows[-1]['id'] == state['last_id']"]
[148.420903, "o", "\r\n"]
[148.420925, "o", "\u001b[?2004l\r"]
[148.420969, "o", "\u001b[?2004h"]
[148.421161, "o", "> print('VERIFIED: %d live documents, exactly one unchanged-format row each; all checksums and minhash signatures match.' % n, flush=True)"]
[148.421206, "o", "\r\n"]
[148.421247, "o", "\u001b[?2004l\r"]
[148.421306, "o", "\u001b[?2004h"]
[148.421508, "o", "> "]
[148.421527, "o", "Path('/tmp/reindex-verified.json').write_text(json.dumps({'verified_rows': n, 'checkpoint': state}, indent=2))"]
[148.421592, "o", "\r\n"]
[148.421641, "o", "\u001b[?2004l\r"]
[148.421699, "o", "\u001b[?2004h"]
[148.421751, "o", "> "]
[148.421974, "o", "PY\r\n\u001b[?2004l\r"]
[148.423019, "o", "\u001b[?2004h"]
[148.423125, "o", "root@4b540f928f29:/app# "]
[148.423368, "o", "bash /tmp/finish-reindex.sh > /tmp/reindex-backfill.log 2>&1 & echo \"backfill pid=$!\"\r\n"]
[148.423383, "o", "\u001b[?2004l\r[1] 339\r\n"]
[148.423438, "o", "backfill pid=339\r\n"]
[148.423527, "o", "\u001b[?2004h"]
[148.423555, "o", "root@4b540f928f29:/app# "]
[148.609528, "i", "cat >> README.md <<'MD'\n\n## Resume and recovery\n\n`last_id` is the last **committed** document ID (not an offset or the next ID).\nThe worker resumes strictly after it, preserving the source's gaps and deleted-row\nfiltering. SIGTERM, SIGINT, and SIGHUP request a stop between documents; the worker\ncommits the finished prefix and exits 75 when incomplete.\n\nA commit first flushes and fsyncs shard data and directory entries, then atomically\nreplaces and fsyncs the checkpoint. The checkpoint includes a `position` containing\nthe final shard number and byte offset. On restart, that shard is truncated to the\ncommitted offset and any later shards are removed before appending new work.\nThus a hard kill can discard uncommitted work but cannot skip committed rows or\nreplay rows into duplicates. Shard boundaries have no semantic meaning; a resumed\nrun starts a new shard. A completed checkpoint is idempotent.\n\nOld checkpoints without a durable position cannot be trusted (the old writer\ncheckpointed buffered rows); they trigg"]
[148.609613, "i", "er a one-time rebuild. Malformed checkpoints\nor missing committed bytes fail closed rather than silently resetting progress.\nUse `./jobs clean` only when intentionally requesting a new full rebuild.\nMD\npython3 -m compileall -q reindex tests; tail -8 /tmp/reindex-backfill.log\n"]
[148.618392, "o", "cat >> README.md <<'MD'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ## Resume and recovery\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> `last_id` is the last **committed** document ID (not an offset or the next ID).\r\n\u001b[?2004l\r\u001b[?2004h> The worker resumes strictly after it, preserving the source's gaps and deleted-row\r\n\u001b[?2004l\r\u001b[?2004h> filtering. SIGTERM, SIGINT, and SIGHUP request a stop between documents; the worker\r\n\u001b[?2004l\r\u001b[?2004h> commits the finished prefix and exits 75 when incomplete.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> A commit first flushes and fsyncs shard data and directory entries, then atomically\r\n\u001b[?2004l\r\u001b[?2004h> replaces and fsyncs the checkpoint. The checkpoint includes a `position` containing\r\n\u001b[?2004l\r\u001b[?2004h> the final shard number and byte offset. On restart, that shard is truncated to the\r\n\u001b[?2004l\r\u001b[?2004h> committed offset and any later shards are removed before appending new work.\r\n\u001b[?2004l\r\u001b[?2004h> Thus a hard kill can discard uncommitted work but cannot skip committed rows or\r\n"]
[148.618468, "o", "\u001b[?2004l\r\u001b[?2004h> replay rows into duplicates. Shard boundaries have no semantic meaning; a resumed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.623815, "o", "run starts a new shard. A completed checkpoint is idempotent."]
[148.624232, "o", "\r\n"]
[148.624823, "o", "\u001b[?2004l\r"]
[148.624894, "o", "\u001b[?2004h"]
[148.624946, "o", "> "]
[148.625034, "o", "\r\n\u001b[?2004l\r"]
[148.626688, "o", "\u001b[?2004h"]
[148.627733, "o", "> Old checkpoints without a durable position cannot be trusted (the old writer"]
[148.627795, "o", "\r\n\u001b[?2004l\r"]
[148.627809, "o", "\u001b[?2004h"]
[148.627829, "o", "> "]
[148.62792, "o", "checkpointed buffered rows); they trigger a one-time rebuild. Malformed checkpoints"]
[148.627927, "o", "\r\n"]
[148.627935, "o", "\u001b[?2004l\r"]
[148.627951, "o", "\u001b[?2004h"]
[148.62796, "o", "> "]
[148.628038, "o", "or missing committed bytes fail closed rather than silently resetting progress."]
[148.628045, "o", "\r\n"]
[148.628052, "o", "\u001b[?2004l\r"]
[148.628063, "o", "\u001b[?2004h"]
[148.628072, "o", "> "]
[148.628157, "o", "Use `./jobs clean` only when intentionally requesting a new full rebuild."]
[148.628165, "o", "\r\n"]
[148.628174, "o", "\u001b[?2004l\r"]
[148.628187, "o", "\u001b[?2004h"]
[148.628196, "o", "> "]
[148.628205, "o", "MD"]
[148.628211, "o", "\r\n"]
[148.628218, "o", "\u001b[?2004l\r"]
[148.632814, "o", "\u001b[?2004h"]
[148.632933, "o", "root@4b540f928f29:/app# "]
[148.633149, "o", "python3 -m compileall -q reindex tests; tail -8 /tmp/reindex-backfill.log"]
[148.633277, "o", "\r\n"]
