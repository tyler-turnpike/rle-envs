[98.73363, "i", "cat > tests/test_recovery.py <<'PY'\n\"\"\"Regression tests for the durable-prefix commit/recovery protocol.\"\"\"\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source, generate_corpus\nfrom reindex.store import ShardWriter, iter_rows, shard_paths\nfrom reindex.worker import _run, parse_args, run\n\nROOT = Path(__file__).resolve().parent.parent\n\n\ndef cheap_row(doc):\n    return {\"id\": doc.id, \"title\": doc.title}\n\n\nclass CheckpointTest(unittest.TestCase):\n    def test_failed_replace_keeps_old_checkpoint(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            ckpt = Checkpoint(Path(tmp) / \"checkpoint.json\")\n            ckpt.save({\"docs\": 3})\n            with patch(\"reindex.checkpoint.os.replace\", side_effect=OSError(\"crash\")):\n                with self.assertRaises(OSError):\n                    ckpt.save({\"docs\": 9})\n            self."]
[98.733767, "i", "assertEqual(ckpt.load()[\"docs\"], 3)\n            self.assertEqual(list(Path(tmp).glob(\"*.tmp\")), [])\n\n    def test_corrupt_checkpoint_fails_closed(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"checkpoint.json\"\n            path.write_text('{\"docs\":')\n            with self.assertRaises(ValueError):\n                Checkpoint(path).load()\n\n\nclass StoreRecoveryTest(unittest.TestCase):\n    def test_truncate_partial_tail_and_remove_later_shards(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            writer = ShardWriter(tmp, shard_rows=3, buffer_rows=2)\n            for i in range(5):\n                writer.add({\"id\": i, \"title\": \"café 東京\"})\n            position = writer.flush()\n            for i in range(5, 11):\n                writer.add({\"id\": i})\n            writer.close()\n            with open(shard_paths(tmp)[-1], \"ab\") as fh:\n                fh.write(b'{\"id\":')\n            writer = ShardWriter(tmp, shard_rows=3, buffer_rows=2)\n            writer.re"]
[98.733775, "o", "cat > tests/test_recovery.py <<'PY'\r\n"]
[98.733779, "i", "cover(position)\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], list(range(5)))\n            writer.add({\"id\": 5})\n            writer.close()\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], list(range(6)))\n            writer = ShardWriter(tmp)\n            writer.recover(position)\n            writer.recover(position)  # Recovery itself can be repeated safely.\n            writer.close()\n            self.assertEqual([r[\"id\"] for r in iter_rows(tmp)], list(range(5)))\n\n    def test_missing_committed_bytes_fail_closed(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            writer = ShardWriter(tmp)\n            writer.add({\"id\": 1})\n            position = writer.flush()\n            writer.close()\n            shard_paths(tmp)[0].write_bytes(b\"\")\n            writer = ShardWriter(tmp)\n            with self.assertRaisesRegex(ValueError, \"shorter\"):\n                writer.recover(position)\n            writer.abort()\n\n\nclass WorkerRecoveryTest(unittest.TestCase):\n    def args(s"]
[98.735049, "o", "\u001b[?2004l\r\u001b[?2004h> \"\"\"Regression tests for the durable-prefix commit/recovery protocol.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import signal\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> import unittest\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from reindex.checkpoint import Checkpoint\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.source import Source, generate_corpus\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.store import ShardWriter, iter_rows, shard_paths\r\n\u001b[?2004l\r\u001b[?2004h> from reindex.worker import _run, parse_args, run\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ROOT = Path(__file__).resolve().parent.parent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def cheap_row(doc):\r\n\u001b[?2004l\r\u001b[?2004h>     return {\"id\": doc.id, \"title\": doc.title}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004"]
[98.735073, "i", "elf, tmp, batch_size=9):\n        return parse_args([\"--source\", str(tmp / \"docs.db\"), \"--index-dir\", str(tmp / \"index\"),\n                           \"--checkpoint\", str(tmp / \"checkpoint.json\"),\n                           \"--batch-size\", str(batch_size)])\n\n    def expected(self, args):\n        source = Source(args.source)\n        try:\n            return [cheap_row(d) for batch in source.batches(0, 11) for d in batch]\n        finally:\n            source.close()\n\n    def assert_prefix(self, args):\n        state = Checkpoint(args.checkpoint).load()\n        rows = list(iter_rows(args.index_dir))\n        self.assertEqual(rows, self.expected(args)[:state[\"docs\"]])\n        if rows:\n            self.assertEqual(state[\"last_id\"], rows[-1][\"id\"])\n        return state\n\n    def test_many_short_runs_and_completed_rerun(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            tmp = Path(tmp)\n            generate_corpus(tmp / \"docs.db\", count=87, seed=5)\n            args = self.args(tmp)\n            previous = 0"]
