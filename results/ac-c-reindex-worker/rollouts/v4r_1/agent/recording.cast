[67.511774, "o", "    # The handler never interrupts a write/rename. Stop between documents instead.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.511864, "o", "    stopping = False\r\n\u001b[?2004l\r"]
[67.511935, "o", "\u001b[?2004h"]
[67.511979, "o", "> "]
[67.512048, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.512137, "o", "    def request_stop(signum, frame):\r\n\u001b[?2004l\r"]
[67.512207, "o", "\u001b[?2004h> "]
[67.512363, "o", "        nonlocal stopping\r\n\u001b[?2004l\r\u001b[?2004h>         stopping = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.512558, "o", "    old_handlers = {sig: signal.signal(sig, request_stop)\r\n\u001b[?2004l\r"]
[67.512656, "o", "\u001b[?2004h> "]
[67.51283, "o", "                    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n\u001b[?2004l\r"]
[67.512938, "o", "\u001b[?2004h> "]
[67.513033, "o", "    try:\r\n\u001b[?2004l\r"]
[67.513126, "o", "\u001b[?2004h> "]
[67.514411, "o", "        return _run(args, lambda: stopping)\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         for sig, handler in old_handlers.items():\r\n\u001b[?2004l\r\u001b[?2004h>             signal.signal(sig, handler)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _run(args, stopping):\r\n\u001b[?2004l\r\u001b[?2004h>     ckpt = Checkpoint(args.checkpoint)\r\n\u001b[?2004l\r\u001b[?2004h>     state = ckpt.load()\r\n\u001b[?2004l\r\u001b[?2004h>     source = Source(args.source)\r\n\u001b[?2004l\r\u001b[?2004h>     store = ShardWriter(args.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         if \"position\" not in state:\r\n\u001b[?2004l\r\u001b[?2004h>             # Legacy checkpoints did not describe a durable prefix and may already\r\n\u001b[?2004l\r\u001b[?2004h>             # have missing/duplicate rows. Rebuild once rather than trust them.\r\n\u001b[?2004l\r\u001b[?2004h>             log.info(\"no recoverable checkpoint: rebuilding index from scratch\")\r\n\u001b[?2004l\r\u001b[?2004h>             store.reset()\r\n\u001b[?2004l\r\u001b[?2004h>             state = {\"last_id\": 0, \"docs\": 0, \"complete\": "]
[67.514484, "o", "False,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.514606, "o", "                     \"position\": store.flush()}"]
[67.517869, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             store.recover(state[\"position\"])\r\n\u001b[?2004l\r\u001b[?2004h>         if state[\"complete\"]:\r\n\u001b[?2004l\r\u001b[?2004h>             log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>             return 0\r\n\u001b[?2004l\r\u001b[?2004h>         total = source.count()\r\n\u001b[?2004l\r\u001b[?2004h>         started = time.monotonic()\r\n\u001b[?2004l\r\u001b[?2004h>         initial_docs = state[\"docs\"]\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Source.batches has an inclusive start; checkpoint.last_id is already done.\r\n\u001b[?2004l\r\u001b[?2004h>         start_id = state[\"last_id\"] + 1 if state[\"docs\"] else 0\r\n\u001b[?2004l\r\u001b[?2004h>         for n, batch in enumerate(source.batches(start_id=start_id, size=args.batch_size), 1):\r\n\u001b[?2004l\r\u001b[?2004h>             for doc in batch:\r\n\u001b[?2004l\r\u001b[?2004h>                "]
[67.517895, "o", " if stopping():\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h>                 store.add(transform_doc(doc))\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"last_id\"] = doc.id\r\n\u001b[?2004l\r\u001b[?2004h>                 state[\"docs\"] += 1\r\n\u001b[?2004l\r\u001b[?2004h>             # Data (including directory entries) must reach disk before progress.\r\n\u001b[?2004l\r\u001b[?2004h>             # If killed before checkpoint replacement, recovery drops this tail.\r\n\u001b[?2004l\r\u001b[?2004h>             state[\"position\"] = store.flush()\r\n\u001b[?2004l\r\u001b[?2004h>             ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>             if stopping():\r\n\u001b[?2004l\r\u001b[?2004h>                 log.info(\"stopped at id %d (%d docs committed)\", state[\"last_id\"], state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>                 return 75\r\n\u001b[?2004l\r\u001b[?2004h>             if n % 20 == 0:\r\n\u001b[?2004l\r\u001b[?2004h>                 rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\r\n\u001b[?2004l\r\u001b[?2004h>                 log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n\u001b["]
[67.517912, "o", "?2004l\r\u001b[?2004h>                          state[\"last_id\"], state[\"docs\"], total, rate)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if stopping():\r\n\u001b[?2004l\r\u001b[?2004h>             return 75\r\n\u001b[?2004l\r\u001b[?2004h>         state[\"complete\"] = True\r\n\u001b[?2004l\r\u001b[?2004h>         ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         store.abort()\r\n\u001b[?2004l\r\u001b[?2004h>         source.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' +s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('    return parser.parse_args(argv)', '    args = parser.parse_args(argv)\\n    if args.batch_size <= 0:\\n        parser.error(\"--batch-size must be positive\")\\n    return args')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
