[98.735084, "i", "\n            for _ in range(30):\n                transformed = 0\n\n                def transform(doc):\n                    nonlocal transformed\n                    transformed += 1\n                    return cheap_row(doc)\n\n                with patch(\"reindex.worker.transform_doc\", side_effect=transform):\n                    rc = _run(args, lambda: transformed >= 7)\n                state = self.assert_prefix(args)\n                self.assertGreaterEqual(state[\"docs\"], previous)\n                previous = state[\"docs\"]\n                if rc == 0:\n                    break\n            else:\n                self.fail(\"repeated runs did not converge\")\n            self.assertTrue(state[\"complete\"])\n            before = {p.name: p.read_bytes() for p in shard_paths(args.index_dir)}\n            with patch(\"reindex.worker.transform_doc\", side_effect=AssertionError(\"already indexed\")):\n                self.assertEqual(_run(args, lambda: False), 0)\n            self.assertEqual(before, {p.name: p.read_bytes() for p in sha"]
[98.735087, "i", "rd_paths(args.index_dir)})\n            self.assertEqual(list(iter_rows(args.index_dir)), self.expected(args))\n\n    def test_sigterm_commits_partial_batch(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            tmp = Path(tmp)\n            generate_corpus(tmp / \"docs.db\", count=20)\n            args = self.args(tmp)\n            calls = 0\n\n            def transform(doc):\n                nonlocal calls\n                calls += 1\n                if calls == 3:\n                    os.kill(os.getpid(), signal.SIGTERM)\n                return cheap_row(doc)\n\n            with patch(\"reindex.worker.transform_doc\", side_effect=transform):\n                self.assertEqual(run(args), 75)\n            self.assertEqual(self.assert_prefix(args)[\"docs\"], 3)\n            with patch(\"reindex.worker.transform_doc\", side_effect=cheap_row):\n                self.assertEqual(run(args), 0)\n            self.assertTrue(self.assert_prefix(args)[\"complete\"])\n\n    def test_hard_exit_before_and_after_checkpoint_replace(self):\n   "]
[98.735093, "i", "     # Real process exits avoid Python cleanup and exercise both sides of the\n        # data-durable / progress-published boundary. Every row keeps its ID.\n        script = '''\nimport os, sys\nfrom unittest.mock import patch\nfrom reindex.worker import main\nfrom reindex.checkpoint import Checkpoint\noriginal = Checkpoint.save\ncalls = 0\ndef crash(self, state):\n    global calls\n    calls += 1\n    if calls == 3:\n        if sys.argv[1] == \"after\":\n            original(self, state)\n        os._exit(99)\n    original(self, state)\nwith patch(\"reindex.worker.transform_doc\", side_effect=lambda d: {\"id\": d.id, \"title\": d.title}), patch.object(Checkpoint, \"save\", crash):\n    main(sys.argv[2:])\n'''\n        for when in (\"before\", \"after\"):\n            with self.subTest(when=when), tempfile.TemporaryDirectory() as tmp:\n                tmp = Path(tmp)\n                generate_corpus(tmp / \"docs.db\", count=50)\n                args = self.args(tmp)\n                cli = [\"--source\", args.source, \"--index-dir\", args.index_dir,\n  "]
[98.735301, "i", "                     \"--checkpoint\", args.checkpoint, \"--batch-size\", \"9\"]\n                proc = subprocess.run([sys.executable, \"-c\", script, when] + cli,\n                                      cwd=ROOT, capture_output=True, timeout=10)\n                self.assertEqual(proc.returncode, 99, proc.stderr.decode())\n                state = Checkpoint(args.checkpoint).load()\n                self.assertEqual(state[\"docs\"], 9 if when == \"before\" else 18)\n                writer = ShardWriter(args.index_dir)\n                writer.recover(state[\"position\"])\n                writer.abort()\n                self.assert_prefix(args)\n                with patch(\"reindex.worker.transform_doc\", side_effect=cheap_row):\n                    self.assertEqual(_run(args, lambda: False), 0)\n                self.assertTrue(self.assert_prefix(args)[\"complete\"])\n\n    def test_empty_source(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            tmp = Path(tmp)\n            generate_corpus(tmp / \"docs.db\", count=0)\n          "]
[98.73532, "i", "  args = self.args(tmp)\n            self.assertEqual(_run(args, lambda: False), 0)\n            state = self.assert_prefix(args)\n            self.assertTrue(state[\"complete\"])\n            self.assertEqual(state[\"docs\"], 0)\n\n    def test_unsafe_legacy_checkpoint_rebuilt(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            tmp = Path(tmp)\n            generate_corpus(tmp / \"docs.db\", count=10)\n            args = self.args(tmp)\n            Checkpoint(args.checkpoint).save({\"last_id\": 900, \"docs\": 900, \"complete\": True})\n            writer = ShardWriter(args.index_dir)\n            writer.add({\"id\": 900})\n            writer.close()\n            with patch(\"reindex.worker.transform_doc\", side_effect=cheap_row):\n                self.assertEqual(_run(args, lambda: False), 0)\n            self.assertTrue(self.assert_prefix(args)[\"complete\"])\nPY\n./jobs test > /tmp/reindex-tests.log 2>&1 & echo \"tests pid=$!\"\n./jobs reindex > /tmp/reindex-run1.log 2>&1 & echo \"reindex pid=$!\"\n"]
