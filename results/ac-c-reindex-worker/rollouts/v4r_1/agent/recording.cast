[10.686319, "o", "\r\n\u001b[?2004l\r\"\"\"Source corpus: the documents table the search index is built from.\r\n\r\nThe corpus lives in data/docs.db (SQLite).  Ids are increasing but not contiguous\r\n(deleted rows are purged now and then), and soft-deleted rows are skipped.\r\n`generate_corpus` builds the fixture corpus used in dev images and tests.\r\n\"\"\"\r\nimport random\r\nimport sqlite3\r\nfrom collections import namedtuple\r\n\r\nDoc = namedtuple(\"Doc\", \"id title body lang\")\r\n\r\nDEFAULT_SEED = 20240611\r\nDEFAULT_COUNT = 6000\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS docs (\r\n    id INTEGER PRIMARY KEY,\r\n    title TEXT NOT NULL,\r\n    body TEXT NOT NULL,\r\n    lang TEXT NOT NULL,\r\n    deleted INTEGER NOT NULL DEFAULT 0,\r\n    updated_at TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\n_ACCENTED = [\"café\", \"naïve\", \"résumé\", \"über\", \"façade\", \"Ångström\", \"smörgåsbord\",\r\n             \"jalapeño\", \"Zürich\", \"déjà\", \"crème\", \"señor\", \"Straße\", \"coöperate\"]\r\n_STOP = [\"the\", \"of\", \"and\", \"to\", \"in\", \"is\", \"for\", \"with\", \"on\", \"as\", \"by\", \"at\"]\r\n\r\n\r\ndef _vocabulary(rn"]
[10.686326, "o", "g, size=700):\r\n    onsets = [\"b\", \"c\", \"d\", \"f\", \"g\", \"h\", \"k\", \"l\", \"m\", \"n\", \"p\", \"r\", \"s\", \"t\",\r\n              \"v\", \"w\", \"z\", \"br\", \"ch\", \"cl\", \"dr\", \"gr\", \"pl\", \"qu\", \"sh\", \"st\", \"th\", \"tr\"]\r\n    vowels = [\"a\", \"e\", \"i\", \"o\", \"u\", \"ai\", \"ea\", \"io\", \"ou\", \"y\"]\r\n    codas = [\"\", \"\", \"n\", \"r\", \"s\", \"t\", \"l\", \"m\", \"ck\", \"nd\", \"st\", \"x\"]\r\n    words = set()\r\n    while len(words) < size:\r\n        syllables = rng.randint(1, 3)\r\n        words.add(\"\".join(rng.choice(onsets) + rng.choice(vowels) + rng.choice(codas)\r\n                          for _ in range(syllables)))\r\n    return sorted(words) + _ACCENTED + _STOP * 6\r\n\r\n\r\ndef generate_corpus(path, count=DEFAULT_COUNT, seed=DEFAULT_SEED):\r\n    \"\"\"Write a deterministic corpus of `count` documents to the SQLite file at `path`.\"\"\"\r\n    rng = random.Random(seed)\r\n    vocab = _vocabulary(rng)\r\n    rows, doc_id = [], 0\r\n    for _ in range(count):\r\n        doc_id += rng.choice((1, 1, 1, 2, 3))\r\n        title = \" \".join(rng.choice(vocab) for _ in range(rng.randint(2, 7))).t"]
[10.686332, "o", "itle()\r\n        sentences = []\r\n        for _ in range(rng.randi"]
[10.686585, "o", "nt(0, 9)):\r\n            words = [rng.choice(vocab) for _ in range(rng.randint(4, 18))]\r\n            if rng.random() < 0.15:\r\n                words[0] = words[0].upper()\r\n            sentences.append(\" \".join(words).capitalize() + rng.choice((\".\", \"!\", \"?\", \"...\", \";\")))\r\n        body = \" \".join(sentences)\r\n        lang = rng.choice((\"en\", \"en\", \"en\", \"de\", \"fr\"))\r\n        deleted = 1 if rng.random() < 0.04 else 0\r\n        updated = \"2024-%02d-%02d\" % (rng.randint(1, 12), rng.randint(1, 28))\r\n        rows.append((doc_id, title, body, lang, deleted, updated))\r\n    conn = sqlite3.connect(path)\r\n    with conn:\r\n        conn.executescript(SCHEMA)\r\n        conn.execute(\"DELETE FROM docs\")\r\n        conn.executemany(\"INSERT INTO docs VALUES (?, ?, ?, ?, ?, ?)\", rows)\r\n    conn.close()\r\n    return len(rows)\r\n\r\n\r\nclass Source:\r\n    \"\"\"Read-only access to the live (not soft-deleted) documents, in id order.\"\"\"\r\n\r\n    def __init__(self, path):\r\n        self.conn = sqlite3.connect(\"file:%s?mode=ro\" % path, uri=True)\r\n\r\n   "]
[10.686629, "o", " def count(self):\r\n        return self.conn.execute(\"SELECT COUNT(*) FROM docs WHERE deleted = 0\").fetchone()[0]\r\n\r\n    def batches(self, start_id=0, size=25):\r\n        \"\"\"Yield lists of Docs with id >= start_id, `size` at a time, in id order.\"\"\"\r\n        next_id = start_id\r\n        while True:\r\n            rows = self.conn.execute(\r\n                \"SELECT id, title, body, lang FROM docs WHERE deleted = 0 AND id >= ? \"\r\n                \"ORDER BY id LIMIT ?\", (next_id, size)).fetchall()\r\n            if not rows:\r\n                return\r\n            yield [Doc(*row) for row in rows]\r\n            next_id = rows[-1][0] + 1\r\n\r\n    def close(self):\r\n        self.conn.close()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    import sys\r\n    out = sys.argv[1] if len(sys.argv) > 1 else \"data/docs.db\"\r\n    print(\"wrote %d docs to %s\" % (generate_corpus(out), out))\r\n"]
[10.686693, "o", "\"\"\"Document -> index row.\r\n\r\nRow format (consumed by the search service; do not change without a format bump):\r\n  id        source doc id\r\n  slug      url slug from the title\r\n  lang      language code\r\n  length    number of index tokens (stopwords removed)\r\n  terms     up to 8 most frequent tokens, ties broken alphabetically\r\n  checksum  sha256 prefix over the normalised title + body (change detection)\r\n  minhash   64 x 32-bit minhash values over character 5-grams (near-duplicate detection)\r\n\"\"\"\r\nimport hashlib\r\nimport re\r\nimport unicodedata\r\nfrom collections import Counter\r\n\r\nTOKEN_RE = re.compile(r\"[a-z0-9]+\")\r\nSTOPWORDS = frozenset(\"a an and are as at be by for from has in is it of on or that the to was \"\r\n                      \"were will with\".split())\r\nTOP_TERMS = 8\r\nNUM_PERM = 64\r\nSHINGLE = 5\r\n_SALTS = [b\"perm-%04d\" % i for i in range(NUM_PERM)]\r\n\r\n\r\ndef normalize(text):\r\n    \"\"\"NFKD-fold accents away and lowercase.\"\"\"\r\n    text = unicodedata.normalize(\"NFKD\", text)\r\n    return \"\".join(ch for ch in tex"]
[10.686742, "o", "t if not unicodedata.combining(ch)).lower()\r\n\r\n\r\ndef tokenize(text):\r\n    return [tok for tok in TOKEN_RE.findall(normalize(text)) if tok not in STOPWORDS]\r\n\r\n\r\ndef slugify(title):\r\n    return \"-\".join(TOKEN_RE.findall(normalize(title)))[:64] or \"untitled\"\r\n\r\n\r\ndef checksum(title, body):\r\n    digest = hashlib.sha256()\r\n    digest.update(normalize(title).encode(\"utf-8\"))\r\n    digest.update(b\"\\x00\")\r\n    digest.update(normalize(body).encode(\"utf-8\"))\r\n    return digest.hexdigest()[:32]\r\n\r\n\r\ndef minhash(tokens):\r\n    text = \" \".join(tokens)\r\n    shingles = {text[i:i + SHINGLE] for i in range(max(1, len(text) - SHINGLE + 1))}\r\n    encoded = [s.encode(\"utf-8\") for s in sorted(shingles)]\r\n    blake = hashlib.blake2b\r\n    signature = []\r\n    for salt in _SALTS:\r\n        signature.append(min(int.from_bytes(blake(s, digest_size=4, salt=salt).digest(), \"big\")\r\n                             for s in encoded))\r\n    return signature\r\n\r\n\r\ndef transform_doc(doc):\r\n    tokens = tokenize(doc.title + \" \" + doc.body)\r\n    top = "]
