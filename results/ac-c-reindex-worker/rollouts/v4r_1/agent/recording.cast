[10.551649, "o", "# search-reindex\r\n\r\nBuilds the search index (`var/index/shard-*.jsonl`) from the document store\r\n(`data/docs.db`).\r\n\r\n| path | what |\r\n|------|------|\r\n| `reindex/worker.py` | the reindex job: reads docs in id order, transforms, writes shards, checkpoints |\r\n| `reindex/transform.py` | doc -> index row (row format documented there) |\r\n| `reindex/store.py` | shard writer / reader |\r\n| `reindex/checkpoint.py` | progress checkpoint (`var/checkpoint.json`) |\r\n| `reindex/source.py` | source corpus access (+ fixture generator) |\r\n| `ops/supervise.py` | job runner used for every batch job here: budget, SIGTERM/SIGKILL, run log |\r\n| `ops/limits.json` | per-job budgets and cooldowns |\r\n| `jobs` | entry points: `./jobs reindex`, `./jobs status`, `./jobs history`, `./jobs test`, `./jobs clean` |\r\n\r\nA full reindex of the current corpus is several budgets long; the job is designed\r\nto be run repeatedly and pick up where the previous run stopped.\r\n"]
[10.555231, "o", "\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n\r\nNormally started by `make reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str(ROOT / \"var\" / \""]
[10.55542, "o", "index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    ckpt = Checkpoint(args.checkpoint)\r\n    state = ckpt.load()\r\n    if state[\"complete\"]:\r\n        log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n        return 0\r\n    so"]
[10.555432, "o", "urce = Source(args.source)\r\n    store = ShardWriter(args.index_dir)\r\n    if state[\"last_id\"] == 0:\r\n        log.info(\"no checkpoint: rebuilding index from scratch\")\r\n        store.reset()\r\n    total = source.count()\r\n    started = time.monotonic()\r\n    log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\r\n    for n, batch in enumerate(source.batches(start_id=state[\"last_id\"], size=args.batch_size), 1):\r\n        for doc in batch:\r\n            store.add(transform_doc(doc))\r\n        state[\"last_id\"] = batch[-1].id\r\n        state[\"docs\"] += len(batch)\r\n        ckpt.save(state)\r\n        if n % 20 == 0:\r\n            rate = n * args.batch_size / (time.monotonic() - started)\r\n            log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                     state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n    store.close()\r\n    state[\"complete\"] = True\r\n    ckpt.save(state)\r\n    source.close()\r\n    log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n    return 0\r\n\r\n\r"]
[10.555868, "o", "\ndef main(argv=None):\r\n    logging.basicConfig(level=logging.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"Reindex progress checkpoint (var/checkpoint.json).\"\"\"\r\nimport json\r\nimport logging\r\nfrom pathlib import Path\r\n\r\nlog = logging.getLogger(\"reindex.checkpoint\")\r\n\r\n\r\ndef fresh_state():\r\n    # last_id: id of the last document handled; docs: documents indexed so far\r\n    return {\"last_id\": 0, \"docs\": 0, \"complete\": False}\r\n\r\n\r\nclass Checkpoint:\r\n    def __init__(self, path):\r\n        self.path = Path(path)\r\n\r\n    def load(self):\r\n        try:\r\n            data = json.loads(self.path.read_text())\r\n        except FileNotFoundError:\r\n            return fresh_state()\r\n        except ValueError:\r\n            log.warning(\"checkpoint %s unreadable, starting over"]
[10.555889, "o", "\", self.path)\r\n            return fresh_state()\r\n        state = fresh_state()\r\n        state.update(data)\r\n        return state\r\n\r\n    def save(self, state):\r\n        self.path.parent.mkdir(parents=True, exist_ok=True)\r\n        with open(self.path, \"w\") as fh:\r\n            json.dump(state, fh)\r\n\r\n    def clear(self):\r\n        self.path.unlink(missing_ok=True)\r\n\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\")"]
[10.555895, "o", ")\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close"]
[10.5559, "o", "_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(sel"]
[10.555945, "o", "f):\r\n        if self._fh is not None:\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n"]
