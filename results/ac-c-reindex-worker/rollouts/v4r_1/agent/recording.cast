[115.149783, "o", "\r\n\u001b[?2004l\r\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n\r\nNormally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport signal\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", "]
[115.149804, "o", "default=str(ROOT / \"var\" / \"index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    args = parser.parse_args(argv)\r\n    if args.batch_size <= 0:\r\n        parser.error(\"--batch-size must be positive\")\r\n    return args\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    # The handler never interrupts a write/rename. Stop"]
[115.149811, "o", " between documents instead.\r\n    stopping = False\r\n\r\n    def request_stop(signum, frame):\r\n        nonlocal stopping\r\n        stopping = True\r\n\r\n    old_handlers = {sig: signal.signal(sig, request_stop)\r\n                    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n    try:\r\n        return _run(args, lambda: stopping)\r\n    finally:\r\n        for sig, handler in old_handlers.items():\r\n            signal.signal(sig, handler)\r\n\r\n\r\ndef _run(args, stopping):\r\n    ckpt = Checkpoint(args.checkpoint)\r\n    state = ckpt.load()\r\n    source = Source(args.source)\r\n    store = ShardWriter(args.index_dir)\r\n    try:\r\n        if \"position\" not in state:\r\n            # Legacy checkpoints did not describe a durable prefix and may already\r\n            # have missing/duplicate rows. Rebuild once rather than trust them.\r\n            log.info(\"no recoverable checkpoint: rebuilding index from scratch\")\r\n            store.reset()\r\n            state = {\"last_id\": 0, \"docs\": 0, \"complete\": False,\r\n                     "]
[115.149814, "o", "\"position\": store.flush()}\r\n            ckpt.save(state)\r\n        else:\r\n            store.recover(state[\"position\"])\r\n        if state[\"complete\"]:\r\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n            return 0\r\n        total = source.count()\r\n        started = time.monotonic()\r\n        initial_docs = state[\"docs\"]\r\n        log.info(\"starting after id %d (%d/%d docs done)\", state[\"last_id\"], state[\"docs\"], total)\r\n\r\n        # Source.batches has an inclusive start; checkpoint.last_id is already done.\r\n        start_id = state[\"last_id\"] + 1 if state[\"docs\"] else 0\r\n        for n, batch in enumerate(source.batches(start_id=start_id, size=args.batch_size), 1):\r\n            for doc in batch:\r\n                if stopping():\r\n                    break\r\n                store.add(transform_doc(doc))\r\n                state[\"last_id\"] = doc.id\r\n                state[\"docs\"] += 1\r\n            # Data (including directory entries) must reach disk before progress.\r\n            # If killed "]
[115.150041, "o", "before checkpoint replacement, recovery drops this tail.\r\n            state[\"position\"] = store.flush()\r\n            ckpt.save(state)\r\n            if stopping():\r\n                log.info(\"stopped at id %d (%d docs committed)\", state[\"last_id\"], state[\"docs\"])\r\n                return 75\r\n            if n % 20 == 0:\r\n                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\r\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                         state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n        if stopping():\r\n            return 75\r\n        state[\"complete\"] = True\r\n        ckpt.save(state)\r\n        log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n        return 0\r\n    finally:\r\n        store.abort()\r\n        source.close()\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logging.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None "]
[115.150049, "o", "else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\u001b[?2004hroot@4b540f928f29:/app# "]
