    return 0


def run(args):
    if args.batch_size <= 0:
        raise ValueError("batch size must be positive")
    stopping = False

    def request_stop(signum, frame):
        nonlocal stopping
        stopping = True

    handlers = {sig: signal.signal(sig, request_stop)
                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    source = store = None
    try:
        ckpt = Checkpoint(args.checkpoint)
        state = ckpt.load()
        # Old checkpoints could get ahead of the index. There is no trustworthy
        # durable boundary in that format, so migrate by rebuilding, not guessing.
        if "shards" not in state:
            if state["docs"] or state["complete"]:
                log.warning("legacy checkpoint has no durable offsets; rebuilding")
            state = {"last_id": 0, "docs": 0, "complete": False, "shards": {}}
            ckpt.save(state)
        store = ShardWriter(args.index_dir)
        store.recover(state["shards"])
        if state["complete"]:
            log.info("index already complete (%d docs)", state["docs"])
            return 0
        source = Source(args.source)
        total = source.count()
        started = time.monotonic()
        initial_docs = state["docs"]
        log.info("starting after id %d (%d/%d docs done)", state["last_id"], state["docs"], total)

        # Source.batches is inclusive; last_id is the last *committed* document.
        start_id = state["last_id"] + 1 if state["docs"] else 0
        for n, batch in enumerate(source.batches(start_id=start_id,
                                                size=args.batch_size), 1):
            last_id, count = state["last_id"], 0
            for doc in batch:
                if stopping:
                    break
                store.add(transform_doc(doc))
                last_id = doc.id
                count += 1
            if count:
                # All shard data (including rotated shards and directory entries)
                # is durable before publishing the corresponding checkpoint.
                offsets = store.committed_offsets()
                state = dict(state, last_id=last_id, docs=state["docs"] + count,
                             shards=offsets)
                ckpt.save(state)
            if stopping:
                log.info("stopped safely: last_id=%d docs=%d/%d",
                         state["last_id"], state["docs"], total)
                return 75
            if n % 20 == 0:
                rate = (state["docs"] - initial_docs) / (time.monotonic() - started)
                log.info("progress: last_id=%d docs=%d/%d (%.0f docs/s)",
                         state["last_id"], state["docs"], total, rate)

        state = dict(state, complete=True, shards=store.committed_offsets())
        ckpt.save(state)
        log.info("reindex complete: %d docs", state["docs"])
        return 0
    finally:
        try:
            if store is not None:
                store.abort()
            if source is not None:
                source.close()
        finally:
            for sig, handler in handlers.items():
                signal.signal(sig, handler)


def main(argv=None):
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(asctime)s %(name)s %(levelname)s %(message)s")
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.status:
        return show_status(args)
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
