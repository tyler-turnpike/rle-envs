[69.300276, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''        self._buffer.clear()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _rotate''', '''        # Persist new shard names as well as their contents before allowing\r\n\u001b[?2004l\r\u001b[?2004h>         # a checkpoint to refer to them.\r\n\u001b[?2004l\r\u001b[?2004h>         sync_directory(self.index_dir)\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.clear()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _rotate''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''        if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.close()''', '''        if self._fh is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             # Rotation can occur inside flush(); every closed shard must be\r\n\u001b[?2004l\r\u001b[?2004h>             # durable, not only the final shard in that flush.\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h>             os.fsync(self._fh.fileno())\r\n\u001b[?2004l\r\u001b[?2004h>             self._fh.close()''')\r\n\u001b[?2004l\r\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h>     def abort(self):\r\n\u001b[?2004l\r\u001b[?2004"]
[69.300329, "o", "h>         \"\"\"Release resources without publishing or flushing buffered work.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         self._buffer.clear()\r\n\u001b[?2004l\r\u001b[?2004h>         self._close_shard()\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
