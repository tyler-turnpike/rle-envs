[178.141681, "i", "ce(marker, '''    def test_zero_id_is_included_on_fresh_build(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            tmp = Path(tmp)\n            generate_corpus(tmp / 'docs.db', count=0)\n            with sqlite3.connect(tmp / 'docs.db') as conn:\n                conn.execute(\"INSERT INTO docs VALUES (0, 'Zero', '', 'en', 0, 'now')\")\n            self.assertEqual(run(parse_args(self.args(tmp))), 0)\n            self.assertEqual(list(iter_rows(tmp / 'index')), self.expected(tmp))\n            self.assertEqual(Checkpoint(tmp / 'checkpoint.json').load()['docs'], 1)\n\n''' + marker)\nopen(p, 'w').write(s)\nPY\n./jobs test > /tmp/search-412-tests-final.log 2>&1 &\necho \"final tests pid=$!\"\ntail -30 /tmp/search-412-backfill.log\n"]
