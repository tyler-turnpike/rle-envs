[396.904635, "o", "> "]
[396.905236, "o", "assert r['checkpoint'] == Checkpoint('var/checkpoint.json').load()\r\n\u001b[?2004l\r\u001b[?2004h> assert r['source_sha256'] == hashlib.sha256(Path('data/docs.db').read_bytes()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h> assert r['shards'] == {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in shard_paths('var/index')}\r\n\u001b[?2004l\r\u001b[?2004h> assert not Path('ops/overrides/reindex.json').exists()\r\n\u001b[?2004l\r\u001b[?2004h> print('Final verification OK: 5,739 exact rows, six shards, complete checkpoint, normal limits restored.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
