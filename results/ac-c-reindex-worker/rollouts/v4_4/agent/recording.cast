[156.647212, "o", "        os.fsync(self._fh.fileno())\r\n        # Persist new shard names as well as their contents before allowing\r\n        # a checkpoint to refer to them.\r\n        sync_directory(self.index_dir)\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            # Rotation can occur inside flush(); every closed shard must be\r\n            # durable, not only the final shard in that flush.\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Release resources without publishing or flushing buffered work.\"\"\"\r\n        self._buffer.clear()\r\n        "]
[156.647383, "o", "self._close_shard()\r\n"]
