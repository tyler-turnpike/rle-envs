[178.295867, "i", "cat > /tmp/search-412-verify.py <<'PY'\nimport hashlib\nimport json\nimport sys\nimport time\nfrom pathlib import Path\n\nsys.path.insert(0, '/app')\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows, shard_paths\nfrom reindex.transform import transform_doc\n\nroot = Path('/app')\nckpt = Checkpoint(root / 'var/checkpoint.json')\nwhile not ckpt.load()['complete']:\n    time.sleep(2)\nstate = ckpt.load()\nrows = list(iter_rows(root / 'var/index'))\nsource = Source(root / 'data/docs.db')\nexpected_ids = []\nn = 0\nfor batch in source.batches(0, 100):\n    for doc in batch:\n        assert n < len(rows), ('missing row', doc.id)\n        assert rows[n] == transform_doc(doc), ('row mismatch', doc.id)\n        expected_ids.append(doc.id)\n        n += 1\n    print('verified full row contents:', n, flush=True)\nassert n == len(rows) == len(set(expected_ids)) == source.count() == state['docs']\nassert state['last_id'] == expected_ids[-1]\nsource.close()\nreport = {\n    'verified_rows': "]
[178.296089, "i", "n,\n    'unique_ids': len(set(expected_ids)),\n    'source': 'data/docs.db',\n    'source_sha256': hashlib.sha256((root / 'data/docs.db').read_bytes()).hexdigest(),\n    'all_rows_equal_transform_doc': True,\n    'checkpoint': state,\n    'shards': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()\n               for p in shard_paths(root / 'var/index')},\n}\n(root / 'var/reindex-verification.json').write_text(json.dumps(report, indent=2) + '\\n')\nprint('VERIFIED:', json.dumps(report), flush=True)\nPY\npython3 /tmp/search-412-verify.py > /tmp/search-412-verify.log 2>&1 &\necho \"verification pid=$!\"\n"]
