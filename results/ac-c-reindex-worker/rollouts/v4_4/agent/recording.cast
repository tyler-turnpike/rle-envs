[69.242579, "i", "cat > reindex/durability.py <<'PY'\n\"\"\"Filesystem durability helpers shared by index and checkpoint commits.\"\"\"\nimport os\n\n\ndef sync_directory(path):\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\nPY\ncat > reindex/checkpoint.py <<'PY'\n\"\"\"Atomically published reindex progress and its durable shard boundary.\"\"\"\nimport json\nimport logging\nimport os\nimport tempfile\nfrom pathlib import Path\n\nfrom reindex.durability import sync_directory\n\nlog = logging.getLogger(\"reindex.checkpoint\")\nVERSION = 1\n\n\ndef fresh_state():\n    return {\"version\": VERSION, \"last_id\": 0, \"docs\": 0,\n            \"complete\": False, \"position\": None}\n\n\nclass Checkpoint:\n    def __init__(self, path):\n        self.path = Path(path)\n\n    def load(self):\n        try:\n            data = json.loads(self.path.read_text())\n        except FileNotFoundError:\n            return fresh_state()\n        # Old checkpoints may acknowledge rows that were never written. They\n        # cannot safe"]
[69.2452, "i", "ly be resumed with the new commit protocol.\n        if \"version\" not in data:\n            log.warning(\"legacy checkpoint %s has no durable boundary; rebuilding\", self.path)\n            return fresh_state()\n        if data[\"version\"] != VERSION:\n            raise ValueError(\"unsupported checkpoint version\")\n        for key in fresh_state():\n            if key not in data:\n                raise ValueError(\"checkpoint missing %s\" % key)\n        if data[\"docs\"] and data[\"position\"] is None:\n            raise ValueError(\"checkpoint has no shard boundary\")\n        return data\n\n    def save(self, state):\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        fd, name = tempfile.mkstemp(prefix=self.path.name + \".\", suffix=\".tmp\",\n                                    dir=self.path.parent)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                json.dump(state, fh)\n                fh.flush()\n                os.fsync(fh.fileno())\n            os.replace(name, self.path)\n     "]
