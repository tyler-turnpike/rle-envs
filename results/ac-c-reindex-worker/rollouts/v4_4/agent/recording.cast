[142.329523, "i", "cat > /tmp/search-412-backfill.sh <<'SH'\n#!/bin/bash\ncd /app\nfor n in $(seq 1 60); do\n  ./jobs reindex\n  rc=$?\n  if [ \"$rc\" -ne 0 ] && [ \"$rc\" -ne 75 ]; then exit \"$rc\"; fi\n  python3 - <<'PY'\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.store import iter_rows\ns = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nassert len(rows) == s['docs'] == len({r['id'] for r in rows}), s\nassert rows[-1]['id'] == s['last_id'] if rows else s['docs'] == 0\nprint('verified committed rows:', len(rows), flush=True)\nPY\n  if [ \"$?\" -ne 0 ]; then exit 1; fi\n  if [ \"$rc\" -eq 0 ]; then exit 0; fi\ndone\nexit 1\nSH\nbash /tmp/search-412-backfill.sh > /tmp/search-412-backfill.log 2>&1 &\necho \"backfill pid=$!\"\ntail -60 /tmp/search-412-tests.log\n"]
