[86.20812, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durability import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, bu"]
[86.208467, "o", "ffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._next_shard = 0\r\n        self._rows_in_shard = 0\r\n        self._buffer.clear()\r\n        sync_directory(self.index_dir)\r\n\r\n    def recover(self, position):\r\n        \"\"\"Discard everything beyond the checkpoint, includ"]
[86.208488, "o", "ing partial lines.\r\n\r\n        Recovery is itself restartable. A missing/short committed shard is an\r\n        error, never an excuse to silently skip acknowledged documents.\r\n        \"\"\"\r\n        if self._fh is not None or self._buffer:\r\n            raise RuntimeError(\"recover must precede writes\")\r\n        if position is None:\r\n            self.reset()\r\n            return\r\n        number, offset, rows = (position[k] for k in (\"shard\", \"offset\", \"rows\"))\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % number)\r\n        if offset <= 0 or rows <= 0 or not path.exists() or path.stat().st_size < offset:\r\n            raise ValueError(\"committed shard boundary is missing or truncated\")\r\n        for tail in shard_paths(self.index_dir):\r\n            if int(tail.stem.split(\"-\", 1)[1]) > number:\r\n                tail.unlink()\r\n        with open(path, \"r+b\") as fh:\r\n            fh.truncate(offset)\r\n            fh.flush()\r\n            os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        self._fh = "]
[86.208504, "o", "open(path, \"a\", encoding=\"utf-8\")\r\n        self._rows_in_shard = rows\r\n        self._next_shard = number + 1\r\n\r\n    def position(self):\r\n        \"\"\"Return the durable boundary to publish in the next checkpoint.\"\"\"\r\n        if self._buffer:\r\n            raise RuntimeError(\"flush rows before checkpointing\")\r\n        if self._fh is None:\r\n            return None\r\n        return {\"shard\": self._next_shard - 1, \"offset\": self._fh.tell(),\r\n                \"rows\": self._rows_in_shard}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def flush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1"]
[86.20852, "o", "\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        # Persist new shard names as well as their contents before allowing\r\n        # a checkpoint to refer to them.\r\n        sync_directory(self.index_dir)\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"a\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            # Rotation can occur inside flush(); every closed shard must be\r\n            # durable, not only the final shard in that flush.\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(self):\r\n        self.flush()\r\n        self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Release resources without publishing or flushing buffered work.\"\"\"\r\n        se"]
[86.208538, "o", "lf._buffer.clear()\r\n        self._close_shard()\r\n"]
[86.209526, "o", "\"\"\"Reindex worker: data/docs.db -> var/index/shard-*.jsonl.\r\n\r\nNormally started by `./jobs reindex` (ops/supervise.py runs it inside the job budget).\r\nProgress is kept in var/checkpoint.json so the next run continues where the last\r\none stopped; a run with no checkpoint rebuilds the index from scratch.\r\n\r\n    python3 -m reindex.worker            run / resume\r\n"]
[86.209727, "o", "    python3 -m reindex.worker --status   print progress\r\n\"\"\"\r\nimport argparse\r\nimport logging\r\nimport signal\r\nimport sys\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import ShardWriter, iter_rows\r\nfrom reindex.transform import transform_doc\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nBATCH_SIZE = 25\r\n\r\nlog = logging.getLogger(\"reindex.worker\")\r\n\r\n\r\ndef parse_args(argv):\r\n    parser = argparse.ArgumentParser(prog=\"reindex.worker\")\r\n    parser.add_argument(\"--source\", default=str(ROOT / \"data\" / \"docs.db\"))\r\n    parser.add_argument(\"--index-dir\", default=str(ROOT / \"var\" / \"index\"))\r\n    parser.add_argument(\"--checkpoint\", default=str(ROOT / \"var\" / \"checkpoint.json\"))\r\n    parser.add_argument(\"--batch-size\", type=int, default=BATCH_SIZE)\r\n    parser.add_argument(\"--status\", action=\"store_true\", help=\"print progress and exit\")\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef show_status(args):\r\n    state = Checkpoint"]
[86.209844, "o", "(args.checkpoint).load()\r\n    source = Source(args.source)\r\n    total = source.count()\r\n    source.close()\r\n    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []\r\n    unique = len({row[\"id\"] for row in rows})\r\n    print(\"checkpoint : %s\" % state)\r\n    print(\"source     : %d live docs\" % total)\r\n    print(\"index      : %d rows, %d unique ids (%.1f%% of source)\"\r\n          % (len(rows), unique, 100.0 * unique / max(total, 1)))\r\n    return 0\r\n\r\n\r\ndef run(args):\r\n    if args.batch_size <= 0:\r\n        raise ValueError(\"batch size must be positive\")\r\n    stopping = False\r\n\r\n    def request_stop(signum, frame):\r\n        # Never raise inside a filesystem commit. Finish the current document,\r\n        # flush the partial batch, and publish its boundary before exiting.\r\n        nonlocal stopping\r\n        stopping = True\r\n\r\n    handlers = {sig: signal.signal(sig, request_stop)\r\n                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}\r\n    source = store = None\r\n    try:\r\n  "]
[86.210018, "o", "      ckpt = Checkpoint(args.checkpoint)\r\n        state = ckpt.load()\r\n        store = ShardWriter(args.index_dir)\r\n        store.recover(state[\"position\"])\r\n        if state[\"complete\"]:\r\n            log.info(\"index already complete (%d docs)\", state[\"docs\"])\r\n            return 0\r\n        source = Source(args.source)\r\n        total = source.count()\r\n        started = time.monotonic()\r\n        initial_docs = state[\"docs\"]\r\n        log.info(\"starting after id %d (%d/%d docs done)\",\r\n                 state[\"last_id\"], state[\"docs\"], total)\r\n\r\n        # Source.batches uses an inclusive lower bound; last_id is already done.\r\n        for n, batch in enumerate(source.batches(start_id=state[\"last_id\"] + 1,\r\n                                                 size=args.batch_size), 1):\r\n            count = 0\r\n            last_id = state[\"last_id\"]\r\n            for doc in batch:\r\n                if stopping:\r\n                    break\r\n                store.add(transform_doc(doc))\r\n                last_id = doc.id\r\n    "]
[86.210027, "o", "            count += 1\r\n            if count:\r\n                store.flush()\r\n                committed = dict(state, last_id=last_id, docs=state[\"docs\"] + count,\r\n                                 position=store.position())\r\n                ckpt.save(committed)\r\n                state = committed\r\n            if stopping:\r\n                log.info(\"stopped at id %d (%d/%d docs committed)\",\r\n                         state[\"last_id\"], state[\"docs\"], total)\r\n                return 75\r\n            if n % 20 == 0:\r\n                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)\r\n                log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n                         state[\"last_id\"], state[\"docs\"], total, rate)\r\n\r\n        ckpt.save(dict(state, complete=True))\r\n        log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n        return 0\r\n    finally:\r\n        try:\r\n            if store is not None:\r\n                store.abort()\r\n            if source is not None:\r\n                s"]
[86.210031, "o", "ource.close()\r\n        finally:\r\n            for sig, handler in handlers.items():\r\n                signal.signal(sig, handler)\r\n\r\n\r\ndef main(argv=None):\r\n    logging.basicConfig(level=logging.INFO, stream=sys.stderr,\r\n                        format=\"%(asctime)s %(name)s %(levelname)s %(message)s\")\r\n    args = parse_args(sys.argv[1:] if argv is None else argv)\r\n    if args.status:\r\n        return show_status(args)\r\n    return run(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
