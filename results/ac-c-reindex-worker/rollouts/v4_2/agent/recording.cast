[125.51708, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.517211, "o", "                writer.add({\"id\": i})\r\n"]
[125.517275, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.517408, "o", "            committed = writer.commit()\r\n"]
[125.517507, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.517638, "o", "            for i in range(3, 10):\r\n"]
[125.517737, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.517858, "o", "                writer.add({\"id\": i})\r\n"]
[125.517923, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.518145, "o", "            writer.close()  # durable output, but NOT a published checkpoint\r\n"]
[125.518214, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.518375, "o", "            with open(shard_paths(tmp)[0], \"ab\") as fh:\r\n"]
[125.518456, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.51861, "o", "                fh.write(b'{\"id\": \"\\xc3')\r\n"]
[125.518677, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.51888, "o", "            resumed = ShardWriter(tmp, shard_rows=4, buffer_rows=2)\r\n"]
[125.518948, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.519081, "o", "            resumed.recover(committed)\r\n"]
[125.519244, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.519405, "o", "            self.assertEqual(list(iter_rows(tmp)), [{\"id\": i} for i in range(3)])\r\n"]
[125.519477, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.519651, "o", "            for i in range(3, 10):\r\n"]
[125.519722, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.519834, "o", "                resumed.add({\"id\": i})\r\n"]
[125.519896, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.520008, "o", "            resumed.close()\r\n"]
[125.520067, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.520288, "o", "            self.assertEqual(list(iter_rows(tmp)), [{\"id\": i} for i in range(10)])\r\n"]
