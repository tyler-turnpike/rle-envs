[79.340545, "o", "\u001b[?2004l\r"]
[79.340691, "o", "\u001b[?2004h>                 log.info(\"stopped safely at id %d (%d/%d docs)\","]
[79.340758, "o", "\r\n"]
[79.340836, "o", "\u001b[?2004l\r"]
[79.340891, "o", "\u001b[?2004h"]
