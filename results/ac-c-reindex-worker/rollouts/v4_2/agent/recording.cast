[79.342362, "o", "> "]
[79.34237, "o", "                rate = (state[\"docs\"] - initial_docs) / (time.monotonic() - started)"]
[79.342482, "o", "\r\n"]
[79.343238, "o", "\u001b[?2004l\r\u001b[?2004h>                 log.info(\"progress: last_id=%d docs=%d/%d (%.0f docs/s)\",\r\n\u001b[?2004l\r\u001b[?2004h>                          state[\"last_id\"], state[\"docs\"], total, rate)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if stopping:\r\n\u001b[?2004l\r\u001b[?2004h>             return 75\r\n\u001b[?2004l\r\u001b[?2004h>         state[\"shards\"] = store.commit()\r\n\u001b[?2004l\r\u001b[?2004h>         state[\"complete\"] = True\r\n\u001b[?2004l\r\u001b[?2004h>         ckpt.save(state)\r\n\u001b[?2004l\r\u001b[?2004h>         log.info(\"reindex complete: %d docs\", state[\"docs\"])\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.343388, "o", "            if store is not None:"]
