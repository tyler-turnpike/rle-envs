[125.548271, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     def test_invalid_batch_size(self):"]
[125.548289, "o", "\r\n"]
[125.548413, "o", "\u001b[?2004l\r"]
[125.548477, "o", "\u001b[?2004h>         with self.assertRaises(SystemExit):\r\n\u001b[?2004l\r"]
[125.548513, "o", "\u001b[?2004h"]
[125.548577, "o", "> "]
[125.548627, "o", "            worker.parse_args([\"--batch-size\", \"0\"])"]
[125.548674, "o", "\r\n\u001b[?2004l\r"]
[125.548939, "o", "\u001b[?2004h> "]
[125.549019, "o", "PY\r\n\u001b[?2004l\r"]
[125.552886, "o", "[1]+  Exit 75                 ./jobs reindex > /tmp/search-412-first-run.log 2>&1\r\n\u001b[?2004h"]
[125.552976, "o", "root@c5e45fe218ea:/app# "]
[125.553026, "o", "cat >> README.md <<'MD'"]
[125.553093, "o", "\r\n\u001b[?2004l\r"]
[125.553168, "o", "\u001b[?2004h> "]
[125.55323, "o", "\r\n"]
[125.55324, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.553251, "o", "> "]
[125.553337, "o", "## Resume / durability protocol"]
[125.553399, "o", "\r\n\u001b[?2004l\r"]
[125.553417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.553566, "o", "> The checkpoint's `last_id` is the **last committed** source ID; the next query"]
[125.553645, "o", "\r\n\u001b[?2004l\r"]
[125.553769, "o", "\u001b[?2004h"]
[125.553807, "o", "> starts strictly after it (IDs need not be contiguous). Each batch, or partial"]
[125.553833, "o", "\r\n"]
[125.553846, "o", "\u001b[?2004l\r"]
[125.553892, "o", "\u001b[?2004h"]
[125.554, "o", "> "]
[125.554118, "o", "batch on SIGTERM/SIGINT/SIGHUP, is committed in this order:\r\n"]
[125.554219, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[125.554461, "o", "\u001b[?2004l\r\u001b[?2004h> 1. Flush and fsync all affected shards, including shards closed by rotation."]
[125.554547, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.554693, "o", "> "]
[125.554798, "o", "2. Fsync the index directory and record committed shard names and byte sizes."]
[125.554877, "o", "\r\n\u001b[?2004l\r"]
[125.554986, "o", "\u001b[?2004h> "]
[125.555027, "o", "3. Write and fsync a temporary checkpoint, atomically replace the old checkpoint,"]
[125.555042, "o", "\r\n\u001b[?2004l\r"]
[125.555158, "o", "\u001b[?2004h> "]
[125.555224, "o", "   then fsync its directory."]
[125.555318, "o", "\r\n\u001b[?2004l\r"]
[125.55548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.555537, "o", "\u001b[?2004h> On restart, validate the committed files, truncate any bytes past those sizes,"]
[125.55555, "o", "\r\n"]
[125.555559, "o", "\u001b[?2004l\r"]
[125.555761, "o", "\u001b[?2004h> and remove shards absent from the checkpoint before continuing. Thus a SIGKILL"]
[125.55583, "o", "\r\n"]
[125.555877, "o", "\u001b[?2004l\r"]
[125.555962, "o", "\u001b[?2004h> "]
[125.556019, "o", "between writing rows and publishing progress only replays uncommitted work;\r\n"]
[125.556099, "o", "\u001b[?2004l\r"]
[125.556119, "o", "\u001b[?2004h"]
[125.556229, "o", "> "]
[125.556308, "o", "partial JSON/UTF-8 tails are discarded without parsing them. Missing/shortened"]
[125.556453, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.556493, "o", "> committed files or malformed checkpoints fail loudly instead of skipping work."]
[125.556507, "o", "\r\n"]
[125.556519, "o", "\u001b[?2004l\r"]
[125.556574, "o", "\u001b[?2004h> "]
[125.556696, "o", "A completed rerun performs recovery but does not reindex documents."]
[125.556751, "o", "\r\n\u001b[?2004l\r"]
[125.556824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.556916, "o", "\u001b[?2004h> "]
[125.556988, "o", "Old checkpoints (without shard byte sizes) cannot be trusted: the old worker could\r\n\u001b[?2004l\r"]
[125.557116, "o", "\u001b[?2004h> "]
[125.557239, "o", "publish unwritten rows. These are rebuilt once. As before, a missing checkpoint\r\n"]
[125.557354, "o", "\u001b[?2004l\r\u001b[?2004h> means a rebuild. The source corpus must remain fixed during a reindex; use"]
[125.55742, "o", "\r\n"]
[125.557431, "o", "\u001b[?2004l\r"]
[125.557526, "o", "\u001b[?2004h"]
[125.557636, "o", "> "]
[125.557718, "o", "`./jobs clean` to start a new generation after source changes. Run writers through\r\n\u001b[?2004l\r"]
[125.557831, "o", "\u001b[?2004h> "]
[125.557903, "o", "`./jobs reindex` so the supervisor serializes access. Index row transformation is\r\n\u001b[?2004l\r"]
[125.558029, "o", "\u001b[?2004h> "]
[125.55827, "o", "unchanged.\r\n\u001b[?2004l\r\u001b[?2004h> MD\r\n\u001b[?2004l\r"]
[125.560747, "o", "\u001b[?2004h"]
[125.560865, "o", "root@c5e45fe218ea:/app# "]
[125.561002, "o", "./jobs test > /tmp/search-412-tests.log 2>&1; cat /tmp/search-412-tests.log"]
[125.561046, "o", "\r\n"]
[125.561064, "o", "\u001b[?2004l\r"]
[126.471185, "i", "cat /tmp/search-412-first-run.log; ./jobs status; ./jobs history\n"]
[126.471344, "o", "cat /tmp/search-412-first-run.log; ./jobs status; ./jobs history\r\n"]
[133.957232, "i", "cat /tmp/search-412-first-run.log; ./jobs status; ./jobs history; python3 - <<'PY'\nfrom reindex.checkpoint import Checkpoint\nfrom reindex.source import Source\nfrom reindex.store import iter_rows\nstate = Checkpoint('var/checkpoint.json').load()\nrows = list(iter_rows('var/index'))\nsource = Source('data/docs.db')\nids = [d.id for batch in source.batches(size=1000) for d in batch]\nsource.close()\nassert [r['id'] for r in rows] == ids[:state['docs']]\nassert len(rows) == state['docs']\nassert rows[-1]['id'] == state['last_id']\nprint('Verified committed real-index prefix:', len(rows), 'rows; last_id', state['last_id'])\nPY\n./jobs reindex > /tmp/search-412-second-run.log 2>&1 & echo \"second supervisor pid=$!\"\n"]
[133.958712, "o", "cat /tmp/search-412-first-run.log; ./jobs status; ./jobs history; python3 - <<'PY'\r\nfrom reindex.checkpoint import Checkpoint\r\nfrom reindex.source import Source\r\nfrom reindex.store import iter_rows\r\nstate = Checkpoint('var/checkpoint.json').load()\r\nrows = list(iter_rows('var/index'))\r\nsource = Source('data/docs.db')\r\nids = [d.id for batch in source.batches(size=1000) for d in batch]\r\nsource.close()\r\nassert [r['id'] for r in rows] == ids[:state['docs']]\r\nassert len(rows) == state['docs']\r\nassert rows[-1]['id'] == state['last_id']\r\nprint('Verified committed real-index prefix:', len(rows), 'rows; last_id', state['last_id'])\r\nPY\r\n./jobs reindex > /tmp/search-412-second-run.log 2>&1 & echo \"second supervisor pid=$!\"\r\n"]
