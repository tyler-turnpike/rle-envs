[125.52064, "o", "    def test_missing_committed_bytes_fail_without_deleting_other_files(self):\r\n"]
[125.520706, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.520867, "o", "        with tempfile.TemporaryDirectory() as tmp:\r\n"]
[125.520939, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.521054, "o", "            writer = ShardWriter(tmp)\r\n"]
[125.521117, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.521238, "o", "            writer.add({\"id\": 1})\r\n"]
[125.521301, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.521435, "o", "            committed = writer.commit()\r\n"]
[125.521498, "o", "\u001b[?2004l\r\u001b[?2004h> "]
