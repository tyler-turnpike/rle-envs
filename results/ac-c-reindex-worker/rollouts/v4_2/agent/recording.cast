[125.523304, "o", "    def test_rotation_syncs_all_shards(self):\r\n"]
[125.52333, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.523371, "o", "> "]
[125.523491, "o", "        with tempfile.TemporaryDirectory() as tmp:\r\n"]
[125.523567, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.523605, "o", "> "]
[125.523775, "o", "            writer = ShardWriter(tmp, shard_rows=2, buffer_rows=20)\r\n"]
[125.523862, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.523965, "o", "            for i in range(5):\r\n"]
[125.524032, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.524151, "o", "                writer.add({\"id\": i})\r\n"]
[125.524235, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.524345, "o", "            real_sync = os.fsync\r\n"]
[125.524419, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.524516, "o", "            synced = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.524608, "o", "> \r\n"]
[125.524621, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.524719, "o", "            def sync(fd):"]
[125.524789, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.524968, "o", "                synced.append(os.readlink('/proc/self/fd/%d' % fd))\r\n"]
[125.525054, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.525158, "o", "                real_sync(fd)\r\n"]
[125.525223, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.525305, "o", "> "]
[125.525496, "o", "            with mock.patch(\"reindex.store.os.fsync\", side_effect=sync):\r\n"]
[125.525561, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.52572, "o", "                writer.commit()\r\n"]
[125.525783, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.526002, "o", "            self.assertTrue({str(p) for p in shard_paths(tmp)} <= set(synced))\r\n"]
[125.526067, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.526182, "o", "            writer.close()\r\n"]
