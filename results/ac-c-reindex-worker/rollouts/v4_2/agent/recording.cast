[79.31256, "o", "       raise ValueError(\"committed shard missing or shortened: %s\" % path)\\n        for path in shard_paths(self.index_dir):\\n            if path.name not in sizes:\\n                path.unlink()\\n            elif path.stat().st_size > sizes[path.name]:\\n                with open(path, \"r+b\") as fh:\\n                    fh.truncate(sizes[path.name])\\n                    fh.flush()\\n                    os.fsync(fh.fileno())\\n        sync_directory(self.index_dir)\\n        self._next_shard = self._first_free_shard()\\n\\n    def commit(self):\\n        \"\"\"Make rows and directory entries durable; return checkpoint boundaries.\\n\\n        Only publishing these boundaries in Checkpoint.save commits the batch.\\n        Until then, recovery discards everything after the previous boundaries.\\n        \"\"\"\\n        self.flush()\\n        sync_directory(self.index_dir)\\n        return {path.name: path.stat().st_size for path in shard_paths(self.index_dir)}\\n\\n    def add')\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.312573, "o", "> "]
[79.312818, "o", "s = s.replace('self._fh = open(path, \"a\", encoding=\"utf-8\")', 'self._fh = open(path, \"x\", encoding=\"utf-8\")')"]
[79.312928, "o", "\r\n"]
[79.312993, "o", "\u001b[?2004l\r\u001b[?2004h"]
[79.313379, "o", "> s = s.replace('        if self._fh is not None:\\n            self._fh.close()\\n            self._fh = None', '        if self._fh is not None:\\n            # Rotation must sync earlier shards too, not just the last shard.\\n            self._fh.flush()\\n            os.fsync(self._fh.fileno())\\n            self._fh.close()\\n            self._fh = None')"]
[79.31345, "o", "\r\n"]
[79.313508, "o", "\u001b[?2004l\r"]
[79.313586, "o", "\u001b[?2004h"]
[79.313653, "o", "> "]
[79.313892, "o", "s += '\\n    def abort(self):\\n        \"\"\"Close without publishing buffered rows; restart rolls back any tail.\"\"\"\\n        self._buffer.clear()\\n        self._close_shard()\\n'"]
[79.313965, "o", "\r\n"]
[79.314044, "o", "\u001b[?2004l\r\u001b[?2004h"]
