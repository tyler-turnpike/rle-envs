[182.277104, "i", "       yield json.loads(line)\n''' + s[b:]\nopen(p, 'w').write(s)\np = 'reindex/worker.py'\ns = open(p).read().replace('    rows = list(iter_rows(args.index_dir)) if Path(args.index_dir).exists() else []', '    rows = list(iter_rows(args.index_dir, state.get(\"shards\")))')\nopen(p, 'w').write(s)\np = 'reindex/checkpoint.py'\ns = open(p).read().replace('                                         dir=self.path.parent)', '                                        dir=self.path.parent)')\ns = s.replace('        sync_directory(self.path.parent)\\n', '        sync_directory(self.path.parent)\\n', 1)\ns = s.replace('        self.path.unlink(missing_ok=True)\\n        sync_directory(self.path.parent)', '        self.path.unlink(missing_ok=True)\\n        if self.path.parent.exists():\\n            sync_directory(self.path.parent)')\nopen(p, 'w').write(s)\np = 'tests/test_durability.py'\ns = open(p).read().replace('import json\\n', 'import contextlib\\nimport io\\n')\ns += '''\n    def test_status_ignores_uncommitted_partial_tail(self):\n       "]
