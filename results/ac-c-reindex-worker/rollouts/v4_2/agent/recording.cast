[293.314498, "o", "\u001b[?2004h"]
[293.314502, "o", "> "]
[293.314545, "o", "from reindex.source import Source\r\n\u001b[?2004l\r"]
[293.31457, "o", "\u001b[?2004h"]
[293.314574, "o", "> "]
[293.314628, "o", "from reindex.store import iter_rows, shard_paths\r\n\u001b[?2004l\r"]
[293.314656, "o", "\u001b[?2004h"]
[293.31466, "o", "> "]
[293.314709, "o", "from reindex.transform import transform_doc\r\n\u001b[?2004l\r"]
[293.314751, "o", "\u001b[?2004h"]
[293.314759, "o", "> \r\n\u001b[?2004l\r"]
[293.314773, "o", "\u001b[?2004h"]
[293.314777, "o", "> "]
[293.314808, "o", "root = Path('/app')\r\n\u001b[?2004l\r"]
[293.314865, "o", "\u001b[?2004h> "]
[293.314926, "o", "conn = sqlite3.connect('file:/app/data/docs.db?mode=ro', uri=True)\r\n\u001b[?2004l\r"]
[293.314959, "o", "\u001b[?2004h> "]
[293.315031, "o", "assert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\r\n\u001b[?2004l\r"]
[293.315062, "o", "\u001b[?2004h> "]
[293.315297, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.318424, "o", "> "]
[293.319693, "o", "state = Checkpoint(root / 'var/checkpoint.json').load()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.319793, "o", "assert state['complete'] is True"]
[293.319804, "o", "\r\n"]
[293.319813, "o", "\u001b[?2004l\r"]
[293.319861, "o", "\u001b[?2004h"]
[293.319875, "o", "> "]
[293.319984, "o", "paths = shard_paths(root / 'var/index')"]
[293.319997, "o", "\r\n"]
[293.320246, "o", "\u001b[?2004l\r"]
[293.320285, "o", "\u001b[?2004h"]
[293.320321, "o", "> "]
[293.320423, "o", "assert {p.name: p.stat().st_size for p in paths} == state['shards']"]
[293.320452, "o", "\r\n"]
[293.320464, "o", "\u001b[?2004l\r"]
[293.32059, "o", "\u001b[?2004h"]
[293.32061, "o", "> "]
[293.320688, "o", "rows = list(iter_rows(root / 'var/index'))"]
[293.320753, "o", "\r\n\u001b[?2004l\r"]
[293.320786, "o", "\u001b[?2004h"]
[293.320852, "o", "> "]
[293.32091, "o", "ids = [row['id'] for row in rows]\r\n\u001b[?2004l\r"]
[293.320925, "o", "\u001b[?2004h> "]
[293.321005, "o", "assert len(ids) == len(set(ids)) == state['docs']\r\n\u001b[?2004l\r"]
[293.321052, "o", "\u001b[?2004h> "]
[293.32115, "o", "source = Source(root / 'data/docs.db')\r\n\u001b[?2004l\r"]
[293.321199, "o", "\u001b[?2004h"]
[293.321206, "o", "> "]
[293.321253, "o", "assert len(rows) == source.count()"]
[293.321305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.321324, "o", "pos = 0\r\n\u001b[?2004l\r"]
[293.321375, "o", "\u001b[?2004h"]
[293.321381, "o", "> "]
[293.321449, "o", "for batch in source.batches(size=100):\r\n\u001b[?2004l\r"]
[293.321511, "o", "\u001b[?2004h> "]
[293.321542, "o", "    for doc in batch:\r\n\u001b[?2004l\r"]
[293.321572, "o", "\u001b[?2004h"]
[293.321576, "o", "> "]
[293.321905, "o", "        assert rows[pos] == transform_doc(doc), 'row mismatch at source id %s' % doc.id\r\n\u001b[?2004l\r\u001b[?2004h>         pos += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.322208, "o", "    print('verified %d/%d complete rows' % (pos, len(rows)), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.322226, "o", "source.close()\r\n\u001b[?2004l\r"]
[293.322269, "o", "\u001b[?2004h> "]
[293.322282, "o", "assert pos == len(rows)\r\n\u001b[?2004l\r"]
[293.322316, "o", "\u001b[?2004h> "]
[293.322447, "o", "assert state['last_id'] == (ids[-1] if ids else 0)\r\n\u001b[?2004l\r\u001b[?2004h> report = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.322504, "o", "    'complete': True,\r\n\u001b[?2004l\r"]
[293.322517, "o", "\u001b[?2004h> "]
[293.322574, "o", "    'source_live_docs': pos,\r\n\u001b[?2004l\r"]
[293.32258, "o", "\u001b[?2004h> "]
[293.322653, "o", "    'index_rows': len(rows),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.322709, "o", "    'unique_ids': len(set(ids)),\r\n\u001b[?2004l\r"]
[293.322723, "o", "\u001b[?2004h> "]
[293.32278, "o", "    'last_id': state['last_id'],\r\n\u001b[?2004l\r"]
[293.322799, "o", "\u001b[?2004h> "]
[293.322934, "o", "    'all_rows_match_transform_including_checksum_and_minhash': True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.323035, "o", "    'shard_sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in paths},\r\n\u001b[?2004l\r"]
[293.323117, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[293.323167, "o", "\u001b[?2004h> "]
[293.323263, "o", "(root / 'var/reindex-verification.json').write_text(json.dumps(report, indent=2) + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.323326, "o", "print(json.dumps(report, indent=2), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[293.324639, "o", "\u001b[?2004h"]
[293.324691, "o", "root@c5e45fe218ea:/app# "]
