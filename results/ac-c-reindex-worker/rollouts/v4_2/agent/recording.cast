[125.526358, "o", "> "]
[125.526484, "o", "class WorkerDurabilityTest(unittest.TestCase):"]
[125.526553, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.52668, "o", "    def setUp(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.526725, "o", "> "]
[125.526875, "o", "        self.temporary = tempfile.TemporaryDirectory()\r\n"]
[125.526942, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.527103, "o", "        self.addCleanup(self.temporary.cleanup)\r\n"]
[125.527138, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.527179, "o", "> "]
[125.527296, "o", "        self.tmp = Path(self.temporary.name)\r\n"]
[125.527359, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.527541, "o", "        generate_corpus(self.tmp / \"docs.db\", count=19, seed=5)\r\n"]
[125.527648, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.527776, "o", "        source = Source(self.tmp / \"docs.db\")\r\n"]
[125.527838, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.528055, "o", "        self.docs = [doc for batch in source.batches(size=5) for doc in batch]\r\n"]
[125.528117, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.528225, "o", "        source.close()\r\n"]
[125.528288, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.528479, "o", "        self.expected = [transform_doc(doc) for doc in self.docs]\r\n"]
[125.52854, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.528698, "o", "        self.args = worker.parse_args([\r\n"]
[125.52876, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.528924, "o", "            \"--source\", str(self.tmp / \"docs.db\"),\r\n"]
[125.528985, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.529151, "o", "            \"--index-dir\", str(self.tmp / \"index\"),\r\n"]
[125.529223, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.529388, "o", "            \"--checkpoint\", str(self.tmp / \"checkpoint.json\"),\r\n"]
[125.529478, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.529586, "o", "            \"--batch-size\", \"3\"])\r\n"]
[125.529669, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.529793, "o", "    def assert_prefix(self):\r\n"]
[125.529863, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.530029, "o", "        state = Checkpoint(self.args.checkpoint).load()\r\n"]
[125.530091, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.530248, "o", "        rows = list(iter_rows(self.args.index_dir))\r\n"]
[125.530308, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.530529, "o", "        self.assertEqual(rows[:state[\"docs\"]], self.expected[:state[\"docs\"]])\r\n"]
[125.530605, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.530803, "o", "        self.assertEqual(state[\"last_id\"], rows[state[\"docs\"] - 1][\"id\"])\r\n"]
[125.530868, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.530965, "o", "        return state\r\n"]
[125.53103, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.531187, "o", "> "]
[125.531292, "o", "    def assert_complete(self):\r\n"]
[125.531355, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.531518, "o", "        rows = list(iter_rows(self.args.index_dir))\r\n"]
[125.531581, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.531731, "o", "        self.assertEqual(rows, self.expected)"]
[125.531779, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.531848, "o", "> "]
[125.532032, "o", "        self.assertEqual(len(rows), len({row[\"id\"] for row in rows}))\r\n"]
[125.532097, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.532261, "o", "        state = Checkpoint(self.args.checkpoint).load()\r\n"]
[125.532324, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.532469, "o", "        self.assertTrue(state[\"complete\"])\r\n"]
[125.532533, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.532718, "o", "        self.assertEqual(state[\"docs\"], len(self.expected))\r\n"]
[125.532785, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.532874, "o", "> "]
[125.533041, "o", "    def test_repeated_partial_batch_stops_then_resume(self):\r\n"]
[125.53314, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.533266, "o", "        original = worker.transform_doc\r\n"]
[125.533365, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.533454, "o", "        previous = 0\r\n"]
[125.533522, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.533645, "o", "        for _ in range(3):\r\n"]
[125.533708, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.533818, "o", "            calls = 0\r\n"]
[125.533883, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.533965, "o", "> "]
[125.534077, "o", "            def transform(doc):\r\n"]
[125.534176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.534284, "o", "                nonlocal calls\r\n"]
[125.534355, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.534448, "o", "                calls += 1\r\n"]
[125.534537, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.53465, "o", "                if calls == 2:\r\n"]
[125.534715, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.534888, "o", "                    os.kill(os.getpid(), signal.SIGTERM)\r\n"]
[125.53497, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.535103, "o", "                return original(doc)\r\n"]
[125.535161, "o", "\u001b[?2004l\r"]
[125.535213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.535263, "o", "> "]
[125.535422, "o", "            with mock.patch.object(worker, \"transform_doc\", side_effect=transform):\r\n"]
[125.535488, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.53567, "o", "                self.assertEqual(worker.run(self.args), 75)\r\n"]
[125.535758, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.535872, "o", "            state = self.assert_prefix()\r\n"]
[125.535938, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.536089, "o", "            self.assertEqual(state[\"docs\"], previous + 2)\r\n"]
[125.536172, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.536385, "o", "            self.assertEqual(len(list(iter_rows(self.args.index_dir))), state[\"docs\"])\r\n"]
[125.53645, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.536564, "o", "            previous = state[\"docs\"]\r\n"]
[125.536662, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.536811, "o", "        self.assertEqual(worker.run(self.args), 0)\r\n"]
[125.536892, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.536974, "o", "> "]
[125.537042, "o", "        self.assert_complete()\r\n\u001b[?2004l\r"]
[125.537093, "o", "\u001b[?2004h"]
[125.537167, "o", "> "]
[125.537342, "o", "        # A completed rerun changes neither index bytes nor checkpoint bytes.\r\n"]
[125.53741, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.537649, "o", "        before = {p.name: p.read_bytes() for p in Path(self.args.index_dir).iterdir()}\r\n"]
[125.537682, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.537711, "o", "> "]
[125.53788, "o", "        checkpoint_before = Path(self.args.checkpoint).read_bytes()\r\n"]
[125.537945, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.538103, "o", "        self.assertEqual(worker.run(self.args), 0)\r\n"]
[125.538179, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.53827, "o", "> "]
[125.538483, "o", "        self.assertEqual(before, {p.name: p.read_bytes() for p in Path(self.args.index_dir).iterdir()})\r\n"]
[125.538551, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.538819, "o", "        self.assertEqual(checkpoint_before, Path(self.args.checkpoint).read_bytes())\r\n"]
[125.5389, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[125.538965, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.539162, "o", "    def test_hard_exit_on_both_sides_of_checkpoint_publish(self):\r\n"]
[125.539251, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.539384, "o", "        for publish in (False, True):\r\n"]
[125.53946, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.53961, "o", "            with self.subTest(publish=publish):\r\n"]
[125.539674, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.539834, "o", "                # Start each case from an independent empty generation.\r\n"]
[125.539943, "o", "\u001b[?2004l\r\u001b[?2004h>                 Path(self.args.checkpoint).unlink(missing_ok=True)"]
[125.540008, "o", "\r\n"]
[125.540019, "o", "\u001b[?2004l\r"]
[125.540136, "o", "\u001b[?2004h"]
[125.540199, "o", ">                 ShardWriter(self.args.index_dir).reset()\r\n\u001b[?2004l\r"]
[125.540287, "o", "\u001b[?2004h"]
[125.540378, "o", ">                 script = '''"]
[125.540433, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import os, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.540512, "o", "> from reindex.checkpoint import Checkpoint"]
[125.540555, "o", "\r\n"]
[125.540675, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.540749, "o", "> from reindex.worker import main\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.540819, "o", "> "]
[125.540894, "o", "save = Checkpoint.save\r\n\u001b[?2004l\r\u001b[?2004h> def crashing_save(self, state):"]
[125.540943, "o", "\r\n\u001b[?2004l\r"]
[125.541014, "o", "\u001b[?2004h>     if state['docs'] >= 6:"]
[125.541085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.541162, "o", ">         if sys.argv[1] == 'True':"]
[125.541224, "o", "\r\n\u001b[?2004l\r"]
[125.541314, "o", "\u001b[?2004h"]
[125.541385, "o", ">             save(self, state)"]
[125.541436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.541517, "o", "        os._exit(91)"]
[125.541573, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     save(self, state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.541734, "o", "> Checkpoint.save = crashing_save"]
[125.541797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> main(sys.argv[2:])"]
[125.541871, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.541988, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h>                 result = subprocess.run([sys.executable, \"-c\", script, str(publish),"]
[125.542043, "o", "\r\n"]
[125.54207, "o", "\u001b[?2004l\r"]
[125.542148, "o", "\u001b[?2004h"]
[125.542196, "o", ">                                          \"--source\", self.args.source,\r\n"]
[125.542255, "o", "\u001b[?2004l\r\u001b[?2004h"]
[125.542374, "o", "> "]
[125.542445, "o", "                                         \"--index-dir\", self.args.index_dir,\r\n\u001b[?2004l\r"]
[125.542613, "o", "\u001b[?2004h>                                          \"--checkpoint\", self.args.checkpoint,"]
[125.542675, "o", "\r\n"]
[125.542709, "o", "\u001b[?2004l\r"]
[125.542742, "o", "\u001b[?2004h> "]
[125.542882, "o", "                                         \"--batch-size\", \"3\"], cwd=ROOT,\r\n"]
[125.543028, "o", "\u001b[?2004l\r\u001b[?2004h>                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,"]
[125.543099, "o", "\r\n"]
[125.543119, "o", "\u001b[?2004l\r"]
[125.54313, "o", "\u001b[?2004h"]
[125.54323, "o", ">                                         timeout=15)"]
[125.543274, "o", "\r\n\u001b[?2004l\r"]
[125.5434, "o", "\u001b[?2004h> "]
