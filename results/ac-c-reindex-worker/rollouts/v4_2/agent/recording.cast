[89.368452, "i", "cat reindex/store.py; ./jobs reindex > /tmp/search-412-first-run.log 2>&1 & echo \"supervisor shell pid=$!\"; cat /tmp/search-412-first-run.log\n"]
[89.369603, "o", "cat reindex/store.py; ./jobs reindex > /tmp/search-412-first-run.log 2>&1 & echo \"supervisor shell pid=$!\"; cat /tmp/search-412-first-run.log\r\n\u001b[?2004l\r"]
[89.371897, "o", "\"\"\"Index storage: JSON-lines shards under var/index/.\r\n\r\nEach line is one index row (see reindex.transform).  The search service loads every\r\n`shard-*.jsonl` file in the directory; shard boundaries carry no meaning.  Rows are\r\nbuffered and written out in blocks (one write + fsync per block) because the index\r\nvolume is network storage in production and small appends are slow there.\r\n\"\"\"\r\nimport json\r\nimport os\r\nimport re\r\nfrom pathlib import Path\r\n\r\nfrom reindex.durable import sync_directory\r\n\r\nSHARD_ROWS = 1000      # rows per shard file before rotating\r\nBUFFER_ROWS = 200      # rows held in memory before a block write\r\n\r\n\r\ndef shard_paths(index_dir):\r\n    return sorted(Path(index_dir).glob(\"shard-*.jsonl\"))\r\n\r\n\r\ndef iter_rows(index_dir):\r\n    for path in shard_paths(index_dir):\r\n        with open(path, encoding=\"utf-8\") as fh:\r\n            for line in fh:"]
[89.372214, "o", "\r\n                if line.strip():\r\n                    yield json.loads(line)\r\n\r\n\r\nclass ShardWriter:\r\n    def __init__(self, index_dir, shard_rows=SHARD_ROWS, buffer_rows=BUFFER_ROWS):\r\n        self.index_dir = Path(index_dir)\r\n        self.index_dir.mkdir(parents=True, exist_ok=True)\r\n        sync_directory(self.index_dir.parent)\r\n        self.shard_rows = shard_rows\r\n        self.buffer_rows = buffer_rows\r\n        self._buffer = []\r\n        self._fh = None\r\n        self._rows_in_shard = 0\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def _first_free_shard(self):\r\n        numbers = [int(p.stem.split(\"-\", 1)[1]) for p in shard_paths(self.index_dir)]\r\n        return max(numbers) + 1 if numbers else 0\r\n\r\n    @property\r\n    def pending(self):\r\n        return len(self._buffer)\r\n\r\n    def reset(self):\r\n        \"\"\"Drop every shard (used when a reindex starts from scratch).\"\"\"\r\n        self._close_shard()\r\n        for path in shard_paths(self.index_dir):\r\n            path.unlink()\r\n        self._buff"]
[89.373873, "o", "er.clear()\r\n        self._next_shard = 0\r\n        sync_directory(self.index_dir)\r\n\r\n    def recover(self, sizes):\r\n        \"\"\"Roll back to an atomic checkpoint, including partial JSON/UTF-8 tails.\r\n\r\n        Validate all committed files before modifying anything. Missing committed\r\n        bytes are an error, never an excuse to silently skip source documents.\r\n        \"\"\"\r\n        if self._fh is not None or self._buffer:\r\n            raise RuntimeError(\"recover must precede writes\")\r\n        if not isinstance(sizes, dict):\r\n            raise ValueError(\"invalid shard manifest\")\r\n        for name, size in sizes.items():\r\n            if (not re.fullmatch(r\"shard-[0-9]{5,}\\.jsonl\", name)\r\n                    or type(size) is not int or size < 0):\r\n                raise ValueError(\"invalid shard boundary: %r\" % name)\r\n            path = self.index_dir / name\r\n            if not path.is_file() or path.stat().st_size < size:\r\n                raise ValueError(\"committed shard missing or shortened: %s\" % path)\r\n     "]
[89.374025, "o", "   for path in shard_paths(self.index_dir):\r\n            if path.name not in sizes:\r\n                path.unlink()\r\n            elif path.stat().st_size > sizes[path.name]:\r\n                with open(path, \"r+b\") as fh:\r\n                    fh.truncate(sizes[path.name])\r\n                    fh.flush()\r\n                    os.fsync(fh.fileno())\r\n        sync_directory(self.index_dir)\r\n        self._next_shard = self._first_free_shard()\r\n\r\n    def commit(self):\r\n        \"\"\"Make rows and directory entries durable; return checkpoint boundaries.\r\n\r\n        Only publishing these boundaries in Checkpoint.save commits the batch.\r\n        Until then, recovery discards everything after the previous boundaries.\r\n        \"\"\"\r\n        self.flush()\r\n        sync_directory(self.index_dir)\r\n        return {path.name: path.stat().st_size for path in shard_paths(self.index_dir)}\r\n\r\n    def add(self, row):\r\n        self._buffer.append(row)\r\n        if len(self._buffer) >= self.buffer_rows:\r\n            self.flush()\r\n\r\n    def f"]
[89.374048, "o", "lush(self):\r\n        if not self._buffer:\r\n            return\r\n        for row in self._buffer:\r\n            if self._fh is None or self._rows_in_shard >= self.shard_rows:\r\n                self._rotate()\r\n            self._fh.write(json.dumps(row, sort_keys=True, separators=(\",\", \":\"),\r\n                                      ensure_ascii=False) + \"\\n\")\r\n            self._rows_in_shard += 1\r\n        self._fh.flush()\r\n        os.fsync(self._fh.fileno())\r\n        self._buffer.clear()\r\n\r\n    def _rotate(self):\r\n        self._close_shard()\r\n        path = self.index_dir / (\"shard-%05d.jsonl\" % self._next_shard)\r\n        self._fh = open(path, \"x\", encoding=\"utf-8\")\r\n        self._next_shard += 1\r\n        self._rows_in_shard = 0\r\n\r\n    def _close_shard(self):\r\n        if self._fh is not None:\r\n            # Rotation must sync earlier shards too, not just the last shard.\r\n            self._fh.flush()\r\n            os.fsync(self._fh.fileno())\r\n            self._fh.close()\r\n            self._fh = None\r\n\r\n    def close(se"]
[89.374065, "o", "lf):\r\n        self.flush()\r\n        self._close_shard()\r\n\r\n    def abort(self):\r\n        \"\"\"Close without publishing buffered rows; restart rolls back any tail.\"\"\"\r\n        self._buffer.clear()\r\n        self._close_shard()\r\n[1] 245\r\nsupervisor shell pid=245\r\n"]
