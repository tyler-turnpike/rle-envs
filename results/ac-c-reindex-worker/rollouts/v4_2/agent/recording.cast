[125.5219, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.522063, "o", "            extra = Path(tmp) / \"shard-00001.jsonl\"\r\n"]
[125.522129, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.522274, "o", "            extra.write_text('{\"id\": 2}\\n')\r\n"]
[125.522345, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.522555, "o", "            with self.assertRaisesRegex(ValueError, \"missing or shortened\"):\r\n"]
[125.522624, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.522809, "o", "                ShardWriter(tmp).recover(committed)\r\n"]
[125.522907, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.523035, "o", "            self.assertTrue(extra.exists())\r\n"]
