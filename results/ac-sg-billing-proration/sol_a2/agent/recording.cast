[60.238328, "i", "date(2023, 12, 31), date(2024, 2, 29), date(2025, 2, 28), 7, 23),\n            (\"annual\", \"monthly\", date(2024, 2, 29), date(2028, 1, 31), date(2028, 2, 29), 2, 7),\n        ]\n        for old, new, anchor, change, renewal, credit, charge in cases:\n            with self.subTest(old=old):\n                result = prorate_change(Subscription(\"s\", \"c\", old, anchor), new, change, catalog)\n                self.assertEqual((result.credit, result.charge), (credit, charge))\n                self.assertEqual((result.new_anchor, result.next_renewal), (change, renewal))\n                self.assertEqual(result.lines[0].period_end, result.period_end)\n                self.assertEqual(result.lines[1].period_start, change)\n                self.assertEqual(result.lines[1].period_end, renewal)\n                self.assertEqual(sum(line.amount for line in result.lines), result.total)\nPY\npython -m unittest discover -s tests\n"]
