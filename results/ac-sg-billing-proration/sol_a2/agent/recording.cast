[70.026562, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\ncases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\nwith tempfile.TemporaryDirectory() as directory:\n    path = Path(directory) / 'subscriptions.json'\n    for case in cases:\n        path.write_text(json.dumps({'subscriptions': [{'id': 'sub_test', 'customer': 'cus_test', 'plan': case['plan'], 'anchor': case['anchor'], 'balance': 0}]}))\n        result = subprocess.run([sys.executable, '-m', 'billing', 'preview', '--sub', str(path), '--id', 'sub_test', '--to', case['to'], '--at', case['at'], '--json'], check=True, capture_output=True, text=True)\n        invoice = json.loads(result.stdout)\n        expected = case['expected']\n        assert [line['amount'] for line in invoice['lines']] == [-expected['credit'], expected['charge']], case['id']\n        assert invoice['subtotal'] == expected['total'], case['id']\n        assert invoice['amount_due'] == max(0, expected['total']), case['id']\n  "]
[70.026654, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
