[91.945625, "o", "\"\"\"Invoice previews for plan changes.\"\"\"\tfrom __future__ import annotations\t\r\nimport json\tfrom dataclasses import dataclass, field\tfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\tfrom pathlib import Path\tfrom typing import Dict, List\r\n\tfrom .proration import Line, Proration\t\r\nCURRENCY_EXPONENT = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"JPY\": 0}\t\t\r\n"]
[91.945786, "o", "@dataclass\tclass InvoicePreview:\t    sub_id: str\r\n    currency: str\t    issued_on: date\t    lines: List[Line] = field(default_factory=list)\r\n    balance_before: int = 0\t\t    @property\r\n    def subtotal(self) -> int:\t        return sum(line.amount for line in self.lines)\t\r\n    @property\t    def amount_due(self) -> int:\t        \"\"\"What the customer pays now; never negative.\"\"\"\r\n        return max(0, self.subtotal + self.balance_before)\t\t    @property\r\n    def credit_carried(self) -> int:\t        \"\"\"Credit left on the account after this invoice (positive number).\"\"\"\t        return max(0, -(self.subtotal + self.balance_before))\r\n\t\tdef build_preview(proration: Proration, currency: str, balance_before: int = 0) -> InvoicePreview:\r\n    return InvoicePreview(\t        sub_id=proration.sub_id,\t        currency=currency,\r\n        issued_on=proration.change_at,\t        lines=list(proration.lines),\t        balance_before=balance_before,\r\n    )\t\t\r\ndef format_amount(minor: int, currency: str) -> str:\t    exp = CURRENCY_EXPO"]
[91.945871, "o", "NENT.get(currency, 2)\t    sign = \"-\" if minor < 0 else \"\"\r\n    minor = abs(minor)\t    if exp == 0:\t        return f\"{sign}{minor} {currency}\"\r\n    major, frac = divmod(minor, 10 ** exp)\t    return f\"{sign}{major:,}.{frac:0{exp}d} {currency}\"\t\r\n\tdef to_dict(preview: InvoicePreview) -> Dict:\t    return {\r\n        \"subscription\": preview.sub_id,\t        \"currency\": preview.currency,\t        \"issued_on\": preview.issued_on.isoformat(),\r\n        \"lines\": [\t            {\t                \"kind\": line.kind,\r\n                \"plan\": line.plan_id,\t                \"amount\": line.amount,\t                \"period_start\": line.period_start.isoformat(),\r\n                \"period_end\": line.period_end.isoformat(),\t                \"description\": line.description,\t            }\r\n            for line in preview.lines\t        ],\t        \"subtotal\": preview.subtotal,\r\n        \"balance_before\": preview.balance_before,\t        \"amount_due\": preview.amount_due,\t        \"credit_carried\": preview.credit_carried,\r\n"]
[91.964744, "o", "Worked examples: 10\r\nmid-month-upgrade starter-monthly -> pro-monthly 2025-03-14 2026-06-20\r\nmonth-end-anchor-short-month pro-monthly -> team-monthly 2024-01-31 2026-02-15\r\nmonth-end-anchor-after-short-month pro-monthly -> team-monthly 2024-01-31 2026-03-10\r\nleap-day-renewal pro-monthly -> team-monthly 2028-01-30 2028-02-29\r\nannual-leap-anchor team-annual -> pro-annual 2024-02-29 2027-11-02\r\n"]
