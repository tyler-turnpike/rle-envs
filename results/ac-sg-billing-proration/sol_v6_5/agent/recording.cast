[49.621232, "o", "self):\r\n        self.assertEqual(portion(1, 1, 2), 0)\t        self.assertEqual(portion(3, 1, 2), 2)\r\n        self.assertEqual(portion(4900, 15, 28), 2625)\t\r\n    def test_rejects_bad_fraction(self):\t        with self.assertRaises(ValueError):\r\n            portion(100, 5, 4)\t\r\n\tclass InvoiceTest(unittest.TestCase):\r\n    def setUp(self):\t        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\t    def test_downgrade_carries_credit(self):\r\n        sub = Subscription(\"sub_9\", \"cus_9\", \"team-monthly\", date(2025, 3, 14))\t        pr = prorate_change(sub, \"starter-monthly\", date(2026, 6, 20), self.catalog)\r\n        preview = build_preview(pr, \"USD\")\t        self.assertEqual(preview.amount_due, 0)\r\n        self.assertEqual(preview.credit_carried, pr.credit - pr.charge)\t        self.assertEqual([l[\"kind\"] for l in to_dict(preview)[\"lines\"]], [\"credit\", \"charge\"])\r\n\t    def test_format_amount(self):\r\n        self.assertEqual(format_amount(123456, \"USD\"), \"1,234.56 USD\")\t        self.assertEqual(format_amount("]
[49.621428, "o", "-5, \"USD\"), \"-0.05 USD\")\r\n        self.assertEqual(format_amount(500, \"JPY\"), \"500 JPY\")\t\r\n    def test_cli_json_preview(self):\t        buf = io.StringIO()\r\n        with redirect_stdout(buf):\t            cli.main([\"preview\", \"--sub\", str(APP / \"data\" / \"subscriptions.json\"),\r\n                      \"--id\", \"sub_1001\", \"--to\", \"pro-monthly\", \"--at\", \"2026-06-20\",\t                      \"--catalog\", str(APP / \"data\" / \"catalog.json\"), \"--json\"])\r\n        doc = json.loads(buf.getvalue())\t        self.assertEqual(doc[\"subscription\"], \"sub_1001\")\r\n        self.assertEqual(doc[\"subtotal\"], 2960)\t        self.assertEqual(doc[\"amount_due\"], 2960)\r\n\t\r\nclass PartnerInvoiceTest(unittest.TestCase):\t    \"\"\"Partner-channel subscriptions: the change preview carries the partner's commission.\"\"\"\r\n\t\r\n"]
[49.624101, "o", "\"\"\"Plan catalog: plan definitions and their price history.\"\"\"\tfrom __future__ import annotations\t\r\nimport json\tfrom dataclasses import dataclass, field\tfrom datetime import date\r\nfrom pathlib import Path\tfrom typing import Dict, List, Tuple\t\r\nfrom .calendar import interval_months, parse_date\t\tDEFAULT_CATALOG = Path(__file__).resolve().parent.parent / \"data\" / \"catalog.json\"\r\n\t\t@dataclass(frozen=True)\r\nclass Plan:\t    plan_id: str\t    name: str\r\n    interval: str\t    currency: str\t    # (effective_from, unit price in minor units), sorted by date\r\n    prices: Tuple[Tuple[date, int], ...] = field(default_factory=tuple)\t\t    @property\r\n    def months(self) -> int:\t        return interval_months(self.interval)\t\r\n    def price_on(self, on: date) -> int:\t        \"\"\"Price in force on ``on`` (the latest entry whose start is <= on).\"\"\"\t        current = None\r\n"]
[49.624449, "o", "        for start, cents in self.prices:\t            if start <= on:\t                current = cents\r\n            else:\t                break\t        if current is None:\r\n            raise LookupError(f\"plan {self.plan_id} has no price on {on}\")\t        return current\t\r\n\tclass Catalog:\t    def __init__(self, plans: Dict[str, Plan]):\r\n        self._plans = dict(plans)\t\t    def plan(self, plan_id: str) -> Plan:\r\n        try:\t            return self._plans[plan_id]\t        except KeyError:\r\n            raise KeyError(f\"unknown plan: {plan_id}\") from None\t\t    def price(self, plan_id: str, on: date) -> int:\r\n        return self.plan(plan_id).price_on(on)\t\t    def plan_ids(self) -> List[str]:\r\n        return sorted(self._plans)\t\t    def __contains__(self, plan_id: str) -> bool:\r\n        return plan_id in self._plans\t\t\r\ndef _plan_from_dict(raw: dict) -> Plan:\t    history = sorted(\t        (parse_date(p[\"effective_from\"]), int(p[\"unit_amount\"])) for p in raw[\"prices\"]\r\n    )\t    if not history:\t        raise ValueEr"]
[49.625391, "o", "ror(f\"plan {raw['id']} has an empty price history\")\r\n    if raw[\"interval\"] not in (\"month\", \"year\"):\t        raise ValueError(f\"plan {raw['id']} has unknown interval {raw['interval']!r}\")\t    return Plan(\r\n        plan_id=raw[\"id\"],\t        name=raw.get(\"name\", raw[\"id\"]),\t        interval=raw[\"interval\"],\r\n        currency=raw.get(\"currency\", \"USD\"),\t        prices=tuple(history),\t    )\r\n\t\tdef load_catalog(path: Path | str = DEFAULT_CATALOG) -> Catalog:\r\n    with open(path, encoding=\"utf-8\") as fh:\t        doc = json.load(fh)\t    plans = {}\r\n    for raw in doc[\"plans\"]:\t        plan = _plan_from_dict(raw)\t        if plan.plan_id in plans:\r\n            raise ValueError(f\"duplicate plan id {plan.plan_id}\")\t        plans[plan.plan_id] = plan\t    return Catalog(plans)\r\n"]
