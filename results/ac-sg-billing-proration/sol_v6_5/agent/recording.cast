[10.795387, "o", " KNOWN_FAILURES.read_text().splitlines()} - {\"\"}\r\n\r\n    def walk(suite):\r\n        for item in suite:\r\n            if isinstance(item, unittest.TestSuite):\r\n                yield from walk(item)\r\n            else:\r\n                yield item\r\n    for test in walk(tests):\r\n        if any(test.id().endswith(name) for name in listed):\r\n            method = getattr(test, test._testMethodName)\r\n\r\n            def expected(method=method):\r\n                return method()\r\n            expected.__unittest_expecting_failure__ = True\r\n            setattr(test, test._testMethodName, expected)\r\n    return tests\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n# Known failures accepted for a release: one test id per line (e.g. PortionTest.test_half_even)\r\n# with the ticket in a comment. See tests/README.md.\r\n{\r\n  \"bulk_reprice_seconds\": 0.2,\r\n  \"note\": \"CI runner budget for the bulk repricing check (data/book.json). The platform team adjusts it when the runners change.\"\r\n}\r\n\u001b[?2004hroot@aa9d188bc6ab:/app# "]
