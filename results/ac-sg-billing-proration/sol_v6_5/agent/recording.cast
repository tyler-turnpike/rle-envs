[91.964884, "o", "price-change-inside-cycle team-monthly -> pro-monthly 2026-12-20 2027-01-05\r\nchange-on-anchor-day starter-monthly -> team-monthly 2026-03-31 2026-03-31\r\nmonthly-to-annual starter-monthly -> starter-annual 2025-08-30 2026-02-27\r\ndowngrade-carries-credit team-monthly -> starter-monthly 2025-10-31 2026-04-07\r\n"]
