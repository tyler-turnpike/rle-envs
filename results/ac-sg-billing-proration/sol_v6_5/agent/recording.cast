[86.926707, "o", "\"\"\"Command line: preview the invoice for a plan change.\t\r\n    python -m billing preview --sub data/subscriptions.json --id sub_1042 \\\t        --to pro-monthly --at 2026-01-31 [--json]\r\n\"\"\"\tfrom __future__ import annotations\r\n\timport argparse\r\nimport json\timport sys\r\n\tfrom .calendar import parse_date\r\nfrom .catalog import DEFAULT_CATALOG, load_catalog\tfrom .invoice import build_preview, render_text, to_dict\r\nfrom .proration import Subscription, prorate_change\t\r\n\tdef _load_subscription(path: str, sub_id: str) -> tuple[Subscription, int]:\r\n    with open(path, encoding=\"utf-8\") as fh:\t        rows = json.load(fh)[\"subscriptions\"]\r\n    for row in rows:\t        if row[\"id\"] == sub_id:\r\n            sub = Subscription(row[\"id\"], row[\"customer\"], row[\"plan\"], parse_date(row[\"anchor\"]))\t            return sub, int(row.get(\"balance\", 0))\r\n    raise SystemExit(f\"no subscription {sub_id} in {path}\")\t\r\n\tdef main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"billing\")\t    sub = parser.ad"]
[86.926926, "o", "d_subparsers(dest=\"cmd\", required=True)\r\n    p = sub.add_parser(\"preview\", help=\"preview a mid-cycle plan change\")\t    p.add_argument(\"--sub\", required=True, help=\"subscriptions JSON file\")\r\n    p.add_argument(\"--id\", required=True, help=\"subscription id\")\t    p.add_argument(\"--to\", required=True, help=\"new plan id\")\r\n    p.add_argument(\"--at\", required=True, help=\"change date, YYYY-MM-DD\")\t    p.add_argument(\"--catalog\", default=str(DEFAULT_CATALOG))\r\n    p.add_argument(\"--json\", action=\"store_true\")\t    args = parser.parse_args(argv)\r\n\t    catalog = load_catalog(args.catalog)\r\n    subscription, balance = _load_subscription(args.sub, args.id)\t    proration = prorate_change(subscription, args.to, parse_date(args.at), catalog)\r\n    currency = catalog.plan(args.to).currency\t    preview = build_preview(proration, currency, balance_before=balance)\r\n    if args.json:\t        json.dump(to_dict(preview), sys.stdout, indent=2)\r\n        sys.stdout.write(\"\\n\")\t    else:\r\n        print(render_text(preview))\t    return 0"]
[86.926972, "o", "\r\n\t\r\nif __name__ == \"__main__\":\t    sys.exit(main())\r\n"]
