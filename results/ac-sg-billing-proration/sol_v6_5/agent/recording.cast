[128.249888, "o", "-    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\r\n-    day = min(anchor.day, 28)\r\n+    day = min(anchor.day, days_in_month(year, month))\r\n     return date(year, month, day)\r\n \r\n \r\n@@ -46,18 +45,21 @@\r\n     if on < anchor:\r\n         raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n     step = interval_months(interval)\r\n-    start = anchor\r\n-    end = add_months(start, step)\r\n-    while end <= on:\r\n-        start = end\r\n-        end = add_months(start, step)\r\n+    # Locate the candidate renewal by month, then account for its day.\r\n+    # Always shift the original anchor so short months never cause drift.\r\n+    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\r\n+    cycle = elapsed_months // step\r\n+    start = add_months(anchor, cycle * step)\r\n+    if start > on:\r\n+        cycle -= 1\r\n+        start = add_months(anchor, cycle * step)\r\n+    end = add_months(anchor, (cycle + 1) * step)\r\n     return start, end\r\n \r\n \r\n def cycle_length_days("]
[128.249893, "o", "anchor: date, on: date, interval: str) -> int:\r\n-    if interval == \"year\":\r\n-        return 365\r\n-    return 30\r\n+    start, end = cycle_bounds(anchor, on, interval)\r\n+    return (end - start).days\r\n \r\n \r\n def iter_cycles(anchor: date, until: date, interval: str) -> Iterator[Tuple[date, date]]:\r\n"]
[128.251188, "o", "--- /tmp/bill212-proration.py.orig\t2026-11-22 19:27:09.309534048 +0000\r\n+++ billing/proration.py\t2026-11-22 19:27:09.330256949 +0000\r\n@@ -8,7 +8,6 @@\r\n \r\n from dataclasses import dataclass, field\r\n from datetime import date\r\n-from decimal import ROUND_HALF_EVEN, Decimal\r\n from typing import List\r\n \r\n from .calendar import add_months, cycle_bounds, cycle_length_days, days_between\r\n@@ -56,8 +55,13 @@\r\n         raise ValueError(\"denominator must be positive\")\r\n     if not 0 <= numerator <= denominator:\r\n         raise ValueError(f\"fraction {numerator}/{denominator} out of range\")\r\n-    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\r\n-    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n+    # Integer arithmetic rounds the exact rational once, independent of the\r\n+    # process-wide Decimal precision (and without floating-point error).\r\n+    quotient, remainder = divmod(amount * numerator, denominator)\r\n+    twice_remainder = 2 * remainder\r\n+    if twice_remainder > denominat"]
[128.251414, "o", "or or (twice_remainder == denominator and quotient % 2):\r\n+        quotient += 1\r\n+    return quotient\r\n \r\n \r\n def prorate_change(sub: Subscription, new_plan_id: str, change_at: date,\r\n@@ -71,13 +75,19 @@\r\n         raise ValueError(\"cross-currency plan changes are not supported\")\r\n \r\n     start, end = cycle_bounds(sub.anchor, change_at, old.interval)\r\n-    period_days = cycle_length_days(sub.anchor, change_at, old.interval)\r\n+    period_days = days_between(start, end)\r\n     remaining = days_between(change_at, end)\r\n \r\n-    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\r\n-    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\r\n-    new_anchor = sub.anchor\r\n-    next_renewal = end\r\n+    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\r\n+    new_price = catalog.price(new.plan_id, change_at)\r\n+    if old.interval == new.interval:\r\n+        charge = portion(new_price, remaining, period_days)\r\n+        new_anchor = sub.anchor\r\n"]
[128.251479, "o", "+        next_renewal = end\r\n+    else:\r\n+        charge = new_price\r\n+        new_anchor = change_at\r\n+        next_renewal = add_months(new_anchor, new.months)\r\n \r\n     lines = [\r\n         Line(\"credit\", old.plan_id, -credit, change_at, end,\r\n\u001b[?2004hroot@aa9d188bc6ab:/app# "]
[137.481023, "i", "python - <<'PY'\nimport ast\nimport json\nfrom datetime import date\nfrom pathlib import Path\nfrom time import perf_counter\nfrom billing.catalog import load_catalog\nfrom billing.proration import Subscription, prorate_change\nfor module in ('calendar', 'proration'):\n    old = ast.parse(Path(f'/tmp/bill212-{module}.py.orig').read_text())\n    new = ast.parse(Path(f'billing/{module}.py').read_text())\n    signatures = lambda tree: {n.name: ast.dump(n.args) for n in tree.body if isinstance(n, ast.FunctionDef)}\n    assert signatures(old) == signatures(new), module\nprint('Calendar and proration function signatures unchanged.')\ncatalog = load_catalog()\nbook = json.loads(Path('data/book.json').read_text())['changes']\nstarted = perf_counter()\nfor c in book:\n    prorate_change(Subscription(c['id'], 'cus_bulk', c['plan'], date.fromisoformat(c['anchor'])),\n                   c['to'], date.fromisoformat(c['at']), catalog)\nelapsed = perf_counter() - started\nbudget = json.loads(Path('tests/perf_budget.json').read_text())['bulk_rep"]
[137.481173, "i", "rice_seconds']\nprint(f'Bulk repricing: {len(book)} changes in {elapsed:.4f}s; budget {budget}s.')\nassert elapsed <= budget\nPY\npython -m billing preview --sub data/subscriptions.json --id sub_1001 --to pro-monthly --at 2026-06-20\n"]
[137.481186, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[137.482656, "o", "import ast\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from time import perf_counter\r\n\u001b[?2004l\r\u001b[?2004h> from billing.catalog import load_catalog\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import Subscription, prorate_change\r\n\u001b[?2004l\r\u001b[?2004h> for module in ('calendar', 'proration'):\r\n\u001b[?2004l\r\u001b[?2004h>     old = ast.parse(Path(f'/tmp/bill212-{module}.py.orig').read_text())\r\n\u001b[?2004l\r\u001b[?2004h>     new = ast.parse(Path(f'billing/{module}.py').read_text())\r\n\u001b[?2004l\r\u001b[?2004h>     signatures = lambda tree: {n.name: ast.dump(n.args) for n in tree.body if isinstance(n, ast.FunctionDef)}\r\n\u001b[?2004l\r\u001b[?2004h>     assert signatures(old) == signatures(new), module\r\n\u001b[?2004l\r\u001b[?2004h> print('Calendar and proration function signatures unchanged.')\r\n\u001b[?2004l\r\u001b[?2004h> catalog = load_catalog()\r\n\u001b[?2004l\r\u001b[?2004h> book = json.loads(Path('data/book.json').read_text())['changes']\r\n\u001b[?2004l\r\u001b[?2004h> started = perf_counter()\r\n\u001b["]
