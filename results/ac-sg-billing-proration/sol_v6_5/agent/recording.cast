[80.347381, "o", "import unittest\tfrom datetime import date\r\n\tfrom billing.calendar import add_months, cycle_bounds, days_in_month, iter_cycles\r\n\t\r\nclass AddMonthsTest(unittest.TestCase):\t    def test_mid_month_anchor(self):\r\n        self.assertEqual(add_months(date(2025, 3, 14), 1), date(2025, 4, 14))\t        self.assertEqual(add_months(date(2025, 3, 14), 10), date(2026, 1, 14))\r\n\t    def test_year_rollover(self):\r\n        self.assertEqual(add_months(date(2025, 11, 5), 3), date(2026, 2, 5))\t        self.assertEqual(add_months(date(2025, 12, 1), 12), date(2026, 12, 1))\r\n\t    def test_month_end_anchor_clamps_then_returns(self):\r\n        anchor = date(2026, 1, 31)\t        got = [add_months(anchor, k) for k in range(1, 5)]\r\n        self.assertEqual(got, [date(2026, 2, 28), date(2026, 3, 31),\t                               date(2026, 4, 30), date(2026, 5, 31)])\r\n\t    def test_leap_years(self):\r\n"]
[80.347481, "o", "        self.assertEqual(add_months(date(2028, 1, 30), 1), date(2028, 2, 29))\t        anchor = date(2024, 2, 29)\r\n        got = [add_months(anchor, 12 * k) for k in range(1, 5)]\t        self.assertEqual(got, [date(2025, 2, 28), date(2026, 2, 28),\r\n                               date(2027, 2, 28), date(2028, 2, 29)])\t\r\n    def test_days_in_month(self):\t        self.assertEqual(days_in_month(2026, 2), 28)\r\n        self.assertEqual(days_in_month(2028, 2), 29)\t\r\n\tclass CycleBoundsTest(unittest.TestCase):\r\n    def test_mid_month(self):\t        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 20), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\t\r\n    def test_change_on_renewal_day_starts_new_cycle(self):\t        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 14), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\t\r\n    def test_month_end_anchor(self):\t        anchor = date(2024, 1, 31)\r\n        self.assertEqual(cycle_bounds(anchor, d"]
[80.347517, "o", "ate(2026, 2, 15), \"month\"),\t                         (date(2026, 1, 31), date(2026, 2, 28)))\r\n        self.assertEqual(cycle_bounds(anchor, date(2026, 3, 10), \"month\"),\t                         (date(2026, 2, 28), date(2026, 3, 31)))\r\n\t    def test_annual(self):\r\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2027, 11, 2), \"year\"),\t                         (date(2027, 2, 28), date(2028, 2, 29)))\r\n\t    def test_iter_cycles_is_contiguous(self):\r\n        cycles = list(iter_cycles(date(2026, 1, 31), date(2026, 6, 1), \"month\"))\t        self.assertEqual(cycles[0][0], date(2026, 1, 31))\r\n        for (s1, e1), (s2, _) in zip(cycles, cycles[1:]):\t            self.assertEqual(e1, s2)\r\n        self.assertEqual(cycles[-1], (date(2026, 5, 31), date(2026, 6, 30)))\t\r\n\tif __name__ == \"__main__\":\r\n    unittest.main()\t\r\n"]
