[43.049829, "i", "(k + 1) * step)''')\ns = s.replace('    if interval == \"year\":\\n        return 365\\n    return 30', '    start, end = cycle_bounds(anchor, on, interval)\\n    return (end - start).days')\np.write_text(s)\np = Path('billing/proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_EVEN, Decimal\\n', 'from fractions import Fraction\\n')\ns = s.replace('from .calendar import add_months, cycle_bounds, cycle_length_days, days_between', 'from .calendar import add_months, cycle_bounds, days_between')\ns = s.replace('    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))', '    return round(Fraction(amount * numerator, denominator))')\ns = s.replace('    period_days = cycle_length_days(sub.anchor, change_at, old.interval)', '    period_days = days_between(start, end)')\ns = s.replace('    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at),"]
