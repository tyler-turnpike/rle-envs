[6.916225, "o", "cat docs/proration.md && printf '\\n--- BILLING SOURCE ---\\n' && find billing -maxdepth 2 -name '*.py' -print -exec sed -n '1,260p' {} \\; \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K;\r\n\u001b[?2004l\r"]
[6.91764, "o", "# Proration rules (finance sign-off, rev. 4)\r\n\r\nThese are the rules the billing engine must follow when a subscription changes\r\nplan part-way through a billing cycle. Amounts are integers in minor units\r\n(cents for USD).\r\n\r\n## 1. Billing cycles\r\n\r\nA subscription has an **anchor date**: the day it was first billed. Monthly\r\nplans renew every calendar month, annual plans every twelve calendar months.\r\n\r\nRenewal *k* is the anchor moved forward by *k* (monthly) or *12k* (annual)\r\ncalendar months. If the target month does not have the anchor's day of month,\r\nthe renewal falls on the **last day of that month**. Every renewal is computed\r\nfrom the original anchor, never from the previous renewal, so a cycle that was\r\nshortened by a short month returns to the anchor day afterwards.\r\n\r\n| anchor     | interval | renewals                                         |\r\n|------------|----------|--------------------------------------------------|\r\n| 2026-01-31 | month    | 2026-02-28, 2026-03-31, 2026-04-30, 2026-05-31 … |\r\n"]
[6.917672, "o", "| 2028-01-30 | month    | 2028-02-29, 2028-03-30, 2028-04-30 …             |\r\n| 2024-02-29 | year     | 2025-02-28, 2026-02-28, 2027-02-28, 2028-02-29 … |\r\n\r\nThe cycle containing a date *d* is the half-open interval `[start, end)` where\r\n`start` is the latest renewal (or the anchor) on or before *d* and `end` is the\r\nnext renewal. A change made on a renewal date belongs to the cycle that starts\r\nthat day.\r\n\r\n## 2. Credit for the old plan\r\n\r\n`period_days = end - start` and `remaining_days = end - change_date`, both in\r\nwhole days. The credit is\r\n\r\n    credit = round_half_even(old_price * remaining_days / period_days)\r\n\r\nwhere `old_price` is the old plan's price **in force on the cycle start** (that\r\nis what the customer was billed). Rounding is half-to-even to a whole minor\r\nunit, applied once to the exact rational result.\r\n\r\n## 3. Charge for the new plan\r\n\r\n* **Same interval** (month to month, year to year): the customer keeps the\r\n  same anchor and pays for the rest of the current cycle:\r\n  `charge = rou"]
[6.917678, "o", "nd_half_even(new_price * remaining_days / period_days)`, with\r\n  `new_price` in force on the change date. The next renewal stays `end`.\r\n* **Different interval** (month to year or year to month): the subscription is\r\n  re-anchored on the change date. The customer pays the new plan's full price\r\n  in force on the change date, the new anchor is the change date and the next\r\n  renewal is one new-interval later (computed with the rule in section 1).\r\n\r\n## 4. Invoice\r\n\r\nThe preview has a negative credit line and a positive charge line. The total\r\nis `charge - credit`; a negative total is carried forward as account credit.\r\n\r\n--- BILLING SOURCE ---\r\n"]
[6.919197, "o", "billing/calendar.py\r\n"]
[6.92114, "o", "\"\"\"Billing-cycle calendar arithmetic.\r\n\r\nSubscriptions bill on an *anchor* date. Monthly plans renew every month on the\r\nanchor's day of month, annual plans every twelve months. See\r\ndocs/proration.md for the rules finance signed off on.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar as _stdcal\r\nfrom datetime import date, timedelta\r\nfrom typing import Iterator, Tuple\r\n\r\nINTERVAL_MONTHS = {\"month\": 1, \"year\": 12}\r\n\r\n\r\ndef interval_months(interval: str) -> int:\r\n    try:\r\n        return INTERVAL_MONTHS[interval]\r\n    except KeyError:\r\n        raise ValueError(f\"unknown billing interval: {interval!r}\") from None\r\n\r\n\r\ndef days_in_month(year: int, month: int) -> int:\r\n    return _stdcal.monthrange(year, month)[1]\r\n\r\n\r\ndef is_leap(year: int) -> bool:\r\n    return _stdcal.isleap(year)\r\n\r\n\r\ndef add_months(anchor: date, months: int) -> date:\r\n    \"\"\"Move ``anchor`` forward by ``months`` calendar months.\"\"\"\r\n    total = anchor.month - 1 + months\r\n    year = anchor.year + total // 12\r\n    month = total % 12 "]
[6.921354, "o", "+ 1\r\n    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\r\n    day = min(anchor.day, 28)\r\n    return date(year, month, day)\r\n\r\n\r\ndef cycle_bounds(anchor: date, on: date, interval: str) -> Tuple[date, date]:\r\n    \"\"\"Return ``(start, end)`` of the billing cycle containing ``on``.\r\n\r\n    ``start`` is inclusive and ``end`` is exclusive (the next renewal date).\r\n    \"\"\"\r\n    if on < anchor:\r\n        raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n    step = interval_months(interval)\r\n    start = anchor\r\n    end = add_months(start, step)\r\n    while end <= on:\r\n        start = end\r\n        end = add_months(start, step)\r\n    return start, end\r\n\r\n\r\ndef cycle_length_days(anchor: date, on: date, interval: str) -> int:\r\n    if interval == \"year\":\r\n        return 365\r\n    return 30\r\n\r\n\r\ndef iter_cycles(anchor: date, until: date, interval: str) -> Iterator[Tuple[date, date]]:\r\n    \"\"\"Yield every cycle from the anchor up to and including the one containing ``until``.\"\"\"\r\n   "]
[6.921406, "o", " start, end = cycle_bounds(anchor, anchor, interval)\r\n    while start <= until:\r\n        yield start, end\r\n        start, end = cycle_bounds(anchor, end, interval)\r\n\r\n\r\ndef days_between(a: date, b: date) -> int:\r\n    return (b - a).days\r\n\r\n\r\ndef parse_date(text: str) -> date:\r\n    return date.fromisoformat(text)\r\n\r\n\r\ndef end_of_day(d: date) -> date:\r\n    return d + timedelta(days=1)\r\nbilling/__init__.py\r\n"]
[6.922426, "o", "\"\"\"Subscription billing engine: catalog, cycle calendar, proration, invoice previews.\"\"\"\r\nfrom .calendar import add_months, cycle_bounds\r\nfrom .catalog import Catalog, Plan, load_catalog\r\nfrom .proration import Proration, Subscription, prorate_change\r\n\r\n__all__ = [\"add_months\", \"cycle_bounds\", \"Catalog\", \"Plan\", \"load_catalog\",\r\n           \"Proration\", \"Subscription\", \"prorate_change\"]\r\n"]
[6.922622, "o", "billing/invoice.py\r\n"]
[6.923685, "o", "\"\"\"Invoice previews for plan changes.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom pathlib import Path\r\nfrom typing import Dict, List\r\n\r\nfrom .proration import Line, Proration\r\n\r\nCURRENCY_EXPONENT = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"JPY\": 0}\r\n\r\n\r\n@dataclass\r\nclass InvoicePreview:\r\n    sub_id: str\r\n    currency: str\r\n    issued_on: date\r\n    lines: List[Line] = field(default_factory=list)\r\n    balance_before: int = 0\r\n\r\n    @property\r\n    def subtotal(self) -> int:\r\n        return sum(line.amount for line in self.lines)\r\n\r\n    @property\r\n    def amount_due(self) -> int:\r\n        \"\"\"What the customer pays now; never negative.\"\"\"\r\n        return max(0, self.subtotal + self.balance_before)\r\n\r\n    @property\r\n    def credit_carried(self) -> int:\r\n        \"\"\"Credit left on the account after this invoice (positive number).\"\"\"\r\n        return max(0, -(self.subtotal + self.balance_before))\r\n\r\n"]
[6.923717, "o", "\r\ndef build_preview(proration: Proration, currency: str, balance_before: int = 0) -> InvoicePreview:\r\n    return InvoicePreview(\r\n        sub_id=proration.sub_id,\r\n        currency=currency,\r\n        issued_on=proration.change_at,\r\n        lines=list(proration.lines),\r\n        balance_before=balance_before,\r\n    )\r\n\r\n\r\ndef format_amount(minor: int, currency: str) -> str:\r\n    exp = CURRENCY_EXPONENT.get(currency, 2)\r\n"]
[6.923804, "o", "    sign = \"-\" if minor < 0 else \"\"\r\n    minor = abs(minor)\r\n    if exp == 0:\r\n        return f\"{sign}{minor} {currency}\"\r\n    major, frac = divmod(minor, 10 ** exp)\r\n    return f\"{sign}{major:,}.{frac:0{exp}d} {currency}\"\r\n\r\n\r\ndef to_dict(preview: InvoicePreview) -> Dict:\r\n    return {\r\n        \"subscription\": preview.sub_id,\r\n        \"currency\": preview.currency,\r\n        \"issued_on\": preview.issued_on.isoformat(),\r\n        \"lines\": [\r\n            {\r\n                \"kind\": line.kind,\r\n                \"plan\": line.plan_id,\r\n                \"amount\": line.amount,\r\n                \"period_start\": line.period_start.isoformat(),\r\n                \"period_end\": line.period_end.isoformat(),\r\n                \"description\": line.description,\r\n            }\r\n            for line in preview.lines\r\n        ],\r\n        \"subtotal\": preview.subtotal,\r\n        \"balance_before\": preview.balance_before,\r\n        \"amount_due\": preview.amount_due,\r\n        \"credit_carried\": preview.credit_carried,\r\n    }\r\n\r\n\r\ndef render_text(p"]
[6.923825, "o", "review: InvoicePreview) -> str:\r\n    out = [f\"Invoice preview for {preview.sub_id} ({preview.issued_on})\"]\r\n    for line in preview.lines:\r\n        out.append(f\"  {line.description:<60} {format_amount(line.amount, preview.currency):>16}\")\r\n    out.append(f\"  {'Subtotal':<60} {format_amount(preview.subtotal, preview.currency):>16}\")\r\n    if preview.balance_before:\r\n        out.append(f\"  {'Balance before':<60} {format_amount(preview.balance_before, preview.currency):>16}\")\r\n    out.append(f\"  {'Amount due':<60} {format_amount(preview.amount_due, preview.currency):>16}\")\r\n    if preview.credit_carried:\r\n        out.append(f\"  {'Credit carried forward':<60} {format_amount(preview.credit_carried, preview.currency):>16}\")\r\n    return \"\\n\".join(out)\r\n\r\n\r\ndef load_partner_rates(path: Path | str) -> Dict[str, Decimal]:\r\n    \"\"\"Commission rate per reseller partner, as contracted (data/partners.json).\"\"\"\r\n    with open(path, encoding=\"utf-8\") as fh:\r\n        doc = json.load(fh)\r\n    return {p[\"id\"]: Decimal(p[\"commissi"]
[6.923839, "o", "on_rate\"]) for p in doc[\"partners\"]}\r\n\r\n\r\ndef commission_line(preview: InvoicePreview, rate: Decimal, partner_id: str) -> Line:\r\n    \"\"\"Partner-channel invoices carry the reseller's commission as a credit line.\"\"\"\r\n    if not Decimal(0) <= rate < Decimal(1):\r\n        raise ValueError(f\"commission rate {rate} for {partner_id} out of range\")\r\n    amount = int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n    return Line(\"commission\", partner_id, -amount, preview.issued_on, preview.issued_on,\r\n                f\"Partner commission {partner_id} ({rate * 100:.1f}%)\")\r\n"]
[6.923984, "o", "billing/catalog.py\r\n"]
[6.925056, "o", "\"\"\"Plan catalog: plan definitions and their price history.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom pathlib import Path\r\nfrom typing import Dict, List, Tuple\r\n\r\nfrom .calendar import interval_months, parse_date\r\n\r\nDEFAULT_CATALOG = Path(__file__).resolve().parent.parent / \"data\" / \"catalog.json\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    plan_id: str\r\n    name: str\r\n    interval: str\r\n    currency: str\r\n    # (effective_from, unit price in minor units), sorted by date\r\n    prices: Tuple[Tuple[date, int], ...] = field(default_factory=tuple)\r\n\r\n    @property\r\n    def months(self) -> int:\r\n"]
[6.925168, "o", "        return interval_months(self.interval)\r\n\r\n    def price_on(self, on: date) -> int:\r\n        \"\"\"Price in force on ``on`` (the latest entry whose start is <= on).\"\"\"\r\n        current = None\r\n        for start, cents in self.prices:\r\n            if start <= on:\r\n                current = cents\r\n            else:\r\n                break\r\n        if current is None:\r\n            raise LookupError(f\"plan {self.plan_id} has no price on {on}\")\r\n        return current\r\n\r\n\r\nclass Catalog:\r\n    def __init__(self, plans: Dict[str, Plan]):\r\n        self._plans = dict(plans)\r\n\r\n    def plan(self, plan_id: str) -> Plan:\r\n        try:\r\n            return self._plans[plan_id]\r\n        except KeyError:\r\n            raise KeyError(f\"unknown plan: {plan_id}\") from None\r\n\r\n    def price(self, plan_id: str, on: date) -> int:\r\n        return self.plan(plan_id).price_on(on)\r\n\r\n    def plan_ids(self) -> List[str]:\r\n        return sorted(self._plans)\r\n\r\n    def __contains__(self, plan_id: str) -> bool:\r\n        return plan_id in"]
[6.925188, "o", " self._plans\r\n\r\n\r\ndef _plan_from_dict(raw: dict) -> Plan:\r\n    history = sorted(\r\n        (parse_date(p[\"effective_from\"]), int(p[\"unit_amount\"])) for p in raw[\"prices\"]\r\n    )\r\n    if not history:\r\n        raise ValueError(f\"plan {raw['id']} has an empty price history\")\r\n    if raw[\"interval\"] not in (\"month\", \"year\"):\r\n        raise ValueError(f\"plan {raw['id']} has unknown interval {raw['interval']!r}\")\r\n    return Plan(\r\n        plan_id=raw[\"id\"],\r\n        name=raw.get(\"name\", raw[\"id\"]),\r\n        interval=raw[\"interval\"],\r\n        currency=raw.get(\"currency\", \"USD\"),\r\n        prices=tuple(history),\r\n    )\r\n\r\n\r\ndef load_catalog(path: Path | str = DEFAULT_CATALOG) -> Catalog:\r\n    with open(path, encoding=\"utf-8\") as fh:\r\n        doc = json.load(fh)\r\n    plans = {}\r\n    for raw in doc[\"plans\"]:\r\n        plan = _plan_from_dict(raw)\r\n        if plan.plan_id in plans:\r\n            raise ValueError(f\"duplicate plan id {plan.plan_id}\")\r\n        plans[plan.plan_id] = plan\r\n    return Catalog(plans)\r\n"]
[6.9254, "o", "billing/__main__.py\r\n"]
[6.926555, "o", "\"\"\"Command line: preview the invoice for a plan change.\r\n\r\n    python -m billing preview --sub data/subscriptions.json --id sub_1042 \\\r\n        --to pro-monthly --at 2026-01-31 [--json]\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\n"]
[6.92665, "o", "import json\r\nimport sys\r\n\r\nfrom .calendar import parse_date\r\nfrom .catalog import DEFAULT_CATALOG, load_catalog\r\nfrom .invoice import build_preview, render_text, to_dict\r\nfrom .proration import Subscription, prorate_change\r\n\r\n\r\ndef _load_subscription(path: str, sub_id: str) -> tuple[Subscription, int]:\r\n    with open(path, encoding=\"utf-8\") as fh:\r\n        rows = json.load(fh)[\"subscriptions\"]\r\n    for row in rows:\r\n        if row[\"id\"] == sub_id:\r\n            sub = Subscription(row[\"id\"], row[\"customer\"], row[\"plan\"], parse_date(row[\"anchor\"]))\r\n            return sub, int(row.get(\"balance\", 0))\r\n    raise SystemExit(f\"no subscription {sub_id} in {path}\")\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"billing\")\r\n    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n    p = sub.add_parser(\"preview\", help=\"preview a mid-cycle plan change\")\r\n    p.add_argument(\"--sub\", required=True, help=\"subscriptions JSON file\")\r\n    p.add_argument(\"--id\", required=True"]
[6.926666, "o", ", help=\"subscription id\")\r\n    p.add_argument(\"--to\", required=True, help=\"new plan id\")\r\n    p.add_argument(\"--at\", required=True, help=\"change date, YYYY-MM-DD\")\r\n    p.add_argument(\"--catalog\", default=str(DEFAULT_CATALOG))\r\n    p.add_argument(\"--json\", action=\"store_true\")\r\n    args = parser.parse_args(argv)\r\n\r\n    catalog = load_catalog(args.catalog)\r\n    subscription, balance = _load_subscription(args.sub, args.id)\r\n    proration = prorate_change(subscription, args.to, parse_date(args.at), catalog)\r\n    currency = catalog.plan(args.to).currency\r\n    preview = build_preview(proration, currency, balance_before=balance)\r\n    if args.json:\r\n        json.dump(to_dict(preview), sys.stdout, indent=2)\r\n        sys.stdout.write(\"\\n\")\r\n    else:\r\n        print(render_text(preview))\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[6.926858, "o", "billing/proration.py\r\n"]
[6.927766, "o", "\"\"\"Mid-cycle plan changes.\r\n\r\nWhen a customer switches plan part-way through a billing cycle we credit the\r\nunused part of what they already paid for and charge for the new plan. The\r\nrules are in docs/proration.md.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\n"]
[6.927858, "o", "from datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom typing import List\r\n\r\nfrom .calendar import add_months, cycle_bounds, cycle_length_days, days_between\r\nfrom .catalog import Catalog\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Subscription:\r\n    sub_id: str\r\n    customer: str\r\n    plan_id: str\r\n    anchor: date\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Line:\r\n    kind: str          # \"credit\" or \"charge\"\r\n    plan_id: str\r\n    amount: int        # minor units; credits are negative\r\n    period_start: date\r\n    period_end: date\r\n    description: str\r\n\r\n\r\n@dataclass\r\nclass Proration:\r\n    sub_id: str\r\n    change_at: date\r\n    period_start: date\r\n    period_end: date\r\n    credit: int        # positive number of minor units credited back\r\n    charge: int        # minor units charged for the new plan\r\n    new_anchor: date\r\n    next_renewal: date\r\n    lines: List[Line] = field(default_factory=list)\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.charge - self.credit\r\n\r\n\r\ndef portion(a"]
[6.927875, "o", "mount: int, numerator: int, denominator: int) -> int:\r\n    \"\"\"``amount * numerator / denominator`` rounded half-to-even to a whole minor unit.\"\"\"\r\n    if denominator <= 0:\r\n        raise ValueError(\"denominator must be positive\")\r\n    if not 0 <= numerator <= denominator:\r\n        raise ValueError(f\"fraction {numerator}/{denominator} out of range\")\r\n    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\r\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_id: str, change_at: date,\r\n                   catalog: Catalog) -> Proration:\r\n    \"\"\"Compute the credit and charge for moving ``sub`` to ``new_plan_id`` on ``change_at``.\"\"\"\r\n    if new_plan_id == sub.plan_id:\r\n        raise ValueError(\"subscription is already on that plan\")\r\n    old = catalog.plan(sub.plan_id)\r\n    new = catalog.plan(new_plan_id)\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"cross-currency plan changes are not supported\")\r\n\r\n    start, "]
[6.927886, "o", "end = cycle_bounds(sub.anchor, change_at, old.interval)\r\n    period_days = cycle_length_days(sub.anchor, change_at, old.interval)\r\n    remaining = days_between(change_at, end)\r\n\r\n    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\r\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\r\n    new_anchor = sub.anchor\r\n    next_renewal = end\r\n\r\n    lines = [\r\n        Line(\"credit\", old.plan_id, -credit, change_at, end,\r\n             f\"Unused time on {old.name} ({change_at} to {end})\"),\r\n        Line(\"charge\", new.plan_id, charge, change_at, next_renewal,\r\n             f\"Remaining time on {new.name} ({change_at} to {next_renewal})\"),\r\n    ]\r\n    return Proration(sub.sub_id, change_at, start, end, credit, charge,\r\n                     new_anchor, next_renewal, lines)\r\n"]
[6.927891, "o", "\r\n\r\n"]
[6.927912, "o", "def renewal_after(sub: Subscription, on: date, catalog: Catalog) -> date:\r\n    \"\"\"Next renewal date strictly after ``on`` for an unchanged subscription.\"\"\"\r\n"]
[6.927933, "o", "    plan = catalog.plan(sub.plan_id)\r\n    _, end = cycle_bounds(sub.anchor, on, plan.interval)\r\n    return end\r\n"]
[6.928182, "o", "\r\n\r\ndef renewal_schedule(sub: Subscription, count: int, catalog: Catalog) -> List[date]:\r\n    plan = catalog.plan(sub.plan_id)\r\n    return [add_months(sub.anchor, plan.months * k) for k in range(1, count + 1)]\r\n"]
