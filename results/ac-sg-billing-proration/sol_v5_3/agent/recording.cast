[87.393366, "i", "actPortionRegressionTest(unittest.TestCase):\n    def test_half_even_for_positive_and_negative_ties(self):\n        for amount, expected in [(1, 0), (3, 2), (5, 2), (7, 4), (-3, -2), (-5, -2)]:\n            with self.subTest(amount=amount):\n                self.assertEqual(portion(amount, 1, 2), expected)\n\n    def test_large_amount_and_decimal_context_do_not_affect_rounding(self):\n        with localcontext() as ctx:\n            ctx.prec = 2\n            self.assertEqual(portion(10**40 + 1, 1, 2), 5 * 10**39)\n            self.assertEqual(portion(10**40 + 3, 1, 2), 5 * 10**39 + 2)\n            self.assertEqual(portion(100, 1, 3), 33)\n\n    def test_invalid_fractions(self):\n        for numerator, denominator in [(0, 0), (0, -1), (-1, 3), (4, 3)]:\n            with self.subTest(numerator=numerator, denominator=denominator):\n                with self.assertRaises(ValueError):\n                    portion(100, numerator, denominator)\n\n\nclass ProrationRegressionTest(unittest.TestCase):\n    def test_old_price_at_start_and_ne"]
