[73.050872, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\ncases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\nwith tempfile.TemporaryDirectory() as directory:\n    path = Path(directory) / 'subscriptions.json'\n    for case in cases:\n        path.write_text(json.dumps({'subscriptions': [{\n            'id': case['id'], 'customer': 'finance-example',\n            'plan': case['plan'], 'anchor': case['anchor'], 'balance': 0,\n        }]}))\n        result = subprocess.run([\n            sys.executable, '-m', 'billing', 'preview', '--sub', str(path),\n            '--id', case['id'], '--to', case['to'], '--at', case['at'], '--json',\n        ], check=True, capture_output=True, text=True)\n        doc = json.loads(result.stdout)\n        expected = case['expected']\n        assert [line['amount'] for line in doc['lines']] == [-expected['credit'], expected['charge']], case['id']\n        assert doc['subtotal'] == expected['total'], case['id']\n        assert "]
[73.051134, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.051152, "i", "doc['amount_due'] == max(0, expected['total']), case['id']\n        assert doc['credit_carried'] == max(0, -expected['total']), case['id']\n        assert doc['lines'][0]['period_end'] == expected['period_end'], case['id']\n        assert doc['lines'][1]['period_end'] == expected['next_renewal'], case['id']\n        print(f\"PASS CLI {case['id']}: total={doc['subtotal']}, due={doc['amount_due']}, credit={doc['credit_carried']}\")\nPY\n"]
