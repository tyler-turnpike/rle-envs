[54.162924, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/calendar.py')\ns = p.read_text().replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    # Clamp only in the target month; callers retain the original anchor.\\n    day = min(anchor.day, days_in_month(year, month))')\ns = s.replace('''    start = anchor\n    end = add_months(start, step)\n    while end <= on:\n        start = end\n        end = add_months(start, step)\n    return start, end''', '''    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\n    cycle = elapsed_months // step\n    start = add_months(anchor, cycle * step)\n    if start > on:\n        cycle -= 1\n        start = add_months(anchor, cycle * step)\n    end = add_months(anchor, (cycle + 1) * step)\n    return start, end''')\ns = s.replace('''    if interval == \"year\":\n        return 365\n    return 30''', '''    start, end = cycle_bounds(anchor, on, interval)\n    return (end - start).days''')\np.write_text"]
[54.163443, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/calendar.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    # Clamp only in the target month; callers retain the original anchor.\\n    day = min(anchor.day, days_in_month(year, month))')\r\n\u001b[?2004l\r\u001b[?2004h> "]
