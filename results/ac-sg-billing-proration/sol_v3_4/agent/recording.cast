[99.950725, "i", " 2, 28))\n\n    def test_bounds_around_month_end_and_annual_renewals(self):\n        for day in (28, 29, 30, 31):\n            anchor = date(2024, 1, day)\n            for interval, step in (('month', 1), ('year', 12)):\n                for k in range(1, 61):\n                    renewal = add_months(anchor, k * step)\n                    with self.subTest(anchor=anchor, interval=interval, renewal=renewal):\n                        self.assertEqual(cycle_bounds(anchor, renewal, interval),\n                                         (renewal, add_months(anchor, (k + 1) * step)))\n                        self.assertEqual(cycle_bounds(anchor, renewal - timedelta(days=1), interval),\n                                         (add_months(anchor, (k - 1) * step), renewal))\n\n    def test_actual_cycle_lengths(self):\n        self.assertEqual(cycle_length_days(date(2026, 1, 31), date(2026, 2, 1), 'month'), 28)\n        self.assertEqual(cycle_length_days(date(2026, 1, 31), date(2026, 3, 1), 'month'), 31)\n        self.assertEqual(cycle_"]
[99.950752, "i", "length_days(date(2024, 2, 29), date(2027, 11, 2), 'year'), 366)\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2028, 2, 28), 'year'),\n                         (date(2027, 2, 28), date(2028, 2, 29)))\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2028, 2, 29), 'year'),\n                         (date(2028, 2, 29), date(2029, 2, 28)))\n\n    def test_invalid_cycle_requests(self):\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 30), 'month')\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 31), 'week')\n\n\nclass ProrationRegressionTest(unittest.TestCase):\n    def test_rounding_is_exact_and_independent_of_decimal_context(self):\n        with localcontext() as ctx:\n            ctx.prec = 2\n            self.assertEqual(portion(10**40 + 1, 1, 2), 5 * 10**39)\n            self.assertEqual(portion(10**40 + 3, 1, 2), 5 * 10**39 + 2)\n            self.assertEqual(portion(5, 1, 3), 2)\n         "]
