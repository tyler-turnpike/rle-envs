[104.602762, "i", " interval), (start, end))\n                        self.assertEqual(cycle_length_days(anchor, start, interval),\n                                         (end - start).days)\n\n    def test_actual_cycle_lengths(self):\n        anchor = date(2026, 1, 31)\n        self.assertEqual(cycle_length_days(anchor, date(2026, 2, 15), \"month\"), 28)\n        self.assertEqual(cycle_length_days(anchor, date(2026, 3, 10), \"month\"), 31)\n        self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 11, 2), \"year\"), 366)\n\n    def test_century_leap_rules_and_backwards_months(self):\n        self.assertEqual(add_months(date(2096, 2, 29), 48), date(2100, 2, 28))\n        self.assertEqual(add_months(date(1996, 2, 29), 48), date(2000, 2, 29))\n        self.assertEqual(add_months(date(2028, 3, 31), -1), date(2028, 2, 29))\n        self.assertEqual(add_months(date(2028, 3, 31), 0), date(2028, 3, 31))\n\n\nclass ExactRoundingRegressionTest(unittest.TestCase):\n    def test_large_amounts_and_half_even_ties(self):\n        base = 10 ** 40\n   "]
