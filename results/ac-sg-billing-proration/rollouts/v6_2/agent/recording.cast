[105.603746, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\ncases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\nwith tempfile.TemporaryDirectory() as temp:\n    path = Path(temp) / 'subscriptions.json'\n    path.write_text(json.dumps({'subscriptions': [\n        {'id': c['id'], 'customer': 'cus_cli', 'plan': c['plan'], 'anchor': c['anchor']}\n        for c in cases\n    ]}))\n    for case in cases:\n        result = subprocess.run([sys.executable, '-m', 'billing', 'preview', '--sub', str(path),\n                                 '--id', case['id'], '--to', case['to'], '--at', case['at'],\n                                 '--json'], check=True, capture_output=True, text=True)\n        doc = json.loads(result.stdout)\n        expected = case['expected']\n        assert doc['subtotal'] == expected['total'], case['id']\n        assert [line['amount'] for line in doc['lines']] == [-expected['credit'], expected['charge']], case['id']\n        assert doc['lines']"]
[105.604028, "i", "[0]['period_end'] == expected['period_end'], case['id']\n        assert doc['lines'][1]['period_end'] == expected['next_renewal'], case['id']\n        assert doc['amount_due'] == max(0, expected['total']), case['id']\n        assert doc['credit_carried'] == max(0, -expected['total']), case['id']\nprint(f'CLI verified for all {len(cases)} finance worked examples')\nPY\n"]
[105.604075, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
