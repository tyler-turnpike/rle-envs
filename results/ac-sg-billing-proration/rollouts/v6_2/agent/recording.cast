[56.942547, "o", "> p = Path('billing/calendar.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    # Clamp only in short months; callers retain the original anchor.\\n    day = min(anchor.day, days_in_month(year, month))')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    start = anchor\\n    end = add_months(start, step)\\n    while end <= on:\\n        start = end\\n        end = add_months(start, step)\\n    return start, end', '    # Estimate the renewal index directly, then account for the day of month.\\n    # Both bounds must be derived from the original anchor to avoid drift.\\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\\n    cycle = elapsed_months // step\\n    start = add_months(anchor, cycle * step)\\n    if start > on:\\n        cycle -= 1\\n        start = add_months(anchor, cycle * step)\\n    end = add_months(anchor, (cycle + 1) * step)\\n    return start, end')\r"]
[56.942576, "o", "\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    if interval == \"year\":\\n        return 365\\n    return 30', '    start, end = cycle_bounds(anchor, on, interval)\\n    return (end - start).days')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('from decimal import ROUND_HALF_EVEN, Decimal\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('from .calendar import add_months, cycle_bounds, cycle_length_days, days_between', 'from .calendar import add_months, cycle_bounds, days_between')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.944375, "o", "s = s.replace('    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))', '    # Round the exact rational once, without Decimal context precision limits.\\n    whole, remainder = divmod(amount * numerator, denominator)\\n    if 2 * remainder > denominator or (2 * remainder == denominator and whole % 2):\\n        whole += 1\\n    return whole')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.944535, "o", "s = s.replace('    period_days = cycle_length_days(sub.anchor, change_at, old.interval)', '    period_days = days_between(start, end)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.944587, "o", "> "]
[56.945184, "o", "s = s.replace('    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\\n    new_anchor = sub.anchor\\n    next_renewal = end', '    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\\n    new_price = catalog.price(new.plan_id, change_at)\\n    if old.interval == new.interval:\\n        charge = portion(new_price, remaining, period_days)\\n        new_anchor = sub.anchor\\n        next_renewal = end\\n    else:\\n        charge = new_price\\n        new_anchor = change_at\\n        next_renewal = add_months(new_anchor, new.months)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
