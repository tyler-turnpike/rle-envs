[104.605258, "o", "\u001b[?2004l\r\u001b[?2004h> from billing.calendar import add_months, cycle_bounds, cycle_length_days\r\n\u001b[?2004l\r\u001b[?2004h> from billing.catalog import load_catalog\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import Subscription, portion, prorate_change, renewal_schedule\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> APP = Path(__file__).resolve().parent.parent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class CalendarRegressionTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_every_renewal_retains_original_anchor(self):\r\n\u001b[?2004l\r\u001b[?2004h>         for day in (28, 29, 30, 31):\r\n\u001b[?2004l\r\u001b[?2004h>             anchor = date(2024, 1, day)\r\n\u001b[?2004l\r\u001b[?2004h>             for interval, step in ((\"month\", 1), (\"year\", 12)):\r\n\u001b[?2004l\r\u001b[?2004h>                 for k in range(1, 61):\r\n\u001b[?2004l\r\u001b[?2004h>                     start = add_months(anchor, k * step)\r\n\u001b[?2004l\r\u001b[?2004h>                     end = add_months(anchor, (k + 1) * step)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.60553, "o", "                    with self.subTest(day=day, interval=interval, renewal=k):\r\n\u001b[?2004l\r\u001b[?2004h>                         self.assertEqual(cycle_bounds(anchor, start, interval), (start, end))\r\n\u001b[?2004l\r\u001b[?2004h>                         self.assertEqual(cycle_length_days(anchor, start, interval),\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.605544, "o", "> "]
[104.605635, "o", "                                         (end - start).days)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.605664, "o", "    def test_actual_cycle_lengths(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.605724, "o", "        anchor = date(2026, 1, 31)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.605912, "o", "        self.assertEqual(cycle_length_days(anchor, date(2026, 2, 15), \"month\"), 28)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_length_days(anchor, date(2026, 3, 10), \"month\"), 31)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.606004, "o", "        self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 11, 2), \"year\"), 366)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
