[67.829733, "o", "            {\r\n                \"kind\": line.kind,\r\n                \"plan\": line.plan_id,\r\n                \"amount\": line.amount,\r\n                \"period_start\": line.period_start.isoformat(),\r\n                \"period_end\": line.period_end.isoformat(),\r\n                \"description\": line.description,\r\n            }\r\n            for line in preview.lines\r\n        ],\r\n        \"subtotal\": preview.subtotal,\r\n        \"balance_before\": preview.balance_before,\r\n        \"amount_due\": preview.amount_due,\r\n        \"credit_carried\": preview.credit_carried,\r\n    }\r\n\r\n"]
[67.831119, "o", "\r\ndef render_text(preview: InvoicePreview) -> str:\r\n    out = [f\"Invoice preview for {preview.sub_id} ({preview.issued_on})\"]\r\n    for line in preview.lines:\r\n        out.append(f\"  {line.description:<60} {format_amount(line.amount, preview.currency):>16}\")\r\n    out.append(f\"  {'Subtotal':<60} {format_amount(preview.subtotal, preview.currency):>16}\")\r\n    if preview.balance_before:\r\n        out.append(f\"  {'Balance before':<60} {format_amount(preview.balance_before, preview.currency):>16}\")\r\n    out.append(f\"  {'Amount due':<60} {format_amount(preview.amount_due, preview.currency):>16}\")\r\n    if preview.credit_carried:\r\n        out.append(f\"  {'Credit carried forward':<60} {format_amount(preview.credit_carried, preview.currency):>16}\")\r\n    return \"\\n\".join(out)\r\n\r\n\r\ndef load_partner_rates(path: Path | str) -> Dict[str, Decimal]:\r\n    \"\"\"Commission rate per reseller partner, as contracted (data/partners.json).\"\"\"\r\n    with open(path, encoding=\"utf-8\") as fh:\r\n        doc = json.load(fh)\r\n    return {p[\"id\"]: "]
[67.83119, "o", "Decimal(p[\"commission_rate\"]) for p in doc[\"partners\"]}\r\n\r\n\r\ndef commission_line(preview: InvoicePreview, rate: Decimal, partner_id: str) -> Line:\r\n    \"\"\"Partner-channel invoices carry the reseller's commission as a credit line.\"\"\"\r\n    if not Decimal(0) <= rate < Decimal(1):\r\n        raise ValueError(f\"commission rate {rate} for {partner_id} out of range\")\r\n    amount = int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n    return Line(\"commission\", partner_id, -amount, preview.issued_on, preview.issued_on,\r\n                f\"Partner commission {partner_id} ({rate * 100:.1f}%)\")\r\n\u001b[?2004hroot@afa7d15e4c08:/app# "]
[67.941849, "i", "cat > tests/test_billing_regressions.py <<'PY'\n\"\"\"Additional coverage for BILL-212's calendar and exact-money rules.\"\"\"\nimport unittest\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.catalog import load_catalog\nfrom billing.invoice import build_preview\nfrom billing.proration import Subscription, portion, prorate_change, renewal_schedule\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        self.assertEqual(add_months(date(2028, 3, 31), 0), date(2028, 3, 31))\n        self.assertEqual(add_months(date(2028, 3, 31), -1), date(2028, 2, 29))\n        self.assertEqual(add_months(date(2026, 1, 31), -2), date(2025, 11, 30))\n\n    def test_gregorian_century_rules(self):\n        self.assertEqual(add_months(date(2096, 2, 29), 48), date(2100, 2, 28))\n        self.assertEqual(add_months(date"]
[67.942277, "i", "(1996, 2, 29), 48), date(2000, 2, 29))\n\n    def test_each_day_belongs_to_original_anchor_cycle(self):\n        for day in (29, 30, 31):\n            anchor = date(2024, 1, day)\n            for interval, months, count in ((\"month\", 1, 60), (\"year\", 12, 8)):\n                for k in range(count):\n                    start = add_months(anchor, months * k)\n                    end = add_months(anchor, months * (k + 1))\n                    on = start\n                    while on < end:\n                        with self.subTest(anchor=anchor, interval=interval, on=on):\n                            self.assertEqual(cycle_bounds(anchor, on, interval), (start, end))\n                        on += timedelta(days=1)\n\n    def test_cycle_length_is_actual_calendar_length(self):\n        self.assertEqual(cycle_length_days(date(2028, 1, 31), date(2028, 2, 1), \"month\"), 29)\n        self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 7, 1), \"year\"), 366)\n        with self.assertRaises(ValueError):\n            cycle_boun"]
