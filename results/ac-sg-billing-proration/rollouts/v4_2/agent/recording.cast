[94.129189, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_billing_regressions.py')\ns = p.read_text().replace('import unittest\\n', 'import json\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport unittest\\n')\ns += '''\n\nclass CliRegressionTest(unittest.TestCase):\n    def test_all_finance_examples_through_cli(self):\n        cases = json.loads((APP / \"tests\" / \"fixtures\" / \"plan_changes.json\").read_text())[\"cases\"]\n        with tempfile.TemporaryDirectory() as temp:\n            subscriptions = Path(temp) / \"subscriptions.json\"\n            subscriptions.write_text(json.dumps({\"subscriptions\": [\n                {\"id\": case[\"id\"], \"customer\": \"finance-example\", \"plan\": case[\"plan\"],\n                 \"anchor\": case[\"anchor\"], \"balance\": 0} for case in cases\n            ]}))\n            for case in cases:\n                with self.subTest(case=case[\"id\"]):\n                    result = subprocess.run(\n                        [sys.executable, \"-m\", \"billing\", \"preview\", \"--sub\", str(subscriptions),\n             "]
[94.129496, "i", "            \"--id\", case[\"id\"], \"--to\", case[\"to\"], \"--at\", case[\"at\"],\n                         \"--catalog\", str(APP / \"data\" / \"catalog.json\"), \"--json\"],\n                        cwd=APP, check=True, capture_output=True, text=True)\n                    doc = json.loads(result.stdout)\n                    exp = case[\"expected\"]\n                    self.assertEqual(doc[\"subtotal\"], exp[\"total\"])\n                    self.assertEqual(doc[\"amount_due\"], max(0, exp[\"total\"]))\n                    self.assertEqual(doc[\"credit_carried\"], max(0, -exp[\"total\"]))\n                    self.assertEqual([(line[\"kind\"], line[\"amount\"], line[\"period_start\"],\n                                       line[\"period_end\"]) for line in doc[\"lines\"]],\n                                     [(\"credit\", -exp[\"credit\"], case[\"at\"], exp[\"period_end\"]),\n                                      (\"charge\", exp[\"charge\"], case[\"at\"], exp[\"next_renewal\"])])\n'''\np.write_text(s)\nPY\npython -m unittest discover -s tests -p test_billing_regressions.py -v"]
