[97.543159, "i", "nds(anchor, start - timedelta(days=1), interval),\n                                     (add_months(anchor, (k - 1) * step), start))\n\n    def test_actual_cycle_lengths(self):\n        for anchor, on, interval, days in (\n            (date(2026, 1, 31), date(2026, 2, 15), 'month', 28),\n            (date(2028, 1, 31), date(2028, 2, 15), 'month', 29),\n            (date(2026, 3, 31), date(2026, 4, 15), 'month', 30),\n            (date(2026, 1, 31), date(2026, 3, 15), 'month', 31),\n            (date(2024, 2, 29), date(2026, 3, 1), 'year', 365),\n            (date(2024, 2, 29), date(2027, 3, 1), 'year', 366),\n        ):\n            with self.subTest(anchor=anchor, on=on):\n                self.assertEqual(cycle_length_days(anchor, on, interval), days)\n\n    def test_rejects_invalid_cycles(self):\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 30), 'month')\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 31), 'week')"]
[97.54317, "i", "\n\n\nclass ProrationRegressionTest(unittest.TestCase):\n    def test_rounding_is_exact_and_context_independent(self):\n        with localcontext() as context:\n            context.prec = 2\n            for amount in (1, 3, 5, 10**60 + 3, -(10**60 + 3)):\n                for numerator, denominator in ((0, 31), (1, 2), (15, 31), (31, 31)):\n                    with self.subTest(amount=amount, fraction=(numerator, denominator)):\n                        self.assertEqual(portion(amount, numerator, denominator),\n                                         round(Fraction(amount * numerator, denominator)))\n        for numerator, denominator in ((-1, 2), (3, 2), (0, 0), (0, -1)):\n            with self.assertRaises(ValueError):\n                portion(100, numerator, denominator)\n\n    def test_credit_uses_billed_price_and_charge_uses_current_price(self):\n        catalog = Catalog({\n            'old': Plan('old', 'Old', 'month', 'USD',\n                        ((date(2026, 1, 1), 3100), (date(2026, 1, 15), 6200))),\n            'new"]
[97.543433, "i", "': Plan('new', 'New', 'month', 'USD',\n                        ((date(2026, 1, 1), 6200), (date(2026, 1, 15), 9300))),\n        })\n        anchor = date(2026, 1, 1)\n        pr = prorate_change(Subscription('s', 'c', 'old', anchor), 'new', date(2026, 1, 16), catalog)\n        self.assertEqual((pr.credit, pr.charge, pr.total), (1600, 4800, 3200))\n        self.assertEqual((pr.new_anchor, pr.next_renewal), (anchor, date(2026, 2, 1)))\n\n    def test_interval_changes_bill_full_cycle_and_keep_new_anchor(self):\n        catalog = Catalog({\n            'monthly': Plan('monthly', 'Monthly', 'month', 'USD', ((date(2020, 1, 1), 3100),)),\n            'annual': Plan('annual', 'Annual', 'year', 'USD', ((date(2020, 1, 1), 31000),)),\n        })\n        for old, new, anchor, at, renewals in (\n            ('annual', 'monthly', date(2025, 6, 30), date(2026, 1, 31),\n             [date(2026, 2, 28), date(2026, 3, 31), date(2026, 4, 30), date(2026, 5, 31)]),\n            ('monthly', 'annual', date(2024, 1, 31), date(2024, 2, 29),\n       "]
