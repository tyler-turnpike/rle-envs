[97.543547, "i", "ertEqual(invoice['subtotal'], expected['total'])\n                    self.assertEqual(invoice['amount_due'], max(0, expected['total']))\n                    self.assertEqual(invoice['credit_carried'], max(0, -expected['total']))\n                    self.assertEqual([(line['kind'], line['amount'], line['period_start'], line['period_end'])\n                                      for line in invoice['lines']],\n                                     [('credit', -expected['credit'], case['at'], expected['period_end']),\n                                      ('charge', expected['charge'], case['at'], expected['next_renewal'])])\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest discover -s tests > /tmp/bill212-tests.log 2>&1; tail -20 /tmp/bill212-tests.log\n"]
