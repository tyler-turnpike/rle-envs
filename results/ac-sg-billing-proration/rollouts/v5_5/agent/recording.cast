[97.542896, "i", "cat > tests/test_bill212.py <<'PY'\n\"\"\"Regression coverage for finance's rev. 4 proration rules (BILL-212).\"\"\"\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom fractions import Fraction\nfrom pathlib import Path\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.catalog import Catalog, Plan\nfrom billing.proration import Subscription, portion, prorate_change, renewal_schedule\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_clamps_only_to_target_month_end(self):\n        for year, feb_day in ((2026, 28), (2028, 29)):\n            for day in (28, 29, 30, 31):\n                anchor = date(year, 1, day)\n                with self.subTest(anchor=anchor):\n                    self.assertEqual(add_months(anchor, 0), anchor)\n                    self.assertEqual(add_months(anchor, 1), date(year, 2, min(day, feb_day)))\n            "]
[97.543138, "i", "        self.assertEqual(add_months(anchor, 2), date(year, 3, day))\n                    self.assertEqual(add_months(anchor, 3), date(year, 4, min(day, 30)))\n                    self.assertEqual(add_months(anchor, -1), date(year - 1, 12, day))\n        self.assertEqual(add_months(date(2026, 2, 28), 1), date(2026, 3, 28))\n\n    def test_half_open_boundaries_retain_original_anchor(self):\n        for anchor, interval, step in ((date(2024, 1, 31), 'month', 1),\n                                       (date(2024, 2, 29), 'year', 12)):\n            for k in range(1, 60):\n                start = add_months(anchor, k * step)\n                end = add_months(anchor, (k + 1) * step)\n                with self.subTest(interval=interval, start=start):\n                    self.assertEqual(cycle_bounds(anchor, start, interval), (start, end))\n                    self.assertEqual(cycle_bounds(anchor, end - timedelta(days=1), interval),\n                                     (start, end))\n                    self.assertEqual(cycle_bou"]
