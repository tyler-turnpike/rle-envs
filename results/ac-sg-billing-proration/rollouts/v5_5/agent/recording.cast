[22.29368, "o", "import unittest\r\nfrom datetime import date\r\n\r\nfrom billing.calendar import add_months, cycle_bounds, days_in_month, iter_cycles\r\n\r\n\r\nclass AddMonthsTest(unittest.TestCase):\r\n    def test_mid_month_anchor(self):\r\n        self.assertEqual(add_months(date(2025, 3, 14), 1), date(2025, 4, 14))\r\n        self.assertEqual(add_months(date(2025, 3, 14), 10), date(2026, 1, 14))\r\n\r\n    def test_year_rollover(self):\r\n        self.assertEqual(add_months(date(2025, 11, 5), 3), date(2026, 2, 5))\r\n        self.assertEqual(add_months(date(2025, 12, 1), 12), date(2026, 12, 1))\r\n\r\n    def test_month_end_anchor_clamps_then_returns(self):\r\n        anchor = date(2026, 1, 31)\r\n        got = [add_months(anchor, k) for k in range(1, 5)]\r\n        self.assertEqual(got, [date(2026, 2, 28), date(2026, 3, 31),\r\n                               date(2026, 4, 30), date(2026, 5, 31)])\r\n\r\n    def test_leap_years(self):\r\n        self.assertEqual(add_months(date(2028, 1, 30), 1), date(2028, 2, 29))\r\n        anchor = date(2024, 2, 29)\r\n        got "]
[22.29371, "o", "= [add_months(anchor, 12 * k) for k in range(1, 5)]\r\n        self.assertEqual(got, [date(2025, 2, 28), date(2026, 2, 28),\r\n                               date(2027, 2, 28), date(2028, 2, 29)])\r\n\r\n    def test_days_in_month(self):\r\n        self.assertEqual(days_in_month(2026, 2), 28)\r\n        self.assertEqual(days_in_month(2028, 2), 29)\r\n\r\n\r\nclass CycleBoundsTest(unittest.TestCase):\r\n    def test_mid_month(self):\r\n        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 20), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\r\n\r\n    def test_change_on_renewal_day_starts_new_cycle(self):\r\n        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 14), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\r\n\r\n    def test_month_end_anchor(self):\r\n        anchor = date(2024, 1, 31)\r\n        self.assertEqual(cycle_bounds(anchor, date(2026, 2, 15), \"month\"),\r\n                         (date(2026, 1, 31), date(2026, 2, 28)))\r\n        self.assertEq"]
[22.293729, "o", "ual(cycle_bounds(anchor, date(2026, 3, 10), \"month\"),\r\n                         (date(2026, 2, 28), date(2026, 3, 31)))\r\n\r\n    def test_annual(self):\r\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2027, 11, 2), \"year\"),\r\n                         (date(2027, 2, 28), date(2028, 2, 29)))\r\n\r\n    def test_iter_cycles_is_contiguous(self):\r\n        cycles = list(iter_cycles(date(2026, 1, 31), date(2026, 6, 1), \"month\"))\r\n        self.assertEqual(cycles[0][0], date(2026, 1, 31))\r\n        for (s1, e1), (s2, _) in zip(cycles, cycles[1:]):\r\n            self.assertEqual(e1, s2)\r\n        self.assertEqual(cycles[-1], (date(2026, 5, 31), date(2026, 6, 30)))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\nimport io\r\nimport json\r\nimport unittest\r\nfrom contextlib import redirect_stdout\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom pathlib import Path\r\n\r\nfrom billing import __main__ as cli\r\nfrom billing.catalog import load_catalog\r\nfrom billing.invoice import build_preview,"]
[22.293733, "o", " commission_line, format_amount, load_partner_rates, to_dict\r\nfrom billing.proration import Subscription, portion, prorate_change\r\n\r\nHERE = Path(__file__).resolve().parent\r\nAPP = HERE.parent\r\nCASES = json.loads((HERE / \"fixtures\" / \"plan_changes.json\").read_text())[\"cases\"]\r\n\r\n\r\nclass WorkedExamplesTest(unittest.TestCase):\r\n    \"\"\"Finance's worked examples (docs/proration.md, rev. 4).\"\"\"\r\n\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_worked_examples(self):\r\n        for case in CASES:\r\n            with self.subTest(case=case[\"id\"]):\r\n                sub = Subscription(\"sub_x\", \"cus_x\", case[\"plan\"], date.fromisoformat(case[\"anchor\"]))\r\n                got = prorate_change(sub, case[\"to\"], date.fromisoformat(case[\"at\"]), self.catalog)\r\n                exp = case[\"expected\"]\r\n                self.assertEqual((got.period_start.isoformat(), got.period_end.isoformat()),\r\n                                 (exp[\"period_start\"], exp[\"period_end\"]))\r\n         "]
[22.293737, "o", "       self.assertEqual(got.credit, exp[\"credit\"])\r\n                self.assertEqual(got.charge, exp[\"charge\"])\r\n                self.assertEqual(got.total, exp[\"total\"])\r\n                self.assertEqual(got.new_anchor.isoformat(), exp[\"new_anchor\"])\r\n                self.assertEqual(got.next_renewal.isoformat(), exp[\"next_renewal\"])\r\n\r\n\r\nclass PortionTest(unittest.TestCase):\r\n    def test_half_even(self):\r\n        self.assertEqual(portion(1, 1, 2), 0)\r\n        self.assertEqual(portion(3, 1, 2), 2)\r\n        self.assertEqual(portion(4900, 15, 28), 2625)\r\n\r\n    def test_rejects_bad_fraction(self):\r\n        with self.assertRaises(ValueError):\r\n            portion(100, 5, 4)\r\n\r\n\r\nclass InvoiceTest(unittest.TestCase):\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_downgrade_carries_credit(self):\r\n        sub = Subscription(\"sub_9\", \"cus_9\", \"team-monthly\", date(2025, 3, 14))\r\n        pr = prorate_change(sub, \"starter-monthly\", date(2026, 6, 20), self.cat"]
