[58.290419, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Additional BILL-212 coverage for calendar, rounding, and CLI invoices.\"\"\"\nimport json\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.proration import portion\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -13), date(2027, 2, 28))\n\n    def test_each_renewal_starts_a_cycle_without_anchor_drift(self):\n        for anchor, step, interval in [\n            (date(2026, 1, 29), 1, 'month'),\n            (date(2028, 1, 30), 1, 'month'),\n            (date(2026, 1, 31), 1, 'month'),\n      "]
[58.290837, "i", "      (date(2024, 2, 29), 12, 'year'),\n            (date(2096, 2, 29), 12, 'year'),\n        ]:\n            for k in range(1, 50):\n                with self.subTest(anchor=anchor, k=k):\n                    previous = add_months(anchor, (k - 1) * step)\n                    renewal = add_months(anchor, k * step)\n                    following = add_months(anchor, (k + 1) * step)\n                    self.assertEqual(cycle_bounds(anchor, renewal, interval),\n                                     (renewal, following))\n                    self.assertEqual(cycle_bounds(anchor, renewal - timedelta(days=1), interval),\n                                     (previous, renewal))\n\n    def test_actual_cycle_lengths(self):\n        for anchor, interval, days in [\n            (date(2026, 1, 31), 'month', 28),\n            (date(2028, 1, 31), 'month', 29),\n            (date(2026, 4, 30), 'month', 30),\n            (date(2026, 2, 28), 'month', 28),\n            (date(2026, 3, 31), 'month', 30),\n            (date(2026, 7, 31), 'month', 3"]
[58.290897, "o", "cat > tests/test_regressions.py <<'PY'\r\n\u001b[?2004l\r"]
