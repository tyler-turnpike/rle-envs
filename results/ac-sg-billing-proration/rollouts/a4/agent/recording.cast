[58.29807, "o", "> "]
[58.298125, "o", "    def test_large_values_and_decimal_context_do_not_affect_rounding(self):\r\n\u001b[?2004l\r"]
[58.298952, "o", "\u001b[?2004h>         with localcontext() as context:\r\n\u001b[?2004l\r\u001b[?2004h>             context.prec = 2\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(portion(10**40 + 1, 1, 2), 5 * 10**39)\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(portion(10**40 + 3, 1, 2), 5 * 10**39 + 2)\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(portion(5, 1, 3), 2)\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(portion(-3, 1, 2), -2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class PreviewRegressionTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_cli_invoices_match_all_finance_examples(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
