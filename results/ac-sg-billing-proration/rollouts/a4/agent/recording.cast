[37.589441, "o", "s = s.replace('    start = anchor\\n    end = add_months(start, step)\\n    while end <= on:\\n        start = end\\n        end = add_months(start, step)', '    # Estimate the renewal index, then account for dates before the renewal\\n    # day. Always calculate from the original anchor to avoid short-month drift.\\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\\n    k = elapsed_months // step\\n    start = add_months(anchor, k * step)\\n    if start > on:\\n        k -= 1\\n        start = add_months(anchor, k * step)\\n    end = add_months(anchor, (k + 1) * step)')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    if interval == \"year\":\\n        return 365\\n    return 30', '    \"\"\"Return the actual number of days in the cycle containing ``on``.\"\"\"\\n    start, end = cycle_bounds(anchor, on, interval)\\n    return (end - start).days')\r\n\u001b[?2004l\r"]
