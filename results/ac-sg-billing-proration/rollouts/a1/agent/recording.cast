[100.530909, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\ncases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\nwith tempfile.TemporaryDirectory() as directory:\n    subscriptions = Path(directory) / 'subscriptions.json'\n    subscriptions.write_text(json.dumps({'subscriptions': [\n        {'id': case['id'], 'customer': case['id'], 'plan': case['plan'],\n         'anchor': case['anchor'], 'balance': 0} for case in cases\n    ]}))\n    for case in cases:\n        result = subprocess.run([\n            sys.executable, '-m', 'billing', 'preview', '--sub', str(subscriptions),\n            '--id', case['id'], '--to', case['to'], '--at', case['at'], '--json',\n        ], check=True, capture_output=True, text=True)\n        invoice = json.loads(result.stdout)\n        expected = case['expected']\n        credit, charge = invoice['lines']\n        assert credit['amount'] == -expected['credit'], case['id']\n        assert charge['amount'] == expected['charge'], cas"]
[100.531008, "i", "e['id']\n        assert credit['period_start'] == charge['period_start'] == case['at'], case['id']\n        assert credit['period_end'] == expected['period_end'], case['id']\n        assert charge['period_end'] == expected['next_renewal'], case['id']\n        assert invoice['subtotal'] == expected['total'], case['id']\n        assert invoice['amount_due'] == max(0, expected['total']), case['id']\n        assert invoice['credit_carried'] == max(0, -expected['total']), case['id']\n        print('CLI OK:', case['id'])\nprint(f'All {len(cases)} worked-example CLI previews verified.')\nPY\npython -m unittest discover -s tests\n"]
[100.531022, "o", "python - <<'PY'"]
[100.531411, "o", "\r\n\u001b[?2004l\r"]
[100.531556, "o", "\u001b[?2004h> "]
[100.531884, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.532025, "o", "import subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.533928, "o", "> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.535834, "o", "import tempfile"]
[100.535859, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> cases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\r\n\u001b[?2004l\r\u001b[?2004h> with tempfile.TemporaryDirectory() as directory:\r\n\u001b[?2004l\r\u001b[?2004h>     subscriptions = Path(directory) / 'subscriptions.json'\r\n\u001b[?2004l\r\u001b[?2004h>     subscriptions.write_text(json.dumps({'subscriptions': [\r\n\u001b[?2004l\r\u001b[?2004h>         {'id': case['id'], 'customer': case['id'], 'plan': case['plan'],\r\n\u001b[?2004l\r\u001b[?2004h>          'anchor': case['anchor'], 'balance': 0} for case in cases\r\n\u001b[?2004l\r\u001b[?2004h>     ]}))\r\n\u001b[?2004l\r\u001b[?2004h>     for case in cases:\r\n\u001b[?2004l\r\u001b[?2004h>         result = subprocess.run([\r\n\u001b[?2004l\r\u001b[?2004h>             sys.executable, '-m', 'billing', 'preview', '--sub', str(subscriptions),\r\n\u001b[?2004l\r\u001b[?2004h>             '--id', case['id'], '--to', case['to'], '--at', case['at'], '--json',\r\n\u001b[?2004l\r\u001b[?2004h>         ], check=True, capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h>         invoice = j"]
[100.536041, "o", "son.loads(result.stdout)\r\n\u001b[?2004l\r\u001b[?2004h>         expected = case['expected']\r\n\u001b[?2004l\r\u001b[?2004h>         credit, charge = invoice['lines']\r\n\u001b[?2004l\r\u001b[?2004h>         assert credit['amount'] == -expected['credit'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert charge['amount'] == expected['charge'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert credit['period_start'] == charge['period_start'] == case['at'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert credit['period_end'] == expected['period_end'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert charge['period_end'] == expected['next_renewal'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert invoice['subtotal'] == expected['total'], case['id']\r\n\u001b[?2004l\r\u001b[?2004h>         assert invoice['amount_due'] == max(0, expected['total']), case['id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.536149, "o", "        assert invoice['credit_carried'] == max(0, -expected['total']), case['id']"]
[100.536209, "o", "\r\n\u001b[?2004l\r"]
[100.536258, "o", "\u001b[?2004h"]
[100.536743, "o", ">         print('CLI OK:', case['id'])\r\n\u001b[?2004l\r\u001b[?2004h> print(f'All {len(cases)} worked-example CLI previews verified.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
