[43.074425, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/calendar.py')\ns = p.read_text()\ns = s.replace('    \"\"\"Move ``anchor`` forward by ``months`` calendar months.\"\"\"', '    \"\"\"Move by calendar months, clamping only to the target month\\'s last day.\"\"\"')\ns = s.replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    day = min(anchor.day, days_in_month(year, month))')\ns = s.replace('    start = anchor\\n    end = add_months(start, step)\\n    while end <= on:\\n        start = end\\n        end = add_months(start, step)\\n    return start, end', '''    # Estimate the renewal index by month, then account for dates before that\n    # month's renewal. Always offset the original anchor to avoid clamp drift.\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\n    k = elapsed_months // step\n    start = add_months(anchor, k * step)\n    if start > on:\n        k -= 1\n        start = add_months(anchor, k * step)\n    end = add_mon"]
