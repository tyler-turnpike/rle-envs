[50.954677, "o", "\"\"\"Billing-cycle calendar arithmetic.\r\n\r\nSubscriptions bill on an *anchor* date. Monthly plans renew every month on the\r\nanchor's day of month, annual plans every twelve months. See\r\ndocs/proration.md for the rules finance signed off on.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar as _stdcal\r\nfrom datetime import date, timedelta\r\nfrom typing import Iterator, Tuple\r\n\r\nINTERVAL_MONTHS = {\"month\": 1, \"year\": 12}\r\n\r\n\r\ndef interval_months(interval: str) -> int:\r\n    try:\r\n        return INTERVAL_MONTHS[interval]\r\n    except KeyError:\r\n        raise ValueError(f\"unknown billing interval: {interval!r}\") from None\r\n\r\n\r\ndef days_in_month(year: int, month: int) -> int:\r\n    return _stdcal.monthrange(year, month)[1]\r\n\r\n\r\ndef is_leap(year: int) -> bool:\r\n    return _stdcal.isleap(year)\r\n\r\n\r\ndef add_months(anchor: date, months: int) -> date:\r\n    \"\"\"Move by calendar months, clamping only to the target month's last day.\"\"\"\r\n    total = anchor.month - 1 + months\r\n    year = anchor.year + total // 12\r\n    mon"]
[50.95492, "o", "th = total % 12 + 1\r\n    day = min(anchor.day, days_in_month(year, month))\r\n    return date(year, month, day)\r\n\r\n\r\ndef cycle_bounds(anchor: date, on: date, interval: str) -> Tuple[date, date]:\r\n    \"\"\"Return ``(start, end)`` of the billing cycle containing ``on``.\r\n\r\n    ``start`` is inclusive and ``end`` is exclusive (the next renewal date).\r\n    \"\"\"\r\n    if on < anchor:\r\n        raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n    step = interval_months(interval)\r\n    # Estimate the renewal index by month, then account for dates before that\r\n    # month's renewal. Always offset the original anchor to avoid clamp drift.\r\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\r\n    k = elapsed_months // step\r\n    start = add_months(anchor, k * step)\r\n    if start > on:\r\n        k -= 1\r\n        start = add_months(anchor, k * step)\r\n    end = add_months(anchor, (k + 1) * step)\r\n    return start, end\r\n\r\n\r\ndef cycle_length_days(anchor: date, on: date, interval: str) -> int"]
[50.955411, "o", ":\r\n    start, end = cycle_bounds(anchor, on, interval)\r\n    return (end - start).days\r\n\r\n\r\ndef iter_cycles(anchor: date, until: date, interval: str) -> Iterator[Tuple[date, date]]:\r\n    \"\"\"Yield every cycle from the anchor up to and including the one containing ``until``.\"\"\"\r\n    start, end = cycle_bounds(anchor, anchor, interval)\r\n    while start <= until:\r\n        yield start, end\r\n        start, end = cycle_bounds(anchor, end, interval)\r\n\r\n\r\ndef days_between(a: date, b: date) -> int:\r\n    return (b - a).days\r\n\r\n\r\ndef parse_date(text: str) -> date:\r\n    return date.fromisoformat(text)\r\n\r\n\r\ndef end_of_day(d: date) -> date:\r\n    return d + timedelta(days=1)\r\n\"\"\"Mid-cycle plan changes.\r\n\r\nWhen a customer switches plan part-way through a billing cycle we credit the\r\nunused part of what they already paid for and charge for the new plan. The\r\nrules are in docs/proration.md.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom typing import List\r\n\r\nf"]
[50.955484, "o", "rom .calendar import add_months, cycle_bounds, cycle_length_days, days_between\r\nfrom .catalog import Catalog\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Subscription:\r\n    sub_id: str\r\n    customer: str\r\n    plan_id: str\r\n    anchor: date\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Line:\r\n    kind: str          # \"credit\" or \"charge\"\r\n    plan_id: str\r\n    amount: int        # minor units; credits are negative\r\n    period_start: date\r\n    period_end: date\r\n    description: str\r\n\r\n\r\n@dataclass\r\nclass Proration:\r\n    sub_id: str\r\n    change_at: date\r\n    period_start: date\r\n    period_end: date\r\n    credit: int        # positive number of minor units credited back\r\n    charge: int        # minor units charged for the new plan\r\n    new_anchor: date\r\n    next_renewal: date\r\n    lines: List[Line] = field(default_factory=list)\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.charge - self.credit\r\n\r\n\r\ndef portion(amount: int, numerator: int, denominator: int) -> int:\r\n    \"\"\"``amount * numerator / denominator`` ro"]
[50.955528, "o", "unded half-to-even to a whole minor unit.\"\"\"\r\n    if denominator <= 0:\r\n        raise ValueError(\"denominator must be positive\")\r\n    if not 0 <= numerator <= denominator:\r\n        raise ValueError(f\"fraction {numerator}/{denominator} out of range\")\r\n    # Round the exact rational once, independent of Decimal/float precision.\r\n    whole, remainder = divmod(amount * numerator, denominator)\r\n    if 2 * remainder > denominator or (2 * remainder == denominator and whole % 2):\r\n        whole += 1\r\n    return whole\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_id: str, change_at: date,\r\n                   catalog: Catalog) -> Proration:\r\n    \"\"\"Compute the credit and charge for moving ``sub`` to ``new_plan_id`` on ``change_at``.\"\"\"\r\n    if new_plan_id == sub.plan_id:\r\n        raise ValueError(\"subscription is already on that plan\")\r\n    old = catalog.plan(sub.plan_id)\r\n    new = catalog.plan(new_plan_id)\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"cross-currency plan changes are not suppo"]
[50.955534, "o", "rted\")\r\n\r\n    start, end = cycle_bounds(sub.anchor, change_at, old.interval)\r\n    period_days = cycle_length_days(sub.anchor, change_at, old.interval)\r\n    remaining = days_between(change_at, end)\r\n\r\n    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\r\n    new_price = catalog.price(new.plan_id, change_at)\r\n    if old.interval == new.interval:\r\n        charge = portion(new_price, remaining, period_days)\r\n        new_anchor = sub.anchor\r\n        next_renewal = end\r\n        charge_description = \"Remaining time\"\r\n    else:\r\n        charge = new_price\r\n        new_anchor = change_at\r\n        next_renewal = add_months(new_anchor, new.months)\r\n        charge_description = \"Full cycle\"\r\n\r\n    lines = [\r\n        Line(\"credit\", old.plan_id, -credit, change_at, end,\r\n             f\"Unused time on {old.name} ({change_at} to {end})\"),\r\n        Line(\"charge\", new.plan_id, charge, change_at, next_renewal,\r\n             f\"{charge_description} on {new.name} ({change_at} to {next_renewal})\"),\r\n    ]"]
[50.955539, "o", "\r\n    return Proration(sub.sub_id, change_at, start, end, credit, charge,\r\n                     new_anchor, next_renewal, lines)\r\n\r\n\r\n"]
[50.955677, "o", "def renewal_after(sub: Subscription, on: date, catalog: Catalog) -> date:\r\n    \"\"\"Next renewal date strictly after ``on`` for an unchanged subscription.\"\"\"\r\n    plan = catalog.plan(sub.plan_id)\r\n    _, end = cycle_bounds(sub.anchor, on, plan.interval)\r\n    return end\r\n\r\n\r\ndef renewal_schedule(sub: Subscription, count: int, catalog: Catalog) -> List[date]:\r\n    plan = catalog.plan(sub.plan_id)\r\n    return [add_months(sub.anchor, plan.months * k) for k in range(1, count + 1)]\r\n\u001b[?2004hroot@712ec5551b16:/app# "]
[83.873636, "i", "cat > tests/test_proration_regressions.py <<'PY'\n\"\"\"Regression coverage for the rev. 4 calendar and proration rules.\"\"\"\nimport calendar\nimport unittest\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom fractions import Fraction\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.catalog import Catalog, Plan\nfrom billing.invoice import build_preview\nfrom billing.proration import Subscription, portion, prorate_change\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_all_anchor_days_keep_original_renewal_day(self):\n        # Include ordinary/leap years and a non-leap century. Check both sides\n        # of renewals, including the renewal itself (a half-open boundary).\n        for year in (2023, 2024, 2027, 2028, 2096):\n            for month in range(1, 13):\n                for day in range(28, calendar.monthrange(year, month)[1] + 1):\n                    anchor = date(year, month, day)\n                    for interval, step in ((\"month\", 1)"]
[83.873684, "o", "cat > tests/test_proration_regressions.py <<'PY'"]
[83.874193, "i", ", (\"year\", 12)):\n                        renewals = []\n                        for k in range(7):\n                            y, m = divmod(year * 12 + month - 1 + k * step, 12)\n                            m += 1\n                            renewals.append(date(y, m, min(day, calendar.monthrange(y, m)[1])))\n                        for start, end in zip(renewals, renewals[1:]):\n                            for on in (start, start + timedelta(days=1), end - timedelta(days=1)):\n                                with self.subTest(anchor=anchor, interval=interval, on=on):\n                                    self.assertEqual(cycle_bounds(anchor, on, interval), (start, end))\n                                    self.assertEqual(cycle_length_days(anchor, on, interval), (end - start).days)\n\n    def test_add_months_zero_and_negative_offsets(self):\n        self.assertEqual(add_months(date(2028, 3, 31), 0), date(2028, 3, 31))\n        self.assertEqual(add_months(date(2028, 3, 31), -1), date(2028, 2, 29))\n        self.assertEq"]
[83.874824, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Regression coverage for the rev. 4 calendar and proration rules.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import calendar\r\n\u001b[?2004l\r\u001b[?2004h> import unittest\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date, timedelta\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import localcontext\r\n\u001b[?2004l\r\u001b[?2004h> from fractions import Fraction\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing.calendar import add_months, cycle_bounds, cycle_length_days\r\n\u001b[?2004l\r\u001b[?2004h> from billing.catalog import Catalog, Plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.invoice import build_preview\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import Subscription, portion, prorate_change\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class CalendarRegressionTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_all_anchor_days_keep_original_renewal_day(self):\r\n\u001b[?2004l\r\u001b[?2004h>         # Include ordinary/leap years and a non-leap century. Check both sides\r\n\u001b[?2004l\r\u001b[?2004h>         # of renewals, including the renewal itself (a half-o"]
