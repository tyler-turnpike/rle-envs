[56.934841, "o", "\"\"\"Plan catalog: plan definitions and their price history.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom pathlib import Path\r\nfrom typing import Dict, List, Tuple\r\n\r\nfrom .calendar import interval_months, parse_date\r\n\r\nDEFAULT_CATALOG = Path(__file__).resolve().parent.parent / \"data\" / \"catalog.json\"\r\n\r\n\r\n"]
[56.934965, "o", "@dataclass(frozen=True)\r\nclass Plan:\r\n    plan_id: str\r\n    name: str\r\n    interval: str\r\n    currency: str\r\n    # (effective_from, unit price in minor units), sorted by date\r\n    prices: Tuple[Tuple[date, int], ...] = field(default_factory=tuple)\r\n\r\n    @property\r\n    def months(self) -> int:\r\n        return interval_months(self.interval)\r\n\r\n    def price_on(self, on: date) -> int:\r\n        \"\"\"Price in force on ``on`` (the latest entry whose start is <= on).\"\"\"\r\n        current = None\r\n        for start, cents in self.prices:\r\n            if start <= on:\r\n                current = cents\r\n            else:\r\n                break\r\n        if current is None:\r\n            raise LookupError(f\"plan {self.plan_id} has no price on {on}\")\r\n        return current\r\n\r\n\r\n"]
[56.935072, "o", "\u001b[?2004h"]
[56.935145, "o", "root@4c86fc2caa80:/app# "]
[57.054189, "i", "sed -n '41,90p' billing/catalog.py\n"]
[57.054404, "o", "sed -n '41,90p' billing/catalog.py\r\n"]
[57.054442, "o", "\u001b[?2004l\r"]
[57.055835, "o", "class Catalog:\r\n    def __init__(self, plans: Dict[str, Plan]):\r\n        self._plans = dict(plans)\r\n\r\n    def plan(self, plan_id: str) -> Plan:\r\n        try:\r\n            return self._plans[plan_id]\r\n        except KeyError:\r\n            raise KeyError(f\"unknown plan: {plan_id}\") from None\r\n\r\n    def price(self, plan_id: str, on: date) -> int:\r\n        return self.plan(plan_id).price_on(on)\r\n\r\n    def plan_ids(self) -> List[str]:\r\n        return sorted(self._plans)\r\n\r\n    def __contains__(self, plan_id: str) -> bool:\r\n        return plan_id in self._plans\r\n\r\n\r\ndef _plan_from_dict(raw: dict) -> Plan:\r\n    history = sorted(\r\n        (parse_date(p[\"effective_from\"]), int(p[\"unit_amount\"])) for p in raw[\"prices\"]\r\n    )\r\n    if not history:\r\n        raise ValueError(f\"plan {raw['id']} has an empty price history\")\r\n    if raw[\"interval\"] not in (\"month\", \"year\"):\r\n        raise ValueError(f\"plan {raw['id']} has unknown interval {raw['interval']!r}\")\r\n    return Plan(\r\n        plan_id=raw[\"id\"],"]
[57.055883, "o", "\r\n        name=raw.get(\"name\", raw[\"id\"]),\r\n        interval=raw[\"interval\"],\r\n        currency=raw.get(\"currency\", \"USD\"),\r\n        prices=tuple(history),\r\n    )\r\n\r\n\r\ndef load_catalog(path: Path | str = DEFAULT_CATALOG) -> Catalog:\r\n    with open(path, encoding=\"utf-8\") as fh:\r\n        doc = json.load(fh)\r\n    plans = {}\r\n    for raw in doc[\"plans\"]:\r\n        plan = _plan_from_dict(raw)\r\n        if plan.plan_id in plans:\r\n            raise ValueError(f\"duplicate plan id {plan.plan_id}\")\r\n        plans[plan.plan_id] = plan\r\n    return Catalog(plans)\r\n\u001b[?2004hroot@4c86fc2caa80:/app# "]
[66.494652, "i", "cp billing/calendar.py /tmp/bill212-calendar.py && cp billing/proration.py /tmp/bill212-proration.py\npython - <<'PY'\nfrom pathlib import Path\np = Path('billing/calendar.py')\ns = p.read_text().replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    # Clamp only in the target month; callers retain the original anchor.\\n    day = min(anchor.day, days_in_month(year, month))')\ns = s.replace('    start = anchor\\n    end = add_months(start, step)\\n    while end <= on:\\n        start = end\\n        end = add_months(start, step)\\n    return start, end', '    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\\n    cycle = elapsed_months // step\\n    start = add_months(anchor, cycle * step)\\n    if start > on:\\n        cycle -= 1\\n        start = add_months(anchor, cycle * step)\\n    end = add_months(anchor, (cycle + 1) * step)\\n    return start, end')\ns = s.replace('    if interval == \"year\":\\n        return 365\\n    return 30'"]
[66.495008, "i", ", '    start, end = cycle_bounds(anchor, on, interval)\\n    return (end - start).days')\np.write_text(s)\np = Path('billing/proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_EVEN, Decimal\\n', '')\ns = s.replace('    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))', '    # Integer arithmetic avoids intermediate rounding and Decimal context limits.\\n    quotient, remainder = divmod(amount * numerator, denominator)\\n    twice_remainder = 2 * remainder\\n    if twice_remainder > denominator or (twice_remainder == denominator and quotient % 2):\\n        quotient += 1\\n    return quotient')\ns = s.replace('    period_days = cycle_length_days(sub.anchor, change_at, old.interval)', '    period_days = days_between(start, end)')\ns = s.replace('    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\\n  "]
