[109.534297, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom datetime import date\nfrom pathlib import Path\nfrom billing.catalog import load_catalog\nfrom billing.proration import Subscription, prorate_change\n\ncases = json.loads(Path('tests/fixtures/plan_changes.json').read_text())['cases']\nwith tempfile.TemporaryDirectory() as directory:\n    path = Path(directory) / 'subscriptions.json'\n    path.write_text(json.dumps({'subscriptions': [dict(id=c['id'], customer='cus_verify', plan=c['plan'], anchor=c['anchor']) for c in cases]}))\n    for c in cases:\n        args = [sys.executable, '-m', 'billing', 'preview', '--sub', str(path), '--id', c['id'], '--to', c['to'], '--at', c['at']]\n        result = subprocess.run(args + ['--json'], check=True, capture_output=True, text=True)\n        invoice = json.loads(result.stdout)\n        expected = c['expected']\n        assert invoice['subtotal'] == expected['total'], c['id']\n        assert invoice['amount_due'] == max(0, expected['total']), c['id'"]
[109.534482, "i", "]\n        assert invoice['credit_carried'] == max(0, -expected['total']), c['id']\n        assert [line['amount'] for line in invoice['lines']] == [-expected['credit'], expected['charge']], c['id']\n        if c['id'] == 'annual-to-monthly-reanchor':\n            print(subprocess.run(args, check=True, capture_output=True, text=True).stdout)\nprint(f'CLI subprocess verification: all {len(cases)} finance examples passed')\ncatalog = load_catalog()\nbook = json.loads(Path('data/book.json').read_text())['changes']\nstart = time.perf_counter()\nfor c in book:\n    prorate_change(Subscription(c['id'], 'cus_bulk', c['plan'], date.fromisoformat(c['anchor'])), c['to'], date.fromisoformat(c['at']), catalog)\nprint(f'Bulk repricing: {len(book)} changes in {time.perf_counter() - start:.4f}s (budget 0.2s)')\nPY\n"]
