[101.075197, "i", "cat > tests/test_bill212_regressions.py <<'PY'\n\"\"\"Additional boundary and end-to-end coverage for BILL-212.\"\"\"\nimport io\nimport json\nimport tempfile\nimport unittest\nfrom contextlib import redirect_stdout\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing import __main__ as cli\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.proration import portion\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -13), date(2027, 2, 28))\n\n    def test_actual_cycle_lengths(self):\n        cases = [\n            (date(2026, 1, 31), date(2026, 2, 15), 'month', 28),\n            (date(2026, 1, 31), date(2026, 3, 10), 'month', 31),\n          "]
[101.075252, "i", "  (date(2028, 1, 30), date(2028, 2, 15), 'month', 30),\n            (date(2024, 2, 29), date(2027, 11, 2), 'year', 366),\n            (date(2024, 2, 29), date(2026, 11, 2), 'year', 365),\n        ]\n        for anchor, on, interval, expected in cases:\n            with self.subTest(anchor=anchor, on=on, interval=interval):\n                self.assertEqual(cycle_length_days(anchor, on, interval), expected)\n\n    def test_lookup_matches_anchor_based_schedule(self):\n        for anchor in (date(2024, 1, 29), date(2024, 1, 30),\n                       date(2024, 1, 31), date(2024, 2, 29)):\n            for interval, step in (('month', 1), ('year', 12)):\n                for k in range(20):\n                    start = add_months(anchor, step * k)\n                    end = add_months(anchor, step * (k + 1))\n                    for on in (start, start + (end - start) // 2,\n                               end - timedelta(days=1)):\n                        with self.subTest(anchor=anchor, interval=interval, on=on):\n              "]
[101.075259, "i", "              self.assertEqual(cycle_bounds(anchor, on, interval),\n                                             (start, end))\n\n    def test_invalid_cycle_requests(self):\n        anchor = date(2026, 1, 31)\n        with self.assertRaises(ValueError):\n            cycle_bounds(anchor, date(2026, 1, 30), 'month')\n        with self.assertRaises(ValueError):\n            cycle_bounds(anchor, anchor, 'week')\n        with self.assertRaises(ValueError):\n            cycle_length_days(anchor, anchor, 'week')\n\n\nclass ExactRoundingRegressionTest(unittest.TestCase):\n    def test_large_values_and_decimal_context(self):\n        with localcontext() as context:\n            context.prec = 2\n            self.assertEqual(portion(10**60 + 1, 1, 2), 10**60 // 2)\n            self.assertEqual(portion(10**60 + 3, 1, 2), 10**60 // 2 + 2)\n            self.assertEqual(portion(4900, 15, 28), 2625)\n            self.assertEqual(portion(-3, 1, 2), -2)\n            self.assertEqual(portion(-1, 1, 2), 0)\n            self.assertEqual(portion(10**6"]
