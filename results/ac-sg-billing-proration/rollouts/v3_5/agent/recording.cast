[42.479673, "i", "chor, on, interval)\\n    return (end - start).days')\np.write_text(s)\np = Path('billing/proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_EVEN, Decimal', 'from fractions import Fraction')\ns = s.replace('    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))', '    # Fraction keeps the result exact until the single half-even rounding.\\n    return round(Fraction(amount * numerator, denominator))')\ns = s.replace('    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\\n    new_anchor = sub.anchor\\n    next_renewal = end', '''    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\n    new_price = catalog.price(new.plan_id, change_at)\n    if old.interval == new.interval:\n        charge = portion(new_price, remaining, period_days)\n        new_anchor = sub.anchor\n        nex"]
