[105.415271, "i", "s.run(\n                        [sys.executable, '-m', 'billing', 'preview', '--sub', str(subs),\n                         '--id', case['id'], '--to', case['to'], '--at', case['at'],\n                         '--json'], cwd=app, text=True, capture_output=True, check=True)\n                    doc = json.loads(result.stdout)\n                    expected = case['expected']\n                    self.assertEqual([line['amount'] for line in doc['lines']],\n                                     [-expected['credit'], expected['charge']])\n                    self.assertEqual([line['period_start'] for line in doc['lines']],\n                                     [case['at'], case['at']])\n                    self.assertEqual([line['period_end'] for line in doc['lines']],\n                                     [expected['period_end'], expected['next_renewal']])\n                    self.assertEqual(doc['subtotal'], expected['total'])\n                    self.assertEqual(doc['amount_due'], max(0, expected['total']))\n                "]
[105.415294, "i", "    self.assertEqual(doc['credit_carried'], max(0, -expected['total']))\n\n    def test_existing_balance_is_carried_with_leap_anchor_downgrade(self):\n        app = Path(__file__).resolve().parent.parent\n        result = subprocess.run(\n            [sys.executable, '-m', 'billing', 'preview', '--sub', 'data/subscriptions.json',\n             '--id', 'sub_1077', '--to', 'pro-annual', '--at', '2027-11-02', '--json'],\n            cwd=app, text=True, capture_output=True, check=True)\n        doc = json.loads(result.stdout)\n        self.assertEqual(doc['subtotal'], -19508)\n        self.assertEqual(doc['balance_before'], -2500)\n        self.assertEqual(doc['amount_due'], 0)\n        self.assertEqual(doc['credit_carried'], 22008)\n'''\ns = s.replace(\"\\n\\nif __name__ == '__main__':\", insert + \"\\n\\nif __name__ == '__main__':\")\np.write_text(s)\nPY\npython -m unittest discover -s tests\n"]
