[87.239772, "i", "id_cycles(self):\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 30), 'month')\n        with self.assertRaises(ValueError):\n            cycle_length_days(date(2026, 1, 31), date(2026, 2, 1), 'week')\n\n    def test_iteration_includes_cycle_starting_on_until(self):\n        self.assertEqual(list(iter_cycles(date(2026, 1, 31), date(2026, 2, 28), 'month')),\n                         [(date(2026, 1, 31), date(2026, 2, 28)),\n                          (date(2026, 2, 28), date(2026, 3, 31))])\n\n\nclass ExactPortionTest(unittest.TestCase):\n    def test_rounding_is_independent_of_decimal_context(self):\n        with localcontext() as context:\n            context.prec = 2\n            self.assertEqual(portion(4900, 21, 31), 3319)\n            self.assertEqual(portion(9900, 13, 28), 4596)\n\n    def test_large_half_even_results_are_exact(self):\n        base = 10 ** 40\n        self.assertEqual(portion(2 * base + 1, 1, 2), base)\n        self.assertEqual(portion(2 * base + 3, 1, 2)"]
