[87.239199, "i", "cat > tests/test_billing_regressions.py <<'PY'\n\"\"\"Additional edge cases for BILL-212's finance rev. 4 rules.\"\"\"\nimport unittest\nfrom datetime import date\nfrom decimal import localcontext\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days, iter_cycles\nfrom billing.catalog import Catalog, Plan\nfrom billing.proration import Subscription, portion, prorate_change, renewal_after, renewal_schedule\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_29th_and_30th_return_after_short_month(self):\n        for day in (29, 30):\n            with self.subTest(day=day):\n                anchor = date(2026, 1, day)\n                self.assertEqual(cycle_bounds(anchor, date(2026, 3, 1), 'month'),\n                                 (date(2026, 2, 28), date(2026, 3, day)))\n\n    def test_leap_anchor_renewal_boundaries(self):\n        anchor = date(2024, 2, 29)\n        for on, start, end in (\n            (date(2028, 2, 28), date(2027, 2, 28), date(2028, 2, 29)),\n            (date(2028, 2, 29), date(2"]
[87.239608, "o", "cat > tests/test_billing_regressions.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Additional edge cases for BILL-212's finance rev. 4 rules.\"\"\"\r\n\u001b[?2004l\r"]
[87.239754, "i", "028, 2, 29), date(2029, 2, 28)),\n        ):\n            with self.subTest(on=on):\n                self.assertEqual(cycle_bounds(anchor, on, 'year'), (start, end))\n\n    def test_actual_cycle_lengths(self):\n        for anchor, on, interval, days in (\n            (date(2026, 1, 31), date(2026, 2, 1), 'month', 28),\n            (date(2028, 1, 30), date(2028, 2, 1), 'month', 30),\n            (date(2026, 1, 31), date(2026, 3, 1), 'month', 31),\n            (date(2024, 2, 29), date(2027, 11, 2), 'year', 366),\n            (date(2024, 2, 29), date(2026, 11, 2), 'year', 365),\n        ):\n            with self.subTest(anchor=anchor, on=on):\n                self.assertEqual(cycle_length_days(anchor, on, interval), days)\n\n    def test_zero_and_negative_month_offsets(self):\n        self.assertEqual(add_months(date(2026, 1, 31), 0), date(2026, 1, 31))\n        self.assertEqual(add_months(date(2026, 3, 31), -1), date(2026, 2, 28))\n        self.assertEqual(add_months(date(2026, 1, 31), -2), date(2025, 11, 30))\n\n    def test_inval"]
