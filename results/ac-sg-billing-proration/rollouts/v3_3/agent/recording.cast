[94.940451, "o", "\u001b[?2004l\r\u001b[?2004h>                                       date.fromisoformat(expected['next_renewal'])))\r\n\u001b[?2004l\r\u001b[?2004h>                     subscriptions.write_text(json.dumps({'subscriptions': [{\r\n\u001b[?2004l\r\u001b[?2004h>                         'id': sub.sub_id, 'customer': sub.customer, 'plan': sub.plan_id,\r\n\u001b[?2004l\r\u001b[?2004h>                         'anchor': case['anchor'],\r\n\u001b[?2004l\r\u001b[?2004h>                     }]}))\r\n\u001b[?2004l\r\u001b[?2004h>                     output = io.StringIO()\r\n\u001b[?2004l\r\u001b[?2004h>                     with redirect_stdout(output):\r\n\u001b[?2004l\r\u001b[?2004h>                         self.assertEqual(cli.main([\r\n\u001b[?2004l\r\u001b[?2004h>                             'preview', '--sub', str(subscriptions), '--id', sub.sub_id,\r\n\u001b[?2004l\r\u001b[?2004h>                             '--to', case['to'], '--at', case['at'], '--json',\r\n\u001b[?2004l\r\u001b[?2004h>                             '--catalog', str(APP / 'data/catalog.json'),\r\n\u001b[?2004l\r\u001b[?2004h>                         ]), 0)\r\n\u001b[?2004l\r\u001b[?2004h>                     inv"]
[94.940533, "o", "oice = json.loads(output.getvalue())\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assertEqual(invoice['subtotal'], expected['total'])\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assertEqual(invoice['amount_due'], max(expected['total'], 0))\r\n\u001b[?2004l\r\u001b[?2004h>                     self.assertEqual(invoice['credit_carried'], max(-expected['total'], 0))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
