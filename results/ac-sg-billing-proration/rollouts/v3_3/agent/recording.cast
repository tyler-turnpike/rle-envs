[94.930952, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"BILL-212 calendar, rounding, and invoice-preview regressions.\"\"\"\nimport io\nimport json\nimport tempfile\nimport unittest\nfrom contextlib import redirect_stdout\nfrom datetime import date\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing import __main__ as cli\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days, iter_cycles\nfrom billing.catalog import load_catalog\nfrom billing.invoice import build_preview\nfrom billing.proration import Subscription, portion, prorate_change\n\nAPP = Path(__file__).resolve().parents[1]\nCASES = json.loads((APP / 'tests/fixtures/plan_changes.json').read_text())['cases']\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -13), date(2027, 2, 28))\n\n    def"]
[94.931172, "i", " test_century_leap_rules(self):\n        self.assertEqual(add_months(date(2000, 1, 31), 1), date(2000, 2, 29))\n        self.assertEqual(add_months(date(2100, 1, 31), 1), date(2100, 2, 28))\n\n    def test_month_end_cycle_boundaries(self):\n        for day in (29, 30, 31):\n            anchor = date(2026, 1, day)\n            with self.subTest(anchor=anchor):\n                self.assertEqual(cycle_bounds(anchor, date(2026, 2, 27), 'month'),\n                                 (anchor, date(2026, 2, 28)))\n                self.assertEqual(cycle_bounds(anchor, date(2026, 2, 28), 'month'),\n                                 (date(2026, 2, 28), date(2026, 3, day)))\n                self.assertEqual(cycle_bounds(anchor, date(2026, 3, day), 'month'),\n                                 (date(2026, 3, day), date(2026, 4, min(day, 30))))\n\n    def test_annual_iteration_restores_leap_day(self):\n        anchor = date(2024, 2, 29)\n        renewals = [anchor, date(2025, 2, 28), date(2026, 2, 28),\n                    date(2027, 2, 28), dat"]
