[94.931216, "i", "ses(ValueError):\n            cycle_length_days(date(2026, 1, 31), date(2026, 2, 1), 'week')\n\n\nclass ExactPortionTest(unittest.TestCase):\n    def test_rounding_is_exact_and_independent_of_decimal_context(self):\n        denominator = 10 ** 50\n        with localcontext() as context:\n            context.prec = 2\n            self.assertEqual(portion(10 ** 40 + 3, 1, 2), 5 * 10 ** 39 + 2)\n            self.assertEqual(portion(1, denominator // 2 + 1, denominator), 1)\n            self.assertEqual(portion(1, denominator // 2 - 1, denominator), 0)\n            self.assertEqual(portion(-3, 1, 2), -2)\n            self.assertEqual(portion(-1, 1, 2), 0)\n            self.assertEqual(portion(99, 0, 31), 0)\n            self.assertEqual(portion(99, 31, 31), 99)\n\n    def test_nonpositive_denominator_and_negative_fraction(self):\n        for numerator, denominator in ((0, 0), (0, -1), (-1, 31)):\n            with self.subTest(numerator=numerator, denominator=denominator):\n                with self.assertRaises(ValueError):\n        "]
[94.931241, "i", "            portion(100, numerator, denominator)\n\n\nclass PreviewRegressionTest(unittest.TestCase):\n    def test_worked_example_lines_and_cli(self):\n        catalog = load_catalog(APP / 'data/catalog.json')\n        with tempfile.TemporaryDirectory() as directory:\n            subscriptions = Path(directory) / 'subscriptions.json'\n            for case in CASES:\n                with self.subTest(case=case['id']):\n                    at = date.fromisoformat(case['at'])\n                    sub = Subscription('sub_test', 'cus_test', case['plan'],\n                                       date.fromisoformat(case['anchor']))\n                    result = prorate_change(sub, case['to'], at, catalog)\n                    expected = case['expected']\n                    credit, charge = result.lines\n                    self.assertEqual((credit.kind, credit.plan_id, credit.amount,\n                                      credit.period_start, credit.period_end),\n                                     ('credit', case['plan'], -expecte"]
[94.931251, "i", "d['credit'], at,\n                                      date.fromisoformat(expected['period_end'])))\n                    self.assertEqual((charge.kind, charge.plan_id, charge.amount,\n                                      charge.period_start, charge.period_end),\n                                     ('charge', case['to'], expected['charge'], at,\n                                      date.fromisoformat(expected['next_renewal'])))\n                    subscriptions.write_text(json.dumps({'subscriptions': [{\n                        'id': sub.sub_id, 'customer': sub.customer, 'plan': sub.plan_id,\n                        'anchor': case['anchor'],\n                    }]}))\n                    output = io.StringIO()\n                    with redirect_stdout(output):\n                        self.assertEqual(cli.main([\n                            'preview', '--sub', str(subscriptions), '--id', sub.sub_id,\n                            '--to', case['to'], '--at', case['at'], '--json',\n                            '--catalog', "]
[94.931267, "i", "str(APP / 'data/catalog.json'),\n                        ]), 0)\n                    invoice = json.loads(output.getvalue())\n                    self.assertEqual(invoice['subtotal'], expected['total'])\n                    self.assertEqual(invoice['amount_due'], max(expected['total'], 0))\n                    self.assertEqual(invoice['credit_carried'], max(-expected['total'], 0))\n\n    def test_existing_credit_balance_is_carried_forward(self):\n        catalog = load_catalog(APP / 'data/catalog.json')\n        sub = Subscription('sub_test', 'cus_test', 'team-annual', date(2024, 2, 29))\n        result = prorate_change(sub, 'pro-monthly', date(2026, 11, 20), catalog)\n        preview = build_preview(result, 'USD', balance_before=-2500)\n        self.assertEqual(preview.amount_due, max(result.total - 2500, 0))\n        self.assertEqual(preview.credit_carried, max(2500 - result.total, 0))\nPY\npython -m unittest discover -s tests\n"]
