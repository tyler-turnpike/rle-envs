[111.098097, "i", "python - <<'PY'\nfrom datetime import date, timedelta\nfrom billing.calendar import add_months, cycle_bounds\nchecks = 0\nfor year in (1999, 2000, 2024, 2026, 2028, 2096, 2100):\n    for month in range(1, 13):\n        for day in (28, 29, 30, 31):\n            try:\n                anchor = date(year, month, day)\n            except ValueError:\n                continue\n            for interval, step, count in (('month', 1, 36), ('year', 12, 8)):\n                renewals = [add_months(anchor, step * k) for k in range(count + 1)]\n                for start, end in zip(renewals, renewals[1:]):\n                    for on in (start, start + timedelta(days=1), end - timedelta(days=1)):\n                        assert cycle_bounds(anchor, on, interval) == (start, end), (anchor, on, interval)\n                        checks += 1\nprint(f'Calendar boundary reference checks passed: {checks}')\nPY\n"]
[111.098358, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[111.099566, "o", "\u001b[?2004h> from datetime import date, timedelta\r\n\u001b[?2004l\r\u001b[?2004h> from billing.calendar import add_months, cycle_bounds\r\n\u001b[?2004l\r\u001b[?2004h> checks = 0\r\n\u001b[?2004l\r\u001b[?2004h> for year in (1999, 2000, 2024, 2026, 2028, 2096, 2100):\r\n\u001b[?2004l\r\u001b[?2004h>     for month in range(1, 13):\r\n\u001b[?2004l\r\u001b[?2004h>         for day in (28, 29, 30, 31):\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 anchor = date(year, month, day)\r\n\u001b[?2004l\r\u001b[?2004h>             except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             for interval, step, count in (('month', 1, 36), ('year', 12, 8)):\r\n\u001b[?2004l\r\u001b[?2004h>                 renewals = [add_months(anchor, step * k) for k in range(count + 1)]\r\n\u001b[?2004l\r\u001b[?2004h>                 for start, end in zip(renewals, renewals[1:]):\r\n\u001b[?2004l\r\u001b[?2004h>                     for on in (start, start + timedelta(days=1), end - timedelta(days=1)):\r\n\u001b[?2004l\r\u001b[?2004h>                         assert cycle_bounds(anchor, on, interval) == (s"]
[111.099595, "o", "tart, end), (anchor, on, interval)\r\n\u001b[?2004l\r\u001b[?2004h>                         checks += 1\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Calendar boundary reference checks passed: {checks}')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
