[62.929669, "o", "                 \"anchor\": c[\"anchor\"]} for c in CASES]\r\n\u001b[?2004l\r"]
[62.929686, "o", "\u001b[?2004h"]
[62.929732, "o", "> "]
[62.929822, "o", "        with tempfile.TemporaryDirectory() as tmp:\r\n"]
[62.929889, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.929999, "o", "            subscriptions = Path(tmp) / \"subscriptions.json\"\r\n\u001b[?2004l\r"]
[62.930067, "o", "\u001b[?2004h> "]
[62.930192, "o", "            subscriptions.write_text(json.dumps({\"subscriptions\": rows}))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.930224, "o", "            for case in CASES:\r\n\u001b[?2004l\r"]
[62.930299, "o", "\u001b[?2004h> "]
[62.930343, "o", "                with self.subTest(case=case[\"id\"]):\r\n\u001b[?2004l\r"]
[62.930455, "o", "\u001b[?2004h>                     buf = io.StringIO()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.930464, "o", "                    with redirect_stdout(buf):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.930555, "o", "                        cli.main([\"preview\", \"--sub\", str(subscriptions),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.930653, "o", "                                  \"--id\", case[\"id\"], \"--to\", case[\"to\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.93079, "o", "> "]
[62.930843, "o", "                                  \"--at\", case[\"at\"], \"--json\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.930931, "o", "                    doc = json.loads(buf.getvalue())\r\n\u001b[?2004l\r\u001b[?2004h>                     exp = case[\"expected\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.931, "o", "                    self.assertEqual(doc[\"subtotal\"], exp[\"total\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.931091, "o", "                    self.assertEqual(doc[\"amount_due\"], max(0, exp[\"total\"]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.931164, "o", "> "]
[62.931251, "o", "                    self.assertEqual(doc[\"credit_carried\"], max(0, -exp[\"total\"]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.93132, "o", "                    credit, charge = doc[\"lines\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.931393, "o", "                    self.assertEqual((credit[\"kind\"], credit[\"plan\"], credit[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.931473, "o", "> "]
[62.931553, "o", "                                     (\"credit\", case[\"plan\"], -exp[\"credit\"]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.93162, "o", "                    self.assertEqual((charge[\"kind\"], charge[\"plan\"], charge[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.931686, "o", "                                     (\"charge\", case[\"to\"], exp[\"charge\"]))\r\n\u001b[?2004l\r"]
[62.931753, "o", "\u001b[?2004h> "]
[62.931784, "o", "                    self.assertEqual(credit[\"period_start\"], case[\"at\"])\r\n\u001b[?2004l\r"]
[62.931818, "o", "\u001b[?2004h> "]
[62.931911, "o", "                    self.assertEqual(credit[\"period_end\"], exp[\"period_end\"])"]
[62.931992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.932072, "o", "                    self.assertEqual(charge[\"period_start\"], case[\"at\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.932236, "o", "                    self.assertEqual(charge[\"period_end\"], exp[\"next_renewal\"])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[62.932248, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.932337, "o", "    def test_format_amount(self):''')"]
