[66.348601, "o", "--- /tmp/bill212-calendar.py.orig\t2026-11-22 18:18:03.647429694 +0000\r\n+++ billing/calendar.py\t2026-11-22 18:18:03.671238682 +0000\r\n@@ -33,8 +33,8 @@\r\n     total = anchor.month - 1 + months\r\n     year = anchor.year + total // 12\r\n     month = total % 12 + 1\r\n-    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\r\n-    day = min(anchor.day, 28)\r\n+    # Clamp only to the target month; callers retain the original anchor.\r\n+    day = min(anchor.day, days_in_month(year, month))\r\n     return date(year, month, day)\r\n \r\n \r\n@@ -46,18 +46,20 @@\r\n     if on < anchor:\r\n         raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n     step = interval_months(interval)\r\n-    start = anchor\r\n-    end = add_months(start, step)\r\n-    while end <= on:\r\n-        start = end\r\n-        end = add_months(start, step)\r\n+    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\r\n+    cycle = elapsed_months // step\r\n+    start = add_months(anchor, cycle * step)\r\n+    if sta"]
[66.348646, "o", "rt > on:\r\n+        cycle -= 1\r\n+        start = add_months(anchor, cycle * step)\r\n+    # Both boundaries come from the original anchor, so clamping never drifts.\r\n+    end = add_months(anchor, (cycle + 1) * step)\r\n     return start, end\r\n \r\n \r\n def cycle_length_days(anchor: date, on: date, interval: str) -> int:\r\n-    if interval == \"year\":\r\n-        return 365\r\n-    return 30\r\n+    start, end = cycle_bounds(anchor, on, interval)\r\n+    return (end - start).days\r\n \r\n \r\n def iter_cycles(anchor: date, until: date, interval: str) -> Iterator[Tuple[date, date]]:\r\n"]
