[65.328944, "i", "        self.assertEqual(portion(amount, numerator, denominator),\n                                             round(Fraction(amount * numerator, denominator)))\n\n    def test_invalid_fractions(self):\n        for numerator, denominator in ((0, 0), (0, -1), (-1, 2), (3, 2)):\n            with self.subTest(numerator=numerator, denominator=denominator):\n                with self.assertRaises(ValueError):\n                    portion(100, numerator, denominator)\n\n    def test_credit_uses_cycle_start_charge_uses_change_date(self):\n        history = ((date(2026, 1, 1), 100), (date(2026, 2, 1), 200))\n        catalog = Catalog({\n            'old': Plan('old', 'Old', 'month', 'USD', history),\n            'new': Plan('new', 'New', 'month', 'USD', history),\n        })\n        sub = Subscription('sub', 'customer', 'old', date(2026, 1, 31))\n        pr = prorate_change(sub, 'new', date(2026, 2, 14), catalog)\n        self.assertEqual((pr.credit, pr.charge), (50, 100))\n        self.assertEqual(pr.new_anchor, sub.anchor)\n       "]
[65.328953, "i", " self.assertEqual(pr.next_renewal, date(2026, 2, 28))\n\n    def test_invoice_line_amounts_and_periods_for_worked_examples(self):\n        catalog = load_catalog()\n        for case in CASES:\n            with self.subTest(case=case['id']):\n                at = date.fromisoformat(case['at'])\n                sub = Subscription('sub', 'customer', case['plan'], date.fromisoformat(case['anchor']))\n                pr = prorate_change(sub, case['to'], at, catalog)\n                credit, charge = pr.lines\n                self.assertEqual((credit.kind, credit.plan_id, credit.amount), ('credit', sub.plan_id, -pr.credit))\n                self.assertEqual((charge.kind, charge.plan_id, charge.amount), ('charge', case['to'], pr.charge))\n                self.assertEqual((credit.period_start, credit.period_end), (at, pr.period_end))\n                self.assertEqual((charge.period_start, charge.period_end), (at, pr.next_renewal))\n                self.assertEqual(sum(line.amount for line in pr.lines), case['expected']['total'])\n\n"]
[65.328959, "i", "\nclass CLIRegressionTest(unittest.TestCase):\n    def test_all_finance_examples_through_module_entrypoint(self):\n        with tempfile.TemporaryDirectory() as temp:\n            path = Path(temp) / 'subscriptions.json'\n            path.write_text(json.dumps({'subscriptions': [\n                {'id': c['id'], 'customer': 'customer', 'plan': c['plan'], 'anchor': c['anchor']}\n                for c in CASES\n            ]}))\n            for case in CASES:\n                with self.subTest(case=case['id']):\n                    result = subprocess.run(\n                        [sys.executable, '-m', 'billing', 'preview', '--sub', str(path),\n                         '--id', case['id'], '--to', case['to'], '--at', case['at'], '--json'],\n                        cwd=APP, check=True, capture_output=True, text=True)\n                    doc = json.loads(result.stdout)\n                    total = case['expected']['total']\n                    self.assertEqual(doc['subtotal'], total)\n                    self.assertEqual(doc['amo"]
[65.328963, "i", "unt_due'], max(0, total))\n                    self.assertEqual(doc['credit_carried'], max(0, -total))\n                    self.assertEqual([line['amount'] for line in doc['lines']],\n                                     [-case['expected']['credit'], case['expected']['charge']])\n                    self.assertEqual(doc['lines'][1]['period_end'], case['expected']['next_renewal'])\nPY\npython -m unittest discover -s tests -p test_bill212_regressions.py -v\n"]
