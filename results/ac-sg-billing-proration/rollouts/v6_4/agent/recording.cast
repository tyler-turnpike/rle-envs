[57.305406, "i", "cat > tests/test_bill212_regressions.py <<'PY'\n\"\"\"Additional regression coverage for finance's rev. 4 proration rules.\"\"\"\nimport json\nfrom datetime import date\nfrom decimal import localcontext\nfrom fractions import Fraction\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days, iter_cycles\nfrom billing.proration import portion\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_month_end_and_century_leap_rules(self):\n        cases = [\n            (date(2026, 1, 31), 0, date(2026, 1, 31)),\n            (date(2026, 1, 31), 1, date(2026, 2, 28)),\n            (date(2026, 1, 31), 2, date(2026, 3, 31)),\n            (date(2028, 3, 31), -1, date(2028, 2, 29)),\n            (date(2000, 1, 31), 1, date(2000, 2, 29)),\n            (date(2100, 1, 31), 1, date(2100, 2, 28)),\n            (date(2024, 2, 29), 48, date(2028, 2, 29)),\n        ]\n        for anchor, mont"]
[57.305612, "i", "hs, expected in cases:\n            with self.subTest(anchor=anchor, months=months):\n                self.assertEqual(add_months(anchor, months), expected)\n\n    def test_annual_leap_day_boundary(self):\n        anchor = date(2024, 2, 29)\n        self.assertEqual(cycle_bounds(anchor, date(2028, 2, 28), \"year\"),\n                         (date(2027, 2, 28), date(2028, 2, 29)))\n        self.assertEqual(cycle_bounds(anchor, date(2028, 2, 29), \"year\"),\n                         (date(2028, 2, 29), date(2029, 2, 28)))\n\n    def test_cycle_lengths_are_actual_days(self):\n        anchor = date(2026, 1, 31)\n        self.assertEqual(cycle_length_days(anchor, anchor, \"month\"), 28)\n        self.assertEqual(cycle_length_days(anchor, date(2026, 3, 1), \"month\"), 31)\n        self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 3, 1), \"year\"), 366)\n\n    def test_iter_cycles_retains_original_anchor(self):\n        self.assertEqual(list(iter_cycles(date(2026, 1, 31), date(2026, 3, 31), \"month\")), [\n            (date(2026, "]
[57.305622, "i", "1, 31), date(2026, 2, 28)),\n            (date(2026, 2, 28), date(2026, 3, 31)),\n            (date(2026, 3, 31), date(2026, 4, 30)),\n        ])\n\n    def test_invalid_cycle_requests(self):\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 30), \"month\")\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 31), \"week\")\n\n\nclass ExactPortionRegressionTest(unittest.TestCase):\n    def test_exact_half_even_independent_of_decimal_context(self):\n        # Large amounts and low context precision must not introduce intermediate\n        # rounding, even when the exact result lies just above or below a tie.\n        with localcontext() as context:\n            context.prec = 3\n            for amount in [0, 1, 3, 5, -1, -3, -5, 10**40 + 1]:\n                for numerator, denominator in [(0, 31), (1, 2), (15, 31), (31, 31),\n                                                (10**30 + 1, 2 * 10**30)]:\n                    with self.s"]
[57.305634, "i", "ubTest(amount=amount, numerator=numerator, denominator=denominator):\n                        self.assertEqual(portion(amount, numerator, denominator),\n                                         round(Fraction(amount * numerator, denominator)))\n\n    def test_invalid_fractions(self):\n        for numerator, denominator in [(0, 0), (0, -1), (-1, 30), (31, 30)]:\n            with self.subTest(numerator=numerator, denominator=denominator):\n                with self.assertRaises(ValueError):\n                    portion(100, numerator, denominator)\n\n\nclass FinanceCLIRegressionTest(unittest.TestCase):\n    def test_all_finance_examples_through_cli(self):\n        cases = json.loads((APP / \"tests/fixtures/plan_changes.json\").read_text())[\"cases\"]\n        with tempfile.TemporaryDirectory() as directory:\n            subscriptions = Path(directory) / \"subscriptions.json\"\n            subscriptions.write_text(json.dumps({\"subscriptions\": [\n                {\"id\": c[\"id\"], \"customer\": \"cus_regression\", \"plan\": c[\"plan\"], \"anchor\":"]
[57.305638, "i", " c[\"anchor\"]}\n                for c in cases\n            ]}))\n            for case in cases:\n                with self.subTest(case=case[\"id\"]):\n                    result = subprocess.run([\n                        sys.executable, \"-m\", \"billing\", \"preview\", \"--sub\", str(subscriptions),\n                        \"--id\", case[\"id\"], \"--to\", case[\"to\"], \"--at\", case[\"at\"], \"--json\",\n                    ], cwd=APP, check=True, text=True, capture_output=True)\n                    invoice = json.loads(result.stdout)\n                    expected = case[\"expected\"]\n                    self.assertEqual(invoice[\"subtotal\"], expected[\"total\"])\n                    self.assertEqual(invoice[\"amount_due\"], max(0, expected[\"total\"]))\n                    self.assertEqual(invoice[\"credit_carried\"], max(0, -expected[\"total\"]))\n                    credit, charge = invoice[\"lines\"]\n                    self.assertEqual((credit[\"kind\"], credit[\"amount\"]), (\"credit\", -expected[\"credit\"]))\n                    self.assertEqual((charge[\""]
[57.305642, "i", "kind\"], charge[\"amount\"]), (\"charge\", expected[\"charge\"]))\n                    self.assertEqual(credit[\"period_start\"], case[\"at\"])\n                    self.assertEqual(credit[\"period_end\"], expected[\"period_end\"])\n                    self.assertEqual(charge[\"period_start\"], case[\"at\"])\n                    self.assertEqual(charge[\"period_end\"], expected[\"next_renewal\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nPY\npython -m unittest discover -s tests\n"]
