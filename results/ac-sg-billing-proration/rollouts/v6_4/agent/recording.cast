[70.203149, "o", "tor and whole % 2):\r\n+        whole += 1\r\n+    return whole\r\n \r\n \r\n def prorate_change(sub: Subscription, new_plan_id: str, change_at: date,\r\n@@ -71,19 +75,27 @@\r\n         raise ValueError(\"cross-currency plan changes are not supported\")\r\n \r\n     start, end = cycle_bounds(sub.anchor, change_at, old.interval)\r\n-    period_days = cycle_length_days(sub.anchor, change_at, old.interval)\r\n+    period_days = days_between(start, end)\r\n     remaining = days_between(change_at, end)\r\n \r\n-    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\r\n-    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\r\n-    new_anchor = sub.anchor\r\n-    next_renewal = end\r\n+    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\r\n+    new_price = catalog.price(new.plan_id, change_at)\r\n+    if old.interval == new.interval:\r\n+        charge = portion(new_price, remaining, period_days)\r\n+        new_anchor = sub.anchor\r\n+        next_renewal = end\r\n+        charg"]
[70.203311, "o", "e_description = \"Remaining time\"\r\n+    else:\r\n+        charge = new_price\r\n+        new_anchor = change_at\r\n+        next_renewal = add_months(new_anchor, new.months)\r\n+        charge_description = \"Full cycle\"\r\n \r\n     lines = [\r\n         Line(\"credit\", old.plan_id, -credit, change_at, end,\r\n              f\"Unused time on {old.name} ({change_at} to {end})\"),\r\n         Line(\"charge\", new.plan_id, charge, change_at, next_renewal,\r\n-             f\"Remaining time on {new.name} ({change_at} to {next_renewal})\"),\r\n+             f\"{charge_description} on {new.name} ({change_at} to {next_renewal})\"),\r\n     ]\r\n     return Proration(sub.sub_id, change_at, start, end, credit, charge,\r\n                      new_anchor, next_renewal, lines)\r\n\u001b[?2004hroot@ddf74f36b5ef:/app# "]
[70.302665, "i", "python - <<'PY'\nfrom datetime import date, timedelta\nfrom billing.calendar import add_months, cycle_bounds\nchecks = 0\nfor year in (1999, 2000, 2024, 2026, 2028, 2099):\n    for month in (1, 2, 6, 12):\n        for day in (28, 29, 30, 31):\n            try:\n                anchor = date(year, month, day)\n            except ValueError:\n                continue\n            for interval, step in [('month', 1), ('year', 12)]:\n                for k in range(6):\n                    start = add_months(anchor, step * k)\n                    end = add_months(anchor, step * (k + 1))\n                    for on in (start, end - timedelta(days=1)):\n                        assert cycle_bounds(anchor, on, interval) == (start, end)\n                        checks += 1\nprint(f'Calendar boundary cross-checks passed: {checks}')\nPY\npython -m billing preview --sub data/subscriptions.json --id sub_1001 --to pro-monthly --at 2026-06-20\n"]
[70.302846, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
