[73.453401, "o", "\", 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.453685, "o", "            (date(2024, 1, 31), \"month\", 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.453975, "o", "            (date(2024, 2, 29), \"year\", 12),\r\n\u001b[?2004l\r\u001b[?2004h>         ]:\r\n\u001b[?2004l\r\u001b[?2004h>             for k in range(1, 49):\r\n\u001b[?2004l\r\u001b[?2004h> "]
