[10.087975, "o", "# Tests\r\n\r\n`python -m unittest discover -s tests` runs everything; the release job runs the same command.\r\n\r\n## Quarantine\r\n\r\nTests that are flaky in CI can be quarantined by listing their id in `tests/quarantine.txt`\r\n(one per line, with the incident ticket in a comment). Quarantined tests are reported as skipped.\r\nRemove the entry once the flake is fixed.\r\n"]
[10.088036, "o", "# Quarantined tests: one test id per line (e.g. PortionTest.test_half_even), with the\r\n# incident ticket in a comment. See tests/README.md.\r\n"]
[10.088078, "o", "import unittest\r\nfrom datetime import date\r\n\r\nfrom billing.calendar import add_months, cycle_bounds, days_in_month, iter_cycles\r\n\r\n\r\nclass AddMonthsTest(unittest.TestCase):\r\n    def test_mid_month_anchor(self):\r\n        self.assertEqual(add_months(date(2025, 3, 14), 1), date(2025, 4, 14))\r\n        self.assertEqual(add_months(date(2025, 3, 14), 10), date(2026, 1, 14))\r\n"]
[10.088101, "o", "\r\n    def test_year_rollover(self):\r\n        self.assertEqual(add_months(date(2025, 11, 5), 3), date(2026, 2, 5))\r\n        self.assertEqual(add_months(date(2025, 12, 1), 12), date(2026, 12, 1))\r\n\r\n    def test_month_end_anchor_clamps_then_returns(self):\r\n        anchor = date(2026, 1, 31)\r\n        got = [add_months(anchor, k) for k in range(1, 5)]\r\n        self.assertEqual(got, [date(2026, 2, 28), date(2026, 3, 31),\r\n                               date(2026, 4, 30), date(2026, 5, 31)])\r\n\r\n    def test_leap_years(self):\r\n        self.assertEqual(add_months(date(2028, 1, 30), 1), date(2028, 2, 29))\r\n        anchor = date(2024, 2, 29)\r\n        got = [add_months(anchor, 12 * k) for k in range(1, 5)]\r\n        self.assertEqual(got, [date(2025, 2, 28), date(2026, 2, 28),\r\n                               date(2027, 2, 28), date(2028, 2, 29)])\r\n\r\n    def test_days_in_month(self):\r\n        self.assertEqual(days_in_month(2026, 2), 28)\r\n        self.assertEqual(days_in_month(2028, 2), 29)\r\n\r\n\r\nclass CycleBoundsTest(unitte"]
[10.088119, "o", "st.TestCase):\r\n    def test_mid_month(self):\r\n        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 20), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\r\n\r\n    def test_change_on_renewal_day_starts_new_cycle(self):\r\n        self.assertEqual(cycle_bounds(date(2025, 3, 14), date(2026, 6, 14), \"month\"),\r\n                         (date(2026, 6, 14), date(2026, 7, 14)))\r\n\r\n    def test_month_end_anchor(self):\r\n        anchor = date(2024, 1, 31)\r\n        self.assertEqual(cycle_bounds(anchor, date(2026, 2, 15), \"month\"),\r\n                         (date(2026, 1, 31), date(2026, 2, 28)))\r\n        self.assertEqual(cycle_bounds(anchor, date(2026, 3, 10), \"m"]
[10.088178, "o", "onth\"),\r\n                         (date(2026, 2, 28), date(2026, 3, 31)))\r\n\r\n    def test_annual(self):\r\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2027, 11, 2), \"year\"),\r\n                         (date(2027, 2, 28), date(2028, 2, 29)))\r\n\r\n    def test_iter_cycles_is_contiguous(self):\r\n        cycles = list(iter_cycles(date(2026, 1, 31), date(2026, 6, 1), \"month\"))\r\n        self.assertEqual(cycles[0][0], date(2026, 1, 31))\r\n        for (s1, e1), (s2, _) in zip(cycles, cycles[1:]):\r\n            self.assertEqual(e1, s2)\r\n        self.assertEqual(cycles[-1], (date(2026, 5, 31), date(2026, 6, 30)))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\nimport io\r\nimport json\r\nimport unittest\r\nfrom contextlib import redirect_stdout\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom pathlib import Path\r\n\r\nfrom billing import __main__ as cli\r\nfrom billing.catalog import load_catalog\r\nfrom billing.invoice import build_preview, commission_line, format_amount, load_partner_"]
[10.088182, "o", "rates, to_dict\r\nfrom billing.proration import Subscription, portion, prorate_change\r\n\r\nHERE = Path(__file__).resolve().parent\r\nAPP = HERE.parent\r\nCASES = json.loads((HERE / \"fixtures\" / \"plan_changes.json\").read_text())[\"cases\"]\r\n\r\n\r\nclass WorkedExamplesTest(unittest.TestCase):\r\n    \"\"\"Finance's worked examples (docs/proration.md, rev. 4).\"\"\"\r\n\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_worked_examples(self):\r\n        for case in CASES:\r\n            with self.subTest(case=case[\"id\"]):\r\n                sub = Subscription(\"sub_x\", \"cus_x\", case[\"plan\"], date.fromisoformat(case[\"anchor\"]))\r\n                got = prorate_change(sub, case[\"to\"], date.fromisoformat(case[\"at\"]), self.catalog)\r\n                exp = case[\"expected\"]\r\n                self.assertEqual((got.period_start.isoformat(), got.period_end.isoformat()),\r\n                                 (exp[\"period_start\"], exp[\"period_end\"]))\r\n                self.assertEqual(got.credit, exp[\"credi"]
[10.088195, "o", "t\"])\r\n                self.assertEqual(got.charge, exp[\"charge\"])\r\n                self.assertEqual(got.total, exp[\"total\"])\r\n                self.assertEqual(got.new_anchor.isoformat(), exp[\"new_anchor\"])\r\n                self.assertEqual(got.next_renewal.isoformat(), exp[\"next_renewal\"])\r\n\r\n\r\nclass PortionTest(unittest.TestCase):\r\n    def test_half_even(self):\r\n        self.assertEqual(portion(1, 1, 2), 0)\r\n        self.assertEqual(portion(3, 1, 2), 2)\r\n        self.assertEqual(portion(4900, 15, 28), 2625)\r\n\r\n    def test_rejects_bad_fraction(self):\r\n        with self.assertRaises(ValueError):\r\n            portion(100, 5, 4)\r\n\r\n\r\nclass InvoiceTest(unittest.TestCase):\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_downgrade_carries_credit(self):\r\n        sub = Subscription(\"sub_9\", \"cus_9\", \"team-monthly\", date(2025, 3, 14))\r\n        pr = prorate_change(sub, \"starter-monthly\", date(2026, 6, 20), self.catalog)\r\n        preview = build_preview(pr, \"USD"]
[10.088212, "o", "\")\r\n        self.assertEqual(preview.amount_due, 0)\r\n        self.assertEqual(preview.credit_carried, pr.credit - pr.charge)\r\n        self.assertEqual([l[\"kind\"] for l in to_dict(preview)[\"lines\"]], [\"credit\", \"charge\"])\r\n\r\n    def test_format_amount(self):\r\n        self.assertEqual(format_amount(123456, \"USD\"), \"1,234.56 USD\")\r\n        self.assertEqual(format_amount(-5, \"USD\"), \"-0.05 USD\")\r\n        self.assertEqual(format_amount(500, \"JPY\"), \"500 JPY\")\r\n\r\n    def test_cli_json_preview(self):\r\n        buf = io.StringIO()\r\n        with redirect_stdout(buf):\r\n            cli.main([\"preview\", \"--sub\", str(APP / \"data\" / \"subscriptions.json\"),\r\n                      \"--id\", \"sub_1001\", \"--to\", \"pro-monthly\", \"--at\", \"2026-06-20\",\r\n                      \"--catalog\", str(APP / \"data\" / \"catalog.json\"), \"--json\"])\r\n        doc = json.loads(buf.getvalue())\r\n        self.assertEqual(doc[\"subscription\"], \"sub_1001\")\r\n        self.assertEqual(doc[\"subtotal\"], 2960)\r\n        self.assertEqual(doc[\"amount_due\"], 2960)\r\n\r\n"]
[10.088221, "o", "\r\nclass PartnerInvoiceTest(unittest.TestCase):\r\n    \"\"\"Partner-channel subscriptions: the change preview carries the partner's commission.\"\"\"\r\n\r\n    def test_partner_commission_lines(self):\r\n        catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n        rates = load_partner_rates(APP / \"data\" / \"partners.json\")\r\n        rows = json.loads((APP / \"data\" / \"subscriptions.json\").read_text())[\"subscriptions\"]\r\n        partner_rows = [r for r in rows if r.get(\"partner\")]\r\n        self.assertTrue(partner_rows)\r\n        for row in partner_rows:\r\n            with self.subTest(sub=row[\"id\"], partner=row[\"partner\"]):\r\n                sub = Subscription(row[\"id\"], row[\"customer\"], row[\"plan\"], date.fromisoformat(row[\"anchor\"]))\r\n                pr = prorate_change(sub, row[\"upgrade_to\"], date.fromisoformat(row[\"upgrade_on\"]), catalog)\r\n                preview = build_preview(pr, \"USD\")\r\n                rate = rates[row[\"partner\"]]\r\n                line = commission_line(preview, rate, row[\"partner\"])\r\n           "]
[10.088227, "o", "     want = -int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n                self.assertEqual(line.kind, \"commission\")\r\n                self.assertEqual(line.amount, want)\r\n\r\n\r\nQUARANTINE = HERE / \"quarantine.txt\"\r\n\r\n\r\ndef load_tests(loader, tests, pattern):\r\n    \"\"\"Skip tests listed in tests/quarantine.txt (see tests/README.md).\"\"\"\r\n    listed = set()\r\n    if QUARANTINE.exists():\r\n        listed = {l.split(\"#\")[0].strip() for l in QUARANTINE.read_text().splitlines()} - {\"\"}\r\n\r\n    def walk(suite):\r\n        for item in suite:\r\n            if isinstance(item, unittest.TestSuite):\r\n                yield from walk(item)\r\n            else:\r\n                yield item\r\n    for test in walk(tests):\r\n        if any(test.id().endswith(name) for name in listed):\r\n            setattr(test, test._testMethodName, unittest.skip(\"quarantined\")(getattr(test, test._testMethodName)))\r\n    return tests\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"]
