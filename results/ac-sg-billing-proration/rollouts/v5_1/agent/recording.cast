[53.298122, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/calendar.py')\ns = p.read_text().replace('''    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\n    day = min(anchor.day, 28)\n''', '''    # Clamp only when the target month lacks the original anchor day.\n    day = min(anchor.day, days_in_month(year, month))\n''')\ns = s.replace('''    start = anchor\n    end = add_months(start, step)\n    while end <= on:\n        start = end\n        end = add_months(start, step)\n    return start, end\n''', '''    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\n    cycle = elapsed_months // step\n    start = add_months(anchor, cycle * step)\n    if start > on:\n        cycle -= 1\n        start = add_months(anchor, cycle * step)\n    # Always derive renewals from the original anchor, not a clamped renewal.\n    end = add_months(anchor, (cycle + 1) * step)\n    return start, end\n''')\ns = s.replace('''    if interval == \"year\":\n        return 365\n    return 30\n''', '''    start, en"]
