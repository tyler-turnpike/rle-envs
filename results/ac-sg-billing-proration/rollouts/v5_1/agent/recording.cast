[97.025307, "i", "chor)\n        self.assertEqual(renewal_schedule(new_sub, 2, self.catalog), [date(2028, 2, 29), date(2028, 3, 31)])\n\n    def test_monthly_to_annual_reanchors_on_leap_day(self):\n        sub = Subscription(\"sub\", \"customer\", \"old\", date(2028, 1, 31))\n        at = date(2028, 2, 29)\n        pr = prorate_change(sub, \"annual\", at, self.catalog)\n        self.assertEqual((pr.credit, pr.charge), (6200, 36600))\n        self.assertEqual((pr.new_anchor, pr.next_renewal), (at, date(2029, 2, 28)))\n        self.assertEqual(pr.lines[1].period_end, date(2029, 2, 28))\n        new_sub = Subscription(\"sub\", \"customer\", \"annual\", pr.new_anchor)\n        self.assertEqual(renewal_schedule(new_sub, 4, self.catalog)[-1], date(2032, 2, 29))\nPY\npython -m unittest discover -s tests -p test_proration_regressions.py > /tmp/bill-212-regressions.log 2>&1; cat /tmp/bill-212-regressions.log\n"]
