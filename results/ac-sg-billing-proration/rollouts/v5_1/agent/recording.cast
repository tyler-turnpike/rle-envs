[97.023888, "i", "cat > tests/test_proration_regressions.py <<'PY'\n\"\"\"BILL-212 regressions for finance's rev. 4 proration rules.\"\"\"\nimport calendar\nimport unittest\nfrom datetime import date, timedelta\nfrom decimal import localcontext\nfrom fractions import Fraction\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days, iter_cycles\nfrom billing.catalog import Catalog, Plan\nfrom billing.proration import Subscription, portion, prorate_change, renewal_schedule\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -13), date(2027, 2, 28))\n\n    def test_february_end_is_not_a_sticky_month_end(self):\n        self.assertEqual(add_months(date(2026, 2, 28), 1), date(2026, 3, 28))\n        self.assertEqual(add_months(date(2028, 2, 29), 1), date(2028, 3, 29))\n\n    def test_a"]
[97.023941, "i", "ll_renewal_boundaries_use_original_anchor(self):\n        for day in (28, 29, 30, 31):\n            for interval, step in ((\"month\", 1), (\"year\", 12)):\n                anchor = date(2024, 1, day)\n                renewals = []\n                for k in range(61):\n                    year, month0 = divmod(anchor.year * 12 + anchor.month - 1 + k * step, 12)\n                    month = month0 + 1\n                    renewals.append(date(year, month, min(day, calendar.monthrange(year, month)[1])))\n                for start, end, following in zip(renewals, renewals[1:], renewals[2:]):\n                    with self.subTest(anchor=anchor, interval=interval, end=end):\n                        self.assertEqual(cycle_bounds(anchor, end - timedelta(days=1), interval), (start, end))\n                        self.assertEqual(cycle_bounds(anchor, end, interval), (end, following))\n\n    def test_actual_cycle_lengths(self):\n        cases = [\n            (date(2026, 1, 31), date(2026, 2, 1), \"month\", 28),\n            (date(2028, 1, "]
[97.023954, "i", "31), date(2028, 2, 1), \"month\", 29),\n            (date(2026, 3, 31), date(2026, 4, 1), \"month\", 30),\n            (date(2026, 1, 31), date(2026, 3, 1), \"month\", 31),\n            (date(2024, 2, 29), date(2027, 6, 1), \"year\", 366),\n            (date(2024, 2, 29), date(2028, 6, 1), \"year\", 365),\n        ]\n        for anchor, on, interval, expected in cases:\n            with self.subTest(anchor=anchor, on=on):\n                self.assertEqual(cycle_length_days(anchor, on, interval), expected)\n\n    def test_annual_iteration_returns_to_leap_day(self):\n        cycles = list(iter_cycles(date(2024, 2, 29), date(2028, 2, 29), \"year\"))\n        self.assertEqual(cycles[-2], (date(2027, 2, 28), date(2028, 2, 29)))\n        self.assertEqual(cycles[-1], (date(2028, 2, 29), date(2029, 2, 28)))\n\n    def test_invalid_cycle_requests(self):\n        anchor = date(2026, 1, 31)\n        with self.assertRaises(ValueError):\n            cycle_bounds(anchor, date(2026, 1, 30), \"month\")\n        with self.assertRaises(ValueError):\n          "]
[97.024752, "i", "  cycle_length_days(anchor, anchor, \"week\")\n\n\nclass ExactPortionRegressionTest(unittest.TestCase):\n    def test_rounds_exact_rational_independent_of_decimal_precision(self):\n        with localcontext() as context:\n            context.prec = 2\n            for amount in (1, 3, 4900, 10**40 + 1, 10**40 + 3, -(10**40 + 3)):\n                for numerator, denominator in ((1, 2), (15, 28), (29, 31), (0, 31), (31, 31)):\n                    with self.subTest(amount=amount, fraction=(numerator, denominator)):\n                        self.assertEqual(portion(amount, numerator, denominator),\n                                         round(Fraction(amount * numerator, denominator)))\n\n    def test_rejects_invalid_fractions(self):\n        for numerator, denominator in ((0, 0), (0, -1), (-1, 10), (11, 10)):\n            with self.subTest(fraction=(numerator, denominator)):\n                with self.assertRaises(ValueError):\n                    portion(100, numerator, denominator)\n\n\nclass PlanChangeRegressionTest(unittest.Test"]
