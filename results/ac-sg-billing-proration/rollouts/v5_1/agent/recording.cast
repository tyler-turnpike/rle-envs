[97.025087, "i", "Case):\n    def setUp(self):\n        self.catalog = Catalog({\n            \"old\": Plan(\"old\", \"Old\", \"month\", \"USD\", (\n                (date(2024, 1, 1), 3100), (date(2026, 1, 15), 6200))),\n            \"new\": Plan(\"new\", \"New\", \"month\", \"USD\", (\n                (date(2024, 1, 1), 6200), (date(2026, 1, 15), 9300))),\n            \"annual\": Plan(\"annual\", \"Annual\", \"year\", \"USD\", ((date(2024, 1, 1), 36600),)),\n        })\n\n    def test_prices_are_selected_on_cycle_start_and_change_date(self):\n        sub = Subscription(\"sub\", \"customer\", \"old\", date(2025, 12, 31))\n        pr = prorate_change(sub, \"new\", date(2026, 1, 16), self.catalog)\n        self.assertEqual((pr.credit, pr.charge, pr.total), (1500, 4500, 3000))\n        self.assertEqual((pr.new_anchor, pr.next_renewal), (sub.anchor, date(2026, 1, 31)))\n        self.assertEqual([line.amount for line in pr.lines], [-1500, 4500])\n        self.assertTrue(all(line.period_start == pr.change_at and line.period_end == pr.period_end\n                            for line in p"]
