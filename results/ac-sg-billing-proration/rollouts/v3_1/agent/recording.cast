[31.595637, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/calendar.py')\ns = p.read_text()\ns = s.replace('    # Not every month has a 29th/30th/31st, so stay on a day that always exists.\\n    day = min(anchor.day, 28)', '    # Clamp only when the target month cannot represent the anchor day.\\n    day = min(anchor.day, days_in_month(year, month))')\ns = s.replace('    start = anchor\\n    end = add_months(start, step)\\n    while end <= on:\\n        start = end\\n        end = add_months(start, step)\\n    return start, end', '    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\\n    cycle = elapsed_months // step\\n    start = add_months(anchor, cycle * step)\\n    if start > on:\\n        cycle -= 1\\n        start = add_months(anchor, cycle * step)\\n    # Always use the original anchor so short months never cause drift.\\n    end = add_months(anchor, (cycle + 1) * step)\\n    return start, end')\ns = s.replace('    if interval == \"year\":\\n        return 365\\n    return 30', '    start, end = cycl"]
[31.595685, "i", "e_bounds(anchor, on, interval)\\n    return days_between(start, end)')\np.write_text(s)\np = Path('billing/proration.py')\ns = p.read_text().replace('from decimal import ROUND_HALF_EVEN, Decimal', 'from fractions import Fraction')\ns = s.replace('add_months, cycle_bounds, cycle_length_days, days_between', 'add_months, cycle_bounds, days_between')\ns = s.replace('    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))', '    # Fraction rounds the exact rational once, with ties to even.\\n    return round(Fraction(amount * numerator, denominator))')\ns = s.replace('    period_days = cycle_length_days(sub.anchor, change_at, old.interval)', '    period_days = days_between(start, end)')\ns = s.replace('    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\\n    new_anchor = sub.anchor\\n    next_renewal = end', '    credit = po"]
[31.595705, "i", "rtion(catalog.price(old.plan_id, start), remaining, period_days)\\n    new_price = catalog.price(new.plan_id, change_at)\\n    if old.interval == new.interval:\\n        charge = portion(new_price, remaining, period_days)\\n        new_anchor = sub.anchor\\n        next_renewal = end\\n        charge_description = \"Remaining time\"\\n    else:\\n        charge = new_price\\n        new_anchor = change_at\\n        next_renewal = add_months(new_anchor, new.months)\\n        charge_description = \"Full period\"')\ns = s.replace('f\"Remaining time on {new.name} ({change_at} to {next_renewal})\"', 'f\"{charge_description} on {new.name} ({change_at} to {next_renewal})\"')\np.write_text(s)\nPY\npython -m unittest discover -s tests > /tmp/bill-212-tests.log 2>&1; cat /tmp/bill-212-tests.log\n"]
