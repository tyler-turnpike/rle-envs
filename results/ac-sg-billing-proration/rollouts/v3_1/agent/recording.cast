[62.073772, "i", "cat > tests/test_proration_regressions.py <<'PY'\n\"\"\"Additional BILL-212 coverage for calendar, rounding, and preview periods.\"\"\"\nimport io\nimport json\nimport unittest\nfrom contextlib import redirect_stdout\nfrom datetime import date\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing import __main__ as cli\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.catalog import load_catalog\nfrom billing.proration import Subscription, portion, prorate_change, renewal_schedule\n\nAPP = Path(__file__).resolve().parent.parent\nCASES = json.loads((APP / 'tests/fixtures/plan_changes.json').read_text())['cases']\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_zero_and_negative_month_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -3), date(2027, 12, 31))\n\n    def test_renewal_boundaries_for"]
