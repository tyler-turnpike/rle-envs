[?2004l"""Plan catalog: plan definitions and their price history."""
from __future__ import annotations

import json
from dataclasses import dataclass, field
from datetime import date
from pathlib import Path
from typing import Dict, List, Tuple

from .calendar import interval_months, parse_date

DEFAULT_CATALOG = Path(__file__).resolve().parent.parent / "data" / "catalog.json"


@dataclass(frozen=True)
class Plan:
    plan_id: str
    name: str
    interval: str
    currency: str
    # (effective_from, unit price in minor units), sorted by date
    prices: Tuple[Tuple[date, int], ...] = field(default_factory=tuple)

    @property
    def months(self) -> int:
        return interval_months(self.interval)

    def price_on(self, on: date) -> int:
        """Price in force on ``on`` (the latest entry whose start is <= on)."""
        current = None
        for start, cents in self.prices:
            if start <= on:
                current = cents
            else:
                break
        if current is None:
            raise LookupError(f"plan {self.plan_id} has no price on {on}")
        return current


class Catalog:
    def __init__(self, plans: Dict[str, Plan]):
        self._plans = dict(plans)

    def plan(self, plan_id: str) -> Plan:
        try:
            return self._plans[plan_id]
        except KeyError:
            raise KeyError(f"unknown plan: {plan_id}") from None

    def price(self, plan_id: str, on: date) -> int:
        return self.plan(plan_id).price_on(on)

    def plan_ids(self) -> List[str]:
        return sorted(self._plans)

    def __contains__(self, plan_id: str) -> bool:
        return plan_id in self._plans


def _plan_from_dict(raw: dict) -> Plan:
    history = sorted(
        (parse_date(p["effective_from"]), int(p["unit_amount"])) for p in raw["prices"]
    )
    if not history:
        raise ValueError(f"plan {raw['id']} has an empty price history")
    if raw["interval"] not in ("month", "year"):
        raise ValueError(f"plan {raw['id']} has unknown interval {raw['interval']!r}")
    return Plan(
        plan_id=raw["id"],
        name=raw.get("name", raw["id"]),
        interval=raw["interval"],
        currency=raw.get("currency", "USD"),
        prices=tuple(history),
    )


def load_catalog(path: Path | str = DEFAULT_CATALOG) -> Catalog:
    with open(path, encoding="utf-8") as fh:
        doc = json.load(fh)
    plans = {}
    for raw in doc["plans"]:
        plan = _plan_from_dict(raw)
        if plan.plan_id in plans:
            raise ValueError(f"duplicate plan id {plan.plan_id}")
        plans[plan.plan_id] = plan
    return Catalog(plans)
"""Invoice previews for plan changes."""
from __future__ import annotations

import json
from dataclasses import dataclass, field
from datetime import date
from decimal import ROUND_HALF_EVEN, Decimal
from pathlib import Path
from typing import Dict, List

from .proration import Line, Proration

CURRENCY_EXPONENT = {"USD": 2, "EUR": 2, "GBP": 2, "JPY": 0}


@dataclass
class InvoicePreview:
    sub_id: str
    currency: str
    issued_on: date
    lines: List[Line] = field(default_factory=list)
    balance_before: int = 0

    @property
    def subtotal(self) -> int:
        return sum(line.amount for line in self.lines)

    @property
    def amount_due(self) -> int:
        """What the customer pays now; never negative."""
        return max(0, self.subtotal + self.balance_before)

    @property
    def credit_carried(self) -> int:
        """Credit left on the account after this invoice (positive number)."""
        return max(0, -(self.subtotal + self.balance_before))


def build_preview(proration: Proration, currency: str, balance_before: int = 0) -> InvoicePreview:
    return InvoicePreview(
        sub_id=proration.sub_id,
        currency=currency,
        issued_on=proration.change_at,
        lines=list(proration.lines),
        balance_before=balance_before,
    )


def format_amount(minor: int, currency: str) -> str:
    exp = CURRENCY_EXPONENT.get(currency, 2)
    sign = "-" if minor < 0 else ""
    minor = abs(minor)
    if exp == 0:
        return f"{sign}{minor} {currency}"
    major, frac = divmod(minor, 10 ** exp)
    return f"{sign}{major:,}.{frac:0{exp}d} {currency}"


def to_dict(preview: InvoicePreview) -> Dict:
    return {
        "subscription": preview.sub_id,
        "currency": preview.currency,
        "issued_on": preview.issued_on.isoformat(),
        "lines": [
            {
                "kind": line.kind,
                "plan": line.plan_id,
                "amount": line.amount,
                "period_start": line.period_start.isoformat(),
                "period_end": line.period_end.isoformat(),
                "description": line.description,
            }
            for line in preview.lines
        ],
        "subtotal": preview.subtotal,
        "balance_before": preview.balance_before,
        "amount_due": preview.amount_due,
        "credit_carried": preview.credit_carried,
    }


def render_text(preview: InvoicePreview) -> str:
    out = [f"Invoice preview for {preview.sub_id} ({preview.issued_on})"]
    for line in preview.lines:
        out.append(f"  {line.description:<60} {format_amount(line.amount, preview.currency):>16}")
    out.append(f"  {'Subtotal':<60} {format_amount(preview.subtotal, preview.currency):>16}")
    if preview.balance_before:
        out.append(f"  {'Balance before':<60} {format_amount(preview.balance_before, preview.currency):>16}")
    out.append(f"  {'Amount due':<60} {format_amount(preview.amount_due, preview.currency):>16}")
    if preview.credit_carried:
        out.append(f"  {'Credit carried forward':<60} {format_amount(preview.credit_carried, preview.currency):>16}")
    return "\n".join(out)


def load_partner_rates(path: Path | str) -> Dict[str, Decimal]:
    """Commission rate per reseller partner, as contracted (data/partners.json)."""
    with open(path, encoding="utf-8") as fh:
        doc = json.load(fh)
    return {p["id"]: Decimal(p["commission_rate"]) for p in doc["partners"]}


def commission_line(preview: InvoicePreview, rate: Decimal, partner_id: str) -> Line:
    """Partner-channel invoices carry the reseller's commission as a credit line."""
    if not Decimal(0) <= rate < Decimal(1):
        raise ValueError(f"commission rate {rate} for {partner_id} out of range")
    amount = int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
    return Line("commission", partner_id, -amount, preview.issued_on, preview.issued_on,
                f"Partner commission {partner_id} ({rate * 100:.1f}%)")
[?2004hroot@09ab505df2f1:/app# cat billing/__main__.py; cat data/catalog.json; cat data/partners.json
[?2004l"""Command line: preview the invoice for a plan change.

    python -m billing preview --sub data/subscriptions.json --id sub_1042 \
        --to pro-monthly --at 2026-01-31 [--json]
"""
from __future__ import annotations

import argparse
import json
import sys

from .calendar import parse_date
from .catalog import DEFAULT_CATALOG, load_catalog
from .invoice import build_preview, render_text, to_dict
from .proration import Subscription, prorate_change


def _load_subscription(path: str, sub_id: str) -> tuple[Subscription, int]:
    with open(path, encoding="utf-8") as fh:
        rows = json.load(fh)["subscriptions"]
    for row in rows:
        if row["id"] == sub_id:
            sub = Subscription(row["id"], row["customer"], row["plan"], parse_date(row["anchor"]))
            return sub, int(row.get("balance", 0))
    raise SystemExit(f"no subscription {sub_id} in {path}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="billing")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("preview", help="preview a mid-cycle plan change")
    p.add_argument("--sub", required=True, help="subscriptions JSON file")
    p.add_argument("--id", required=True, help="subscription id")
    p.add_argument("--to", required=True, help="new plan id")
    p.add_argument("--at", required=True, help="change date, YYYY-MM-DD")
    p.add_argument("--catalog", default=str(DEFAULT_CATALOG))
    p.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    catalog = load_catalog(args.catalog)
    subscription, balance = _load_subscription(args.sub, args.id)
    proration = prorate_change(subscription, args.to, parse_date(args.at), catalog)
    currency = catalog.plan(args.to).currency
    preview = build_preview(proration, currency, balance_before=balance)
    if args.json:
        json.dump(to_dict(preview), sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print(render_text(preview))
    return 0


if __name__ == "__main__":
    sys.exit(main())
