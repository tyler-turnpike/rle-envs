[54.023964, "o", "    def test_rejects_bad_fraction(self):\r\n        with self.assertRaises(ValueError):\r\n            portion(100, 5, 4)\r\n\r\n\r\nclass InvoiceTest(unittest.TestCase):\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_downgrade_carries_credit(self):\r\n        sub = Subscription(\"sub_9\", \"cus_9\", \"team-monthly\", date(2025, 3, 14))\r\n        pr = prorate_change(sub, \"starter-monthly\", date(2026, 6, 20), self.catalog)\r\n        preview = build_preview(pr, \"USD\")\r\n        self.assertEqual(preview.amount_due, 0)\r\n        self.assertEqual(preview.credit_carried, pr.credit - pr.charge)\r\n        self.assertEqual([l[\"kind\"] for l in to_dict(preview)[\"lines\"]], [\"credit\", \"charge\"])\r\n\r\n    def test_format_amount(self):\r\n        self.assertEqual(format_amount(123456, \"USD\"), \"1,234.56 USD\")\r\n        self.assertEqual(format_amount(-5, \"USD\"), \"-0.05 USD\")\r\n        self.assertEqual(format_amount(500, \"JPY\"), \"500 JPY\")\r\n\r\n    def test_cli_json_preview(self):\r\n        buf = io."]
[54.023971, "o", "StringIO()\r\n        with redirect_stdout(buf):\r\n            cli.main([\"preview\", \"--sub\", str(APP / \"data\" / \"subscriptions.json\"),\r\n                      \"--id\", \"sub_1001\", \"--to\", \"pro-monthly\", \"--at\", \"2026-06-20\",\r\n                      \"--catalog\", str(APP / \"data\" / \"catalog.json\"), \"--json\"])\r\n        doc = json.loads(buf.getvalue())\r\n        self.assertEqual(doc[\"subscription\"], \"sub_1001\")\r\n        self.assertEqual(doc[\"subtotal\"], 2960)\r\n        self.assertEqual(doc[\"amount_due\"], 2960)\r\n\r\n\r\nclass PartnerInvoiceTest(unittest.TestCase):\r\n    \"\"\"Partner-channel subscriptions: the change preview carries the partner's commission.\"\"\"\r\n\r\n    def test_partner_commission_lines(self):\r\n        catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n        rates = load_partner_rates(APP / \"data\" / \"partners.json\")\r\n        rows = json.loads((APP / \"data\" / \"subscriptions.json\").read_text())[\"subscriptions\"]\r\n        partner_rows = [r for r in rows if r.get(\"partner\")]\r\n        self.assertTrue(partner_rows)\r"]
[54.023983, "o", "\n        for row in partner_rows:\r\n            with self.subTest(sub=row[\"id\"], partner=row[\"partner\"]):\r\n                sub = Subscription(row[\"id\"], row[\"customer\"], row[\"plan\"], date.fromisoformat(row[\"anchor\"]))\r\n                pr = prorate_change(sub, row[\"upgrade_to\"], date.fromisoformat(row[\"upgrade_on\"]), catalog)\r\n                preview = build_preview(pr, \"USD\")\r\n                rate = rates[row[\"partner\"]]\r\n                line = commission_line(preview, rate, row[\"partner\"])\r\n                want = -int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n                self.assertEqual(line.kind, \"commission\")\r\n                self.assertEqual(line.amount, want)\r\n\r\n\r\nQUARANTINE = HERE / \"quarantine.txt\"\r\n\r\n"]
[54.025034, "o", "\"\"\"Billing-cycle calendar arithmetic.\r\n\r\nSubscriptions bill on an *anchor* date. Monthly plans renew every month on the\r\nanchor's day of month, annual plans every twelve months. See\r\ndocs/proration.md for the rules finance signed off on.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar as _stdcal\r\nfrom datetime import date, timedelta\r\nfrom typing import Iterator, Tuple\r\n\r\nINTERVAL_MONTHS = {\"month\": 1, \"year\": 12}\r\n\r\n\r\n"]
[54.025265, "o", "def interval_months(interval: str) -> int:\r\n    try:\r\n        return INTERVAL_MONTHS[interval]\r\n    except KeyError:\r\n        raise ValueError(f\"unknown billing interval: {interval!r}\") from None\r\n\r\n\r\ndef days_in_month(year: int, month: int) -> int:\r\n    return _stdcal.monthrange(year, month)[1]\r\n\r\n\r\ndef is_leap(year: int) -> bool:\r\n    return _stdcal.isleap(year)\r\n\r\n\r\ndef add_months(anchor: date, months: int) -> date:\r\n    \"\"\"Move ``anchor`` forward by ``months`` calendar months.\"\"\"\r\n    total = anchor.month - 1 + months\r\n    year = anchor.year + total // 12\r\n    month = total % 12 + 1\r\n    # Clamp only when the target month cannot represent the anchor day.\r\n    day = min(anchor.day, days_in_month(year, month))\r\n    return date(year, month, day)\r\n\r\n\r\ndef cycle_bounds(anchor: date, on: date, interval: str) -> Tuple[date, date]:\r\n    \"\"\"Return ``(start, end)`` of the billing cycle containing ``on``.\r\n\r\n    ``start`` is inclusive and ``end`` is exclusive (the next renewal date).\r\n    \"\"\"\r\n    if on < anchor:\r\n "]
[54.025328, "o", "       raise ValueError(f\"{on} is before the subscription anchor {anchor}\")\r\n    step = interval_months(interval)\r\n    elapsed_months = (on.year - anchor.year) * 12 + on.month - anchor.month\r\n    cycle = elapsed_months // step\r\n    start = add_months(anchor, cycle * step)\r\n    if start > on:\r\n        cycle -= 1\r\n        start = add_months(anchor, cycle * step)\r\n    # Always use the original anchor so short months do not cause drift.\r\n    end = add_months(anchor, (cycle + 1) * step)\r\n    return start, end\r\n\r\n\r\ndef cycle_length_days(anchor: date, on: date, interval: str) -> int:\r\n    start, end = cycle_bounds(anchor, on, interval)\r\n    return (end - start).days\r\n\r\n\r\ndef iter_cycles(anchor: date, until: date, interval: str) -> Iterator[Tuple[date, date]]:\r\n    \"\"\"Yield every cycle from the anchor up to and including the one containing ``until``.\"\"\"\r\n    start, end = cycle_bounds(anchor, anchor, interval)\r\n    while start <= until:\r\n        yield start, end\r\n        start, end = cycle_bounds(anchor, end, interval"]
[54.02536, "o", ")\r\n\r\n\r\ndef days_between(a: date, b: date) -> int:\r\n    return (b - a).days\r\n\r\n\r\ndef parse_date(text: str) -> date:\r\n    return date.fromisoformat(text)\r\n\r\n\r\ndef end_of_day(d: date) -> date:\r\n    return d + timedelta(days=1)\r\n\u001b[?2004hroot@fa24857333d1:/app# "]
