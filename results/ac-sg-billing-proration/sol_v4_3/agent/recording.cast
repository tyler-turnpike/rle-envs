[78.337274, "i", "ts(self):\n        with self.assertRaises(ValueError):\n            cycle_bounds(date(2026, 1, 31), date(2026, 1, 30), \"month\")\n        with self.assertRaises(ValueError):\n            cycle_length_days(date(2026, 1, 31), date(2026, 2, 1), \"week\")\n\n\nclass ExactPortionRegressionTest(unittest.TestCase):\n    def test_large_half_even_ties_and_decimal_context(self):\n        even = 10 ** 40\n        with localcontext() as context:\n            context.prec = 2\n            for sign in (1, -1):\n                self.assertEqual(portion(sign * (2 * even + 1), 1, 2), sign * even)\n                self.assertEqual(portion(sign * (2 * even + 3), 1, 2), sign * (even + 2))\n            self.assertEqual(portion(100, 1, 3), 33)\n            self.assertEqual(portion(100, 2, 3), 67)\n\n    def test_fraction_validation(self):\n        for numerator, denominator in [(1, 0), (0, -1), (-1, 2), (3, 2)]:\n            with self.subTest(numerator=numerator, denominator=denominator):\n                with self.assertRaises(ValueError):\n             "]
