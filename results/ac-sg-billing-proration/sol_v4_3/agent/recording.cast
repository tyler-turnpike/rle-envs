[78.337319, "i", "       portion(100, numerator, denominator)\n\n\nclass ProrationRegressionTest(unittest.TestCase):\n    def setUp(self):\n        self.catalog = load_catalog()\n\n    def test_new_price_is_effective_on_change_date(self):\n        sub = Subscription(\"sub_x\", \"cus_x\", \"pro-monthly\", date(2026, 6, 20))\n        got = prorate_change(sub, \"starter-monthly\", date(2026, 7, 5), self.catalog)\n        self.assertEqual((got.credit, got.charge), (2450, 750))\n        self.assertEqual((got.new_anchor, got.next_renewal),\n                         (sub.anchor, date(2026, 7, 20)))\n\n    def test_monthly_to_annual_on_leap_day(self):\n        sub = Subscription(\"sub_x\", \"cus_x\", \"pro-monthly\", date(2027, 12, 31))\n        change = date(2028, 2, 29)\n        got = prorate_change(sub, \"pro-annual\", change, self.catalog)\n        self.assertEqual((got.credit, got.charge), (4900, 49000))\n        self.assertEqual(got.new_anchor, change)\n        self.assertEqual(got.next_renewal, date(2029, 2, 28))\n        credit, charge = got.lines\n        self.as"]
[78.337359, "o", "> "]
[78.337367, "i", "sertEqual((credit.amount, credit.period_start, credit.period_end),\n                         (-4900, change, date(2028, 3, 31)))\n        self.assertEqual((charge.amount, charge.period_start, charge.period_end),\n                         (49000, change, date(2029, 2, 28)))\n\n    def test_worked_examples_through_cli(self):\n        cases = json.loads((APP / \"tests/fixtures/plan_changes.json\").read_text())[\"cases\"]\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / \"subscriptions.json\"\n            for case in cases:\n                with self.subTest(case=case[\"id\"]):\n                    path.write_text(json.dumps({\"subscriptions\": [{\n                        \"id\": \"sub_cli\", \"customer\": \"cus_cli\", \"plan\": case[\"plan\"],\n                        \"anchor\": case[\"anchor\"], \"balance\": 0,\n                    }]}))\n                    result = subprocess.run(\n                        [sys.executable, \"-m\", \"billing\", \"preview\", \"--sub\", str(path),\n                         \"--id\", \"su"]
[78.337518, "o", "import json"]
[78.337529, "i", "b_cli\", \"--to\", case[\"to\"], \"--at\", case[\"at\"], \"--json\"],\n                        cwd=APP, capture_output=True, text=True, check=True,\n                    )\n                    invoice = json.loads(result.stdout)\n                    expected = case[\"expected\"]\n                    self.assertEqual(invoice[\"subtotal\"], expected[\"total\"])\n                    self.assertEqual(invoice[\"amount_due\"], max(0, expected[\"total\"]))\n                    self.assertEqual(invoice[\"credit_carried\"], max(0, -expected[\"total\"]))\n                    credit, charge = invoice[\"lines\"]\n                    self.assertEqual((credit[\"kind\"], credit[\"amount\"]),\n                                     (\"credit\", -expected[\"credit\"]))\n                    self.assertEqual((charge[\"kind\"], charge[\"amount\"]),\n                                     (\"charge\", expected[\"charge\"]))\n                    self.assertEqual(credit[\"period_start\"], case[\"at\"])\n                    self.assertEqual(credit[\"period_end\"], expected[\"period_end\"])\n           "]
