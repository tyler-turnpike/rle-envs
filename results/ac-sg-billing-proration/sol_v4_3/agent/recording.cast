[78.336684, "i", "cat > tests/test_proration_regressions.py <<'PY'\n\"\"\"BILL-212 coverage beyond finance's worked examples.\"\"\"\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom datetime import date\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\nfrom billing.catalog import load_catalog\nfrom billing.invoice import build_preview\nfrom billing.proration import Subscription, portion, prorate_change\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_add_months_zero_and_negative_offsets(self):\n        anchor = date(2028, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2028, 2, 29))\n        self.assertEqual(add_months(anchor, -13), date(2027, 2, 28))\n\n    def test_clamped_renewals_start_new_cycles(self):\n        cases = [\n            (date(2026, 1, 31), date(2026, 2, 28), \"month\", date(2026, 3, 31)),\n"]
[78.337098, "i", "            (date(2028, 1, 30), date(2028, 2, 29), \"month\", date(2028, 3, 30)),\n            (date(2024, 2, 29), date(2028, 2, 29), \"year\", date(2029, 2, 28)),\n        ]\n        for anchor, on, interval, end in cases:\n            with self.subTest(anchor=anchor, on=on):\n                self.assertEqual(cycle_bounds(anchor, on, interval), (on, end))\n\n    def test_actual_cycle_lengths(self):\n        cases = [\n            (date(2026, 1, 31), date(2026, 2, 1), \"month\", 28),\n            (date(2028, 1, 31), date(2028, 2, 1), \"month\", 29),\n            (date(2026, 1, 31), date(2026, 3, 1), \"month\", 31),\n            (date(2026, 1, 31), date(2026, 4, 1), \"month\", 30),\n            (date(2024, 2, 29), date(2026, 3, 1), \"year\", 365),\n            (date(2024, 2, 29), date(2027, 3, 1), \"year\", 366),\n        ]\n        for anchor, on, interval, days in cases:\n            with self.subTest(on=on, interval=interval):\n                self.assertEqual(cycle_length_days(anchor, on, interval), days)\n\n    def test_invalid_cycle_reques"]
