[101.918811, "i", "python - <<'PY'\nfrom datetime import date, timedelta\nfrom billing.calendar import add_months, cycle_bounds\nchecks = 0\nfor year in (1999, 2000, 2024, 2026, 2028, 2096):\n    for month in range(1, 13):\n        for day in (28, 29, 30, 31):\n            try:\n                anchor = date(year, month, day)\n            except ValueError:\n                continue\n            for interval, step in (('month', 1), ('year', 12)):\n                for k in range(10):\n                    start = add_months(anchor, k * step)\n                    end = add_months(anchor, (k + 1) * step)\n                    for on in (start, end - timedelta(days=1)):\n                        assert cycle_bounds(anchor, on, interval) == (start, end), (anchor, on, interval)\n                        checks += 1\nprint(f'Calendar boundary cross-check: {checks} assertions passed')\nPY\npython -m billing preview --sub data/subscriptions.json --id sub_1042 --to team-monthly --at 2026-02-13\npython -m billing preview --sub data/subscriptions.json --id sub_107"]
[101.91901, "i", "7 --to pro-monthly --at 2028-02-14\n"]
