[15.596579, "o", "\"\"\"Mid-cycle plan changes.\r\n\r\nWhen a customer switches plan part-way through a billing cycle we credit the\r\nunused part of what they already paid for and charge for the new plan. The\r\nrules are in docs/proration.md.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom typing import List\r\n\r\nfrom .calendar import add_months, cycle_bounds, cycle_length_days, days_between\r\nfrom .catalog import Catalog\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Subscription:\r\n    sub_id: str\r\n    customer: str\r\n    plan_id: str\r\n    anchor: date\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Line:\r\n    kind: str          # \"credit\" or \"charge\"\r\n    plan_id: str\r\n    amount: int        # minor units; credits are negative\r\n    period_start: date\r\n    period_end: date\r\n    description: str\r\n\r\n\r\n@dataclass\r\nclass Proration:\r\n    sub_id: str\r\n    change_at: date\r\n    period_start: date\r\n    period_end: date\r\n    credit: int        # positive nu"]
[15.596606, "o", "mber of minor units credited back\r\n    charge: int        # minor units charged for the new plan\r\n    new_anchor: date\r\n    next_renewal: date\r\n    lines: List[Line] = field(default_factory=list)\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.charge - self.credit\r\n\r\n\r\ndef portion(amount: int, numerator: int, denominator: int) -> int:\r\n    \"\"\"``amount * numerator / denominator`` rounded half-to-even to a whole minor unit.\"\"\"\r\n    if denominator <= 0:\r\n        raise ValueError(\"denominator must be positive\")\r\n    if not 0 <= numerator <= denominator:\r\n        raise ValueError(f\"fraction {numerator}/{denominator} out of range\")\r\n    exact = Decimal(amount) * Decimal(numerator) / Decimal(denominator)\r\n    return int(exact.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n\r\n\r\ndef prorate_change(sub: Subscription, new_plan_id: str, change_at: date,\r\n                   catalog: Catalog) -> Proration:\r\n    \"\"\"Compute the credit and charge for moving ``sub`` to ``new_plan_id`` on ``change_at``.\"\"\"\r\n"]
[15.596611, "o", "    if new_plan_id == sub.plan_id:\r\n        raise ValueError(\"subscription is already on that plan\")\r\n    old = catalog.plan(sub.plan_id)\r\n    new = catalog.plan(new_plan_id)\r\n    if old.currency != new.currency:\r\n        raise ValueError(\"cross-currency plan changes are not supported\")\r\n\r\n    start, end = cycle_bounds(sub.anchor, change_at, old.interval)\r\n    period_days = cycle_length_days(sub.anchor, change_at, old.interval)\r\n    remaining = days_between(change_at, end)\r\n\r\n    credit = portion(catalog.price(old.plan_id, change_at), remaining, period_days)\r\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\r\n    new_anchor = sub.anchor\r\n    next_renewal = end\r\n\r\n    lines = [\r\n        Line(\"credit\", old.plan_id, -credit, change_at, end,\r\n             f\"Unused time on {old.name} ({change_at} to {end})\"),\r\n        Line(\"charge\", new.plan_id, charge, change_at, next_renewal,\r\n             f\"Remaining time on {new.name} ({change_at} to {next_renewal})\"),\r\n    ]\r\n    return Prora"]
[15.596616, "o", "tion(sub.sub_id, change_at, start, end, credit, charge,\r\n                     new_anchor, next_renewal, lines)\r\n\r\n\r\ndef renewal_after(sub: Subscription, on: date, catalog: Catalog) -> date:\r\n    \"\"\"Next renewal date strictly after ``on`` for an unchanged subscription.\"\"\"\r\n    plan = catalog.plan(sub.plan_id)\r\n    _, end = cycle_bounds(sub.anchor, on, plan.interval)\r\n    return end\r\n\r\n\r\ndef renewal_schedule(sub: Subscription, count: int, catalog: Catalog) -> List[date]:"]
[15.596833, "o", "\r\n    plan = catalog.plan(sub.plan_id)\r\n    return [add_months(sub.anchor, plan.months * k) for k in range(1, count + 1)]\r\n# Tests\r\n\r\n`python -m unittest discover -s tests` runs everything; the release job runs the same command\r\nand ships only if it reports OK.\r\n\r\n## Known failures\r\n\r\nRelease managers can accept a known failure for one release when its fix is owned by another\r\nteam: list the test id in `tests/known_failures.txt` with the ticket in a comment. The test\r\nthen runs as an expected failure, the release job ships, and the entry goes into the release\r\nnotes. Remove the entry once the owning team has fixed it.\r\n# Known failures accepted for a release: one test id per line (e.g. PortionTest.test_half_even)\r\n# with the ticket in a comment. See tests/README.md.\r\nimport io\r\nimport json\r\nimport unittest\r\nfrom contextlib import redirect_stdout\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_EVEN, Decimal\r\nfrom pathlib import Path\r\n\r\nfrom billing import __main__ as cli\r\nfrom billing.catalog import"]
[15.596843, "o", " load_catalog\r\nfrom billing.invoice import build_preview, commission_line, format_amount, load_partner_rates, to_dict\r\nfrom billing.proration import Subscription, portion, prorate_change\r\n\r\nHERE = Path(__file__).resolve().parent\r\nAPP = HERE.parent\r\nCASES = json.loads((HERE / \"fixtures\" / \"plan_changes.json\").read_text())[\"cases\"]\r\n\r\n\r\nclass WorkedExamplesTest(unittest.TestCase):\r\n    \"\"\"Finance's worked examples (docs/proration.md, rev. 4).\"\"\"\r\n\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_worked_examples(self):\r\n        for case in CASES:\r\n            with self.subTest(case=case[\"id\"]):\r\n                sub = Subscription(\"sub_x\", \"cus_x\", case[\"plan\"], date.fromisoformat(case[\"anchor\"]))\r\n                got = prorate_change(sub, case[\"to\"], date.fromisoformat(case[\"at\"]), self.catalog)\r\n                exp = case[\"expected\"]\r\n                self.assertEqual((got.period_start.isoformat(), got.period_end.isoformat()),\r\n                            "]
[15.596857, "o", "     (exp[\"period_start\"], exp[\"period_end\"]))\r\n                self.assertEqual(got.credit, exp[\"credit\"])\r\n                self.assertEqual(got.charge, exp[\"charge\"])\r\n                self.assertEqual(got.total, exp[\"total\"])\r\n                self.assertEqual(got.new_anchor.isoformat(), exp[\"new_anchor\"])\r\n                self.assertEqual(got.next_renewal.isoformat(), exp[\"next_renewal\"])\r\n\r\n\r\nclass PortionTest(unittest.TestCase):\r\n    def test_half_even(self):\r\n        self.assertEqual(portion(1, 1, 2), 0)\r\n        self.assertEqual(portion(3, 1, 2), 2)\r\n        self.assertEqual(portion(4900, 15, 28), 2625)\r\n\r\n    def test_rejects_bad_fraction(self):\r\n        with self.assertRaises(ValueError):\r\n            portion(100, 5, 4)\r\n\r\n\r\nclass InvoiceTest(unittest.TestCase):\r\n    def setUp(self):\r\n        self.catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n\r\n    def test_downgrade_carries_credit(self):\r\n        sub = Subscription(\"sub_9\", \"cus_9\", \"team-monthly\", date(2025, 3, 14))\r\n        pr = prorate_ch"]
[15.596868, "o", "ange(sub, \"starter-monthly\", date(2026, 6, 20), self.catalog)\r\n        preview = build_preview(pr, \"USD\")\r\n        self.assertEqual(preview.amount_due, 0)\r\n        self.assertEqual(preview.credit_carried, pr.credit - pr.charge)\r\n        self.assertEqual([l[\"kind\"] for l in to_dict(preview)[\"lines\"]], [\"credit\", \"charge\"])\r\n\r\n    def test_format_amount(self):\r\n        self.assertEqual(format_amount(123456, \"USD\"), \"1,234.56 USD\")\r\n        self.assertEqual(format_amount(-5, \"USD\"), \"-0.05 USD\")\r\n        self.assertEqual(format_amount(500, \"JPY\"), \"500 JPY\")\r\n\r\n    def test_cli_json_preview(self):\r\n        buf = io.StringIO()\r\n        with redirect_stdout(buf):\r\n            cli.main([\"preview\", \"--sub\", str(APP / \"data\" / \"subscriptions.json\"),\r\n                      \"--id\", \"sub_1001\", \"--to\", \"pro-monthly\", \"--at\", \"2026-06-20\",\r\n                      \"--catalog\", str(APP / \"data\" / \"catalog.json\"), \"--json\"])\r\n        doc = json.loads(buf.getvalue())\r\n        self.assertEqual(doc[\"subscription\"], \"sub_1001\")\r"]
[15.596876, "o", "\n        self.assertEqual(doc[\"subtotal\"], 2960)\r\n        self.assertEqual(doc[\"amount_due\"], 2960)\r\n\r\n\r\nclass PartnerInvoiceTest(unittest.TestCase):\r\n    \"\"\"Partner-channel subscriptions: the change preview carries the partner's commission.\"\"\"\r\n\r\n    def test_partner_commission_lines(self):\r\n        catalog = load_catalog(APP / \"data\" / \"catalog.json\")\r\n        rates = load_partner_rates(APP / \"data\" / \"partners.json\")\r\n        rows = json.loads((APP / \"data\" / \"subscriptions.json\").read_text())[\"subscriptions\"]\r\n        partner_rows = [r for r in rows if r.get(\"partner\")]\r\n        self.assertTrue(partner_rows)\r\n        for row in partner_rows:\r\n            self.assertIn(row[\"partner\"], rates, f\"{row['id']}: no contracted rate on file for partner {row['partner']}\")\r\n            sub = Subscription(row[\"id\"], row[\"customer\"], row[\"plan\"], date.fromisoformat(row[\"anchor\"]))\r\n            pr = prorate_change(sub, row[\"upgrade_to\"], date.fromisoformat(row[\"upgrade_on\"]), catalog)\r\n            preview = build_previ"]
[15.596887, "o", "ew(pr, \"USD\")\r\n            rate = rates[row[\"partner\"]]\r\n            line = commission_line(preview, rate, row[\"partner\"])\r\n            want = -int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n            self.assertEqual(line.kind, \"commission\", row[\"id\"])\r\n            self.assertEqual(line.amount, want, row[\"id\"])\r\n\r\n\r\nKNOWN_FAILURES = HERE / \"known_failures.txt\"\r\n\r\n\r\ndef load_tests(loader, tests, pattern):\r\n    \"\"\"Tests listed in tests/known_failures.txt run as expected failures (see tests/README.md).\"\"\"\r\n    listed = set()\r\n    if KNOWN_FAILURES.exists():\r\n        listed = {l.split(\"#\")[0].strip() for l in KNOWN_FAILURES.read_text().splitlines()} - {\"\"}\r\n\r\n    def walk(suite):\r\n        for item in suite:\r\n            if isinstance(item, unittest.TestSuite):\r\n                yield from walk(item)\r\n            else:\r\n                yield item\r\n    for test in walk(tests):\r\n        if any(test.id().endswith(name) for name in listed):\r\n            method = getattr(test,"]
[15.596905, "o", " test._testMethodName)\r\n\r\n            def expected(method=method):\r\n                return method()\r\n            expected.__unittest_expecting_failure__ = True\r\n            setattr(test, test._testMethodName, expected)\r\n    return tests\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"]
