[81.722339, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class CalendarRegressionTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_month_arithmetic_preserves_valid_days(self):\r\n\u001b[?2004l\r\u001b[?2004h>         anchor = date(2026, 3, 31)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(add_months(anchor, 0), anchor)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(add_months(anchor, -1), date(2026, 2, 28))\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(add_months(date(2028, 2, 29), 48), date(2032, 2, 29))\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(add_months(date(2096, 2, 29), 48), date(2100, 2, 28))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_renewal_day_starts_new_cycle(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_bounds(date(2026, 1, 31), date(2026, 2, 28), 'month'),\r\n\u001b[?2004l\r\u001b[?2004h>                          (date(2026, 2, 28), date(2026, 3, 31)))\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2028, 2, 29), 'year'),\r\n\u001b[?2004l\r\u001b[?2004h>                          (date(2"]
[81.722363, "o", "028, 2, 29), date(2029, 2, 28)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_actual_cycle_lengths(self):\r\n\u001b[?2004l\r\u001b[?2004h>         anchor = date(2026, 1, 31)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_length_days(anchor, anchor, 'month'), 28)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_length_days(anchor, date(2026, 3, 1), 'month'), 31)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 3, 1), 'year'), 366)\r\n\u001b[?2004l\r\u001b[?2004h>         with self.assertRaises(ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>             cycle_bounds(anchor, date(2026, 1, 30), 'month')\r\n\u001b[?2004l\r\u001b[?2004h>         with self.assertRaises(ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>             cycle_length_days(anchor, anchor, 'week')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ExactPortionRegressionTest(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_rounding_does_not_depend_on_decimal_context(self):\r\n\u001b[?2004l\r\u001b[?2004h>         with localcontext() as context:\r\n\u001b"]
