[47.546299, "i", "hange_at), remaining, period_days)\\n    charge = portion(catalog.price(new.plan_id, change_at), remaining, period_days)\\n    new_anchor = sub.anchor\\n    next_renewal = end', '''    credit = portion(catalog.price(old.plan_id, start), remaining, period_days)\n    new_price = catalog.price(new.plan_id, change_at)\n    if old.interval == new.interval:\n        charge = portion(new_price, remaining, period_days)\n        new_anchor = sub.anchor\n        next_renewal = end\n    else:\n        charge = new_price\n        new_anchor = change_at\n        next_renewal = add_months(new_anchor, new.months)''')\np.write_text(s)\nPY\npython -m unittest discover -s tests\n"]
