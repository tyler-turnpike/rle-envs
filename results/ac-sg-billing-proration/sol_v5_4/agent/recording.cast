[81.718709, "i", "cat > tests/test_proration_regressions.py <<'PY'\n\"\"\"Additional regression coverage for BILL-212 (finance rules rev. 4).\"\"\"\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom datetime import date\nfrom decimal import localcontext\nfrom pathlib import Path\n\nfrom billing.calendar import add_months, cycle_bounds, cycle_length_days\n\nfrom billing.proration import portion\n\nAPP = Path(__file__).resolve().parent.parent\n\n\nclass CalendarRegressionTest(unittest.TestCase):\n    def test_month_arithmetic_preserves_valid_days(self):\n        anchor = date(2026, 3, 31)\n        self.assertEqual(add_months(anchor, 0), anchor)\n        self.assertEqual(add_months(anchor, -1), date(2026, 2, 28))\n        self.assertEqual(add_months(date(2028, 2, 29), 48), date(2032, 2, 29))\n        self.assertEqual(add_months(date(2096, 2, 29), 48), date(2100, 2, 28))\n\n    def test_renewal_day_starts_new_cycle(self):\n        self.assertEqual(cycle_bounds(date(2026, 1, 31), date(2026, 2, 28), 'month'),\n                       "]
[81.71876, "i", "  (date(2026, 2, 28), date(2026, 3, 31)))\n        self.assertEqual(cycle_bounds(date(2024, 2, 29), date(2028, 2, 29), 'year'),\n                         (date(2028, 2, 29), date(2029, 2, 28)))\n\n    def test_actual_cycle_lengths(self):\n        anchor = date(2026, 1, 31)\n        self.assertEqual(cycle_length_days(anchor, anchor, 'month'), 28)\n        self.assertEqual(cycle_length_days(anchor, date(2026, 3, 1), 'month'), 31)\n        self.assertEqual(cycle_length_days(date(2024, 2, 29), date(2027, 3, 1), 'year'), 366)\n        with self.assertRaises(ValueError):\n            cycle_bounds(anchor, date(2026, 1, 30), 'month')\n        with self.assertRaises(ValueError):\n            cycle_length_days(anchor, anchor, 'week')\n\n\nclass ExactPortionRegressionTest(unittest.TestCase):\n    def test_rounding_does_not_depend_on_decimal_context(self):\n        with localcontext() as context:\n            context.prec = 2\n            self.assertEqual(portion(9900, 15, 31), 4790)\n            self.assertEqual(portion(10**40 + 3, 1, 2), "]
[81.718864, "i", "5 * 10**39 + 2)\n\n    def test_half_even_in_both_directions(self):\n        for amount, expected in [(1, 0), (3, 2), (5, 2), (7, 4), (-3, -2), (-5, -2)]:\n            with self.subTest(amount=amount):\n                self.assertEqual(portion(amount, 1, 2), expected)\n\n\nclass WorkedExamplesCLIRegressionTest(unittest.TestCase):\n    def test_all_examples_as_json_previews(self):\n        cases = json.loads((APP / 'tests/fixtures/plan_changes.json').read_text())['cases']\n        with tempfile.TemporaryDirectory() as directory:\n            subscriptions = Path(directory) / 'subscriptions.json'\n            for case in cases:\n                with self.subTest(case=case['id']):\n                    subscriptions.write_text(json.dumps({'subscriptions': [{\n                        'id': 'sub_example', 'customer': 'cus_example',\n                        'plan': case['plan'], 'anchor': case['anchor'], 'balance': 0,\n                    }]}))\n                    result = subprocess.run([\n                        sys.executable, '-m'"]
