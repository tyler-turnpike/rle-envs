[131.289095, "i", "python - <<'PY'\nfrom datetime import date, timedelta\nfrom billing.calendar import add_months, cycle_bounds\nchecked = 0\nfor year in (1999, 2000, 2024, 2026, 2096, 2100):\n    for month in range(1, 13):\n        for day in (28, 29, 30, 31):\n            try:\n                anchor = date(year, month, day)\n            except ValueError:\n                continue\n            for interval, step in [('month', 1), ('year', 12)]:\n                for k in range(9):\n                    start = add_months(anchor, k * step)\n                    end = add_months(anchor, (k + 1) * step)\n                    for on in (start, start + (end - start) // 2, end - timedelta(days=1)):\n                        assert cycle_bounds(anchor, on, interval) == (start, end), (anchor, on, interval)\n                        checked += 1\nprint(f'Calendar cross-check passed: {checked} boundary/mid-cycle dates')\nPY\npython -m billing preview --sub data/subscriptions.json --id sub_1042 --to team-monthly --at 2026-03-10\npython -m billing preview --sub d"]
[131.290955, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date, timedelta\r\n\u001b[?2004l\r\u001b[?2004h> from billing.calendar import add_months, cycle_bounds\r\n\u001b[?2004l\r\u001b[?2004h> checked = 0\r\n\u001b[?2004l\r\u001b[?2004h> for year in (1999, 2000, 2024, 2026, 2096, 2100):\r\n\u001b[?2004l\r\u001b[?2004h>     for month in range(1, 13):\r\n\u001b[?2004l\r\u001b[?2004h>         for day in (28, 29, 30, 31):\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 anchor = date(year, month, day)\r\n\u001b[?2004l\r\u001b[?2004h>             except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             for interval, step in [('month', 1), ('year', 12)]:\r\n\u001b[?2004l\r\u001b[?2004h>                 for k in range(9):\r\n\u001b[?2004l\r\u001b[?2004h>                     start = add_months(anchor, k * step)\r\n\u001b[?2004l\r\u001b[?2004h>                     end = add_months(anchor, (k + 1) * step)\r\n\u001b[?2004l\r\u001b[?2004h>                     for on in (start, start + (end - start) // 2, end - timedelta(days=1)):\r\n\u001b[?2004l\r\u001b[?2004h>                         assert cycle_"]
