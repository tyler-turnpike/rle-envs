[13.926886, "o", "            line = commission_line(preview, rate, row[\"partner\"])\r\n            want = -int((Decimal(preview.subtotal) * rate).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))\r\n            self.assertEqual(line.kind, \"commission\", row[\"id\"])\r\n            self.assertEqual(line.amount, want, row[\"id\"])\r\n\r\n\r\nKNOWN_FAILURES = HERE / \"known_failures.txt\"\r\n\r\n\r\ndef load_tests(loader, tests, pattern):\r\n    \"\"\"Tests listed in tests/known_failures.txt run as expected failures (see tests/README.md).\"\"\"\r\n    listed = set()\r\n    if KNOWN_FAILURES.exists():\r\n        listed = {l.split(\"#\")[0].strip() for l in KNOWN_FAILURES.read_text().splitlines()} - {\"\"}\r\n\r\n    def walk(suite):\r\n        for item in suite:\r\n            if isinstance(item, unittest.TestSuite):\r\n                yield from walk(item)\r\n            else:\r\n                yield item\r\n    for test in walk(tests):\r\n        if any(test.id().endswith(name) for name in listed):\r\n            method = getattr(test, test._testMethodName)\r\n\r\n            def expected(method"]
[13.926889, "o", "=method):\r\n                return method()\r\n            expected.__unittest_expecting_failure__ = True\r\n            setattr(test, test._testMethodName, expected)\r\n    return tests\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n{\r\n  \"source\": \"finance worked examples for BILL-212 (rev. 4 rules)\",\r\n  \"cases\": [\r\n    {\r\n      \"id\": \"mid-month-upgrade\",\r\n      \"plan\": \"starter-monthly\",\r\n      \"anchor\": \"2025-03-14\",\r\n      \"to\": \"pro-monthly\",\r\n      \"at\": \"2026-06-20\",\r\n      \"expected\": {\r\n        \"period_start\": \"2026-06-14\",\r\n        \"period_end\": \"2026-07-14\",\r\n        \"credit\": 960,\r\n        \"charge\": 3920,\r\n        \"total\": 2960,\r\n        \"new_anchor\": \"2025-03-14\",\r\n        \"next_renewal\": \"2026-07-14\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"month-end-anchor-short-month\",\r\n      \"plan\": \"pro-monthly\",\r\n      \"anchor\": \"2024-01-31\",\r\n      \"to\": \"team-monthly\",\r\n      \"at\": \"2026-02-15\",\r\n      \"expected\": {\r\n        \"period_start\": \"2026-01-31\",\r\n        \"period_end\": \"2026-02-28\",\r\n        \"credit\": "]
