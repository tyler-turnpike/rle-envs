[33.332127, "o", "\u001b[1;39m{\u001b[0m\u001b[34;1m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"vol-0772\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"volume\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ledger-pr-77-journal\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"subnet\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"network\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"attached_to\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"i-0771\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"targets\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"target\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"labels\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"env\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"pr-77\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"expires\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-11-15\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"owner\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ledger-team\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"project\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ledger\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[33.342421, "o", "\u001b[?2004h"]
[33.342682, "o", "root@57d787aa425a:/app# "]
[33.342809, "o", "python3 - <<'PY'"]
[33.342888, "o", "\r\n"]
[33.342989, "o", "\u001b[?2004l\r"]
[33.343096, "o", "\u001b[?2004h"]
[33.343173, "o", "> from pathlib import Path"]
[33.343251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.343372, "o", "> p = Path('lib/order.sh')"]
[33.34341, "o", "\r\n"]
[33.343445, "o", "\u001b[?2004l\r"]
[33.343719, "o", "\u001b[?2004h> "]
[33.343729, "o", "s = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')"]
[33.343857, "o", "\r\n"]
[33.343925, "o", "\u001b[?2004l\r"]
[33.344003, "o", "\u001b[?2004h"]
[33.344071, "o", "> "]
[33.344413, "o", "s = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')"]
[33.34446, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.344577, "o", "p.write_text(s)"]
[33.344594, "o", "\r\n\u001b[?2004l\r"]
[33.344599, "o", "\u001b[?2004h"]
[33.344728, "o", "> p = Path('teardown.sh')"]
[33.34479, "o", "\r\n\u001b[?2004l\r"]
[33.344825, "o", "\u001b[?2004h"]
[33.344833, "o", "> "]
[33.344962, "o", "s = p.read_text()\r\n"]
[33.344972, "o", "\u001b[?2004l\r"]
[33.345065, "o", "\u001b[?2004h> "]
[33.345232, "o", "s = s[:s.index('# TODO(PLAT-311)')] + '''# A dry run must not detach volumes or overwrite a previous teardown report."]
[33.345308, "o", "\r\n"]
[33.34541, "o", "\u001b[?2004l\r"]
[33.345454, "o", "\u001b[?2004h"]
[33.345545, "o", "> if [[ \"$DRY_RUN\" -eq 0 ]]; then"]
[33.345621, "o", "\r\n"]
[33.345655, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.345663, "o", "> "]
[33.34579, "o", "    report_init \"$ENV_NAME\""]
[33.345855, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.345996, "o", ">     # Keep a report of successful deletions even if a later operation fails."]
[33.346065, "o", "\r\n"]
[33.346116, "o", "\u001b[?2004l\r"]
[33.346186, "o", "\u001b[?2004h"]
[33.346328, "o", "> "]
[33.346337, "o", "    trap 'rc=$?; trap - EXIT; report_write; exit \"$rc\"' EXIT"]
[33.346463, "o", "\r\n"]
[33.346538, "o", "\u001b[?2004l\r"]
[33.346581, "o", "\u001b[?2004h"]
[33.346645, "o", "> fi"]
[33.346724, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.346731, "o", "> "]
[33.346773, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.346898, "o", "> if [[ -z \"$inventory\" ]]; then"]
[33.346962, "o", "\r\n"]
[33.346969, "o", "\u001b[?2004l\r"]
[33.347089, "o", "\u001b[?2004h"]
[33.347099, "o", ">     echo \"teardown: nothing to do\""]
[33.347175, "o", "\r\n"]
[33.347242, "o", "\u001b[?2004l\r"]
[33.34725, "o", "\u001b[?2004h"]
[33.347385, "o", "> "]
[33.347394, "o", "    exit 0"]
[33.347402, "o", "\r\n"]
[33.347473, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.347547, "o", "> fi\r\n"]
[33.347618, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.347626, "o", "> "]
[33.347635, "o", "\r\n"]
[33.347694, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.347847, "o", "> # Sort before making changes so inventory/order failures cannot be hidden by"]
[33.347935, "o", "\r\n"]
[33.348008, "o", "\u001b[?2004l\r"]
[33.348074, "o", "\u001b[?2004h> "]
[33.348218, "o", "# process substitution. Run the loop in this shell for report bookkeeping."]
[33.348329, "o", "\r\n"]
[33.348361, "o", "\u001b[?2004l\r"]
[33.348366, "o", "\u001b[?2004h"]
[33.348515, "o", "> ordered=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\""]
[33.348591, "o", "\r\n"]
[33.348667, "o", "\u001b[?2004l\r"]
[33.348676, "o", "\u001b[?2004h"]
[33.348745, "o", "> while IFS=$'\\\\t' read -r id kind name; do"]
[33.348834, "o", "\r\n"]
[33.348911, "o", "\u001b[?2004l\r"]
[33.348934, "o", "\u001b[?2004h"]
[33.34894, "o", "> "]
[33.34906, "o", "    [[ -n \"$id\" ]] || continue"]
[33.349072, "o", "\r\n"]
[33.349208, "o", "\u001b[?2004l\r\u001b[?2004h>     if [[ \"$kind\" == volume ]]; then"]
[33.349265, "o", "\r\n"]
[33.349305, "o", "\u001b[?2004l\r"]
[33.349324, "o", "\u001b[?2004h"]
[33.34947, "o", ">         attached_to=\"$(inventory_field \"$id\" attached_to)\""]
[33.349555, "o", "\r\n"]
[33.349616, "o", "\u001b[?2004l\r"]
[33.349742, "o", "\u001b[?2004h>         if [[ -n \"$attached_to\" ]]; then"]
[33.349813, "o", "\r\n"]
[33.349947, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[33.349957, "o", "            if [[ \"$DRY_RUN\" -eq 1 ]]; then"]
[33.350026, "o", "\r\n"]
[33.350037, "o", "\u001b[?2004l\r"]
[33.350065, "o", "\u001b[?2004h"]
[33.350111, "o", "> "]
[33.350265, "o", "                echo \"would detach volume $id from $attached_to\""]
[33.350342, "o", "\r\n"]
[33.350414, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.350449, "o", "> "]
[33.350551, "o", "            else\r\n\u001b[?2004l\r"]
[33.350558, "o", "\u001b[?2004h"]
[33.350669, "o", ">                 echo \"detaching volume $id from $attached_to\""]
[33.350755, "o", "\r\n"]
[33.350817, "o", "\u001b[?2004l\r"]
[33.350875, "o", "\u001b[?2004h"]
[33.350943, "o", "> "]
[33.350949, "o", "                \"$CLOUDCTL\" volume detach \"$id\""]
[33.351042, "o", "\r\n"]
[33.351092, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.351142, "o", ">             fi"]
[33.351216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.35136, "o", ">         fi"]
[33.351379, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.351401, "o", "    fi"]
[33.351438, "o", "\r\n"]
[33.351466, "o", "\u001b[?2004l\r\u001b[?2004h"]
[33.351546, "o", "> "]
[33.351551, "o", "    if [[ \"$DRY_RUN\" -eq 1 ]]; then"]
[33.351647, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.351654, "o", "> "]
[33.351755, "o", "        echo \"would delete $kind $id ($name)\""]
[33.351848, "o", "\r\n\u001b[?2004l\r"]
[33.35191, "o", "\u001b[?2004h"]
[33.351998, "o", ">         continue"]
[33.352054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.352135, "o", ">     fi\r\n"]
[33.352151, "o", "\u001b[?2004l\r"]
[33.352156, "o", "\u001b[?2004h"]
[33.352296, "o", ">     echo \"deleting $kind $id ($name)\""]
[33.352347, "o", "\r\n"]
[33.352371, "o", "\u001b[?2004l\r"]
[33.352376, "o", "\u001b[?2004h"]
[33.352481, "o", ">     \"$CLOUDCTL\" delete \"$id\""]
[33.35255, "o", "\r\n"]
[33.352677, "o", "\u001b[?2004l\r\u001b[?2004h>     report_add deleted \"$id\" \"$kind\" \"$name\""]
[33.352741, "o", "\r\n"]
[33.35276, "o", "\u001b[?2004l\r"]
[33.352875, "o", "\u001b[?2004h"]
[33.352884, "o", "> done <<< \"$ordered\""]
[33.35294, "o", "\r\n"]
[33.352956, "o", "\u001b[?2004l\r"]
[33.35296, "o", "\u001b[?2004h"]
[33.353075, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[33.353105, "o", "> "]
[33.353109, "o", "echo \"teardown: done\""]
[33.353209, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.353223, "o", "'''"]
[33.353331, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.353369, "o", "> "]
[33.35341, "o", "p.write_text(s)"]
[33.353491, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.353562, "o", "> PY\r\n"]
[33.353801, "o", "\u001b[?2004l\r"]
[33.397077, "o", "\u001b[?2004h"]
[33.397379, "o", "root@57d787aa425a:/app# "]
[33.397569, "o", "bash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh"]
[33.397614, "o", "\r\n"]
[33.399506, "o", "\u001b[?2004l\r"]
[33.770598, "o", "    run1| teardown: env=pr-101 project=checkout selector=project=checkout,env=pr-101\r\n    run1| teardown: 7 resource(s) found\r\n    run1| deleting dns dns-1017 (pr-101.checkout.preview.internal)\r\n    run1| deleted dns dns-1017 (pr-101.checkout.preview.internal)\r\n    run1| deleting lb lb-1016 (checkout-pr-101-lb)\r\n    run1| deleted lb lb-1016 (checkout-pr-101-lb)\r\n    run1| detaching volume vol-1015 from i-1014\r\n    run1| detached volume vol-1015\r\n    run1| deleting volume vol-1015 (checkout-pr-101-pgdata)\r\n    run1| deleted volume vol-1015 (checkout-pr-101-pgdata)\r\n    run1| deleting instance i-1013 (checkout-pr-101-web)\r\n    run1| deleted instance i-1013 (checkout-pr-101-web)\r\n    run1| deleting instance i-1014 (checkout-pr-101-worker)\r\n    run1| deleted instance i-1014 (checkout-pr-101-worker)\r\n    run1| deleting subnet subnet-1012 (checkout-pr-101-app)\r\n    run1| deleted subnet subnet-1012 (checkout-pr-101-app)\r\n    run1| deleting network net-1011 (checkout-pr-101-vpc)\r\n    run1| deleted network net-1011 (c"]
