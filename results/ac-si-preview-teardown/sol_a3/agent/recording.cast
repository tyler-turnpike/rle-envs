[15.619232, "o", "reated\": \"2026-10-01T09:03:00\",\r\n      \"id\": \"lb-1016\",\r\n      \"kind\": \"lb\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-lb\",\r\n      \"status\": \"active\",\r\n      \"subnet\": \"subnet-1012\",\r\n      \"targets\": [\r\n        \"i-1013\"\r\n      ]\r\n    },\r\n    \"net-1011\": {\r\n      \"cidr\": \"10.11.0.0/16\",\r\n      \"created\": \"2026-10-01T09:00:00\",\r\n      \"id\": \"net-1011\",\r\n      \"kind\": \"network\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-vpc\",\r\n      \"status\": \"available\"\r\n    },\r\n    \"net-1021\": {\r\n      \"cidr\": \"10.12.0.0/16\",\r\n      \"created\": \"2026-10-02T09:00:00\",\r\n      \"id\": \"net-1021\",\r\n      \"kind\": \"network\",\r\n      \"labels\": {\r\n        \"env\": \"pr-102\",\r\n        \"expires\": \"2026-10-09\",\r\n        \"owner\": \"checkout-team\",\r\n        \"pro"]
