[15.608384, "o", "cat lib/inventory.sh lib/order.sh; ls -la tests/fixtures tools reports; cat tests/fixtures/previews.conf; cat tests/fixtures/account.json\r\n\u001b[?2004l\r"]
[15.613623, "o", "# shellcheck shell=bash\r\n# Inventory helpers: map a preview env to its label selector and list what it owns.\r\n#\r\n# Environment overrides:\r\n#   CLOUDCTL        cloudctl binary to call (default: cloudctl on PATH)\r\n#   PREVIEWS_CONF   env -> selector mapping (default: conf/previews.conf)\r\n\r\nCLOUDCTL=\"${CLOUDCTL:-cloudctl}\"\r\nPREVIEWS_CONF=\"${PREVIEWS_CONF:-$ROOT/conf/previews.conf}\"\r\n\r\n# load_env_config ENV\r\n# Sets ENV_NAME, ENV_PROJECT and ENV_SELECTOR from the config file.\r\nload_env_config() {\r\n    local want=\"$1\" env project selector\r\n    [[ -r \"$PREVIEWS_CONF\" ]] || { echo \"inventory: cannot read $PREVIEWS_CONF\" >&2; return 1; }\r\n    while read -r env project selector _; do\r\n        [[ -z \"$env\" || \"$env\" == \\#* ]] && continue\r\n        if [[ \"$env\" == \"$want\" ]]; then\r\n            ENV_NAME=\"$env\"\r\n            ENV_PROJECT=\"$project\"\r\n            ENV_SELECTOR=\"$selector\"\r\n            return 0\r\n        fi\r\n    done < \"$PREVIEWS_CONF\"\r\n    echo \"inventory: unknown preview env '$want' (see $PREVIEWS_CONF)\" >&2\r\n  "]
[15.613843, "o", "  return 1\r\n}\r\n\r\n# inventory_collect SELECTOR\r\n# Prints one line per resource: \"<id>\\t<kind>\\t<name>\".\r\ninventory_collect() {\r\n    local selector=\"$1\"\r\n    \"$CLOUDCTL\" list --selector \"$selector\" --json \\\r\n        | jq -r '.[] | [.id, .kind, .name] | @tsv'\r\n}\r\n\r\n# inventory_json ID\r\n# Full JSON description of one resource (includes \"dependents\": [ids]).\r\ninventory_json() {\r\n    \"$CLOUDCTL\" describe \"$1\" --json\r\n}\r\n\r\n# inventory_field ID FIELD\r\n# Prints one top-level field of a resource (\"\" when unset).\r\ninventory_field() {\r\n    inventory_json \"$1\" | jq -r --arg f \"$2\" '.[$f] // empty'\r\n}\r\n\r\n# inventory_exists ID -> 0 if the resource is still there\r\ninventory_exists() {\r\n    \"$CLOUDCTL\" describe \"$1\" >/dev/null 2>&1\r\n}\r\n# shellcheck shell=bash\r\n# Ordering of resources for teardown.\r\n#\r\n# Resources have to go in reverse dependency order: cloudctl refuses to delete\r\n# anything that still has dependents (see `cloudctl --help`).\r\n\r\n# order_rank KIND -> numeric rank; lower ranks are processed first.\r\n# NOTE: copied"]
[15.613855, "o", " from the provisioning side (create order) -- still needs to be\r\n# turned into a teardown order and to cover every kind we provision.\r\norder_rank() {\r\n    case \"$1\" in\r\n        network)  echo 10 ;;\r\n        subnet)   echo 20 ;;\r\n        instance) echo 30 ;;\r\n        *)        echo 99 ;;\r\n    esac\r\n}\r\n\r\n# order_resources < \"<id>\\t<kind>\\t<name>\" lines\r\n# Prints the same lines sorted by rank (stable within a rank).\r\norder_resources() {\r\n    local id kind name\r\n    while IFS=$'\\t' read -r id kind name; do\r\n        [[ -z \"$id\" ]] && continue\r\n        printf '%s\\t%s\\t%s\\t%s\\n' \"$(order_rank \"$kind\")\" \"$id\" \"$kind\" \"$name\"\r\n    done | sort -s -n -k1,1 | cut -f2-\r\n}\r\n"]
[15.61571, "o", "reports:\r\n"]
