[58.286894, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('teardown.sh')\ns = p.read_text()\na = s.index('# A dry run')\nb = s.index('# Sort before', a)\ns = s[:a] + '''# Preserve the last deletion report when a completed teardown is re-run.\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        report_write\n    fi\n    exit 0\nfi\n\n# A dry run must not detach volumes or overwrite a previous teardown report.\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Keep a report of successful deletions even if a later operation fails.\n    trap 'rc=$?; trap - EXIT; report_write; exit \"$rc\"' EXIT\nfi\n\n''' + s[b:]\ns = s.replace('    \"$CLOUDCTL\" delete \"$id\"\\n    report_add deleted \"$id\" \"$kind\" \"$name\"', '''    if \"$CLOUDCTL\" delete \"$id\"; then\n        report_add deleted \"$id\" \"$kind\" \"$name\"\n    else\n        rc=$?\n        report_add blocked \"$id\" \"$kind\" \"$name\" \"Delete failed (exit $rc); teardown "]
[58.286968, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[58.287215, "i", "stopped. Check cloudctl deps $id.\"\n        exit \"$rc\"\n    fi''')\np.write_text(s)\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle='(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1'\ns = s.replace(needle, '''cp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run leaves account unchanged\" cmp -s \"$WORK/before.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry run writes no deletion report\" test ! -e \"$REPORT_DIR/pr-101.md\"\ncheck \"dry run plans volume detachment\" grep -q \"would detach volume\" \"$WORK/dry.out\"\n\n''' + needle)\ns = s.replace('log_lines=\"$(wc -l', 'cp \"$report\" \"$WORK/first-report.md\"\\n\\nlog_lines=\"$(wc -l')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"', 'check \"second run changed nothing\" test -z \"$changes\"\\ncheck \"second run preserves deletion report\" cmp -s \"$WORK/first-report.md\" \"$report\"')\np.write_text(s)\nPY\nbash -n teardown.sh"]
