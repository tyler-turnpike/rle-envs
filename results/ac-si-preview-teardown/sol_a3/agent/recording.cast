[59.301541, "i", "python3 - <<'PY'\nimport copy, json, os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nbase = json.loads((root / 'tests/fixtures/account.json').read_text())\nwith tempfile.TemporaryDirectory() as work:\n    work = pathlib.Path(work)\n    for case in ('detached', 'blocked'):\n        account = work / case\n        account.mkdir()\n        state = copy.deepcopy(base)\n        if case == 'detached':\n            state['resources']['vol-1015']['attached_to'] = None\n            state['resources']['vol-1015']['status'] = 'available'\n        else:\n            outsider = copy.deepcopy(state['resources']['i-1013'])\n            outsider.update(id='i-outsider', name='unrelated-worker')\n            outsider['labels']['env'] = 'pr-102'\n            state['resources']['i-outsider'] = outsider\n        (account / 'state.json').write_text(json.dumps(state))\n        env = dict(os.environ, CLOUDCTL_STATE=str(account), REPORT_DIR=str(account / 'reports'), PREVIEWS_CONF=str(root / 'tests/fixtures/previews.conf'))\n        result ="]
[59.301625, "o", "python3 - <<'PY'\r\nimport copy, json, os, pathlib, subprocess, tempfile\r\nroot = pathlib.Path.cwd()\r\nbase = json.loads((root / 'tests/fixtures/account.json').read_text())\r\nwith tempfile.TemporaryDirectory() as work:\r\n    work = pathlib.Path(work)\r\n    for case in ('detached', 'blocked'):\r\n        account = work / case\r\n        account.mkdir()\r\n        state = copy.deepcopy(base)\r\n        if case == 'detached':\r\n            state['resources']['vol-1015']['attached_to'] = None\r\n            state['resources']['vol-1015']['status'] = 'available'\r\n        else:\r\n            outsider = copy.deepcopy(state['resources']['i-1013'])\r\n            outsider.update(id='i-outsider', name='unrelated-worker')\r\n            outsider['labels']['env'] = 'pr-102'\r\n            state['resources']['i-outsider'] = outsider\r\n        (account / 'state.json').write_text(json.dumps(state))\r\n        env = dict(os.environ, CLOUDCTL_STATE=str(account), REPORT_DIR=str(account / 'reports'), PREVIEWS_CONF=str(root / 'tests/fixtures/previews.conf'"]
[59.301724, "i", " subprocess.run(['./teardown.sh', 'pr-101'], env=env, text=True, capture_output=True)\n        after = json.loads((account / 'state.json').read_text())\n        report = (account / 'reports/pr-101.md').read_text()\n        if case == 'detached':\n            assert result.returncode == 0, result.stdout + result.stderr\n            assert not any(r['labels']['env'] == 'pr-101' for r in after['resources'].values())\n        else:\n            assert result.returncode == 4, result.stdout + result.stderr\n            assert 'blocked | subnet-1012' in report, report\n            assert 'deleted | dns-1017' in report, report\n            for rid, resource in state['resources'].items():\n                if resource['labels']['env'] != 'pr-101':\n                    assert after['resources'][rid] == resource\n            assert 'net-1011' in after['resources']\n        print(f'PASS: {case} volume/dependency scenario')\nPY\n"]
