[33.310526, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# A dry run must not detach volumes or overwrite a previous teardown report.\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Keep a report of successful deletions even if a later operation fails.\n    trap 'rc=$?; trap - EXIT; report_write; exit \"$rc\"' EXIT\nfi\n\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    exit 0\nfi\n\n# Sort before making change"]
[33.311685, "o", "python3 - <<'PY'\r\nfrom pathlib import Path\r\np = Path('lib/order.sh')\r\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\r\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\r\np.write_text(s)\r\np = Path('teardown.sh')\r\ns = p.read_text()\r\ns = s[:s.index('# TODO(PLAT-311)')] + '''# A dry run must not detach volumes or overwrite a previous teardown report.\r\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n    report_init \"$ENV_NAME\"\r\n    # Keep a report of successful deletions even if a later operation fails.\r\n    trap 'rc=$?; trap - EXIT; report_write; exit \"$rc\"' EXIT\r\nfi\r\n\r\nif [[ -z \"$inventory\" ]]; then\r\n    echo \"teardown: nothing to do\"\r\n    exit 0\r\nfi\r\n\r\n# Sort "]
[33.311752, "i", "s so inventory/order failures cannot be hidden by\n# process substitution. Run the loop in this shell for report bookkeeping.\nordered=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\nwhile IFS=$'\\\\t' read -r id kind name; do\n    [[ -n \"$id\" ]] || continue\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id from $attached_to\"\n            else\n                echo \"detaching volume $id from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh\n"]
[33.3118, "o", "before making changes so inventory/order failures cannot be hidden by\r\n# process substitution. Run the loop in this shell for report bookkeeping.\r\nordered=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\r\nwhile IFS=$'\\\\t' read -r id kind name; do\r\n    [[ -n \"$id\" ]] || continue\r\n    if [[ \"$kind\" == volume ]]; then\r\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n        if [[ -n \"$attached_to\" ]]; then\r\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n                echo \"would detach volume $id from $attached_to\"\r\n            else\r\n                echo \"detaching volume $id from $attached_to\"\r\n                \"$CLOUDCTL\" volume detach \"$id\"\r\n            fi\r\n        fi\r\n    fi\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    \"$CLOUDCTL\" delete \"$id\"\r\n    report_add deleted \"$id\" \"$kind\" \"$name\"\r\ndone <<< \"$ordered\"\r\n\r\necho \"teardown: done\"\r\n'''\r\np.write_text(s)\r\nPY\r\nbash -n teardown.sh lib/*.sh"]
[33.311861, "o", "; bash tests/test_teardown.sh\r\n"]
[33.331238, "o", "\u001b[1;39m{\u001b[0m\u001b[34;1m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"dns-0776\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"dns\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"pr-77.ledger.preview.internal\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"subnet\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"network\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"attached_to\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"targets\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;30mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"target\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"i-0775\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"labels\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[34;1m\"env\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"pr-77\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"expires\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-11-15\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"owner\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ledger-team\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[34;1m\"project\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ledger\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
