[67.603941, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle = '(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1'\ns = s.replace(needle, '''# A dry run must not detach, delete, or write a misleading deletion report.\ncp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before-dry-run.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry-run.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run leaves account unchanged\" cmp -s \"$WORK/before-dry-run.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry run reports planned detachment\" grep -q \"would detach volume vol-1015\" \"$WORK/dry-run.out\"\ncheck \"dry run writes no report\" test ! -e \"$REPORT_DIR/pr-101.md\"\n\n''' + needle, 1)\ns = s.replace('for id in $before_101; do\\n    check \"report lists $id\" grep -qs -- \"$id\" \"$report\"\\ndone', '''while IFS=$'\\\\t' read -r id kind name; do\n    check \"report lists deleted $id with kind and name\" grep -Fqs -- \"| deleted | $id | $kind | $name |\" \"$report\"\ndone < <(jq -r "]
[67.604224, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.604239, "i", "'.resources[] | select(.labels.env == \"pr-101\") | [.id,.kind,.name] | @tsv' \"$FIXTURES/account.json\")\n\nactual_order=\"$(jq -r '.effects[] | select(.action == \"deleted\") | .kind' \"$CLOUDCTL_STATE/calls.log\")\"\nexpected_order=$'dns\\\\nlb\\\\nvolume\\\\ninstance\\\\ninstance\\\\nsubnet\\\\nnetwork'\ncheck \"resources deleted in dependency order\" test \"$actual_order\" = \"$expected_order\"\ncp \"$report\" \"$WORK/first-report.md\"''')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"', '''check \"second run changed nothing\" test -z \"$changes\"\ncheck \"second run preserves deletion report\" cmp -s \"$report\" \"$WORK/first-report.md\"\n\n# A previous attempt may already have detached a volume.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl volume detach vol-1015 > /dev/null\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/detached.out\" 2>&1\ncheck \"already-detached volume is handled\" test \"$?\" -eq 0\ncheck \"already-detached teardown removes all selected resources\" test -z \"$(ids_for project=checkout,env=pr-101"]
[67.60425, "i", ")\"\n\n# Cross-env dependencies must block deletion, never trigger --force or movement.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl instance move i-1023 --subnet subnet-1012 > /dev/null\nexternal_before=\"$(cloudctl list --selector project=checkout,env=pr-102 --json)\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked.out\" 2>&1\ncheck \"external dependency returns exit 4\" test \"$?\" -eq 4\ncheck \"external resources stay unchanged\" test \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$external_before\"\ncheck \"blocked subnet remains\" cloudctl describe subnet-1012\ncheck \"blocked network remains\" cloudctl describe net-1011\ncheck \"partial report records completed deletion\" grep -Fqs '| deleted | dns-1017 | dns |' \"$report\"\ncheck \"partial report records blocked deletion\" grep -Fqs '| failed | subnet-1012 | subnet |' \"$report\"''')\np.write_text(s)\nPY\nbash tests/test_teardown.sh\n"]
