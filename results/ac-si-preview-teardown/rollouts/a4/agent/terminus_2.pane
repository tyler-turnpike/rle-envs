            targets = select(work, kind, parse_selector(sel) if sel else None, match)
        elif args:
            targets = [resolve(work, a) for a in args]
        else:
            raise CloudError(2, "usage: cloudctl delete ID|NAME... | --selector K=V | --match GLOB")
        errors = []
        for t in targets:
