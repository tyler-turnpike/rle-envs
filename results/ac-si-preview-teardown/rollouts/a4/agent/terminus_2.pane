[?2004l#!/usr/bin/env bash
# teardown.sh - remove a preview environment's cloud resources.
#
#   ./teardown.sh <env> [--dry-run]
#
# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are
# found with the env's label selector and deleted through cloudctl.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/inventory.sh
source "$ROOT/lib/inventory.sh"
# shellcheck source=lib/order.sh
source "$ROOT/lib/order.sh"
# shellcheck source=lib/report.sh
source "$ROOT/lib/report.sh"

usage() {
    echo "usage: $0 <env> [--dry-run]" >&2
    exit 2
}

[[ $# -ge 1 ]] || usage
ENV_ARG="$1"; shift
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        *) usage ;;
    esac
done

load_env_config "$ENV_ARG"
echo "teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR"

inventory="$(inventory_collect "$ENV_SELECTOR")"
echo "teardown: $(printf '%s\n' "$inventory" | grep -c . || true) resource(s) found"

# Keep the original deletion report on a no-op rerun.
if [[ -z "$inventory" ]]; then
    echo "teardown: nothing to do"
    if [[ "$DRY_RUN" -eq 0 && ! -f "$REPORT_DIR/$ENV_NAME.md" ]]; then
        report_init "$ENV_NAME"
        report_write
    fi
    exit 0
fi

# Resolve the full order before making any changes; reject unknown kinds.
ordered="$(printf '%s\n' "$inventory" | order_resources)"
if [[ "$DRY_RUN" -eq 0 ]]; then
    report_init "$ENV_NAME"
    # Keep a record of completed deletions even if a later operation fails.
    finish_report() {
        local status=$?
        trap - EXIT
        if ! report_write; then
            [[ "$status" -ne 0 ]] || status=1
        fi
        exit "$status"
    }
    trap finish_report EXIT
fi

# Do not use --force: dependencies outside this selector must remain untouched.
while IFS=$'\t' read -r id kind name; do
    if [[ "$kind" == volume ]]; then
        attached_to="$(inventory_field "$id" attached_to)"
        if [[ -n "$attached_to" ]]; then
            if [[ "$DRY_RUN" -eq 1 ]]; then
                echo "would detach volume $id from $attached_to"
            else
                echo "detaching volume $id from $attached_to"
                if "$CLOUDCTL" volume detach "$id"; then
                    report_add detached "$id" "$kind" "$name" "from $attached_to"
                else
                    rc=$?
                    report_add failed "$id" "$kind" "$name" "detach failed (exit $rc)"
                    exit "$rc"
                fi
            fi
        fi
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "would delete $kind $id ($name)"
        continue
    fi
    echo "deleting $kind $id ($name)"
    if "$CLOUDCTL" delete "$id"; then
        report_add deleted "$id" "$kind" "$name"
    else
        rc=$?
        report_add failed "$id" "$kind" "$name" "delete failed (exit $rc); inspect cloudctl deps $id"
        exit "$rc"
    fi
done <<< "$ordered"

echo "teardown: done"
# shellcheck shell=bash
# Ordering of resources for teardown.
#
# Resources have to go in reverse dependency order: cloudctl refuses to delete
# anything that still has dependents (see `cloudctl --help`).

# order_rank KIND -> numeric rank; lower ranks are processed first.
order_rank() {
    case "$1" in
        dns)      echo 10 ;;
        lb)       echo 20 ;;
        volume)   echo 30 ;;
        instance) echo 40 ;;
        subnet)   echo 50 ;;
        network)  echo 60 ;;
        *) echo "order: unknown resource kind '$1'" >&2; return 1 ;;
    esac
}

# order_resources < "<id>\t<kind>\t<name>" lines
# Prints the same lines sorted by rank (stable within a rank).
order_resources() {
    local id kind name rank
    while IFS=$'\t' read -r id kind name; do
        [[ -z "$id" ]] && continue
        rank="$(order_rank "$kind")" || return
        printf '%s\t%s\t%s\t%s\n' "$rank" "$id" "$kind" "$name"
    done | sort -s -n -k1,1 | cut -f2-
}
