[61.761212, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nmarker = '(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1'\ns = s.replace(marker, '''# A dry run must not detach volumes, delete resources, or publish a report.\ncp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before-dry-run.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry-run.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run leaves account unchanged\" cmp -s \"$WORK/before-dry-run.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry run does not write a report\" test ! -e \"$REPORT_DIR/pr-101.md\"\ncheck \"dry run shows volume detachment\" grep -q \"would detach volume vol-1015\" \"$WORK/dry-run.out\"\n\n''' + marker)\ns = s.replace('log_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"', 'cp \"$report\" \"$WORK/first-report.md\"\\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"', '''check \"second run changed nothing\" test -z \"$ch"]
