[40.124187, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# Keep the last deletion report when a completed teardown is run again.\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        report_write\n    fi\n    exit 0\nfi\n\n# Collect the ordering before making changes, and keep the loop in this shell\n# so report state is reta"]
[40.124423, "i", "ined. Never cascade into resources outside the selector.\nordered_inventory=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Also publish successful actions if a later deletion fails. A retry will\n    # discover only the remaining resources and tolerate detached volumes.\n    trap 'report_write' EXIT\nfi\n\nwhile IFS=$'\\\\t' read -r id kind name; do\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id ($name) from $attached_to\"\n            else\n                echo \"detaching volume $id ($name) from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n                report_add detached \"$id\" \"$kind\" \"$name\" \"from $attached_to\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    "]
[40.124457, "i", "echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered_inventory\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh\n"]
