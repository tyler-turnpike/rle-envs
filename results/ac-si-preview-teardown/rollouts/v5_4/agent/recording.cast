[40.975505, "i", "$id ($name) from $attached_to\"\n            else\n                echo \"detaching volume $id ($name) from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n                report_add detached \"$id\" \"$kind\" \"$name\" \"from $attached_to\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered_inventory\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh\n"]
