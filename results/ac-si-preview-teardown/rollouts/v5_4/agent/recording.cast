[61.526006, "o", "\r\n--- current scripts ---\r\n"]
[61.527071, "o", "#!/usr/bin/env bash\r\n# teardown.sh - remove a preview environment's cloud resources.\r\n#\r\n#   ./teardown.sh <env> [--dry-run]\r\n#\r\n# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are\r\n# found with the env's label selector and deleted through cloudctl.\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n# shellcheck source=lib/inventory.sh\r\nsource \"$ROOT/lib/inventory.sh\"\r\n# shellcheck source=lib/order.sh\r\nsource \"$ROOT/lib/order.sh\"\r\n# shellcheck source=lib/report.sh\r\nsource \"$ROOT/lib/report.sh\"\r\n\r\nusage() {\r\n    echo \"usage: $0 <env> [--dry-run]\" >&2\r\n    exit 2\r\n}\r\n\r\n[[ $# -ge 1 ]] || usage\r\nENV_ARG=\"$1\"; shift\r\nDRY_RUN=0\r\nfor arg in \"$@\"; do\r\n    case \"$arg\" in\r\n        --dry-run) DRY_RUN=1 ;;\r\n        *) usage ;;\r\n    esac\r\ndone\r\n\r\nload_env_config \"$ENV_ARG\"\r\necho \"teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR\"\r\n\r\ninventory=\"$(inventory_collect \"$ENV_SELECTOR\")\"\r\necho \"teardown: $(printf '%s\\n' \"$inventory\" | grep -c . || true) resourc"]
[61.527108, "o", "e(s) found\"\r\n\r\n# Keep an existing deletion report on an empty rerun, rather than replacing\r\n# the audit trail with an empty report. An initially empty env still gets one.\r\nif [[ -z \"$inventory\" ]]; then\r\n    echo \"teardown: nothing to do (no resources matched)\"\r\n    if [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n        if [[ ! -f \"$REPORT_DIR/${ENV_NAME}.md\" ]]; then\r\n            report_init \"$ENV_NAME\"\r\n            report_write\r\n        else\r\n            echo \"teardown: report retained: $REPORT_DIR/${ENV_NAME}.md\"\r\n        fi\r\n    fi\r\n    exit 0\r\nfi\r\n\r\nordered_inventory=\"$(printf '%s\\n' \"$inventory\" | order_resources)\"\r\n\r\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n    report_init \"$ENV_NAME\"\r\n    # Write successful actions even if a later dependency or API error stops us.\r\n    # Do not let report generation hide the original failure status.\r\n    finish_report() {\r\n        local status=$?\r\n        trap - EXIT\r\n        report_write || { [[ \"$status\" -ne 0 ]] || status=1; }\r\n        exit \"$status\"\r\n    }\r\n    trap finish_report EXIT\r"]
[61.527355, "o", "\nfi\r\n\r\n# Use a redirected loop, not a pipeline subshell, so failures reach the EXIT\r\n# trap and reporting remains in the main shell. Never cascade outside selector.\r\nwhile IFS=$'\\t' read -r id kind name; do\r\n    if [[ \"$kind\" == \"volume\" ]]; then\r\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n        if [[ -n \"$attached_to\" ]]; then\r\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n                echo \"would detach volume $id ($name) from $attached_to\"\r\n            else\r\n                echo \"detaching volume $id ($name) from $attached_to\"\r\n                \"$CLOUDCTL\" volume detach \"$id\"\r\n                report_add detached \"$id\" \"$kind\" \"$name\" \"from $attached_to\"\r\n            fi\r\n        fi\r\n    fi\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    \"$CLOUDCTL\" delete \"$id\"\r\n    report_add deleted \"$id\" \"$kind\" \"$name\"\r\ndone <<< \"$ordered_inventory\"\r\n\r\necho \"teardown: done\"\r\n# shellcheck shell=ba"]
[61.52738, "o", "sh\r\n# Ordering of resources for teardown.\r\n#\r\n# Resources have to go in reverse dependency order: cloudctl refuses to delete\r\n# anything that still has dependents (see `cloudctl --help`).\r\n\r\n# order_rank KIND -> numeric rank; lower ranks are processed first.\r\norder_rank() {\r\n    case \"$1\" in\r\n        dns)      echo 10 ;;\r\n        lb)       echo 20 ;;\r\n        volume)   echo 30 ;;\r\n        instance) echo 40 ;;\r\n        subnet)   echo 50 ;;\r\n        network)  echo 60 ;;\r\n        *)        echo 99 ;;\r\n    esac\r\n}\r\n\r\n# order_resources < \"<id>\\t<kind>\\t<name>\" lines\r\n# Prints the same lines sorted by rank (stable within a rank).\r\norder_resources() {\r\n    local id kind name\r\n    while IFS=$'\\t' read -r id kind name; do\r\n        [[ -z \"$id\" ]] && continue\r\n        printf '%s\\t%s\\t%s\\t%s\\n' \"$(order_rank \"$kind\")\" \"$id\" \"$kind\" \"$name\"\r\n    done | sort -s -n -k1,1 | cut -f2-\r\n}\r\n\u001b[?2004hroot@4697f250fd00:/app# "]
[61.581198, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\ns = s.replace('before_102=\"$(ids_for project=checkout,env=pr-102)\"', '''before_102=\"$(ids_for project=checkout,env=pr-102)\"\nstate_before=\"$(cat \"$CLOUDCTL_STATE/state.json\")\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run leaves account unchanged\" test \"$(cat \"$CLOUDCTL_STATE/state.json\")\" = \"$state_before\"\ncheck \"dry run does not write a deletion report\" test ! -e \"$REPORT_DIR/pr-101.md\"\ncheck \"dry run includes volume detach\" grep -q 'would detach volume vol-1015' \"$WORK/dry.out\"''')\ns = s.replace('log_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"', '''check \"deletions follow dependency order\" test \"$(jq -rs '[.[].effects[] | select(.action == \"deleted\") | .kind] | join(\",\")' \"$CLOUDCTL_STATE/calls.log\")\" = \"dns,lb,volume,instance,instance,subnet,network\"\nreport_before=\"$(cat \"$report\")\"\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.lo"]
[61.581868, "i", "g\")\"''')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"', '''check \"second run changed nothing\" test -z \"$changes\"\ncheck \"second run preserves deletion report\" test \"$(cat \"$report\")\" = \"$report_before\"\n\n# A prior interrupted teardown may already have detached its volume.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl volume detach vol-1015 >/dev/null\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/detached.out\" 2>&1\ncheck \"already-detached volume is handled\" test \"$?\" -eq 0\ncheck \"detached-volume teardown removes all target resources\" test -z \"$(ids_for project=checkout,env=pr-101)\"\ncheck \"other environment remains exactly unchanged\" test \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$(jq '[.resources[] | select(.labels.project == \"checkout\" and .labels.env == \"pr-102\")] | sort_by(.id)' \"$FIXTURES/account.json\")\"\n\nrm -f \"$report\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/empty.out\" 2>&1\ncheck \"initially empty environment exits 0\" test \""]
[61.581997, "o", "python3 - <<'PY'"]
[61.582159, "i", "$?\" -eq 0\ncheck \"initially empty environment gets a no-op report\" grep -q 'Nothing to do' \"$report\"\nstate_before=\"$(cat \"$CLOUDCTL_STATE/state.json\")\"\n(cd \"$APP_ROOT\" && ./teardown.sh unknown-env) > \"$WORK/unknown.out\" 2>&1\ncheck \"unknown environment is rejected\" test \"$?\" -ne 0\ncheck \"unknown environment changes nothing\" test \"$(cat \"$CLOUDCTL_STATE/state.json\")\" = \"$state_before\"''')\np.write_text(s)\nPY\nbash -n teardown.sh lib/inventory.sh lib/order.sh lib/report.sh tests/test_teardown.sh; bash tests/test_teardown.sh\n"]
