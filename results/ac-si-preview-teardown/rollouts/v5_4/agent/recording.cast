[90.721409, "o", "describe net-1011 --json\r\n\u001b[?2004l\r\u001b[?2004h> check \"partial progress report is written\" grep -q '| deleted | dns-1017 | dns |' \"$report\"\r\n\u001b[?2004l\r\u001b[?2004h> check \"blocked resource is not reported as deleted\" bash -c '! grep -q \"| deleted | subnet-1012 |\" \"$1\"' _ \"$report\"\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> assert needle in s\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(needle, '\\n' + insert + needle))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
