[104.283965, "i", "LIVE_AFTER=$(mktemp /tmp/pr-482-after.XXXXXX.json); cloudctl list --json > \"$LIVE_AFTER\"; python3 - \"$LIVE_BEFORE\" \"$LIVE_AFTER\" <<'PY'\nimport json, sys\nbefore = {r['id']: r for r in json.load(open(sys.argv[1]))}\nafter = {r['id']: r for r in json.load(open(sys.argv[2]))}\ntarget = {rid for rid, r in before.items() if r['labels'].get('project') == 'checkout' and r['labels'].get('env') == 'pr-482'}\nassert len(target) == 7, target\nassert set(before) - set(after) == target, 'Unexpected removed resources'\nassert not (set(after) - set(before)), 'Unexpected new resources'\nfor rid, old in before.items():\n    if rid in target:\n        continue\n    new = after[rid].copy()\n    old = old.copy()\n    if rid == 'i-0771':\n        assert new['subnet'] == 'subnet-0a12' and new['status'] == 'running'\n        old['subnet'] = 'subnet-0a12'\n        new.pop('restarted', None)\n        old.pop('restarted', None)\n    assert old == new, f'Unexpected change to {rid}'\nprint('Verified: exactly seven pr-482 resources removed; all other reso"]
[104.28401, "i", "urces unchanged except the documented ledger worker relocation.')\nPY\nprintf '\\n--- live teardown report ---\\n'; cat reports/pr-482.md\n"]
