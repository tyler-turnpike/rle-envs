[90.719602, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle = '\\necho\\nif [[ \"$failures\" -eq 0 ]]'\ninsert = '''\n# A foreign dependent must block deletion, never be swept up by a cascade.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\nrm -f \"$report\"\ncloudctl instance move i-1023 --subnet subnet-1012 >/dev/null\nforeign_before=\"$(cloudctl list --selector project=checkout,env=pr-102 --json)\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked.out\" 2>&1\ncheck \"outside dependency causes failure\" test \"$?\" -eq 4\ncheck \"outside dependent is untouched\" test \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$foreign_before\"\ncheck \"blocked network is retained\" cloudctl describe net-1011 --json\ncheck \"partial progress report is written\" grep -q '| deleted | dns-1017 | dns |' \"$report\"\ncheck \"blocked resource is not reported as deleted\" bash -c '! grep -q \"| deleted | subnet-1012 |\" \"$1\"' _ \"$report\"\n'''\nassert needle in s\np.write_text(s.replace("]
[90.721289, "i", "needle, '\\n' + insert + needle))\nPY\nbash tests/test_teardown.sh\n"]
