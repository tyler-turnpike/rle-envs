[64.15347, "i", "REAL_CHECK=\"$(mktemp -d)\"; export REAL_CHECK\ncloudctl list --json > \"$REAL_CHECK/before.json\"\nmkdir -p \"$REAL_CHECK/account\"\njq '{account:\"rehearsal\", resources: (map({key:.id,value:.}) | from_entries)}' \"$REAL_CHECK/before.json\" > \"$REAL_CHECK/account/state.json\"\n(\nset -euo pipefail\nexport CLOUDCTL_STATE=\"$REAL_CHECK/account\" REPORT_DIR=\"$REAL_CHECK/reports\"\ncloudctl instance move i-0771 --subnet subnet-0a12\n./teardown.sh pr-482\ncloudctl list --json > \"$REAL_CHECK/after-rehearsal.json\"\npython3 - <<'PY'\nimport json, os\nfrom pathlib import Path\np = Path(os.environ['REAL_CHECK'])\nbefore = {r['id']: r for r in json.loads((p/'before.json').read_text())}\nafter = {r['id']: r for r in json.loads((p/'after-rehearsal.json').read_text())}\nexpected = {k:v for k,v in before.items() if v['labels'].get('project') == 'checkout' and v['labels'].get('env') == 'pr-482'}\nassert set(before) - set(after) == set(expected)\nassert not (set(after) - set(before))\nfor rid, r in after.items():\n    old = before[rid].copy()\n    r = r.copy"]
[64.153589, "o", "REAL_CHECK=\"$(mktemp -d)\"; export REAL_CHECK\r\ncloudctl list --json > \"$REAL_CHECK/before.json\"\r\nmkdir -p \"$REAL_CHECK/account\"\r\njq '{account:\"rehearsal\", resources: (map({key:.id,value:.}) | from_entries)}' \"$REAL_CHECK/before.json\" > \"$REAL_CHECK/account/state.json\"\r\n(\r\nset -euo pipefail\r\nexport CLOUDCTL_STATE=\"$REAL_CHECK/account\" REPORT_DIR=\"$REAL_CHECK/reports\"\r\ncloudctl instance move i-0771 --subnet subnet-0a12\r\n./teardown.sh pr-482\r\ncloudctl list --json > \"$REAL_CHECK/after-rehearsal.json\"\r\npython3 - <<'PY'\r\nimport json, os\r\nfrom pathlib import Path\r\np = Path(os.environ['REAL_CHECK'])\r\nbefore = {r['id']: r for r in json.loads((p/'before.json').read_text())}\r\nafter = {r['id']: r for r in json.loads((p/'after-rehearsal.json').read_text())}\r\nexpected = {k:v for k,v in before.items() if v['labels'].get('project') == 'checkout' and v['labels'].get('env') == 'pr-482'}\r\nassert set(before) - set(after) == set(expected)\r\nassert not (set(after) - set(before))\r\nfor rid, r in after.items():\r\n    old = before[rid].c"]
