[78.231968, "i", "(\nset -euo pipefail\ncloudctl instance move i-0771 --subnet subnet-0a12\n./teardown.sh pr-482\ncloudctl list --json > \"$REAL_CHECK/after-real.json\"\npython3 - <<'PY'\nimport json, os\nfrom pathlib import Path\np = Path(os.environ['REAL_CHECK'])\nbefore = {r['id']: r for r in json.loads((p/'before.json').read_text())}\nafter = {r['id']: r for r in json.loads((p/'after-real.json').read_text())}\nexpected = {k:v for k,v in before.items() if v['labels'].get('project') == 'checkout' and v['labels'].get('env') == 'pr-482'}\nassert len(expected) == 7\nassert set(before) - set(after) == set(expected)\nassert not (set(after) - set(before))\nfor rid, resource in after.items():\n    old = before[rid].copy()\n    new = resource.copy()\n    if rid == 'i-0771':\n        assert new['subnet'] == 'subnet-0a12'\n        assert new['status'] == 'running'\n        new.pop('restarted')\n        old['subnet'] = 'subnet-0a12'\n    assert new == old, rid\nreport = Path('reports/pr-482.md')\ntext = report.read_text()\nfor resource in expected.values():\n    a"]
[78.232164, "i", "ssert all(str(resource[field]) in text for field in ('id', 'kind', 'name'))\nwith report.open('a') as f:\n    f.write('\\n## Dependency remediation\\n\\n'\n            'Ledger preview worker `i-0771` (`ledger-pr-77-worker`) was using '\n            '`subnet-4822` and blocked its deletion. Before teardown, it was moved '\n            'to the available platform shared preview subnet `subnet-0a12` '\n            '(`platform-preview-shared-a`), which already hosts the ledger API. '\n            'The move restarted the worker; it remains running. Its journal volume '\n            '`vol-0772` remains attached and unchanged. No ledger resources were deleted.\\n')\nprint('Real account verified: seven pr-482 resources deleted, including net-4821; ledger worker running in shared subnet; all other resources unchanged.')\nPY\ncp reports/pr-482.md \"$REAL_CHECK/final-report.md\"\n./teardown.sh pr-482\ncmp reports/pr-482.md \"$REAL_CHECK/final-report.md\"\ncloudctl list --json > \"$REAL_CHECK/after-rerun.json\"\ncmp \"$REAL_CHECK/after-real.json\" \""]
