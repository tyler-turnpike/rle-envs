[30.892802, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# Do not replace an earlier deletion report with an empty report on a rerun.\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        report_write\n    fi\n    exit 0\nfi\n\nordered_inventory=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\nif [[ \"$DRY_RUN\" -eq 0 ]]; th"]
[30.893633, "i", "en\n    report_init \"$ENV_NAME\"\n    # Keep a record of successful deletions even if a later operation fails.\n    finish_report() {\n        local status=$?\n        trap - EXIT\n        report_write\n        exit \"$status\"\n    }\n    trap finish_report EXIT\nfi\n\n# Keep this loop in the current shell so report state and errors are preserved.\nwhile IFS=$'\\\\t' read -r id kind name; do\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id from $attached_to\"\n            else\n                echo \"detaching volume $id from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered_inv"]
[30.893683, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('lib/order.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('teardown.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.893691, "i", "entory\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh\nbash tests/test_teardown.sh\n"]
