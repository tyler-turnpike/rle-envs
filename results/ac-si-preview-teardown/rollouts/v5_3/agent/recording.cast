[40.41336, "i", "./teardown.sh pr-482 --dry-run; cat teardown.sh lib/order.sh\n"]
[40.414272, "o", "./teardown.sh pr-482 --dry-run; cat teardown.sh lib/order.sh\r\n\u001b[?2004l\r"]
[40.418899, "o", "teardown: env=pr-482 project=checkout selector=project=checkout,env=pr-482\r\n"]
[40.452827, "o", "teardown: 7 resource(s) found\r\n"]
[40.459856, "o", "would delete dns dns-4827 (pr-482.checkout.preview.internal)\r\nwould delete lb lb-4826 (checkout-pr-482-lb)\r\n"]
[40.49129, "o", "would detach volume vol-4825 from i-4824\r\nwould delete volume vol-4825 (checkout-pr-482-pgdata)\r\nwould delete instance i-4823 (checkout-pr-482-web)\r\nwould delete instance i-4824 (checkout-pr-482-worker)\r\nwould delete subnet subnet-4822 (checkout-pr-482-app)\r\nwould delete network net-4821 (checkout-pr-482-vpc)\r\nteardown: done\r\n#!/usr/bin/env bash\r\n# teardown.sh - remove a preview environment's cloud resources.\r\n#\r\n#   ./teardown.sh <env> [--dry-run]\r\n#\r\n# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are\r\n# found with the env's label selector and deleted through cloudctl.\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n# shellcheck source=lib/inventory.sh\r\nsource \"$ROOT/lib/inventory.sh\"\r\n# shellcheck source=lib/order.sh\r\nsource \"$ROOT/lib/order.sh\"\r\n# shellcheck source=lib/report.sh\r\nsource \"$ROOT/lib/report.sh\"\r\n\r\nusage() {\r\n    echo \"usage: $0 <env> [--dry-run]\" >&2\r\n    exit 2\r\n}\r\n\r\n[[ $# -ge 1 ]] || usage\r\nENV_ARG=\"$1\"; shift\r\nDRY_RUN=0\r\nfor arg in \"$@"]
[40.491369, "o", "\"; do\r\n    case \"$arg\" in\r\n        --dry-run) DRY_RUN=1 ;;\r\n        *) usage ;;\r\n    esac\r\ndone\r\n\r\nload_env_config \"$ENV_ARG\"\r\necho \"teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR\"\r\n\r\ninventory=\"$(inventory_collect \"$ENV_SELECTOR\")\"\r\necho \"teardown: $(printf '%s\\n' \"$inventory\" | grep -c . || true) resource(s) found\"\r\n\r\n# Do not replace an earlier deletion report with an empty report on a rerun.\r\nif [[ -z \"$inventory\" ]]; then\r\n    echo \"teardown: nothing to do\"\r\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\r\n        report_init \"$ENV_NAME\"\r\n        report_write\r\n    fi\r\n    exit 0\r\nfi\r\n\r\nordered_inventory=\"$(printf '%s\\n' \"$inventory\" | order_resources)\"\r\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n    report_init \"$ENV_NAME\"\r\n    # Keep a record of successful deletions even if a later operation fails.\r\n    finish_report() {\r\n        local status=$?\r\n        trap - EXIT\r\n        report_write\r\n        exit \"$status\"\r\n    }\r\n    trap finish_report EXIT\r\nfi\r\n\r\n# Keep this loop"]
[40.491374, "o", " in the current shell so report state and errors are preserved.\r\nwhile IFS=$'\\t' read -r id kind name; do\r\n    if [[ \"$kind\" == volume ]]; then\r\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n        if [[ -n \"$attached_to\" ]]; then\r\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n                echo \"would detach volume $id from $attached_to\"\r\n            else\r\n                echo \"detaching volume $id from $attached_to\"\r\n                \"$CLOUDCTL\" volume detach \"$id\"\r\n            fi\r\n        fi\r\n    fi\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    \"$CLOUDCTL\" delete \"$id\"\r\n    report_add deleted \"$id\" \"$kind\" \"$name\"\r\ndone <<< \"$ordered_inventory\"\r\n\r\necho \"teardown: done\"\r\n# shellcheck shell=bash\r\n# Ordering of resources for teardown.\r\n#\r\n# Resources have to go in reverse dependency order: cloudctl refuses to delete\r\n# anything that still has dependents (see `cloudctl --help`).\r\n\r\n# order"]
[40.491378, "o", "_rank KIND -> numeric rank; lower ranks are processed first.\r\norder_rank() {\r\n    case \"$1\" in\r\n        dns)      echo 10 ;;\r\n        lb)       echo 20 ;;\r\n        volume)   echo 30 ;;\r\n        instance) echo 40 ;;\r\n        subnet)   echo 50 ;;\r\n        network)  echo 60 ;;\r\n        *)        echo 99 ;;\r\n    esac\r\n}\r\n\r\n# order_resources < \"<id>\\t<kind>\\t<name>\" lines\r\n# Prints the same lines sorted by rank (stable within a rank).\r\norder_resources() {\r\n    local id kind name\r\n    while IFS=$'\\t' read -r id kind name; do\r\n        [[ -z \"$id\" ]] && continue\r\n        printf '%s\\t%s\\t%s\\t%s\\n' \"$(order_rank \"$kind\")\" \"$id\" \"$kind\" \"$name\"\r\n    done | sort -s -n -k1,1 | cut -f2-\r\n}\r\n\u001b[?2004hroot@47ec5d8d8560:/app# "]
[62.962164, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle = '(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1'\ns = s.replace(needle, '''cp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before-dry-run.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry-run.out\" 2>&1\ncheck \"dry-run exits 0\" test \"$?\" -eq 0\ncheck \"dry-run changes no resources\" cmp -s \"$WORK/before-dry-run.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry-run plans volume detach\" grep -q \"would detach volume vol-1015\" \"$WORK/dry-run.out\"\ncheck \"dry-run writes no deletion report\" test ! -e \"$REPORT_DIR/pr-101.md\"\n\n''' + needle)\ns = s.replace('log_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"', 'cp \"$report\" \"$WORK/first-report.md\"\\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"', '''check \"second run changed nothing\" test -z \"$changes\"\ncheck \"second run preserves deletion report\" cmp -s \"$WORK/first-report.md\""]
[62.962245, "i", " \"$report\"\n\n# A previous attempt may already have detached a volume before stopping.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl volume detach vol-1015 > /dev/null\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/detached.out\" 2>&1\ncheck \"teardown with an already-detached volume exits 0\" test \"$?\" -eq 0\ncheck \"already-detached volume is deleted\" test -z \"$(ids_for project=checkout,env=pr-101)\"\ncheck \"other environment remains untouched\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\n\nrm -f \"$report\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/empty.out\" 2>&1\ncheck \"empty environment without an earlier report exits 0\" test \"$?\" -eq 0\ncheck \"empty environment gets a no-op report\" grep -qi \"nothing to do\" \"$report\"''')\np.write_text(s)\nPY\nbash tests/test_teardown.sh\n"]
