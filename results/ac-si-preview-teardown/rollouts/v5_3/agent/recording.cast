[40.333441, "o", "11\",\r\n    \"status\": \"available\"\r\n  },\r\n  {\r\n    \"cidr\": \"10.82.1.0/24\",\r\n    \"created\": \"2026-11-09T14:02:40\",\r\n    \"id\": \"subnet-4822\",\r\n    \"kind\": \"subnet\",\r\n    \"labels\": {\r\n      \"env\": \"pr-482\",\r\n      \"expires\": \"2026-11-21\",\r\n      \"owner\": \"checkout-team\",\r\n      \"project\": \"checkout\"\r\n    },\r\n    \"name\": \"checkout-pr-482-app\",\r\n    \"network\": \"net-4821\",\r\n    \"status\": \"available\"\r\n  }\r\n]\r\n"]
