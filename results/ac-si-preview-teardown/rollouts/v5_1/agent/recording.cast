[65.978159, "o", "#!/usr/bin/env bash\r\n# teardown.sh - remove a preview environment's cloud resources.\r\n#\r\n#   ./teardown.sh <env> [--dry-run]\r\n#\r\n# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are\r\n# found with the env's label selector and deleted through cloudctl.\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n# shellcheck source=lib/inventory.sh\r\nsource \"$ROOT/lib/inventory.sh\"\r\n# shellcheck source=lib/order.sh\r\nsource \"$ROOT/lib/order.sh\"\r\n# shellcheck source=lib/report.sh\r\nsource \"$ROOT/lib/report.sh\"\r\n\r\nusage() {\r\n    echo \"usage: $0 <env> [--dry-run]\" >&2\r\n    exit 2\r\n}\r\n\r\n[[ $# -ge 1 ]] || usage\r\nENV_ARG=\"$1\"; shift\r\nDRY_RUN=0\r\nfor arg in \"$@\"; do\r\n    case \"$arg\" in\r\n        --dry-run) DRY_RUN=1 ;;\r\n        *) usage ;;\r\n    esac\r\ndone\r\n\r\nload_env_config \"$ENV_ARG\"\r\necho \"teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR\"\r\n\r\ninventory=\"$(inventory_collect \"$ENV_SELECTOR\")\"\r\necho \"teardown: $(printf '%s\\n' \"$inventory\" | grep -c . || true) resourc"]
[65.978282, "o", "e(s) found\"\r\n\r\n# Preserve an existing deletion report when an already-clean env is rerun.\r\nif [[ -z \"$inventory\" ]]; then\r\n    echo \"teardown: nothing to do\"\r\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\r\n        report_init \"$ENV_NAME\"\r\n        report_write\r\n    fi\r\n    exit 0\r\nfi\r\n\r\n# Keep report rows in this shell, and publish even a partially completed run.\r\n# A dry run must not mutate cloud resources or overwrite a real report.\r\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n    report_init \"$ENV_NAME\"\r\n    trap 'report_write' EXIT\r\nfi\r\n\r\nordered=\"$(printf '%s\\n' \"$inventory\" | order_resources)\"\r\nwhile IFS=$'\\t' read -r id kind name; do\r\n    [[ -n \"$id\" ]] || continue\r\n    if [[ \"$kind\" == volume ]]; then\r\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n        if [[ -n \"$attached_to\" ]]; then\r\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n                echo \"would detach volume $id ($name) from $attached_to\"\r\n            else\r\n                echo \"detaching volume $id ($name) f"]
[65.978366, "o", "rom $attached_to\"\r\n                \"$CLOUDCTL\" volume detach \"$id\"\r\n            fi\r\n        fi\r\n    fi\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    if \"$CLOUDCTL\" delete \"$id\"; then\r\n        report_add deleted \"$id\" \"$kind\" \"$name\"\r\n    else\r\n        rc=$?\r\n        report_add failed \"$id\" \"$kind\" \"$name\" \"delete refused (exit $rc); resource retained\"\r\n        echo \"teardown: stopped at $id; remaining resources retained (no force deletion)\" >&2\r\n        exit \"$rc\"\r\n    fi\r\ndone <<< \"$ordered\"\r\n\r\necho \"teardown: done\"\r\n"]
