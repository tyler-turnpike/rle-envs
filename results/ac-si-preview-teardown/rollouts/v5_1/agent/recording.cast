[31.477882, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.', '# Delete dependents first; attached volumes are detached by the caller.')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# Keep report rows in this shell, and publish even a partially completed run.\n# A dry run must not mutate cloud resources or overwrite a real report.\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    trap 'report_write' EXIT\nfi\n\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    exit "]
[31.478107, "o", "python3 - <<'PY'"]
[31.478124, "i", "0\nfi\n\nordered=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\nwhile IFS=$'\\\\t' read -r id kind name; do\n    [[ -n \"$id\" ]] || continue\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id ($name) from $attached_to\"\n            else\n                echo \"detaching volume $id ($name) from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh\n"]
[31.479017, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('lib/order.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.', '# Delete dependents first; attached volumes are detached by the caller.')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('teardown.sh')\r\n\u001b[?2004l\r\u001b[?2004h"]
