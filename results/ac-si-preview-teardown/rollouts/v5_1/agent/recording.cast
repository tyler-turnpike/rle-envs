[6.937385, "o", "#!/usr/bin/env bash\r\n# teardown.sh - remove a preview environment's cloud resources.\r\n#\r\n#   ./teardown.sh <env> [--dry-run]\r\n#\r\n# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are\r\n# found with the env's label selector and deleted through cloudctl.\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n# shellcheck source=lib/inventory.sh\r\nsource \"$ROOT/lib/inventory.sh\"\r\n# shellcheck source=lib/order.sh\r\nsource \"$ROOT/lib/order.sh\"\r\n# shellcheck source=lib/report.sh\r\nsource \"$ROOT/lib/report.sh\"\r\n\r\nusage() {\r\n    echo \"usage: $0 <env> [--dry-run]\" >&2\r\n    exit 2\r\n}\r\n\r\n[[ $# -ge 1 ]] || usage\r\nENV_ARG=\"$1\"; shift\r\nDRY_RUN=0\r\nfor arg in \"$@\"; do\r\n    case \"$arg\" in\r\n        --dry-run) DRY_RUN=1 ;;\r\n        *) usage ;;\r\n    esac\r\ndone\r\n\r\nload_env_config \"$ENV_ARG\"\r\necho \"teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR\"\r\n\r\ninventory=\"$(inventory_collect \"$ENV_SELECTOR\")\"\r\necho \"teardown: $(printf '%s\\n' \"$inventory\" | grep -c . || true) resourc"]
[6.938144, "o", "e(s) found\"\r\n\r\n# TODO(PLAT-311): volumes have to be detached before they can be deleted.\r\n# TODO(PLAT-311): make re-runs safe and write the report (lib/report.sh).\r\nprintf '%s\\n' \"$inventory\" | order_resources | while IFS=$'\\t' read -r id kind name; do\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    \"$CLOUDCTL\" delete \"$id\"\r\ndone\r\n\r\necho \"teardown: done\"\r\n"]
[6.947195, "o", "# shellcheck shell=bash\r\n# Teardown report: one markdown file per env under $REPORT_DIR.\r\n#\r\n#   report_init ENV           start a new report (truncates the scratch rows)\r\n#   report_add ACTION ID KIND NAME [NOTE]\r\n#   report_write              render reports/<env>.md, prints its path\r\n\r\nREPORT_DIR=\"${REPORT_DIR:-$ROOT/reports}\"\r\n_REPORT_ENV=\"\"\r\n_REPORT_ROWS=\"\"\r\n\r\nreport_init() {\r\n    _REPORT_ENV=\"$1\"\r\n    mkdir -p \"$REPORT_DIR\"\r\n    _REPORT_ROWS=\"$(mktemp)\"\r\n}\r\n\r\nreport_add() {\r\n    [[ -n \"$_REPORT_ROWS\" ]] || { echo \"report: report_init not called\" >&2; return 1; }\r\n    local action=\"$1\" id=\"$2\" kind=\"$3\" name=\"$4\" note=\"${5:-}\"\r\n    printf '%s\\t%s\\t%s\\t%s\\t%s\\n' \"$action\" \"$id\" \"$kind\" \"$name\" \"$note\" >> \"$_REPORT_ROWS\"\r\n}\r\n\r\nreport_path() {\r\n    echo \"$REPORT_DIR/${_REPORT_ENV}.md\"\r\n}\r\n\r\nreport_write() {\r\n    local out action id kind name note\r\n    out=\"$(report_path)\"\r\n    {\r\n        echo \"# Teardown report: ${_REPORT_ENV}\"\r\n        echo\r\n        echo \"- generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\r\n      "]
[6.947402, "o", "  echo \"- selector: ${ENV_SELECTOR:-?}\"\r\n        echo\r\n        if [[ ! -s \"$_REPORT_ROWS\" ]]; then\r\n            echo \"Nothing to do: no resources matched.\"\r\n        else\r\n            echo \"| action | id | kind | name | note |\"\r\n            echo \"|---|---|---|---|---|\"\r\n            while IFS=$'\\t' read -r action id kind name note; do\r\n                echo \"| $action | $id | $kind | $name | $note |\"\r\n            done < \"$_REPORT_ROWS\"\r\n        fi\r\n    } > \"$out\"\r\n    rm -f \"$_REPORT_ROWS\"\r\n    echo \"$out\"\r\n}\r\n# Preview environments known to the teardown tool.\r\n# env       project    selector (passed to `cloudctl list --selector`)\r\npr-455      checkout   project=checkout,env=pr-455\r\npr-461      checkout   project=checkout,env=pr-461\r\npr-480      checkout   project=checkout,env=pr-480\r\npr-482      checkout   project=checkout,env=pr-482\r\npr-77       ledger     project=ledger,env=pr-77\r\n#!/usr/bin/env bash\r\n# End-to-end test of teardown.sh against a throwaway copy of the fixture account.\r\n#   bash tests/test_teardo"]
[6.947447, "o", "wn.sh\r\nset -uo pipefail\r\n\r\nAPP_ROOT=\"${APP_ROOT:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)}\"\r\nFIXTURES=\"${FIXTURES:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)/fixtures}\"\r\nWORK=\"$(mktemp -d)\"\r\ntrap 'rm -rf \"$WORK\"' EXIT\r\n\r\nexport CLOUDCTL_STATE=\"$WORK/account\"\r\nexport REPORT_DIR=\"$WORK/reports\"\r\nexport PREVIEWS_CONF=\"$FIXTURES/previews.conf\"\r\nmkdir -p \"$CLOUDCTL_STATE\"\r\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\r\n\r\nfailures=0\r\ncheck() {  # check DESCRIPTION COMMAND...\r\n    local desc=\"$1\"; shift\r\n    if \"$@\"; then echo \"ok   - $desc\"; else echo \"FAIL - $desc\"; failures=$((failures + 1)); fi\r\n}\r\nids_for() {  # ids_for SELECTOR\r\n    cloudctl list --selector \"$1\" --json | jq -r '.[].id' | sort\r\n}\r\n\r\nbefore_101=\"$(ids_for project=checkout,env=pr-101)\"\r\nbefore_102=\"$(ids_for project=checkout,env=pr-102)\"\r\n\r\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1\r\nrc1=$?\r\nsed 's/^/    run1| /' \"$WORK/run1.out\"\r\ncheck \"first run exits 0\" test \"$rc1\" -eq 0\r\ncheck \"every pr-101 resource"]
[6.947564, "o", " is gone\" test -z \"$(ids_for project=checkout,env=pr-101)\"\r\ncheck \"pr-102 is untouched\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\r\n\r\nreport=\"$REPORT_DIR/pr-101.md\"\r\ncheck \"report written to reports/pr-101.md\" test -s \"$report\"\r\nfor id in $before_101; do\r\n    check \"report lists $id\" grep -qs -- \"$id\" \"$report\"\r\ndone\r\n\r\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"\r\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run2.out\" 2>&1\r\nrc2=$?\r\nsed 's/^/    run2| /' \"$WORK/run2.out\"\r\ncheck \"second run exits 0\" test \"$rc2\" -eq 0\r\ncheck \"second run says there is nothing to do\" grep -qi \"nothing to do\" \"$WORK/run2.out\"\r\nchanges=\"$(tail -n +\"$((log_lines + 1))\" \"$CLOUDCTL_STATE/calls.log\" | jq -c 'select(.effects | length > 0)')\"\r\ncheck \"second run changed nothing\" test -z \"$changes\"\r\n\r\necho\r\nif [[ \"$failures\" -eq 0 ]]; then echo \"all checks passed\"; else echo \"$failures check(s) failed\"; exit 1; fi\r\n\u001b[?2004hroot@84b702f8523f:/app# "]
[7.077312, "i", "cloudctl --help\n"]
[7.077659, "o", "cloudctl --help\r\n\u001b[?2004l\r"]
[7.167735, "o", "cloudctl - preview account CLI\r\n\r\nusage:\r\n  cloudctl list [--kind KIND] [--selector K=V[,K=V...]] [--match GLOB] [--json]\r\n  cloudctl describe ID|NAME [--json]\r\n  cloudctl deps ID|NAME [--json]       what depends on a resource\r\n  cloudctl delete ID|NAME... [--force] [--dry-run]\r\n  cloudctl delete (--selector K=V[,...] | --match GLOB) [--kind KIND] [--force] [--dry-run]\r\n  cloudctl volume detach VOLUME\r\n  cloudctl lb deregister LB INSTANCE\r\n  cloudctl instance move INSTANCE --subnet SUBNET\r\n\r\nkinds: network, subnet, instance, volume, lb, dns\r\nlabels: every resource carries project, env and owner labels; preview envs also\r\n        carry an expires=YYYY-MM-DD label\r\n\r\ndelete:\r\n  A resource that still has dependents is refused with DependencyViolation (exit 4):\r\n  networks with subnets; subnets with instances or load balancers; instances with\r\n  attached volumes, load-balancer registrations or DNS records; load balancers with\r\n  DNS records; volumes that are still attached.\r\n  --force      cascade: detach attache"]
[7.167935, "o", "d volumes, deregister from load balancers and\r\n               delete every dependent resource first, then delete the target\r\n  --selector   bulk delete of every resource whose labels match\r\n  --match      bulk delete of every resource whose name matches GLOB (e.g. 'pr-*')\r\n  --kind       restrict a bulk delete to one kind\r\n  --dry-run    print what would happen, change nothing\r\n\r\ninstance move:\r\n  stops the instance, re-homes it into SUBNET (attached volumes, load-balancer\r\n  registrations and DNS records stay with it) and starts it again\r\n\r\nexit codes: 0 ok, 2 usage, 3 not found, 4 dependency violation\r\naccount data: $CLOUDCTL_STATE (default /var/tmp/mockcloud)\r\n\r\n"]
