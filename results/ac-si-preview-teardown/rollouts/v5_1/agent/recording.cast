[66.069091, "i", "cat > tests/test_teardown_edge_cases.sh <<'EOF'\n#!/usr/bin/env bash\n# Additional safety checks, always against a disposable fixture account.\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\nWORK=\"$(mktemp -d)\"\ntrap 'rm -rf \"$WORK\"' EXIT\nexport CLOUDCTL_STATE=\"$WORK/account\" REPORT_DIR=\"$WORK/reports\"\nexport PREVIEWS_CONF=\"$ROOT/tests/fixtures/previews.conf\"\nmkdir -p \"$CLOUDCTL_STATE\"\nreset_account() { cp \"$ROOT/tests/fixtures/account.json\" \"$CLOUDCTL_STATE/state.json\"; }\nreset_account\ncp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before.json\"\n\"$ROOT/teardown.sh\" pr-101 --dry-run > \"$WORK/dry.out\"\ncmp \"$WORK/before.json\" \"$CLOUDCTL_STATE/state.json\"\ntest ! -e \"$REPORT_DIR/pr-101.md\"\ngrep -q 'would detach volume vol-1015' \"$WORK/dry.out\"\necho 'ok - dry run does not mutate resources or write a report'\ncloudctl volume detach vol-1015 >/dev/null\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/detached.out\"\ntest \"$(cloudctl list --selector project=checkout,env=pr-101 --json | jq length)\" -eq 0\ncp \"$REPORT_DIR"]
[66.069505, "i", "/pr-101.md\" \"$WORK/report.md\"\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/empty.out\"\ngrep -qi 'nothing to do' \"$WORK/empty.out\"\ncmp \"$WORK/report.md\" \"$REPORT_DIR/pr-101.md\"\necho 'ok - already-detached volume and no-op report preservation'\nreset_account\n# Simulate an unrelated instance placed in the target environment's subnet.\njq '.resources[\"i-1023\"].subnet = \"subnet-1012\"' \"$CLOUDCTL_STATE/state.json\" > \"$WORK/cross.json\"\ncp \"$WORK/cross.json\" \"$CLOUDCTL_STATE/state.json\"\nrc=0\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/blocked.out\" 2>&1 || rc=$?\ntest \"$rc\" -eq 4\njq -e --slurpfile before \"$WORK/cross.json\" '\n  .resources as $after | $before[0].resources | to_entries |\n  map(select(.value.labels.env == \"pr-102\")) |\n  all(.[]; .value == $after[.key])' \"$CLOUDCTL_STATE/state.json\" >/dev/null\ncloudctl describe subnet-1012 >/dev/null\ncloudctl describe net-1011 >/dev/null\ngrep -q '| deleted | vol-1015 | volume | checkout-pr-101-pgdata |' \"$REPORT_DIR/pr-101.md\"\ngrep -q '| failed | subnet-1012 |' \"$REPORT_DIR/pr-101.md\"\necho 'ok"]
