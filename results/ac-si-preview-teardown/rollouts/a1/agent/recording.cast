[108.242776, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/report.sh')\ns = p.read_text().replace('_REPORT_ROWS=\"\"\\n', '_REPORT_ROWS=\"\"\\n_REPORT_PREVIOUS_DELETIONS=\"\"\\n', 1)\ns = s.replace('    _REPORT_ROWS=\"$(mktemp)\"\\n', '''    _REPORT_ROWS=\"$(mktemp)\"\n    # Keep successful deletions from earlier, partially completed attempts.\n    _REPORT_PREVIOUS_DELETIONS=\"\"\n    if [[ -f \"$(report_path)\" ]]; then\n        _REPORT_PREVIOUS_DELETIONS=\"$(sed -n '/^| deleted | /p' \"$(report_path)\")\"\n    fi\n''')\ns = s.replace('if [[ ! -s \"$_REPORT_ROWS\" ]]; then', 'if [[ ! -s \"$_REPORT_ROWS\" && -z \"$_REPORT_PREVIOUS_DELETIONS\" ]]; then')\ns = s.replace('            echo \"|---|---|---|---|---|\"\\n', '''            echo \"|---|---|---|---|---|\"\n            if [[ -n \"$_REPORT_PREVIOUS_DELETIONS\" ]]; then\n                printf '%s\\\\n' \"$_REPORT_PREVIOUS_DELETIONS\"\n            fi\n''')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text().replace('    \"$CLOUDCTL\" delete \"$id\"\\n    report_add deleted', '''    if delete_output=\"$(\"$CLOUDC"]
