[108.243039, "i", "TL\" delete \"$id\" 2>&1)\"; then\n        printf '%s\\\\n' \"$delete_output\"\n    else\n        status=$?\n        printf '%s\\\\n' \"$delete_output\" >&2\n        report_add blocked \"$id\" \"$kind\" \"$name\" \"$delete_output\"\n        exit \"$status\"\n    fi\n    report_add deleted''')\np.write_text(s)\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nmarker='\\necho\\nif [[ \"$failures\" -eq 0 ]]'\nextra='''\n# Cross-environment dependencies must block deletion, never trigger a cascade.\npython3 - \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\" <<'PYFIXTURE'\nimport json, sys\nwith open(sys.argv[1]) as f:\n    state = json.load(f)\nr = dict(state['resources']['i-1023'])\nr.update(id='i-cross', name='unrelated-worker', subnet='subnet-1012')\nstate['resources'][r['id']] = r\nwith open(sys.argv[2], 'w') as f:\n    json.dump(state, f)\nPYFIXTURE\nrm -f \"$report\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked.out\" 2>&1\ncheck \"cross-env dependency blocks teardown\" test \"$?\" -eq 4\ncheck \"unrelated dependent survives\" cloudctl describe "]
