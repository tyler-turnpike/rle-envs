[36.570457, "o", "        if report=\"$(report_write)\"; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.570583, "o", "            echo \"teardown: report=$report\"\r\n\u001b[?2004l\r\u001b[?2004h>         else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.570662, "o", "            echo \"teardown: failed to write report\" >&2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.57072, "o", "            [[ \"$status\" -ne 0 ]] || status=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.570743, "o", "        fi\r\n\u001b[?2004l\r"]
[36.570795, "o", "\u001b[?2004h>         exit \"$status\"\r\n\u001b[?2004l\r"]
[36.570826, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[36.570902, "o", "\u001b[?2004h"]
[36.571003, "o", "> "]
[36.571065, "o", "    trap finish_report EXIT\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571157, "o", "# Run in this shell so report state is not lost in a pipeline subshell.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571162, "o", "while IFS=$'\\\\t' read -r id kind name; do\r\n"]
[36.571311, "o", "\u001b[?2004l\r\u001b[?2004h>     if [[ \"$kind\" == volume ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571331, "o", "        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.571514, "o", ">         if [[ -n \"$attached_to\" ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571536, "o", "            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571542, "o", "                echo \"would detach volume $id from $attached_to\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571676, "o", "            else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571698, "o", "                echo \"detaching volume $id from $attached_to\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.571752, "o", "                \"$CLOUDCTL\" volume detach \"$id\"\r\n\u001b[?2004l\r\u001b[?2004h>             fi"]
[36.571769, "o", "\r\n\u001b[?2004l\r"]
[36.571939, "o", "\u001b[?2004h>         fi\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h>     if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n\u001b[?2004l\r"]
[36.571967, "o", "\u001b[?2004h> "]
[36.572029, "o", "        echo \"would delete $kind $id ($name)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.572083, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.572182, "o", "    echo \"deleting $kind $id ($name)\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.572202, "o", ">     \"$CLOUDCTL\" delete \"$id\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.572268, "o", "> "]
[36.572278, "o", "    report_add deleted \"$id\" \"$kind\" \"$name\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.57233, "o", "> done <<< \"$ordered_inventory\"\r\n\u001b[?2004l\r"]
[36.572341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.572425, "o", "\u001b[?2004h> echo \"teardown: done\"\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[36.572483, "o", "\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
