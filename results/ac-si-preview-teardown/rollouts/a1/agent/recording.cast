[52.611647, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\ns = s.replace('before_102=\"$(ids_for project=checkout,env=pr-102)\"\\n', '''before_102=\"$(ids_for project=checkout,env=pr-102)\"\n\ncp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before-dry-run.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry-run.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run leaves account unchanged\" cmp -s \"$WORK/before-dry-run.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry run writes no report\" test ! -e \"$REPORT_DIR/pr-101.md\"\ncheck \"dry run includes volume detachment\" grep -q \"would detach volume vol-1015\" \"$WORK/dry-run.out\"\n''')\ns = s.replace('done\\n\\nlog_lines=', '''done\nwhile IFS=$'\\\\t' read -r id kind name; do\n    check \"report includes id, kind and name for $id\" grep -Fq \"| deleted | $id | $kind | $name |\" \"$report\"\ndone < <(jq -r '.resources[] | select(.labels.env == \"pr-101\") | [.id, .kind, .name] | @tsv' \"$FIXTURES/account.json\")\ncp \"$report\" \"$WORK/first-repor"]
[52.611948, "i", "t.md\"\n\nlog_lines=''')\ns = s.replace('check \"second run changed nothing\" test -z \"$changes\"\\n', '''check \"second run changed nothing\" test -z \"$changes\"\ncheck \"second run preserves deletion report\" cmp -s \"$report\" \"$WORK/first-report.md\"\n\n# An interrupted teardown may leave a volume detached but not yet deleted.\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl volume detach vol-1015 > /dev/null\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/detached.out\" 2>&1\ncheck \"already-detached volume is handled\" test \"$?\" -eq 0\ncheck \"detached-volume run removes the env\" test -z \"$(ids_for project=checkout,env=pr-101)\"\ncheck \"detached-volume run leaves pr-102 untouched\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\n''')\np.write_text(s)\nPY\nbash -n teardown.sh lib/order.sh tests/test_teardown.sh\nbash tests/test_teardown.sh\n"]
[52.611979, "o", "python3 - <<'PY'"]
