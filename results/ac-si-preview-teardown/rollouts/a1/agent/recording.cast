[108.253701, "o", "(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked-retry.out\" 2>&1\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.253714, "o", "> check \"blocked retry still fails safely\" test \"$?\" -eq 4"]
[108.253729, "o", "\r\n"]
[108.253813, "o", "\u001b[?2004l\r"]
[108.253851, "o", "\u001b[?2004h"]
[108.253882, "o", "> "]
[108.254014, "o", "check \"blocked retry retains earlier deletions\" grep -q '| deleted | dns-1017 |' \"$report\"\r\n"]
[108.254139, "o", "\u001b[?2004l\r\u001b[?2004h"]
[108.254149, "o", "> # Once the external dependency is removed, a retry can finish the env."]
[108.254184, "o", "\r\n"]
[108.255057, "o", "\u001b[?2004l\r\u001b[?2004h> cloudctl delete i-cross > /dev/null\r\n\u001b[?2004l\r\u001b[?2004h> (cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/resumed.out\" 2>&1\r\n\u001b[?2004l\r\u001b[?2004h> check \"teardown resumes after blocker is resolved\" test \"$?\" -eq 0\r\n\u001b[?2004l\r\u001b[?2004h> for id in $before_101; do\r\n\u001b[?2004l\r\u001b[?2004h>     check \"resumed report retains $id\" grep -qs -- \"$id\" \"$report\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> check \"resumed teardown removes the env\" test -z \"$(ids_for project=checkout,env=pr-101)\"\r\n\u001b[?2004l\r\u001b[?2004h> check \"resumed teardown preserves other env\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> assert marker in s\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(marker, '\\n' + extra + marker)\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
