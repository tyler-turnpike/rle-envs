[119.633418, "i", "./teardown.sh pr-482; teardown_rc=$?; printf 'pr-482 teardown exit code: %s\\n' \"$teardown_rc\"\ncloudctl list --json > \"$verification_dir/final.json\"\npython3 - \"$verification_dir\" <<'PY'\nimport json, sys\nfrom pathlib import Path\nwork = Path(sys.argv[1])\nbefore = json.loads((work / 'before.json').read_text())\nafter = json.loads((work / 'final.json').read_text())\ndef target(r):\n    return r['labels'].get('project') == 'checkout' and r['labels'].get('env') == 'pr-482'\nassert [r for r in before if not target(r)] == [r for r in after if not target(r)], 'unrelated resources changed'\nassert {r['id'] for r in after if target(r)} == {'subnet-4822', 'net-4821'}\nremaining = {r['id'] for r in after}\nreport = Path('reports/pr-482.md').read_text()\nfor r in before:\n    if target(r) and r['id'] not in remaining:\n        assert f\"| deleted | {r['id']} | {r['kind']} | {r['name']} |\" in report\nassert '| blocked | subnet-4822 |' in report and 'i-0771' in report\nprint('Verified: five deletions reported; subnet/network retained; all"]
[119.633475, "i", " unrelated resources unchanged.')\nPY\ncat reports/pr-482.md\n"]
