[36.568006, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# Preserve the deletion report when an already torn-down env is run again.\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    if [[ \"$DRY_RUN\" -eq 0 && ! -e \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        echo \"teardown: report=$(report_write)\"\n    fi\n    exit 0\nfi\n\n# Sort before making changes so ordering failures cannot be hidden by the"]
[36.568052, "i", " loop.\nordered_inventory=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\n\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Keep a record of successful deletions even if a later operation fails.\n    finish_report() {\n        local status=$? report\n        trap - EXIT\n        if report=\"$(report_write)\"; then\n            echo \"teardown: report=$report\"\n        else\n            echo \"teardown: failed to write report\" >&2\n            [[ \"$status\" -ne 0 ]] || status=1\n        fi\n        exit \"$status\"\n    }\n    trap finish_report EXIT\nfi\n\n# Run in this shell so report state is not lost in a pipeline subshell.\nwhile IFS=$'\\\\t' read -r id kind name; do\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id from $attached_to\"\n            else\n                echo \"detaching volume $id from $attached_to\"\n                \"$CLOUDCT"]
[36.568058, "i", "L\" volume detach \"$id\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered_inventory\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh\nbash tests/test_teardown.sh\n"]
