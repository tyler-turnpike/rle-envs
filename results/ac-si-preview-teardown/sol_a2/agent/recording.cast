[64.382809, "o", "[\r\n  {\r\n    \"created\": \"2026-11-12T10:22:30\",\r\n    \"id\": \"dns-0776\",\r\n    \"kind\": \"dns\",\r\n    \"labels\": {\r\n      \"env\": \"pr-77\",\r\n      \"expires\": \"2026-11-15\",\r\n      \"owner\": \"ledger-team\",\r\n      \"project\": \"ledger\"\r\n    },\r\n    \"name\": \"pr-77.ledger.preview.internal\",\r\n    \"status\": \"active\",\r\n    \"target\": \"i-0775\"\r\n  },\r\n  {\r\n    \"created\": \"2026-11-12T10:21:09\",\r\n    \"id\": \"i-0771\",\r\n    \"image\": \"ledger-worker:pr-77\",\r\n    \"kind\": \"instance\",\r\n    \"labels\": {\r\n      \"env\": \"pr-77\",\r\n      \"expires\": \"2026-11-15\",\r\n      \"owner\": \"ledger-team\",\r\n      \"project\": \"ledger\"\r\n    },\r\n    \"name\": \"ledger-pr-77-worker\",\r\n    \"status\": \"running\",\r\n    \"subnet\": \"subnet-4822\"\r\n  },\r\n  {\r\n    \"created\": \"2026-11-12T10:19:58\",\r\n    \"id\": \"i-0775\",\r\n    \"image\": \"ledger-api:pr-77\",\r\n    \"kind\": \"instance\",\r\n    \"labels\": {\r\n      \"env\": \"pr-77\",\r\n      \"expires\": \"2026-11-15\",\r\n      \"owner\": \"ledger-team\",\r\n      \"project\": \"ledger\"\r\n    },\r\n    \"name\": \"ledger-pr-77-api\",\r\n    \"status\": \"running\",\r\n    \"subnet\""]
