[55.640722, "i", "(\nset -e\nwork=\"$(mktemp -d)\"\ntrap 'rm -rf \"$work\"' EXIT\ncloudctl list --json > \"$work/before.json\"\n./teardown.sh pr-482\ncloudctl list --json > \"$work/after.json\"\npython3 - \"$work/before.json\" \"$work/after.json\" reports/pr-482.md <<'PY'\nimport json\nimport sys\nfrom pathlib import Path\nbefore, after = [json.loads(Path(p).read_text()) for p in sys.argv[1:3]]\ndef target(r):\n    return r['labels'].get('project') == 'checkout' and r['labels'].get('env') == 'pr-482'\nremoved = [r for r in before if target(r)]\nassert len(removed) == 7, f'Expected seven target resources, found {len(removed)}'\nassert not any(target(r) for r in after), 'Target resources remain'\nassert {r['id']: r for r in before if not target(r)} == {r['id']: r for r in after}, 'Non-target resources changed'\nreport = Path(sys.argv[3]).read_text()\nfor r in removed:\n    assert f\"| deleted | {r['id']} | {r['kind']} | {r['name']} |\" in report, f\"Missing report row: {r['id']}\"\nprint('Verified: all seven pr-482 resources removed; all other resources unchanged; "]
[55.641162, "o", "(\r\n\u001b[?2004l\r"]
[55.641217, "i", "report complete.')\nPY\ncp reports/pr-482.md \"$work/report.md\"\n./teardown.sh pr-482\ncmp reports/pr-482.md \"$work/report.md\"\nprintf '\\n--- final report ---\\n'\ncat reports/pr-482.md\n)\n"]
[55.641414, "o", "report complete.')\r\nPY\r\ncp reports/pr-482.md \"$work/report.md\"\r\n./teardown.sh pr-482\r\ncmp reports/pr-482.md \"$work/report.md\"\r\nprintf '\\n--- final report ---\\n'\r\ncat reports/pr-482.md\r\n)\r\n\u001b[?2004h> set -e\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.641529, "o", "> work=\"$(mktemp -d)\"\r\n"]
