[23.87607, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# Sort before making changes so inventory/ordering failures cannot be hidden by\n# process substitution or a loop running in a pipeline subshell.\nordered_inventory=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\n\nif [[ -z \"$ordered_inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    # Preserve the deletion audit from an earlier successful run.\n    if [[ \"$DRY_RUN\" -eq 0 && ! "]
[23.876745, "i", "-f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        report_write\n    fi\n    exit 0\nfi\n\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Keep a record of successful deletions even if a later operation fails.\n    trap 'report_write' EXIT\nfi\n\nwhile IFS=$'\\\\t' read -r id kind name; do\n    [[ -n \"$id\" ]] || continue\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        [[ \"$kind\" != volume ]] || echo \"would detach volume $id ($name) if attached\"\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            echo \"detaching volume $id ($name) from $attached_to\"\n            \"$CLOUDCTL\" volume detach \"$id\"\n        fi\n    fi\n    echo \"deleting $kind $id ($name)\"\n    \"$CLOUDCTL\" delete \"$id\"\n    report_add deleted \"$id\" \"$kind\" \"$name\"\ndone <<< \"$ordered_inventory\"\n\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_write\n    trap - EXIT\nfi"]
[23.878258, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.879643, "i", "\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh\nbash tests/test_teardown.sh\n"]
