[64.414754, "i", "sed -n '1,110p' tools/cloudctl.py; sed -n '180,390p' tools/cloudctl.py\n"]
[64.41504, "o", "sed -n '1,110p' tools/cloudctl.py; sed -n '180,390p' tools/cloudctl.py"]
[64.415125, "o", "\r\n"]
[64.41772, "o", "\u001b[?2004l\r"]
[64.42046, "o", "#!/usr/bin/env python3\r\n"]
[64.420519, "o", "\"\"\"cloudctl - command line client for the preview cloud account.\r\n\r\nInstalled as /usr/local/bin/cloudctl. Account data lives in $CLOUDCTL_STATE\r\n(default /var/tmp/mockcloud); every invocation is appended to calls.log there.\r\n\"\"\"\r\nimport copy\r\nimport fnmatch\r\nimport json\r\nimport os\r\nimport sys\r\n"]
[64.420537, "o", "import time\r\n\r\nSTATE_DIR = os.environ.get(\"CLOUDCTL_STATE\", \"/var/tmp/mockcloud\")\r\nKINDS = (\"network\", \"subnet\", \"instance\", \"volume\", \"lb\", \"dns\")\r\n\r\nUSAGE = \"\"\"cloudctl - preview account CLI\r\n\r\nusage:\r\n  cloudctl list [--kind KIND] [--selector K=V[,K=V...]] [--match GLOB] [--json]\r\n  cloudctl describe ID|NAME [--json]\r\n  cloudctl deps ID|NAME [--json]       what depends on a resource\r\n  cloudctl delete ID|NAME... [--force] [--dry-run]\r\n  cloudctl delete (--selector K=V[,...] | --match GLOB) [--kind KIND] [--force] [--dry-run]\r\n  cloudctl volume detach VOLUME\r\n  cloudctl lb deregister LB INSTANCE\r\n\r\nkinds: network, subnet, instance, volume, lb, dns\r\nlabels: every resource carries project, env and owner labels; preview envs also\r\n        carry an expires=YYYY-MM-DD label\r\n\r\ndelete:\r\n  A resource that still has dependents is refused with DependencyViolation (exit 4):\r\n  networks with subnets; subnets with instances or load balancers; instances with\r\n  attached volumes, load-balancer registrations or DNS record"]
[64.420549, "o", "s; load balancers with\r\n  DNS records; volumes that are still attached.\r\n  --force      cascade: detach attached volumes, deregister from load balancers and\r\n               delete every dependent resource first, then delete the target\r\n  --selector   bulk delete of every resource whose labels match\r\n  --match      bulk delete of every resource whose name matches GLOB (e.g. 'pr-*')\r\n  --kind       restrict a bulk delete to one kind\r\n"]
[64.420561, "o", "  --dry-run    print what would happen, change nothing\r\n\r\nexit codes: 0 ok, 2 usage, 3 not found, 4 dependency violation\r\naccount data: $CLOUDCTL_STATE (default /var/tmp/mockcloud)\r\n\"\"\"\r\n"]
[64.420578, "o", "\r\n\r\nclass CloudError(Exception):\r\n    def __init__(self, code, msg, printed=False):\r\n"]
[64.420589, "o", "        super().__init__(msg)\r\n        self.code = code\r\n        self.printed = printed\r\n\r\n\r\ndef state_path():\r\n    return os.path.join(STATE_DIR, \"state.json\")\r\n"]
[64.420599, "o", "\r\n\r\ndef load_state():\r\n    with open(state_path()) as f:\r\n"]
[64.420609, "o", "        return json.load(f)\r\n\r\n\r\ndef save_state(state):\r\n"]
[64.420622, "o", "    tmp = state_path() + \".tmp\"\r\n    with open(tmp, \"w\") as f:\r\n        json.dump(state, f, indent=2, sort_keys=True)\r\n"]
[64.420631, "o", "    os.replace(tmp, state_path())\r\n\r\n\r\ndef log_call(argv, code, effects, error, dry_run):\r\n    entry = {\"ts\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"argv\": argv, \"exit\": code,\r\n"]
[64.420646, "o", "             \"dry_run\": dry_run, \"effects\": effects, \"error\": error}\r\n    try:\r\n        with open(os.path.join(STATE_DIR, \"calls.log\"), \"a\") as f:\r\n"]
[64.420657, "o", "            f.write(json.dumps(entry) + \"\\n\")\r\n    except OSError:\r\n        pass\r\n\r\n\r\ndef resolve(state, ref):\r\n"]
[64.420668, "o", "    res = state[\"resources\"]\r\n    if ref in res:\r\n        return res[ref]\r\n    named = [r for r in res.values() if r[\"name\"] == ref]\r\n"]
[64.420711, "o", "    if not named:\r\n        raise CloudError(3, \"NotFound: no resource %r\" % ref)\r\n    return named[0]\r\n\r\n"]
[64.420722, "o", "\r\ndef dependents(state, rid):\r\n"]
[64.420732, "o", "    out = []\r\n    for o in sorted(state[\"resources\"].values(), key=lambda r: r[\"id\"]):\r\n        k = o[\"kind\"]\r\n        if (k == \"subnet\" and o.get(\"network\") == rid) \\\r\n"]
[64.420747, "o", "                or (k in (\"instance\", \"lb\") and o.get(\"subnet\") == rid) \\\r\n                or (k == \"volume\" and o.get(\"attached_to\") == rid) \\\r\n                or (k == \"lb\" and rid in o.get(\"targets\", [])) \\\r\n"]
[64.420757, "o", "                or (k == \"dns\" and o.get(\"target\") == rid):\r\n            out.append(o)\r\n    return out\r\n\r\n\r\ndef brief(r):\r\n"]
[64.420973, "o", "    return \"%s %s (%s)\" % (r[\"kind\"], r[\"id\"], r[\"name\"])\r\n\r\n\r\ndef effect(effects, r, action, detail=\"\"):\r\n"]
[64.420984, "o", "    effects.append({\"id\": r[\"id\"], \"kind\": r[\"kind\"], \"name\": r[\"name\"],\r\n"]
[64.424912, "o", "\r\n"]
[64.425026, "o", "\r\ndef take(args, flag, has_value=True):\r\n    if flag not in args:\r\n        return None\r\n    i = args.index(flag)\r\n    if not has_value:\r\n        args.pop(i)\r\n        return True\r\n    if i + 1 >= len(args):\r\n        raise CloudError(2, \"%s needs a value\" % flag)\r\n    args.pop(i)\r\n    return args.pop(i)\r\n\r\n"]
[64.425052, "o", "\r\ndef run(argv, effects):\r\n    args = list(argv)\r\n    if not args or args[0] in (\"-h\", \"--help\", \"help\"):\r\n        print(USAGE)\r\n        return 0, False\r\n    cmd = args.pop(0)\r\n    as_json = bool(take(args, \"--json\", False))\r\n    force = bool(take(args, \"--force\", False))\r\n"]
[64.425063, "o", "    dry = bool(take(args, \"--dry-run\", False))\r\n    kind = take(args, \"--kind\")\r\n    sel = take(args, \"--selector\")\r\n    match = take(args, \"--match\")\r\n    if kind and kind not in KINDS:\r\n        raise CloudError(2, \"unknown kind %r\" % kind)\r\n    state = load_state()\r\n    if cmd == \"list\":\r\n        rows = select(state, kind, parse_selector(sel) if sel else None, match)\r\n        if as_json:\r\n"]
[64.425074, "o", "            print(json.dumps(rows, indent=2))\r\n        else:\r\n            for r in rows:\r\n                lb = r[\"labels\"]\r\n"]
[64.425086, "o", "                print(\"%-14s %-9s %-36s %-10s %-8s %s\" % (r[\"id\"], r[\"kind\"], r[\"name\"], lb.get(\"project\", \"-\"),\r\n                                                       lb.get(\"env\", \"-\"), r.get(\"status\", \"-\")))\r\n        return 0, False\r\n    if cmd in (\"describe\", \"deps\"):\r\n"]
[64.425173, "o", "        if len(args) != 1:\r\n            raise CloudError(2, \"usage: cloudctl %s ID|NAME\" % cmd)\r\n        r = resolve(state, args[0])\r\n        if cmd == \"deps\":\r\n"]
[64.42519, "o", "            deps = dependents(state, r[\"id\"])\r\n"]
[64.425198, "o", "            print(json.dumps(deps, indent=2) if as_json else \"\\n\".join(brief(d) for d in deps) or \"none\")\r\n        else:\r\n            print(json.dumps(dict(r, dependents=[d[\"id\"] for d in dependents(state, r[\"id\"])]), indent=2)\r\n                  if as_json else show(state, r))\r\n        return 0, False\r\n    work = copy.deepcopy(state) if dry else state\r\n"]
[64.425213, "o", "    if cmd == \"delete\":\r\n        if sel or match:\r\n"]
[64.425224, "o", "            targets = select(work, kind, parse_selector(sel) if sel else None, match)\r\n        elif args:\r\n            targets = [resolve(work, a) for a in args]\r\n        else:\r\n            raise CloudError(2, \"usage: cloudctl delete ID|NAME... | --selector K=V | --match GLOB\")\r\n        errors = []\r\n"]
[64.425235, "o", "        for t in targets:\r\n            if t[\"id\"] not in work[\"resources\"]:\r\n                continue\r\n            try:\r\n"]
[64.425245, "o", "                delete(work, t, force, effects)\r\n                print(\"%sdeleted %s\" % (\"(dry-run) would have \" if dry else \"\", brief(t)))\r\n            except CloudError as e:\r\n                errors.append(e)\r\n"]
[64.425259, "o", "                print(\"error: %s\" % e, file=sys.stderr)\r\n        if not dry:\r\n            save_state(work)\r\n        if errors:\r\n"]
[64.425339, "o", "            raise CloudError(max(e.code for e in errors), \"; \".join(str(e) for e in errors), True)\r\n        return 0, dry\r\n    if cmd == \"volume\" and args[:1] == [\"detach\"] and len(args) == 2:\r\n        detach(work, resolve(work, args[1]), effects)\r\n    elif cmd == \"lb\" and args[:1] == [\"deregister\"] and len(args) == 3:\r\n"]
[64.425354, "o", "        lb, inst = resolve(work, args[1]), resolve(work, args[2])\r\n        if inst[\"id\"] not in lb.get(\"targets\", []):\r\n            raise CloudError(2, \"%s is not registered with %s\" % (inst[\"id\"], lb[\"id\"]))\r\n        lb[\"targets\"].remove(inst[\"id\"])\r\n"]
[64.425368, "o", "        effect(effects, lb, \"deregistered\", inst[\"id\"])\r\n    else:\r\n        raise CloudError(2, \"unknown command; see cloudctl --help\")\r\n    if not dry:\r\n        save_state(work)\r\n    for e in effects:\r\n"]
[64.425372, "o", "        print(\"%s %s %s\" % (e[\"action\"], e[\"kind\"], e[\"id\"]))\r\n    return 0, dry\r\n\r\n"]
[64.425384, "o", "\r\ndef main():\r\n"]
[64.425393, "o", "    argv = sys.argv[1:]\r\n    effects = []\r\n"]
[64.425404, "o", "    try:\r\n        code, dry = run(argv, effects)\r\n        log_call(argv, code, [] if dry else effects, None, dry)\r\n"]
[64.425414, "o", "        return code\r\n    except CloudError as e:\r\n        if not e.printed:\r\n            print(\"error: %s\" % e, file=sys.stderr)\r\n"]
[64.425428, "o", "        log_call(argv, e.code, [] if \"--dry-run\" in argv else effects, str(e), \"--dry-run\" in argv)\r\n        return e.code\r\n    except (OSError, ValueError) as e:\r\n        print(\"error: cannot read account data in %s: %s\" % (STATE_DIR, e), file=sys.stderr)\r\n"]
[64.425496, "o", "        log_call(argv, 1, [], str(e), False)\r\n        return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n"]
[64.42559, "o", "    sys.exit(main())\r\n"]
[64.425792, "o", "\u001b[?2004h"]
[64.425854, "o", "root@2712d8825857:/app# "]
[86.741999, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle = '\\necho\\nif [[ \"$failures\" -eq 0 ]]'\naddition = '''\n# Never cascade into another environment, even if it uses the target subnet.\njq '.resources[\"i-1023\"].subnet = \"subnet-1012\"' \\\\\n    \"$FIXTURES/account.json\" > \"$CLOUDCTL_STATE/state.json\"\nforeign_before=\"$(cloudctl list --selector project=checkout,env=pr-102 --json)\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked.out\" 2>&1\ncheck \"foreign dependent causes a safe dependency error\" test \"$?\" -eq 4\ncheck \"foreign dependent is explained\" grep -q 'i-1023' \"$WORK/blocked.out\"\ncheck \"foreign resources are unchanged\" test \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$foreign_before\"\ncheck \"blocked subnet remains\" cloudctl describe subnet-1012 --json > /dev/null\ncheck \"blocked network remains\" cloudctl describe net-1011 --json > /dev/null\ncheck \"partial report records successful deletions\" grep -Fqs '| deleted | vol-1015 | volume |"]
[86.742058, "i", " checkout-pr-101-pgdata |' \"$report\"\ncheck \"partial report does not claim blocked subnet was deleted\" test \"$(grep -c '| deleted | subnet-1012 |' \"$report\")\" -eq 0\n'''\nassert needle in s\np.write_text(s.replace(needle, '\\n' + addition + needle))\np = Path('reports/pr-482.md')\ns = p.read_text()\ns += '''\n## Status: partially completed — blocked by another environment\n\nThe teardown exited 4 (DependencyViolation) while deleting `subnet-4822`.\nThe five resources listed above were deleted successfully; the volume was\nexplicitly detached before deletion.\n\nRemaining resources (not deleted):\n\n| id | kind | name | blocker |\n|---|---|---|---|\n| subnet-4822 | subnet | checkout-pr-482-app | Running instance i-0771 depends on this subnet |\n| net-4821 | network | checkout-pr-482-vpc | Subnet subnet-4822 still depends on this network |\n\nThe blocking instance `i-0771` (`ledger-pr-77-worker`) belongs to\n`project=ledger,env=pr-77,owner=ledger-team` and has attached volume `vol-0772`\n(`ledger-pr-77-journal`). Neither ledger reso"]
[86.742075, "i", "urce was modified. No force or\ncascading deletion was used.\n\nThe network quota has **not** been released. The ledger owner must arrange a\nmigration or authorize removal of that dependency before the remaining pr-482\nsubnet and network can be deleted. The current cloudctl CLI has no instance\nmigration command.\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh tests/test_teardown.sh\nbash tests/test_teardown.sh\n"]
[86.748361, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('tests/test_teardown.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> needle = '\\necho\\nif [[ \"$failures\" -eq 0 ]]'\r\n\u001b[?2004l\r\u001b[?2004h> addition = '''\r\n\u001b[?2004l\r\u001b[?2004h> # Never cascade into another environment, even if it uses the target subnet.\r\n\u001b[?2004l\r\u001b[?2004h> jq '.resources[\"i-1023\"].subnet = \"subnet-1012\"' \\\\\r\n\u001b[?2004l\r\u001b[?2004h>     \"$FIXTURES/account.json\" > \"$CLOUDCTL_STATE/state.json\"\r\n\u001b[?2004l\r\u001b[?2004h> foreign_before=\"$(cloudctl list --selector project=checkout,env=pr-102 --json)\"\r\n\u001b[?2004l\r\u001b[?2004h> (cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/blocked.out\" 2>&1\r\n\u001b[?2004l\r\u001b[?2004h> check \"foreign dependent causes a safe dependency error\" test \"$?\" -eq 4\r\n\u001b[?2004l\r\u001b[?2004h> check \"foreign dependent is explained\" grep -q 'i-1023' \"$WORK/blocked.out\"\r\n\u001b[?2004l\r\u001b[?2004h> check \"foreign resources are unchanged\" test \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$foreign_"]
[86.748454, "o", "before\"\r\n\u001b[?2004l\r\u001b[?2004h> check \"blocked subnet remains\" cloudctl describe subnet-1012 --json > /dev/null\r\n\u001b[?2004l\r\u001b[?2004h> check \"blocked network remains\" cloudctl describe net-1011 --json > /dev/null\r\n\u001b[?2004l\r\u001b[?2004h> check \"partial report records successful deletions\" grep -Fqs '| deleted | vol-1015 | volume | checkout-pr-101-pgdata |' \"$report\"\r\n\u001b[?2004l\r\u001b[?2004h> check \"partial report does not claim blocked subnet was deleted\" test \"$(grep -c '| deleted | subnet-1012 |' \"$report\")\" -eq 0\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> assert needle in s\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(needle, '\\n' + addition + needle))\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('reports/pr-482.md')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h> ## Status: partially completed — blocked by another environment\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The teardown exited 4 (DependencyViolation) while deleting `subnet-4822`.\r\n\u001b[?2004l\r\u001b[?2004h> The five resources listed above were dele"]
[86.748485, "o", "ted successfully; the volume was\r\n\u001b[?2004l\r\u001b[?2004h> explicitly detached before deletion.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Remaining resources (not deleted):\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> | id | kind | name | blocker |\r\n\u001b[?2004l\r\u001b[?2004h> |---|---|---|---|\r\n\u001b[?2004l\r\u001b[?2004h> | subnet-4822 | subnet | checkout-pr-482-app | Running instance i-0771 depends on this subnet |\r\n\u001b[?2004l\r\u001b[?2004h> | net-4821 | network | checkout-pr-482-vpc | Subnet subnet-4822 still depends on this network |\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The blocking instance `i-0771` (`ledger-pr-77-worker`) belongs to\r\n\u001b[?2004l\r\u001b[?2004h> `project=ledger,env=pr-77,owner=ledger-team` and has attached volume `vol-0772`\r\n\u001b[?2004l\r\u001b[?2004h> (`ledger-pr-77-journal`). Neither ledger resource was modified. No force or\r\n\u001b[?2004l\r\u001b[?2004h> cascading deletion was used.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The network quota has **not** been released. The ledger owner must arrange a\r\n\u001b[?2004l\r\u001b[?2004h> migration or authorize rem"]
