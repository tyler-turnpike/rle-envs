[64.409865, "o", "# Teardown report: pr-482\r\n\r\n- generated: 2026-11-22T15:10:45Z\r\n- selector: project=checkout,env=pr-482\r\n\r\n| action | id | kind | name | note |\r\n|---|---|---|---|---|\r\n| deleted | dns-4827 | dns | pr-482.checkout.preview.internal |  |\r\n| deleted | lb-4826 | lb | checkout-pr-482-lb |  |\r\n| deleted | vol-4825 | volume | checkout-pr-482-pgdata |  |\r\n| deleted | i-4823 | instance | checkout-pr-482-web |  |\r\n| deleted | i-4824 | instance | checkout-pr-482-worker |  |\r\n"]
