[39.534485, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_teardown.sh')\ns = p.read_text()\nneedle = '(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.out\" 2>&1'\ns = s.replace(needle, '''cp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before-dry-run.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101 --dry-run) > \"$WORK/dry-run.out\" 2>&1\ncheck \"dry run exits 0\" test \"$?\" -eq 0\ncheck \"dry run changes no resources\" cmp -s \"$WORK/before-dry-run.json\" \"$CLOUDCTL_STATE/state.json\"\ncheck \"dry run writes no deletion report\" test ! -e \"$REPORT_DIR/pr-101.md\"\n\n''' + needle)\ns = s.replace('log_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"', '''while IFS=$'\\\\t' read -r id kind name; do\n    check \"report lists id, kind and name for $id\" grep -Fqs -- \"| deleted | $id | $kind | $name |\" \"$report\"\ndone < <(jq -r '.resources[] | select(.labels.env == \"pr-101\") | [.id, .kind, .name] | @tsv' \"$FIXTURES/account.json\")\ncp \"$report\" \"$WORK/first-report.md\"\n\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"''')\ns = s.replace('check \"s"]
[39.534539, "i", "econd run changed nothing\" test -z \"$changes\"', '''check \"second run changed nothing\" test -z \"$changes\"\ncheck \"second run preserves deletion report\" cmp -s \"$WORK/first-report.md\" \"$report\"\n\n# A previous attempt may have detached a volume but not yet deleted it.\njq '.resources[\"vol-1015\"].attached_to = null | .resources[\"vol-1015\"].status = \"available\"' \\\\\n    \"$FIXTURES/account.json\" > \"$CLOUDCTL_STATE/state.json\"\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/detached.out\" 2>&1\ncheck \"teardown handles an already-detached volume\" test \"$?\" -eq 0\ncheck \"already-detached volume and its environment are gone\" test -z \"$(ids_for project=checkout,env=pr-101)\"\ncheck \"other environment is still untouched\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\n\n# pr-102 has DNS pointing directly at its instance rather than a load balancer.\n(cd \"$APP_ROOT\" && ./teardown.sh pr-102) > \"$WORK/direct-dns.out\" 2>&1\ncheck \"teardown handles DNS pointing directly at an instance\" test \"$?\" -eq 0\ncheck \"every pr-102 "]
