[6.416877, "o", "#!/usr/bin/env bash\r\n# End-to-end test of teardown.sh against a throwaway copy of the fixture account.\r\n#   bash tests/test_teardown.sh\r\nset -uo pipefail\r\n\r\nAPP_ROOT=\"${APP_ROOT:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)}\"\r\nFIXTURES=\"${FIXTURES:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)/fixtures}\"\r\nWORK=\"$(mktemp -d)\"\r\ntrap 'rm -rf \"$WORK\"' EXIT\r\n\r\nexport CLOUDCTL_STATE=\"$WORK/account\"\r\nexport REPORT_DIR=\"$WORK/reports\"\r\nexport PREVIEWS_CONF=\"$FIXTURES/previews.conf\"\r\nmkdir -p \"$CLOUDCTL_STATE\"\r\ncp \"$FIXTURES/account.json\" \"$CLOUDCTL_STATE/state.json\"\r\n\r\nfailures=0\r\ncheck() {  # check DESCRIPTION COMMAND...\r\n    local desc=\"$1\"; shift\r\n    if \"$@\"; then echo \"ok   - $desc\"; else echo \"FAIL - $desc\"; failures=$((failures + 1)); fi\r\n}\r\nids_for() {  # ids_for SELECTOR\r\n    cloudctl list --selector \"$1\" --json | jq -r '.[].id' | sort\r\n}\r\n\r\nbefore_101=\"$(ids_for project=checkout,env=pr-101)\"\r\nbefore_102=\"$(ids_for project=checkout,env=pr-102)\"\r\n\r\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run1.ou"]
[6.416981, "o", "t\" 2>&1\r\nrc1=$?\r\nsed 's/^/    run1| /' \"$WORK/run1.out\"\r\ncheck \"first run exits 0\" test \"$rc1\" -eq 0\r\ncheck \"every pr-101 resource is gone\" test -z \"$(ids_for project=checkout,env=pr-101)\"\r\ncheck \"pr-102 is untouched\" test \"$(ids_for project=checkout,env=pr-102)\" = \"$before_102\"\r\n\r\nreport=\"$REPORT_DIR/pr-101.md\"\r\ncheck \"report written to reports/pr-101.md\" test -s \"$report\"\r\nfor id in $before_101; do\r\n    check \"report lists $id\" grep -qs -- \"$id\" \"$report\"\r\ndone\r\n\r\nlog_lines=\"$(wc -l < \"$CLOUDCTL_STATE/calls.log\")\"\r\n(cd \"$APP_ROOT\" && ./teardown.sh pr-101) > \"$WORK/run2.out\" 2>&1\r\nrc2=$?\r\nsed 's/^/    run2| /' \"$WORK/run2.out\"\r\ncheck \"second run exits 0\" test \"$rc2\" -eq 0\r\ncheck \"second run says there is nothing to do\" grep -qi \"nothing to do\" \"$WORK/run2.out\"\r\nchanges=\"$(tail -n +\"$((log_lines + 1))\" \"$CLOUDCTL_STATE/calls.log\" | jq -c 'select(.effects | length > 0)')\"\r\ncheck \"second run changed nothing\" test -z \"$changes\"\r\n\r\necho\r\nif [[ \"$failures\" -eq 0 ]]; then echo \"all checks passed\"; else echo \"$failu"]
[6.417054, "o", "res check(s) failed\"; exit 1; fi\r\n"]
[6.417508, "o", "\r\n--- cloudctl help ---\r\n"]
[6.512706, "o", "cloudctl - preview account CLI\r\n\r\nusage:\r\n  cloudctl list [--kind KIND] [--selector K=V[,K=V...]] [--match GLOB] [--json]\r\n  cloudctl describe ID|NAME [--json]\r\n  cloudctl deps ID|NAME [--json]       what depends on a resource\r\n  cloudctl delete ID|NAME... [--force] [--dry-run]\r\n  cloudctl delete (--selector K=V[,...] | --match GLOB) [--kind KIND] [--force] [--dry-run]\r\n  cloudctl volume detach VOLUME\r\n  cloudctl lb deregister LB INSTANCE\r\n\r\nkinds: network, subnet, instance, volume, lb, dns\r\nlabels: every resource carries project, env and owner labels; preview envs also\r\n        carry an expires=YYYY-MM-DD label\r\n\r\ndelete:\r\n  A resource that still has dependents is refused with DependencyViolation (exit 4):\r\n  networks with subnets; subnets with instances or load balancers; instances with\r\n  attached volumes, load-balancer registrations or DNS records; load balancers with\r\n  DNS records; volumes that are still attached.\r\n  --force      cascade: detach attached volumes, deregister from load balancers and\r\n    "]
[6.512969, "o", "           delete every dependent resource first, then delete the target\r\n  --selector   bulk delete of every resource whose labels match\r\n  --match      bulk delete of every resource whose name matches GLOB (e.g. 'pr-*')\r\n  --kind       restrict a bulk delete to one kind\r\n  --dry-run    print what would happen, change nothing\r\n\r\nexit codes: 0 ok, 2 usage, 3 not found, 4 dependency violation\r\naccount data: $CLOUDCTL_STATE (default /var/tmp/mockcloud)\r\n\r\n"]
