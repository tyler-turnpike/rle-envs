[54.431978, "o", "#!/usr/bin/env bash\r\n# teardown.sh - remove a preview environment's cloud resources.\r\n#\r\n#   ./teardown.sh <env> [--dry-run]\r\n#\r\n# <env> is a preview env from conf/previews.conf (e.g. pr-482). Resources are\r\n# found with the env's label selector and deleted through cloudctl.\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n# shellcheck source=lib/inventory.sh\r\nsource \"$ROOT/lib/inventory.sh\"\r\n# shellcheck source=lib/order.sh\r\nsource \"$ROOT/lib/order.sh\"\r\n# shellcheck source=lib/report.sh\r\nsource \"$ROOT/lib/report.sh\"\r\n\r\nusage() {\r\n    echo \"usage: $0 <env> [--dry-run]\" >&2\r\n    exit 2\r\n}\r\n\r\n[[ $# -ge 1 ]] || usage\r\nENV_ARG=\"$1\"; shift\r\nDRY_RUN=0\r\nfor arg in \"$@\"; do\r\n    case \"$arg\" in\r\n        --dry-run) DRY_RUN=1 ;;\r\n        *) usage ;;\r\n    esac\r\ndone\r\n\r\nload_env_config \"$ENV_ARG\"\r\necho \"teardown: env=$ENV_NAME project=$ENV_PROJECT selector=$ENV_SELECTOR\"\r\n\r\ninventory=\"$(inventory_collect \"$ENV_SELECTOR\")\"\r\necho \"teardown: $(printf '%s\\n' \"$inventory\" | grep -c . || true) resourc"]
[54.432244, "o", "e(s) found\"\r\n\r\n# An empty inventory is a successful no-op. Keep any existing deletion report\r\n# so that rerunning the teardown does not erase its audit trail.\r\nif [[ -z \"$inventory\" ]]; then\r\n    echo \"teardown: nothing to do\"\r\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\r\n        report_init \"$ENV_NAME\"\r\n        report_write\r\n    fi\r\n    exit 0\r\nfi\r\n\r\n# Sort before mutating anything, and keep the loop in this shell so errors and\r\n# report handling are not hidden in a pipeline's subshell.\r\nordered=\"$(printf '%s\\n' \"$inventory\" | order_resources)\"\r\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\r\n    report_init \"$ENV_NAME\"\r\n    # Record successful deletions even if a later operation is refused. Never\r\n    # force-delete dependents: they may belong to a different environment.\r\n    finish_report() {\r\n        local status=$?\r\n        trap - EXIT\r\n        if [[ \"$status\" -ne 0 ]]; then\r\n            echo \"teardown: incomplete (exit $status); see report\" >&2\r\n        fi\r\n        report_write || { [[ \"$sta"]
[54.432251, "o", "tus\" -ne 0 ]] || status=1; }\r\n        exit \"$status\"\r\n    }\r\n    trap finish_report EXIT\r\nfi\r\n\r\nwhile IFS=$'\\t' read -r id kind name; do\r\n    [[ -n \"$id\" ]] || continue\r\n    if [[ \"$kind\" == volume ]]; then\r\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\r\n        if [[ -n \"$attached_to\" ]]; then\r\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n                echo \"would detach volume $id from $attached_to\"\r\n            else\r\n                echo \"detaching volume $id from $attached_to\"\r\n                \"$CLOUDCTL\" volume detach \"$id\"\r\n            fi\r\n        fi\r\n    fi\r\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\r\n        echo \"would delete $kind $id ($name)\"\r\n        continue\r\n    fi\r\n    echo \"deleting $kind $id ($name)\"\r\n    if \"$CLOUDCTL\" delete \"$id\"; then\r\n        report_add deleted \"$id\" \"$kind\" \"$name\"\r\n    else\r\n        status=$?\r\n        report_add failed \"$id\" \"$kind\" \"$name\" \"delete exited $status; check resource dependencies\"\r\n        exit \"$status\"\r\n    fi\r\ndone <<< \"$ordered\"\r\n\r\necho \"teardow"]
[54.432259, "o", "n: done\"\r\n# shellcheck shell=bash\r\n# Ordering of resources for teardown.\r\n#\r\n# Resources have to go in reverse dependency order: cloudctl refuses to delete\r\n# anything that still has dependents (see `cloudctl --help`).\r\n\r\n# order_rank KIND -> numeric rank; lower ranks are processed first.\r\norder_rank() {\r\n    case \"$1\" in\r\n        dns)      echo 10 ;;\r\n        lb)       echo 20 ;;\r\n        volume)   echo 30 ;;\r\n        instance) echo 40 ;;\r\n        subnet)   echo 50 ;;\r\n        network)  echo 60 ;;\r\n        *)        echo 99 ;;\r\n    esac\r\n}\r\n\r\n# order_resources < \"<id>\\t<kind>\\t<name>\" lines\r\n# Prints the same lines sorted by rank (stable within a rank).\r\norder_resources() {\r\n    local id kind name\r\n    while IFS=$'\\t' read -r id kind name; do\r\n        [[ -z \"$id\" ]] && continue\r\n        printf '%s\\t%s\\t%s\\t%s\\n' \"$(order_rank \"$kind\")\" \"$id\" \"$kind\" \"$name\"\r\n    done | sort -s -n -k1,1 | cut -f2-\r\n}\r\n# shellcheck shell=bash\r\n# Teardown report: one markdown file per env under $REPORT_DIR.\r\n#\r\n#   report_init "]
[54.432263, "o", "ENV           start a new report (truncates the scratch rows)\r\n#   report_add ACTION ID KIND NAME [NOTE]\r\n#   report_write              render reports/<env>.md, prints its path\r\n\r\nREPORT_DIR=\"${REPORT_DIR:-$ROOT/reports}\"\r\n_REPORT_ENV=\"\"\r\n_REPORT_ROWS=\"\"\r\n\r\nreport_init() {\r\n    _REPORT_ENV=\"$1\"\r\n    mkdir -p \"$REPORT_DIR\"\r\n    _REPORT_ROWS=\"$(mktemp)\"\r\n}\r\n\r\nreport_add() {\r\n    [[ -n \"$_REPORT_ROWS\" ]] || { echo \"report: report_init not called\" >&2; return 1; }\r\n    local action=\"$1\" id=\"$2\" kind=\"$3\" name=\"$4\" note=\"${5:-}\"\r\n    printf '%s\\t%s\\t%s\\t%s\\t%s\\n' \"$action\" \"$id\" \"$kind\" \"$name\" \"$note\" >> \"$_REPORT_ROWS\"\r\n}\r\n\r\nreport_path() {\r\n    echo \"$REPORT_DIR/${_REPORT_ENV}.md\"\r\n}\r\n\r\nreport_write() {\r\n    local out action id kind name note\r\n    out=\"$(report_path)\"\r\n    {\r\n        echo \"# Teardown report: ${_REPORT_ENV}\"\r\n        echo\r\n        echo \"- generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"\r\n        echo \"- selector: ${ENV_SELECTOR:-?}\"\r\n        echo\r\n        if [[ ! -s \"$_REPORT_ROWS\" ]]; then\r\n        "]
[54.433877, "o", "    echo \"Nothing to do: no resources matched.\"\r\n        else\r\n            echo \"| action | id | kind | name | note |\"\r\n            echo \"|---|---|---|---|---|\"\r\n            while IFS=$'\\t' read -r action id kind name note; do\r\n                echo \"| $action | $id | $kind | $name | $note |\"\r\n            done < \"$_REPORT_ROWS\"\r\n        fi\r\n    } > \"$out\"\r\n    rm -f \"$_REPORT_ROWS\"\r\n    echo \"$out\"\r\n}\r\n\r\n--- environment overrides ---\r\n"]
[54.433993, "o", "\u001b[?2004hroot@71645e816463:/app# "]
[78.647348, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/report.sh')\ns = p.read_text().replace('    local out action id kind name note\\n    out=\"$(report_path)\"\\n    {', '''    local out tmp action id kind name note\n    out=\"$(report_path)\"\n    tmp=\"$(mktemp \"$REPORT_DIR/.teardown.XXXXXX\")\" || return\n    # Preserve successful deletions from earlier, partially completed attempts.\n    if [[ -s \"$out\" ]]; then\n        cat \"$out\" > \"$tmp\" || { rm -f \"$tmp\"; return 1; }\n        printf '\\\\n---\\\\n\\\\n' >> \"$tmp\"\n    fi\n    {''').replace('    } > \"$out\"\\n    rm -f \"$_REPORT_ROWS\"', '''    } >> \"$tmp\" || { rm -f \"$tmp\"; return 1; }\n    mv -f \"$tmp\" \"$out\" || { rm -f \"$tmp\"; return 1; }\n    rm -f \"$_REPORT_ROWS\"''')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text().replace('                \"$CLOUDCTL\" volume detach \"$id\"\\n', '                \"$CLOUDCTL\" volume detach \"$id\"\\n                report_add detached \"$id\" \"$kind\" \"$name\" \"from $attached_to\"\\n')\np.write_text(s)\nPY\ncat > tests/test_teardown_edge_cases.sh "]
[78.647551, "i", "<<'EOF'\n#!/usr/bin/env bash\n# Additional checks; all mutations are confined to a temporary fixture account.\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\nWORK=\"$(mktemp -d)\"\ntrap 'rm -rf \"$WORK\"' EXIT\nexport CLOUDCTL_STATE=\"$WORK/account\" REPORT_DIR=\"$WORK/reports\"\nexport PREVIEWS_CONF=\"$ROOT/tests/fixtures/previews.conf\"\nmkdir -p \"$CLOUDCTL_STATE\"\ncp \"$ROOT/tests/fixtures/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncp \"$CLOUDCTL_STATE/state.json\" \"$WORK/before.json\"\n\"$ROOT/teardown.sh\" pr-101 --dry-run > \"$WORK/dry.out\"\ncmp \"$WORK/before.json\" \"$CLOUDCTL_STATE/state.json\"\ntest ! -e \"$REPORT_DIR/pr-101.md\"\ngrep -q 'would detach volume vol-1015' \"$WORK/dry.out\"\necho 'ok   - dry run leaves state and reports untouched'\n\n# Already detached volumes must not trigger a second detach (which the CLI rejects).\ncloudctl volume detach vol-1015 > /dev/null\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/detached.out\"\n! grep -q 'detaching volume' \"$WORK/detached.out\"\ncp \"$REPORT_DIR/pr-101.md\" \"$WORK/report."]
[78.647578, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path"]
[78.647594, "i", "md\"\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/empty.out\"\ngrep -qi 'nothing to do' \"$WORK/empty.out\"\ncmp \"$REPORT_DIR/pr-101.md\" \"$WORK/report.md\"\necho 'ok   - detached volume and no-op report retention'\n\n# pr-102 has DNS pointing straight at an instance, rather than at a load balancer.\n\"$ROOT/teardown.sh\" pr-102 > \"$WORK/direct-dns.out\"\ntest \"$(cloudctl list --json | jq length)\" -eq 0\necho 'ok   - direct-instance DNS is deleted before the instance'\n\n# A foreign instance blocks the subnet. Never cascade-delete or move it.\ncp \"$ROOT/tests/fixtures/account.json\" \"$CLOUDCTL_STATE/state.json\"\ncloudctl instance move i-1023 --subnet subnet-1012 > /dev/null\nforeign_before=\"$(cloudctl list --selector project=checkout,env=pr-102 --json)\"\nif \"$ROOT/teardown.sh\" pr-101 > \"$WORK/blocked.out\" 2>&1; then\n    echo 'FAIL - foreign dependency should block teardown' >&2\n    exit 1\nelse\n    test \"$?\" -eq 4\nfi\ntest \"$(cloudctl list --selector project=checkout,env=pr-102 --json)\" = \"$foreign_before\"\ngrep -q '| deleted | dns-1017 | dns |"]
[78.64761, "i", "' \"$REPORT_DIR/pr-101.md\"\ngrep -q '| failed | subnet-1012 | subnet |' \"$REPORT_DIR/pr-101.md\"\ncloudctl instance move i-1023 --subnet subnet-1022 > /dev/null\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/retry.out\"\nfor id in dns-1017 lb-1016 vol-1015 i-1013 i-1014 subnet-1012 net-1011; do\n    grep -q \"| deleted | $id |\" \"$REPORT_DIR/pr-101.md\"\ndone\necho 'ok   - foreign resources preserved and partial retry report retained'\necho 'all edge-case checks passed'\nEOF\nbash -n teardown.sh lib/*.sh tests/test_teardown_edge_cases.sh\nbash tests/test_teardown.sh && bash tests/test_teardown_edge_cases.sh\n"]
[78.647725, "o", "\r\n\u001b[?2004l\r' \"$REPORT_DIR/pr-101.md\"\r\ngrep -q '| failed | subnet-1012 | subnet |' \"$REPORT_DIR/pr-101.md\"\r\ncloudctl instance move i-1023 --subnet subnet-1022 > /dev/null\r\n\"$ROOT/teardown.sh\" pr-101 > \"$WORK/retry.out\"\r\nfor id in dns-1017 lb-1016 vol-1015 i-1013 i-1014 subnet-1012 net-1011; do\r\n    grep -q \"| deleted | $id |\" \"$REPORT_DIR/pr-101.md\"\r\ndone\r\necho 'ok   - foreign resources preserved and partial retry report retained'\r\necho 'all edge-case checks passed'\r\nEOF\r\nbash -n teardown.sh lib/*.sh tests/test_teardown_edge_cases.sh\r\nbash tests/test_teardown.sh && bash tests/test_teardown_edge_cases.sh\r\n"]
