[11.452039, "o", "# shellcheck shell=bash\r\n# Inventory helpers: map a preview env to its label selector and list what it owns.\r\n#\r\n# Environment overrides:\r\n#   CLOUDCTL        cloudctl binary to call (default: cloudctl on PATH)\r\n#   PREVIEWS_CONF   env -> selector mapping (default: conf/previews.conf)\r\n\r\nCLOUDCTL=\"${CLOUDCTL:-cloudctl}\"\r\nPREVIEWS_CONF=\"${PREVIEWS_CONF:-$ROOT/conf/previews.conf}\"\r\n\r\n# load_env_config ENV\r\n# Sets ENV_NAME, ENV_PROJECT and ENV_SELECTOR from the config file.\r\nload_env_config() {\r\n    local want=\"$1\" env project selector\r\n    [[ -r \"$PREVIEWS_CONF\" ]] || { echo \"inventory: cannot read $PREVIEWS_CONF\" >&2; return 1; }\r\n    while read -r env project selector _; do\r\n        [[ -z \"$env\" || \"$env\" == \\#* ]] && continue\r\n        if [[ \"$env\" == \"$want\" ]]; then\r\n            ENV_NAME=\"$env\"\r\n            ENV_PROJECT=\"$project\"\r\n            ENV_SELECTOR=\"$selector\"\r\n            return 0\r\n        fi\r\n    done < \"$PREVIEWS_CONF\"\r\n    echo \"inventory: unknown preview env '$want' (see $PREVIEWS_CONF)\" >&2\r\n  "]
[11.452152, "o", "  return 1\r\n}\r\n\r\n# inventory_collect SELECTOR\r\n# Prints one line per resource: \"<id>\\t<kind>\\t<name>\".\r\ninventory_collect() {\r\n    local selector=\"$1\"\r\n    \"$CLOUDCTL\" list --selector \"$selector\" --json \\\r\n        | jq -r '.[] | [.id, .kind, .name] | @tsv'\r\n}\r\n\r\n# inventory_json ID\r\n# Full JSON description of one resource (includes \"dependents\": [ids]).\r\ninventory_json() {\r\n    \"$CLOUDCTL\" describe \"$1\" --json\r\n}\r\n\r\n# inventory_field ID FIELD\r\n# Prints one top-level field of a resource (\"\" when unset).\r\ninventory_field() {\r\n    inventory_json \"$1\" | jq -r --arg f \"$2\" '.[$f] // empty'\r\n}\r\n\r\n# inventory_exists ID -> 0 if the resource is still there\r\ninventory_exists() {\r\n    \"$CLOUDCTL\" describe \"$1\" >/dev/null 2>&1\r\n}\r\n# shellcheck shell=bash\r\n# Ordering of resources for teardown.\r\n#\r\n# Resources have to go in reverse dependency order: cloudctl refuses to delete\r\n# anything that still has dependents (see `cloudctl --help`).\r\n\r\n# order_rank KIND -> numeric rank; lower ranks are processed first.\r\n# NOTE: copied"]
[11.45217, "o", " from the provisioning side (create order) -- still needs to be\r\n# turned into a teardown order and to cover every kind we provision.\r\norder_rank() {\r\n    case \"$1\" in\r\n        network)  echo 10 ;;\r\n        subnet)   echo 20 ;;\r\n        instance) echo 30 ;;\r\n        *)        echo 99 ;;\r\n    esac\r\n}\r\n\r\n# order_resources < \"<id>\\t<kind>\\t<name>\" lines\r\n# Prints the same lines sorted by rank (stable within a rank).\r\norder_resources() {\r\n    local id kind name\r\n    while IFS=$'\\t' read -r id kind name; do\r\n        [[ -z \"$id\" ]] && continue\r\n        printf '%s\\t%s\\t%s\\t%s\\n' \"$(order_rank \"$kind\")\" \"$id\" \"$kind\" \"$name\"\r\n    done | sort -s -n -k1,1 | cut -f2-\r\n}\r\n"]
[11.454873, "o", "# env       project    selector\r\npr-101      checkout   project=checkout,env=pr-101\r\npr-102      checkout   project=checkout,env=pr-102\r\n{\r\n  \"account\": \"fixture\",\r\n  \"resources\": {\r\n    \"dns-1017\": {\r\n      \"created\": \"2026-10-01T09:03:20\",\r\n      \"id\": \"dns-1017\",\r\n      \"kind\": \"dns\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"pr-101.checkout.preview.internal\",\r\n      \"status\": \"active\",\r\n      \"target\": \"lb-1016\"\r\n    },\r\n    \"dns-1024\": {\r\n      \"created\": \"2026-10-02T09:03:20\",\r\n      \"id\": \"dns-1024\",\r\n      \"kind\": \"dns\",\r\n      \"labels\": {\r\n        \"env\": \"pr-102\",\r\n        \"expires\": \"2026-10-09\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"pr-102.checkout.preview.internal\",\r\n      \"status\": \"active\",\r\n      \"target\": \"i-1023\"\r\n    },\r\n    \"i-1013\": {\r\n      \"created\": \"2026-10-01T09:02:00\",\r\n      \"id\": \"i-1013\",\r\n      \"imag"]
[11.454906, "o", "e\": \"checkout-web:pr-101\",\r\n      \"kind\": \"instance\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-web\",\r\n      \"status\": \"running\",\r\n      \"subnet\": \"subnet-1012\"\r\n    },\r\n    \"i-1014\": {\r\n      \"created\": \"2026-10-01T09:02:05\",\r\n      \"id\": \"i-1014\",\r\n      \"image\": \"checkout-worker:pr-101\",\r\n      \"kind\": \"instance\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-worker\",\r\n      \"status\": \"running\",\r\n      \"subnet\": \"subnet-1012\"\r\n    },\r\n    \"i-1023\": {\r\n      \"created\": \"2026-10-02T09:02:00\",\r\n      \"id\": \"i-1023\",\r\n      \"image\": \"checkout-web:pr-102\",\r\n      \"kind\": \"instance\",\r\n      \"labels\": {\r\n        \"env\": \"pr-102\",\r\n        \"expires\": \"2026-10-09\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n    "]
[11.454921, "o", "  },\r\n      \"name\": \"checkout-pr-102-web\",\r\n      \"status\": \"running\",\r\n      \"subnet\": \"subnet-1022\"\r\n    },\r\n    \"lb-1016\": {\r\n      \"created\": \"2026-10-01T09:03:00\",\r\n      \"id\": \"lb-1016\",\r\n      \"kind\": \"lb\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-lb\",\r\n      \"status\": \"active\",\r\n      \"subnet\": \"subnet-1012\",\r\n      \"targets\": [\r\n        \"i-1013\"\r\n      ]\r\n    },\r\n    \"net-1011\": {\r\n      \"cidr\": \"10.11.0.0/16\",\r\n      \"created\": \"2026-10-01T09:00:00\",\r\n      \"id\": \"net-1011\",\r\n      \"kind\": \"network\",\r\n      \"labels\": {\r\n        \"env\": \"pr-101\",\r\n        \"expires\": \"2026-10-08\",\r\n        \"owner\": \"checkout-team\",\r\n        \"project\": \"checkout\"\r\n      },\r\n      \"name\": \"checkout-pr-101-vpc\",\r\n      \"status\": \"available\"\r\n    },\r\n    \"net-1021\": {\r\n      \"cidr\": \"10.12.0.0/16\",\r\n      \"created\": \"2026-10-02T09:00:00\",\r\n      \"id\": \"net-1021\",\r\n      \"kind\": \""]
