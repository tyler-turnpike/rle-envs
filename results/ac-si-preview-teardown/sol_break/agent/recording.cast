[117.661837, "o", "> cloudctl list --json > \"$LIVE_CHECK/after.json\"\r\n\u001b[?2004l\r\u001b[?2004h> python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json, os\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path(os.environ['LIVE_CHECK'])\r\n\u001b[?2004l\r\u001b[?2004h> before = {r['id']:r for r in json.loads((p/'before.json').read_text())}\r\n\u001b[?2004l\r\u001b[?2004h> after = {r['id']:r for r in json.loads((p/'after.json').read_text())}\r\n\u001b[?2004l\r\u001b[?2004h> target = {rid for rid,r in before.items() if r['labels'].get('project') == 'checkout' and r['labels'].get('env') == 'pr-482'}\r\n\u001b[?2004l\r\u001b[?2004h> assert len(target) == 7\r\n\u001b[?2004l\r\u001b[?2004h> assert set(before) - set(after) == target\r\n\u001b[?2004l\r\u001b[?2004h> assert not set(after) - set(before)\r\n\u001b[?2004l\r\u001b[?2004h> report = Path('/app/reports/pr-482.md').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> for rid in target:\r\n\u001b[?2004l\r\u001b[?2004h>     r = before[rid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.661906, "o", "    assert f\"| deleted | {rid} | {r['kind']} | {r['name']} |\" in report\r\n\u001b[?2004l\r\u001b[?2004h> "]
