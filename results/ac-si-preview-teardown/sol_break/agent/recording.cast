[117.660711, "i", "(set -euo pipefail\ncloudctl list --json > \"$LIVE_CHECK/after.json\"\npython3 - <<'PY'\nimport json, os\nfrom pathlib import Path\np = Path(os.environ['LIVE_CHECK'])\nbefore = {r['id']:r for r in json.loads((p/'before.json').read_text())}\nafter = {r['id']:r for r in json.loads((p/'after.json').read_text())}\ntarget = {rid for rid,r in before.items() if r['labels'].get('project') == 'checkout' and r['labels'].get('env') == 'pr-482'}\nassert len(target) == 7\nassert set(before) - set(after) == target\nassert not set(after) - set(before)\nreport = Path('/app/reports/pr-482.md').read_text()\nfor rid in target:\n    r = before[rid]\n    assert f\"| deleted | {rid} | {r['kind']} | {r['name']} |\" in report\nfor rid,r in after.items():\n    expected = dict(before[rid])\n    if rid == 'i-0771':\n        expected['subnet'] = 'subnet-0a12'\n        expected['restarted'] = r['restarted']\n        assert r['status'] == 'running'\n    assert r == expected, rid\nassert after['vol-0772']['attached_to'] == 'i-0771'\nassert 'net-4821' not in after\npri"]
[117.661114, "i", "nt('Verified: all seven pr-482 resources deleted and reported; one network released.')\nprint('Verified: all unrelated resources preserved; ledger worker running in shared subnet with journal attached.')\nPY\ncp reports/pr-482.md \"$LIVE_CHECK/final-report.md\"\n./teardown.sh pr-482\ncmp reports/pr-482.md \"$LIVE_CHECK/final-report.md\"\ncloudctl list --json > \"$LIVE_CHECK/after-rerun.json\"\ncmp \"$LIVE_CHECK/after.json\" \"$LIVE_CHECK/after-rerun.json\"\nprintf '\\n--- final report ---\\n'\ncat reports/pr-482.md\n)\n"]
