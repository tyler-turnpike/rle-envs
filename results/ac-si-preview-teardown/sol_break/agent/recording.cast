[38.484488, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/order.sh')\ns = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\ns = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\np.write_text(s)\np = Path('teardown.sh')\ns = p.read_text()\ns = s[:s.index('# TODO(PLAT-311)')] + '''# An empty inventory is a successful no-op. Keep any existing deletion report\n# so that rerunning the teardown does not erase its audit trail.\nif [[ -z \"$inventory\" ]]; then\n    echo \"teardown: nothing to do\"\n    if [[ \"$DRY_RUN\" -eq 0 && ! -f \"$REPORT_DIR/$ENV_NAME.md\" ]]; then\n        report_init \"$ENV_NAME\"\n        report_write\n    fi\n    exit 0\nfi\n\n# Sort before mutating anything,"]
[38.485044, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('lib/order.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('# NOTE: copied from the provisioning side (create order) -- still needs to be\\n# turned into a teardown order and to cover every kind we provision.\\n', '')\r\n\u001b[?2004l\r"]
[38.485162, "i", " and keep the loop in this shell so errors and\n# report handling are not hidden in a pipeline's subshell.\nordered=\"$(printf '%s\\\\n' \"$inventory\" | order_resources)\"\nif [[ \"$DRY_RUN\" -eq 0 ]]; then\n    report_init \"$ENV_NAME\"\n    # Record successful deletions even if a later operation is refused. Never\n    # force-delete dependents: they may belong to a different environment.\n    finish_report() {\n        local status=$?\n        trap - EXIT\n        if [[ \"$status\" -ne 0 ]]; then\n            echo \"teardown: incomplete (exit $status); see report\" >&2\n        fi\n        report_write || { [[ \"$status\" -ne 0 ]] || status=1; }\n        exit \"$status\"\n    }\n    trap finish_report EXIT\nfi\n\nwhile IFS=$'\\\\t' read -r id kind name; do\n    [[ -n \"$id\" ]] || continue\n    if [[ \"$kind\" == volume ]]; then\n        attached_to=\"$(inventory_field \"$id\" attached_to)\"\n        if [[ -n \"$attached_to\" ]]; then\n            if [[ \"$DRY_RUN\" -eq 1 ]]; then\n                echo \"would detach volume $id from $attached_to\"\n            else"]
[38.485199, "o", "\u001b[?2004h> "]
[38.485207, "i", "\n                echo \"detaching volume $id from $attached_to\"\n                \"$CLOUDCTL\" volume detach \"$id\"\n            fi\n        fi\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"would delete $kind $id ($name)\"\n        continue\n    fi\n    echo \"deleting $kind $id ($name)\"\n    if \"$CLOUDCTL\" delete \"$id\"; then\n        report_add deleted \"$id\" \"$kind\" \"$name\"\n    else\n        status=$?\n        report_add failed \"$id\" \"$kind\" \"$name\" \"delete exited $status; check resource dependencies\"\n        exit \"$status\"\n    fi\ndone <<< \"$ordered\"\n\necho \"teardown: done\"\n'''\np.write_text(s)\nPY\nbash -n teardown.sh lib/*.sh; bash tests/test_teardown.sh\n"]
[38.485336, "o", "s = s.replace('        network)  echo 10 ;;\\n        subnet)   echo 20 ;;\\n        instance) echo 30 ;;', '        dns)      echo 10 ;;\\n        lb)       echo 20 ;;\\n        volume)   echo 30 ;;\\n        instance) echo 40 ;;\\n        subnet)   echo 50 ;;\\n        network)  echo 60 ;;')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.485353, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[38.485481, "o", "\u001b[?2004h> p = Path('teardown.sh')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r"]
