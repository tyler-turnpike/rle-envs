[95.223744, "i", "\n    def test_revoke_allows_exact_minimum_and_is_idempotent(self):\n        self.enqueue('1', message('AR-1', LEAD, 'revoke', 'bo', 'billing-reader, billing-reader'))\n        self.enqueue('2', message('AR-2', LEAD, 'revoke', 'bo', 'billing-reader'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], ['ci-viewer'])\n        self.assertEqual(self.acl()['zed'], ['billing-reader'])\n        self.assertEqual(len(self.audit()), 1)\n\n    def test_unknown_role_rejection_is_atomic_and_audited(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'billing-reader, typo'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'rejected')\n        self.assertIn('typo', self.audit()[0]['reason'])\n\n    def test_malformed_message_retains_audit_metadata(self):\n        self.enqueue('1', message('AR-1', f'Lead <{LEAD}>', 'oops', 'ana', 'ci-viewer'))\n       "]
