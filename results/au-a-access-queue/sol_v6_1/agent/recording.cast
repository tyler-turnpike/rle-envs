[66.277867, "i", "cat > accessq/mailparse.py <<'PY'\n\"\"\"Parse structured access requests from RFC 822 messages.\n\nOnly the request block in the text/plain body is used, not signatures or\nquoted correspondence. Sender identities are single, normalized mailboxes.\n\"\"\"\nfrom __future__ import annotations\n\nimport email\nimport re\nfrom dataclasses import dataclass\nfrom email import policy as email_policy\nfrom email.utils import getaddresses\nfrom pathlib import Path\n\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\nACTIONS = (\"grant\", \"revoke\")\n\n\nclass ParseError(ValueError):\n    \"\"\"An invalid request, retaining available envelope data for the audit.\"\"\"\n\n    def __init__(self, reason: str):\n        super().__init__(reason)\n        self.ticket = \"?\"\n        self.msg_id = \"\"\n        self.actor = \"\"\n\n\n@dataclass\nclass Request:\n    path: Path\n    msg_id: str\n    ticket: str\n    sender: str\n    action: str\n    principal: str\n    roles: list[str]\n    justification: str = \"\"\n\n\ndef sender_address(value:"]
[66.277896, "i", " str) -> str:\n    \"\"\"Ignore display names and case, but never approve multiple senders.\"\"\"\n    try:\n        addresses = getaddresses([value])\n    except ValueError:\n        return \"\"\n    if len(addresses) != 1:\n        return \"\"\n    address = addresses[0][1].strip().casefold()\n    if address.count(\"@\") != 1 or any(c.isspace() for c in address):\n        return \"\"\n    if not all(address.split(\"@\")):\n        return \"\"\n    return address\n\n\ndef _plain_body(msg) -> str:\n    part = msg.get_body(preferencelist=(\"plain\",))\n    if part is None:\n        raise ParseError(\"no text/plain part\")\n    try:\n        body = part.get_content()\n    except (LookupError, UnicodeError, ValueError) as exc:\n        raise ParseError(f\"invalid text/plain body: {exc}\") from exc\n    if not isinstance(body, str):\n        raise ParseError(\"invalid text/plain body\")\n    return body\n\n\ndef parse_fields(text: str) -> dict[str, str]:\n    fields: dict[str, str] = {}\n    for line in text.splitlines():\n        if line.rstrip() == \"--\" or line.lstrip"]
[66.278001, "o", "cat > accessq/mailparse.py <<'PY'\r\n\u001b[?2004l\r"]
[66.278036, "i", "().startswith(\">\"):\n            break\n        if not line.strip() and fields:\n            break\n        match = FIELD_RE.match(line.strip())\n        if match:\n            key, value = match.group(1).lower(), match.group(2).strip()\n            if key in fields:\n                raise ParseError(f\"duplicate {key} field\")\n            fields[key] = value\n    return fields\n\n\ndef parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    ticket_match = TICKET_RE.search(subject)\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    from_header = msg.get(\"From\", \"\")\n    raw_sender = str(from_header)\n    sender = sender_address(raw_sender)\n    try:\n        if not ticket_match:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        if (len(msg.get_all(\"From\", [])) != 1 or not sender\n                or getattr(from_header, \"defects\", ())):\n            raise ParseE"]
[66.278054, "o", "\u001b[?2004h"]
[66.278068, "i", "rror(\"missing or invalid From address\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles entry\")\n        return Request(\n            path=path, msg_id=msg_id, ticket=ticket_match.group(1),\n            sender=sender, action=action, principal=principal,\n            roles=list(dict.fromkeys(roles)),\n            justification=fields.get(\"justification\", \"\"),\n        )\n    except ParseError as exc:\n        exc.ticket = ticket_match.group(1) if ticket_match else \"?\"\n        exc.msg_id = msg_id\n        exc.actor = sender or raw_sender\n        raise\nPY\n"]
[66.278327, "o", "> "]
