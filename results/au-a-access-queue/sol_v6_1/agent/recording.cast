[110.960475, "i", "python - <<'PY'\nimport hashlib, json\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nbase = json.loads(Path('/tmp/accessq-baseline.json').read_text())\npreview = json.loads(Path('/tmp/accessq-preview.json').read_text())\nacl = json.loads(Path('state/acl.json').read_text())['principals']\nexpected = base['acl']['principals']\nexpected['priya.raman'] = sorted(expected['priya.raman'] + ['deploy-operator'])\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = sorted(expected['alice.ng'] + ['artifact-publisher'])\nassert acl == expected, 'Unexpected ACL change'\ntext = Path('state/audit.log').read_text()\nassert text.startswith(base['audit']), 'Existing audit log changed'\nentries = [json.loads(line) for line in text[len(base['audit']):].splitlines()]\nassert len(entries) == 12\nassert sum(e['result'] == 'applied' for e in entries) == 8\nassert sum(e['result'] == 'held' for e in entries) == 4\nassert not list"]
[110.960629, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.960671, "i", "(Path('queue/new').iterdir())\nfor outcome in preview:\n    dest = 'cur' if outcome['status'] == 'applied' else 'held'\n    path = Path('queue') / dest / outcome['name']\n    assert hashlib.sha256(path.read_bytes()).hexdigest() == base['files']['queue/new/' + outcome['name']]\nfor path, digest in base['files'].items():\n    if path.startswith('queue/bounced/'):\n        assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == digest\nbefore = {str(p): p.read_bytes() for d in ('queue', 'state') for p in Path(d).rglob('*') if p.is_file()}\nassert process_queue(Path('/app')) == []\nafter = {str(p): p.read_bytes() for d in ('queue', 'state') for p in Path(d).rglob('*') if p.is_file()}\nassert before == after\nprint('Verified exact ACL delta, 8 applied-role audit entries, 4 held-message entries, unchanged audit prefix and message contents, untouched bounced mail, and write-free empty rerun.')\nprint('\\nCurrent assignments:')\nfor principal, roles in sorted(acl.items()):\n    print(f'{principal}: {\", \".join(roles) or \"-\"}')\n"]
[110.960677, "o", "import hashlib, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.960683, "i", "PY\n"]
