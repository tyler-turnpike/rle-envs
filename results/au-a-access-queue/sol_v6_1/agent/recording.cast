[109.931417, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Handler fixes\n\nThe former 0.4 gaps are covered by the tests: exact-role revocation,\ntransitive and duplicate-free grants, comma-separated role lists,\ncase-insensitive mailbox matching independent of display names, held/rejected\naudit entries, and write-free dry runs. Dry runs simulate earlier requests in\nmemory so minimum-holder checks match a real run.\n\n''' + s[end:]\np.write_text(s)\np = Path('tests/test_regressions.py')\np.write_text(p.read_text().replace('import json\\n', ''))\nPY\npython -m accessq.cli process\n"]
