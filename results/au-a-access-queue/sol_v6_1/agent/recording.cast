[96.231483, "i", "python - <<'PY'\nimport hashlib, json\nfrom pathlib import Path\nfrom accessq.handler import process_queue\n\ndef snapshot():\n    return {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\n            for directory in ('queue', 'state')\n            for p in Path(directory).rglob('*') if p.is_file()}\n\nbaseline = {'files': snapshot(), 'acl': json.loads(Path('state/acl.json').read_text()),\n            'audit': Path('state/audit.log').read_text()}\nPath('/tmp/accessq-baseline.json').write_text(json.dumps(baseline))\noutcomes = process_queue(Path('/app'), dry_run=True)\nfor o in outcomes:\n    print(f'{o.status:9} {o.ticket:8} {o.detail}')\nassert snapshot() == baseline['files'], 'Dry run modified queue/state!'\nprint('Verified: dry run changed no queue or state file contents.')\nPath('/tmp/accessq-preview.json').write_text(json.dumps([vars(o) for o in outcomes]))\nPY\n"]
