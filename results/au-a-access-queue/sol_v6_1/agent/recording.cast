[95.221143, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Safety and edge-case coverage beyond the original gap tests.\"\"\"\nimport json\nfrom email.message import EmailMessage\n\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\nfrom accessq.handler import process_queue\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes()\n                for p in self.root.rglob('*') if p.is_file()}\n\n    def test_noop_grants_and_revokes_have_no_audit_entries(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-2', LEAD, 'revoke', 'nobody', 'ci-viewer'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(self.audit(), [])\n        self.assertEqual([o.status for o in outcomes], ['applied', 'applied'])\n        self.assertNotIn('nobody', self.acl())\n\n    def test_transitive_shared_roles_are_audited_once(self):\n        self.enqueue('1', message('A"]
[95.221234, "i", "R-1', LEAD, 'grant', 'cy', 'release-manager, deploy-operator'))\n        process_queue(self.root)\n        entries = self.audit()\n        self.assertEqual(len(entries), 4)\n        self.assertEqual({e['role'] for e in entries}, set(self.acl()['cy']))\n        self.assertTrue(all(e['actor'] == LEAD and e['ticket'] == 'AR-1'\n                            and e['msg_id'] == '<AR-1@example.test>'\n                            and e['result'] == 'applied' for e in entries))\n\n    def test_minimum_holders_blocks_entire_revoke(self):\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-1', LEAD, 'revoke', 'bo', 'ci-viewer, billing-reader'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], ['billing-reader', 'ci-viewer'])\n        self.assertEqual(self.listing('held'), ['1.eml'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'held')\n        self.assertIn('min_holders = 1', self.audit()[0]['reason'])\n"]
