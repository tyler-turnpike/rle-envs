[137.319498, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[137.319537, "o", "\u001b[?2004h> "]
[137.319721, "o", "import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[137.320198, "o", "old = Path('/tmp/accessq-before/state/audit.log').read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> new = Path('state/audit.log').read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> assert new.startswith(old)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[137.322609, "o", "entries = [json.loads(line) for line in new[len(old):].splitlines()]"]
[137.322643, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> counts = Counter(e['result'] for e in entries)\r\n\u001b[?2004l\r\u001b[?2004h> assert counts == {'applied': 8, 'held': 4}, counts\r\n\u001b[?2004l\r\u001b[?2004h> assert {e['ticket'] for e in entries if e['result'] == 'applied'} == {'AR-2201', 'AR-2204', 'AR-2206', 'AR-2208'}\r\n\u001b[?2004l\r\u001b[?2004h> assert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207'}\r\n\u001b[?2004l\r\u001b[?2004h> assert len(list(Path('queue/new').glob('*.eml'))) == 0\r\n\u001b[?2004l\r\u001b[?2004h> assert len(list(Path('queue/cur').glob('*.eml'))) == 4\r\n\u001b[?2004l\r\u001b[?2004h> assert len(list(Path('queue/held').glob('*.eml'))) == 4\r\n\u001b[?2004l\r\u001b[?2004h> for source in Path('/tmp/accessq-before/queue/new').glob('*.eml'):\r\n\u001b[?2004l\r\u001b[?2004h>     matches = [p for folder in ('cur', 'held') if (p := Path('queue') / folder / source.name).exists()]\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(matches) == 1 and matches[0].read_bytes() == source.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> for source in Path('/tmp/accessq-before/queue/bounced').glob('*"]
[137.322654, "o", ".eml'):\r\n\u001b[?2004l\r\u001b[?2004h>     assert (Path('queue/bounced') / source.name).read_bytes() == source.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> approved = tomllib.loads(Path('policy/delegation.toml').read_text())['approved_senders']\r\n\u001b[?2004l\r\u001b[?2004h> assert set(approved) == {'ilse.achterberg@fernhollow.dev', 'mara.lindqvist@fernhollow.dev'}\r\n\u001b[?2004l\r\u001b[?2004h> print('FINAL VERIFIED: 4 applied requests, 4 held requests; 8 role changes and 4 holds audited; original audit and message contents preserved; Mara delegated; bounced copy untouched.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
