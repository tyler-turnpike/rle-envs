[98.007138, "i", "cat accessq/mailparse.py; for f in queue/new/*2201* queue/new/*2202* queue/new/*2203*; do echo \"===== $f\"; cat \"$f\"; done\n"]
[98.007426, "o", "cat accessq/mailparse.py; for f in queue/new/*2201* queue/new/*2202* queue/new/*2203*; do echo \"===== $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[98.009076, "o", "\"\"\"Parse access-request messages (RFC 822 / .eml) from the queue.\r\n\r\nA request body is a block of ``Key: value`` lines, for example::\r\n\r\n    Action: grant\r\n    Principal: priya.raman\r\n    Roles: deploy-operator\r\n    Justification: joining the deploy rotation\r\n\r\nAnything after a ``-- `` signature separator is ignored.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport email\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom email import policy as email_policy\r\nfrom pathlib import Path\r\n\r\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\r\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\r\nACTIONS = (\"grant\", \"revoke\")\r\n\r\n\r\nclass ParseError(ValueError):\r\n    \"\"\"The message is not a well-formed access request, with audit metadata.\"\"\"\r\n\r\n    def __init__(self, message: str, *, ticket: str = \"?\", msg_id: str = \"\",\r\n                 actor: str = \"\"):\r\n        super().__init__(message)\r\n        self.ticket = ticket\r\n        self.msg_id = msg_id\r\n        self.actor = actor\r\n\r\n\r\ndef sender_address(value: str) -> str:\r\n    \"\"\""]
[98.009204, "o", "Return a single mailbox, ignoring display name and address case.\"\"\"\r\n    header = email_policy.default.header_factory(\"From\", value)\r\n    addresses = header.addresses\r\n    if (header.defects or len(addresses) != 1\r\n            or not addresses[0].username or not addresses[0].domain):\r\n        raise ValueError(\"From must contain one valid mailbox\")\r\n    return addresses[0].addr_spec.casefold()\r\n\r\n\r\n@dataclass\r\nclass Request:\r\n    path: Path\r\n    msg_id: str\r\n    ticket: str\r\n    sender: str\r\n    action: str\r\n    principal: str\r\n    roles: list[str]\r\n    justification: str = \"\"\r\n\r\n\r\ndef _plain_body(msg) -> str:\r\n    part = msg.get_body(preferencelist=(\"plain\",))\r\n    if part is None:\r\n        raise ParseError(\"no text/plain part\")\r\n    return part.get_content()\r\n\r\n\r\ndef parse_fields(text: str) -> dict[str, str]:\r\n    fields: dict[str, str] = {}\r\n    for line in text.splitlines():\r\n        if line.rstrip() == \"--\":\r\n            break\r\n        m = FIELD_RE.match(line.strip())\r\n        if m:\r\n            fields.se"]
[98.009229, "o", "tdefault(m.group(1).lower(), m.group(2).strip())\r\n    return fields\r\n\r\n\r\ndef parse_message(path: Path) -> Request:\r\n    with open(path, \"rb\") as fh:\r\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\r\n    subject = str(msg.get(\"Subject\", \"\"))"]
[98.009257, "o", "\r\n    m = TICKET_RE.search(subject)\r\n    ticket = m.group(1) if m else \"?\""]
[98.009362, "o", "\r\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\r\n    sender = \"\"\r\n    try:\r\n        headers = msg.get_all(\"From\", [])\r\n        if len(headers) != 1:\r\n            raise ParseError(\"expected one From header\")\r\n        try:\r\n            sender = sender_address(str(headers[0]))\r\n        except ValueError as exc:\r\n            raise ParseError(str(exc)) from exc\r\n        if not m:\r\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\r\n        fields = parse_fields(_plain_body(msg))\r\n        action = fields.get(\"action\", \"\").lower()\r\n        if action not in ACTIONS:\r\n            raise ParseError(f\"unsupported action {action!r}\")\r\n        principal = fields.get(\"principal\", \"\")\r\n        if not principal:\r\n            raise ParseError(\"missing Principal\")\r\n        if not fields.get(\"roles\"):\r\n            raise ParseError(\"missing Roles\")\r\n        roles = [role.strip() for role in fields[\"roles\"].split(\",\")]\r\n        if not all(roles):\r\n            raise ParseError(\"empty role in Roles\")\r\n       "]
[98.009397, "o", " roles = list(dict.fromkeys(roles))\r\n    except (ParseError, LookupError, UnicodeError) as exc:\r\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_id,\r\n                         actor=sender) from exc\r\n    return Request(\r\n        path=path,\r\n        msg_id=msg_id,\r\n        ticket=ticket,\r\n        sender=sender,\r\n        action=action,\r\n        principal=principal,\r\n        roles=roles,\r\n        justification=fields.get(\"justification\", \"\"),\r\n    )\r\n"]
[98.00961, "o", "===== queue/new/1763284210.M2201P4120.fernq.eml\r\n"]
