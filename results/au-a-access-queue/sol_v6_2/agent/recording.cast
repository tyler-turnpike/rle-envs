[137.318573, "i", "python - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nimport tomllib\nold = Path('/tmp/accessq-before/state/audit.log').read_bytes()\nnew = Path('state/audit.log').read_bytes()\nassert new.startswith(old)\nentries = [json.loads(line) for line in new[len(old):].splitlines()]\ncounts = Counter(e['result'] for e in entries)\nassert counts == {'applied': 8, 'held': 4}, counts\nassert {e['ticket'] for e in entries if e['result'] == 'applied'} == {'AR-2201', 'AR-2204', 'AR-2206', 'AR-2208'}\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207'}\nassert len(list(Path('queue/new').glob('*.eml'))) == 0\nassert len(list(Path('queue/cur').glob('*.eml'))) == 4\nassert len(list(Path('queue/held').glob('*.eml'))) == 4\nfor source in Path('/tmp/accessq-before/queue/new').glob('*.eml'):\n    matches = [p for folder in ('cur', 'held') if (p := Path('queue') / folder / source.name).exists()]\n    assert len(matches) == 1 and matches[0].read_bytes() == so"]
[137.318617, "i", "urce.read_bytes()\nfor source in Path('/tmp/accessq-before/queue/bounced').glob('*.eml'):\n    assert (Path('queue/bounced') / source.name).read_bytes() == source.read_bytes()\napproved = tomllib.loads(Path('policy/delegation.toml').read_text())['approved_senders']\nassert set(approved) == {'ilse.achterberg@fernhollow.dev', 'mara.lindqvist@fernhollow.dev'}\nprint('FINAL VERIFIED: 4 applied requests, 4 held requests; 8 role changes and 4 holds audited; original audit and message contents preserved; Mara delegated; bounced copy untouched.')\nPY\n"]
