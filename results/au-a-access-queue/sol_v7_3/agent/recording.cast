[83.481879, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text().replace('## Known gaps (0.4)\\n\\nNot finished yet; the tests in `tests/` describe the intended behaviour.\\n\\n- revocations are not implemented\\n- implied roles are only expanded one level\\n- re-granting a held role duplicates it\\n- `Roles:` with several roles is read as one role name\\n- sender check compares the raw `From:` header\\n- held/rejected messages get no audit line\\n- `--dry-run` still saves the ACL and moves messages\\n', '## Implementation status\\n\\nThe 0.4 gaps are fixed and covered by `tests/`: revocations, transitive role\\nexpansion, idempotent grants, comma-separated roles, normalized sender checks,\\nheld/rejected auditing, and write-free dry runs. Dry runs simulate changes in\\nmemory so subsequent requests see the same decisions as a real run.\\n')\ns = s.replace('- Sender not delegated: **held**,', '- An explicit SPF, DKIM, or DMARC failure in `Authentication-Results` from\\n  `mx.fernhollow.dev` is **held** for ident"]
[83.482031, "i", "ity verification, even when `From:`\\n  names a delegated sender. Missing authentication results remain compatible\\n  with older form messages; this is not a full mail-authentication verifier.\\n- Sender not delegated: **held**,')\np.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom hashlib import sha256\nfrom accessq.handler import process_queue\n\ndef snapshot():\n    return {str(p): sha256(p.read_bytes()).hexdigest()\n            for folder in ('state', 'queue') for p in Path(folder).rglob('*') if p.is_file()}\nbefore = snapshot()\nfor outcome in process_queue(Path('.'), dry_run=True):\n    print(f'{outcome.status:9} {outcome.ticket:8} {outcome.detail}')\nassert snapshot() == before, 'Dry-run changed files!'\nprint('Verified: dry-run left all queue and state files byte-for-byte unchanged.')\nPY\n"]
[83.482042, "o", "python - <<'PY'\r\n"]
