[55.775111, "i", "cat > accessq/mailparse.py <<'PY'\n\"\"\"Parse RFC 822 access requests, ignoring signatures and quoted replies.\"\"\"\nfrom __future__ import annotations\n\nimport email\nimport re\nfrom dataclasses import dataclass\nfrom email import policy as email_policy\nfrom email.utils import getaddresses\nfrom pathlib import Path\n\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\nACTIONS = (\"grant\", \"revoke\")\n\n\nclass ParseError(ValueError):\n    \"\"\"Malformed request, retaining envelope information for the audit log.\"\"\"\n\n    def __init__(self, reason: str, *, ticket=\"?\", msg_id=\"\", actor=\"\"):\n        super().__init__(reason)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor\n\n\ndef normalize_sender(value: str) -> str:\n    \"\"\"Only a single mailbox can identify the request's sender.\"\"\"\n    addresses = getaddresses([value])\n    if len(addresses) != 1:\n        return \"\"\n    address = addresses[0][1].strip().lower()\n    if address.count(\"@\") != 1 or any(c.isspace() f"]
[55.77531, "o", "cat > accessq/mailparse.py <<'PY'"]
[55.775541, "i", "or c in address):\n        return \"\"\n    local, domain = address.split(\"@\")\n    return address if local and domain else \"\"\n\n\n@dataclass\nclass Request:\n    path: Path\n    msg_id: str\n    ticket: str\n    sender: str\n    action: str\n    principal: str\n    roles: list[str]\n    justification: str = \"\"\n    authentication_failure: str = \"\"\n\n\ndef _plain_body(msg) -> str:\n    part = msg.get_body(preferencelist=(\"plain\",))\n    if part is None:\n        raise ParseError(\"no text/plain part\")\n    return part.get_content()\n\n\ndef parse_fields(text: str) -> dict[str, str]:\n    fields: dict[str, str] = {}\n    for line in text.splitlines():\n        if line.rstrip() == \"--\":\n            break\n        if line.lstrip().startswith(\">\"):\n            continue\n        m = FIELD_RE.match(line.strip())\n        if m:\n            fields.setdefault(m.group(1).lower(), m.group(2).strip())\n    return fields\n\n\ndef _authentication_failure(msg) -> str:\n    # Only consume results stamped by our receiving MX. Missing results are\n    # allowed for"]
