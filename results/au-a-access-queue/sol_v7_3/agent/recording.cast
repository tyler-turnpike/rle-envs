[55.775665, "i", " older form messages; explicit failures need human review.\n    for header in msg.get_all(\"Authentication-Results\", []):\n        authority, _, results = str(header).partition(\";\")\n        if authority.strip().lower() != \"mx.fernhollow.dev\":\n            continue\n        failures = re.findall(\n            r\"\\b(dmarc|spf|dkim)\\s*=\\s*(fail|permerror)\\b\", results, re.I)\n        if failures:\n            return \"mail authentication failed: \" + \", \".join(\n                f\"{method.lower()}={result.lower()}\" for method, result in failures)\n    return \"\"\n\n\ndef parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    senders = msg.get_all(\"From\", [])\n    sender = normalize_sender(str(senders[0])) if len(senders) == 1 else \"\"\n    try:\n        if not mat"]
[55.777581, "i", "ch:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        if not sender:\n            raise ParseError(\"missing or ambiguous From mailbox\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        if not fields.get(\"roles\"):\n            raise ParseError(\"missing Roles\")\n        roles = [role.strip() for role in fields[\"roles\"].split(\",\")]\n        if not all(roles):\n            raise ParseError(\"empty role in Roles\")\n        return Request(\n            path=path, msg_id=msg_id, ticket=ticket, sender=sender,\n            action=action, principal=principal, roles=list(dict.fromkeys(roles)),\n            justification=fields.get(\"justification\", \"\"),\n            authentication_failure=_authentication_failure(msg),\n        )\n    "]
