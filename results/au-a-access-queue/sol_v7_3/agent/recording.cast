[55.778848, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import dataclass\r\n\u001b[?2004l\r\u001b[?2004h> from email import policy as email_policy"]
[55.778871, "o", "\r\n"]
[55.778887, "o", "\u001b[?2004l\r"]
[55.778905, "o", "\u001b[?2004h"]
[55.778942, "o", "> "]
[55.778996, "o", "from email.utils import getaddresses"]
[55.779122, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.779178, "o", "from pathlib import Path"]
[55.779232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.779299, "o", "> \r\n"]
[55.779381, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.779388, "o", "> TICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")"]
[55.779437, "o", "\r\n"]
[55.779458, "o", "\u001b[?2004l\r"]
[55.779483, "o", "\u001b[?2004h"]
[55.779573, "o", "> "]
[55.779578, "o", "FIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")"]
[55.77962, "o", "\r\n"]
[55.779696, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.779702, "o", "> "]
[55.779776, "o", "ACTIONS = (\"grant\", \"revoke\")"]
[55.779812, "o", "\r\n"]
[55.779845, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.779911, "o", "> "]
[55.779952, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.77996, "o", "> \r\n"]
[55.779971, "o", "\u001b[?2004l\r"]
[55.780087, "o", "\u001b[?2004h"]
[55.780096, "o", "> class ParseError(ValueError):"]
[55.780104, "o", "\r\n"]
[55.780128, "o", "\u001b[?2004l\r"]
[55.780143, "o", "\u001b[?2004h"]
[55.780179, "o", "> "]
[55.780331, "o", "    \"\"\"Malformed request, retaining envelope information for the audit log.\"\"\""]
[55.780368, "o", "\r\n"]
[55.780419, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.780438, "o", "> "]
[55.78049, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.780519, "o", "> "]
[55.780622, "o", "    def __init__(self, reason: str, *, ticket=\"?\", msg_id=\"\", actor=\"\"):"]
[55.780674, "o", "\r\n"]
[55.780731, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.780775, "o", "> "]
[55.780832, "o", "        super().__init__(reason)"]
[55.780896, "o", "\r\n\u001b[?2004l\r"]
[55.780927, "o", "\u001b[?2004h> "]
[55.780984, "o", "        self.ticket = ticket"]
[55.781103, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         self.msg_id = msg_id"]
[55.781152, "o", "\r\n"]
[55.781189, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.781273, "o", ">         self.actor = actor"]
[55.78131, "o", "\r\n"]
[55.781327, "o", "\u001b[?2004l\r"]
[55.781404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.781411, "o", "\u001b[?2004h"]
[55.781431, "o", "> "]
[55.781546, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def normalize_sender(value: str) -> str:"]
[55.781595, "o", "\r\n"]
[55.781662, "o", "\u001b[?2004l\r"]
[55.781872, "o", "\u001b[?2004h>     \"\"\"Only a single mailbox can identify the request's sender.\"\"\""]
[55.782996, "o", "\r\n"]
[55.78316, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.78336, "o", ">     addresses = getaddresses([value])"]
[55.783393, "o", "\r\n"]
[55.783419, "o", "\u001b[?2004l\r"]
[55.783501, "o", "\u001b[?2004h"]
[55.783568, "o", "> "]
[55.783582, "o", "    if len(addresses) != 1:"]
[55.783645, "o", "\r\n"]
[55.783652, "o", "\u001b[?2004l\r"]
[55.783688, "o", "\u001b[?2004h"]
[55.78376, "o", ">         return \"\""]
[55.783786, "o", "\r\n"]
[55.783794, "o", "\u001b[?2004l\r"]
[55.783844, "o", "\u001b[?2004h"]
[55.783938, "o", ">     address = addresses[0][1].strip().lower()"]
[55.783976, "o", "\r\n"]
[55.784, "o", "\u001b[?2004l\r"]
[55.784159, "o", "\u001b[?2004h>     if address.count(\"@\") != 1 or any(c.isspace() for c in address):"]
[55.784218, "o", "\r\n"]
[55.784266, "o", "\u001b[?2004l\r"]
[55.784305, "o", "\u001b[?2004h"]
[55.784363, "o", ">         return \"\""]
[55.784413, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.784441, "o", "> "]
[55.784519, "o", "    local, domain = address.split(\"@\")"]
[55.784556, "o", "\r\n"]
[55.784604, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.784695, "o", "> "]
[55.784703, "o", "    return address if local and domain else \"\""]
[55.784774, "o", "\r\n"]
[55.784822, "o", "\u001b[?2004l\r"]
[55.784828, "o", "\u001b[?2004h"]
[55.784889, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.784908, "o", "> "]
[55.784962, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.785046, "o", "> @dataclass"]
[55.785108, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.78517, "o", "> class Request:"]
[55.785199, "o", "\r\n\u001b[?2004l\r"]
[55.785234, "o", "\u001b[?2004h"]
[55.785796, "o", ">     path: Path\r\n\u001b[?2004l\r\u001b[?2004h>     msg_id: str\r\n\u001b[?2004l\r\u001b[?2004h>     ticket: str\r\n\u001b[?2004l\r\u001b[?2004h>     sender: str\r\n\u001b[?2004l\r\u001b[?2004h>     action: str\r\n\u001b[?2004l\r\u001b[?2004h>     principal: str\r\n\u001b[?2004l\r\u001b[?2004h>     roles: list[str]\r\n\u001b[?2004l\r\u001b[?2004h>     justification: str = \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     authentication_failure: str = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _plain_body(msg) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     part = msg.get_body(preferencelist=(\"plain\",))\r\n\u001b[?2004l\r"]
[55.785908, "o", "\u001b[?2004h"]
[55.785956, "o", "> "]
[55.786043, "o", "    if part is None:"]
[55.786103, "o", "\r\n"]
[55.786146, "o", "\u001b[?2004l\r"]
[55.7862, "o", "\u001b[?2004h"]
[55.786245, "o", "> "]
[55.786333, "o", "        raise ParseError(\"no text/plain part\")\r\n"]
[55.786375, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.786444, "o", "> "]
[55.78645, "o", "    return part.get_content()"]
[55.786529, "o", "\r\n"]
[55.786566, "o", "\u001b[?2004l\r"]
[55.786613, "o", "\u001b[?2004h"]
[55.786655, "o", "> "]
[55.786697, "o", "\r\n"]
[55.786716, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.786749, "o", "> "]
[55.786789, "o", "\r\n"]
[55.78681, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.786895, "o", "> def parse_fields(text: str) -> dict[str, str]:"]
[55.786936, "o", "\r\n"]
[55.786979, "o", "\u001b[?2004l\r"]
[55.78708, "o", "\u001b[?2004h>     fields: dict[str, str] = {}"]
[55.787144, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.787223, "o", ">     for line in text.splitlines():"]
[55.787262, "o", "\r\n"]
[55.787315, "o", "\u001b[?2004l\r"]
[55.787321, "o", "\u001b[?2004h"]
[55.787404, "o", ">         if line.rstrip() == \"--\":"]
[55.787441, "o", "\r\n"]
[55.787457, "o", "\u001b[?2004l\r"]
[55.787509, "o", "\u001b[?2004h> "]
[55.787534, "o", "            break"]
[55.787589, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.787669, "o", ">         if line.lstrip().startswith(\">\"):"]
[55.787707, "o", "\r\n"]
[55.787729, "o", "\u001b[?2004l\r"]
[55.787781, "o", "\u001b[?2004h> "]
[55.787837, "o", "            continue"]
[55.787868, "o", "\r\n"]
[55.787883, "o", "\u001b[?2004l\r"]
[55.787932, "o", "\u001b[?2004h> "]
[55.788037, "o", "        m = FIELD_RE.match(line.strip())"]
[55.788058, "o", "\r\n"]
[55.788129, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.788135, "o", "> "]
[55.788165, "o", "        if m:"]
[55.788237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.788327, "o", "            fields.setdefault(m.group(1).lower(), m.group(2).strip())"]
[55.788379, "o", "\r\n"]
[55.788415, "o", "\u001b[?2004l\r"]
[55.788462, "o", "\u001b[?2004h"]
[55.788509, "o", "> "]
[55.78852, "o", "    return fields"]
[55.788576, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.788607, "o", "> "]
[55.788628, "o", "\r\n"]
[55.788663, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.788677, "o", "> "]
[55.788746, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.788842, "o", "def _authentication_failure(msg) -> str:"]
[55.788868, "o", "\r\n"]
[55.788891, "o", "\u001b[?2004l\r"]
[55.788948, "o", "\u001b[?2004h> "]
[55.789092, "o", "    # Only consume results stamped by our receiving MX. Missing results are"]
[55.789139, "o", "\r\n"]
[55.789189, "o", "\u001b[?2004l\r"]
[55.789208, "o", "\u001b[?2004h"]
[55.789263, "o", "> "]
[55.789362, "o", "    # allowed for older form messages; explicit failures need human review."]
[55.789394, "o", "\r\n"]
[55.789432, "o", "\u001b[?2004l\r"]
[55.789476, "o", "\u001b[?2004h"]
[55.789566, "o", "> "]
[55.789571, "o", "    for header in msg.get_all(\"Authentication-Results\", []):"]
[55.789663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.789767, "o", "        authority, _, results = str(header).partition(\";\")"]
[55.789817, "o", "\r\n"]
[55.789871, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.789966, "o", ">         if authority.strip().lower() != \"mx.fernhollow.dev\":"]
[55.790026, "o", "\r\n"]
[55.790119, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.790197, "o", ">             continue"]
[55.790226, "o", "\r\n"]
[55.790277, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.790354, "o", ">         failures = re.findall("]
[55.790392, "o", "\r\n"]
[55.790408, "o", "\u001b[?2004l\r"]
[55.790464, "o", "\u001b[?2004h> "]
[55.790557, "o", "            r\"\\b(dmarc|spf|dkim)\\s*=\\s*(fail|permerror)\\b\", results, re.I)"]
[55.790598, "o", "\r\n"]
[55.790642, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.790686, "o", "> "]
[55.790721, "o", "        if failures:"]
[55.790776, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.790882, "o", ">             return \"mail authentication failed: \" + \", \".join("]
[55.790921, "o", "\r\n"]
[55.790942, "o", "\u001b[?2004l\r"]
[55.790988, "o", "\u001b[?2004h"]
[55.79106, "o", "> "]
[55.79118, "o", "                f\"{method.lower()}={result.lower()}\" for method, result in failures)"]
[55.791219, "o", "\r\n"]
[55.791252, "o", "\u001b[?2004l\r"]
[55.791305, "o", "\u001b[?2004h"]
[55.791344, "o", "> "]
[55.791398, "o", "    return \"\""]
[55.791444, "o", "\r\n"]
[55.791449, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.791512, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.79157, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[55.791606, "o", "> "]
[55.791669, "o", "def parse_message(path: Path) -> Request:"]
[55.791709, "o", "\r\n"]
[55.791762, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.791835, "o", ">     with open(path, \"rb\") as fh:"]
[55.79187, "o", "\r\n"]
[55.791893, "o", "\u001b[?2004l\r"]
[55.791947, "o", "\u001b[?2004h> "]
[55.79208, "o", "        msg = email.message_from_binary_file(fh, policy=email_policy.default)"]
[55.792133, "o", "\r\n"]
[55.792168, "o", "\u001b[?2004l\r"]
[55.792223, "o", "\u001b[?2004h> "]
[55.792272, "o", "    subject = str(msg.get(\"Subject\", \"\"))"]
[55.792321, "o", "\r\n"]
[55.792357, "o", "\u001b[?2004l\r"]
[55.792378, "o", "\u001b[?2004h"]
[55.792459, "o", ">     match = TICKET_RE.search(subject)"]
[55.792496, "o", "\r\n"]
[55.792519, "o", "\u001b[?2004l\r"]
[55.792569, "o", "\u001b[?2004h> "]
[55.792636, "o", "    ticket = match.group(1) if match else \"?\""]
[55.792691, "o", "\r\n"]
[55.792743, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.792821, "o", ">     msg_id = str(msg.get(\"Message-ID\", \"\")).strip()"]
[55.792877, "o", "\r\n"]
[55.792913, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.792994, "o", "> "]
[55.793, "o", "    senders = msg.get_all(\"From\", [])"]
[55.7931, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.793106, "o", "> "]
[55.793213, "o", "    sender = normalize_sender(str(senders[0])) if len(senders) == 1 else \"\""]
[55.793265, "o", "\r\n"]
[55.793297, "o", "\u001b[?2004l\r"]
[55.793341, "o", "\u001b[?2004h"]
[55.793391, "o", ">     try:"]
[55.793415, "o", "\r\n"]
[55.793458, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.793524, "o", ">         if not match:"]
[55.793561, "o", "\r\n\u001b[?2004l\r"]
[55.793759, "o", "\u001b[?2004h"]
[55.793769, "o", ">             raise ParseError(f\"no ticket id in subject {subject!r}\")"]
[55.793851, "o", "\r\n"]
[55.793869, "o", "\u001b[?2004l\r"]
[55.793977, "o", "\u001b[?2004h>         if not sender:"]
[55.794036, "o", "\r\n"]
[55.794087, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.794245, "o", "> "]
[55.794256, "o", "            raise ParseError(\"missing or ambiguous From mailbox\")"]
[55.794333, "o", "\r\n"]
[55.79435, "o", "\u001b[?2004l\r"]
[55.794392, "o", "\u001b[?2004h"]
[55.794513, "o", ">         fields = parse_fields(_plain_body(msg))"]
[55.794583, "o", "\r\n"]
[55.79459, "o", "\u001b[?2004l\r"]
[55.794729, "o", "\u001b[?2004h"]
[55.79474, "o", ">         action = fields.get(\"action\", \"\").lower()"]
[55.794821, "o", "\r\n"]
[55.794827, "o", "\u001b[?2004l\r"]
[55.794854, "o", "\u001b[?2004h"]
[55.794973, "o", ">         if action not in ACTIONS:"]
[55.795034, "o", "\r\n"]
[55.795074, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.795211, "o", ">             raise ParseError(f\"unsupported action {action!r}\")"]
[55.79528, "o", "\r\n"]
[55.795357, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.795458, "o", ">         principal = fields.get(\"principal\", \"\")"]
[55.795542, "o", "\r\n"]
[55.795608, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.795629, "o", "> "]
[55.795707, "o", "        if not principal:"]
[55.795739, "o", "\r\n"]
[55.795789, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.795869, "o", ">             raise ParseError(\"missing Principal\")"]
[55.795903, "o", "\r\n"]
[55.795937, "o", "\u001b[?2004l\r"]
[55.79598, "o", "\u001b[?2004h"]
[55.796086, "o", ">         if not fields.get(\"roles\"):"]
[55.79614, "o", "\r\n"]
[55.796156, "o", "\u001b[?2004l\r"]
[55.79616, "o", "\u001b[?2004h"]
[55.796264, "o", ">             raise ParseError(\"missing Roles\")"]
[55.7963, "o", "\r\n"]
[55.796335, "o", "\u001b[?2004l\r"]
[55.796378, "o", "\u001b[?2004h"]
[55.796417, "o", "> "]
[55.796511, "o", "        roles = [role.strip() for role in fields[\"roles\"].split(\",\")]"]
[55.796553, "o", "\r\n"]
[55.796594, "o", "\u001b[?2004l\r"]
[55.796636, "o", "\u001b[?2004h"]
[55.796688, "o", ">         if not all(roles):"]
[55.796753, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.796845, "o", ">             raise ParseError(\"empty role in Roles\")"]
[55.796881, "o", "\r\n"]
[55.796915, "o", "\u001b[?2004l\r"]
[55.796956, "o", "\u001b[?2004h"]
[55.796999, "o", "> "]
[55.797099, "o", "        return Request(\r\n\u001b[?2004l\r"]
[55.797156, "o", "\u001b[?2004h> "]
[55.797243, "o", "            path=path, msg_id=msg_id, ticket=ticket, sender=sender,"]
[55.797297, "o", "\r\n"]
[55.797338, "o", "\u001b[?2004l\r"]
[55.797358, "o", "\u001b[?2004h"]
[55.797493, "o", ">             action=action, principal=principal, roles=list(dict.fromkeys(roles)),"]
[55.797529, "o", "\r\n"]
[55.797564, "o", "\u001b[?2004l\r"]
[55.797748, "o", "\u001b[?2004h"]
[55.797757, "o", ">             justification=fields.get(\"justification\", \"\"),"]
[55.797835, "o", "\r\n"]
[55.797898, "o", "\u001b[?2004l\r\u001b[?2004h"]
[55.798028, "o", ">             authentication_failure=_authentication_failure(msg),"]
[55.798081, "o", "\r\n"]
[55.798102, "o", "\u001b[?2004l\r"]
[55.79817, "o", "\u001b[?2004h> "]
[55.798197, "o", "        )"]
[55.798253, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.798282, "o", "> "]
[55.798373, "o", "    except (ValueError, LookupError, TypeError) as exc:"]
[55.798417, "o", "\r\n"]
[55.798467, "o", "\u001b[?2004l\r\u001b[?2004h"]
