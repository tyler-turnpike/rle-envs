[102.843314, "i", "python - <<'PY'\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom accessq.handler import process_queue\n\nroot = Path('.')\noriginal_acl = json.loads(Path('state/acl.json').read_text())['principals']\noriginal_audit = Path('state/audit.log').read_bytes()\noriginal_messages = {p.name: p.read_bytes() for p in Path('queue/new').glob('*.eml')}\noriginal_bounced = {p.name: p.read_bytes() for p in Path('queue/bounced').glob('*.eml')}\npreview = process_queue(root, dry_run=True)\nexpected_status = {\n    'AR-2201': 'applied', 'AR-2202': 'held', 'AR-2203': 'held',\n    'AR-2204': 'applied', 'AR-2205': 'held', 'AR-2206': 'applied',\n    'AR-2207': 'held', 'AR-2208': 'applied', 'AR-2209': 'held',\n}\nassert {o.ticket: o.status for o in preview} == expected_status\nsubprocess.run([sys.executable, '-m', 'accessq.cli', 'process'], check=True)\nassert not list(Path('queue/new').glob('*.eml'))\nfor outcome in preview:\n    dest = 'cur' if outcome.status == 'applied' else 'held'\n    assert (Path('queue') / dest / outcome"]
[102.843538, "i", ".name).read_bytes() == original_messages[outcome.name]\nassert {p.name: p.read_bytes() for p in Path('queue/bounced').glob('*.eml')} == original_bounced\nexpected_acl = dict(original_acl)\nexpected_acl['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected_acl['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected_acl['svc-legacy-ci'] = []\nexpected_acl['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert json.loads(Path('state/acl.json').read_text())['principals'] == expected_acl\nnew_audit = Path('state/audit.log').read_bytes()\nassert new_audit.startswith(original_audit), 'Existing audit history changed'\nentries = [json.loads(line) for line in new_audit[len(original_audit):].splitlines()]\nassert len(entries) == 13\nassert sum(e['result'] == 'applied' for e in entries) == 8\nassert sum(e['result'] == 'held' for e in entries) == 5\nassert not any(e.get('role') == 'admin' for e in entries)\nassert all(len(roles) == len(set(roles)) for roles in expe"]
