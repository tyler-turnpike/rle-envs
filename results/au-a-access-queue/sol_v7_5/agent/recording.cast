[83.366855, "i", "le.test>')\n        self.assertEqual(entry['actor'], LEAD)\n        self.assertIn('unsupported action', entry['reason'])\n\n    def test_missing_plain_body_and_empty_role_are_rejected(self):\n        self.enqueue('1', message('AR-27', LEAD, 'grant', 'ana', 'ci-viewer, '))\n        self.enqueue('2', message('AR-28', LEAD, 'grant', 'ana', 'ci-viewer')\n                     .replace('text/plain', 'text/html'))\n        self.assertEqual([o.status for o in process_queue(self.root)],\n                         ['rejected', 'rejected'])\n        self.assertEqual(len(self.audit()), 2)\n\n    def test_failed_authentication_is_held(self):\n        self.enqueue('1', 'Authentication-Results: mx.example.test; spf=fail; dkim=none; dmarc=fail\\n'\n                     + message('AR-29', LEAD, 'grant', 'ana', 'admin'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'held')\n        self.assertIn('authentication failed', self.audit()[0]['reason'])\n        self.assertEqual(self.acl()['ana'], ['ci-viewe"]
