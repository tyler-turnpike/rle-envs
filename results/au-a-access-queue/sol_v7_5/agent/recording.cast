[84.356565, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\na = s.index('## Known gaps (0.4)')\nb = s.index('## Handoffs', a)\ns = s[:a] + '''## Handler status\n\nThe 0.4 gaps are fixed: revocations, transitive/deduplicated grants, comma-separated\nroles, normalized sender matching, held/rejected audit records, and read-only dry\nruns. Dry runs simulate earlier requests in memory so subsequent decisions match\nan actual run.\n\nMessages with explicit DMARC failures (or SPF failures without a DKIM pass) in\nupstream `Authentication-Results` are held for identity verification. This is not\nlocal cryptographic verification: the mail gateway must supply trustworthy\nresults and strip untrusted copies. Messages without these headers retain the\nsender-delegation behavior described above.\n\n''' + s[b:]\np.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): (p.read_bytes(), p.stat().st_mtim"]
