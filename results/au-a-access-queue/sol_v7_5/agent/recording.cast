[115.683273, "i", "python - <<'PY'\nimport subprocess\nfrom pathlib import Path\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): (p.read_bytes(), p.stat().st_mtime_ns)\n            for base in ('queue', 'state', 'policy')\n            for p in (root / base).rglob('*') if p.is_file()}\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert snapshot() == before\nprint('Verified: empty-queue rerun made no changes. Updated summary: queue/HANDOFF.md')\nPY\n"]
