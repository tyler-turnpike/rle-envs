[97.656895, "i", "python - <<'PY'\nimport json\nimport subprocess\nfrom collections import Counter\nfrom pathlib import Path\nroot = Path('/app')\naudit_path = root / 'state/audit.log'\nold_audit = audit_path.read_bytes()\nold_acl = json.loads((root / 'state/acl.json').read_text())['principals']\nnew_messages = {p.name: p.read_bytes() for p in (root / 'queue/new').glob('*.eml')}\nbounced = {p.name: p.read_bytes() for p in (root / 'queue/bounced').glob('*.eml')}\nassert len(new_messages) == 9\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert not list((root / 'queue/new').glob('*.eml'))\nassert len(list((root / 'queue/cur').glob('*.eml'))) == 4\nassert len(list((root / 'queue/held').glob('*.eml'))) == 5\nfor name, content in new_messages.items():\n    matches = [p for d in ('cur', 'held') if (p := root / 'queue' / d / name).exists()]\n    assert len(matches) == 1 and matches[0].read_bytes() == content\nassert {p.name: p.read_bytes() for p in (root / 'queue/bounced').glob('*.eml')} == bounced\nnew_audit = audit_path.rea"]
[97.657184, "i", "d_bytes()\nassert new_audit.startswith(old_audit)\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 5}\nassert Counter(e['action'] for e in entries if e['result'] == 'applied') == {'grant': 6, 'revoke': 2}\nacl = json.loads((root / 'state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in old_acl.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert acl == expected\nprint('Verified: 4 applied messages, 5 held, 6 role grants, 2 role revocations; prior audit preserved.')\nprint('Verified: svc-release-bot has no admin, Tomas retains billing-reader, bounced mail untouched.')\nPY\n"]
[97.657236, "o", "python - <<'PY'\r\n\u001b[?2004l\rd_bytes()\r\nassert new_audit.startswith(old_audit)\r\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\r\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 5}\r\nassert Counter(e['action'] for e in entries if e['result'] == 'applied') == {'grant': 6, 'revoke': 2}\r\nacl = json.loads((root / 'state/acl.json').read_text())['principals']\r\nexpected = {p: list(roles) for p, roles in old_acl.items()}\r\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\r\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\r\nexpected['svc-legacy-ci'] = []\r\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\r\nassert acl == expected\r\nprint('Verified: 4 applied messages, 5 held, 6 role grants, 2 role revocations; prior audit preserved.')\r\nprint('Verified: svc-release-bot has no admin, Tomas retains billing-reader, bounced mail untouched.')\r\nPY\r\n"]
