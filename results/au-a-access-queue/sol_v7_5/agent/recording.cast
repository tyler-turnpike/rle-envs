[83.366754, "i", "cat > tests/test_regressions.py <<'PY'\nimport unittest\n\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Delegation, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def test_min_holders_holds_entire_revoke(self):\n        self.write_acl({'ana': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-20', LEAD, 'revoke', 'ana',\n                                  'ci-viewer, billing-reader'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'held')\n        self.assertIn('min_holders = 1', outcomes[0].detail)\n        self.assertEqual(self.acl()['ana'], ['billing-reader', 'ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'held')\n\n    def test_revoke_noop_and_grant_noop_are_not_audited(self):\n        self.enqueue('1', message('AR-21', LEAD, 'revoke', 'missing', 'ci-viewer'))\n        self.enqueue('2', message('AR-22', LEAD, '"]
[83.366828, "i", "grant', 'ana', 'ci-viewer'))\n        outcomes = process_queue(self.root)\n        self.assertEqual([o.status for o in outcomes], ['applied', 'applied'])\n        self.assertNotIn('missing', self.acl())\n        self.assertEqual(self.audit(), [])\n\n    def test_each_change_audited_once_and_log_preserved(self):\n        audit_path = self.root / 'state' / 'audit.log'\n        old = '{\"result\":\"historic\"}\\n'\n        audit_path.write_text(old)\n        self.enqueue('1', message('AR-23', LEAD, 'grant', 'ana',\n                                  'release-manager, deploy-operator, release-manager'))\n        self.enqueue('2', message('AR-24', LEAD, 'revoke', 'bo',\n                                  'ci-viewer, billing-reader, ci-viewer'))\n        process_queue(self.root)\n        self.assertTrue(audit_path.read_text().startswith(old))\n        entries = self.audit()[1:]\n        self.assertEqual(len(entries), 5)\n        self.assertEqual(len({(e['ticket'], e['role']) for e in entries}), 5)\n        for entry in entries:\n            "]
