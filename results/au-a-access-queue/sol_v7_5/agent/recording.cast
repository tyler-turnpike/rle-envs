[55.912144, "i", "   if self.dry_run:\\n            return\\n        line = json.dumps')\np.write_text(s)\np = Path('accessq/policy.py')\ns = p.read_text().replace('import tomllib', 'import tomllib\\nfrom email import policy as email_policy\\nfrom email.parser import Parser')\na = s.index('        out: list[str] = []')\nb = s.index('\\n\\n@dataclass\\nclass Delegation:', a)\ns = s[:a] + '''        out: list[str] = []\n        seen: set[str] = set()\n\n        def visit(name: str) -> None:\n            if name in seen:\n                return\n            seen.add(name)\n            out.append(name)\n            for implied in self.roles[name].implies:\n                visit(implied)\n\n        for name in names:\n            visit(name)\n        return out\n\n\ndef sender_address(sender: str) -> str:\n    \"\"\"Accept exactly one well-formed mailbox, ignoring its display name.\"\"\"\n    try:\n        header = Parser(policy=email_policy.default).parsestr(\n            \"From: \" + sender + \"\\\\n\\\\n\")[\"From\"]\n        if header.defects or len(header.addresses) != 1:\n   "]
