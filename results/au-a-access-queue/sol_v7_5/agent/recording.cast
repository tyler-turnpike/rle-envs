[19.06557, "o", "# Role catalog for the platform ACL. Granting a role also grants every role it\r\n# implies (transitively). Revoking removes only the roles named in the request.\r\n\r\n[roles.ci-viewer]\r\ndescription = \"Read-only access to CI pipelines and build logs\"\r\n\r\n[roles.deploy-operator]\r\ndescription = \"Trigger and roll back deployments to staging and production\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.artifact-publisher]\r\ndescription = \"Publish build artifacts and container images to the internal registry\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.release-manager]\r\ndescription = \"Cut release branches, approve production releases\"\r\nimplies = [\"deploy-operator\", \"artifact-publisher\"]\r\n\r\n[roles.oncall-responder]\r\ndescription = \"Page acknowledgement, runbook execution, incident channels\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.billing-reader]\r\ndescription = \"Read cloud billing exports and cost dashboards\"\r\n# Finance's nightly cost-report export runs as whoever holds this role.\r\nmin_holders = 1\r\n\r\n[roles.access-reviewer]\r\ndescription = \"Read the"]
[19.065726, "o", " ACL and audit log for quarterly access reviews\"\r\n\r\n[roles.admin]\r\ndescription = \"Organisation administrator: full control of every platform resource, including the ACL itself\"\r\n# Senders whose access requests count as approved when they file them.\r\n# Requests from anyone else are moved to queue/held/ for the platform lead.\r\n# Addresses only (no display names).\r\napproved_senders = [\"ilse.achterberg@fernhollow.dev\"]\r\n"]
[19.067306, "o", "\"\"\"Run with: python -m unittest discover -s tests -v   (from the repo root).\"\"\"\r\nimport json\r\nimport shutil\r\nimport tempfile\r\nimport textwrap\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nfrom accessq.handler import process_queue\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLEAD = \"lead@example.test\"\r\n\r\n\r\ndef message(ticket, sender, action, principal, roles, msg_id=None):\r\n    return textwrap.dedent(f\"\"\"\\\r\n        From: {sender}\r\n        To: access-requests@example.test\r\n        Subject: [{ticket}] access request\r\n        Message-ID: <{msg_id or ticket}@example.test>\r\n        Date: Mon, 16 Nov 2026 09:00:00 +0000\r\n        Content-Type: text/plain; charset=utf-8\r\n\r\n        Action: {action}\r\n        Principal: {principal}\r\n        Roles: {roles}\r\n        Justification: test\r\n\r\n        --\r\n        sent from the access-request form\r\n        \"\"\")\r\n\r\n\r\nclass QueueCase(unittest.TestCase):\r\n    def setUp(self):\r\n        self.root = Path(tempfile.mkdtemp())\r\n        self.addCleanup(shutil.rmtree, self.root)\r\n    "]
[19.067386, "o", "    (self.root / \"policy\").mkdir()\r\n        shutil.copy(REPO / \"policy\" / \"roles.toml\", self.root / \"policy\" / \"roles.toml\")\r\n        (self.root / \"policy\" / \"delegation.toml\").write_text(\r\n            f'approved_senders = [\"{LEAD}\"]\\n')\r\n        (self.root / \"state\").mkdir()\r\n        self.write_acl({\"ana\": [\"ci-viewer\"], \"bo\": [\"billing-reader\", \"ci-viewer\"], \"zed\": [\"billing-reader\"]})\r\n        (self.root / \"state\" / \"audit.log\").write_text(\"\")\r\n        for d in (\"new\", \"cur\", \"held\"):\r\n            (self.root / \"queue\" / d).mkdir(parents=True)\r\n\r\n    def write_acl(self, principals):\r\n        (self.root / \"state\" / \"acl.json\").write_text(\r\n            json.dumps({\"principals\": principals}))\r\n\r\n    def enqueue(self, name, text):\r\n        (self.root / \"queue\" / \"new\" / f\"{name}.eml\").write_text(text)\r\n\r\n    def acl(self):\r\n        return json.loads((self.root / \"state\" / \"acl.json\").read_text())[\"principals\"]\r\n\r\n    def audit(self):\r\n        text = (self.root / \"state\" / \"audit.log\").read_text()\r\n        retur"]
