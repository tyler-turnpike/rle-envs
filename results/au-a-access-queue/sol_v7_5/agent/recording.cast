[56.019955, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('accessq/mailparse.py')\ns = p.read_text().replace('from pathlib import Path', 'from pathlib import Path\\n\\nfrom .policy import sender_address')\ns = s.replace('    justification: str = \"\"', '    justification: str = \"\"\\n    authentication_failure: str = \"\"')\na = s.index('def parse_message(')\ns = s[:a] + '''def message_metadata(msg) -> dict[str, str]:\n    match = TICKET_RE.search(str(msg.get(\"Subject\", \"\")))\n    return {\n        \"ticket\": match.group(1) if match else \"?\",\n        \"msg_id\": str(msg.get(\"Message-ID\", \"\")).strip(),\n        \"actor\": sender_address(str(msg.get(\"From\", \"\"))),\n    }\n\n\ndef authentication_failure(msg) -> str:\n    # These are upstream mail-gateway results, not authentication performed here.\n    # Missing results remain compatible with local/form-generated messages.\n    for header in msg.get_all(\"Authentication-Results\", []):\n        results = str(header).lower()\n        if re.search(r\"\\\\bdmarc\\\\s*=\\\\s*fail\\\\b\", results):\n            retur"]
[56.019997, "i", "n \"mail authentication failed (DMARC)\"\n        if (re.search(r\"\\\\bspf\\\\s*=\\\\s*fail\\\\b\", results)\n                and not re.search(r\"\\\\bdkim\\\\s*=\\\\s*pass\\\\b\", results)):\n            return \"mail authentication failed (SPF, without DKIM pass)\"\n    return \"\"\n\n\ndef parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    metadata = message_metadata(msg)\n    try:\n        if metadata[\"ticket\"] == \"?\":\n            raise ParseError(\"no ticket id in subject\")\n        if len(msg.get_all(\"From\", [])) != 1 or not metadata[\"actor\"]:\n            raise ParseError(\"missing or ambiguous sender address\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles "]
[56.020195, "i", "= [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty role in Roles\")\n        return Request(\n            path=path,\n            msg_id=metadata[\"msg_id\"],\n            ticket=metadata[\"ticket\"],\n            sender=metadata[\"actor\"],\n            action=action,\n            principal=principal,\n            roles=list(dict.fromkeys(roles)),\n            justification=fields.get(\"justification\", \"\"),\n            authentication_failure=authentication_failure(msg),\n        )\n    except (ParseError, UnicodeError, LookupError) as exc:\n        error = ParseError(str(exc))\n        error.metadata = metadata\n        raise error from exc\n'''\np.write_text(s)\np = Path('accessq/handler.py')\ns = p.read_text().replace('    if not delegation.approves(req.sender):', '    if req.authentication_failure:\\n        return \"held\", req.authentication_failure\\n    if not delegation.approves(req.sender):')\ns = s.replace('    store = AclStore(root).load()', "]
[56.020385, "i", "'    store = AclStore(root, dry_run=dry_run).load()')\ns = s.replace('''            outcomes.append(Outcome(path.name, \"?\", \"rejected\", str(exc)))\n            _move(path, held)''', '''            metadata = getattr(exc, \"metadata\", {\"ticket\": \"?\", \"msg_id\": \"\", \"actor\": \"\"})\n            store.audit(result=\"rejected\", reason=str(exc), **metadata)\n            outcomes.append(Outcome(path.name, metadata[\"ticket\"], \"rejected\", str(exc)))\n            if not dry_run:\n                _move(path, held)''')\ns = s.replace('''            _move(path, cur)\n        else:\n            _move(path, held)''', '''            if changed:\n                store.save()\n            if not dry_run:\n                _move(path, cur)\n        else:\n            store.audit(result=status, ticket=req.ticket, msg_id=req.msg_id,\n                        actor=req.sender, reason=detail)\n            if not dry_run:\n                _move(path, held)''')\ns = s.replace('    store.save()\\n    return outcomes', '    return outcomes')\np.write_text(s)\nPY"]
