[48.854222, "i", "  def __init__(self, reason: str, *, ticket: str = \"?\", msg_id: str = \"\", actor: str = \"\"):\n        super().__init__(reason)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor''')\nstart = s.index('    subject = str(msg.get(\"Subject\", \"\"))')\ns = s[:start] + '''    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    from_headers = msg.get_all(\"From\", [])\n    addresses = getaddresses([str(header) for header in from_headers])\n    sender = addresses[0][1].casefold() if len(addresses) == 1 else \"\"\n    try:\n        if not match:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        if (len(from_headers) != 1 or len(addresses) != 1 or\n                not sender or \"@\" not in sender or\n                any(getattr(header, \"defects\", ()) for header in from_headers)):\n            raise ParseError(\"missing or malformed From address\")\n        "]
[48.854236, "i", "fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles entry\")\n        return Request(\n            path=path, msg_id=msg_id, ticket=ticket, sender=sender,\n            action=action, principal=principal, roles=roles,\n            justification=fields.get(\"justification\", \"\"),\n        )\n    except (ValueError, LookupError, UnicodeError) as exc:\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_id, actor=sender) from exc\n'''\np.write_text(s)\np = Path('accessq/handler.py')\ns = p.read_text().replace('store = AclStore(root).load()', 'store = AclStore(root, dry_run=dry_run).load()\\n    dirty = False')"]
