[90.118391, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\na = s.index('## Known gaps (0.4)')\nb = s.index('## Handoffs', a)\ns = s[:a] + '''## Implementation status\n\nThe original 0.4 gaps are fixed: revocations, transitive implied roles,\nidempotent grants, comma-separated roles, sender-address normalization,\nheld/rejected auditing, and write-free dry runs. Dry runs simulate queue-order\nACL changes in memory, including minimum-holder checks. Regression coverage is\nin `tests/test_handler.py` and `tests/test_regressions.py`.\n\n''' + s[b:]\np.write_text(s)\nPY\npython - <<'PY'\nimport json\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): p.read_bytes().hex()\n            for directory in ('state', 'policy', 'queue')\n            for p in (root / directory).rglob('*') if p.is_file()}\nbefore = snapshot()\nPath('/tmp/accessq-run-baseline.json').write_text(json.dumps(before))\noutcomes = process_queue(root, dry_run"]
[90.118442, "i", "=True)\nassert snapshot() == before, 'Dry run changed files!'\nfor o in outcomes:\n    print(f'{o.status:9} {o.ticket:8} {o.detail}')\nPath('/tmp/accessq-preview.json').write_text(json.dumps([o.__dict__ for o in outcomes]))\nprint('Verified: dry-run changed no state, policy, or queue files.')\nPY\n"]
