[71.3786, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Additional coverage for audit integrity, sender boundaries and dry runs.\"\"\"\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes() if p.is_file() else None\n                for p in self.root.rglob('*')}\n\n    def test_dry_run_all_outcomes_and_sequential_changes(self):\n        self.enqueue('1', message('AR-11', LEAD, 'grant', 'ana', 'release-manager'))\n        self.enqueue('2', message('AR-12', LEAD, 'grant', 'ana', 'release-manager'))\n        self.enqueue('3', message('AR-13', 'other@example.test', 'grant', 'ana', 'admin'))\n        self.enqueue('4', message('AR-14', LEAD, 'grant', 'ana', 'unknown'))\n        self.enqueue('5', message('AR-15', LEAD, 'bad', 'ana', 'ci-viewer'))\n        before = self.snapshot()\n        preview = process_queue(self.root, dry_run=True)\n        s"]
[71.378942, "i", "elf.assertEqual(before, self.snapshot())\n        self.assertEqual([o.status for o in preview],\n                         ['applied', 'applied', 'held', 'rejected', 'rejected'])\n        self.assertIn('no change', preview[1].detail)\n        self.assertEqual(preview, process_queue(self.root))\n\n    def test_audit_only_actual_changes_and_preserves_existing_log(self):\n        prefix = '{\"result\":\"previous\"}\\n'\n        (self.root / 'state' / 'audit.log').write_text(prefix)\n        self.enqueue('1', message('AR-16', LEAD, 'grant', 'ana',\n                                  'release-manager, ci-viewer, release-manager'))\n        self.enqueue('2', message('AR-17', LEAD, 'grant', 'ana', 'release-manager'))\n        process_queue(self.root)\n        self.assertTrue((self.root / 'state' / 'audit.log').read_text().startswith(prefix))\n        entries = self.audit()[1:]\n        self.assertEqual(len(entries), 3)\n        self.assertEqual({e['role'] for e in entries},\n                         {'release-manager', 'deploy-operator', '"]
[71.378958, "o", "cat > tests/test_regressions.py <<'PY'"]
[71.378971, "i", "artifact-publisher'})\n        for e in entries:\n            self.assertEqual(e['actor'], LEAD)\n            self.assertEqual(e['ticket'], 'AR-16')\n            self.assertEqual(e['msg_id'], '<AR-16@example.test>')\n            self.assertEqual(e['result'], 'applied')\n            self.assertEqual(e['action'], 'grant')\n\n    def test_revoke_does_not_expand_and_missing_role_is_noop(self):\n        self.write_acl({'ana': ['ci-viewer', 'deploy-operator']})\n        self.enqueue('1', message('AR-18', LEAD, 'revoke', 'ana',\n                                  'deploy-operator, billing-reader, deploy-operator'))\n        self.enqueue('2', message('AR-19', LEAD, 'revoke', 'absent', 'ci-viewer'))\n        process_queue(self.root)\n        self.assertEqual(self.acl(), {'ana': ['ci-viewer']})\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['action'], 'revoke')\n        self.assertEqual(self.audit()[0]['role'], 'deploy-operator')\n\n    def test_rejected_messages_have_metadata_and_one_audit_line("]
[71.379173, "i", "self):\n        cases = [('AR-20', 'grant', 'unknown'), ('AR-21', 'bad', 'ci-viewer'),\n                 ('AR-22', 'grant', 'ci-viewer,,billing-reader')]\n        for i, (ticket, action, roles) in enumerate(cases):\n            self.enqueue(str(i), message(ticket, f'Lead <{LEAD}>', action, 'ana', roles))\n        before = self.acl()\n        process_queue(self.root)\n        self.assertEqual(before, self.acl())\n        self.assertEqual(len(self.audit()), 3)\n        for entry, (ticket, _, _) in zip(self.audit(), cases):\n            self.assertEqual(entry['result'], 'rejected')\n            self.assertEqual(entry['ticket'], ticket)\n            self.assertEqual(entry['msg_id'], f'<{ticket}@example.test>')\n            self.assertEqual(entry['actor'], LEAD)\n            self.assertTrue(entry['reason'])\n\n    def test_missing_ticket_is_rejected_and_audited(self):\n        self.enqueue('1', message('AR-23', LEAD, 'grant', 'ana', 'admin')\n                     .replace('[AR-23]', 'no ticket'))\n        process_queue(self.root)\n  "]
