[108.388211, "i", "python - <<'PY'\nimport json\nimport subprocess\nfrom collections import Counter\nfrom copy import deepcopy\nfrom pathlib import Path\n\nacl_path = Path('state/acl.json')\naudit_path = Path('state/audit.log')\nbefore_acl = json.loads(acl_path.read_text())\nbefore_audit = audit_path.read_bytes()\nmessages = {p.name: p.read_bytes() for p in Path('queue/new').glob('*.eml')}\nbounced = {p.name: p.read_bytes() for p in Path('queue/bounced').iterdir() if p.is_file()}\nassert len(messages) == 8\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nexpected = deepcopy(before_acl['principals'])\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['tomas.eriksen'] = ['ci-viewer']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert json.loads(acl_path.read_text())['principals'] == expected\nassert not list(Path('queue/new').glob('*.eml'))\nhe"]
[108.388274, "i", "ld_tickets = {'2202', '2205', '2207'}\nfor name, content in messages.items():\n    destination = 'held' if name.split('.M')[1][:4] in held_tickets else 'cur'\n    assert (Path('queue') / destination / name).read_bytes() == content\nassert {p.name: p.read_bytes() for p in Path('queue/bounced').iterdir() if p.is_file()} == bounced\nafter_audit = audit_path.read_bytes()\nassert after_audit.startswith(before_audit)\nentries = [json.loads(line) for line in after_audit[len(before_audit):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\nassert Counter(e['ticket'] for e in entries) == {'AR-2201': 1, 'AR-2202': 1,\n    'AR-2203': 1, 'AR-2204': 4, 'AR-2205': 1, 'AR-2206': 2, 'AR-2207': 1, 'AR-2208': 1}\nfor entry in entries:\n    assert all(k in entry for k in ('ticket', 'msg_id', 'actor'))\n    if entry['result'] == 'applied':\n        assert entry['actor'] == 'mara.lindqvist@fernhollow.dev'\n    else:\n        assert entry['reason']\nprint('\\nVerified: five messages applied, three held; six r"]
[108.388294, "i", "ole grants and three revocations.')\nprint('Existing audit preserved; 12 entries appended; bounced mail unchanged.')\n\n# An empty rerun must not change the ACL, audit, or any queue file.\ndef snapshot():\n    return {str(p): p.read_bytes() if p.is_file() else None\n            for d in ('state', 'queue') for p in Path(d).rglob('*')}\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert snapshot() == before\nprint('Verified: empty rerun writes nothing.')\nPY\n"]
