[94.107263, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Handler status\n\nThe 0.4 gaps are fixed: revocations, transitive and idempotent grants,\ncomma-separated roles, case-insensitive mailbox sender checks, held/rejected\naudit entries, and write-free dry runs. Regression tests also cover\nminimum-holder protection, multipart requests, and untrusted approval claims\nin message bodies or Cc headers.\n\n''' + s[end:]\np.write_text(s)\nPY\npython - <<'PY'\nimport hashlib\nimport subprocess\nfrom pathlib import Path\n\ndef snapshot():\n    return {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\n            for directory in ('policy', 'state', 'queue')\n            for p in Path(directory).rglob('*') if p.is_file()}\n\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert snapshot() == before, 'Dry run changed files'\nprint('Verified: policy, state, and "]
[94.107595, "i", "queue files unchanged by dry run.')\nPY\n"]
[94.107615, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[94.10833, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('## Known gaps (0.4)')\r\n\u001b[?2004l\r\u001b[?2004h> end = s.index('## Handoffs', start)\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''## Handler status\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The 0.4 gaps are fixed: revocations, transitive and idempotent grants,\r\n\u001b[?2004l\r\u001b[?2004h> comma-separated roles, case-insensitive mailbox sender checks, held/rejected\r\n\u001b[?2004l\r\u001b[?2004h> audit entries, and write-free dry runs. Regression tests also cover\r\n\u001b[?2004l\r\u001b[?2004h> minimum-holder protection, multipart requests, and untrusted approval claims\r\n\u001b[?2004l\r\u001b[?2004h> in message bodies or Cc headers.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\rqueue files unchanged by dry run.')\r\nPY\r\n"]
[94.12699, "o", "\u001b[?2004hroot@b594e3590da0:/app# "]
