[80.405674, "i", "(preview, actual)\n        self.assertEqual([o.status for o in actual],\n                         ['applied', 'applied', 'held', 'rejected', 'rejected'])\n\n    def test_role_expansion_handles_cycles_and_shared_dependencies(self):\n        catalog = Catalog({'a': Role('a', '', ('b', 'c')),\n                           'b': Role('b', '', ('a', 'c')), 'c': Role('c', '')})\n        self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\n\n    def test_delegation_normalizes_both_sides(self):\n        delegation = Delegation(['LEAD@Example.TEST'])\n        self.assertTrue(delegation.approves('\"Lead, Team\" <lead@example.test>'))\n        self.assertFalse(delegation.approves('\"lead@example.test\" <other@example.test>'))\n        self.assertFalse(delegation.approves('lead@example.test, other@example.test'))\n        self.assertFalse(delegation.approves(''))\nPY\npython -m unittest discover -s tests -v\n"]
