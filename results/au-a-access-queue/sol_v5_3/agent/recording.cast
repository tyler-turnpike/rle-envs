[108.104009, "i", "python - <<'PY'\nimport json\nimport subprocess\nfrom collections import Counter\nfrom pathlib import Path\n\nacl_path = Path('state/acl.json')\naudit_path = Path('state/audit.log')\nbefore = json.loads(acl_path.read_text())['principals']\nexpected = {p: list(roles) for p, roles in before.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\naudit_before = audit_path.read_bytes()\nqueued = {p.name: p.read_bytes() for p in Path('queue/new').glob('*.eml')}\nbounced = {p: p.read_bytes() for p in Path('queue/bounced').glob('*') if p.is_file()}\nassert len(queued) == 8\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert json.loads(acl_path.read_text())['principals'] == expected\nassert not list(Path('queue/new').iterdir())\nfor name, content in queued.items():\n    ticket_number = nam"]
[108.104051, "i", "e.split('.M')[1][:4]\n    folder = 'cur' if ticket_number in {'2201', '2204', '2206', '2208'} else 'held'\n    assert (Path('queue') / folder / name).read_bytes() == content\nassert all(path.read_bytes() == content for path, content in bounced.items())\naudit_after = audit_path.read_bytes()\nassert audit_after.startswith(audit_before)\nentries = [json.loads(line) for line in audit_after[len(audit_before):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 4}\nassert Counter(e['ticket'] for e in entries if e['result'] == 'applied') == {\n    'AR-2201': 1, 'AR-2204': 4, 'AR-2206': 2, 'AR-2208': 1}\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {\n    'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207'}\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev'\n           for e in entries if e['result'] == 'applied')\nassert all(len(roles) == len(set(roles)) for roles in expected.values())\nprint('Verified: exact ACL changes; 4 applied messages, 4 held; 8 role-change audit entries"]
