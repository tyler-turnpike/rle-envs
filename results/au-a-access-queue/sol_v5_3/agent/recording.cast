[94.127154, "o", "\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.127775, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>             for directory in ('policy', 'state', 'queue')\r\n\u001b[?2004l\r\u001b[?2004h>             for p in Path(directory).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> subprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before, 'Dry run changed files'\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: policy, state, and queue files unchanged by dry run.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
