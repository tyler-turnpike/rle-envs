[77.964122, "o", "\u001b[?2004hroot@99e699fbf28d:/app# "]
[77.964219, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.964313, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.964347, "o", "p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.964486, "o", "start = s.index('## Known gaps (0.4)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.96457, "o", "end = s.index('## Handoffs', start)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.964585, "o", "s = s[:start] + '''## Handler status\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.964669, "o", "> The 0.4 gaps are fixed: revocations, transitive role expansion, idempotent\r\n\u001b[?2004l\r"]
[77.964745, "o", "\u001b[?2004h> "]
[77.964801, "o", "updates, comma-separated roles, normalized sender checks, held/rejected audit\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.964859, "o", "> "]
[77.964896, "o", "entries, and write-free dry runs. Dry runs simulate the queue in order so that\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.964996, "o", "minimum-holder checks reflect earlier requests without writing any state.\r\n\u001b[?2004l\r"]
[77.965058, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.965099, "o", "> PY\r\n\u001b[?2004l\r"]
