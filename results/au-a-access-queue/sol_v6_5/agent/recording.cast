[106.857924, "i", "python - <<'PY'\nimport json\nimport os\nfrom collections import Counter\nfrom pathlib import Path\n\nbackup = Path(os.environ['ACCESSQ_BACKUP'])\nbefore = json.loads((backup / 'state/acl.json').read_text())['principals']\nafter = json.loads(Path('state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in before.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert after == expected, (after, expected)\nold_audit = (backup / 'state/audit.log').read_bytes()\nnew_audit = Path('state/audit.log').read_bytes()\nassert new_audit.startswith(old_audit)\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\nassert len(entries) == 12\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 4}\nassert Counter(e['ticket'] for e in entries) ="]
[106.858317, "i", "= {\n    'AR-2201': 1, 'AR-2202': 1, 'AR-2203': 1, 'AR-2204': 4,\n    'AR-2205': 1, 'AR-2206': 2, 'AR-2207': 1, 'AR-2208': 1,\n}\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev'\n           for e in entries if e['result'] == 'applied')\nassert not list(Path('queue/new').iterdir())\nfor path in (backup / 'queue/new').glob('*.eml'):\n    applied = any(f'M{ticket}' in path.name for ticket in ('2201', '2204', '2206', '2208'))\n    dest = Path('queue') / ('cur' if applied else 'held') / path.name\n    assert dest.read_bytes() == path.read_bytes()\nfor path in (backup / 'queue/bounced').iterdir():\n    assert (Path('queue/bounced') / path.name).read_bytes() == path.read_bytes()\nprint('Verified: exact ACL changes; original audit preserved; 8 role-change and 4 held audit entries; all 8 requests filed unchanged; bounced message untouched.')\nprint('\\nHeld requests:')\nfor entry in entries:\n    if entry['result'] == 'held':\n        print(f\"{entry['ticket']}: {entry['reason']}\")\nPY\npython -m accessq.cli show\n"]
[106.858396, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path"]
