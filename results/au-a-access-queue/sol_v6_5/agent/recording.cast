[77.93738, "i", "play_name_and_case(self):\n        msg = EmailMessage()\n        msg['From'] = '\"Lead, Team\" <LEAD@EXAMPLE.TEST>'\n        msg['Subject'] = '[AR-114] access request'\n        msg['Message-ID'] = '<AR-114@example.test>'\n        msg.set_content('Action: grant\\nPrincipal: ana\\nRoles: deploy-operator, artifact-publisher\\n')\n        msg.add_alternative('<p>Roles: admin</p>', subtype='html')\n        self.enqueue('1', msg.as_string())\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['artifact-publisher', 'ci-viewer', 'deploy-operator'])\n        self.assertTrue(all(e['actor'] == LEAD for e in self.audit()))\n\n    def test_signature_and_quoted_request_do_not_add_privileges(self):\n        self.enqueue('1', message('AR-115', LEAD, 'grant', 'ana', 'deploy-operator') +\n                     '\\n> Action: grant\\n> Principal: bot\\n> Roles: admin\\nRoles: admin\\n')\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer', 'deploy-operator'])\n        self.assertNotIn('bot'"]
[77.937383, "i", ", self.acl())\n\n    def test_dry_run_is_write_free_and_matches_sequential_processing(self):\n        self.write_acl({'bo': ['billing-reader']})\n        self.enqueue('1', message('AR-116', LEAD, 'grant', 'ana', 'billing-reader'))\n        self.enqueue('2', message('AR-117', LEAD, 'revoke', 'bo', 'billing-reader'))\n        self.enqueue('3', message('AR-118', LEAD, 'revoke', 'ana', 'billing-reader'))\n        self.enqueue('4', message('AR-119', 'other@example.test', 'grant', 'ana', 'admin'))\n        self.enqueue('5', message('AR-120', LEAD, 'grant', 'ana', 'unknown'))\n        self.enqueue('6', 'From: nobody@example.test\\n\\ninvalid\\n')\n        before = self.snapshot()\n        preview = process_queue(self.root, dry_run=True)\n        self.assertEqual(self.snapshot(), before)\n        self.assertEqual([o.status for o in preview],\n                         ['applied', 'applied', 'held', 'held', 'rejected', 'rejected'])\n        self.assertEqual(process_queue(self.root), preview)\n\n    def test_audit_is_append_only_and_empty_"]
[77.937397, "i", "rerun_writes_nothing(self):\n        prior = '{\"existing\": true}\\n'\n        (self.root / 'state' / 'audit.log').write_text(prior)\n        self.enqueue('1', message('AR-121', LEAD, 'grant', 'ana', 'deploy-operator'))\n        process_queue(self.root)\n        self.assertTrue((self.root / 'state' / 'audit.log').read_text().startswith(prior))\n        before = self.snapshot()\n        self.assertEqual(process_queue(self.root), [])\n        self.assertEqual(self.snapshot(), before)\n\n    def test_expansion_terminates_on_cycles_and_deduplicates(self):\n        catalog = Catalog({'a': Role('a', '', ('b', 'c')),\n                           'b': Role('b', '', ('a', 'c')), 'c': Role('c', '')})\n        self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Handler status\n\nThe 0.4 gaps are fixed: revocations, transitive role expansion, idempote"]
[77.937413, "i", "nt\nupdates, comma-separated roles, normalized sender checks, held/rejected audit\nentries, and write-free dry runs. Dry runs simulate the queue in order so that\nminimum-holder checks reflect earlier requests without writing any state.\n\n''' + s[end:]\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
