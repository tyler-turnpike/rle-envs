[77.936984, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Regression coverage for queue safety, audit records, and dry-run parity.\"\"\"\nfrom email.message import EmailMessage\n\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\nfrom test_handler import QueueCase, LEAD, message\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes() if p.is_file() else None\n                for p in self.root.rglob('*')}\n\n    def test_grant_audits_only_actual_changes(self):\n        self.enqueue('1', message('AR-101', LEAD, 'grant', 'ana',\n                                  'release-manager, ci-viewer, release-manager'))\n        self.enqueue('2', message('AR-102', LEAD, 'grant', 'ana', 'release-manager'))\n        process_queue(self.root)\n        entries = self.audit()\n        self.assertEqual(len(entries), 3)\n        self.assertEqual({e['role'] for e in entries},\n                         {'release-manager', 'deploy-operator', 'artifact-publisher'})\n   "]
[77.93704, "i", "     for entry in entries:\n            self.assertEqual(entry['result'], 'applied')\n            self.assertEqual(entry['action'], 'grant')\n            self.assertEqual(entry['principal'], 'ana')\n            self.assertEqual(entry['ticket'], 'AR-101')\n            self.assertEqual(entry['actor'], LEAD)\n            self.assertEqual(entry['msg_id'], '<AR-101@example.test>')\n\n    def test_revoke_noop_and_multiple_roles(self):\n        self.enqueue('1', message('AR-103', LEAD, 'revoke', 'bo',\n                                  'billing-reader, ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-104', LEAD, 'revoke', 'bo', 'ci-viewer'))\n        self.enqueue('3', message('AR-105', LEAD, 'revoke', 'absent', 'ci-viewer'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], [])\n        self.assertNotIn('absent', self.acl())\n        self.assertEqual(len(self.audit()), 2)\n        self.assertTrue(all(e['action'] == 'revoke' for e in self.audit()))\n\n    def test_revoke_does_not_remove_implied"]
[77.937312, "i", "_roles(self):\n        self.write_acl({'ana': ['ci-viewer', 'deploy-operator']})\n        self.enqueue('1', message('AR-106', LEAD, 'revoke', 'ana', 'deploy-operator'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n\n    def test_minimum_holders_blocks_whole_request(self):\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-107', LEAD, 'revoke', 'bo',\n                                  'ci-viewer, billing-reader'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'held')\n        self.assertEqual(self.acl()['bo'], ['billing-reader', 'ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertIn('min_holders = 1', self.audit()[0]['reason'])\n\n    def test_unknown_role_rejects_entire_request_and_audits(self):\n        self.enqueue('1', message('AR-108', LEAD, 'grant', 'ana', 'deploy-operator, root'))\n        process_queue(self.root)\n        self.assertEqual(self.ac"]
