[81.808887, "o", "diff -ru '--exclude=__pycache__' /tmp/accessq-before.ziKbE6/accessq/acl.py accessq/acl.py\r\n--- /tmp/accessq-before.ziKbE6/accessq/acl.py\t2026-11-22 14:58:38.000000000 +0000\r\n+++ accessq/acl.py\t2026-11-22 19:18:50.173216710 +0000\r\n@@ -9,10 +9,11 @@\r\n \r\n \r\n class AclStore:\r\n-    def __init__(self, root: Path):\r\n+    def __init__(self, root: Path, *, dry_run: bool = False):\r\n         self.acl_path = Path(root) / \"state\" / \"acl.json\"\r\n         self.audit_path = Path(root) / \"state\" / \"audit.log\"\r\n         self.data: dict = {}\r\n+        self.dry_run = dry_run\r\n \r\n     def load(self) -> \"AclStore\":\r\n         with open(self.acl_path) as fh:\r\n@@ -26,6 +27,8 @@\r\n     def grant(self, principal: str, role: str, *, actor: str, ticket: str,\r\n               msg_id: str) -> bool:\r\n         roles = self.data[\"principals\"].setdefault(principal, [])\r\n+        if role in roles:\r\n+            return False\r\n         roles.append(role)\r\n         roles.sort()\r\n         self.audit(action=\"grant\", principal=principal, role=role, acto"]
