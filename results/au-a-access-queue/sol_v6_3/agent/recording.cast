[95.873641, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Resolved gaps from 0.4\n\nThe handler now supports revocations, transitive and idempotent grants,\ncomma-separated roles, case-insensitive mailbox matching independent of display\nnames, and held/rejected audit records. Dry runs simulate the full queue in\nmemory without saving ACL state, appending audit lines, or moving messages.\nRegression tests also cover minimum-holder protection and multipart requests.\n\n''' + s[end:]\np.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nimport subprocess\n\ndef snapshot():\n    return {str(p): (p.read_bytes(), p.stat().st_mtime_ns)\n            for base in ('queue', 'state', 'policy')\n            for p in Path(base).rglob('*') if p.is_file()}\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert before == snapshot(), 'Dry run modified files!'\n"]
[95.873712, "i", "print('Verified: dry run left all queue, state, and policy files unchanged.')\nPY\n"]
