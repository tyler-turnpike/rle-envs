[129.663531, "i", "python - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nbackup = Path(Path('/tmp/accessq-backup-path').read_text().strip())\nold = (backup / 'state/audit.log').read_bytes()\nnew = Path('state/audit.log').read_bytes()\nassert new.startswith(old)\nentries = [json.loads(line) for line in new[len(old):].splitlines()]\ncounts = {d: len(list((Path('queue') / d).glob('*.eml'))) for d in ('new', 'cur', 'held', 'bounced')}\nassert counts == {'new': 0, 'cur': 4, 'held': 4, 'bounced': 1}\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 4}\nfor original in (backup / 'queue/new').glob('*.eml'):\n    filed = [Path('queue') / d / original.name for d in ('cur', 'held')\n             if (Path('queue') / d / original.name).exists()]\n    assert len(filed) == 1 and filed[0].read_bytes() == original.read_bytes()\nprint('Queue:', counts)\nprint('New audit entries:', dict(Counter(e['result'] for e in entries)))\nprint('Historical audit and filed message contents preserved.')\nPY\n"]
