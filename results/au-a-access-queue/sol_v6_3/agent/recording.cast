[129.668032, "o", "for original in (backup / 'queue/new').glob('*.eml'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.668134, "o", "    filed = [Path('queue') / d / original.name for d in ('cur', 'held')\r\n\u001b[?2004l\r"]
[129.668198, "o", "\u001b[?2004h"]
[129.668276, "o", "> "]
[129.668385, "o", "             if (Path('queue') / d / original.name).exists()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.668678, "o", "    assert len(filed) == 1 and filed[0].read_bytes() == original.read_bytes()\r\n\u001b[?2004l\r"]
[129.66875, "o", "\u001b[?2004h> "]
[129.668896, "o", "print('Queue:', counts)\r\n\u001b[?2004l\r"]
[129.668937, "o", "\u001b[?2004h> "]
[129.669147, "o", "print('New audit entries:', dict(Counter(e['result'] for e in entries)))\r\n\u001b[?2004l\r"]
[129.669184, "o", "\u001b[?2004h> "]
[129.669257, "o", "print('Historical audit and filed message contents preserved.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.669301, "o", "> PY\r\n\u001b[?2004l\r"]
[129.694976, "o", "Queue: {'new': 0, 'cur': 4, 'held': 4, 'bounced': 1}\r\nNew audit entries: {'applied': 8, 'held': 4}\r\nHistorical audit and filed message contents preserved.\r\n"]
