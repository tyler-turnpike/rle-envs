[89.44541, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Regression coverage for queue safety and the completed 0.4 gaps.\"\"\"\nimport unittest\n\nfrom test_handler import LEAD, QueueCase, message\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes()\n                for p in self.root.rglob('*') if p.is_file()}\n\n    def test_minimum_holders_holds_entire_request(self):\n        self.write_acl({'ana': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-11', LEAD, 'revoke', 'ana',\n                                  'ci-viewer, billing-reader'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'held')\n        self.assertEqual(self.acl()['ana'], ['billing-reader', 'ci-viewer'])\n        self.assertIn('min_holders = 1', self.audit()[0]['reason'])\n        self.assertEqual(len(self.audit()), 1)\n\n    def test_dry_run_simulates_order_"]
[89.445669, "i", "and_writes_nothing(self):\n        self.write_acl({'ana': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-12', LEAD, 'grant', 'bo', 'billing-reader'))\n        self.enqueue('2', message('AR-13', LEAD, 'revoke', 'ana', 'billing-reader'))\n        self.enqueue('3', message('AR-14', 'other@example.test', 'grant', 'cy', 'admin'))\n        self.enqueue('4', message('AR-15', LEAD, 'grant', 'cy', 'unknown-role'))\n        self.enqueue('5', message('AR-16', LEAD, 'bogus', 'cy', 'ci-viewer'))\n        before = self.snapshot()\n        preview = process_queue(self.root, dry_run=True)\n        self.assertEqual(self.snapshot(), before)\n        self.assertEqual([o.status for o in preview],\n                         ['applied', 'applied', 'held', 'rejected', 'rejected'])\n        self.assertEqual(preview, process_queue(self.root))\n\n    def test_noop_grants_and_revokes_have_no_applied_audit(self):\n        self.enqueue('1', message('AR-17', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2'"]
