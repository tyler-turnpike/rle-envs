[95.969609, "i", "python - <<'PY'\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): p.read_bytes()\n            for directory in ('policy', 'state', 'queue')\n            for p in (root / directory).rglob('*') if p.is_file()}\nbefore = snapshot()\nfor o in process_queue(root, dry_run=True):\n    print(f'{o.status:9} {o.ticket:8} {o.detail}')\nassert snapshot() == before, 'Dry run changed files!'\nprint('Verified: dry run changed no policy, state, or queue files.')\nPY\ncat accessq/acl.py accessq/handler.py\n"]
[95.970301, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> root = Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p.relative_to(root)): p.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h>             for directory in ('policy', 'state', 'queue')\r\n\u001b[?2004l\r\u001b[?2004h>             for p in (root / directory).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> for o in process_queue(root, dry_run=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.970596, "o", "    print(f'{o.status:9} {o.ticket:8} {o.detail}')\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before, 'Dry run changed files!'\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: dry run changed no policy, state, or queue files.')\r\n\u001b[?2004l\r"]
