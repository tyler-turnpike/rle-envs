[129.84046, "o", "\r\n----------------------------------------------------------------------\r\nRan 19 tests in 0.080s\r\n\r\nOK\r\n"]
[129.852518, "o", "\u001b[?2004hroot@2a6076c7699f:/app# "]
[129.852544, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[129.852734, "o", "\u001b[?2004h> "]
[129.852754, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.852905, "o", "root = Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p.relative_to(root)): p.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h>             for d in ('queue', 'state', 'policy')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.852957, "o", "            for p in (root / d).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.853008, "o", "before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.853044, "o", "assert process_queue(root) == []"]
[129.8531, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.853231, "o", "print('Final verification: empty queue is a no-op; state, audit, policy and messages unchanged.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[129.901741, "o", "Final verification: empty queue is a no-op; state, audit, policy and messages unchanged.\r\n"]
[129.910549, "o", "\u001b[?2004hroot@2a6076c7699f:/app# "]
