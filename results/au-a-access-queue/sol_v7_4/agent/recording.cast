[116.889436, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nroot = Path('/app')\nacl_path = root / 'state/acl.json'\naudit_path = root / 'state/audit.log'\nbefore = json.loads(acl_path.read_text())['principals']\naudit_before = audit_path.read_bytes()\nbounced_before = {p.name: p.read_bytes() for p in (root / 'queue/bounced').iterdir() if p.is_file()}\npreview = process_queue(root, dry_run=True)\nassert audit_path.read_bytes() == audit_before\nassert json.loads(acl_path.read_text())['principals'] == before\noutcomes = process_queue(root)\nassert outcomes == preview\nfor o in outcomes:\n    print(f'{o.status:9} {o.ticket:8} {o.detail}')\nexpected = {p: list(roles) for p, roles in before.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert json.loads(acl_path.rea"]
[116.889595, "i", "d_text())['principals'] == expected\nassert not list((root / 'queue/new').glob('*.eml'))\nfor o in outcomes:\n    destination = 'cur' if o.status == 'applied' else 'held'\n    assert (root / 'queue' / destination / o.name).exists()\naudit_after = audit_path.read_bytes()\nassert audit_after.startswith(audit_before)\nentries = [json.loads(line) for line in audit_after[len(audit_before):].splitlines()]\nassert len(entries) == 13\nassert sum(e['result'] == 'applied' for e in entries) == 8\nassert sum(e['result'] == 'held' for e in entries) == 5\nassert {e['ticket'] for e in entries if e['result'] == 'applied'} == {'AR-2201', 'AR-2204', 'AR-2206', 'AR-2208'}\nassert {p.name: p.read_bytes() for p in (root / 'queue/bounced').iterdir() if p.is_file()} == bounced_before\nassert 'admin' not in expected['svc-release-bot']\nprint('Verified: 4 applied messages, 5 held, 8 role changes, 13 appended audit records; bounced mail unchanged.')\nPY\n"]
