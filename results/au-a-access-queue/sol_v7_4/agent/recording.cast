[89.445891, "i", "et'].startswith('AR-'))\n            self.assertTrue(event['msg_id'])\n            self.assertTrue(event['reason'])\n\n    def test_forwarded_approval_does_not_delegate_sender(self):\n        body = message('AR-23', 'other@example.test', 'grant', 'ana', 'admin')\n        body += '\\nApproved by Team Lead <' + LEAD + '>\\n'\n        self.enqueue('1', body)\n        self.assertEqual(process_queue(self.root)[0].status, 'held')\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_explicit_dmarc_failure_is_held(self):\n        body = message('AR-24', LEAD, 'grant', 'ana', 'admin')\n        body = 'Authentication-Results: mx.example.test; spf=fail; dmarc=fail header.from=example.test\\n' + body\n        self.enqueue('1', body)\n        self.assertEqual(process_queue(self.root)[0].status, 'held')\n        self.assertIn('DMARC', self.audit()[0]['reason'])\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_multiple_sender_addresses_are_rejected(self):\n        self.enqueue('1', message('AR-25', f'{LEAD}, "]
[89.445926, "i", "other@example.test',\n                                  'grant', 'ana', 'admin'))\n        self.assertEqual(process_queue(self.root)[0].status, 'rejected')\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_signature_and_quoted_fields_are_not_additional_requests(self):\n        body = message('AR-26', LEAD, 'grant', 'ana', 'artifact-publisher')\n        body += '\\nPrincipal: service-bot\\nRoles: admin\\n> Action: grant\\n'\n        self.enqueue('1', body)\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['artifact-publisher', 'ci-viewer'])\n        self.assertNotIn('service-bot', self.acl())\n        self.assertEqual(len(self.audit()), 1)\n\n    def test_multipart_and_mixed_case_sender(self):\n        body = ('From: \"Lead, Team\" <LEAD@EXAMPLE.TEST>\\n'\n                'Subject: [AR-27] request\\nMessage-ID: <AR-27@example.test>\\n'\n                'MIME-Version: 1.0\\nContent-Type: multipart/alternative; boundary=\"parts\"\\n\\n'\n                '--parts\\nContent-Type: text/plain; chars"]
[89.445945, "i", "et=utf-8\\n\\n'\n                'Action: revoke\\nPrincipal: ana\\nRoles: ci-viewer, deploy-operator\\n\\n'\n                '--parts\\nContent-Type: text/html\\n\\n<p>Roles: admin</p>\\n--parts--\\n')\n        self.enqueue('1', body)\n        self.assertEqual(process_queue(self.root)[0].status, 'applied')\n        self.assertEqual(self.acl()['ana'], [])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['actor'], LEAD)\n\n    def test_expansion_handles_cycles_and_shared_dependencies(self):\n        catalog = Catalog({'a': Role('a', '', ('b', 'c')),\n                           'b': Role('b', '', ('c',)),\n                           'c': Role('c', '', ('a',))})\n        self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text().replace('- Sender not delegated:', '- An explicit DMARC failure in the mail drop\\'s `Authentication-Results`\\n  holds the message for m"]
[89.445961, "i", "anual sender verification, even if From is delegated.\\n  These headers must be supplied by a trusted inbound mail drop.\\n- Sender not delegated:')\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Handler completion\n\nRevocations, transitive implied roles (including cycles), idempotent grants,\ncomma-separated role lists, normalized sender matching, held/rejected auditing,\nand write-free dry runs are implemented and covered by tests. Dry runs simulate\nrequests in queue order, including minimum-holder checks, without persisting\nany changes. Malformed messages retain available ticket/sender metadata in the\naudit log; unavailable metadata uses `?` for ticket and empty strings otherwise.\n\n''' + s[end:]\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
