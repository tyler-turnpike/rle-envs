[73.355756, "i", "       if m:\n            fields.setdefault(m.group(1).lower(), m.group(2).strip())\n    return fields\n\n\ndef _auth_failure(msg) -> str:\n    # Only use the local receiving gateway's result, not a sender's assertion\n    # or a quoted message body. Missing results are compatible with local mail.\n    for value in msg.get_all(\"Authentication-Results\", []):\n        authority, _, results = str(value).partition(\";\")\n        if authority.strip().lower() != \"mx.fernhollow.dev\":\n            continue\n        if re.search(r\"(?:^|;)\\s*dmarc\\s*=\\s*fail\\b\", results, re.IGNORECASE):\n            return \"sender authentication failed: receiving gateway reports dmarc=fail\"\n    return \"\"\n\n\ndef parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    from_headers ="]
