[104.369812, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Regression coverage for audit, dry-run, parsing and approval boundaries.\"\"\"\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def test_repeated_grants_audit_only_actual_additions(self):\n        self.enqueue('1', message('AR-11', LEAD, 'grant', 'ana', 'release-manager, ci-viewer'))\n        self.enqueue('2', message('AR-12', LEAD, 'grant', 'ana', 'release-manager'))\n        process_queue(self.root)\n        self.assertEqual(len(self.audit()), 3)\n        self.assertEqual({e['role'] for e in self.audit()},\n                         {'artifact-publisher', 'deploy-operator', 'release-manager'})\n        self.assertTrue(all(e['ticket'] == 'AR-11' and e['actor'] == LEAD\n                            and e['msg_id'] == '<AR-11@example.test>'\n                            and e['result'] == 'applied' for e in self.audit()))\n\n    def test_missing_revoke_is_noop_wit"]
[104.369853, "i", "hout_audit_or_new_principal(self):\n        self.enqueue('1', message('AR-13', LEAD, 'revoke', 'missing', 'ci-viewer'))\n        result = process_queue(self.root)\n        self.assertEqual(result[0].status, 'applied')\n        self.assertNotIn('missing', self.acl())\n        self.assertEqual(self.audit(), [])\n\n    def test_min_holders_blocks_entire_multirole_revoke(self):\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-14', LEAD, 'revoke', 'bo', 'ci-viewer, billing-reader'))\n        result = process_queue(self.root)\n        self.assertEqual(result[0].status, 'held')\n        self.assertIn('min_holders = 1', result[0].detail)\n        self.assertEqual(self.acl()['bo'], ['billing-reader', 'ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'held')\n\n    def test_min_holders_uses_changes_from_prior_requests(self):\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer'], 'ana': []})\n        self.enqueu"]
[104.369858, "i", "e('1', message('AR-15', LEAD, 'grant', 'ana', 'billing-reader'))\n        self.enqueue('2', message('AR-16', LEAD, 'revoke', 'bo', 'billing-reader'))\n        result = process_queue(self.root)\n        self.assertEqual([o.status for o in result], ['applied', 'applied'])\n        self.assertEqual(self.acl()['bo'], ['ci-viewer'])\n        self.assertEqual(len(self.audit()), 2)\n\n    def test_unknown_role_rejects_whole_request_and_audits(self):\n        self.enqueue('1', message('AR-17', LEAD, 'grant', 'ana', 'billing-reader, root'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'rejected')\n        self.assertIn('root', self.audit()[0]['reason'])\n\n    def test_malformed_body_audit_retains_message_identity(self):\n        self.enqueue('1', message('AR-18', LEAD, 'invalid', 'ana', 'ci-viewer'))\n        process_queue(self.root)\n        entry, = self.audit()\n        self.assertEqua"]
