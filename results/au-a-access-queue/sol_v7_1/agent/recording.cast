[121.959314, "i", "python - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nbefore = {name: bytes.fromhex(data) for name, data in json.loads(Path('/tmp/accessq-before.json').read_text()).items()}\nold_acl = json.loads(before['state/acl.json'])['principals']\nexpected = {p: set(roles) for p, roles in old_acl.items()}\nexpected['priya.raman'].add('deploy-operator')\nexpected['deniz.kaya'] = {'release-manager', 'deploy-operator', 'artifact-publisher', 'ci-viewer'}\nexpected['svc-legacy-ci'] = set()\nexpected['alice.ng'].add('artifact-publisher')\nactual = json.loads(Path('state/acl.json').read_text())['principals']\nassert actual == {p: sorted(roles) for p, roles in expected.items()}, actual\nassert not list(Path('queue/new').iterdir())\npreview = json.loads(Path('/tmp/accessq-preview.json').read_text())\nfor outcome in preview:\n    dest = 'cur' if outcome['status'] == 'applied' else 'held'\n    name = outcome['name']\n    assert Path('queue', dest, name).read_bytes() == before['queue/new/' + name]\nfor name, content"]
[121.959358, "i", "s in before.items():\n    if name.startswith('queue/bounced/'):\n        assert Path(name).read_bytes() == contents\nold_log = before['state/audit.log']\nlog = Path('state/audit.log').read_bytes()\nassert log.startswith(old_log), 'Existing audit log was modified'\nentries = [json.loads(line) for line in log[len(old_log):].splitlines()]\nassert len(entries) == 13\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 5}\nassert Counter(e['ticket'] for e in entries) == {'AR-2201': 1, 'AR-2202': 1, 'AR-2203': 1, 'AR-2204': 4, 'AR-2205': 1, 'AR-2206': 2, 'AR-2207': 1, 'AR-2208': 1, 'AR-2209': 1}\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\nassert all(e.get('reason') for e in entries if e['result'] == 'held')\nprint('Verified: exact ACL changes; 4 applied messages, 5 held, queue/new empty.')\nprint('Verified: 8 role-change audit entries, 5 hold entries; old log and bounced mail unchanged.')\nPY\n"]
