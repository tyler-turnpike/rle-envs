[105.363417, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom accessq.handler import process_queue\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): p.read_bytes().hex()\n            for d in ('queue', 'state') for p in (root / d).rglob('*') if p.is_file()}\nbefore = snapshot()\nPath('/tmp/accessq-before.json').write_text(json.dumps(before))\noutcomes = process_queue(root, dry_run=True)\nassert snapshot() == before, 'Dry run changed live files'\nPath('/tmp/accessq-preview.json').write_text(json.dumps([vars(o) for o in outcomes]))\nfor o in outcomes:\n    print(f'{o.status:9} {o.ticket}: {o.detail}')\nprint('Verified: live dry run made no file changes.')\nPY\n"]
[105.363653, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[105.364133, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path"]
[105.364657, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> root = Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p.relative_to(root)): p.read_bytes().hex()\r\n\u001b[?2004l\r\u001b[?2004h>             for d in ('queue', 'state') for p in (root / d).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> Path('/tmp/accessq-before.json').write_text(json.dumps(before))\r\n\u001b[?2004l\r\u001b[?2004h> outcomes = process_queue(root, dry_run=True)\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before, 'Dry run changed live files'\r\n\u001b[?2004l\r\u001b[?2004h> Path('/tmp/accessq-preview.json').write_text(json.dumps([vars(o) for o in outcomes]))\r\n\u001b[?2004l\r\u001b[?2004h> for o in outcomes:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{o.status:9} {o.ticket}: {o.detail}')\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: live dry run made no file changes.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
