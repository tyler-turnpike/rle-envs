[73.354248, "i", "cat > accessq/mailparse.py <<'PY'\n\"\"\"Parse the first access-request field block in an RFC 822 message.\n\nAnything after a ``-- `` signature separator is ignored. Sender display names\nare not identities; requests carry the normalized mailbox address instead.\n\"\"\"\nfrom __future__ import annotations\n\nimport email\nimport re\nfrom dataclasses import dataclass\nfrom email import policy as email_policy\nfrom email.utils import getaddresses\nfrom pathlib import Path\n\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\nACTIONS = (\"grant\", \"revoke\")\n\n\nclass ParseError(ValueError):\n    \"\"\"An invalid request, retaining available metadata for the audit log.\"\"\"\n\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.ticket = \"?\"\n        self.msg_id = \"\"\n        self.actor = \"\"\n\n\ndef sender_address(value: str) -> str:\n    \"\"\"Return one unambiguous mailbox, or an empty string for an invalid sender.\"\"\"\n    addresses = getaddresses([value])\n    if len(addresses) !"]
[73.354668, "o", "cat > accessq/mailparse.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Parse the first access-request field block in an RFC 822 message."]
[73.354697, "i", "= 1:\n        return \"\"\n    address = addresses[0][1].strip().lower()\n    if address.count(\"@\") != 1 or any(c.isspace() for c in address):\n        return \"\"\n    local, domain = address.split(\"@\")\n    return address if local and domain else \"\"\n\n\n@dataclass\nclass Request:\n    path: Path\n    msg_id: str\n    ticket: str\n    sender: str\n    action: str\n    principal: str\n    roles: list[str]\n    justification: str = \"\"\n    auth_failure: str = \"\"\n\n\ndef _plain_body(msg) -> str:\n    part = msg.get_body(preferencelist=(\"plain\",))\n    if part is None or part.get_content_type() != \"text/plain\":\n        raise ParseError(\"no text/plain part\")\n    try:\n        return part.get_content()\n    except (LookupError, UnicodeError, ValueError) as exc:\n        raise ParseError(f\"cannot decode text/plain body: {exc}\") from exc\n\n\ndef parse_fields(text: str) -> dict[str, str]:\n    fields: dict[str, str] = {}\n    for line in text.splitlines():\n        if line.rstrip() == \"--\":\n            break\n        m = FIELD_RE.match(line.strip())\n "]
