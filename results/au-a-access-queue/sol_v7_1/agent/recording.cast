[136.958451, "o", "\u001b[?2004hroot@6240b0870945:/app# python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[136.958479, "o", "\u001b[?2004h> "]
[136.958735, "o", "from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> paths = [Path('state/acl.json'), Path('state/audit.log')]\r\n\u001b[?2004l\r\u001b[?2004h> before = [p.read_bytes() for p in paths]\r\n\u001b[?2004l\r\u001b[?2004h> assert process_queue(Path('/app')) == []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.960509, "o", "assert [p.read_bytes() for p in paths] == before\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.960566, "o", "print('Verified: empty-queue rerun makes no state or audit changes.')\r\n\u001b[?2004l\r\u001b[?2004h> for folder in ('new', 'cur', 'held', 'bounced'):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'queue/{folder}: {len(list(Path(\"queue\", folder).glob(\"*.eml\")))} messages')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[137.007001, "o", "Verified: empty-queue rerun makes no state or audit changes.\r\nqueue/new: 0 messages\r\n"]
[137.007144, "o", "queue/cur: 4 messages\r\n"]
[137.007208, "o", "queue/held: 5 messages\r\n"]
[137.007259, "o", "queue/bounced: 1 messages\r\n"]
[137.016043, "o", "\u001b[?2004hroot@6240b0870945:/app# "]
