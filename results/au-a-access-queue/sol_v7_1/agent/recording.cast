[73.365476, "o", "    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\r\n\u001b[?2004l\r\u001b[?2004h>     from_headers = msg.get_all(\"From\", [])\r\n\u001b[?2004l\r\u001b[?2004h>     sender = sender_address(str(from_headers[0])) if len(from_headers) == 1 else \"\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         if not match:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ParseError(f\"no ticket id in subject {subject!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>         if not sender:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ParseError(\"missing or ambiguous From address\")\r\n\u001b[?2004l\r\u001b[?2004h>         fields = parse_fields(_plain_body(msg))\r\n\u001b[?2004l\r\u001b[?2004h>         action = fields.get(\"action\", \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h>         if action not in ACTIONS:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ParseError(f\"unsupported action {action!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>         principal = fields.get(\"principal\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>         if not principal:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ParseError(\"missing Principal\")\r\n\u001b[?2004l\r\u001b[?2004h>         if not fields.get(\"roles\"):\r\n"]
