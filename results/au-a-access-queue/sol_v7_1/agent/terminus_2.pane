    def test_dry_run_simulates_prior_grants_for_min_holders(self):
        self.write_acl({'bo': ['billing-reader'], 'ana': []})
        self.enqueue('1', message('AR-29', LEAD, 'grant', 'ana', 'billing-reader'))
        self.enqueue('2', message('AR-30', LEAD, 'revoke', 'bo', 'billing-reader'))
        before = self.acl()
        preview = process_queue(self.root, dry_run=True)
        self.assertEqual([o.status for o in preview], ['applied', 'applied'])
        self.assertEqual(self.acl(), before)
        self.assertEqual(self.audit(), [])

    def test_expansion_handles_cycles_and_shared_dependencies(self):
        catalog = Catalog({'a': Role('a', '', ('b', 'c')),
                           'b': Role('b', '', ('a', 'c')), 'c': Role('c', '')})
        expanded = catalog.expand(['a', 'b'])
        self.assertEqual(set(expanded), {'a', 'b', 'c'})
        self.assertEqual(len(expanded), 3)
