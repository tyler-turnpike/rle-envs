[14.654466, "o", "\"\"\"Daily revenue ledger built from the orders receipt export (analytics team).\r\n\r\nThe ledger feeds finance's month-end close, so every figure must be exact to the cent.\r\n\"\"\"\r\nfrom collections import defaultdict\r\nfrom decimal import Decimal\r\n\r\nimport fastjson\r\n\r\n\r\ndef read_receipts(text):\r\n    \"\"\"Receipts export: one JSON receipt per line, each with a `day` field added by the exporter.\"\"\"\r\n    rows = []\r\n    for raw in text.splitlines():\r\n        if raw.strip():\r\n            rows.append(fastjson.loads(raw))\r\n    return rows\r\n\r\n\r\ndef _amount(value):\r\n    if isinstance(value, Decimal):\r\n        return value\r\n    if isinstance(value, str):\r\n        return Decimal(value)\r\n    return Decimal(repr(value))\r\n\r\n\r\ndef daily_ledger(text):\r\n    days = defaultdict(lambda: {\"orders\": 0, \"revenue\": Decimal(\"0\"), \"tax\": Decimal(\"0\")})\r\n    for row in read_receipts(text):\r\n        day = days[row[\"day\"]]\r\n        day[\"orders\"] += 1\r\n        day[\"revenue\"] += _amount(row[\"total\"])\r\n        day[\"tax\"] += _amount(row[\"tax\"])\r\n    "]
[14.654655, "o", "return {d: days[d] for d in sorted(days)}\r\n\r\n\r\ndef average_ticket(text):\r\n    rows = read_receipts(text)\r\n    if not rows:\r\n        return Decimal(\"0\")\r\n    total = sum((_amount(r[\"total\"]) for r in rows), Decimal(\"0\"))\r\n    return (total / len(rows)).quantize(Decimal(\"0.01\"))\r\n\r\n\r\ndef ledger_json(text):\r\n    return fastjson.dumps(daily_ledger(text), sort_keys=True, indent=2)\r\nimport unittest\r\nfrom decimal import Decimal\r\n\r\nfrom reports.ledger import average_ticket, daily_ledger, ledger_json\r\n\r\nEXPORT = \"\\n\".join([\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-1\", \"total\": 0.10, \"tax\": 0.02}',\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-2\", \"total\": 0.20, \"tax\": 0.01}',\r\n    '{\"day\": \"2026-11-21\", \"order_id\": \"o-3\", \"total\": 1999.99, \"tax\": 130.84}',\r\n])\r\n\r\n\r\nclass LedgerTest(unittest.TestCase):\r\n    def test_daily_totals_are_exact(self):\r\n        ledger = daily_ledger(EXPORT)\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"revenue\"], Decimal(\"0.30\"))\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"tax\"], Decimal"]
[14.654794, "o", "(\"0.03\"))\r\n        self.assertEqual(ledger[\"2026-11-21\"][\"orders\"], 1)\r\n\r\n    def test_average_ticket(self):\r\n        self.assertEqual(average_ticket(EXPORT), Decimal(\"666.76\"))\r\n\r\n    def test_ledger_json_keeps_cents(self):\r\n        self.assertIn('\"revenue\": \"0.30\"', ledger_json(EXPORT))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"]
[14.655921, "o", "\"\"\"fastjson 1.4 - JSON with money-safe defaults.\r\n\r\n    loads(text, parse_float=Decimal)   numbers with a fraction decode as Decimal\r\n    dumps(obj, sort_keys=False, indent=None)\r\n                                       Decimal values are written as strings (\"12.30\")\r\n    JSONError                          raised for malformed input\r\n\"\"\"\r\nimport json\r\nfrom decimal import Decimal\r\n\r\nVERSION = \"1.4.2\"\r\n\r\n\r\nclass JSONError(ValueError):\r\n    pass\r\n\r\n\r\ndef loads(text, parse_float=Decimal):\r\n    try:\r\n        return json.loads(text, parse_float=parse_float)\r\n    except json.JSONDecodeError as exc:\r\n        raise JSONError(f\"{exc.msg} at line {exc.lineno} column {exc.colno}\") from None\r\n\r\n\r\ndef _default(value):\r\n    if isinstance(value, Decimal):\r\n        return str(value)\r\n    raise TypeError(f\"fastjson cannot encode {type(value).__name__}\")\r\n\r\n\r\ndef dumps(obj, sort_keys=False, indent=None):\r\n    return json.dumps(obj, sort_keys=sort_keys, indent=indent, default=_default)\r\n"]
[14.658419, "o", "\r\n\r\ndef vtuple(text):\r\n    return tuple(int(p) for p in text.split(\".\"))\r\n\r\n\r\ndef workspace():\r\n    cfg = tomllib.loads((ROOT / \"mono.toml\").read_text())\r\n    return cfg[\"workspace\"][\"members\"], ROOT / cfg.get(\"index\", {}).get(\"path\", \"vendor\")\r\n\r\n\r\ndef member_deps(member):\r\n    project = tomllib.loads((ROOT / member / \"pyproject.toml\").read_text())[\"project\"]\r\n    deps = {}\r\n    for raw in project.get(\"dependencies\", []):\r\n        name, rest = SPEC.match(raw).groups()\r\n        deps[name] = [OP.match(c.strip()).groups() for c in rest.split(\",\") if c.strip()]\r\n    return project[\"name\"], deps\r\n\r\n\r\ndef available(index, name):\r\n    return sorted((vtuple(p.name[len(name) + 1:]) for p in index.glob(f\"{name}-*\") if p.is_dir()), reverse=True)\r\n\r\n\r\ndef satisfies(version, constraints):\r\n    checks = {\">=\": lambda a, b: a >= b, \"<=\": lambda a, b: a <= b, \"==\": lambda a, b: a == b,\r\n              \"<\": lambda a, b: a < b, \">\": lambda a, b: a > b}\r\n    return all(checks[op](version, vtuple(v)) for op, v in constraints)\r\n\r"]
[14.658547, "o", "\n\r\ndef owners(path):\r\n    found = []\r\n    for line in (ROOT / \"CODEOWNERS\").read_text().splitlines():\r\n        if line.strip() and not line.startswith(\"#\"):\r\n            pattern, *who = line.split()\r\n            if str(path).startswith(pattern.strip(\"/\")):\r\n                found = who\r\n    return found\r\n\r\n\r\ndef resolve():\r\n    members, index = workspace()\r\n    wanted = {}\r\n    for member in members:\r\n        name, deps = member_deps(member)\r\n        for dep, constraints in deps.items():\r\n            wanted.setdefault(dep, []).append((member, name, constraints))\r\n    locked, conflicts = {}, []\r\n    for dep, users in sorted(wanted.items()):\r\n        options = [v for v in available(index, dep) if all(satisfies(v, c) for _, _, c in users)]\r\n        if options:\r\n            locked[dep] = \".\".join(map(str, options[0]))\r\n            continue\r\n        lines = [f\"  {name} ({member}/pyproject.toml, owners: {' '.join(owners(member)) or '-'}) requires \"\r\n                 + \",\".join(op + v for op, v in c) for member, name"]
[14.659763, "o", ", c in users]\r\n        conflicts.append(f\"resolution conflict: no vendored {dep} satisfies every member\\n\" + \"\\n\".join(lines))\r\n    return locked, conflicts\r\n\r\n\r\ndef read_lock():\r\n    lock = ROOT / \"mono.lock\"\r\n    return tomllib.loads(lock.read_text()).get(\"resolved\", {}) if lock.exists() else {}\r\n\r\n\r\ndef cmd_check(args):\r\n    locked, conflicts = resolve()\r\n    if conflicts:\r\n        print(\"\\n\".join(conflicts), file=sys.stderr)\r\n        print(\"mono.lock left unchanged\", file=sys.stderr)\r\n        return 1\r\n    body = \"\".join(f'{dep} = \"{ver}\"\\n' for dep, ver in sorted(locked.items()))\r\n\u001b[?2004hroot@478b2cd8019e:/app# "]
