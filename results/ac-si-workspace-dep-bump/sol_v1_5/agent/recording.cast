[18.791816, "o", "\"\"\"fastjson 1.4 - JSON with money-safe defaults.\r\n\r\n    loads(text, parse_float=Decimal)   numbers with a fraction decode as Decimal\r\n    dumps(obj, sort_keys=False, indent=None)\r\n                                       Decimal values are written as strings (\"12.30\")\r\n    JSONError                          raised for malformed input\r\n\"\"\"\r\nimport json\r\nfrom decimal import Decimal\r\n\r\nVERSION = \"1.4.2\"\r\n\r\n\r\nclass JSONError(ValueError):\r\n    pass\r\n\r\n\r\ndef loads(text, parse_float=Decimal):\r\n    try:\r\n        return json.loads(text, parse_float=parse_float)\r\n    except json.JSONDecodeError as exc:\r\n        raise JSONError(f\"{exc.msg} at line {exc.lineno} column {exc.colno}\") from None\r\n\r\n\r\ndef _default(value):\r\n    if isinstance(value, Decimal):\r\n        return str(value)\r\n    raise TypeError(f\"fastjson cannot encode {type(value).__name__}\")\r\n\r\n\r\ndef dumps(obj, sort_keys=False, indent=None):\r\n    return json.dumps(obj, sort_keys=sort_keys, indent=indent, default=_default)\r\n"]
[18.792224, "o", "bash: git: command not found\r\n\u001b[?2004hroot@87ebf289869f:/app# "]
[45.113196, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor member in ('orders', 'reports'):\n    path = Path(f'packages/{member}/pyproject.toml')\n    path.write_text(path.read_text().replace('fastjson>=1.4,<2', 'fastjson>=2.1,<3'))\npath = Path('packages/orders/orders/codec.py')\ntext = path.read_text().replace('fastjson.loads(text)', 'fastjson.decode(text, number_mode=\"decimal\")')\ntext = text.replace('fastjson.JSONError', 'fastjson.DecodeError')\ntext = text.replace('fastjson.dumps(receipt, sort_keys=True)', 'fastjson.encode(receipt, key_order=\"sorted\", decimal_as=\"string\")')\npath.write_text(text)\npath = Path('packages/reports/reports/ledger.py')\ntext = path.read_text().replace('fastjson.loads(raw)', 'fastjson.decode(raw, number_mode=\"decimal\")')\ntext = text.replace('fastjson.dumps(daily_ledger(text), sort_keys=True, indent=2)', 'fastjson.encode(daily_ledger(text), key_order=\"sorted\", indent=2, decimal_as=\"string\")')\npath.write_text(text)\nPY\n"]
