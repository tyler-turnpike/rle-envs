"""Order JSON codec: incoming order documents and the receipts we store.

Amounts are exact (Decimal) end to end; receipts are canonical JSON (sorted keys,
amounts written as strings) because finance diffs them across releases.
"""
from decimal import Decimal

import fastjson

REQUIRED = ("order_id", "currency", "lines")
LINE_FIELDS = ("sku", "qty", "unit_price")


class OrderError(ValueError):
    """The document is not a valid order."""


def parse_order(text):
    try:
        doc = fastjson.decode(text, number_mode="decimal")
    except fastjson.DecodeError as exc:
        raise OrderError(f"malformed order JSON: {exc}") from None
    if not isinstance(doc, dict):
        raise OrderError("order must be a JSON object")
    missing = [k for k in REQUIRED if k not in doc]
    if missing:
        raise OrderError(f"order missing {', '.join(missing)}")
    lines = []
    for i, line in enumerate(doc["lines"]):
        if not isinstance(line, dict) or any(k not in line for k in LINE_FIELDS):
            raise OrderError(f"line {i} needs {', '.join(LINE_FIELDS)}")
        price = line["unit_price"]
        if not isinstance(price, Decimal):
            price = Decimal(str(price))
        lines.append({"sku": str(line["sku"]), "qty": int(line["qty"]), "unit_price": price,
                      "tax_rate": Decimal(str(line.get("tax_rate", "0")))})
    discount = doc.get("discount", Decimal("0"))
    return {"order_id": str(doc["order_id"]), "currency": str(doc["currency"]).upper(),
            "lines": lines, "discount": Decimal(str(discount))}


def parse_batch(text):
    """Parse a JSON-lines export; returns (orders, errors) so one bad line does not stop a batch."""
    orders, errors = [], []
    for n, raw in enumerate(text.splitlines(), 1):
        if not raw.strip():
            continue
        try:
            orders.append(parse_order(raw))
        except OrderError as exc:
            errors.append(f"line {n}: {exc}")
    return orders, errors


def dump_receipt(receipt):
    return fastjson.encode(receipt, key_order="sorted", decimal_as="string")


def load_receipt(text):
    try:
        return fastjson.decode(text, number_mode="decimal")
    except fastjson.DecodeError as exc:
        raise OrderError(f"malformed receipt: {exc}") from None
"""Daily revenue ledger built from the orders receipt export (analytics team).

The ledger feeds finance's month-end close, so every figure must be exact to the cent.
"""
from collections import defaultdict
from decimal import Decimal

import fastjson


def read_receipts(text):
    """Receipts export: one JSON receipt per line, each with a `day` field added by the exporter."""
    rows = []
    for raw in text.splitlines():
        if raw.strip():
            rows.append(fastjson.decode(raw, number_mode="decimal"))
    return rows


def _amount(value):
    if isinstance(value, Decimal):
        return value
    if isinstance(value, str):
        return Decimal(value)
    return Decimal(repr(value))


def daily_ledger(text):
    days = defaultdict(lambda: {"orders": 0, "revenue": Decimal("0"), "tax": Decimal("0")})
    for row in read_receipts(text):
        day = days[row["day"]]
        day["orders"] += 1
        day["revenue"] += _amount(row["total"])
        day["tax"] += _amount(row["tax"])
    return {d: days[d] for d in sorted(days)}


def average_ticket(text):
    rows = read_receipts(text)
    if not rows:
        return Decimal("0")
    total = sum((_amount(r["total"]) for r in rows), Decimal("0"))
    return (total / len(rows)).quantize(Decimal("0.01"))


def ledger_json(text):
    return fastjson.encode(daily_ledger(text), key_order="sorted", indent=2, decimal_as="string")
import tempfile
import unittest
from decimal import Decimal

import fastjson
from orders.codec import OrderError, dump_receipt, load_receipt, parse_batch, parse_order
from orders.service import price_order, receipt_for, reload_total, store_receipts, summarize_batch

ORDER = ('{"order_id": "o-100", "currency": "eur", "discount": 1.10, "lines": ['
         '{"sku": "A", "qty": 3, "unit_price": 0.10, "tax_rate": 0.20},'
         '{"sku": "B", "qty": 1, "unit_price": 19.99, "tax_rate": 0.07}]}')


class CodecTest(unittest.TestCase):
    def test_amounts_are_exact(self):
        order = parse_order(ORDER)
        self.assertEqual(order["lines"][0]["unit_price"], Decimal("0.10"))
        self.assertIsInstance(order["discount"], Decimal)
        self.assertEqual(order["currency"], "EUR")

    def test_malformed_raises_order_error(self):
        with self.assertRaises(OrderError):
            parse_order('{"order_id": "o-1", "currency": "EUR", "lines": [')
        with self.assertRaises(OrderError):
            parse_order('{"order_id": "o-1"}')

    def test_receipt_is_canonical(self):
        receipt = {"total": Decimal("21.69"), "order_id": "o-100"}
        self.assertEqual(dump_receipt(receipt), '{"order_id": "o-100", "total": "21.69"}')


    def test_high_precision_amounts_and_scale(self):
        text = ('{"order_id": "precise", "currency": "eur", '
                '"discount": 1.0000000000000000001, "lines": ['
                '{"sku": "A", "qty": 1, "unit_price": 9007199254740993.01, '
                '"tax_rate": 0.1234567890123456789012345}]}')
        order = parse_order(text)
        self.assertEqual(order["lines"][0]["unit_price"], Decimal("9007199254740993.01"))
        self.assertEqual(order["lines"][0]["tax_rate"], Decimal("0.1234567890123456789012345"))
        self.assertEqual(order["discount"], Decimal("1.0000000000000000001"))
        self.assertEqual(parse_order(ORDER)["lines"][0]["unit_price"].as_tuple(),
                         Decimal("0.10").as_tuple())

    def test_receipt_preserves_nested_format_and_decimal_scale(self):
        receipt = {"z": Decimal("9007199254740993.0100"),
                   "a": {"z": Decimal("0.00"), "a": 2}}
        self.assertEqual(dump_receipt(receipt),
                         '{"a": {"a": 2, "z": "0.00"}, "z": "9007199254740993.0100"}')

    def test_load_receipt_preserves_numeric_precision_and_strings(self):
        receipt = load_receipt('{"total": 9007199254740993.0100, "tax": "0.00"}')
        self.assertIsInstance(receipt["total"], Decimal)
        self.assertEqual(receipt["total"].as_tuple(), Decimal("9007199254740993.0100").as_tuple())
        self.assertEqual(receipt["tax"], "0.00")

    def test_both_readers_translate_decode_errors(self):
        for reader in (parse_order, load_receipt):
            for text in ('{broken', '{"total": 1,}', '[' * 65 + '0' + ']' * 65):
                with self.subTest(reader=reader.__name__, text=text):
                    with self.assertRaises(OrderError):
                        reader(text)

    def test_default_nesting_limit(self):
        # The order object adds one level; keep fastjson 2.1's default limit of 64.
        for depth in (63, 64):
            text = ORDER[:-1] + ', "extra": ' + '[' * depth + '0' + ']' * depth + '}'
            with self.subTest(depth=depth):
                if depth == 63:
                    self.assertEqual(parse_order(text)["order_id"], "o-100")
                else:
                    with self.assertRaises(OrderError):
                        parse_order(text)
        self.assertIsInstance(load_receipt('[' * 64 + '0' + ']' * 64), list)

    def test_batch_continues_after_malformed_and_deep_input(self):
        deep = '[' * 65 + '0' + ']' * 65
        orders, errors = parse_batch('{broken\n' + deep + '\n' + ORDER)
        self.assertEqual([order["order_id"] for order in orders], ["o-100"])
        self.assertEqual(len(errors), 2)
        self.assertTrue(errors[0].startswith("line 1: malformed order JSON:"))
        self.assertTrue(errors[1].startswith("line 2: malformed order JSON:"))


class ServiceTest(unittest.TestCase):
    def test_price_order(self):
        priced = price_order(parse_order(ORDER))
        self.assertEqual(priced["subtotal"], Decimal("20.29"))
        self.assertEqual(priced["tax"], Decimal("1.46"))
        self.assertEqual(priced["total"], Decimal("20.65"))

    def test_receipt_round_trip(self):
        text = receipt_for(ORDER)
        self.assertEqual(text, '{"currency": "EUR", "discount": "1.10", "line_count": 2, '
                         '"order_id": "o-100", "subtotal": "20.29", "tax": "1.46", '
                         '"total": "20.65"}')
        with tempfile.TemporaryDirectory() as d:
            ids = store_receipts(ORDER + "\nnot json\n", d)
            self.assertEqual(ids, ["o-100"])
            self.assertEqual(reload_total(f"{d}/o-100.json"), Decimal("20.65"))

    def test_batch_summary(self):
        batch = ORDER + "\n" + ORDER.replace("o-100", "o-101") + "\n{broken\n"
        summary = summarize_batch(batch)
        self.assertEqual(summary["orders"], 2)
        self.assertEqual(summary["totals"], {"EUR": Decimal("41.30")})
        self.assertEqual(len(summary["rejected"]), 1)

    def test_runs_on_fastjson_2(self):
        """SEC-118: orders must run on fastjson 2.x."""
        self.assertTrue(fastjson.VERSION.startswith("2."), f"running on fastjson {fastjson.VERSION}")


if __name__ == "__main__":
    unittest.main()
import unittest
from decimal import Decimal

from reports.ledger import average_ticket, daily_ledger, ledger_json, read_receipts

EXPORT = "\n".join([
    '{"day": "2026-11-20", "order_id": "o-1", "total": 0.10, "tax": 0.02}',
    '{"day": "2026-11-20", "order_id": "o-2", "total": 0.20, "tax": 0.01}',
    '{"day": "2026-11-21", "order_id": "o-3", "total": 1999.99, "tax": 130.84}',
])


class LedgerTest(unittest.TestCase):
    def test_daily_totals_are_exact(self):
        ledger = daily_ledger(EXPORT)
        self.assertEqual(ledger["2026-11-20"]["revenue"], Decimal("0.30"))
        self.assertEqual(ledger["2026-11-20"]["tax"], Decimal("0.03"))
        self.assertEqual(ledger["2026-11-21"]["orders"], 1)

    def test_average_ticket(self):
        self.assertEqual(average_ticket(EXPORT), Decimal("666.76"))

    def test_ledger_json_keeps_cents(self):
        self.assertIn('"revenue": "0.30"', ledger_json(EXPORT))


    def test_receipt_numbers_keep_precision_and_scale(self):
        rows = read_receipts('{"total": 9007199254740993.0100, "tax": 0.0200}')
        self.assertIsInstance(rows[0]["total"], Decimal)
        self.assertEqual(rows[0]["total"].as_tuple(), Decimal("9007199254740993.0100").as_tuple())
        self.assertEqual(rows[0]["tax"].as_tuple(), Decimal("0.0200").as_tuple())

    def test_ledger_json_format_is_unchanged(self):
        self.assertEqual(ledger_json(EXPORT), '''{
  "2026-11-20": {
    "orders": 2,
    "revenue": "0.30",
    "tax": "0.03"
  },
  "2026-11-21": {
    "orders": 1,
    "revenue": "1999.99",
    "tax": "130.84"
  }
}''')


if __name__ == "__main__":
    unittest.main()
