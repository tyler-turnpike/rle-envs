[16.770454, "o", "\"\"\"fastjson 1.4 - JSON with money-safe defaults.\r\n\r\n    loads(text, parse_float=Decimal)   numbers with a fraction decode as Decimal\r\n    dumps(obj, sort_keys=False, indent=None)\r\n                                       Decimal values are written as strings (\"12.30\")\r\n    JSONError                          raised for malformed input\r\n\"\"\"\r\nimport json\r\nfrom decimal import Decimal\r\n\r\nVERSION = \"1.4.2\"\r\n\r\n\r\nclass JSONError(ValueError):\r\n    pass\r\n\r\n\r\ndef loads(text, parse_float=Decimal):\r\n    try:\r\n        return json.loads(text, parse_float=parse_float)\r\n    except json.JSONDecodeError as exc:\r\n        raise JSONError(f\"{exc.msg} at line {exc.lineno} column {exc.colno}\") from None\r\n\r\n\r\ndef _default(value):\r\n    if isinstance(value, Decimal):\r\n        return str(value)\r\n    raise TypeError(f\"fastjson cannot encode {type(value).__name__}\")\r\n\r\n\r\ndef dumps(obj, sort_keys=False, indent=None):\r\n    return json.dumps(obj, sort_keys=sort_keys, indent=indent, default=_default)\r\n"]
[16.772069, "o", "packages/reports/tests/test_ledger.py"]
[16.77221, "o", "\r\npackages/reports/pyproject.toml\r\npackages/reports/reports/ledger.py\r\npackages/reports/reports/__init__.py\r\n"]
[16.773161, "o", "\u001b[?2004hroot@a226f0674522:/app# "]
[25.189105, "i", "cat packages/reports/tests/test_ledger.py; ./mono test reports\n"]
[25.18929, "o", "cat packages/reports/tests/test_ledger.py; ./mono test reports\r\n\u001b[?2004l\r"]
[25.190843, "o", "import unittest\r\nfrom decimal import Decimal\r\n\r\nfrom reports.ledger import average_ticket, daily_ledger, ledger_json\r\n\r\nEXPORT = \"\\n\".join([\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-1\", \"total\": 0.10, \"tax\": 0.02}',\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-2\", \"total\": 0.20, \"tax\": 0.01}',\r\n    '{\"day\": \"2026-11-21\", \"order_id\": \"o-3\", \"total\": 1999.99, \"tax\": 130.84}',\r\n])\r\n\r\n\r\nclass LedgerTest(unittest.TestCase):\r\n    def test_daily_totals_are_exact(self):\r\n        ledger = daily_ledger(EXPORT)\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"revenue\"], Decimal(\"0.30\"))\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"tax\"], Decimal(\"0.03\"))\r\n        self.assertEqual(ledger[\"2026-11-21\"][\"orders\"], 1)\r\n\r\n    def test_average_ticket(self):\r\n        self.assertEqual(average_ticket(EXPORT), Decimal(\"666.76\"))\r\n\r\n    def test_ledger_json_keeps_cents(self):\r\n        self.assertIn('\"revenue\": \"0.30\"', ledger_json(EXPORT))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"]
[25.226525, "o", "testing packages/reports with fastjson 1.4.2\r\n"]
