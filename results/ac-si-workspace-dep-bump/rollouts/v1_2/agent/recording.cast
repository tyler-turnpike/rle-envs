[26.188497, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('packages/orders/orders/codec.py')\ns = p.read_text().replace('fastjson.loads(text)', 'fastjson.decode(text, number_mode=\"decimal\")')\ns = s.replace('fastjson.JSONError', 'fastjson.DecodeError')\ns = s.replace('fastjson.dumps(receipt, sort_keys=True)', 'fastjson.encode(receipt, key_order=\"sorted\", decimal_as=\"string\")')\np.write_text(s)\n\np = Path('packages/reports/reports/ledger.py')\ns = p.read_text().replace('fastjson.loads(raw)', 'fastjson.decode(raw, number_mode=\"decimal\")')\ns = s.replace('fastjson.dumps(daily_ledger(text), sort_keys=True, indent=2)', 'fastjson.encode(daily_ledger(text), key_order=\"sorted\", indent=2, decimal_as=\"string\")')\np.write_text(s)\n\nfor member in ('orders', 'reports'):\n    p = Path('packages') / member / 'pyproject.toml'\n    p.write_text(p.read_text().replace('fastjson>=1.4,<2', 'fastjson>=2.1,<3'))\nPY\n./mono check; ./mono test orders; ./mono test reports\n"]
