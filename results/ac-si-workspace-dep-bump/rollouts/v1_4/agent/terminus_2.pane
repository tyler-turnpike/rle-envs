+                '{"day": "2026-11-20", "total": 0.20, "tax": 0.02}')
+        self.assertEqual(ledger_json(text), '{\n  "2026-11-20": {\n'
+                         '    "orders": 2,\n    "revenue": "12.50",\n'
+                         '    "tax": "0.12"\n  }\n}')
+
+
 if __name__ == "__main__":
     unittest.main()
