[44.862527, "o", "s = s.replace(needle, '''\r\n\u001b[?2004l\r\u001b[?2004h>     def test_numeric_receipts_preserve_precision_and_scale(self):\r\n\u001b[?2004l\r\u001b[?2004h>         text = ('{\"day\": \"2026-11-20\", \"total\": 123456789.1234567890, \"tax\": 0.0200}')\r\n\u001b[?2004l\r\u001b[?2004h>         row = read_receipts(text)[0]\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertIsInstance(row[\"total\"], Decimal)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(str(row[\"total\"]), \"123456789.1234567890\")\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(str(row[\"tax\"]), \"0.0200\")\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(daily_ledger(text)[\"2026-11-20\"][\"revenue\"],\r\n\u001b[?2004l\r\u001b[?2004h>                          Decimal(\"123456789.1234567890\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_ledger_json_format_is_unchanged(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(ledger_json(EXPORT), (\r\n\u001b[?2004l\r\u001b[?2004h>             '{\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '  \"2026-11-20\": {\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \"orders\": 2,\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \""]
[44.862696, "o", "revenue\": \"0.30\",\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \"tax\": \"0.03\"\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '  },\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '  \"2026-11-21\": {\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \"orders\": 1,\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \"revenue\": \"1999.99\",\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '    \"tax\": \"130.84\"\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '  }\\\\n'\r\n\u001b[?2004l\r\u001b[?2004h>             '}'\r\n\u001b[?2004l\r\u001b[?2004h>         ))\r\n\u001b[?2004l\r\u001b[?2004h> ''' + needle)\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
