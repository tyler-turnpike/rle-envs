[56.705234, "i", "python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nscript = '''\nimport json\nfrom decimal import Decimal\nfrom orders.codec import dump_receipt, load_receipt, parse_order\nfrom orders.service import receipt_for\nfrom reports.ledger import ledger_json\norder = '{\"order_id\":\"audit\",\"currency\":\"eur\",\"discount\":0.0100,\"lines\":[{\"sku\":\"A\",\"qty\":3,\"unit_price\":0.1000,\"tax_rate\":0.2000}]}'\nexport = '{\"day\":\"2026-11-20\",\"total\":0.1000,\"tax\":0.0200}\\\\n{\"day\":\"2026-11-20\",\"total\":\"0.20\",\"tax\":\"0.01\"}'\nprint(repr(parse_order(order)))\nprint(receipt_for(order))\nprint(dump_receipt({\"z\": Decimal(\"0.00\"), \"a\": {\"b\": Decimal(\"123456789.1234567890\"), \"a\": 1}}))\nprint(repr(load_receipt('{\"total\":123456789.1234567890,\"tax\":0.0200}')))\nprint(ledger_json(export))\n'''\noutputs = []\nfor root, version in ((Path('/tmp/sec118-before'), '1.4.2'), (Path('/app'), '2.1.0')):\n    paths = [root / 'packages/orders', root / 'packages/reports', Path('/app/vendor') / f'fastjson-{version}']\n    env = dict(os.environ, PYTH"]
[56.705317, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[56.705334, "i", "ONPATH=os.pathsep.join(map(str, paths)), PYTHONDONTWRITEBYTECODE='1')\n    outputs.append(subprocess.check_output([sys.executable, '-c', script], cwd='/tmp', env=env))\nassert outputs[0] == outputs[1], 'Behavior differs between 1.x and 2.1'\nprint('Original 1.4.2 and migrated 2.1.0 outputs match byte-for-byte for audit fixtures.')\nPY\n./mono check && ./mono test orders && ./mono test reports\n"]
[56.705461, "o", "ONPATH=os.pathsep.join(map(str, paths)), PYTHONDONTWRITEBYTECODE='1')\r\n    outputs.append(subprocess.check_output([sys.executable, '-c', script], cwd='/tmp', env=env))\r\nassert outputs[0] == outputs[1], 'Behavior differs between 1.x and 2.1'\r\nprint('Original 1.4.2 and migrated 2.1.0 outputs match byte-for-byte for audit fixtures.')\r\nPY\r\n./mono check && ./mono test orders && ./mono test reports\r\n"]
