[17.756971, "o", "\"\"\"Daily revenue ledger built from the orders receipt export (analytics team).\r\n\r\nThe ledger feeds finance's month-end close, so every figure must be exact to the cent.\r\n\"\"\"\r\nfrom collections import defaultdict\r\nfrom decimal import Decimal\r\n\r\nimport fastjson\r\n\r\n\r\ndef read_receipts(text):\r\n    \"\"\"Receipts export: one JSON receipt per line, each with a `day` field added by the exporter.\"\"\"\r\n    rows = []\r\n    for raw in text.splitlines():\r\n        if raw.strip():\r\n            rows.append(fastjson.loads(raw))\r\n    return rows\r\n\r\n\r\ndef _amount(value):\r\n    if isinstance(value, Decimal):\r\n        return value\r\n    if isinstance(value, str):\r\n        return Decimal(value)\r\n    return Decimal(repr(value))\r\n\r\n\r\ndef daily_ledger(text):\r\n    days = defaultdict(lambda: {\"orders\": 0, \"revenue\": Decimal(\"0\"), \"tax\": Decimal(\"0\")})\r\n    for row in read_receipts(text):\r\n        day = days[row[\"day\"]]\r\n        day[\"orders\"] += 1\r\n        day[\"revenue\"] += _amount(row[\"total\"])\r\n        day[\"tax\"] += _amount(row[\"tax\"])\r\n    "]
[17.757096, "o", "return {d: days[d] for d in sorted(days)}\r\n\r\n\r\ndef average_ticket(text):\r\n    rows = read_receipts(text)\r\n    if not rows:\r\n        return Decimal(\"0\")\r\n    total = sum((_amount(r[\"total\"]) for r in rows), Decimal(\"0\"))\r\n    return (total / len(rows)).quantize(Decimal(\"0.01\"))\r\n\r\n\r\ndef ledger_json(text):\r\n    return fastjson.dumps(daily_ledger(text), sort_keys=True, indent=2)\r\n"]
[17.758547, "o", "import unittest\r\nfrom decimal import Decimal\r\n\r\nfrom reports.ledger import average_ticket, daily_ledger, ledger_json\r\n\r\nEXPORT = \"\\n\".join([\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-1\", \"total\": 0.10, \"tax\": 0.02}',\r\n    '{\"day\": \"2026-11-20\", \"order_id\": \"o-2\", \"total\": 0.20, \"tax\": 0.01}',\r\n    '{\"day\": \"2026-11-21\", \"order_id\": \"o-3\", \"total\": 1999.99, \"tax\": 130.84}',\r\n])\r\n\r\n\r\nclass LedgerTest(unittest.TestCase):\r\n    def test_daily_totals_are_exact(self):\r\n        ledger = daily_ledger(EXPORT)\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"revenue\"], Decimal(\"0.30\"))\r\n        self.assertEqual(ledger[\"2026-11-20\"][\"tax\"], Decimal(\"0.03\"))\r\n        self.assertEqual(ledger[\"2026-11-21\"][\"orders\"], 1)\r\n\r\n    def test_average_ticket(self):\r\n        self.assertEqual(average_ticket(EXPORT), Decimal(\"666.76\"))\r\n\r\n    def test_ledger_json_keeps_cents(self):\r\n        self.assertIn('\"revenue\": \"0.30\"', ledger_json(EXPORT))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\n"]
[17.759826, "o", "\"\"\"fastjson 1.4 - JSON with money-safe defaults.\r\n\r\n    loads(text, parse_float=Decimal)   numbers with a fraction decode as Decimal\r\n    dumps(obj, sort_keys=False, indent=None)\r\n                                       Decimal values are written as strings (\"12.30\")\r\n    JSONError                          raised for malformed input\r\n\"\"\"\r\nimport json\r\nfrom decimal import Decimal\r\n\r\nVERSION = \"1.4.2\"\r\n\r\n\r\nclass JSONError(ValueError):\r\n    pass\r\n\r\n\r\ndef loads(text, parse_float=Decimal):\r\n    try:\r\n        return json.loads(text, parse_float=parse_float)\r\n    except json.JSONDecodeError as exc:\r\n        raise JSONError(f\"{exc.msg} at line {exc.lineno} column {exc.colno}\") from None\r\n\r\n\r\ndef _default(value):\r\n    if isinstance(value, Decimal):\r\n        return str(value)\r\n    raise TypeError(f\"fastjson cannot encode {type(value).__name__}\")\r\n\r\n\r\ndef dumps(obj, sort_keys=False, indent=None):\r\n    return json.dumps(obj, sort_keys=sort_keys, indent=indent, default=_default)\r\n"]
[17.761211, "o", "\"\"\"Order pricing and receipts.\"\"\"\r\nfrom collections import defaultdict\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\nfrom pathlib import Path\r\n\r\nfrom .codec import OrderError, dump_receipt, load_receipt, parse_batch, parse_order\r\n\r\nCENT = Decimal(\"0.01\")\r\n\r\n\r\ndef money(value):\r\n    return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)\r\n\r\n\r\ndef price_order(order):\r\n    \"\"\"Subtotal, per-line tax (rounded per line), discount and total, all exact.\"\"\"\r\n    subtotal = sum((line[\"unit_price\"] * line[\"qty\"] for line in order[\"lines\"]), Decimal(\"0\"))\r\n    tax = sum((money(line[\"unit_price\"] * line[\"qty\"] * line[\"tax_rate\"]) for line in order[\"lines\"]),\r\n              Decimal(\"0\"))\r\n    discount = min(money(order[\"discount\"]), money(subtotal))\r\n    total = money(subtotal) + tax - discount\r\n    return {\"order_id\": order[\"order_id\"], \"currency\": order[\"currency\"],\r\n            \"subtotal\": money(subtotal), \"tax\": money(tax), \"discount\": discount,\r\n            \"total\": money(total), \"line_count\": len(order[\"lines\"])}"]
[17.76131, "o", "\r\n\r\n\r\ndef receipt_for(text):\r\n    return dump_receipt(price_order(parse_order(text)))\r\n\r\n\r\ndef summarize_batch(text):\r\n    \"\"\"Totals per currency for a JSON-lines export, plus the lines that were rejected.\"\"\"\r\n    orders, errors = parse_batch(text)\r\n    totals = defaultdict(lambda: Decimal(\"0\"))\r\n    for order in orders:\r\n        totals[order[\"currency\"]] += price_order(order)[\"total\"]\r\n    return {\"orders\": len(orders), \"totals\": {c: money(v) for c, v in sorted(totals.items())},\r\n            \"rejected\": errors}\r\n\r\n\r\ndef store_receipts(text, out_dir):\r\n    \"\"\"Write one receipt per valid order; returns the ids written.\"\"\"\r\n    out = Path(out_dir)\r\n    out.mkdir(parents=True, exist_ok=True)\r\n    orders, _ = parse_batch(text)\r\n    written = []\r\n    for order in orders:\r\n        receipt = price_order(order)\r\n        (out / f\"{receipt['order_id']}.json\").write_text(dump_receipt(receipt) + \"\\n\")\r\n        written.append(receipt[\"order_id\"])\r\n    return written\r\n\r\n\r\ndef reload_total(path):\r\n    receipt = load_receipt"]
[17.761329, "o", "(Path(path).read_text())\r\n    if \"total\" not in receipt:\r\n        raise OrderError(f\"{path}: not a receipt\")\r\n    return Decimal(str(receipt[\"total\"]))\r\n"]
