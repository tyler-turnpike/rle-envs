[7.272284, "o", "#!/usr/bin/env python3\r\n\"\"\"mono - the workspace tool.\r\n\r\n"]
[7.272437, "o", "    ./mono check                       resolve every member's dependencies to one version each and\r\n                                       write mono.lock (the workspace ships a single version of\r\n                                       every dependency)\r\n    ./mono test MEMBER [--dep N=V]     run a member's tests against the locked versions; --dep tries\r\n                                       a member against another vendored version first\r\n    ./mono deps                        constraints per member and what is locked\r\n    ./mono owners PATH                 who owns a path (CODEOWNERS)\r\n    ./mono bump DEP VERSION --member M | --all\r\n                                       raise a dependency's constraint. Workspace maintainers use\r\n                                       --all to move every package that uses DEP in one go; on a\r\n                                       major upgrade the dependency's codemod rewrites call sites\r\n                                       (renames only - behaviour changes are in the "]
[7.272495, "o", "library's CHANGES)\r\n\"\"\"\r\nimport argparse\r\nimport os\r\nimport re\r\nimport subprocess\r\nimport sys\r\nimport tomllib\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent\r\nSPEC = re.compile(r\"^\\s*([A-Za-z0-9_.-]+)\\s*(.*)$\")\r\nOP = re.compile(r\"^(>=|<=|==|<|>)\\s*([0-9][0-9.]*)$\")\r\nCODEMODS = {(\"fastjson\", 1, 2): [\r\n    (r\"\\bfastjson\\.loads\\(\", \"fastjson.decode(\"),\r\n    (r\"\\bparse_float=Decimal\\b\", 'number_mode=\"decimal\"'),\r\n    (r\"\\bfastjson\\.dumps\\(\", \"fastjson.encode(\"),\r\n    (r\"\\bsort_keys=True\\b\", 'key_order=\"sorted\"'),\r\n    (r\"\\bfastjson\\.JSONError\\b\", \"fastjson.DecodeError\"),\r\n]}\r\n\r\n\r\ndef vtuple(text):\r\n    return tuple(int(p) for p in text.split(\".\"))\r\n\r\n\r\ndef workspace():\r\n    cfg = tomllib.loads((ROOT / \"mono.toml\").read_text())\r\n    return cfg[\"workspace\"][\"members\"], ROOT / cfg.get(\"index\", {}).get(\"path\", \"vendor\")\r\n\r\n\r\ndef member_deps(member):\r\n    project = tomllib.loads((ROOT / member / \"pyproject.toml\").read_text())[\"project\"]\r\n    deps = {}\r\n    for raw in project.get(\"dependencies\", [])"]
[7.272562, "o", ":\r\n        name, rest = SPEC.match(raw).groups()\r\n        deps[name] = [OP.match(c.strip()).groups() for c in rest.split(\",\") if c.strip()]\r\n    return project[\"name\"], deps\r\n\r\n\r\ndef available(index, name):\r\n    return sorted((vtuple(p.name[len(name) + 1:]) for p in index.glob(f\"{name}-*\") if p.is_dir()), reverse=True)\r\n\r\n\r\ndef satisfies(version, constraints):\r\n    checks = {\">=\": lambda a, b: a >= b, \"<=\": lambda a, b: a <= b, \"==\": lambda a, b: a == b,\r\n              \"<\": lambda a, b: a < b, \">\": lambda a, b: a > b}\r\n    return all(checks[op](version, vtuple(v)) for op, v in constraints)\r\n\r\n\r\ndef owners(path):\r\n    found = []\r\n    for line in (ROOT / \"CODEOWNERS\").read_text().splitlines():\r\n        if line.strip() and not line.startswith(\"#\"):\r\n            pattern, *who = line.split()\r\n            if str(path).startswith(pattern.strip(\"/\")):\r\n                found = who\r\n    return found\r\n\r\n\r\ndef resolve():\r\n    members, index = workspace()\r\n    wanted = {}\r\n    for member in members:\r\n        name, deps = "]
[7.272618, "o", "member_deps(member)\r\n        for dep, constraints in deps.items():\r\n            wanted.setdefault(dep, []).append((member, name, constraints))\r\n    locked, conflicts = {}, []\r\n    for dep, users in sorted(wanted.items()):\r\n        options = [v for v in available(index, dep) if all(satisfies(v, c) for _, _, c in users)]\r\n        if options:\r\n            locked[dep] = \".\".join(map(str, options[0]))\r\n            continue\r\n        lines = [f\"  {name} ({member}/pyproject.toml, owners: {' '.join(owners(member)) or '-'}) requires \"\r\n                 + \",\".join(op + v for op, v in c) for member, name, c in users]\r\n        conflicts.append(f\"resolution conflict: no vendored {dep} satisfies every member\\n\" + \"\\n\".join(lines))\r\n    return locked, conflicts\r\n\r\n\r\ndef read_lock():\r\n    lock = ROOT / \"mono.lock\"\r\n    return tomllib.loads(lock.read_text()).get(\"resolved\", {}) if lock.exists() else {}\r\n\r\n\r\ndef cmd_check(args):\r\n    locked, conflicts = resolve()\r\n    if conflicts:\r\n        print(\"\\n\".join(conflicts), file=sys."]
[7.272638, "o", "stderr)\r\n        print(\"mono.lock left unchanged\", file=sys.stderr)\r\n        return 1\r\n    body = \"\".join(f'{dep} = \"{ver}\"\\n' for dep, ver in sorted(locked.items()))\r\n    (ROOT / \"mono.lock\").write_text(\"# generated by ./mono check - do not edit\\n[resolved]\\n\" + body)\r\n    print(\"workspace resolves: \" + \", \".join(f\"{d} {v}\" for d, v in sorted(locked.items())))\r\n    return 0\r\n\r\n\r\ndef cmd_test(args):\r\n    members, index = workspace()\r\n    member = next((m for m in members if Path(m).name == args.member or m == args.member), None)\r\n    if member is None:\r\n        print(f\"unknown member {args.member}\", file=sys.stderr)\r\n        return 2\r\n    versions = dict(read_lock())\r\n    for override in args.dep or []:\r\n        dep, _, ver = override.partition(\"=\")\r\n        versions[dep] = ver\r\n    _, deps = member_deps(member)\r\n    paths = [str(ROOT / member)]\r\n    for dep in deps:\r\n        if dep not in versions or not (index / f\"{dep}-{versions[dep]}\").is_dir():\r\n            print(f\"{dep}: no locked or vendored version (r"]
[7.272655, "o", "un ./mono check)\", file=sys.stderr)\r\n            return 2\r\n        paths.append(str(index / f\"{dep}-{versions[dep]}\"))\r\n    print(\"testing \" + member + \" with \" + \", \".join(f\"{d} {versions[d]}\" for d in deps))\r\n    env = dict(os.environ, PYTHONPATH=os.pathsep.join(paths), PYTHONDONTWRITEBYTECODE=\"1\")\r\n    return subprocess.call([sys.executable, \"-m\", \"unittest\", \"discover\", \"-s\", \"tests\"],\r\n                           cwd=ROOT / member, env=env)\r\n\r\n\r\ndef cmd_bump(args):\r\n    members, index = workspace()\r\n    new = vtuple(args.version)\r\n    targets = [m for m in members if (args.all or Path(m).name == args.member) and args.dep in member_deps(m)[1]]\r\n    if not targets:\r\n        print(\"nothing to bump\", file=sys.stderr)\r\n        return 2\r\n    for member in targets:\r\n        py = ROOT / member / \"pyproject.toml\"\r\n        _, deps = member_deps(member)\r\n        old_major = max((vtuple(v)[0] for op, v in deps[args.dep] if op in (\">=\", \"==\")), default=new[0])\r\n        text = re.sub(rf'\"{re.escape(args.dep)}[^\"]*\"', f"]
[7.272671, "o", "'\"{args.dep}>={args.version},<{new[0] + 1}\"', py.read_text())\r\n        py.write_text(text)\r\n        rules = CODEMODS.get((args.dep, old_major, new[0]), [])\r\n        changed = 0\r\n        for src in (ROOT / member).rglob(\"*.py\"):\r\n            before = src.read_text()\r\n            after = before\r\n            for pattern, repl in rules:\r\n                after = re.sub(pattern, repl, after)\r\n            if after != before:\r\n                src.write_text(after)\r\n                changed += 1\r\n        print(f\"{member}: {args.dep} -> >={args.version},<{new[0] + 1}; codemod rewrote {changed} file(s)\")\r\n    return cmd_check(args)\r\n\r\n\r\ndef cmd_deps(args):\r\n    members, _ = workspace()\r\n    for member in members:\r\n        name, deps = member_deps(member)\r\n        print(f\"{name} ({member}): \" + \", \".join(d + \",\".join(o + v for o, v in c) for d, c in deps.items()))\r\n    print(\"locked: \" + \", \".join(f\"{d} {v}\" for d, v in sorted(read_lock().items())))\r\n    return 0\r\n\r\n\r\ndef main(argv=None):\r\n    ap = argparse.ArgumentParser"]
[7.272694, "o", "(prog=\"mono\", description=__doc__.splitlines()[0])\r\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\r\n    sub.add_parser(\"check\").set_defaults(func=cmd_check)\r\n    t = sub.add_parser(\"test\")\r\n    t.add_argument(\"member\")\r\n    t.add_argument(\"--dep\", action=\"append\", metavar=\"NAME=VERSION\")\r\n    t.set_defaults(func=cmd_test)\r\n    b = sub.add_parser(\"bump\")\r\n    b.add_argument(\"dep\")\r\n    b.add_argument(\"version\")\r\n    g = b.add_mutually_exclusive_group(required=True)\r\n    g.add_argument(\"--member\")\r\n    g.add_argument(\"--all\", action=\"store_true\")\r\n    b.set_defaults(func=cmd_bump)\r\n    sub.add_parser(\"deps\").set_defaults(func=cmd_deps)\r\n    o = sub.add_parser(\"owners\")\r\n    o.add_argument(\"path\")\r\n    o.set_defaults(func=lambda a: print(\" \".join(owners(a.path)) or \"-\") or 0)\r\n    args = ap.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\u001b[?2004hroot@7c56c9ebb6cb:/app# "]
