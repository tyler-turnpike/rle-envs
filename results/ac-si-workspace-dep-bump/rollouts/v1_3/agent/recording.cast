[56.623055, "o", "--- before/mono.lock\r\n+++ mono.lock\r\n@@ -1,3 +1,3 @@\r\n # generated by ./mono check - do not edit\r\n [resolved]\r\n-fastjson = \"1.4.2\"\r\n+fastjson = \"2.1.0\"\r\n\r\nCHANGED: packages/orders/orders/codec.py\r\n"]
[56.623209, "o", "--- before/packages/orders/orders/codec.py\r\n+++ packages/orders/orders/codec.py\r\n@@ -17,8 +17,8 @@\r\n \r\n def parse_order(text):\r\n     try:\r\n-        doc = fastjson.loads(text)\r\n-    except fastjson.JSONError as exc:\r\n+        doc = fastjson.decode(text, number_mode=\"decimal\")\r\n+    except fastjson.DecodeError as exc:\r\n         raise OrderError(f\"malformed order JSON: {exc}\") from None\r\n     if not isinstance(doc, dict):\r\n         raise OrderError(\"order must be a JSON object\")\r\n@@ -53,11 +53,11 @@\r\n \r\n \r\n def dump_receipt(receipt):\r\n-    return fastjson.dumps(receipt, sort_keys=True)\r\n+    return fastjson.encode(receipt, key_order=\"sorted\", decimal_as=\"string\")\r\n \r\n \r\n def load_receipt(text):\r\n     try:\r\n-        return fastjson.loads(text)\r\n-    except fastjson.JSONError as exc:\r\n+        return fastjson.decode(text, number_mode=\"decimal\")\r\n+    except fastjson.DecodeError as exc:\r\n         raise OrderError(f\"malformed receipt: {exc}\") from None\r\n\r\n"]
