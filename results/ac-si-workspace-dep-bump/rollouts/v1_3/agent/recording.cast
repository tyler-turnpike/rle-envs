[56.588927, "i", "mkdir -p /tmp/sec118-before; tar -xzf /tmp/sec118-before.tar.gz -C /tmp/sec118-before\npython3 - <<'PY'\nfrom pathlib import Path\nimport difflib\nbefore = Path('/tmp/sec118-before')\nfor old in sorted(before.rglob('*')):\n    if not old.is_file():\n        continue\n    path = old.relative_to(before)\n    new = Path(path)\n    if old.read_bytes() != new.read_bytes():\n        print(f'CHANGED: {path}')\n        if 'tests' not in path.parts:\n            print(''.join(difflib.unified_diff(old.read_text().splitlines(True), new.read_text().splitlines(True), fromfile=f'before/{path}', tofile=str(path))))\nPY\n"]
