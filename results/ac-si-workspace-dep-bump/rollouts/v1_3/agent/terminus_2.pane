[?2004l"""Daily revenue ledger built from the orders receipt export (analytics team).

The ledger feeds finance's month-end close, so every figure must be exact to the cent.
"""
from collections import defaultdict
from decimal import Decimal

import fastjson


def read_receipts(text):
    """Receipts export: one JSON receipt per line, each with a `day` field added by the exporter."""
    rows = []
    for raw in text.splitlines():
        if raw.strip():
            rows.append(fastjson.loads(raw))
    return rows


def _amount(value):
    if isinstance(value, Decimal):
        return value
    if isinstance(value, str):
        return Decimal(value)
    return Decimal(repr(value))


def daily_ledger(text):
    days = defaultdict(lambda: {"orders": 0, "revenue": Decimal("0"), "tax": Decimal("0")})
    for row in read_receipts(text):
        day = days[row["day"]]
        day["orders"] += 1
        day["revenue"] += _amount(row["total"])
        day["tax"] += _amount(row["tax"])
    return {d: days[d] for d in sorted(days)}


def average_ticket(text):
    rows = read_receipts(text)
    if not rows:
        return Decimal("0")
    total = sum((_amount(r["total"]) for r in rows), Decimal("0"))
    return (total / len(rows)).quantize(Decimal("0.01"))


def ledger_json(text):
    return fastjson.dumps(daily_ledger(text), sort_keys=True, indent=2)
import unittest
from decimal import Decimal

from reports.ledger import average_ticket, daily_ledger, ledger_json

EXPORT = "\n".join([
    '{"day": "2026-11-20", "order_id": "o-1", "total": 0.10, "tax": 0.02}',
    '{"day": "2026-11-20", "order_id": "o-2", "total": 0.20, "tax": 0.01}',
    '{"day": "2026-11-21", "order_id": "o-3", "total": 1999.99, "tax": 130.84}',
])


class LedgerTest(unittest.TestCase):
    def test_daily_totals_are_exact(self):
        ledger = daily_ledger(EXPORT)
        self.assertEqual(ledger["2026-11-20"]["revenue"], Decimal("0.30"))
        self.assertEqual(ledger["2026-11-20"]["tax"], Decimal("0.03"))
        self.assertEqual(ledger["2026-11-21"]["orders"], 1)

    def test_average_ticket(self):
        self.assertEqual(average_ticket(EXPORT), Decimal("666.76"))

    def test_ledger_json_keeps_cents(self):
        self.assertIn('"revenue": "0.30"', ledger_json(EXPORT))


if __name__ == "__main__":
    unittest.main()
"""fastjson 1.4 - JSON with money-safe defaults.

    loads(text, parse_float=Decimal)   numbers with a fraction decode as Decimal
    dumps(obj, sort_keys=False, indent=None)
                                       Decimal values are written as strings ("12.30")
    JSONError                          raised for malformed input
"""
import json
from decimal import Decimal

VERSION = "1.4.2"


class JSONError(ValueError):
    pass


def loads(text, parse_float=Decimal):
    try:
        return json.loads(text, parse_float=parse_float)
    except json.JSONDecodeError as exc:
        raise JSONError(f"{exc.msg} at line {exc.lineno} column {exc.colno}") from None


def _default(value):
    if isinstance(value, Decimal):
        return str(value)
    raise TypeError(f"fastjson cannot encode {type(value).__name__}")


def dumps(obj, sort_keys=False, indent=None):
    return json.dumps(obj, sort_keys=sort_keys, indent=indent, default=_default)
"""Order pricing and receipts."""
from collections import defaultdict
from decimal import ROUND_HALF_UP, Decimal
from pathlib import Path

from .codec import OrderError, dump_receipt, load_receipt, parse_batch, parse_order

CENT = Decimal("0.01")


def money(value):
    return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)


def price_order(order):
    """Subtotal, per-line tax (rounded per line), discount and total, all exact."""
    subtotal = sum((line["unit_price"] * line["qty"] for line in order["lines"]), Decimal("0"))
    tax = sum((money(line["unit_price"] * line["qty"] * line["tax_rate"]) for line in order["lines"]),
              Decimal("0"))
    discount = min(money(order["discount"]), money(subtotal))
    total = money(subtotal) + tax - discount
    return {"order_id": order["order_id"], "currency": order["currency"],
            "subtotal": money(subtotal), "tax": money(tax), "discount": discount,
            "total": money(total), "line_count": len(order["lines"])}


def receipt_for(text):
    return dump_receipt(price_order(parse_order(text)))


def summarize_batch(text):
    """Totals per currency for a JSON-lines export, plus the lines that were rejected."""
    orders, errors = parse_batch(text)
    totals = defaultdict(lambda: Decimal("0"))
    for order in orders:
        totals[order["currency"]] += price_order(order)["total"]
    return {"orders": len(orders), "totals": {c: money(v) for c, v in sorted(totals.items())},
            "rejected": errors}


def store_receipts(text, out_dir):
    """Write one receipt per valid order; returns the ids written."""
    out = Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)
    orders, _ = parse_batch(text)
    written = []
    for order in orders:
        receipt = price_order(order)
        (out / f"{receipt['order_id']}.json").write_text(dump_receipt(receipt) + "\n")
        written.append(receipt["order_id"])
    return written


def reload_total(path):
    receipt = load_receipt(Path(path).read_text())
    if "total" not in receipt:
        raise OrderError(f"{path}: not a receipt")
    return Decimal(str(receipt["total"]))
