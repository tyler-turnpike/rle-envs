[9.455052, "o", "\r\n\u001b[?2004l\r"]
[9.457659, "o", "# Workspace\r\n\r\nTwo services share this workspace and its vendored dependencies:\r\n\r\n| member | what | owners |\r\n|---|---|---|\r\n| `packages/orders` | order pricing and receipts | @payments-team |\r\n| `packages/reports` | daily revenue ledger for finance close | @analytics-team |\r\n\r\nThe workspace ships **one version of each dependency** (`./mono check` resolves every member\r\ntogether and writes `mono.lock`). Third-party code is vendored under `vendor/<name>-<version>/`;\r\nthere is no network access.\r\n\r\n    ./mono check                 resolve + lock\r\n    ./mono test orders           run a member's tests against the lock\r\n    ./mono test orders --dep fastjson=2.1.0   try a member against another vendored version\r\n    ./mono deps                  constraints and lock\r\n    ./mono owners packages/reports\r\n\r\nWorkspace maintainers move a shared dependency for every package at once with\r\n`./mono bump DEP VERSION --all`; on a major upgrade it runs the dependency's codemod over each\r\npackage. Owners are in `CODEOWNERS`.\r\n#"]
[9.457711, "o", " path                 owners\r\n/                      @platform-workspace\r\n/packages/orders/      @payments-team\r\n/packages/reports/     @analytics-team\r\n/vendor/               @platform-workspace\r\n[workspace]\r\n# Every member is resolved together: the workspace ships one version of each dependency.\r\nmembers = [\"packages/orders\", \"packages/reports\"]\r\n\r\n[index]\r\npath = \"vendor\"\r\n# generated by ./mono check - do not edit\r\n[resolved]\r\nfastjson = \"1.4.2\"\r\n"]
[9.461666, "o", "packages/orders/orders/__init__.py\r\npackages/orders/orders/codec.py\r\npackages/orders/orders/service.py\r\npackages/orders/pyproject.toml\r\npackages/orders/tests/test_orders.py\r\npackages/reports/pyproject.toml\r\npackages/reports/reports/__init__.py\r\npackages/reports/reports/ledger.py\r\npackages/reports/tests/test_ledger.py\r\n"]
[9.463645, "o", "\"\"\"Order JSON codec: incoming order documents and the receipts we store.\r\n\r\nAmounts are exact (Decimal) end to end; receipts are canonical JSON (sorted keys,\r\namounts written as strings) because finance diffs them across releases.\r\n\"\"\"\r\nfrom decimal import Decimal\r\n\r\nimport fastjson\r\n\r\nREQUIRED = (\"order_id\", \"currency\", \"lines\")\r\nLINE_FIELDS = (\"sku\", \"qty\", \"unit_price\")\r\n\r\n\r\nclass OrderError(ValueError):\r\n    \"\"\"The document is not a valid order.\"\"\"\r\n\r\n\r\ndef parse_order(text):\r\n    try:\r\n        doc = fastjson.loads(text)\r\n    except fastjson.JSONError as exc:\r\n        raise OrderError(f\"malformed order JSON: {exc}\") from None\r\n    if not isinstance(doc, dict):\r\n        raise OrderError(\"order must be a JSON object\")\r\n    missing = [k for k in REQUIRED if k not in doc]\r\n    if missing:\r\n        raise OrderError(f\"order missing {', '.join(missing)}\")\r\n    lines = []\r\n    for i, line in enumerate(doc[\"lines\"]):\r\n        if not isinstance(line, dict) or any(k not in line for k in LINE_FIELDS):\r\n            ra"]
[9.463689, "o", "ise OrderError(f\"line {i} needs {', '.join(LINE_FIELDS)}\")\r\n        price = line[\"unit_price\"]\r\n        if not isinstance(price, Decimal):\r\n            price = Decimal(str(price))\r\n        lines.append({\"sku\": str(line[\"sku\"]), \"qty\": int(line[\"qty\"]), \"unit_price\": price,\r\n                      \"tax_rate\": Decimal(str(line.get(\"tax_rate\", \"0\")))})\r\n    discount = doc.get(\"discount\", Decimal(\"0\"))\r\n    return {\"order_id\": str(doc[\"order_id\"]), \"currency\": str(doc[\"currency\"]).upper(),\r\n            \"lines\": lines, \"discount\": Decimal(str(discount))}\r\n\r\n\r\ndef parse_batch(text):\r\n    \"\"\"Parse a JSON-lines export; returns (orders, errors) so one bad line does not stop a batch.\"\"\"\r\n    orders, errors = [], []\r\n    for n, raw in enumerate(text.splitlines(), 1):\r\n        if not raw.strip():\r\n            continue\r\n        try:\r\n            orders.append(parse_order(raw))\r\n        except OrderError as exc:\r\n            errors.append(f\"line {n}: {exc}\")\r\n    return orders, errors\r\n\r\n\r\ndef dump_receipt(receipt):\r\n    re"]
[9.463708, "o", "turn fastjson.dumps(receipt, sort_keys=True)\r\n\r\n\r\ndef load_receipt(text):\r\n    try:\r\n        return fastjson.loads(text)\r\n    except fastjson.JSONError as exc:\r\n        raise OrderError(f\"malformed receipt: {exc}\") from None\r\n\"\"\"Order pricing and receipts.\"\"\"\r\nfrom collections import defaultdict\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\nfrom pathlib import Path\r\n\r\nfrom .codec import OrderError, dump_receipt, load_receipt, parse_batch, parse_order\r\n\r\nCENT = Decimal(\"0.01\")\r\n\r\n\r\ndef money(value):\r\n    return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)\r\n\r\n\r\ndef price_order(order):\r\n    \"\"\"Subtotal, per-line tax (rounded per line), discount and total, all exact.\"\"\"\r\n    subtotal = sum((line[\"unit_price\"] * line[\"qty\"] for line in order[\"lines\"]), Decimal(\"0\"))\r\n    tax = sum((money(line[\"unit_price\"] * line[\"qty\"] * line[\"tax_rate\"]) for line in order[\"lines\"]),\r\n              Decimal(\"0\"))\r\n    discount = min(money(order[\"discount\"]), money(subtotal))\r\n    total = money(subtotal) + tax - discount\r\n "]
