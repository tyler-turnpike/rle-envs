[9.716917, "o", "--- accessq/__init__.py ---\r\n"]
[9.718064, "o", "\"\"\"accessq: processes access requests filed by email against the platform ACL.\"\"\"\r\n\r\n__version__ = \"0.4.0\"\r\n"]
