[76.535373, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Additional coverage for queue safety, audit records, and parsing.\"\"\"\nimport json\n\nfrom test_handler import LEAD, QueueCase, message\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes()\n                for p in self.root.rglob('*') if p.is_file()}\n\n    def test_minimum_holders_blocks_entire_revoke(self):\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer']})\n        self.enqueue('1', message('AR-20', LEAD, 'revoke', 'bo',\n                                  'ci-viewer, billing-reader'))\n        before = self.acl()\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'held')\n        self.assertEqual(self.acl(), before)\n        self.assertEqual(self.listing('held'), ['1.eml'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertIn('min_holders', self.audit()[0]['rea"]
[76.535617, "i", "son'])\n\n    def test_revoke_absent_role_is_noop(self):\n        self.enqueue('1', message('AR-21', LEAD, 'revoke', 'missing', 'ci-viewer'))\n        before = self.acl()\n        self.assertEqual(process_queue(self.root)[0].detail, 'revoke missing: no change')\n        self.assertEqual(self.acl(), before)\n        self.assertEqual(self.audit(), [])\n\n    def test_audit_only_roles_actually_changed(self):\n        self.enqueue('1', message('AR-22', LEAD, 'grant', 'ana',\n                                  'release-manager, deploy-operator, ci-viewer'))\n        self.enqueue('2', message('AR-23', LEAD, 'grant', 'ana', 'release-manager'))\n        self.enqueue('3', message('AR-24', LEAD, 'revoke', 'ana',\n                                  'artifact-publisher, artifact-publisher'))\n        process_queue(self.root)\n        entries = self.audit()\n        self.assertEqual(len(entries), 4)\n        self.assertEqual({(e['action'], e['role']) for e in entries}, {\n            ('grant', 'release-manager'), ('grant', 'deploy-operator'),"]
