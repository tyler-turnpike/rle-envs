[111.165445, "i", "python - <<'PY'\nfrom pathlib import Path\nimport json\nimport subprocess\nfrom accessq.mailparse import parse_message\n\nroot = Path('.')\nacl_path = root / 'state/acl.json'\naudit_path = root / 'state/audit.log'\nexpected = json.loads(acl_path.read_text())['principals']\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nold_audit = audit_path.read_bytes()\noriginal_messages = {p.name: p.read_bytes() for p in (root / 'queue/new').glob('*.eml')}\nbounced = {p.name: p.read_bytes() for p in (root / 'queue/bounced').glob('*') if p.is_file()}\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert json.loads(acl_path.read_text())['principals'] == expected\nassert not list((root / 'queue/new').glob('*.eml'))\nfor directory, tickets in [('cur', {'AR-2201', 'AR-2204', 'AR-2206', 'AR-2208'}),\n  "]
[111.165588, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.165669, "i", "                         ('held', {'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207'})]:\n    paths = list((root / 'queue' / directory).glob('*.eml'))\n    assert {parse_message(p).ticket for p in paths} == tickets\n    for p in paths:\n        assert p.read_bytes() == original_messages[p.name]\nassert {p.name: p.read_bytes() for p in (root / 'queue/bounced').glob('*') if p.is_file()} == bounced\nnew_audit = audit_path.read_bytes()\nassert new_audit.startswith(old_audit)\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\nassert len(entries) == 12\nassert sum(e['result'] == 'applied' for e in entries) == 8\nassert sum(e['result'] == 'held' for e in entries) == 4\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\nassert not any(e.get('role') == 'admin' for e in entries)\nprint('Verified: exact ACL changes; 4 applied/4 held; 8 role-change and 4 held audit records; prior audit and all message contents preserved; bounced request untouched.')\nPY\n"]
