[76.548707, "o", "                  'c': Role('c', '', ('a',))})\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
