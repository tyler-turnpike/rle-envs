[89.792456, "i", "python - <<'PY'\nfrom pathlib import Path\nimport subprocess\n\ndef snapshot():\n    return {str(p): p.read_bytes() for directory in ('queue', 'state', 'policy')\n            for p in Path(directory).rglob('*') if p.is_file()}\n\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert snapshot() == before, 'Dry run changed files!'\nprint('Verified: dry run left every queue, state, and policy file unchanged.')\nPY\nsed -n '1,180p' accessq/handler.py; sed -n '1,160p' accessq/mailparse.py\n"]
[89.79418, "o", "python - <<'PY'\r\n"]
