[114.147592, "i", "python - <<'PY'\nfrom pathlib import Path\nimport subprocess\nroot = Path('/app')\ndef snapshot():\n    return {str(p.relative_to(root)): p.read_bytes()\n            for folder in ('state', 'policy', 'queue')\n            for p in (root / folder).rglob('*') if p.is_file()}\nbefore = snapshot()\nresult = subprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True, capture_output=True, text=True)\nprint(result.stdout, end='')\nassert snapshot() == before, 'Dry run changed files!'\nexpected = {'AR-2201': 'applied', 'AR-2202': 'held', 'AR-2203': 'held', 'AR-2204': 'applied',\n            'AR-2205': 'held', 'AR-2206': 'applied', 'AR-2207': 'held', 'AR-2208': 'applied'}\nactual = {parts[1]: parts[0] for line in result.stdout.splitlines()\n          if len(parts := line.split()) > 1 and parts[0] in ('applied', 'held', 'rejected')}\nassert actual == expected, actual\nPath('/tmp/accessq-preview.txt').write_text(result.stdout)\nprint('Verified: dry run changed no queue, state, or policy files; all 8 decisions matc"]
[114.147696, "i", "h expectations.')\nPY\n"]
