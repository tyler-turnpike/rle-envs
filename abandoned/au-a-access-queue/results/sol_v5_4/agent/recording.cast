[134.953104, "i", "python - <<'PY'\nimport json\nimport subprocess\nfrom collections import Counter\nfrom pathlib import Path\nroot = Path('/app')\nbackup = Path('/tmp/accessq-before.ePjleR')\noriginal = json.loads((backup / 'state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in original.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nactual = json.loads((root / 'state/acl.json').read_text())['principals']\nassert actual == expected, (actual, expected)\nassert all(len(roles) == len(set(roles)) for roles in actual.values())\nassert not list((root / 'queue/new').iterdir())\nfor folder, tickets in [('cur', {'2201', '2204', '2206', '2208'}), ('held', {'2202', '2203', '2205', '2207'})]:\n    paths = list((root / 'queue' / folder).glob('*.eml'))\n    assert len(paths) == 4\n    assert {p.na"]
