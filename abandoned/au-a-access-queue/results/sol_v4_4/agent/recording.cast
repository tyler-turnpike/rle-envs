[100.132315, "i", "python - <<'PY'\nimport json\nimport os\nfrom pathlib import Path\nfrom accessq.mailparse import parse_message\n\nbaseline = Path(os.environ['ACCESSQ_BASELINE'])\nbefore = json.loads((baseline / 'state/acl.json').read_text())['principals']\nafter = json.loads(Path('state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in before.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['tomas.eriksen'] = ['ci-viewer']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert after == expected, (after, expected)\nassert not list(Path('queue/new').iterdir())\nassert sorted(parse_message(p).ticket for p in Path('queue/cur').glob('*.eml')) == [\n    'AR-2201', 'AR-2203', 'AR-2204', 'AR-2206', 'AR-2208']\nassert sorted(parse_message(p).ticket for p in Path('queue/held').glob('*.eml')) == [\n    'AR-2202', 'AR-2205', 'AR-2207"]
[100.132359, "o", "python - <<'PY'\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\nfrom accessq.mailparse import parse_message\r\n\r\nbaseline = Path(os.environ['ACCESSQ_BASELINE'])\r\nbefore = json.loads((baseline / 'state/acl.json').read_text())['principals']\r\nafter = json.loads(Path('state/acl.json').read_text())['principals']\r\nexpected = {p: list(roles) for p, roles in before.items()}\r\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\r\nexpected['tomas.eriksen'] = ['ci-viewer']\r\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\r\nexpected['svc-legacy-ci'] = []\r\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\r\nassert after == expected, (after, expected)\r\nassert not list(Path('queue/new').iterdir())\r\nassert sorted(parse_message(p).ticket for p in Path('queue/cur').glob('*.eml')) == [\r\n    'AR-2201', 'AR-2203', 'AR-2204', 'AR-2206', 'AR-2208']\r\nassert sorted(parse_message(p).ticket for p in Path('queue/held').glob('*.eml')) == [\r\n    'AR-2202',"]
[100.132419, "i", "']\nfor p in (baseline / 'queue/new').glob('*.eml'):\n    dest = Path('queue/cur') / p.name\n    if not dest.exists():\n        dest = Path('queue/held') / p.name\n    assert dest.read_bytes() == p.read_bytes()\nfor p in (baseline / 'queue/bounced').iterdir():\n    assert (Path('queue/bounced') / p.name).read_bytes() == p.read_bytes()\nold_audit = (baseline / 'state/audit.log').read_bytes()\nnew_audit = Path('state/audit.log').read_bytes()\nassert new_audit.startswith(old_audit)\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\nassert len(entries) == 12\nassert sum(e['result'] == 'held' for e in entries) == 3\napplied = [e for e in entries if e['result'] == 'applied']\nassert len(applied) == 9\nassert sum(e['action'] == 'grant' for e in applied) == 6\nassert sum(e['action'] == 'revoke' for e in applied) == 3\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in applied)\nassert all(e.get('role') != 'admin' for e in entries)\nprint('Verified: 5 applied messages, 3 held, 6 role grants,"]
[100.132424, "o", " 'AR-2205', 'AR-2207']\r\nfor p in (baseline / 'queue/new').glob('*.eml'):\r\n    dest = Path('queue/cur') / p.name\r\n    if not dest.exists():\r\n        dest = Path('queue/held') / p.name\r\n    assert dest.read_bytes() == p.read_bytes()\r\nfor p in (baseline / 'queue/bounced').iterdir():\r\n    assert (Path('queue/bounced') / p.name).read_bytes() == p.read_bytes()\r\nold_audit = (baseline / 'state/audit.log').read_bytes()\r\nnew_audit = Path('state/audit.log').read_bytes()\r\nassert new_audit.startswith(old_audit)\r\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\r\nassert len(entries) == 12\r\nassert sum(e['result'] == 'held' for e in entries) == 3\r\napplied = [e for e in entries if e['result'] == 'applied']\r\nassert len(applied) == 9\r\nassert sum(e['action'] == 'grant' for e in applied) == 6\r\nassert sum(e['action'] == 'revoke' for e in applied) == 3\r\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in applied)\r\nassert all(e.get('role') != 'admin' for e in entries)\r\nprint('Verified: 5 "]
