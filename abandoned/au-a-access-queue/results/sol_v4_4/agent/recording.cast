[85.268518, "i", "cat > policy/delegation.toml <<'EOF'\n# Leave-period delegation: only requests filed by Mara count as approved.\n# All other senders' requests stay in queue/held/ for the platform lead.\n# Addresses only (no display names); compared case-insensitively.\napproved_senders = [\"mara.lindqvist@fernhollow.dev\"]\nEOF\npython - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\na = s.index('## Known gaps (0.4)')\nb = s.index('## Handoffs', a)\ns = s[:a] + '''## Handler status\n\nThe known 0.4 gaps are fixed: revocations, transitive implication expansion,\nidempotent grants, comma-separated roles, normalized sender checks,\nheld/rejected auditing, and read-only dry runs. Tests cover these behaviors.\n\n''' + s[b:]\np.write_text(s)\nPY\nbaseline=$(mktemp -d /tmp/accessq-before.XXXXXX)\ncp -a state queue \"$baseline/\"\nexport ACCESSQ_BASELINE=\"$baseline\"\nprintf 'Baseline saved to %s\\n' \"$ACCESSQ_BASELINE\"\npython - <<'PY'\nfrom pathlib import Path\nfrom accessq.handler import process_queue\n\ndef snapshot():\n    return {str"]
[85.268575, "i", "(p): p.read_bytes() for base in ('state', 'queue')\n            for p in Path(base).rglob('*') if p.is_file()}\n\nbefore = snapshot()\noutcomes = process_queue(Path('.'), dry_run=True)\nfor o in outcomes:\n    print(f'{o.status:9} {o.ticket:8} {o.detail}')\nassert snapshot() == before, 'Dry run changed files!'\nassert [o.ticket for o in outcomes if o.status == 'applied'] == [\n    'AR-2201', 'AR-2203', 'AR-2204', 'AR-2206', 'AR-2208']\nassert [o.ticket for o in outcomes if o.status == 'held'] == [\n    'AR-2202', 'AR-2205', 'AR-2207']\nprint('Verified: dry run changed no state or queue files; expected 5 applied / 3 held.')\nPY\n"]
[85.268741, "o", "cat > policy/delegation.toml <<'EOF'"]
[85.269917, "o", "\r\n"]
