[45.719819, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('accessq/mailparse.py')\ns = p.read_text().replace('from email import policy as email_policy', 'from email import policy as email_policy\\nfrom email.utils import getaddresses')\ns = s.replace('''    \"\"\"The message is not a well-formed access request.\"\"\"\n''', '''    \"\"\"The message is not well formed; retain metadata for the rejection audit.\"\"\"\n\n    def __init__(self, reason: str, *, ticket: str = \"?\", msg_id: str = \"\",\n                 actor: str = \"\"):\n        super().__init__(reason)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor\n\n\ndef sender_address(value: str) -> str:\n    \"\"\"Return one normalized mailbox, never a display name or a Cc address.\"\"\"\n    addresses = getaddresses([value])\n    if len(addresses) != 1:\n        return \"\"\n    address = addresses[0][1].strip().lower()\n    if address.count(\"@\") != 1 or any(c.isspace() for c in address):\n        return \"\"\n    local, domain = address.split(\"@\")\n    return address if loc"]
[45.720435, "i", "al and domain else \"\"\n''')\ns = s[:s.index('    fields = parse_fields(_plain_body(msg))', s.index('def parse_message'))] + '''    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    from_headers = msg.get_all(\"From\", [])\n    sender = sender_address(str(from_headers[0])) if len(from_headers) == 1 else \"\"\n    ticket = m.group(1) if m else \"?\"\n    try:\n        if not sender:\n            raise ParseError(\"missing or invalid From address\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles\")\n    except (ValueError, LookupError) as exc:\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_i"]
[45.720731, "o", "python - <<'PY'"]
[45.720862, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path"]
[45.720909, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.720976, "o", "> p = Path('accessq/mailparse.py')"]
[45.721016, "i", "d, actor=sender) from exc\n    return Request(\n        path=path,\n        msg_id=msg_id,\n        ticket=ticket,\n        sender=sender,\n        action=action,\n        principal=principal,\n        roles=roles,\n        justification=fields.get(\"justification\", \"\"),\n    )\n'''\n# Collect metadata before checking the subject, including for malformed requests.\ns = s.replace('''    if not m:\n        raise ParseError(f\"no ticket id in subject {subject!r}\")\n''', '')\ns = s.replace('''    try:\n        if not sender:''', '''    try:\n        if not m:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        if not sender:''')\np.write_text(s)\np = Path('accessq/handler.py')\ns = p.read_text().replace('    store = AclStore(root).load()', '    store = AclStore(root, dry_run=dry_run).load()\\n    acl_changed = False')\ns = s.replace('''            outcomes.append(Outcome(path.name, \"?\", \"rejected\", str(exc)))\n            _move(path, held)''', '''            outcomes.append(Outcome(path.name, exc.ticket, \"rejected"]
[45.721055, "i", "\", str(exc)))\n            store.audit(result=\"rejected\", ticket=exc.ticket, msg_id=exc.msg_id,\n                        actor=exc.actor, reason=str(exc))\n            if not dry_run:\n                _move(path, held)''')\ns = s.replace('''            detail = \" \".join(changed) or \"no change\"\n            _move(path, cur)\n        else:\n            _move(path, held)''', '''            acl_changed = acl_changed or bool(changed)\n            detail = \" \".join(changed) or \"no change\"\n            if not dry_run:\n                _move(path, cur)\n        else:\n            store.audit(result=status, ticket=req.ticket, msg_id=req.msg_id,\n                        actor=req.sender, reason=detail)\n            if not dry_run:\n                _move(path, held)''')\ns = s.replace('    store.save()', '    if acl_changed and not dry_run:\\n        store.save()')\np.write_text(s)\nPY\npython -m unittest discover -s tests -v\n"]
