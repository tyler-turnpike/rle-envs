[18.811181, "o", "cat accessq/handler.py; cat tests/test_handler.py\r\n\u001b[?2004l\r\"\"\"Queue processing: parse -> validate -> decide -> apply -> file.\r\n\r\nqueue/new/   messages waiting to be handled\r\nqueue/cur/   messages whose changes were applied\r\nqueue/held/  messages left for the platform lead (sender not delegated, or invalid)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport shutil\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .mailparse import ParseError, Request, parse_message\r\nfrom .policy import Catalog, Delegation\r\n\r\n\r\n@dataclass\r\nclass Outcome:\r\n    name: str\r\n    ticket: str\r\n    status: str  # applied | held | rejected\r\n    detail: str\r\n\r\n\r\ndef _dirs(root: Path) -> tuple[Path, Path, Path]:\r\n    q = root / \"queue\"\r\n    return q / \"new\", q / \"cur\", q / \"held\"\r\n\r\n\r\ndef _move(path: Path, dest: Path) -> None:\r\n    dest.mkdir(parents=True, exist_ok=True)\r\n    shutil.move(str(path), str(dest / path.name))\r\n\r\n\r\ndef decide(req: Request, catalog: Catalog, delegation: Delegation) "]
[18.811338, "o", "-> tuple[str, str]:\r\n    unknown = [r for r in req.roles if not catalog.known(r)]\r\n    if unknown:\r\n        return \"rejected\", \"unknown role(s): \" + \", \".join(unknown)\r\n    if not delegation.approves(req.sender):\r\n        return \"held\", f\"sender {req.sender} is not delegated\"\r\n    return \"applied\", \"\"\r\n\r\n\r\ndef apply(req: Request, store: AclStore, catalog: Catalog) -> list[str]:\r\n    actor = req.sender\r\n    changed = []\r\n    if req.action == \"grant\":\r\n        for role in catalog.expand(req.roles):\r\n            if store.grant(req.principal, role, actor=actor, ticket=req.ticket,\r\n                           msg_id=req.msg_id):\r\n                changed.append(\"+\" + role)\r\n    else:\r\n        for role in req.roles:\r\n            if store.revoke(req.principal, role, actor=actor, ticket=req.ticket,\r\n                            msg_id=req.msg_id):\r\n                changed.append(\"-\" + role)\r\n    return changed\r\n\r\n\r\ndef process_queue(root: Path, dry_run: bool = False) -> list[Outcome]:\r\n    root = Path(root)\r\n    new, cu"]
[18.811372, "o", "r, held = _dirs(root)\r\n    catalog = Catalog.load(root / \"policy\" / \"roles.toml\")\r\n    delegation = Delegation.load(root / \"policy\" / \"delegation.toml\")\r\n    store = AclStore(root).load()\r\n    outcomes: list[Outcome] = []\r\n\r\n    for path in sorted(new.glob(\"*.eml\")):\r\n        try:\r\n            req = parse_message(path)\r\n        except ParseError as exc:\r\n            outcomes.append(Outcome(path.name, \"?\", \"rejected\", str(exc)))\r\n            _move(path, held)\r\n            continue\r\n\r\n        status, detail = decide(req, catalog, delegation)\r\n        if status == \"applied\":\r\n            changed = apply(req, store, catalog)\r\n            detail = \" \".join(changed) or \"no change\"\r\n            _move(path, cur)\r\n        else:\r\n            _move(path, held)\r\n        outcomes.append(Outcome(path.name, req.ticket, status,\r\n                                f\"{req.action} {req.principal}: {detail}\"))\r\n\r\n    store.save()\r\n    return outcomes\r\n"]
[18.812616, "o", "\"\"\"Run with: python -m unittest discover -s tests -v   (from the repo root).\"\"\"\r\nimport json\r\nimport shutil\r\nimport tempfile\r\nimport textwrap\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nfrom accessq.handler import process_queue\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLEAD = \"lead@example.test\"\r\n\r\n\r\ndef message(ticket, sender, action, principal, roles, msg_id=None):\r\n    return textwrap.dedent(f\"\"\"\\\r\n        From: {sender}\r\n        To: access-requests@example.test\r\n        Subject: [{ticket}] access request\r\n        Message-ID: <{msg_id or ticket}@example.test>\r\n        Date: Mon, 16 Nov 2026 09:00:00 +0000\r\n        Content-Type: text/plain; charset=utf-8\r\n\r\n        Action: {action}\r\n        Principal: {principal}\r\n        Roles: {roles}\r\n        Justification: test\r\n\r\n        --\r\n        sent from the access-request form\r\n        \"\"\")\r\n\r\n\r\nclass QueueCase(unittest.TestCase):\r\n    def setUp(self):\r\n        self.root = Path(tempfile.mkdtemp())\r\n        self.addCleanup(shutil.rmtree, self.root)\r\n    "]
[18.812714, "o", "    (self.root / \"policy\").mkdir()\r\n        shutil.copy(REPO / \"policy\" / \"roles.toml\", self.root / \"policy\" / \"roles.toml\")\r\n        (self.root / \"policy\" / \"delegation.toml\").write_text(\r\n            f'approved_senders = [\"{LEAD}\"]\\n')\r\n        (self.root / \"state\").mkdir()\r\n        self.write_acl({\"ana\": [\"ci-viewer\"], \"bo\": [\"billing-reader\", \"ci-viewer\"]})\r\n        (self.root / \"state\" / \"audit.log\").write_text(\"\")\r\n        for d in (\"new\", \"cur\", \"held\"):\r\n            (self.root / \"queue\" / d).mkdir(parents=True)\r\n\r\n    def write_acl(self, principals):\r\n        (self.root / \"state\" / \"acl.json\").write_text(\r\n            json.dumps({\"principals\": principals}))\r\n\r\n    def enqueue(self, name, text):\r\n        (self.root / \"queue\" / \"new\" / f\"{name}.eml\").write_text(text)\r\n\r\n    def acl(self):\r\n        return json.loads((self.root / \"state\" / \"acl.json\").read_text())[\"principals\"]\r\n\r\n    def audit(self):\r\n        text = (self.root / \"state\" / \"audit.log\").read_text()\r\n        return [json.loads(line) for lin"]
[18.812733, "o", "e in text.splitlines() if line.strip()]\r\n\r\n    def listing(self, d):\r\n        return sorted(p.name for p in (self.root / \"queue\" / d).iterdir())\r\n\r\n\r\nclass GrantTests(QueueCase):\r\n    def test_grant_applies_and_files_message(self):\r\n        self.enqueue(\"1\", message(\"AR-1\", f\"Team Lead <{LEAD}>\", \"grant\", \"ana\", \"billing-reader\"))\r\n        process_queue(self.root)\r\n        self.assertEqual(self.acl()[\"ana\"], [\"billing-reader\", \"ci-viewer\"])\r\n        self.assertEqual(self.listing(\"cur\"), [\"1.eml\"])\r\n        self.assertTrue(any(e.get(\"ticket\") == \"AR-1\" and e.get(\"result\") == \"applied\"\r\n                            for e in self.audit()))\r\n\r\n    def test_sender_match_ignores_case(self):\r\n        self.enqueue(\"1\", message(\"AR-2\", \"LEAD@Example.TEST\", \"grant\", \"ana\", \"billing-reader\"))\r\n        process_queue(self.root)\r\n        self.assertIn(\"billing-reader\", self.acl()[\"ana\"])\r\n\r\n    def test_implied_roles_are_granted_transitively(self):\r\n        self.enqueue(\"1\", message(\"AR-3\", LEAD, \"grant\", \"cy\", \"release-man"]
[18.812802, "o", "ager\"))\r\n        process_queue(self.root)\r\n        self.assertEqual(self.acl()[\"cy\"], [\"artifact-publisher\", \"ci-viewer\",\r\n                                            \"deploy-operator\", \"release-manager\"])\r\n\r\n    def test_grant_is_idempotent(self):\r\n        self.enqueue(\"1\", message(\"AR-4\", LEAD, \"grant\", \"ana\", \"deploy-operator\"))\r\n        self.enqueue(\"2\", message(\"AR-5\", LEAD, \"grant\", \"ana\", \"ci-viewer\"))\r\n        process_queue(self.root)\r\n        self.assertEqual(self.acl()[\"ana\"], [\"ci-viewer\", \"deploy-operator\"])\r\n\r\n    def test_several_roles_in_one_request(self):\r\n        self.enqueue(\"1\", message(\"AR-6\", LEAD, \"grant\", \"ana\", \"billing-reader, oncall-responder\"))\r\n        process_queue(self.root)\r\n        self.assertEqual(self.acl()[\"ana\"], [\"billing-reader\", \"ci-viewer\", \"oncall-responder\"])\r\n\r\n\r\nclass RevokeTests(QueueCase):\r\n    def test_revoke_removes_only_named_roles(self):\r\n        self.enqueue(\"1\", message(\"AR-7\", LEAD, \"revoke\", \"bo\", \"billing-reader\"))\r\n        process_queue(self.root)\r\n     "]
