[70.179414, "i", "                        ['artifact-publisher', 'ci-viewer', 'release-manager'])\n        self.assertNotIn('absent', self.acl())\n        self.assertEqual([(e['action'], e['role']) for e in self.audit()], [\n            ('grant', 'release-manager'), ('grant', 'deploy-operator'),\n            ('grant', 'artifact-publisher'), ('revoke', 'deploy-operator')])\n        for entry in self.audit():\n            self.assertEqual(entry['actor'], LEAD)\n            self.assertEqual(entry['result'], 'applied')\n            self.assertTrue({'ticket', 'msg_id', 'principal'} <= entry.keys())\n\n    def test_revoke_does_not_expand_implications(self):\n        self.write_acl({'ana': ['ci-viewer', 'deploy-operator']})\n        self.enqueue('1', message('AR-1', LEAD, 'revoke', 'ana', 'deploy-operator'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n\n    def test_unknown_roles_reject_entire_request_and_audit(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'admin, unknown'))"]
