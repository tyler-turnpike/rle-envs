[70.185484, "o", "from test_handler import LEAD, QueueCase, message\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.policy import Catalog, Role\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class RegressionTests(QueueCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def snapshot(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return {\r\n\u001b[?2004l\r\u001b[?2004h>             str(p.relative_to(self.root)): p.read_bytes() if p.is_file() else None\r\n\u001b[?2004l\r\u001b[?2004h>             for base in ('state', 'queue')\r\n\u001b[?2004l\r\u001b[?2004h>             for p in (self.root / base).rglob('*')\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_only_actual_changes_are_audited(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana',\r\n\u001b[?2004l\r\u001b[?2004h>                                   'release-manager, ci-viewer, release-manager'))\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('2', message('AR-2', LEAD, 'grant', 'ana', 'release-manager'))\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[70.185558, "o", "    self.enqueue('3', message('AR-3', LEAD, 'revoke', 'ana',\r\n\u001b[?2004l\r\u001b[?2004h>                                   'deploy-operator, deploy-operator'))\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('4', message('AR-4', LEAD, 'revoke', 'absent', 'admin'))\r\n\u001b[?2004l\r\u001b[?2004h>         process_queue(self.root)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.acl()['ana'],\r\n\u001b[?2004l\r\u001b[?2004h>                          ['artifact-publisher', 'ci-viewer', 'release-manager'])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertNotIn('absent', self.acl())\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual([(e['action'], e['role']) for e in self.audit()], [\r\n\u001b[?2004l\r\u001b[?2004h>             ('grant', 'release-manager'), ('grant', 'deploy-operator'),\r\n\u001b[?2004l\r\u001b[?2004h>             ('grant', 'artifact-publisher'), ('revoke', 'deploy-operator')])\r\n\u001b[?2004l\r\u001b[?2004h>         for entry in self.audit():\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(entry['actor'], LEAD)\r\n\u001b[?2004l\r\u001b[?2004h>             self.assertEqual(entry['result'], 'applied')\r"]
[70.185575, "o", "\n\u001b[?2004l\r\u001b[?2004h>             self.assertTrue({'ticket', 'msg_id', 'principal'} <= entry.keys())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_revoke_does_not_expand_implications(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.write_acl({'ana': ['ci-viewer', 'deploy-operator']})\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('1', message('AR-1', LEAD, 'revoke', 'ana', 'deploy-operator'))\r\n\u001b[?2004l\r\u001b[?2004h>         process_queue(self.root)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.acl()['ana'], ['ci-viewer'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def test_unknown_roles_reject_entire_request_and_audit(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'admin, unknown'))\r\n\u001b[?2004l\r\u001b[?2004h>         process_queue(self.root)\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.acl()['ana'], ['ci-viewer'])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(self.listing('held'), ['1.eml'])\r\n\u001b[?2004l\r\u001b[?2004h>         self.assertEqual(len(self.audit()), 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
