[104.521513, "i", "python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport json\nbaseline = Path('/tmp/accessq-before')\ncounts = {d: len(list((Path('queue') / d).glob('*.eml'))) for d in ('new', 'cur', 'held', 'bounced')}\nassert counts == {'new': 0, 'cur': 5, 'held': 3, 'bounced': 1}, counts\nold = (baseline / 'state/audit.log').read_bytes()\nnow = Path('state/audit.log').read_bytes()\nassert now.startswith(old)\nentries = [json.loads(line) for line in now[len(old):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\nassert Counter(e['action'] for e in entries if e['result'] == 'applied') == {'grant': 6, 'revoke': 3}\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2205', 'AR-2207'}\nassert not any(e.get('role') == 'admin' for e in entries)\nbounced = Path('queue/bounced/1763461712.M2205P4120.fernq.eml')\nassert bounced.read_bytes() == (baseline / bounced).read_bytes()\nprint('Final verification OK:', counts)\nprint('Audit: original preserved; 6"]
[104.521735, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.521761, "i", " grants, 3 revocations, 3 held entries appended.')\nPY\n"]
