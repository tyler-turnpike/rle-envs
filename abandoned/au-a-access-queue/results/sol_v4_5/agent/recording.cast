[80.091069, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import Counter\n\nbefore = Path('/tmp/accessq-before')\nold = json.loads((before / 'state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in old.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['tomas.eriksen'] = ['ci-viewer']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nassert json.loads(Path('state/acl.json').read_text())['principals'] == expected\nassert not list(Path('queue/new').iterdir())\nassert len(list(Path('queue/cur').glob('*.eml'))) == 5\nassert len(list(Path('queue/held').glob('*.eml'))) == 3\nfor source in (before / 'queue/new').glob('*.eml'):\n    destination = Path('queue/held' if any(t in source.name for t in ('M2202', 'M2205', 'M2207')) else 'queue/cur') / source.name\n    assert source.read_bytes() == destination"]
[80.091681, "i", ".read_bytes()\nfor source in (before / 'queue/bounced').iterdir():\n    assert source.read_bytes() == (Path('queue/bounced') / source.name).read_bytes()\nold_log = (before / 'state/audit.log').read_bytes()\nlog = Path('state/audit.log').read_bytes()\nassert log.startswith(old_log)\nentries = [json.loads(line) for line in log[len(old_log):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2205', 'AR-2207'}\nassert 'admin' not in expected['svc-release-bot']\nprint('Verified: exact ACL changes; 5 applied / 3 held; 9 role audit entries / 3 held entries; original audit preserved; bounced mail untouched.')\nPY\npython -m accessq.cli show\n"]
[80.099184, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.099221, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> before = Path('/tmp/accessq-before')\r\n\u001b[?2004l\r\u001b[?2004h> old = json.loads((before / 'state/acl.json').read_text())['principals']\r\n\u001b[?2004l\r\u001b[?2004h> expected = {p: list(roles) for p, roles in old.items()}\r\n\u001b[?2004l\r\u001b[?2004h> expected['priya.raman'] = ['ci-viewer', 'deploy-operator']\r\n\u001b[?2004l\r\u001b[?2004h> expected['tomas.eriksen'] = ['ci-viewer']\r\n\u001b[?2004l\r\u001b[?2004h> expected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\r\n\u001b[?2004l\r\u001b[?2004h> expected['svc-legacy-ci'] = []\r\n\u001b[?2004l\r\u001b[?2004h> expected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\r\n\u001b[?2004l\r\u001b[?2004h> assert json.loads(Path('state/acl.json').read_text())['principals'] == expected\r\n\u001b[?2004l\r\u001b[?2004h> assert not list(Path('queue/new').iterdir())\r\n\u001b[?2004l\r\u001b[?2004h> assert len(list(Path('queue/cur').glob('*.eml'))) == 5\r\n\u001b[?2004l\r\u001b[?2004h>"]
[80.099231, "o", " assert len(list(Path('queue/held').glob('*.eml'))) == 3\r\n\u001b[?2004l\r\u001b[?2004h> for source in (before / 'queue/new').glob('*.eml'):\r\n\u001b[?2004l\r\u001b[?2004h>     destination = Path('queue/held' if any(t in source.name for t in ('M2202', 'M2205', 'M2207')) else 'queue/cur') / source.name\r\n\u001b[?2004l\r\u001b[?2004h>     assert source.read_bytes() == destination.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> for source in (before / 'queue/bounced').iterdir():\r\n\u001b[?2004l\r\u001b[?2004h>     assert source.read_bytes() == (Path('queue/bounced') / source.name).read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> old_log = (before / 'state/audit.log').read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> log = Path('state/audit.log').read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> assert log.startswith(old_log)\r\n\u001b[?2004l\r\u001b[?2004h> entries = [json.loads(line) for line in log[len(old_log):].splitlines()]\r\n\u001b[?2004l\r\u001b[?2004h> assert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\r\n\u001b[?2004l\r\u001b[?2004h> assert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'app"]
[80.09942, "o", "lied')\r\n\u001b[?2004l\r\u001b[?2004h> assert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2205', 'AR-2207'}\r\n\u001b[?2004l\r\u001b[?2004h> assert 'admin' not in expected['svc-release-bot']\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: exact ACL changes; 5 applied / 3 held; 9 role audit entries / 3 held entries; original audit preserved; bounced mail untouched.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[80.115925, "o", "Verified: exact ACL changes; 5 applied / 3 held; 9 role audit entries / 3 held entries; original audit preserved; bounced mail untouched.\r\n"]
[80.119222, "o", "\u001b[?2004hroot@27448771cb7f:/app# "]
[80.119293, "o", "python -m accessq.cli show\r\n\u001b[?2004l\r"]
[80.166972, "o", "alice.ng: artifact-publisher, ci-viewer, oncall-responder\r\ndeniz.kaya: artifact-publisher, ci-viewer, deploy-operator, release-manager\r\nilse.achterberg: admin\r\njonas.peltier: artifact-publisher, ci-viewer, deploy-operator, release-manager\r\nlea.fontaine: -\r\nmara.lindqvist: access-reviewer, ci-viewer\r\npriya.raman: ci-viewer, deploy-operator\r\nsvc-legacy-ci: -\r\nsvc-release-bot: artifact-publisher, ci-viewer\r\ntomas.eriksen: ci-viewer\r\nwen.zhao: ci-viewer, deploy-operator\r\n"]
