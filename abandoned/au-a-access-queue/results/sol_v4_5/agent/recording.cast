[60.875539, "i", "ot(), before)\n        self.assertEqual(preview[1].detail, 'grant ana: no change')\n        self.assertEqual(process_queue(self.root), preview)\n\n    def test_noop_grant_and_revoke_have_no_applied_audit(self):\n        self.enqueue('1', message('AR-16', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-17', LEAD, 'revoke', 'missing', 'ci-viewer'))\n        self.enqueue('3', message('AR-18', LEAD, 'revoke', 'bo', 'billing-reader, billing-reader'))\n        process_queue(self.root)\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['role'], 'billing-reader')\n        self.assertNotIn('missing', self.acl())\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n\n    def test_unknown_role_rejects_whole_request_and_audits(self):\n        self.enqueue('1', message('AR-19', LEAD, 'grant', 'ana', 'billing-reader, unknown'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        entry, = self.audit()\n      "]
