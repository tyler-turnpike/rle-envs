[41.666846, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('accessq/mailparse.py')\ns = p.read_text().replace('    \"\"\"The message is not a well-formed access request.\"\"\"', '''    \"\"\"The message is not a well-formed access request, with audit metadata.\"\"\"\n\n    def __init__(self, reason, *, ticket=\"?\", msg_id=\"\", actor=\"\"):\n        super().__init__(reason)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor''')\ns = s[:s.index('def parse_message(')] + '''def parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    sender = str(msg.get(\"From\", \"\"))\n    try:\n        headers = msg.get_all(\"From\", [])\n        if len(headers) != 1 or headers[0].defects:\n            raise ParseError(\"missing or malformed From address\")\n       "]
[41.666888, "i", " addresses = headers[0].addresses\n        if (len(addresses) != 1 or not addresses[0].username\n                or not addresses[0].domain):\n            raise ParseError(\"expected one sender address\")\n        sender = addresses[0].addr_spec.casefold()\n        if not match:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles entry\")\n    except (ValueError, LookupError) as exc:\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_id,\n                         actor=sender) from exc\n    return Request(\n        path=path,\n"]
