[60.875652, "i", "ct'] = '[AR-22] removal'\n        msg['Message-ID'] = '<AR-22@example.test>'\n        msg.set_content('Action: revoke\\nPrincipal: bo\\nRoles: billing-reader, ci-viewer\\n')\n        msg.add_alternative('<p>Not the plain request</p>', subtype='html')\n        self.enqueue('1', msg.as_string())\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], [])\n        self.assertEqual(len(self.audit()), 2)\n        self.assertTrue(all(e['actor'] == LEAD for e in self.audit()))\n\n    def test_cc_and_quoted_approval_do_not_delegate_sender(self):\n        text = message('AR-23', 'other@example.test', 'grant', 'ana', 'admin')\n        text = text.replace('To:', f'Cc: {LEAD}\\nTo:', 1)\n        self.enqueue('1', text + f'\\n> Approved by {LEAD}\\n> Roles: admin\\n')\n        process_queue(self.root)\n        self.assertEqual(self.listing('held'), ['1.eml'])\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(self.audit()[0]['result'], 'held')\n\n    def test_quoted_fields_do_not_add_changes"]
[60.875663, "i", "(self):\n        self.enqueue('1', message('AR-24', LEAD, 'grant', 'ana', 'billing-reader') +\n                     '\\n> Action: grant\\n> Principal: bot\\n> Roles: admin\\n')\n        process_queue(self.root)\n        self.assertNotIn('bot', self.acl())\n        self.assertEqual(self.acl()['ana'], ['billing-reader', 'ci-viewer'])\n\n    def test_ambiguous_sender_is_rejected(self):\n        self.enqueue('1', message('AR-25', f'{LEAD}, other@example.test', 'grant', 'ana', 'admin'))\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, 'rejected')\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n\n    def test_role_cycles_and_shared_dependencies_are_deduplicated(self):\n        catalog = Catalog({'a': Role('a', '', ('b', 'c')),\n                           'b': Role('b', '', ('a', 'c')),\n                           'c': Role('c', '')})\n        self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest discover"]
