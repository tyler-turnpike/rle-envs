[61.889806, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\na = s.index('## Known gaps (0.4)')\nb = s.index('## Handoffs', a)\ns = s[:a] + '''## Handler status\n\nThe former 0.4 gaps are fixed: named-role revocations, transitive and\nidempotent grants, comma-separated roles, case-insensitive sender-address\nmatching, held/rejected audit entries, and write-free dry runs. Regression\ntests also cover multipart mail and quoted approvals not delegating a sender.\n\n''' + s[b:]\np.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom accessq.cli import main\n\ndef snapshot():\n    return {str(p): (p.read_bytes(), p.stat().st_mtime_ns)\n            for base in ('state', 'policy', 'queue')\n            for p in Path(base).rglob('*') if p.is_file()}\n\nbefore = snapshot()\nassert main(['process', '--dry-run']) == 0\nassert snapshot() == before, 'dry run changed files'\nprint('Verified: preview changed no queue, policy, ACL, or audit files.')\nPY\n"]
