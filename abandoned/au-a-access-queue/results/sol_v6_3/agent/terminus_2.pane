 class ParseError(ValueError):
-    """The message is not a well-formed access request."""
+    """The message is not a well-formed access request, with audit metadata."""
+
+    def __init__(self, reason: str, *, ticket: str = "?", msg_id: str = "",
+                 sender: str = ""):
+        super().__init__(reason)
+        self.ticket = ticket
+        self.msg_id = msg_id
+        self.sender = sender
+
+
+def sender_address(value: str) -> str:
+    """Extract one mailbox, ignoring its display name and address case."""
+    addresses = getaddresses([value])
+    if len(addresses) != 1:
+        return ""
+    address = addresses[0][1].strip().casefold()
+    if address.count("@") != 1 or any(c.isspace() for c in address):
+        return ""
+    local, domain = address.split("@")
+    return address if local and domain else ""
 
 
