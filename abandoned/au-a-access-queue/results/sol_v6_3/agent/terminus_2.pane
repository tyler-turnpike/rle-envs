    for line in text.splitlines():
        if line.rstrip() == "--":
            break
        m = FIELD_RE.match(line.strip())
        if m:
            fields.setdefault(m.group(1).lower(), m.group(2).strip())
    return fields


def parse_message(path: Path) -> Request:
    with open(path, "rb") as fh:
        msg = email.message_from_binary_file(fh, policy=email_policy.default)
    subject = str(msg.get("Subject", ""))
    m = TICKET_RE.search(subject)
    msg_id = str(msg.get("Message-ID", "")).strip()
    sender = sender_address(str(msg.get("From", "")))
    metadata = {"ticket": m.group(1) if m else "?", "msg_id": msg_id,
                "sender": sender}
    try:
        if not m:
            raise ParseError(f"no ticket id in subject {subject!r}")
        if len(msg.get_all("From", [])) != 1 or not sender:
            raise ParseError("missing or ambiguous sender address")
        fields = parse_fields(_plain_body(msg))
        action = fields.get("action", "").lower()
        if action not in ACTIONS:
            raise ParseError(f"unsupported action {action!r}")
        principal = fields.get("principal", "")
        if not principal:
            raise ParseError("missing Principal")
        if not fields.get("roles"):
            raise ParseError("missing Roles")
        roles = [role.strip() for role in fields["roles"].split(",")]
        if not all(roles):
            raise ParseError("empty role in Roles")
    except (ValueError, LookupError, KeyError) as exc:
        raise ParseError(str(exc), **metadata) from exc
    return Request(
        path=path,
        msg_id=msg_id,
        ticket=m.group(1),
        sender=sender,
        action=action,
        principal=principal,
        roles=list(dict.fromkeys(roles)),
        justification=fields.get("justification", ""),
    )
        except ParseError as exc:
            outcomes.append(Outcome(path.name, exc.ticket, "rejected", str(exc)))
            store.audit(result="rejected", ticket=exc.ticket, msg_id=exc.msg_id,
                        actor=exc.sender, reason=str(exc))
            if not dry_run:
                _move(path, held)
            continue

        status, detail = decide(req, catalog, delegation)
        if status == "applied" and req.action == "revoke":
            status, detail = check_min_holders(req, store, minimums)
        if status == "applied":
            changed = apply(req, store, catalog)
            detail = " ".join(changed) or "no change"
            if not dry_run:
                if changed:
                    store.save()
                _move(path, cur)
        else:
            store.audit(result=status, ticket=req.ticket, msg_id=req.msg_id,
                        actor=req.sender, reason=detail)
            if not dry_run:
                _move(path, held)
        outcomes.append(Outcome(path.name, req.ticket, status,
                                f"{req.action} {req.principal}: {detail}"))

    return outcomes
