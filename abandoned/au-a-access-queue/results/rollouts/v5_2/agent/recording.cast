[80.463492, "i", "cat > tests/test_safety.py <<'PY'\n\"\"\"Regression coverage for approval boundaries and queue safety.\"\"\"\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass SafetyTests(QueueCase):\n    def test_only_changed_roles_are_audited(self):\n        self.enqueue(\"1\", message(\"AR-1\", LEAD, \"grant\", \"ana\", \"release-manager, ci-viewer\"))\n        self.enqueue(\"2\", message(\"AR-2\", LEAD, \"grant\", \"ana\", \"release-manager\"))\n        self.enqueue(\"3\", message(\"AR-3\", LEAD, \"revoke\", \"missing\", \"ci-viewer\"))\n        from accessq.handler import process_queue\n        process_queue(self.root)\n        self.assertEqual(len(self.audit()), 3)\n        self.assertEqual({e[\"role\"] for e in self.audit()},\n                         {\"release-manager\", \"deploy-operator\", \"artifact-publisher\"})\n        self.assertNotIn(\"missing\", self.acl())\n\n    def test_minimum_holders_blocks_entire_revoke(self):\n        self.write_acl({\"bo\": [\"billing-reader\", \"ci-viewer\"]})\n        self.enqueue(\"1\", message(\"AR-1"]
[80.463538, "i", "\", LEAD, \"revoke\", \"bo\", \"ci-viewer, billing-reader\"))\n        from accessq.handler import process_queue\n        outcomes = process_queue(self.root)\n        self.assertEqual(outcomes[0].status, \"held\")\n        self.assertEqual(self.acl()[\"bo\"], [\"billing-reader\", \"ci-viewer\"])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertIn(\"min_holders\", self.audit()[0][\"reason\"])\n\n    def test_dry_run_simulates_prior_grant_and_writes_nothing(self):\n        self.write_acl({\"bo\": [\"billing-reader\", \"ci-viewer\"]})\n        self.enqueue(\"1\", message(\"AR-1\", LEAD, \"grant\", \"ana\", \"billing-reader\"))\n        self.enqueue(\"2\", message(\"AR-2\", LEAD, \"revoke\", \"bo\", \"billing-reader\"))\n        self.enqueue(\"3\", message(\"AR-3\", \"other@example.test\", \"grant\", \"ana\", \"ci-viewer\"))\n        self.enqueue(\"4\", message(\"AR-4\", LEAD, \"grant\", \"ana\", \"unknown\"))\n        self.enqueue(\"5\", \"From: invalid\\nSubject: broken\\n\\nNot a request\\n\")\n        before = {p.relative_to(self.root): p.read_bytes()\n                  for p in "]
[80.463715, "i", "self.root.rglob(\"*\") if p.is_file()}\n        from accessq.handler import process_queue\n        predicted = process_queue(self.root, dry_run=True)\n        after = {p.relative_to(self.root): p.read_bytes()\n                 for p in self.root.rglob(\"*\") if p.is_file()}\n        self.assertEqual(before, after)\n        self.assertEqual([o.status for o in predicted],\n                         [\"applied\", \"applied\", \"held\", \"rejected\", \"rejected\"])\n        self.assertEqual(predicted, process_queue(self.root))\n\n    def test_malformed_message_is_audited_with_available_metadata(self):\n        self.enqueue(\"1\", message(\"AR-1\", LEAD, \"invalid\", \"ana\", \"ci-viewer\"))\n        from accessq.handler import process_queue\n        process_queue(self.root)\n        event, = self.audit()\n        self.assertEqual(event[\"result\"], \"rejected\")\n        self.assertEqual(event[\"ticket\"], \"AR-1\")\n        self.assertEqual(event[\"msg_id\"], \"<AR-1@example.test>\")\n        self.assertEqual(event[\"actor\"], LEAD)\n        self.assertTrue(event[\"reas"]
