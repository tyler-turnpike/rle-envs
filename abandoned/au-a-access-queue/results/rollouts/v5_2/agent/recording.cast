[81.429474, "i", "cat > policy/delegation.toml <<'EOF'\n# Leave coverage: only requests filed by Mara count as approved.\n# Everyone else's requests remain in queue/held/ for the platform lead.\napproved_senders = [\"mara.lindqvist@fernhollow.dev\"]\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nimport tempfile\nroot = Path(tempfile.mkdtemp(prefix='accessq-before-', dir='/tmp'))\nfor name in ('state', 'queue', 'policy'):\n    shutil.copytree(name, root / name)\nPath('/tmp/accessq-snapshot-path').write_text(str(root))\nprint('Pre-processing snapshot:', root)\nPY\nPYTHONDONTWRITEBYTECODE=1 python -m accessq.cli process --dry-run\npython3 - <<'PY'\nfrom pathlib import Path\nroot = Path(Path('/tmp/accessq-snapshot-path').read_text())\nfor name in ('state', 'queue', 'policy'):\n    before = {p.relative_to(root / name): p.read_bytes() for p in (root / name).rglob('*') if p.is_file()}\n    after = {p.relative_to(name): p.read_bytes() for p in Path(name).rglob('*') if p.is_file()}\n    assert before == after, f'Dry run modified {name}'\nprin"]
[81.429524, "i", "t('Verified: dry run left queue, ACL, audit, and policy unchanged.')\nPY\n"]
