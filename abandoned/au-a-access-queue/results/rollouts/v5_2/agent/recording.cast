[101.035905, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport json\nsnapshot = Path(Path('/tmp/accessq-snapshot-path').read_text())\nbefore = json.loads((snapshot / 'state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in before.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nactual = json.loads(Path('state/acl.json').read_text())['principals']\nassert actual == expected, (actual, expected)\nold_audit = (snapshot / 'state/audit.log').read_bytes()\naudit = Path('state/audit.log').read_bytes()\nassert audit.startswith(old_audit), 'Existing audit data changed'\nentries = [json.loads(line) for line in audit[len(old_audit):].splitlines()]\nassert len(entries) == 12, entries\nassert sum(e['result'] == 'applied' for e in entries) == 8\nassert sum(e['result'] == 'held' for e in entrie"]
[101.036034, "i", "s) == 4\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207'}\nassert len(list(Path('queue/cur').glob('*.eml'))) == 4\nassert len(list(Path('queue/held').glob('*.eml'))) == 4\nassert not list(Path('queue/new').iterdir())\nfor old in (snapshot / 'queue/new').glob('*.eml'):\n    destinations = [p for d in ('cur', 'held') if (p := Path('queue') / d / old.name).exists()]\n    assert len(destinations) == 1\n    assert destinations[0].read_bytes() == old.read_bytes()\nfor old in (snapshot / 'queue/bounced').iterdir():\n    assert (Path('queue/bounced') / old.name).read_bytes() == old.read_bytes()\nprint('Verified exact ACL changes, 8 applied-role audit entries, 4 held entries, intact messages, and untouched bounced mail.')\nPY\npython -m accessq.cli show\n"]
