[18.31993, "o", "\"\"\"Command line entry point: python -m accessq.cli [--root DIR] <command>.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .handler import process_queue\r\n\r\nDEFAULT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\ndef cmd_process(args) -> int:\r\n    outcomes = process_queue(args.root, dry_run=args.dry_run)\r\n    if not outcomes:\r\n        print(\"queue/new is empty\")\r\n    for o in outcomes:\r\n        print(f\"{o.status:9} {o.ticket:8} {o.name}  {o.detail}\")\r\n    if args.dry_run:\r\n        print(\"(dry run: nothing written)\")\r\n    return 0\r\n\r\n\r\ndef cmd_show(args) -> int:\r\n    store = AclStore(args.root).load()\r\n    principals = [args.principal] if args.principal else sorted(store.data[\"principals\"])\r\n    for p in principals:\r\n        print(f\"{p}: {', '.join(store.roles_of(p)) or '-'}\")\r\n    return 0\r\n\r\n\r\ndef cmd_grant(args) -> int:\r\n    \"\"\"Direct grant outside the queue (platform lead / on-call admin, e.g. during an incident).\"\"\"\r\n    "]
[18.321055, "o", "store = AclStore(args.root).load()\r\n    if store.grant(args.principal, args.role, actor=\"accessq-cli\", ticket=args.ticket, msg_id=\"\"):\r\n        store.save()\r\n        print(f\"granted {args.role} to {args.principal} ({args.ticket})\")\r\n    else:\r\n        print(f\"{args.principal} already has {args.role}\")\r\n    return 0\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"accessq\")\r\n    parser.add_argument(\"--root\", type=Path, default=DEFAULT_ROOT,\r\n                        help=\"repository root holding queue/, state/ and policy/\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    p = sub.add_parser(\"process\", help=\"handle everything in queue/new\")\r\n    p.add_argument(\"--dry-run\", action=\"store_true\",\r\n                   help=\"report what would happen without writing anything\")\r\n    p.set_defaults(func=cmd_process)\r\n\r\n    s = sub.add_parser(\"show\", help=\"print current role assignments\")\r\n    s.add_argument(\"principal\", nargs=\"?\")\r\n    s.set_defaults(f"]
[18.321241, "o", "unc=cmd_show)\r\n\r\n    g = sub.add_parser(\"grant\", help=\"admin: grant a role directly, outside the queue (audited)\")\r\n    g.add_argument(\"principal\")\r\n    g.add_argument(\"role\")\r\n    g.add_argument(\"--ticket\", required=True, help=\"ticket or incident reference for the audit log\")\r\n    g.set_defaults(func=cmd_grant)\r\n\r\n    args = parser.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[18.32215, "o", "\"\"\"Run with: python -m unittest discover -s tests -v   (from the repo root).\"\"\"\r\nimport json\r\nimport shutil\r\nimport tempfile\r\nimport textwrap\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nfrom accessq.handler import process_queue\r\n\r\nREPO = Path(__file__).resolve().parent.parent\r\nLEAD = \"lead@example.test\"\r\n\r\n\r\ndef message(ticket, sender, action, principal, roles, msg_id=None):\r\n    return textwrap.dedent(f\"\"\"\\\r\n        From: {sender}\r\n        To: access-requests@example.test\r\n        Subject: [{ticket}] access request\r\n        Message-ID: <{msg_id or ticket}@example.test>\r\n        Date: Mon, 16 Nov 2026 09:00:00 +0000\r\n        Content-Type: text/plain; charset=utf-8\r\n\r\n        Action: {action}\r\n        Principal: {principal}\r\n        Roles: {roles}\r\n        Justification: test\r\n\r\n        --\r\n        sent from the access-request form\r\n        \"\"\")\r\n\r\n\r\nclass QueueCase(unittest.TestCase):\r\n    def setUp(self):\r\n        self.root = Path(tempfile.mkdtemp())\r\n        self.addCleanup(shutil.rmtree, self.root)\r\n    "]
[18.322555, "o", "    (self.root / \"policy\").mkdir()\r\n        shutil.copy(REPO / \"policy\" / \"roles.toml\", self.root / \"policy\" / \"roles.toml\")\r\n        (self.root / \"policy\" / \"delegation.toml\").write_text(\r\n            f'approved_senders = [\"{LEAD}\"]\\n')\r\n        (self.root / \"state\").mkdir()\r\n        self.write_acl({\"ana\": [\"ci-viewer\"], \"bo\": [\"billing-reader\", \"ci-viewer\"], \"zed\": [\"billing-reader\"]})\r\n        (self.root / \"state\" / \"audit.log\").write_text(\"\")\r\n        for d in (\"new\", \"cur\", \"held\"):\r\n"]
