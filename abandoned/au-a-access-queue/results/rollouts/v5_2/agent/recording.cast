[51.773288, "i", "    if self.dry_run:\\n            return\\n        line = json.dumps')\np.write_text(s)\np = Path('accessq/policy.py')\ns = p.read_text().replace('from pathlib import Path\\n', 'from pathlib import Path\\n\\nfrom .mailparse import sender_address\\n')\ns = s.replace('''        for name in names:\n            out.append(name)\n            out.extend(self.roles[name].implies)\n        return out''', '''        seen: set[str] = set()\n\n        def visit(name: str) -> None:\n            if name in seen:\n                return\n            seen.add(name)\n            out.append(name)\n            for implied in self.roles[name].implies:\n                visit(implied)\n\n        for name in names:\n            visit(name)\n        return out''')\ns = s.replace('        return sender in self.approved_senders', '''        address = sender_address(sender)\n        return bool(address) and address in {\n            sender_address(approved) for approved in self.approved_senders\n        }''')\np.write_text(s)\nPY\n"]
