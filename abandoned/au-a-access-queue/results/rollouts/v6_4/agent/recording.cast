[77.545462, "i", "udit()[0]['result'], 'held')\n\n    def test_all_roles_validated_before_any_change(self):\n        self.enqueue('1', message('AR-12', LEAD, 'grant', 'ana', 'admin, missing'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        entry, = self.audit()\n        self.assertEqual(entry['result'], 'rejected')\n        self.assertIn('missing', entry['reason'])\n\n    def test_malformed_request_preserves_audit_metadata(self):\n        self.enqueue('1', message('AR-13', f'Lead <{LEAD}>', 'erase', 'ana', 'ci-viewer'))\n        outcome, = process_queue(self.root)\n        self.assertEqual(outcome.status, 'rejected')\n        entry, = self.audit()\n        self.assertEqual(entry['ticket'], 'AR-13')\n        self.assertEqual(entry['msg_id'], '<AR-13@example.test>')\n        self.assertEqual(entry['actor'], LEAD)\n        self.assertIn('reason', entry)\n\n    def test_missing_ticket_is_rejected_and_audited(self):\n        self.enqueue('1', message('AR-14', LEAD, 'grant', 'ana', 'admin')\n       "]
