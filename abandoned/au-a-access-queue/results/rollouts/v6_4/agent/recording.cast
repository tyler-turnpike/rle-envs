[77.545474, "i", "'applied')\n\n    def test_noop_grants_and_revokes_do_not_audit_or_create_principals(self):\n        self.enqueue('1', message('AR-16', LEAD, 'grant', 'ana', 'ci-viewer'))\n        self.enqueue('2', message('AR-17', LEAD, 'revoke', 'nobody', 'ci-viewer'))\n        before = (self.root / 'state/acl.json').read_bytes()\n        outcomes = process_queue(self.root)\n        self.assertTrue(all(o.status == 'applied' for o in outcomes))\n        self.assertEqual(self.audit(), [])\n        self.assertEqual((self.root / 'state/acl.json').read_bytes(), before)\n        self.assertEqual(self.listing('cur'), ['1.eml', '2.eml'])\n\n    def test_duplicate_revoke_audits_once(self):\n        self.enqueue('1', message('AR-18', LEAD, 'revoke', 'ana', 'ci-viewer, ci-viewer'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], [])\n        self.assertEqual(len(self.audit()), 1)\n\n    def test_audit_log_is_append_only(self):\n        log = self.root / 'state/audit.log'\n        original = '{\"existing\": true}\\n'\n        "]
[77.546713, "o", "ite_text(s)\r\nPY\r\ncat > tests/test_regressions.py <<'PY'\r\nimport contextlib\r\nimport io\r\nfrom email.message import EmailMessage\r\n\r\nfrom test_handler import QueueCase, LEAD, message\r\nfrom accessq.cli import main\r\nfrom accessq.handler import process_queue\r\nfrom accessq.policy import Catalog, Role\r\n\r\n\r\nclass RegressionTests(QueueCase):\r\n    def snapshot(self):\r\n        return {str(p.relative_to(self.root)): p.read_bytes()\r\n                for p in self.root.rglob('*') if p.is_file()}\r\n\r\n    def test_last_holder_revoke_is_held_atomically(self):\r\n        self.write_acl({'bo': ['billing-reader', 'ci-viewer']})\r\n        self.enqueue('1', message('AR-11', LEAD, 'revoke', 'bo',\r\n                                  'ci-viewer, billing-reader'))\r\n        outcome, = process_queue(self.root)\r\n        self.assertEqual(outcome.status, 'held')\r\n        self.assertIn('min_holders = 1', outcome.detail)\r\n        self.assertEqual(self.acl()['bo'], ['billing-reader', 'ci-viewer'])\r\n        self.assertEqual(len(self.audit()), 1)\r\n    "]
