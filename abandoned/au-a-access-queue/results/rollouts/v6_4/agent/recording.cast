[77.54464, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('accessq/cli.py')\ns = p.read_text().replace('from .handler import process_queue\\n', 'from .handler import process_queue\\nfrom .policy import Catalog\\n')\ns = s.replace('''    store = AclStore(args.root).load()\n    if store.grant(args.principal, args.role, actor=\"accessq-cli\", ticket=args.ticket, msg_id=\"\"):\n        store.save()\n        print(f\"granted {args.role} to {args.principal} ({args.ticket})\")\n''', '''    catalog = Catalog.load(args.root / \"policy\" / \"roles.toml\")\n    if not catalog.known(args.role):\n        print(f\"unknown role: {args.role}\", file=sys.stderr)\n        return 1\n    store = AclStore(args.root).load()\n    changed = []\n    for role in catalog.expand([args.role]):\n        if store.grant(args.principal, role, actor=\"accessq-cli\",\n                       ticket=args.ticket, msg_id=\"\"):\n            changed.append(role)\n    if changed:\n        store.save()\n        print(f\"granted {', '.join(changed)} to {args.principal} ({args.ticket})\")\n''')\np.wr"]
