[77.584331, "o", "\u001b[?2004h> "]
[77.58446, "o", "        msg.set_content('Action: grant\\nPrincipal: ana\\nRoles: deploy-operator, artifact-publisher\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.584508, "o", "> "]
[77.58457, "o", "        msg.add_alternative('<p>Principal: attacker</p>', subtype='html')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.584631, "o", "        self.enqueue('1', msg.as_string())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.584693, "o", "        process_queue(self.root)\r\n\u001b[?2004l\r\u001b[?2004h> "]
