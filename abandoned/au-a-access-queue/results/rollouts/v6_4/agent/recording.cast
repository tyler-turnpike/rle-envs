[77.584066, "o", "> "]
[77.584112, "o", "        msg = EmailMessage()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.584181, "o", "        msg['From'] = '\"Lead, Team\" <LEAD@EXAMPLE.TEST>'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.584265, "o", "        msg['Subject'] = '[AR-25] phone request'\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.584311, "o", "> "]
