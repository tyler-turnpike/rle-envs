[117.492822, "i", "else 'held') / Path(path).name\n        assert destination.read_bytes() == bytes.fromhex(content)\n    elif path.startswith('queue/bounced/') and content is not None:\n        assert (root / path).read_bytes() == bytes.fromhex(content)\naudit = (root / 'state/audit.log').read_bytes()\nassert audit.startswith(original('state/audit.log'))\nentries = [json.loads(line) for line in audit[len(original('state/audit.log')):].splitlines()]\nassert len(entries) == 12\nchanges = [e for e in entries if e['result'] == 'applied']\nassert len(changes) == 8\nassert {(e['ticket'], e['action'], e['principal'], e['role']) for e in changes} == {\n    ('AR-2201', 'grant', 'priya.raman', 'deploy-operator'),\n    ('AR-2204', 'grant', 'deniz.kaya', 'release-manager'),\n    ('AR-2204', 'grant', 'deniz.kaya', 'deploy-operator'),\n    ('AR-2204', 'grant', 'deniz.kaya', 'ci-viewer'),\n    ('AR-2204', 'grant', 'deniz.kaya', 'artifact-publisher'),\n    ('AR-2206', 'revoke', 'svc-legacy-ci', 'deploy-operator'),\n    ('AR-2206', 'revoke', 'svc-legacy-ci', '"]
