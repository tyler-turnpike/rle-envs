[117.49578, "o", "for path, content in before.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.495848, "o", "    if path.startswith('queue/new/') and content is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.495986, "o", "        ticket = next(t for t in applied | held if t.encode() in bytes.fromhex(content))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.496252, "o", "        destination = root / 'queue' / ('cur' if ticket in applied else 'held') / Path(path).name\r\n\u001b[?2004l\r\u001b[?2004h>         assert destination.read_bytes() == bytes.fromhex(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.496338, "o", "    elif path.startswith('queue/bounced/') and content is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.496386, "o", "> "]
