[83.43599, "o", "The previously listed 0.4 gaps are fixed: revocations, transitive role expansion,\r\n\u001b[?2004l\r\u001b[?2004h> idempotent grants, comma-separated roles, normalized sender checks, held/rejected\r\n\u001b[?2004l\r"]
[83.43611, "o", "\u001b[?2004h> auditing, and write-free dry runs. Regression tests cover these behaviours.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.436265, "o", "Delegation currently lists only `mara.lindqvist@fernhollow.dev`; requests from\r\n\u001b[?2004l\r\u001b[?2004h> "]
