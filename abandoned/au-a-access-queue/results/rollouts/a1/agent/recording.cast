[63.349665, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Additional coverage for auditing, MIME, no-ops, and dry-run safety.\"\"\"\nimport json\n\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def test_noop_grants_and_revokes_are_not_audited(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-2', LEAD, 'revoke', 'absent', 'ci-viewer'))\n        self.enqueue('3', message('AR-3', LEAD, 'revoke', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('4', message('AR-4', LEAD, 'revoke', 'ana', 'ci-viewer'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], [])\n        self.assertNotIn('absent', self.acl())\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['ticket'], 'AR-3')\n\n    def test_unknown_role_rejects_whole_request_and_is_audited(self):\n        self.enqueue('1"]
[63.349916, "i", "', message('AR-1', LEAD, 'grant', 'ana', 'billing-reader, unknown'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        entry, = self.audit()\n        self.assertEqual(entry['result'], 'rejected')\n        self.assertEqual(entry['ticket'], 'AR-1')\n        self.assertEqual(entry['msg_id'], '<AR-1@example.test>')\n        self.assertEqual(entry['actor'], LEAD)\n        self.assertIn('unknown', entry['reason'])\n\n    def test_malformed_body_retains_audit_metadata(self):\n        self.enqueue('1', message('AR-1', LEAD, 'invalid', 'ana', 'ci-viewer'))\n        process_queue(self.root)\n        entry, = self.audit()\n        self.assertEqual((entry['result'], entry['ticket'], entry['actor']),\n                         ('rejected', 'AR-1', LEAD))\n        self.assertEqual(self.listing('held'), ['1.eml'])\n\n    def test_missing_ticket_is_rejected_and_audited(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer')\n                     .replace('[AR-1]', "]
[63.350374, "i", "'no ticket'))\n        process_queue(self.root)\n        entry, = self.audit()\n        self.assertEqual(entry['result'], 'rejected')\n        self.assertEqual(entry['msg_id'], '<AR-1@example.test>')\n        self.assertEqual(entry['actor'], LEAD)\n\n    def test_multiple_senders_cannot_delegate(self):\n        self.enqueue('1', message('AR-1', f'{LEAD}, other@example.test',\n                                  'grant', 'ana', 'billing-reader'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(self.audit()[0]['result'], 'rejected')\n\n    def test_multipart_sender_and_multiple_revocations(self):\n        from email.message import EmailMessage\n        msg = EmailMessage()\n        msg['From'] = '\"Lead, Team\" <LEAD@EXAMPLE.TEST>'\n        msg['Subject'] = '[AR-1] revoke'\n        msg['Message-ID'] = '<AR-1@example.test>'\n        msg.set_content('Action: revoke\\nPrincipal: bo\\nRoles: billing-reader, ci-viewer\\n')\n        msg.add_alternative('<p>not the request</"]
[63.350442, "o", "cat > tests/test_regressions.py <<'PY'\r\n\u001b[?2004l\r"]
[63.35045, "i", "p>', subtype='html')\n        self.enqueue('1', msg.as_string())\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], [])\n        self.assertEqual(len(self.audit()), 2)\n        self.assertTrue(all(e['actor'] == LEAD for e in self.audit()))\n\n    def test_audit_is_append_only(self):\n        audit = self.root / 'state' / 'audit.log'\n        prefix = json.dumps({'result': 'historical'}) + '\\n'\n        audit.write_text(prefix)\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'billing-reader'))\n        process_queue(self.root)\n        self.assertTrue(audit.read_text().startswith(prefix))\n        self.assertEqual(len(self.audit()), 2)\n\n    def test_mixed_dry_run_changes_nothing_and_simulates_in_order(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'billing-reader'))\n        self.enqueue('2', message('AR-2', LEAD, 'revoke', 'ana', 'billing-reader'))\n        self.enqueue('3', message('AR-3', 'other@example.test', 'grant', 'ana', 'ci-viewer'))\n        self.enq"]
[63.350933, "o", "\u001b[?2004h> \"\"\"Additional coverage for auditing, MIME, no-ops, and dry-run safety.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.policy import Catalog, Role\r\n\u001b[?2004l\r\u001b[?2004h> from test_handler import LEAD, QueueCase, message\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class RegressionTests(QueueCase):\r\n\u001b[?2004l\r\u001b[?2004h>     def test_noop_grants_and_revokes_are_not_audited(self):\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\r\n\u001b[?2004l\r\u001b[?2004h>         self.enqueue('2', message('AR-2', LEAD, 'revoke', 'absent', 'ci-viewer'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.350981, "i", "ueue('4', message('AR-4', LEAD, 'grant', 'ana', 'unknown'))\n        self.enqueue('5', message('AR-5', LEAD, 'invalid', 'ana', 'ci-viewer'))\n        def snapshot():\n            return {str(p.relative_to(self.root)): (p.read_bytes(), p.stat().st_mtime_ns)\n                    for p in self.root.rglob('*') if p.is_file()}\n        before = snapshot()\n        outcomes = process_queue(self.root, dry_run=True)\n        self.assertEqual(snapshot(), before)\n        self.assertIn('-billing-reader', outcomes[1].detail)\n        self.assertEqual([o.status for o in outcomes],\n                         ['applied', 'applied', 'held', 'rejected', 'rejected'])\n\n    def test_expansion_handles_cycles_and_shared_dependencies(self):\n        catalog = Catalog({'a': Role('a', '', ('b', 'c')),\n                           'b': Role('b', '', ('a', 'c')),\n                           'c': Role('c', '')})\n        self.assertEqual(catalog.expand(['a', 'b']), ['a', 'b', 'c'])\nPY\npython -m unittest discover -s tests -v\n"]
