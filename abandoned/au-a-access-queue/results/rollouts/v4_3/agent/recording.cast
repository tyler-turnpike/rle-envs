[63.182472, "i", "ge('AR-23', 'other@example.test', 'grant', 'ana', 'admin'))\n        self.enqueue('5', message('AR-24', LEAD, 'grant', 'ana', 'unknown'))\n        self.enqueue('6', message('AR-25', LEAD, 'bad-action', 'ana', 'admin'))\n        def snapshot():\n            return {str(p.relative_to(self.root)): p.read_bytes()\n                    for p in self.root.rglob('*') if p.is_file()}\n        before = snapshot()\n        outcomes = process_queue(self.root, dry_run=True)\n        self.assertEqual(snapshot(), before)\n        self.assertEqual([o.status for o in outcomes],\n                         ['applied', 'applied', 'applied', 'held', 'rejected', 'rejected'])\n        self.assertEqual(outcomes[1].detail, 'grant ana: no change')\n        self.assertEqual(process_queue(self.root), outcomes)\n\n    def test_display_name_and_cc_do_not_authorize_other_sender(self):\n        text = message('AR-26', f'\"{LEAD}\" <other@example.test>', 'grant', 'ana', 'admin')\n        self.enqueue('1', text.replace('To:', f'Cc: {LEAD}\\nTo:', 1))\n        pro"]
