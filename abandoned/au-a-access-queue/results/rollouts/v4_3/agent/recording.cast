[78.595031, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\nstart = s.index('## Known gaps (0.4)')\nend = s.index('## Handoffs', start)\ns = s[:start] + '''## Handler status\n\nThe 0.4 gaps are fixed: explicit revocations, transitive/deduplicated grants,\ncomma-separated roles, case-insensitive sender addresses, held/rejected auditing,\nand read-only dry runs. Regression tests cover these behaviors, including\nmultipart requests and no-op changes.\n\nDelegation is configured in `policy/delegation.toml`. The leave configuration\napproves only `mara.lindqvist@fernhollow.dev`; review it when the lead returns.\nOnly messages already in `queue/new/` are processed. Handoff notes, Cc headers,\nand quoted approvals do not authorize other senders or import other messages.\n\n''' + s[end:]\np.write_text(s)\nPY\ncat accessq/mailparse.py accessq/handler.py\n"]
[78.595145, "o", "python - <<'PY'"]
[78.597693, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('## Known gaps (0.4)')\r\n\u001b[?2004l\r\u001b[?2004h> end = s.index('## Handoffs', start)\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''## Handler status\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The 0.4 gaps are fixed: explicit revocations, transitive/deduplicated grants,\r\n\u001b[?2004l\r\u001b[?2004h> comma-separated roles, case-insensitive sender addresses, held/rejected auditing,\r\n\u001b[?2004l\r\u001b[?2004h> and read-only dry runs. Regression tests cover these behaviors, including\r\n\u001b[?2004l\r\u001b[?2004h> multipart requests and no-op changes.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Delegation is configured in `policy/delegation.toml`. The leave configuration\r\n\u001b[?2004l\r\u001b[?2004h> approves only `mara.lindqvist@fernhollow.dev`; review it when the lead returns.\r\n\u001b[?2004l\r\u001b[?2004h> Only messages already in `queue/new/` are processed. Handoff notes, Cc headers,\r\n\u001b[?2004l\r\u001b[?2004h> and quoted app"]
[78.597752, "o", "rovals do not authorize other senders or import other messages.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[78.621701, "o", "\u001b[?2004hroot@4a557944d36f:/app# "]
[78.62197, "o", "cat accessq/mailparse.py accessq/handler.py"]
[78.621988, "o", "\r\n\u001b[?2004l\r"]
[78.623017, "o", "\"\"\"Parse access-request messages (RFC 822 / .eml) from the queue.\r\n\r\nA request body is a block of ``Key: value`` lines, for example::\r\n\r\n    Action: grant\r\n    Principal: priya.raman\r\n    Roles: deploy-operator\r\n    Justification: joining the deploy rotation\r\n\r\nAnything after a ``-- `` signature separator is ignored.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport email\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom email import policy as email_policy\r\nfrom pathlib import Path\r\n\r\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\r\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\r\nACTIONS = (\"grant\", \"revoke\")\r\n\r\n\r\nclass ParseError(ValueError):\r\n    \"\"\"The message is not a well-formed access request, with audit metadata.\"\"\"\r\n\r\n    def __init__(self, reason: str, *, ticket: str = \"?\", msg_id: str = \"\",\r\n                 actor: str = \"\"):\r\n        super().__init__(reason)\r\n        self.ticket = ticket\r\n        self.msg_id = msg_id\r\n        self.actor = actor\r\n\r\n\r\n@dataclass\r\nclass Request:\r\n    path: Path\r\n    m"]
[78.62303, "o", "sg_id: str\r\n    ticket: str\r\n    sender: str\r\n    action: str\r\n    principal: str\r\n    roles: list[str]\r\n    justification: str = \"\"\r\n\r\n\r\ndef _plain_body(msg) -> str:\r\n    part = msg.get_body(preferencelist=(\"plain\",))\r\n    if part is None:\r\n        raise ParseError(\"no text/plain part\")\r\n    return part.get_content()\r\n\r\n\r\ndef parse_fields(text: str) -> dict[str, str]:\r\n    fields: dict[str, str] = {}\r\n    for line in text.splitlines():\r\n        if line.rstrip() == \"--\":\r\n            break\r\n        m = FIELD_RE.match(line.strip())\r\n        if m:\r\n            fields.setdefault(m.group(1).lower(), m.group(2).strip())\r\n    return fields\r\n\r\n\r\ndef parse_message(path: Path) -> Request:\r\n    with open(path, \"rb\") as fh:\r\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\r\n    subject = str(msg.get(\"Subject\", \"\"))\r\n    m = TICKET_RE.search(subject)\r\n    ticket = m.group(1) if m else \"?\"\r\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\r\n    sender = str(msg.get(\"From\", \"\"))\r\n    try:\r\n  "]
[78.623035, "o", "      headers = msg.get_all(\"From\", [])\r\n        if len(headers) != 1 or he"]
[78.623219, "o", "aders[0].defects:\r\n            raise ParseError(\"missing or malformed From header\")\r\n        addresses = headers[0].addresses\r\n        if len(addresses) != 1 or not addresses[0].username or not addresses[0].domain:\r\n            raise ParseError(\"From must contain exactly one email address\")\r\n        sender = addresses[0].addr_spec.casefold()\r\n        if not m:\r\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\r\n        fields = parse_fields(_plain_body(msg))\r\n        action = fields.get(\"action\", \"\").lower()\r\n        if action not in ACTIONS:\r\n            raise ParseError(f\"unsupported action {action!r}\")\r\n        principal = fields.get(\"principal\", \"\")\r\n        if not principal:\r\n            raise ParseError(\"missing Principal\")\r\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\r\n        if not all(roles):\r\n            raise ParseError(\"missing or empty Roles\")\r\n    except ParseError as exc:\r\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_id, actor"]
[78.623225, "o", "=sender) from exc\r\n    return Request(\r\n        path=path,\r\n        msg_id=msg_id,\r\n        ticket=ticket,\r\n        sender=sender,\r\n        action=action,\r\n        principal=principal,\r\n        roles=roles,\r\n        justification=fields.get(\"justification\", \"\"),\r\n    )\r\n\"\"\"Queue processing: parse -> validate -> decide -> apply -> file.\r\n\r\nqueue/new/   messages waiting to be handled\r\nqueue/cur/   messages whose changes were applied\r\nqueue/held/  messages left for the platform lead (sender not delegated, or invalid)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport shutil\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .mailparse import ParseError, Request, parse_message\r\nfrom .policy import Catalog, Delegation\r\n\r\n\r\n@dataclass\r\nclass Outcome:\r\n    name: str\r\n    ticket: str\r\n    status: str  # applied | held | rejected\r\n    detail: str\r\n\r\n\r\ndef _dirs(root: Path) -> tuple[Path, Path, Path]:\r\n    q = root / \"queue\"\r\n    return q / \"new\", q / \"cur\", q / \"held\"\r\n\r\n\r\n"]
[78.623231, "o", "def _move(path: Path, dest: Path) -> None:\r\n    dest.mkdir(parents=True, exist_ok=True)\r\n    shutil.move(str(path), str(dest / path.name))\r\n\r\n\r\ndef decide(req: Request, catalog: Catalog, delegation: Delegation) -> tuple[str, str]:\r\n    unknown = [r for r in req.roles if not catalog.known(r)]\r\n    if unknown:\r\n        return \"rejected\", \"unknown role(s): \" + \", \".join(unknown)\r\n    if not delegation.approves(req.sender):\r\n        return \"held\", f\"sender {req.sender} is not delegated\"\r\n    return \"applied\", \"\"\r\n\r\n\r\ndef apply(req: Request, store: AclStore, catalog: Catalog) -> list[str]:\r\n    actor = req.sender\r\n    changed = []\r\n    if req.action == \"grant\":\r\n        for role in catalog.expand(req.roles):\r\n            if store.grant(req.principal, role, actor=actor, ticket=req.ticket,\r\n                           msg_id=req.msg_id):\r\n                changed.append(\"+\" + role)\r\n    else:\r\n        for role in req.roles:\r\n            if store.revoke(req.principal, role, actor=actor, ticket=req.ticket,\r\n            "]
[78.623236, "o", "                msg_id=req.msg_id):\r\n                changed.append(\"-\" + role)\r\n    return changed\r\n\r\n\r\ndef process_queue(root: Path, dry_run: bool = False) -> list[Outcome]:\r\n    root = Path(root)\r\n    new, cur, held = _dirs(root)\r\n    catalog = Catalog.load(root / \"policy\" / \"roles.toml\")\r\n    delegation = Delegation.load(root / \"policy\" / \"delegation.toml\")\r\n    store = AclStore(root, dry_run=dry_run).load()\r\n    acl_changed = False\r\n    outcomes: list[Outcome] = []\r\n\r\n    for path in sorted(new.glob(\"*.eml\")):\r\n        try:\r\n            req = parse_message(path)\r\n        except ParseError as exc:\r\n            outcomes.append(Outcome(path.name, exc.ticket, \"rejected\", str(exc)))\r\n            store.audit(result=\"rejected\", ticket=exc.ticket, msg_id=exc.msg_id,\r\n                        actor=exc.actor, reason=str(exc))\r\n            if not dry_run:\r\n                _move(path, held)\r\n            continue\r\n\r\n        status, detail = decide(req, catalog, delegation)\r\n        if status == \"applied\":\r\n          "]
[78.623241, "o", "  changed = apply(req, store, catalog)\r\n            detail = \" \".join(changed) or \"no change\"\r\n            acl_changed = acl_changed or bool(changed)\r\n            if not dry_run:\r\n                _move(path, cur)\r\n        else:\r\n            store.audit(result=status, ticket=req.ticket, msg_id=req.msg_id,\r\n                        actor=req.sender, reason=detail)\r\n            if not dry_run:\r\n                _move(path, held)\r\n        outcomes.append(Outcome(path.name, req.ticket, status,\r\n                                f\"{req.action} {req.principal}: {detail}\"))\r\n\r\n    if acl_changed and not dry_run:\r\n        store.save()\r\n    return outcomes\r\n"]
[78.623448, "o", "\u001b[?2004hroot@4a557944d36f:/app# "]
[78.717377, "i", "export ACCESSQ_VERIFY=$(mktemp -d /tmp/accessq-verify.XXXXXX)\npython - <<'PY'\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport subprocess\n\nroot = Path('/app')\nbackup = Path(os.environ['ACCESSQ_VERIFY'])\nfor directory in ('queue', 'state'):\n    shutil.copytree(root / directory, backup / directory)\ndef snapshot():\n    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()\n            for directory in ('queue', 'state')\n            for p in (root / directory).rglob('*') if p.is_file()}\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert snapshot() == before, 'Dry run changed queue or state!'\n(backup / 'before-hashes.json').write_text(json.dumps(before, indent=2))\nprint('Verified: dry run left all queue and state files unchanged.')\nprint('Verification backup:', backup)\nPY\n"]
[78.717448, "o", "export ACCESSQ_VERIFY=$(mktemp -d /tmp/accessq-verify.XXXXXX)\r\n\u001b[?2004l\r"]
