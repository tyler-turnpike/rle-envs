[63.1827, "i", "cess_queue(self.root)\n        self.assertEqual(self.listing('held'), ['1.eml'])\n        self.assertEqual(self.audit()[0]['actor'], 'other@example.test')\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_multiple_from_addresses_rejected(self):\n        self.enqueue('1', message('AR-27', f'{LEAD}, other@example.test',\n                                  'grant', 'ana', 'admin'))\n        self.assertEqual(process_queue(self.root)[0].status, 'rejected')\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_multipart_and_quoted_fields(self):\n        from email.message import EmailMessage\n        msg = EmailMessage()\n        msg['From'] = '\"Lead, Team\" <LEAD@Example.TEST>'\n        msg['Subject'] = '[AR-28] access'\n        msg['Message-ID'] = '<AR-28@example.test>'\n        msg.set_content('Action: revoke\\nPrincipal: bo\\nRoles: billing-reader, ci-viewer\\n'\n                        '\\n--\\nAction: grant\\nPrincipal: intruder\\nRoles: admin\\n'\n                        '> Action: grant\\n> Principal:"]
[63.182718, "i", " intruder\\n> Roles: admin\\n')\n        msg.add_alternative('<p>Roles: admin</p>', subtype='html')\n        self.enqueue('1', msg.as_string())\n        process_queue(self.root)\n        self.assertEqual(self.acl()['bo'], [])\n        self.assertNotIn('intruder', self.acl())\n        self.assertEqual(len(self.audit()), 2)\n\n\nclass CatalogTests(unittest.TestCase):\n    def test_cycles_and_shared_dependencies_are_expanded_once(self):\n        catalog = Catalog({'a': Role('a', '', ('b',)),\n                           'b': Role('b', '', ('a',))})\n        self.assertEqual(catalog.expand(['a', 'b', 'a']), ['a', 'b'])\n\n    def test_delegation_is_case_insensitive_on_both_sides(self):\n        delegation = Delegation(['LEAD@EXAMPLE.TEST'])\n        self.assertTrue(delegation.approves('Team Lead <lead@example.test>'))\n        self.assertFalse(delegation.approves('lead@example.test.evil'))\n        self.assertFalse(delegation.approves('lead@example.test, other@example.test'))\nPY\npython -m unittest discover -s tests -v\n"]
