[88.608246, "i", "python - <<'PY'\nimport json\nimport os\nfrom pathlib import Path\n\nroot = Path('/app')\nbackup = Path(os.environ['ACCESSQ_VERIFY'])\nbefore = json.loads((backup / 'state/acl.json').read_text())\nafter = json.loads((root / 'state/acl.json').read_text())\nexpected = before['principals'].copy()\nexpected.update({\n    'priya.raman': ['ci-viewer', 'deploy-operator'],\n    'tomas.eriksen': ['ci-viewer'],\n    'deniz.kaya': ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager'],\n    'svc-legacy-ci': [],\n    'alice.ng': ['artifact-publisher', 'ci-viewer', 'oncall-responder'],\n})\nassert after['principals'] == expected\nassert not list((root / 'queue/new').iterdir())\nheld_names = {'1763300655.M2202P4120.fernq.eml', '1763546561.M2205P4120.fernq.eml',\n              '1763650820.M2207P4120.fernq.eml'}\nassert {p.name for p in (root / 'queue/held').iterdir()} == held_names\nfor p in (backup / 'queue/new').glob('*.eml'):\n    dest = root / 'queue' / ('held' if p.name in held_names else 'cur') / p.name\n    assert dest.re"]
[88.60962, "i", "ad_bytes() == p.read_bytes()\nfor p in (backup / 'queue/bounced').glob('*'):\n    assert (root / 'queue/bounced' / p.name).read_bytes() == p.read_bytes()\nold_audit = (backup / 'state/audit.log').read_bytes()\nnew_audit = (root / 'state/audit.log').read_bytes()\nassert new_audit.startswith(old_audit)\nentries = [json.loads(line) for line in new_audit[len(old_audit):].splitlines()]\napplied = [e for e in entries if e['result'] == 'applied']\nheld = [e for e in entries if e['result'] == 'held']\nassert len(entries) == 12 and len(applied) == 9 and len(held) == 3\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in applied)\nassert {e['ticket'] for e in applied} == {'AR-2201', 'AR-2203', 'AR-2204', 'AR-2206', 'AR-2208'}\nassert {e['ticket'] for e in held} == {'AR-2202', 'AR-2205', 'AR-2207'}\nassert all(e['reason'] for e in held)\nprint('Verified: 5 applied messages, 3 held messages, 9 role changes, 12 appended audit entries.')\nprint('Verified: svc-release-bot unchanged; bounced request untouched; original audit "]
