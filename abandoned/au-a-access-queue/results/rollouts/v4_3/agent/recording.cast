[99.612736, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.613429, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from accessq.handler import process_queue\r\n\u001b[?2004l\r\u001b[?2004h> root = Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p): p.read_bytes() for d in ('state', 'queue')\r\n\u001b[?2004l\r\u001b[?2004h>             for p in (root / d).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> assert process_queue(root) == []\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: reprocessing the empty queue makes no changes.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[99.658946, "o", "Verified: reprocessing the empty queue makes no changes.\r\n"]
[99.667367, "o", "\u001b[?2004hroot@4a557944d36f:/app# "]
