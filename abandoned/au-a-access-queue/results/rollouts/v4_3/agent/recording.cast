[42.265502, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('accessq/mailparse.py')\ns = p.read_text().replace('    \"\"\"The message is not a well-formed access request.\"\"\"', '''    \"\"\"The message is not a well-formed access request, with audit metadata.\"\"\"\n\n    def __init__(self, reason: str, *, ticket: str = \"?\", msg_id: str = \"\",\n                 actor: str = \"\"):\n        super().__init__(reason)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor''')\nstart = s.index('    fields = parse_fields(_plain_body(msg))')\ns = s[:start] + '''    ticket = m.group(1) if m else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    sender = str(msg.get(\"From\", \"\"))\n    try:\n        headers = msg.get_all(\"From\", [])\n        if len(headers) != 1 or headers[0].defects:\n            raise ParseError(\"missing or malformed From header\")\n        addresses = headers[0].addresses\n        if len(addresses) != 1 or not addresses[0].username or not addresses[0].domain:\n            raise ParseError(\"From mus"]
[42.265659, "i", "t contain exactly one email address\")\n        sender = addresses[0].addr_spec.casefold()\n        if not m:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles\")\n    except ParseError as exc:\n        raise ParseError(str(exc), ticket=ticket, msg_id=msg_id, actor=sender) from exc\n    return Request(\n        path=path,\n        msg_id=msg_id,\n        ticket=ticket,\n        sender=sender,\n        action=action,\n        principal=principal,\n        roles=roles,\n        justification=fields.get(\"justification\", \"\"),\n    )\n'''\ns = s"]
