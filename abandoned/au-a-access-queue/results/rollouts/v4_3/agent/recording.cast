[63.179705, "i", "cat > tests/test_regressions.py <<'PY'\nimport unittest\n\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Delegation, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def test_noop_grants_and_revokes_have_no_applied_audit(self):\n        self.enqueue('1', message('AR-11', LEAD, 'grant', 'ana', 'ci-viewer'))\n        self.enqueue('2', message('AR-12', LEAD, 'revoke', 'ana', 'billing-reader'))\n        self.enqueue('3', message('AR-13', LEAD, 'revoke', 'nobody', 'ci-viewer'))\n        before = (self.root / 'state/acl.json').read_bytes()\n        outcomes = process_queue(self.root)\n        self.assertEqual([o.detail for o in outcomes], [\n            'grant ana: no change', 'revoke ana: no change', 'revoke nobody: no change'])\n        self.assertEqual(self.audit(), [])\n        self.assertEqual((self.root / 'state/acl.json').read_bytes(), before)\n        self.assertEqual(self.listing('cur'), ['1.eml', '2.eml', '3.eml'])\n\n    def test_audit_append"]
[63.180341, "i", "s_only_actual_changes(self):\n        original = '{\"result\": \"historical\"}\\n'\n        (self.root / 'state/audit.log').write_text(original)\n        self.enqueue('1', message('AR-14', LEAD, 'grant', 'ana',\n                                  'release-manager, ci-viewer, release-manager'))\n        self.enqueue('2', message('AR-15', LEAD, 'revoke', 'ana',\n                                  'deploy-operator, deploy-operator'))\n        process_queue(self.root)\n        self.assertTrue((self.root / 'state/audit.log').read_text().startswith(original))\n        entries = self.audit()[1:]\n        self.assertEqual([(e['action'], e['role']) for e in entries], [\n            ('grant', 'release-manager'), ('grant', 'deploy-operator'),\n            ('grant', 'artifact-publisher'), ('revoke', 'deploy-operator')])\n        for e in entries:\n            self.assertEqual(e['actor'], LEAD)\n            self.assertEqual(e['result'], 'applied')\n            self.assertIn('ticket', e)\n            self.assertIn('msg_id', e)\n        self.assert"]
[63.180551, "i", "Equal(self.acl()['ana'], ['artifact-publisher', 'ci-viewer', 'release-manager'])\n\n    def test_unknown_role_rejects_entire_request_and_audits(self):\n        self.enqueue('1', message('AR-16', LEAD, 'grant', 'ana', 'billing-reader, root'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        entry, = self.audit()\n        self.assertEqual(entry['result'], 'rejected')\n        self.assertEqual(entry['ticket'], 'AR-16')\n        self.assertEqual(entry['msg_id'], '<AR-16@example.test>')\n        self.assertEqual(entry['actor'], LEAD)\n        self.assertIn('root', entry['reason'])\n\n    def test_malformed_request_is_rejected_with_metadata(self):\n        self.enqueue('1', message('AR-17', LEAD, 'grant', '', 'ci-viewer'))\n        self.enqueue('2', message('AR-18', LEAD, 'grant', 'ana', 'ci-viewer,'))\n        process_queue(self.root)\n        self.assertEqual(self.listing('held'), ['1.eml', '2.eml'])\n        self.assertEqual([e['ticket'] for e in self.audit()], ['AR-17', 'AR-1"]
[63.182453, "i", "8'])\n        for e in self.audit():\n            self.assertEqual(e['result'], 'rejected')\n            self.assertEqual(e['actor'], LEAD)\n            self.assertTrue(e['reason'])\n            self.assertTrue(e['msg_id'])\n\n    def test_missing_ticket_is_audited(self):\n        self.enqueue('1', message('AR-19', LEAD, 'grant', 'ana', 'ci-viewer')\n                     .replace('[AR-19]', 'no ticket'))\n        process_queue(self.root)\n        entry, = self.audit()\n        self.assertEqual(entry['ticket'], '?')\n        self.assertEqual(entry['msg_id'], '<AR-19@example.test>')\n        self.assertEqual(entry['actor'], LEAD)\n        self.assertEqual(entry['result'], 'rejected')\n\n    def test_dry_run_all_paths_and_sequential_simulation(self):\n        self.enqueue('1', message('AR-20', LEAD, 'grant', 'ana', 'billing-reader'))\n        self.enqueue('2', message('AR-21', LEAD, 'grant', 'ana', 'billing-reader'))\n        self.enqueue('3', message('AR-22', LEAD, 'revoke', 'bo', 'billing-reader'))\n        self.enqueue('4', messa"]
