[42.166839, "i", "ccessq/policy.py')\ns = p.read_text().replace('from dataclasses import dataclass', 'from dataclasses import dataclass\\nfrom email.utils import getaddresses')\ns = s.replace('''        out: list[str] = []\n        for name in names:\n            out.append(name)\n            out.extend(self.roles[name].implies)\n        return out''', '''        out: list[str] = []\n        seen: set[str] = set()\n\n        def visit(name: str) -> None:\n            if name in seen:\n                return\n            seen.add(name)\n            out.append(name)\n            for dependency in self.roles[name].implies:\n                visit(dependency)\n\n        for name in names:\n            visit(name)\n        return out''')\ns = s.replace('        return sender in self.approved_senders', '''        addresses = getaddresses([sender])\n        if len(addresses) != 1 or not addresses[0][1]:\n            return False\n        address = addresses[0][1].casefold()\n        return address in {s.casefold() for s in self.approved_senders}''')\np.write_t"]
