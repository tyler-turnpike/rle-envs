[50.394861, "i", "uest.\"\"\"\n\n    def __init__(self, message: str, *, ticket: str = \"?\", msg_id: str = \"\",\n                 actor: str = \"\"):\n        super().__init__(message)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.actor = actor''')\ns = s[:s.index('def parse_message(')] + '''def parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    sender = \"\"\n    try:\n        headers = msg.get_all(\"From\", [])\n        if len(headers) != 1 or headers[0].defects:\n            raise ParseError(\"missing or malformed From address\")\n        addresses = headers[0].addresses\n        if (len(addresses) != 1 or not addresses[0].username\n                or not addresses[0].domain):\n            raise ParseError(\"expected one sender address\")\n        sende"]
