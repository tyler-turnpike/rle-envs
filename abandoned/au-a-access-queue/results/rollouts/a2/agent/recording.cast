[97.613437, "i", "python - <<'PY'\nimport json\nimport subprocess\nfrom collections import Counter\nfrom pathlib import Path\n\nacl_path = Path('state/acl.json')\naudit_path = Path('state/audit.log')\nexpected = json.loads(acl_path.read_text())['principals']\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['tomas.eriksen'] = ['ci-viewer']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\noriginal_audit = audit_path.read_bytes()\nmessages = {p.name: p.read_bytes() for p in Path('queue/new').glob('*.eml')}\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nassert json.loads(acl_path.read_text())['principals'] == expected\nassert not list(Path('queue/new').iterdir())\napplied = {'AR-2201', 'AR-2203', 'AR-2204', 'AR-2206', 'AR-2208'}\nheld = {'AR-2202', 'AR-2205', 'AR-2207'}\nfor dirname, tickets in [('cur', applied), ('held', held)]:\n    paths = li"]
[97.613995, "o", "python - <<'PY'"]
[97.614095, "i", "st(Path('queue', dirname).glob('*.eml'))\n    assert len(paths) == len(tickets)\n    for p in paths:\n        assert p.read_bytes() == messages[p.name]\n        assert any(f'[{ticket}]' in p.read_text() for ticket in tickets)\naudit = audit_path.read_bytes()\nassert audit.startswith(original_audit)\nentries = [json.loads(line) for line in audit[len(original_audit):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\nassert {e['ticket'] for e in entries if e['result'] == 'applied'} == applied\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == held\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev'\n           for e in entries if e['result'] == 'applied')\nassert all({'ticket', 'msg_id', 'actor'} <= e.keys() for e in entries)\nassert all(e.get('reason') for e in entries if e['result'] == 'held')\nprint('Verified: exact ACL changes, 5 applied messages, 3 held messages, 9 role audit entries, 3 held audit entries; prior audit and message bytes preserved.')\nbefore = {s"]
