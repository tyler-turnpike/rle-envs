[69.280687, "i", "cat > tests/test_regressions.py <<'PY'\nimport unittest\n\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\nfrom test_handler import LEAD, QueueCase, message\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes()\n                for p in self.root.rglob('*') if p.is_file()}\n\n    def test_noop_grants_and_revokes_have_no_audit_entries(self):\n        self.enqueue('1', message('AR-11', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-12', LEAD, 'revoke', 'ana', 'billing-reader'))\n        self.enqueue('3', message('AR-13', LEAD, 'revoke', 'nobody', 'ci-viewer'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertNotIn('nobody', self.acl())\n        self.assertEqual(self.audit(), [])\n        self.assertEqual(len(self.listing('cur')), 3)\n\n    def test_shared_implied_role_is_audited_only_once(self):\n        self.enqueue('1', me"]
