[103.758734, "o", "\u001b[?2004h> "]
[103.758782, "o", "a = s.index('## Known gaps (0.4)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759007, "o", "b = s.index('## Handoffs', a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759026, "o", "s = s[:a] + '''## Handler status\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> The former 0.4 gaps are implemented and covered by regression tests:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759132, "o", "revocations, transitive/idempotent grants, comma-separated roles, normalized\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759199, "o", "sender addresses, held/rejected audit entries, and write-free dry runs. Dry runs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.75932, "o", "simulate the whole queue in memory, including minimum-holder checks.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759439, "o", "Delegation uses only the single `From` mailbox, never Cc, display names, quoted\r\n\u001b[?2004l\r"]
[103.759521, "o", "\u001b[?2004h> "]
[103.759566, "o", "approvals, or signature text. Multiple/malformed From addresses are rejected.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.75967, "o", "`trusted_authserv_ids` in `policy/delegation.toml` optionally identifies trusted\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759788, "o", "mail gateways: an explicit DMARC failure reported by one holds the request for\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759882, "o", "manual verification, even when From names a delegated sender. The ingress must\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.759943, "o", "strip forged Authentication-Results headers claiming its own ID. Missing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.760042, "o", "results remain compatible with local form messages; this is not a replacement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.760147, "o", "for authentication at the mail gateway.\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.760213, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r"]
[103.760265, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
