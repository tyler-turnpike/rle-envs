[137.340733, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import Counter\noldroot = Path('/tmp/accessq-before')\nold = json.loads((oldroot / 'state/acl.json').read_text())['principals']\nnew = json.loads(Path('state/acl.json').read_text())['principals']\nadded = {(p, r) for p, roles in new.items() for r in roles if r not in old.get(p, [])}\nremoved = {(p, r) for p, roles in old.items() for r in roles if r not in new.get(p, [])}\nassert added == {('priya.raman', 'deploy-operator'), ('deniz.kaya', 'release-manager'), ('deniz.kaya', 'deploy-operator'), ('deniz.kaya', 'artifact-publisher'), ('deniz.kaya', 'ci-viewer'), ('alice.ng', 'artifact-publisher')}\nassert removed == {('svc-legacy-ci', 'deploy-operator'), ('svc-legacy-ci', 'ci-viewer')}\noldlog = (oldroot / 'state/audit.log').read_bytes()\nlog = Path('state/audit.log').read_bytes()\nassert log.startswith(oldlog)\nentries = [json.loads(line) for line in log[len(oldlog):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 5}"]
[137.341005, "i", "\ncounts = {d: len(list((Path('queue') / d).glob('*.eml'))) for d in ('new', 'cur', 'held', 'bounced')}\nassert counts == {'new': 0, 'cur': 4, 'held': 5, 'bounced': 1}\nprint('FINAL CHECK OK: 6 role additions, 2 removals; audit history preserved; 13 new audit entries.')\nprint('Queue:', counts)\nPY\n"]
[137.341066, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r"]
