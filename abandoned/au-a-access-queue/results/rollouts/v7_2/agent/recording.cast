[8.620505, "o", "===== accessq/__init__.py\r\n\"\"\"accessq: processes access requests filed by email against the platform ACL.\"\"\"\r\n\r\n__version__ = \"0.4.0\"\r\n===== accessq/acl.py\r\n"]
[8.622328, "o", "\"\"\"ACL state (state/acl.json) and the append-only audit log (state/audit.log).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport tempfile\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\n\r\nclass AclStore:\r\n    def __init__(self, root: Path):\r\n        self.acl_path = Path(root) / \"state\" / \"acl.json\"\r\n        self.audit_path = Path(root) / \"state\" / \"audit.log\"\r\n        self.data: dict = {}\r\n\r\n    def load(self) -> \"AclStore\":\r\n        with open(self.acl_path) as fh:\r\n            self.data = json.load(fh)\r\n        self.data.setdefault(\"principals\", {})\r\n        return self\r\n\r\n    def roles_of(self, principal: str) -> list[str]:\r\n        return list(self.data[\"principals\"].get(principal, []))\r\n\r\n    def grant(self, principal: str, role: str, *, actor: str, ticket: str,\r\n              msg_id: str) -> bool:\r\n        roles = self.data[\"principals\"].setdefault(principal, [])\r\n        roles.append(role)\r\n        roles.sort()\r\n        self.audit(action=\"grant\", principal=pr"]
[8.622412, "o", "incipal, role=role, actor=actor,\r\n                   ticket=ticket, msg_id=msg_id, result=\"applied\")\r\n        return True\r\n\r\n    def revoke(self, principal: str, role: str, *, actor: str, ticket: str,\r\n               msg_id: str) -> bool:\r\n        raise NotImplementedError(\"revocations are not supported yet\")\r\n\r\n    def save(self) -> None:\r\n        self.data[\"updated\"] = _now()\r\n        fd, tmp = tempfile.mkstemp(dir=self.acl_path.parent, prefix=\".acl-\")\r\n        with os.fdopen(fd, \"w\") as fh:\r\n            json.dump(self.data, fh, indent=2, sort_keys=True)\r\n            fh.write(\"\\n\")\r\n        os.replace(tmp, self.acl_path)\r\n\r\n    def audit(self, **entry) -> None:\r\n        \"\"\"Append one JSON line. Never rewrite or truncate the log.\"\"\"\r\n        line = json.dumps({\"ts\": _now(), **entry}, sort_keys=True)\r\n        with open(self.audit_path, \"a\") as fh:\r\n            fh.write(line + \"\\n\")\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n===== accessq/cli.py\r\n"]
[8.624071, "o", "\"\"\"Command line entry point: python -m accessq.cli [--root DIR] <command>.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .handler import process_queue\r\n\r\nDEFAULT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\ndef cmd_process(args) -> int:\r\n    outcomes = process_queue(args.root, dry_run=args.dry_run)\r\n    if not outcomes:\r\n        print(\"queue/new is empty\")\r\n    for o in outcomes:\r\n        print(f\"{o.status:9} {o.ticket:8} {o.name}  {o.detail}\")\r\n    if args.dry_run:\r\n        print(\"(dry run: nothing written)\")\r\n    return 0\r\n\r\n\r\ndef cmd_show(args) -> int:\r\n    store = AclStore(args.root).load()\r\n    principals = [args.principal] if args.principal else sorted(store.data[\"principals\"])\r\n    for p in principals:\r\n        print(f\"{p}: {', '.join(store.roles_of(p)) or '-'}\")\r\n    return 0\r\n\r\n\r\ndef cmd_grant(args) -> int:\r\n    \"\"\"Direct grant outside the queue (platform lead / on-call admin, e.g. during an incident).\"\"\"\r\n    "]
[8.624178, "o", "store = AclStore(args.root).load()\r\n    if store.grant(args.principal, args.role, actor=\"accessq-cli\", ticket=args.ticket, msg_id=\"\"):\r\n        store.save()\r\n        print(f\"granted {args.role} to {args.principal} ({args.ticket})\")\r\n    else:\r\n        print(f\"{args.principal} already has {args.role}\")\r\n    return 0\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"accessq\")\r\n    parser.add_argument(\"--root\", type=Path, default=DEFAULT_ROOT,\r\n                        help=\"repository root holding queue/, state/ and policy/\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    p = sub.add_parser(\"process\", help=\"handle everything in queue/new\")\r\n    p.add_argument(\"--dry-run\", action=\"store_true\",\r\n                   help=\"report what would happen without writing anything\")\r\n    p.set_defaults(func=cmd_process)\r\n\r\n    s = sub.add_parser(\"show\", help=\"print current role assignments\")\r\n    s.add_argument(\"principal\", nargs=\"?\")\r\n    s.set_defaults(f"]
[8.624231, "o", "unc=cmd_show)\r\n\r\n    g = sub.add_parser(\"grant\", help=\"admin: grant a role directly, outside the queue (audited)\")\r\n    g.add_argument(\"principal\")\r\n    g.add_argument(\"role\")\r\n    g.add_argument(\"--ticket\", required=True, help=\"ticket or incident reference for the audit log\")\r\n    g.set_defaults(func=cmd_grant)\r\n\r\n    args = parser.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
