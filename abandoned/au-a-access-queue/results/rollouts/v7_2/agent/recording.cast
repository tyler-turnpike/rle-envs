[104.761954, "i", "python - <<'PY'\nfrom pathlib import Path\nimport hashlib\nimport subprocess\n\ndef snapshot():\n    return {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\n            for base in ('state', 'queue', 'policy')\n            for p in Path(base).rglob('*') if p.is_file()}\n\nbefore = snapshot()\nresult = subprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert snapshot() == before, 'Dry run changed files!'\nprint('Verified: dry run changed no state, queue, or policy files.')\nPY\n"]
[104.762094, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.762107, "o", "from pathlib import Path\r\n"]
