[77.900362, "i", "cat > accessq/mailparse.py <<'PY'\n\"\"\"Parse the text/plain request block from an RFC 822 message.\n\nQuoted lines are not fields, and anything after a signature separator is ignored.\n\"\"\"\nfrom __future__ import annotations\n\nimport email\nimport re\nfrom dataclasses import dataclass\nfrom email import policy as email_policy\nfrom pathlib import Path\n\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\nACTIONS = (\"grant\", \"revoke\")\n\n\nclass ParseError(ValueError):\n    \"\"\"A malformed request, retaining available identifiers for its audit line.\"\"\"\n\n    def __init__(self, message, *, ticket=\"?\", msg_id=\"\", sender=\"\"):\n        super().__init__(message)\n        self.ticket = ticket\n        self.msg_id = msg_id\n        self.sender = sender\n\n\n@dataclass\nclass Request:\n    path: Path\n    msg_id: str\n    ticket: str\n    sender: str\n    action: str\n    principal: str\n    roles: list[str]\n    justification: str = \"\"\n    authentication_results: tuple[str, ...] = ()\n\n\ndef _plain_body(msg) -> s"]
[77.900656, "i", "tr:\n    part = msg.get_body(preferencelist=(\"plain\",))\n    if part is None or part.get_content_type() != \"text/plain\":\n        raise ParseError(\"no text/plain part\")\n    content = part.get_content()\n    if not isinstance(content, str):\n        raise ParseError(\"invalid text/plain body\")\n    return content\n\n\ndef parse_fields(text: str) -> dict[str, str]:\n    fields: dict[str, str] = {}\n    for line in text.splitlines():\n        if line.rstrip() == \"--\":\n            break\n        m = FIELD_RE.match(line.strip())\n        if m:\n            fields.setdefault(m.group(1).lower(), m.group(2).strip())\n    return fields\n\n\ndef parse_message(path: Path) -> Request:\n    with open(path, \"rb\") as fh:\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\n    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    ticket = match.group(1) if match else \"?\"\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    sender = str(msg.get(\"From\", \"\"))\n    try:\n        headers = msg.get_"]
