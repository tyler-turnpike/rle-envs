[124.814919, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import Counter\nbefore = Path('/tmp/accessq-before')\nold = json.loads((before / 'state/acl.json').read_text())['principals']\nexpected = {p: list(roles) for p, roles in old.items()}\nexpected['priya.raman'] = ['ci-viewer', 'deploy-operator']\nexpected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\nexpected['svc-legacy-ci'] = []\nexpected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\nactual = json.loads(Path('state/acl.json').read_text())['principals']\nassert actual == expected, (actual, expected)\nprevious_log = (before / 'state/audit.log').read_bytes()\ncurrent_log = Path('state/audit.log').read_bytes()\nassert current_log.startswith(previous_log), 'Audit history was changed'\nentries = [json.loads(line) for line in current_log[len(previous_log):].splitlines()]\nassert Counter(e['result'] for e in entries) == {'applied': 8, 'held': 5}\nassert Counter(e['action'] for e in entries if e["]
[124.815048, "i", "'result'] == 'applied') == {'grant': 6, 'revoke': 2}\nassert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\nassert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2203', 'AR-2205', 'AR-2207', 'AR-2209'}\nassert not list(Path('queue/new').iterdir())\nassert len(list(Path('queue/cur').glob('*.eml'))) == 4\nassert len(list(Path('queue/held').glob('*.eml'))) == 5\nfor source in (before / 'queue/new').glob('*.eml'):\n    destinations = [p for d in ('cur', 'held') if (p := Path('queue') / d / source.name).exists()]\n    assert len(destinations) == 1\n    assert destinations[0].read_bytes() == source.read_bytes()\nfor source in (before / 'queue/bounced').glob('*'):\n    assert (Path('queue/bounced') / source.name).read_bytes() == source.read_bytes()\nprint('Verified exact ACL delta: 6 additions, 2 removals; 4 applied messages, 5 held.')\nprint('Verified 13 appended audit entries, original messages preserved, bounced queue untouched.')\nPY\n"]
