[13.804388, "o", "# Role catalog for the platform ACL. Granting a role also grants every role it\r\n# implies (transitively). Revoking removes only the roles named in the request.\r\n\r\n[roles.ci-viewer]\r\ndescription = \"Read-only access to CI pipelines and build logs\"\r\n\r\n[roles.deploy-operator]\r\ndescription = \"Trigger and roll back deployments to staging and production\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.artifact-publisher]\r\ndescription = \"Publish build artifacts and container images to the internal registry\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.release-manager]\r\ndescription = \"Cut release branches, approve production releases\"\r\nimplies = [\"deploy-operator\", \"artifact-publisher\"]\r\n\r\n[roles.oncall-responder]\r\ndescription = \"Page acknowledgement, runbook execution, incident channels\"\r\nimplies = [\"ci-viewer\"]\r\n\r\n[roles.billing-reader]\r\ndescription = \"Read cloud billing exports and cost dashboards\"\r\n# Finance's nightly cost-report export runs as whoever holds this role.\r\nmin_holders = 1\r\n\r\n[roles.access-reviewer]\r\ndescription = \"Read the"]
