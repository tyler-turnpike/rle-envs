[103.740355, "i", "cat > tests/test_regressions.py <<'PY'\n\"\"\"Regression coverage for queue invariants and authorization boundaries.\"\"\"\nfrom test_handler import QueueCase, LEAD, message\nfrom accessq.handler import process_queue\nfrom accessq.policy import Catalog, Role\n\n\nclass RegressionTests(QueueCase):\n    def snapshot(self):\n        return {str(p.relative_to(self.root)): p.read_bytes()\n                for p in self.root.rglob('*') if p.is_file()}\n\n    def test_noop_grants_and_revokes_are_not_audited(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer, ci-viewer'))\n        self.enqueue('2', message('AR-2', LEAD, 'revoke', 'ana', 'admin'))\n        outcomes = process_queue(self.root)\n        self.assertEqual([o.status for o in outcomes], ['applied', 'applied'])\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(self.audit(), [])\n\n    def test_transitive_expansion_audits_each_change_once(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'release-ma"]
[103.740674, "i", "nager, deploy-operator'))\n        process_queue(self.root)\n        rows = self.audit()\n        self.assertEqual(sorted(e['role'] for e in rows),\n                         ['artifact-publisher', 'deploy-operator', 'release-manager'])\n        for entry in rows:\n            self.assertEqual(entry['actor'], LEAD)\n            self.assertEqual(entry['ticket'], 'AR-1')\n            self.assertEqual(entry['msg_id'], '<AR-1@example.test>')\n            self.assertEqual(entry['result'], 'applied')\n\n    def test_unknown_role_rejects_entire_request_and_audits(self):\n        self.enqueue('1', message('AR-1', LEAD, 'grant', 'ana', 'billing-reader, nonexistent'))\n        process_queue(self.root)\n        self.assertEqual(self.acl()['ana'], ['ci-viewer'])\n        self.assertEqual(len(self.audit()), 1)\n        self.assertEqual(self.audit()[0]['result'], 'rejected')\n        self.assertIn('nonexistent', self.audit()[0]['reason'])\n\n    def test_malformed_message_retains_identifiers_in_audit(self):\n        self.enqueue('1', message('"]
