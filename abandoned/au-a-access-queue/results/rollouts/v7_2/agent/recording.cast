[104.762694, "o", "> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def snapshot():\r\n\u001b[?2004l\r\u001b[?2004h>     return {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>             for base in ('state', 'queue', 'policy')\r\n\u001b[?2004l\r\u001b[?2004h>             for p in Path(base).rglob('*') if p.is_file()}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> before = snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> result = subprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\r\n\u001b[?2004l\r\u001b[?2004h> assert snapshot() == before, 'Dry run changed files!'\r\n\u001b[?2004l\r"]
[104.762802, "o", "\u001b[?2004h> print('Verified: dry run changed no state, queue, or policy files.')\r\n\u001b[?2004l\r"]
