[103.740918, "i", "d', 'rejected'])\n\n    def test_quoted_and_signature_fields_cannot_add_requests(self):\n        text = message('AR-1', LEAD, 'grant', 'ana', 'ci-viewer')\n        text += '\\n> Action: grant\\n> Principal: bot\\n> Roles: admin\\n'\n        text += '\\nAction: grant\\nPrincipal: bot\\nRoles: admin\\n'\n        self.enqueue('1', text)\n        process_queue(self.root)\n        self.assertNotIn('bot', self.acl())\n\n    def test_multiple_from_addresses_are_rejected(self):\n        self.enqueue('1', message('AR-1', f'{LEAD}, other@example.test', 'grant', 'ana', 'admin'))\n        outcome, = process_queue(self.root)\n        self.assertEqual(outcome.status, 'rejected')\n        self.assertNotIn('admin', self.acl()['ana'])\n\n    def test_explicit_failed_dmarc_is_held(self):\n        with (self.root / 'policy/delegation.toml').open('a') as fh:\n            fh.write('trusted_authserv_ids = [\"mx.example.test\"]\\n')\n        self.enqueue('1', 'Authentication-Results: mx.example.test; spf=fail; dmarc=fail (p=quarantine) header.from=example.test\\"]
