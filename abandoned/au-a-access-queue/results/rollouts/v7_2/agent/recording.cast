[13.700654, "o", "\"\"\"Command line entry point: python -m accessq.cli [--root DIR] <command>.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .handler import process_queue\r\n\r\nDEFAULT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\ndef cmd_process(args) -> int:\r\n    outcomes = process_queue(args.root, dry_run=args.dry_run)\r\n    if not outcomes:\r\n        print(\"queue/new is empty\")\r\n    for o in outcomes:\r\n        print(f\"{o.status:9} {o.ticket:8} {o.name}  {o.detail}\")\r\n    if args.dry_run:\r\n        print(\"(dry run: nothing written)\")\r\n    return 0\r\n\r\n\r\ndef cmd_show(args) -> int:\r\n    store = AclStore(args.root).load()\r\n    principals = [args.principal] if args.principal else sorted(store.data[\"principals\"])\r\n    for p in principals:\r\n        print(f\"{p}: {', '.join(store.roles_of(p)) or '-'}\")\r\n    return 0\r\n\r\n\r\ndef cmd_grant(args) -> int:\r\n    \"\"\"Direct grant outside the queue (platform lead / on-call admin, e.g. during an incident).\"\"\"\r\n    "]
[13.700861, "o", "store = AclStore(args.root).load()\r\n    if store.grant(args.principal, args.role, actor=\"accessq-cli\", ticket=args.ticket, msg_id=\"\"):\r\n        store.save()\r\n        print(f\"granted {args.role} to {args.principal} ({args.ticket})\")\r\n    else:\r\n        print(f\"{args.principal} already has {args.role}\")\r\n    return 0\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"accessq\")\r\n    parser.add_argument(\"--root\", type=Path, default=DEFAULT_ROOT,\r\n                        help=\"repository root holding queue/, state/ and policy/\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    p = sub.add_parser(\"process\", help=\"handle everything in queue/new\")\r\n    p.add_argument(\"--dry-run\", action=\"store_true\",\r\n                   help=\"report what would happen without writing anything\")\r\n    p.set_defaults(func=cmd_process)\r\n\r\n    s = sub.add_parser(\"show\", help=\"print current role assignments\")\r\n    s.add_argument(\"principal\", nargs=\"?\")\r\n    s.set_defaults(f"]
[13.700904, "o", "unc=cmd_show)\r\n\r\n    g = sub.add_parser(\"grant\", help=\"admin: grant a role directly, outside the queue (audited)\")\r\n    g.add_argument(\"principal\")\r\n    g.add_argument(\"role\")\r\n    g.add_argument(\"--ticket\", required=True, help=\"ticket or incident reference for the audit log\")\r\n    g.set_defaults(func=cmd_grant)\r\n\r\n    args = parser.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"Parse access-request messages (RFC 822 / .eml) from the queue.\r\n\r\nA request body is a block of ``Key: value`` lines, for example::\r\n\r\n    Action: grant\r\n    Principal: priya.raman\r\n    Roles: deploy-operator\r\n    Justification: joining the deploy rotation\r\n\r\nAnything after a ``-- `` signature separator is ignored.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport email\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom email import policy as email_policy\r\nfrom pathlib import Path\r\n\r\nTICKET_RE = re.compile(r\"\\[(AR-\\d+)\\]\")\r\nFIELD_RE = re.compile(r\"^([A-Za-z-]+)\\s*:\\s*(.*)$\")\r\nAC"]
[13.700977, "o", "TIONS = (\"grant\", \"revoke\")\r\n\r\n\r\nclass ParseError(ValueError):\r\n    \"\"\"The message is not a well-formed access request.\"\"\"\r\n\r\n\r\n@dataclass\r\nclass Request:\r\n    path: Path\r\n    msg_id: str\r\n    ticket: str\r\n    sender: str\r\n    action: str\r\n    principal: str\r\n    roles: list[str]\r\n    justification: str = \"\"\r\n\r\n\r\ndef _plain_body(msg) -> str:\r\n    part = msg.get_body(preferencelist=(\"plain\",))\r\n    if part is None:\r\n        raise ParseError(\"no text/plain part\")\r\n    return part.get_content()\r\n\r\n\r\ndef parse_fields(text: str) -> dict[str, str]:\r\n    fields: dict[str, str] = {}\r\n    for line in text.splitlines():\r\n        if line.rstrip() == \"--\":\r\n            break\r\n        m = FIELD_RE.match(line.strip())\r\n        if m:\r\n            fields.setdefault(m.group(1).lower(), m.group(2).strip())\r\n    return fields\r\n\r\n\r\ndef parse_message(path: Path) -> Request:\r\n    with open(path, \"rb\") as fh:\r\n        msg = email.message_from_binary_file(fh, policy=email_policy.default)\r\n    subject = str(msg.get(\"Subject\", \"\"))\r\n "]
[13.700984, "o", "   m = TICKET_RE.search(subject)\r\n    if not m:\r\n        raise ParseError(f\"no ticket id in subject {subject!r}\")\r\n    fields = parse_fields(_plain_body(msg))\r\n    action = fields.get(\"action\", \"\").lower()\r\n    if action not in ACTIONS:\r\n        raise ParseError(f\"unsupported action {action!r}\")\r\n    principal = fields.get(\"principal\", \"\")\r\n    if not principal:\r\n        raise ParseError(\"missing Principal\")\r\n    if not fields.get(\"roles\"):\r\n        raise ParseError(\"missing Roles\")\r\n    # TODO: Roles may list several roles, comma separated\r\n    roles = [fields[\"roles\"].strip()]\r\n    return Request(\r\n        path=path,\r\n        msg_id=str(msg.get(\"Message-ID\", \"\")).strip(),\r\n        ticket=m.group(1),\r\n        sender=str(msg.get(\"From\", \"\")),\r\n        action=action,\r\n        principal=principal,\r\n        roles=roles,\r\n        justification=fields.get(\"justification\", \"\"),\r\n    )\r\n\"\"\"Role catalog (policy/roles.toml) and delegation settings (policy/delegation.toml).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimp"]
[13.701016, "o", "ort tomllib\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\n\r\nclass PolicyError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Role:\r\n    name: str\r\n    description: str\r\n    implies: tuple[str, ...] = ()\r\n\r\n\r\nclass Catalog:\r\n    def __init__(self, roles: dict[str, Role]):\r\n        self.roles = roles\r\n        for role in roles.values():\r\n            for dep in role.implies:\r\n                if dep not in roles:\r\n                    raise PolicyError(f\"{role.name} implies unknown role {dep}\")\r\n\r\n    @classmethod\r\n    def load(cls, path: Path) -> \"Catalog\":\r\n        with open(path, \"rb\") as fh:\r\n            raw = tomllib.load(fh)\r\n        roles = {}\r\n        for name, spec in raw.get(\"roles\", {}).items():\r\n            roles[name] = Role(name, spec.get(\"description\", \"\"),\r\n                               tuple(spec.get(\"implies\", ())))\r\n        return cls(roles)\r\n\r\n    def known(self, name: str) -> bool:\r\n        return name in self.roles\r\n\r\n    def expand(self, names: list[str]) -> li"]
[13.701129, "o", "st[str]:\r\n        \"\"\"The roles to grant for a request: each named role plus what it implies.\"\"\"\r\n        out: list[str] = []\r\n        for name in names:\r\n            out.append(name)\r\n            out.extend(self.roles[name].implies)\r\n        return out\r\n\r\n\r\n@dataclass\r\nclass Delegation:\r\n    approved_senders: list[str]\r\n\r\n    @classmethod\r\n    def load(cls, path: Path) -> \"Delegation\":\r\n        if not path.exists():\r\n            return cls([])\r\n        with open(path, \"rb\") as fh:\r\n            raw = tomllib.load(fh)\r\n        return cls(list(raw.get(\"approved_senders\", [])))\r\n\r\n    def approves(self, sender: str) -> bool:\r\n        return sender in self.approved_senders\r\n\r\n\r\ndef min_holders(path: Path) -> dict[str, int]:\r\n    \"\"\"Per-role minimum number of holders (`min_holders` in policy/roles.toml).\"\"\"\r\n    with open(path, \"rb\") as fh:\r\n        raw = tomllib.load(fh)\r\n    return {name: int(spec.get(\"min_holders\", 0)) for name, spec in raw.get(\"roles\", {}).items()}\r\n\"\"\"Queue processing: parse -> validate -> dec"]
[13.701136, "o", "ide -> apply -> file.\r\n\r\nqueue/new/   messages waiting to be handled\r\nqueue/cur/   messages whose changes were applied\r\nqueue/held/  messages left for the platform lead (sender not delegated, or invalid)\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport shutil\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nfrom .acl import AclStore\r\nfrom .mailparse import ParseError, Request, parse_message\r\nfrom .policy import Catalog, Delegation, min_holders\r\n\r\n\r\n@dataclass\r\nclass Outcome:\r\n    name: str\r\n    ticket: str\r\n    status: str  # applied | held | rejected\r\n    detail: str\r\n\r\n\r\ndef _dirs(root: Path) -> tuple[Path, Path, Path]:\r\n    q = root / \"queue\"\r\n    return q / \"new\", q / \"cur\", q / \"held\"\r\n\r\n\r\ndef _move(path: Path, dest: Path) -> None:\r\n    dest.mkdir(parents=True, exist_ok=True)\r\n    shutil.move(str(path), str(dest / path.name))\r\n\r\n\r\ndef decide(req: Request, catalog: Catalog, delegation: Delegation) -> tuple[str, str]:\r\n    unknown = [r for r in req.roles if not catalog.known(r)]\r\n    if un"]
[13.70114, "o", "known:\r\n        return \"rejected\", \"unknown role(s): \" + \", \".join(unknown)\r\n    if not delegation.approves(req.sender):\r\n        return \"held\", f\"sender {req.sender} is not delegated\"\r\n    return \"applied\", \"\"\r\n\r\n\r\ndef check_min_holders(req: Request, store: AclStore, minimums: dict[str, int]) -> tuple[str, str]:\r\n    \"\"\"A revoke may not leave a role with fewer holders than its min_holders.\"\"\"\r\n    for role in req.roles:\r\n        need = minimums.get(role, 0)\r\n        if need and role in store.roles_of(req.principal):\r\n            holders = sum(1 for roles in store.data[\"principals\"].values() if role in roles)\r\n            if holders - 1 < need:\r\n                return \"held\", (f\"revoking {role} from {req.principal} would leave {holders - 1} holder(s); \"\r\n                                f\"policy requires min_holders = {need}\")\r\n    return \"applied\", \"\"\r\n\r\n\r\ndef apply(req: Request, store: AclStore, catalog: Catalog) -> list[str]:\r\n    actor = req.sender\r\n    changed = []\r\n    if req.action == \"grant\":\r\n        "]
[13.701145, "o", "for role in catalog.expand(req.roles):\r\n            if store.grant(req.principal, role, actor=actor, ticket=req.ticket,\r\n                           msg_id=req.msg_id):\r\n                changed.append(\"+\" + role)\r\n    else:\r\n        for role in req.roles:\r\n            if store.revoke(req.principal, role, actor=actor, ticket=req.ticket,\r\n                            msg_id=req.msg_id):\r\n                changed.append(\"-\" + role)\r\n    return changed\r\n\r\n\r\ndef process_queue(root: Path, dry_run: bool = False) -> list[Outcome]:\r\n    root = Path(root)\r\n    new, cur, held = _dirs(root)\r\n    catalog = Catalog.load(root / \"policy\" / \"roles.toml\")\r\n    minimums = min_holders(root / \"policy\" / \"roles.toml\")\r\n    delegation = Delegation.load(root / \"policy\" / \"delegation.toml\")\r\n    store = AclStore(root).load()\r\n    outcomes: list[Outcome] = []\r\n\r\n    for path in sorted(new.glob(\"*.eml\")):\r\n        try:\r\n            req = parse_message(path)\r\n        except ParseError as exc:\r\n            outcomes.append(Outcome(path.name,"]
[13.701192, "o", " \"?\", \"rejected\", str(exc)))\r\n            _move(path, held)\r\n            continue\r\n\r\n        status, detail = decide(req, catalog, delegation)\r\n        if status == \"applied\" and req.action == \"revoke\":\r\n            status, detail = check_min_holders(req, store, minimums)\r\n        if status == \"applied\":\r\n            changed = apply(req, store, catalog)\r\n            detail = \" \".join(changed) or \"no change\"\r\n            _move(path, cur)\r\n        else:\r\n            _move(path, held)\r\n        outcomes.append(Outcome(path.name, req.ticket, status,\r\n                                f\"{req.action} {req.principal}: {detail}\"))\r\n\r\n    store.save()\r\n    return outcomes\r\n"]
