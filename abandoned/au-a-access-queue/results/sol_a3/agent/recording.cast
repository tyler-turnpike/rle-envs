[85.168958, "i", "mkdir -p backups\nBACKUP_DIR=$(mktemp -d /app/backups/pre-leave.XXXXXX)\nexport BACKUP_DIR\ntar -czf \"$BACKUP_DIR/original.tar.gz\" README.md accessq policy state queue tests\nprintf 'Backup: %s/original.tar.gz\\n' \"$BACKUP_DIR\"\ncat > policy/delegation.toml <<'EOF'\n# Leave delegation: only requests filed by Mara count as approved.\n# All other senders are held for the platform lead's return.\n# Addresses only; matching ignores case and display names.\napproved_senders = [\"mara.lindqvist@fernhollow.dev\"]\nEOF\npython - <<'PY'\nfrom pathlib import Path\nimport subprocess\n\ndef snapshot():\n    return {str(p): (p.read_bytes(), p.stat().st_mtime_ns)\n            for directory in ('policy', 'state', 'queue')\n            for p in Path(directory).rglob('*') if p.is_file()}\n\nbefore = snapshot()\nsubprocess.run(['python', '-m', 'accessq.cli', 'process', '--dry-run'], check=True)\nassert snapshot() == before, 'Dry run changed files'\nprint('Verified: dry run left policy, state, and queue unchanged.')\nPY\n"]
