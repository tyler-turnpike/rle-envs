[99.766781, "i", "python -m accessq.cli process\npython - <<'PY'\nimport json\nimport os\nimport tarfile\nfrom collections import Counter\nfrom pathlib import Path\nimport subprocess\n\nwith tarfile.open(Path(os.environ['BACKUP_DIR']) / 'original.tar.gz') as backup:\n    original_acl = json.load(backup.extractfile('state/acl.json'))\n    original_audit = backup.extractfile('state/audit.log').read()\n    expected = original_acl['principals']\n    expected['priya.raman'] = ['ci-viewer', 'deploy-operator']\n    expected['tomas.eriksen'] = ['ci-viewer']\n    expected['deniz.kaya'] = ['artifact-publisher', 'ci-viewer', 'deploy-operator', 'release-manager']\n    expected['svc-legacy-ci'] = []\n    expected['alice.ng'] = ['artifact-publisher', 'ci-viewer', 'oncall-responder']\n    assert json.loads(Path('state/acl.json').read_text())['principals'] == expected\n    held_tickets = {'2202', '2205', '2207'}\n    for member in backup.getmembers():\n        if member.name.startswith('queue/new/') and member.name.endswith('.eml'):\n            name = Path(member"]
[99.767141, "i", ".name).name\n            ticket = name.split('.M')[1][:4]\n            dest = Path('queue/held' if ticket in held_tickets else 'queue/cur') / name\n            assert dest.read_bytes() == backup.extractfile(member).read()\n        if member.name.startswith('queue/bounced/') and member.isfile():\n            assert Path(member.name).read_bytes() == backup.extractfile(member).read()\n    current_audit = Path('state/audit.log').read_bytes()\n    assert current_audit.startswith(original_audit)\n    entries = [json.loads(line) for line in current_audit[len(original_audit):].splitlines()]\n    assert Counter(e['result'] for e in entries) == {'applied': 9, 'held': 3}\n    assert {e['ticket'] for e in entries if e['result'] == 'held'} == {'AR-2202', 'AR-2205', 'AR-2207'}\n    assert all(e['actor'] == 'mara.lindqvist@fernhollow.dev' for e in entries if e['result'] == 'applied')\n    assert not list(Path('queue/new').iterdir())\n    assert len(list(Path('queue/cur').glob('*.eml'))) == 5\n    assert len(list(Path('queue/held').glob('"]
[99.767162, "o", "python -m accessq.cli process"]
[99.767175, "i", "*.eml'))) == 3\n    print('Verified: exact ACL changes, nine role audit entries, three hold entries, unchanged audit prefix and message contents.')\n\nbefore = {str(p): (p.read_bytes(), p.stat().st_mtime_ns)\n          for directory in ('state', 'queue') for p in Path(directory).rglob('*') if p.is_file()}\nsubprocess.run(['python', '-m', 'accessq.cli', 'process'], check=True)\nafter = {str(p): (p.read_bytes(), p.stat().st_mtime_ns)\n         for directory in ('state', 'queue') for p in Path(directory).rglob('*') if p.is_file()}\nassert before == after\nprint('Verified: second processing run is a no-op.')\nPY\n"]
