[44.014559, "i", "ccessq/mailparse.py')\ns = p.read_text().replace('from email import policy as email_policy', 'from email import policy as email_policy\\nfrom email.utils import getaddresses')\ns = s.replace('    \"\"\"The message is not a well-formed access request.\"\"\"', '''    \"\"\"The message is not a well-formed access request, with audit context.\"\"\"\n\n    def __init__(self, reason: str):\n        super().__init__(reason)\n        self.ticket = \"?\"\n        self.msg_id = \"\"\n        self.actor = \"\"\n\n\ndef normalize_sender(sender: str) -> str:\n    \"\"\"Return one mailbox address, ignoring display name and case.\n\n    Ambiguous or missing senders must never match a delegation.\n    \"\"\"\n    addresses = getaddresses([sender])\n    if len(addresses) != 1:\n        return \"\"\n    address = addresses[0][1].strip().lower()\n    if (address.count(\"@\") != 1 or any(c.isspace() for c in address)\n            or not all(address.split(\"@\"))):\n        return \"\"\n    return address''')\nstart = s.index('    subject = str(msg.get(\"Subject\", \"\"))')\ns = s[:start] +"]
[44.014881, "i", " '''    subject = str(msg.get(\"Subject\", \"\"))\n    match = TICKET_RE.search(subject)\n    msg_id = str(msg.get(\"Message-ID\", \"\")).strip()\n    raw_sender = \", \".join(str(h) for h in msg.get_all(\"From\", []))\n    sender = normalize_sender(raw_sender)\n    try:\n        if not match:\n            raise ParseError(f\"no ticket id in subject {subject!r}\")\n        if not sender:\n            raise ParseError(\"missing or ambiguous From address\")\n        fields = parse_fields(_plain_body(msg))\n        action = fields.get(\"action\", \"\").lower()\n        if action not in ACTIONS:\n            raise ParseError(f\"unsupported action {action!r}\")\n        principal = fields.get(\"principal\", \"\")\n        if not principal:\n            raise ParseError(\"missing Principal\")\n        roles = [role.strip() for role in fields.get(\"roles\", \"\").split(\",\")]\n        if not all(roles):\n            raise ParseError(\"missing or empty Roles entry\")\n        return Request(\n            path=path,\n            msg_id=msg_id,\n            ticket=match.group"]
